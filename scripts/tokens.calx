// Generates loom's design tokens from design/tokens.toml into
// design/generated/: tokens.rs (GPUI), Tokens.swift (iPhone) and tokens.css
// (site, docs, plugin panels).
//
//     calx scripts/tokens.calx            write the generated files
//     calx scripts/tokens.calx --check    fail if they're out of date
//
// Run it from the repository's root.
import std.toml.{Toml, parse}
import std.fs
import std.env
import std.process.{exit}

struct Leaf {
    parent: String,
    key: String,
    value: Toml,
}

// Every value in the tree, in the file's order, with the dotted path of the
// table it's in.
fn walk(table: Toml, parent: String, leaves: mut List<Leaf>) {
    match table {
        Toml.Table(t) => {
            for (k, child) in t {
                let path = if parent.len() == 0 { k.copy() } else { "{parent}.{k}" }
                match child {
                    Toml.Table(_) => walk(child.copy(), path, mut leaves),
                    _ => leaves.push(Leaf { parent: parent.copy(), key: k.copy(), value: child.copy() }),
                }
            }
        },
        _ => {},
    }
}

// "thread.motion.writing" -> "thread_motion_writing"
fn snake(s: String) -> String {
    return s.replace(".", "_").replace("-", "_").to_lower_root()
}

// "thread.motion.writing" -> "ThreadMotionWriting"
fn pascal(s: String) -> String {
    var out = String()
    for part in s.replace(".", "-").split("-") {
        var first = true
        for r in part.runes() {
            if first { var t = String(); t.push(r); out.push_str(t.to_upper_root()) } else { out.push(r) }
            first = false
        }
    }
    return out
}

// "button-ink" -> "buttonInk"
fn camel(s: String) -> String {
    let p = pascal(s)
    var out = String()
    var first = true
    for r in p.runes() {
        if first { var t = String(); t.push(r); out.push_str(t.to_lower_root()) } else { out.push(r) }
        first = false
    }
    return out
}

fn is_colour(v: Toml) -> bool {
    return (v.as_str() ?? String()).starts_with("#")
}

fn hex(v: Toml) -> String {
    let s = v.as_str() ?? String("#000000")
    return "0x{s[1..]}"
}

fn number(v: Toml) -> String {
    match v {
        Toml.Int(i) => return "{i}",
        Toml.Float(f) => return "{f}",
        _ => return String("0"),
    }
}

fn rust_number(v: Toml) -> String {
    match v {
        Toml.Int(i) => return "{i}.0",
        _ => return number(v),
    }
}

fn px(parent: String) -> bool {
    return parent == "size" or parent == "space" or parent == "radius" or parent == "layout" or parent == "control" or parent == "thread.stroke"
}

fn header(comment: String) -> String {
    return "{comment} Generated by scripts/tokens.calx from design/tokens.toml. Don't edit by hand.\n"
}

fn rust(leaves: List<Leaf>) -> String {
    var out = header(String("//"))
    out.push_str("//! loom's design tokens, for the GPUI app. Colours are 0xRRGGBB, for gpui::rgb.\n\n")
    var current = String("-")
    for leaf in leaves {
        if leaf.parent != current {
            if current != "-" { out.push_str("\}\n\n") }
            out.push_str("pub mod {snake(leaf.parent.copy())} \{\n")
            current = leaf.parent.copy()
        }
        let name = snake(leaf.key.copy()).to_upper_root()
        if is_colour(leaf.value.copy()) {
            out.push_str("    pub const {name}: u32 = {hex(leaf.value.copy())};\n")
        } else if let s = leaf.value.as_str() {
            out.push_str("    pub const {name}: &str = \"{s}\";\n")
        } else {
            out.push_str("    pub const {name}: f32 = {rust_number(leaf.value.copy())};\n")
        }
    }
    if current != "-" { out.push_str("\}\n") }
    return out
}

fn swift(leaves: List<Leaf>) -> String {
    var out = header(String("//"))
    out.push_str("// loom's design tokens, for the iPhone app. Colours are 0xRRGGBB; Color(loom:) turns one into a Color.\n\n")
    out.push_str("import SwiftUI\n\n")
    out.push_str("extension Color \{\n    init(loom hex: UInt32) \{\n        self.init(.sRGB, red: Double((hex >> 16) & 0xff) / 255, green: Double((hex >> 8) & 0xff) / 255, blue: Double(hex & 0xff) / 255)\n    \}\n\}\n\n")
    out.push_str("enum Tokens \{\n")
    var current = String("-")
    for leaf in leaves {
        if leaf.parent != current {
            if current != "-" { out.push_str("    \}\n\n") }
            out.push_str("    enum {pascal(leaf.parent.copy())} \{\n")
            current = leaf.parent.copy()
        }
        let name = camel(leaf.key.copy())
        if is_colour(leaf.value.copy()) {
            out.push_str("        static let {name}: UInt32 = {hex(leaf.value.copy())}\n")
        } else if let s = leaf.value.as_str() {
            out.push_str("        static let {name} = \"{s}\"\n")
        } else {
            out.push_str("        static let {name}: CGFloat = {number(leaf.value.copy())}\n")
        }
    }
    if current != "-" { out.push_str("    \}\n") }
    out.push_str("\}\n")
    return out
}

// The CSS name of a leaf: theme colours are plain (--bg, --thread-mint),
// everything else carries its table's path (--radius-card).
fn css_name(leaf: Leaf) -> String {
    if leaf.parent.starts_with("color.") { return "--{leaf.key}" }
    if leaf.parent.starts_with("thread.color.") { return "--thread-{leaf.key}" }
    return "--{leaf.parent.replace(".", "-")}-{leaf.key}"
}

fn css_value(leaf: Leaf) -> String {
    if is_colour(leaf.value.copy()) { return leaf.value.as_str() ?? String() }
    if let s = leaf.value.as_str() { return "\"{s}\"" }
    if px(leaf.parent.copy()) { return "{number(leaf.value.copy())}px" }
    return number(leaf.value.copy())
}

fn css_block(leaves: List<Leaf>, theme: String, indent: String) -> String {
    var out = String()
    for leaf in leaves {
        if leaf.parent == "color.{theme}" or leaf.parent == "thread.color.{theme}" {
            out.push_str("{indent}{css_name(leaf.copy())}: {css_value(leaf.copy())};\n")
        }
    }
    return out
}

fn css(leaves: List<Leaf>) -> String {
    var out = header(String("/*"))
    out = out.replace("\n", " */\n")
    out.push_str("/* loom's design tokens, for the site, the docs and plugin panels. Dark unless [data-theme=\"light\"], or the system is light and no theme is set. */\n\n")
    out.push_str(":root \{\n  color-scheme: dark;\n")
    for leaf in leaves {
        if not leaf.parent.starts_with("color.") and not leaf.parent.starts_with("thread.color.") {
            out.push_str("  {css_name(leaf.copy())}: {css_value(leaf.copy())};\n")
        }
    }
    out.push_str(css_block(leaves.copy(), String("dark"), String("  ")))
    out.push_str("\}\n\n")
    out.push_str("@media (prefers-color-scheme: light) \{\n  :root:not([data-theme=\"dark\"]) \{\n    color-scheme: light;\n")
    out.push_str(css_block(leaves.copy(), String("light"), String("    ")))
    out.push_str("  \}\n\}\n\n")
    out.push_str(":root[data-theme=\"light\"] \{\n  color-scheme: light;\n")
    out.push_str(css_block(leaves.copy(), String("light"), String("  ")))
    out.push_str("\}\n")
    return out
}

fn main() ! Error {
    let check = env.args().len() > 0 and env.args()[0] == "--check"
    let text = try fs.read_text(String("design/tokens.toml")) ?? String()
    let doc = try parse(text)
    var leaves = List<Leaf>()
    walk(doc, String(), mut leaves)

    let files: List<(String, String)> = [
        (String("design/generated/tokens.rs"), rust(leaves.copy())),
        (String("design/generated/Tokens.swift"), swift(leaves.copy())),
        (String("design/generated/tokens.css"), css(leaves.copy())),
    ]
    if check {
        var stale = 0
        for f in files {
            let have = match fs.read_text(f.0.copy()) { ok(t) => t ?? String(), err(_) => String() }
            if have != f.1 {
                eprintln("out of date: {f.0}")
                stale += 1
            }
        }
        if stale > 0 {
            eprintln("run: calx scripts/tokens.calx")
            exit(1)
        }
        println("tokens are up to date")
        return
    }
    try fs.make_dir_all(String("design/generated"))
    for f in files {
        try fs.write_text(f.0.copy(), f.1.copy())
        println("wrote {f.0}")
    }
    println("{leaves.len()} tokens")
}
