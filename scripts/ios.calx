// Builds the core for the iPhone app and makes its Xcode project.
//
//     calx scripts/ios.calx            the core for a phone and the simulator, then the project
//     calx scripts/ios.calx --sim      the core for the simulator alone, which builds faster
//     calx scripts/ios.calx --sample   no core: the project alone, with the app on sample frames
//
// Run it from the repository's root, on a Mac with Xcode and XcodeGen. It:
//
// 1. builds core/lib.calx as a static library for each of `aarch64-ios` and
//    `aarch64-ios-sim`, into build/ios/<platform>/, with its header loomcore.h;
// 2. gives the header a module map, so Swift imports it as `LoomCore`;
// 3. puts the libraries in build/ios/LoomCore.xcframework, which the app links;
// 4. puts the app icon scripts/icons.calx makes, design/logo/ios/AppIcon.appiconset,
//    in build/ios/Icons.xcassets, since Xcode's asset compiler doesn't follow links;
// 5. puts Twemoji's pictures, design/twemoji/svg, in build/ios/Twemoji.xcassets, each
//    keeping its vectors;
// 6. puts Spools' marks, server/catalog/*.svg, and Voice's, shared/voice/*.svg, in
//    build/ios/Marks.xcassets, each keeping its vectors and drawn as a template;
// 7. runs `xcodegen` in ios/, with LOOM_CORE=YES so ios/core.yml links it.
//
// --sample does only the last four.
//
// CALX names the compiler to build with, `calx` otherwise.
import std.env
import std.fs
import std.process.{Command, exit}

const OUT: str = "build/ios"

fn calx() -> String {
    return env.variable(String("CALX")) ?? String("calx")
}

fn has(flag: str) -> bool {
    for a in env.args() {
        if a == flag { return true }
    }
    return false
}

/// Builds the core for one target into build/ios/<folder>/.
fn core(target: str, folder: str, release: bool) ! Error {
    let dir = "{OUT}/{folder}"
    try fs.make_dir_all(dir.copy())
    var c = Command.new(calx()).arg(String("build")).arg(String("--staticlib"))
    if release { c = c.arg(String("--release")) }
    c = c.arg(String("--target")).arg(String(target)).arg(String("core/lib.calx")).arg(String("-o")).arg("{dir}/libloomcore.a")
    println("building the core for {target}")
    try c.run()
    // Swift imports the header as a module.
    try fs.make_dir_all("{dir}/include")
    try fs.write_text("{dir}/include/module.modulemap", String("module LoomCore \{\n    header \"loomcore.h\"\n    export *\n\}\n"))
    try fs.copy("{dir}/loomcore.h", "{dir}/include/loomcore.h")
}

/// The app's asset catalog, build/ios/Icons.xcassets, with the iPhone icon from
/// design/logo/ios, made again each time so it has the icon as it is now.
fn icons() ! Error {
    let catalog = "{OUT}/Icons.xcassets"
    if fs.exists(catalog.copy()) {
        try fs.remove_dir_all(catalog.copy())
    }
    try fs.make_dir_all(catalog.copy())
    try fs.write_text("{catalog}/Contents.json", String("\{\n  \"info\" : \{\n    \"author\" : \"xcode\",\n    \"version\" : 1\n  \}\n\}\n"))
    try fs.copy_dir_all(String("design/logo/ios/AppIcon.appiconset"), "{catalog}/AppIcon.appiconset")
}

/// Twemoji's pictures (PLAN.md, "Emoji") as build/ios/Twemoji.xcassets: each SVG in
/// design/twemoji/svg an image set named as its file is, which keeps its vectors, so UIKit
/// draws an emoji sharp at any size. Made again each time, from the pictures as they are.
fn twemoji() ! Error {
    let catalog = "{OUT}/Twemoji.xcassets"
    if fs.exists(catalog.copy()) {
        try fs.remove_dir_all(catalog.copy())
    }
    try fs.make_dir_all(catalog.copy())
    try fs.write_text("{catalog}/Contents.json", String("\{\n  \"info\" : \{\n    \"author\" : \"xcode\",\n    \"version\" : 1\n  \}\n\}\n"))
    var n = 0
    for file in try fs.list(String("design/twemoji/svg")) {
        if not file.ends_with(".svg") { continue }
        let set = "{catalog}/{file.trim_suffix(".svg")}.imageset"
        try fs.make_dir_all(set.copy())
        try fs.copy("design/twemoji/svg/{file}", "{set}/{file}")
        try fs.write_text("{set}/Contents.json", "\{\n  \"images\" : [\n    \{\n      \"filename\" : \"{file}\",\n      \"idiom\" : \"universal\"\n    \}\n  ],\n  \"info\" : \{\n    \"author\" : \"xcode\",\n    \"version\" : 1\n  \},\n  \"properties\" : \{\n    \"preserves-vector-representation\" : true\n  \}\n\}\n")
        n += 1
    }
    println("put {n} emoji in {catalog}")
}

/// Spools' marks (server/catalog/README.md) and Voice's (shared/voice/README.md) as
/// build/ios/Marks.xcassets: each SVG in server/catalog an image set named `mark-` and its
/// file's name, as a catalog entry's id is, and each in shared/voice one named `voice-`
/// and its file's name, as a tile's `mark` is. Each keeps its vectors and is drawn as a
/// template in the ink it's on. Its `currentColor` is black here, since a template keeps
/// only its shape. Made again each time, from the marks as they are.
fn marks() ! Error {
    let catalog = "{OUT}/Marks.xcassets"
    if fs.exists(catalog.copy()) {
        try fs.remove_dir_all(catalog.copy())
    }
    try fs.make_dir_all(catalog.copy())
    try fs.write_text("{catalog}/Contents.json", String("\{\n  \"info\" : \{\n    \"author\" : \"xcode\",\n    \"version\" : 1\n  \}\n\}\n"))
    let n = (try marks_from(catalog.copy(), "server/catalog", "mark-")) + (try marks_from(catalog.copy(), "shared/voice", "voice-"))
    println("put {n} marks in {catalog}")
}

/// Each SVG in `dir` as an image set in `catalog`, named `prefix` and its file's name.
fn marks_from(catalog: String, dir: str, prefix: str) -> i32 ! Error {
    var n = 0
    for file in try fs.list(String(dir)) {
        if not file.ends_with(".svg") { continue }
        let set = "{catalog}/{prefix}{file.trim_suffix(".svg")}.imageset"
        try fs.make_dir_all(set.copy())
        let svg = (try fs.read_text("{dir}/{file}")) ?? String()
        try fs.write_text("{set}/{file}", svg.replace("currentColor", "#000000"))
        try fs.write_text("{set}/Contents.json", "\{\n  \"images\" : [\n    \{\n      \"filename\" : \"{file}\",\n      \"idiom\" : \"universal\"\n    \}\n  ],\n  \"info\" : \{\n    \"author\" : \"xcode\",\n    \"version\" : 1\n  \},\n  \"properties\" : \{\n    \"preserves-vector-representation\" : true,\n    \"template-rendering-intent\" : \"template\"\n  \}\n\}\n")
        n += 1
    }
    return n
}

fn main() ! Error {
    if not fs.is_file(String("core/lib.calx")) or not fs.is_file(String("ios/project.yml")) {
        eprintln("run it from loom's root: calx scripts/ios.calx")
        exit(2)
    }
    let sample = has("--sample")
    if not sample {
        let sim_only = has("--sim")
        let release = not has("--debug")
        try core("aarch64-ios-sim", "iphonesimulator", release)
        if not sim_only {
            try core("aarch64-ios", "iphoneos", release)
        }
        let root = try fs.real_path(String("."))
        let framework = "{root}/{OUT}/LoomCore.xcframework"
        if fs.exists(framework.copy()) {
            try fs.remove_dir_all(framework.copy())
        }
        var x = Command.new(String("xcodebuild")).arg(String("-create-xcframework"))
        x = x.arg(String("-library")).arg("{OUT}/iphonesimulator/libloomcore.a").arg(String("-headers")).arg("{OUT}/iphonesimulator/include")
        if not sim_only {
            x = x.arg(String("-library")).arg("{OUT}/iphoneos/libloomcore.a").arg(String("-headers")).arg("{OUT}/iphoneos/include")
        }
        try x.arg(String("-output")).arg(framework.copy()).run()
        println("made {OUT}/LoomCore.xcframework")
    }
    try icons()
    try twemoji()
    try marks()
    var gen = Command.new(String("xcodegen")).arg(String("--quiet")).dir(String("ios"))
    gen = gen.env(String("LOOM_CORE"), String(if sample { "NO" } else { "YES" }))
    try gen.run()
    println("made ios/Loom.xcodeproj{if sample { ", on sample frames" } else { "" }}")
}
