{
  "name": "loom-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "tokens": "node ../scripts/sync-site-tokens.mjs",
    "tokens:check": "node ../scripts/sync-site-tokens.mjs --check",
    "verify:tokens": "node verify-tokens.mjs",
    "verify:pages": "node verify-pages.mjs",
    "verify:a11y": "node verify-a11y.mjs",
    "verify:weave": "node verify-weave.mjs",
    "verify": "bun run tokens:check && bun run test && bun run typecheck && bun run build && bun run verify:tokens && bun run verify:pages && bun run verify:a11y && bun run verify:weave"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
