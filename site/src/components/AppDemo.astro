---
// A live copy of loom's desktop app, for the first screen: the sidebar with the pinned agents as
// tiles, centred, then one list of agents and group chats in the person's order, which a drag
// rearranges, with a folder in it; and three chats, each with one scene that plays once: Juniper's,
// whose answer names an Acta card; the Shop group chat, where the router picks who answers and
// the line over the reply says so; and Moss's, where a T3 thread runs to done. Another agent's
// thread with Juniper opens from its row. Its sizes, colours and words are the app's
// (desktop/src/app.rs, design/tokens.toml); the script that plays it is src/scripts/demo.ts. The
// card's pill, the context ring, the pins, a message's Reply and ⋯, the + and the sidebar's
// control open what they open in the app.
import { brains } from '../lib/registry.mjs';
import shapes from '../../../design/generated/shapes.json';

const agents = [
	{ name: 'Biscuit', color: 'apricot', shape: 'star', pinned: true },
	{ name: 'Pip', color: 'lavender', pinned: true },
	// Open, with Biscuit's thread with it (message_agent) under it, as the app lists it.
	{ name: 'Juniper', color: 'sky', shape: 'yarn', on: true, asks: [{ from: 'Biscuit', color: 'apricot', shape: 'star' }] },
	{ name: 'Moss', color: 'mint', shape: 'heart' },
	{ name: 'Otto', color: 'coral', shape: 'snail', folder: 'Home' },
];
const pinned = agents.filter((a) => a.pinned);
const rest = agents.filter((a) => !a.pinned && !a.folder);
// A folder the person made, under its name (PLAN.md, "The sidebar").
const home = agents.filter((a) => a.folder === 'Home');
// The brain chip: the program's icon from the ACP Registry, and what the agent is set to on it.
const [claude] = await brains(['claude-acp']);
// Its plan and limits, as Claude reports them, in the context card under the ring: orange from
// 75% and red from 90% (desktop/src/meter.rs, Level::of).
const PLAN = {
	name: 'Claude Max',
	limits: [
		{ name: 'Session', used: 42, resets: '15:30' },
		{ name: 'This week', used: 78, resets: 'Mon' },
	],
};
// An agent's thread where a message mentions it, or over a message it sent: its shape, still,
// in a box 14 by 14, as desktop/src/app.rs, mention_thread, draws it.
function mentionThread(shape: keyof typeof shapes): string {
	const pts = shapes[shape] as number[][];
	let sx = 0;
	let sy = 0;
	for (const [x, y] of pts) {
		sx = Math.max(sx, Math.abs(x));
		sy = Math.max(sy, Math.abs(y));
	}
	const scale = Math.min(6 / Math.max(sx, 0.1), 6 / Math.max(sy, 0.1));
	return pts.map(([x, y], i) => `${i ? 'L' : 'M'}${(7 + x * scale).toFixed(2)} ${(7 + y * scale).toFixed(2)}`).join(' ');
}
const BISCUIT = mentionThread('star');
// The group chats (PLAN.md, "Group chats"), each with its members' threads woven together,
// four at most, as desktop/src/room_view.rs draws them with thread::weave.
const rooms = [
	{ name: 'Everyone', colors: ['apricot', 'lavender', 'sky', 'mint'] },
	{ name: 'Shop', colors: ['sky', 'apricot'] },
];
// The group chat the demo opens and writes in.
const shop = rooms[1];
// The one list under the tiles: agents and group chats in the person's order, as they dragged
// them (PLAN.md, "The sidebar").
const listed = ['Everyone', 'Juniper', 'Shop', 'Moss'].map((name) => ({
	room: rooms.find((r) => r.name === name),
	agent: rest.find((a) => a.name === name),
}));
function wave(k: number, n: number): string {
	const phase = (k * Math.PI * 2) / n;
	const pts: string[] = [];
	for (let i = 0; i <= 24; i++) {
		const u = i / 24;
		pts.push(`${i ? 'L' : 'M'}${(1 + u * 24).toFixed(2)} ${(7 - Math.sin(u * Math.PI * 2 + phase) * 5).toFixed(2)}`);
	}
	return pts.join(' ');
}
// The + menu (app.rs, plus_menu, plus_face): what adds to the message, then what it does, and
// the lists Recent files, Skills and Routines open beside it, each ending in its settings page.
const PLUS_LISTS = {
	recent: [
		{ icon: 'file', name: 'notes-2.4.md', line: 'Today 09:12' },
		{ icon: 'image', name: 'checkout-before.png', line: 'Yesterday 16:40' },
		{ icon: 'file', name: 'october-orders.csv', line: 'Yesterday 11:05' },
	],
	skills: [
		{ icon: 'book', name: 'deploy-shop', line: 'Ships main to production and checks its health' },
		{ icon: 'book', name: 'release-notes', line: 'Writes the changelog from merged pull requests' },
	],
	routines: [
		{ icon: 'clock', name: 'Morning brief', line: 'Ran 08:00 ✓' },
		{ icon: 'clock', name: 'Stock check', line: 'Moss · Ran 09:00 ✓' },
	],
};
// Lucide's icons, as the app draws them (gpui-kit-assets).
const ICON: Record<string, string> = {
	paperclip: '<path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"/>',
	fileClock: '<path d="M16 22h2a2 2 0 0 0 2-2V8a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 14 2H6a2 2 0 0 0-2 2v2.85"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M8 14v2.2l1.6 1"/><circle cx="8" cy="16" r="6"/>',
	smile: '<path d="M15 10V9"/><path d="M16.472 15a6 6 0 0 1-8.943 0"/><path d="M9 10V9"/><circle cx="12" cy="12" r="10"/>',
	book: '<path d="M12 5v16"/><path d="M20.001 19A2 2 0 0 0 22 17V5a2 2 0 0 0-1.999-2L16 3.002A5 5 0 0 0 12 5a5 5 0 0 0-4-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 1.999 2H8a5 5 0 0 1 4 2 5 5 0 0 1 4-2z"/>',
	clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
	spool: '<path d="M17 13.44 4.442 17.082A2 2 0 0 0 4.982 21H19a2 2 0 0 0 .558-3.921l-1.115-.32A2 2 0 0 1 17 14.837V7.66"/><path d="m7 10.56 12.558-3.642A2 2 0 0 0 19.018 3H5a2 2 0 0 0-.558 3.921l1.115.32A2 2 0 0 1 7 9.163v7.178"/>',
	terminal: '<path d="m7 11 2-2-2-2"/><path d="M11 13h4"/><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>',
	search: '<path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>',
	right: '<path d="m9 18 6-6-6-6"/>',
	settings: '<path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/>',
	file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8M10 9H8"/>',
	image: '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
};

// GitHub's mark, as its site icon on the reply's link.
const GITHUB =
	'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z';
// The layers glyph on a board's tile, before an Acta card's id (app.rs, board_tile), in a
// 24-unit box.
const BOARD_LAYERS = [
	'M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z',
	'M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12',
	'M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17',
];
---

<div class="app" data-demo role="region" aria-label="loom's desktop app, with an agent at work">
	<span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
	<aside class="side">
		<div class="side-top">
			<span class="brand" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
					<mask id="demo-knot" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32">
						<rect width="32" height="32" fill="white"></rect>
						<path d="M13.67 22.24 C 14.8 23.3, 16.3 24.1, 18.14 24.34" stroke="black" stroke-width="5.6"></path>
					</mask>
					<path d="M3 24.5 H12 C 19 24.5, 22 18.5, 22 14 C 22 9.5, 19 7, 16 7 C 13 7, 10 9.5, 10 14" mask="url(#demo-knot)"></path>
					<path d="M10 14 C 10 19, 13.5 24.5, 20 24.5 H29"></path>
				</svg>
				loom
			</span>
			<span class="side-tools">
				<button type="button" class="icon-btn small bar" data-bar aria-label="Collapse the sidebar">
					<svg class="i shut" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18m7 12-3-3 3-3"></path></svg>
					<svg class="i open" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18m5-12 3 3-3 3"></path></svg>
				</button>
			</span>
		</div>
		<div class="list" aria-hidden="true">
			<div class="pins">
				{
					pinned.map((a) => (
						<div class:list={['tile', { on: a.on }]} data-agent={a.name} title={a.name}>
							<svg data-thread data-color={a.color} data-shape={a.shape} width="52" height="36" />
							<span class="tile-name">{a.name}</span>
						</div>
					))
				}
			</div>
			<div class="side-line"></div>
			{
				listed.map(({ room: r, agent: a }) =>
					r ? (
						<div class="agent room" data-room={r.name}>
							<svg class="weave" width="26" height="14" viewBox="0 0 26 14">
								{r.colors.map((c, k) => (
									<path d={wave(k, r.colors.length)} style={`stroke: var(--thread-${c})`} />
								))}
							</svg>
							<span class="agent-text">
								<span class="agent-name">{r.name}</span>
							</span>
						</div>
					) : (
						a && (
							<>
								<div class:list={['agent', { on: a.on }]} data-agent={a.name}>
									<svg data-thread data-color={a.color} data-shape={a.shape} width="26" height={a.shape ? 22 : 10} />
									<span class="agent-text">
										<span class="agent-name">{a.name}</span>
										<span class="agent-preview" />
									</span>
								</div>
								{a.on &&
									a.asks?.map((k) => (
										<div class="ask" data-ask>
											<svg data-thread data-color={k.color} data-shape={k.shape} width="18" height={k.shape ? 22 : 8} />
											<span class="ask-name">From {k.from}</span>
										</div>
									))}
							</>
						)
					),
				)
			}
			<div class="group-head folder">
				Home
				<svg class="i" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
			</div>
			{
				home.map((a) => (
					<div class="agent" data-agent={a.name}>
						<svg data-thread data-color={a.color} data-shape={a.shape} width="26" height={a.shape ? 22 : 10} />
						<span class="agent-text">
							<span class="agent-name">{a.name}</span>
							<span class="agent-preview" />
						</span>
					</div>
				))
			}
			<div class="new-row">
				<svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"></path></svg>
				New
			</div>
		</div>
		<div class="side-foot" aria-hidden="true">
			<span class="server">
				<svg data-yarn="This computer" width="32" height="32"></svg>
				<span class="server-text">
					<span class="server-name">This computer</span>
					<span class="server-state">Connected</span>
				</span>
			</span>
			<span class="icon-btn gear">
				<svg class="i" viewBox="0 0 24 24"
					><path
						d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
					></path><circle cx="12" cy="12" r="3"></circle></svg
				>
			</span>
		</div>
	</aside>

	<div class="main">
		<div class="titlebar">
			<!-- In a narrow window it gives way as the app's does (model/header.rs, demo.ts). -->
			<div class="header" data-header>
				<span class="agent-btn" aria-hidden="true">
					<svg data-thread data-color="sky" data-head width="26" height="10"></svg>
					<span class="head-name">Juniper</span>
					<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
				</span>
				<!-- A group chat's head: its members' threads woven, its name and how many are in
				     it, which opens its settings (room_view.rs, room_head). -->
				<span class="room-btn" aria-hidden="true">
					<svg class="weave" width="26" height="14" viewBox="0 0 26 14">
						{shop.colors.map((c, k) => <path d={wave(k, shop.colors.length)} style={`stroke: var(--thread-${c})`} />)}
					</svg>
					<span class="head-name">{shop.name}</span>
					<span class="room-count">{shop.colors.length} agents</span>
				</span>
				<span class="chips">
					<!-- The chat's pins: how many, and the popover centred under it, with its nub on
					     the pin and each pin drawn as the chat draws its message (app.rs, pins_pop,
					     pins_placed, pin_row). -->
					<span class="pins-at">
						<button type="button" class="chip pins-btn" data-pins aria-expanded="false" aria-label="Pinned" title="Pinned  Ctrl+Shift+P"
							><svg class="i" viewBox="0 0 24 24"><path d="M12 17v5"></path><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path></svg
							><span data-pins-count>2</span></button
						>
						<div class="pins-pop" data-pins-pop role="dialog" aria-label="Pinned" hidden>
							<div class="pp-head"><span class="pp-title">Pinned</span><span class="pp-count" data-pins-count>2</span></div>
							<div class="pp-wrap">
								<div class="pp-list" data-pins-list tabindex="-1"></div>
								<div class="pp-empty" hidden>
									<span class="pp-ring"><svg class="i" viewBox="0 0 24 24"><path d="M12 17v5"></path><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path></svg></span>
									<b>Nothing pinned yet</b>
									<span>Hover a message and pick Pin</span>
								</div>
								<div class="pp-note" data-pins-note hidden></div>
							</div>
						</div>
						<span class="pp-nub" aria-hidden="true"></span>
					</span>
					<span class="chip brain" aria-hidden="true">
						{claude?.icon && <span class="brain-icon" style={`--icon: url(${claude.icon})`} />}
						<span class="brain-words">Opus 5.5<span class="brain-effort">&nbsp;· Medium</span></span>
						<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
					</span>
					<!-- How full Juniper's session context is, after its model, with its card under it
					     on hover, kept open by a click (app.rs, context_ring, context_card_view). Its
					     program says only how many tokens are in it, not what they are. -->
					<span class="context-at">
						<button type="button" class="context" data-context aria-expanded="false" aria-label="Context 41%, 82k of 200k"
							><svg viewBox="0 0 16 16"
								><circle class="track" cx="8" cy="8" r="7" pathLength="100"></circle><circle
									class="fill"
									cx="8"
									cy="8"
									r="7"
									pathLength="100"
									style="--fill: 41"></circle></svg
							></button
						>
						<div class="context-card" data-context-card role="dialog" aria-label="Context" hidden>
							<div class="cc-head"><span class="cc-title">Context</span><span class="cc-amount" data-context-amount>82k of 200k</span></div>
							<div class="cc-bar"><span data-context-bar style="--fill: 41%"></span></div>
							<div class="cc-row"><span>Last turn</span><span class="cc-tokens" data-context-turn>410k</span></div>
							<div class="cc-row"><span>Last 24 hours</span><span class="cc-tokens" data-context-day>6.2M</span></div>
							<div class="cc-line" data-context-line>Compacted 2 h ago</div>
							<div class="cc-actions">
								<button type="button" data-context-act="compact">Compact now</button>
								<button type="button" data-context-act="fresh">Start a fresh session</button>
							</div>
							<!-- The plan of the program the open agent runs on, as it reports it: its
							     session's and its week's limits, each a small ring with when it resets. -->
							<div class="cc-plan">
								<div class="cc-plan-name">
									{claude?.icon && <span class="brain-icon" style={`--icon: url(${claude.icon})`} />}
									{PLAN.name}
								</div>
								{
									PLAN.limits.map((l) => (
										<div class:list={['limit', { warn: l.used >= 75 && l.used < 90, bad: l.used >= 90 }]}>
											<svg class="ring" viewBox="0 0 14 14">
												<circle cx="7" cy="7" r="6.1" pathLength="100" />
												<circle class="fill" cx="7" cy="7" r="6.1" pathLength="100" stroke-dasharray={`${l.used} 100`} />
											</svg>
											<span class="limit-name">{l.name}</span>
											<span class="limit-words">{`${l.used}% · ${l.resets}`}</span>
										</div>
									))
								}
							</div>
						</div>
					</span>
					<span class="chip mode" aria-hidden="true">
						<span class="mode-words">Asks when it's risky</span>
						<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
					</span>
				</span>
			</div>
			<div class="winctl" aria-hidden="true">
				<span><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14"></path></svg></span>
				<span><svg class="i" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg></span>
				<span class="close"><svg class="i" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"></path></svg></span>
			</div>
		</div>

		<!-- Another agent's thread with Juniper, opened from its row in the sidebar in the chat's
		     place, under a strip that says whose it is, with the way back (app.rs, branch_strip). -->
		<div class="strip-wrap">
			<div class="strip">
				<button type="button" class="strip-back" data-back aria-label="Back to the chat"
					><svg class="i" viewBox="0 0 24 24"><path d="m12 19-7-7 7-7M19 12H5"></path></svg></button
				>
				<svg data-thread data-color="apricot" data-shape="star" width="18" height="22" class="strip-mark" aria-hidden="true"></svg>
				<span class="strip-title">From Biscuit</span>
			</div>
		</div>
		<div class="chat">
			<div class="msgs asked" aria-live="off">
				<div class="time-line">Today 08:47</div>
				<div class="row from-agent" style="--from: var(--thread-apricot)">
					<div class="from-who"><svg class="mention-thread" viewBox="0 0 14 14" aria-hidden="true"><path d={BISCUIT}></path></svg>Biscuit</div>
					<div class="from-bubble">The billing fix is ready. It needs a review before 2.4 goes out.</div>
				</div>
				<div class="row reply">
