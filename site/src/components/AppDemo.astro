<style>
	/* The window, as the app is: 1120 wide by default, every size from the tokens. */
	.app {
		--tint: var(--thread-sky);
		position: relative;
		display: flex;
		height: 640px;
		max-width: 1120px;
		margin: 0 auto;
		overflow: hidden;
		text-align: left;
		background: var(--bg);
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		box-shadow: var(--shadow);
		font-size: var(--size-body);
		line-height: 1.618;
		color: var(--ink);
		user-select: none;
		-webkit-user-select: none;
		cursor: default;
	}
	.i {
		width: 14px;
		height: 14px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.chev {
		width: 12px;
		height: 12px;
		color: var(--ink-3);
	}
	.icon-btn {
		display: grid;
		place-items: center;
		border-radius: var(--radius-row);
		color: var(--ink-2);
		transition: background-color 0.12s;
	}
	.icon-btn:hover {
		background: var(--hover);
	}
	button {
		font: inherit;
		color: inherit;
		background: none;
		border: 0;
		padding: 0;
	}

	/* The sidebar, and the rail it collapses to, its width easing between the two. */
	.side {
		display: flex;
		flex-direction: column;
		width: var(--layout-sidebar);
		flex: none;
		overflow: hidden;
		background: var(--side);
		border-right: 1px solid var(--line);
		transition: width 0.22s cubic-bezier(0.2, 0.7, 0.3, 1);
	}
	.side-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--layout-titlebar);
		padding: 0 12px 0 16px;
		flex: none;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: var(--weight-semibold);
		white-space: nowrap;
	}
	.side-tools {
		display: flex;
		gap: 2px;
	}
	.icon-btn.small {
		width: var(--control-icon-small);
		height: var(--control-icon-small);
	}
	.bar {
		color: var(--ink-3);
		cursor: pointer;
	}
	.bar:hover {
		color: var(--ink);
	}
	/* On the rail it's always the control that opens the sidebar. */
	.bar .open,
	.app.railed .bar .shut {
		display: none;
	}
	.app.railed .bar .open {
		display: block;
	}
	/* One column the sidebar's width: a long status after a name cuts off with an
	   ellipsis instead of widening the list and pushing the tiles right. */
	.list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-content: start;
		gap: 2px;
		flex: 1;
		padding: 12px 8px 0;
	}
	.agent {
		display: flex;
		align-items: center;
		min-width: 0;
		gap: 12px;
		padding: 8px 12px;
		border-radius: var(--radius-row);
		transition: background-color 0.12s;
	}
	.agent:hover {
		background: var(--hover);
	}
	.agent.on {
		background: var(--active);
	}
	/* An agent's thread, 10 tall, or 22 in its shape; a group chat's weave keeps its own 26 by 14. */
	.agent svg {
		flex: none;
	}
	.agent svg[data-thread] {
		width: 26px;
		height: 10px;
	}
	.agent svg[data-thread][data-shape] {
		height: 22px;
	}
	/* One line whatever the agent is doing, as in the app: what it's on sits quietly
	   after its name, so a row never changes height. */
	.agent-text {
		display: flex;
		align-items: center;
		gap: 8px;
		flex: 1;
		min-width: 0;
	}
	.agent-name {
		flex: 1;
		min-width: 0;
		font-weight: var(--weight-medium);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.agent-preview {
		min-width: 0;
		max-width: 55%;
		font-size: var(--size-caption);
		color: var(--ink-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.agent-preview:empty {
		display: none;
	}
	/* A group's head (app.rs, group_head): its name, small and quiet, with a chevron when it
	   opens and shuts. */
	.group-head {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-top: 8px;
		padding: 4px 12px;
		font-size: var(--size-caption);
		font-weight: var(--weight-medium);
		color: var(--ink-3);
	}
	.group-head .i {
		width: 12px;
		height: 12px;
	}
	.app.railed .group-head {
		display: none;
	}
	/* The thin line between the tiles and the list (app.rs, side_line). */
	.side-line {
		height: 1px;
		margin: 4px 8px 6px;
		background: var(--line);
	}
	/* The list's last row, quiet, which opens New group chat, New agent and New folder. */
	.new-row {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 12px;
		border-radius: var(--radius-row);
		color: var(--ink-3);
		transition:
			background-color 0.12s,
			color 0.12s;
	}
	.new-row:hover {
		background: var(--hover);
		color: var(--ink);
	}
	.new-row .i {
		width: 26px;
		height: 14px;
		flex: none;
	}
	/* A row dragged to a new place (app.rs, droppable): it fades where it was, lifted beside
	   the pointer, and a line in the accent shows where it lands; over a folder's name, it goes
	   in. */
	.list > .agent {
		cursor: grab;
	}
	.list > .agent.dragging {
		opacity: 0.35;
	}
	.list > .drop-before {
		box-shadow: 0 -2px 0 var(--drop);
	}
	.list > .drop-after {
		box-shadow: 0 2px 0 var(--drop);
	}
	.group-head.folder.drop-in {
		border-radius: var(--radius-row);
		background: var(--hover);
		color: var(--ink);
	}
	.agent.ghost {
		position: fixed;
		top: -200px;
		left: 0;
		background: var(--raised-2);
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
	}
	/* A group chat's row: its members' threads woven, and its name. */
	.weave path {
		fill: none;
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.room {
		cursor: pointer;
	}
	/* The Shop group chat, open in the chat's place: its row lit, its head, its messages and
	   "Message Shop" in the composer. A group chat has no brain or mode of its own: its header
	   has its pins and the context of the member that answered last (app.rs, header). */
	.room-btn,
	.msgs.room,
	.msgs.moss,
	.room-ph,
	.app.in-room .agent-btn,
	.app.in-room :is(.chip.brain, .chip.mode),
	.app.in-room .msgs.mine,
	.app.in-room .agent-ph,
	.app.in-moss .msgs.mine {
		display: none;
	}
	.app.in-room .msgs.room,
	.app.in-moss .msgs.moss {
		display: block;
	}
	/* Moss's chat, open in the chat's place: its row lit, Juniper's not. Another agent's
	   thread with Juniper is a row under Juniper only while Juniper is open. */
	.app.in-moss .agent.on {
		background: none;
	}
	.app.in-moss .agent[data-agent='Moss'] {
		background: var(--active);
	}
	.app:is(.in-room, .in-moss) .ask {
		display: none;
	}
	.pins-at[hidden] {
		display: none;
	}
	.app.in-room .room-ph {
		display: inline;
	}
	.app.in-room .typed:not(:empty) ~ .room-ph {
		display: none;
	}
	.app.in-room .agent.on {
		background: none;
	}
	.app.in-room .room[data-room='Shop'] {
		background: var(--active);
	}
	.room-btn {
		align-items: center;
		gap: 8px;
		border-radius: var(--radius-row);
		padding: 4px 8px;
		font-weight: var(--weight-medium);
		white-space: nowrap;
	}
	.app.in-room .room-btn {
		display: inline-flex;
	}
	.room-count {
		font-size: var(--size-caption);
		font-weight: var(--weight-regular);
		color: var(--ink-3);
	}
	/* The line over a reply in a group chat, in its name's place: "→ Biscuit · invoices",
	   quiet, with the agent's thread in its shape and its name in its colour. A click offers
	   the chat's other members to send the message to instead. */
	.routed {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: var(--size-caption);
		line-height: 1.4;
		color: var(--ink-3);
		cursor: pointer;
	}
	.routed-who {
		display: inline-flex;
		align-items: center;
		font-weight: var(--weight-medium);
		color: color-mix(in srgb, var(--from) 70%, var(--ink-3));
	}
	.routed-who .mention-thread {
		margin-right: 4px;
	}
	/* Another agent's thread with the open one, under its row (app.rs, ask_row): the
	   asker's thread, small, and "From NAME". */
	.ask {
		display: flex;
		align-items: center;
		min-width: 0;
		gap: 12px;
		padding: 4px 12px 4px 20px;
		border-radius: var(--radius-row);
		font-size: var(--size-caption);
		color: var(--ink-2);
		transition: background-color 0.12s;
	}
	.ask:hover {
		background: var(--hover);
	}
	.ask svg {
		width: 18px;
		height: 22px;
		flex: none;
	}
	.ask-name {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* The pinned agents over the rest: tiles three across, the row centred and a fourth on a
	   centred row of its own, each with its thread drawn large in its shape and its name under it. */
	.pins {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4px;
		margin-bottom: 6px;
	}
	.pins:empty {
		display: none;
	}
	.tile {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		width: 78px;
		height: 78px;
		padding: 0 8px;
		border-radius: var(--radius-card);
		background: var(--raised);
		transition: background-color 0.12s;
	}
	.tile:hover {
		background: var(--raised-2);
	}
	.tile.on {
		background: var(--active);
	}
	.tile svg {
		width: 52px;
		height: 36px;
		flex: none;
	}
	.tile-name {
		max-width: 100%;
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		color: var(--ink-2);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tile.on .tile-name {
		color: var(--ink);
	}
	.side-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 4px;
		padding: 8px;
		flex: none;
	}
	.server {
		display: flex;
		align-items: center;
		gap: 12px;
		flex: 1;
		min-width: 0;
		height: var(--control-server);
		padding: 0 8px;
		border-radius: var(--radius-row);
		transition: background-color 0.12s;
	}
	.server:hover {
		background: var(--hover);
	}
	.server svg {
		width: 32px;
		height: 32px;
		flex: none;
	}
	.server-text {
		display: grid;
		line-height: 1.45;
		white-space: nowrap;
	}
	.server-name {
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
	}
	.server-state {
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.gear {
		width: var(--control-icon-large);
		height: var(--control-icon-large);
		flex: none;
		color: var(--ink-3);
	}
	.gear .i {
		width: 16px;
		height: 16px;
	}

	/* The rail: the control that opens the sidebar, each agent as its thread, and at the foot
	   the gear over the server's yarn. */
	.app.railed .side {
		width: var(--layout-rail);
	}
	.app.railed .side-top {
		justify-content: center;
		padding: 0;
	}
	/* The rail lists the agents and group chats alone, as the app's does. */
	.app.railed .ask {
		display: none;
	}
	.app.railed :is(.brand, .new-row, .side-line, .agent-text, .tile-name, .server-text) {
		display: none;
	}
	.app.railed .list {
		justify-items: center;
		padding: 4px 0 0;
	}
	/* On the rail a pinned agent is its thread, as every agent is, first, with a short line
	   under them, then the list, a group chat its woven threads, and a short line before a
	   folder's agents. */
	.app.railed .pins {
		display: grid;
		justify-items: center;
		gap: 2px;
		margin: 0;
	}
	.app.railed .pins::after,
	.app.railed .group-head.folder {
		content: '';
		display: block;
		width: 16px;
		height: 1px;
		margin: 4px 0;
		padding: 0;
		overflow: hidden;
		font-size: 0;
		background: var(--line-strong);
	}
	.app.railed .group-head.folder .i {
		display: none;
	}
	.app.railed :is(.agent, .tile) {
		width: 40px;
		height: 40px;
		padding: 0;
		justify-content: center;
	}
	.app.railed .tile:not(.on) {
		background: none;
	}
	.app.railed .tile:not(.on):hover {
		background: var(--hover);
	}
	.app.railed .tile {
		border-radius: var(--radius-row);
	}
	.app.railed .tile svg {
		width: 26px;
		height: 18px;
	}
	.app.railed .side-foot {
		flex-direction: column-reverse;
		padding: 0 0 8px;
	}
	.app.railed .server {
		flex: none;
		width: var(--control-server);
		padding: 0;
		justify-content: center;
	}

	/* The title bar, with the agent's header in it, over the chat only. */
	.main {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
	}
	.titlebar {
		display: flex;
		align-items: center;
		height: var(--layout-titlebar);
		border-bottom: 1px solid var(--line);
		flex: none;
	}
	/* What's in it never reaches past it, into the window's buttons. Its popovers hang from the
	   window, not from it, so they aren't cut. */
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex: 1;
		min-width: 0;
		align-self: stretch;
		padding: 0 16px;
		overflow: hidden;
	}
	/* In a narrow window it gives way as the app's does (desktop/src/model/header.rs): demo.ts
	   takes one step at a time, always in this order, until it fits: the brain chip drops its
	   effort, a group chat's head how many are in it, the brain chip shows only its icon, the
	   chips close up, and the chevrons go. Then the name shortens to a few letters, and then
	   the mode's words. */
	.header.fit-effort .brain-effort,
	.header.fit-members .room-count,
	.header.fit-icon .chip.brain :is(.brain-words, .chev),
	.header.fit-chevrons :is(.agent-btn, .chip.mode) .chev {
		display: none;
	}
	.header.fit-close,
	.header.fit-close .chips {
		gap: 8px;
	}
	.header.fit-close .context-at {
		margin-left: -4px;
	}
	/* Nothing in it shrinks by itself: demo.ts gives the name and the mode's words their
	   widths once every step is taken (model::header::fit). */
	.header > *,
	.agent-btn > svg,
	.room-btn > svg,
	.chips > * {
		flex: none;
	}
	.head-name,
	.mode-words {
		display: block;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.agent-btn,
	.chip {
		display: inline-flex;
		align-items: center;
		border-radius: var(--radius-row);
		padding: 4px 8px;
		white-space: nowrap;
		transition: background-color 0.12s;
	}
	.agent-btn:hover,
	.chip:hover {
		background: var(--hover);
	}
	.agent-btn {
		gap: 8px;
		font-weight: var(--weight-medium);
	}
	.agent-btn svg[data-thread] {
		width: 26px;
		height: 10px;
	}
	.chips {
		display: flex;
		align-items: center;
		gap: 16px;
		min-width: 0;
	}
	.chip {
		gap: 4px;
		font-size: var(--size-caption);
		color: var(--ink-2);
	}
	.chip.brain {
		gap: 6px;
	}
	/* The program's icon from the ACP Registry, drawn in the chip's ink, as the app draws it. */
	.brain-icon {
		width: 12px;
		height: 12px;
		flex: none;
		background: currentColor;
		-webkit-mask: var(--icon) center / contain no-repeat;
		mask: var(--icon) center / contain no-repeat;
	}
	.winctl {
		display: flex;
		gap: 2px;
		padding: 0 8px;
	}
	.winctl span {
		display: grid;
		place-items: center;
		width: 34px;
		height: 28px;
		border-radius: var(--radius-row);
		color: var(--ink-3);
		transition:
			background-color 0.12s,
			color 0.12s;
	}
	.winctl span:hover {
		background: var(--hover);
		color: var(--ink);
	}
	.winctl .close:hover {
		background: var(--bad);
		color: #fff;
	}

	/* On a Mac (html[data-os], set in Base.astro), the Mac app's window: its traffic lights
	   where the app puts them (desktop/src/app.rs, LIGHTS), the knot after them, and no
	   buttons at the title bar's end. */
	.lights {
		display: none;
		position: absolute;
		top: 17px;
		left: 16px;
		gap: 9px;
		z-index: 1;
	}
	.lights i {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: #ff5f57;
		box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.15);
	}
	.lights i:nth-child(2) {
		background: #febc2e;
	}
	.lights i:nth-child(3) {
		background: #28c840;
	}
	:global(html[data-os='mac']) .lights {
		display: flex;
	}
	:global(html[data-os='mac']) .side-top {
		padding-left: 92px;
	}
	:global(html[data-os='mac']) .winctl {
		display: none;
	}
	/* With the sidebar put away, the lights reach past the rail, so the title bar crosses the
	   window over it, with the control that opens the sidebar after the lights, and the rail
	   begins under it. */
	:global(html[data-os='mac']) .app.railed .side {
		background: none;
		border-right: 0;
	}
	:global(html[data-os='mac']) .app.railed .side-top {
		border-bottom: 1px solid var(--line);
	}
	:global(html[data-os='mac']) .app.railed :is(.list, .side-foot) {
		background: var(--side);
		border-right: 1px solid var(--line);
	}
	:global(html[data-os='mac']) .app.railed .bar {
		position: absolute;
		top: 11px;
		left: 86px;
	}
	:global(html[data-os='mac']) .app.railed .header {
		padding-left: 60px;
	}

	/* The chat: a column 740 wide at most, newest at the bottom. */
	.chat {
		position: relative;
		flex: 1;
		min-height: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 0 24px;
	}
	/* The column leaves each row's hover strip beside it, where its time and buttons are,
	   inside the chat (app.rs, ROW_SIDE: 70 from the chat's edge). */
	.msgs {
		width: 100%;
		max-width: min(var(--space-column), calc(100% - 92px));
		margin: 0 auto;
		padding-bottom: 8px;
	}
	@media (max-width: 640px) {
		.msgs {
			max-width: none;
		}
	}
	/* Across the chat where it paused, or on a new day: when it went on. */
	.time-line {
		padding: 8px 0 4px;
		text-align: center;
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.row {
		padding: 4px 0 8px;
	}
	.row.fresh {
		animation: rise 0.28s cubic-bezier(0.2, 0.7, 0.3, 1) both;
	}
	/* A scene's message before it's sent (demo.ts). */
	.row.unsent {
		display: none;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}
	.you {
		display: flex;
		justify-content: flex-end;
	}
	/* What the person wrote: the bubble grey with a breath of the agent's colour, a little more
	   in the dark, as the app draws it by default (Vibrant bubbles, the colour itself, is a
	   choice in its settings). */
	.bubble {
		max-width: 520px;
		padding: 10px 16px;
		border-radius: var(--radius-bubble);
		background: color-mix(in srgb, var(--tint) 7%, var(--bubble));
		overflow-wrap: anywhere;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .bubble {
			background: color-mix(in srgb, var(--tint) 12%, var(--bubble));
		}
	}
	:root[data-theme='dark'] .bubble {
		background: color-mix(in srgb, var(--tint) 12%, var(--bubble));
	}
	.reply {
		display: flex;
		gap: 12px;
	}
	/* Beside the agent's name over the first reply after a time line, and level with the
	   bubble's first line beside the rest. */
	.reply-thread {
		width: 14px;
		height: 10px;
		flex: none;
		margin-top: 16px;
	}
	.reply-thread.head {
		margin-top: 4px;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
		flex: 1;
	}
	.who {
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		line-height: 1.4;
	}
	/* The answer: a grey bubble, never the agent's colour, which is the person's. Its corner
	   by the thread is squared off as a speech bubble's tail. */
	.said {
		align-self: flex-start;
		max-width: 94%;
		padding: 10px 16px;
		border-radius: var(--radius-bubble-joined) var(--radius-bubble) var(--radius-bubble) var(--radius-bubble);
		background: var(--bubble);
		line-height: var(--line-reply);
	}
	.said:empty {
		display: none;
	}
	.said :global(p + p) {
		margin-top: 12px;
	}
	/* A link: its site's icon before it, underlined, its whole address on hover. */
	/* An agent a message mentions (desktop/src/app.rs, linked_words): its thread and its name in
	   its colour, a little weathered toward the quiet ink, with nothing behind it. It opens the
	   agent's chat, with the hand and a light background of its colour under the pointer. */
	.mention {
		color: color-mix(in srgb, var(--from) 70%, var(--ink-3));
		font-weight: var(--weight-medium);
		white-space: nowrap;
		cursor: pointer;
		border-radius: 4px;
		padding: 0 2px;
		margin: 0 -2px;
		transition: background-color 120ms ease;
	}
	.mention:hover {
		background: color-mix(in srgb, var(--from) 14%, transparent);
	}
	.mention-thread {
		display: inline-block;
		width: 14px;
		height: 14px;
		margin-right: 3px;
		fill: none;
		stroke: color-mix(in srgb, var(--from) 70%, var(--ink-3));
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		vertical-align: -2px;
	}
	/* A message another agent sent (app.rs, person): on the person's side, a breath of the
	   sender's colour, with its thread and name over it. */
	.from-agent {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 4px;
	}
	.from-who {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: var(--size-caption);
		font-weight: var(--weight-medium);
		color: color-mix(in srgb, var(--from) 70%, var(--ink-3));
	}
	.from-who .mention-thread {
		margin: 0;
		stroke: currentColor;
	}
	.from-bubble {
		max-width: 520px;
		padding: 10px 16px;
		border-radius: var(--radius-bubble);
		background: color-mix(in srgb, var(--from) 10%, var(--bubble));
		overflow-wrap: anywhere;
	}
	.link {
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-color: var(--line-strong);
		white-space: nowrap;
	}
	.site-icon {
		width: 14px;
		height: 14px;
		flex: none;
		border-radius: 3px;
	}
	.site-icon.gh {
		fill: var(--ink);
	}
	.link .site-icon {
		display: inline-block;
		vertical-align: -2px;
		margin-right: 4px;
	}
	/* An Acta card a message names (PLAN.md, "Cards in messages"; app.rs, card_pill): its
	   board's tile, its id in mono, its title cut to fit and a dot in its status's colour, on
	   the bubble's fill with a line around it. Under the pointer, or focused by a tap, its
	   preview opens under it (app.rs, card_preview), and stays while the pointer is on it. */
	.acta-pill {
		position: relative;
		display: inline-block;
		max-width: 100%;
		outline: none;
	}
	.acta-face {
		display: inline-block;
		box-sizing: border-box;
		max-width: 100%;
		height: var(--control-pill);
		padding: 0 7px 0 4px;
		line-height: 20px;
		border: 1px solid var(--line);
		border-radius: var(--radius-row);
		background: var(--bubble);
		white-space: nowrap;
		cursor: pointer;
	}
	.acta-tile {
		display: inline-block;
		width: 14px;
		height: 14px;
		margin-right: 5px;
		vertical-align: -2px;
		fill: var(--board);
	}
	.acta-tile g {
		fill: none;
		stroke: #f4f1fc;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.acta-id {
		margin-right: 5px;
		font-family: var(--mono);
		font-size: var(--size-caption);
		color: var(--ink-2);
	}
	.acta-title {
		display: inline-block;
		max-width: min(var(--layout-pill-title), 40vw);
		overflow: hidden;
		text-overflow: ellipsis;
		vertical-align: top;
		font-size: var(--size-small);
		color: var(--ink);
	}
	.acta-dot {
		display: inline-block;
		width: 7px;
		height: 7px;
		margin-left: 5px;
		border-radius: 50%;
		background: var(--status);
		vertical-align: 1px;
	}
	.acta-preview {
		position: absolute;
		left: 0;
		top: calc(100% + 4px);
		z-index: 6;
		display: none;
		flex-direction: column;
		gap: var(--space-s);
		box-sizing: border-box;
		width: var(--layout-card-preview);
		max-width: calc(100vw - 64px);
		padding: var(--space-m);
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-card);
		box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.1);
		line-height: var(--line-body);
		white-space: normal;
		cursor: default;
	}
	/* The gap to the pill, so the pointer crossing it keeps the preview open. */
	.acta-preview::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: -6px;
		height: 6px;
	}
	.acta-preview.up {
		top: auto;
		bottom: calc(100% + 4px);
	}
	.acta-preview.up::before {
		top: auto;
		bottom: -6px;
	}
	.acta-pill:hover .acta-preview,
	.acta-pill:focus .acta-preview {
		display: flex;
	}
	.cp-place {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.cp-place .acta-tile {
		margin: 0;
	}
	.cp-title {
		font-size: var(--size-body);
		font-weight: var(--weight-semibold);
		color: var(--ink);
	}
	.cp-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.cp-chip {
		display: inline-flex;
		align-items: center;
		height: 20px;
		padding: 0 8px;
		border: 1px solid var(--line-strong);
		border-radius: 10px;
		font-size: var(--size-caption);
		color: var(--ink-2);
		white-space: nowrap;
	}
	.cp-status {
		color: var(--status);
		border-color: color-mix(in srgb, var(--status) 60%, transparent);
	}
	.cp-text {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: var(--size-small);
		color: var(--ink-2);
	}
	.cp-subtasks {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: var(--size-caption);
		color: var(--ink-3);
		white-space: nowrap;
	}
	.cp-bar {
		flex: 1;
		height: 4px;
		border-radius: 2px;
		background: var(--line-strong);
		overflow: hidden;
	}
	.cp-bar span {
		display: block;
		height: 100%;
		border-radius: 2px;
		background: var(--ok);
	}
	.cp-buttons {
		display: flex;
		gap: var(--space-s);
		padding-top: 2px;
	}
	.cp-button {
		display: inline-flex;
		align-items: center;
		height: 28px;
		padding: 0 10px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-button);
		font-size: var(--size-caption);
		font-weight: var(--weight-medium);
		color: var(--ink);
		cursor: pointer;
		transition: background-color 120ms ease;
	}
	.cp-button:hover {
		background: var(--hover);
	}
	/* A card's side preview beside the chat (acta_ui.rs, card_side): the head with the
	   board's tile, board · id in mono and close; the title as a heading, the chips, the
	   description, the subtasks with their ticks and the last comments; Open in Acta and
	   Follow at the foot. 36% of the window, as the app's panel beside the chat. */
	.acta-side {
		display: flex;
		flex-direction: column;
		width: 36%;
		min-width: 300px;
		max-width: 400px;
		flex: none;
		border-left: 1px solid var(--line);
		background: var(--bg);
	}
	.acta-side[hidden] {
		display: none;
	}
	.as-head {
		display: flex;
		align-items: center;
		gap: var(--space-s);
		height: var(--layout-titlebar);
		padding: 0 var(--space-l);
		flex: none;
	}
	.as-head .acta-tile {
		width: 16px;
		height: 16px;
		margin: 0;
	}
	.as-place {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: var(--mono);
		font-size: var(--size-small);
		color: var(--ink-2);
	}
	.as-close {
		width: var(--control-icon);
		height: var(--control-icon);
		color: var(--ink-3);
		cursor: pointer;
	}
	.as-body {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
		padding: var(--space-s) var(--space-l) var(--space-xl);
	}
	.as-title {
		font-size: var(--size-heading);
		line-height: 1.3;
		font-weight: var(--weight-semibold);
		color: var(--ink);
	}
	.as-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.as-chip {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		height: 22px;
		padding: 0 8px;
		border: 1px solid var(--line-strong);
		border-radius: 11px;
		font-size: var(--size-caption);
		color: var(--ink-2);
		white-space: nowrap;
	}
	.as-chip .i {
		width: 12px;
		height: 12px;
	}
	.as-status {
		color: var(--status);
		border-color: color-mix(in srgb, var(--status) 60%, transparent);
		cursor: pointer;
	}
	.as-status-at {
		position: relative;
	}
	.as-menu {
		position: absolute;
		left: 0;
		top: 26px;
		z-index: 7;
		display: flex;
		flex-direction: column;
		width: 180px;
		padding: var(--space-xs);
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-card);
		box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.25);
	}
	.as-menu[hidden] {
		display: none;
	}
	.as-menu button {
		display: flex;
		align-items: center;
		gap: var(--space-s);
		padding: 6px var(--space-m);
		border-radius: var(--radius-row);
		font-size: var(--size-small);
		text-align: left;
		cursor: pointer;
	}
	.as-menu button:hover {
		background: var(--hover);
	}
	.as-menu i {
		width: 7px;
		height: 7px;
		border-radius: 50%;
	}
	.as-menu .on::after {
		content: '✓';
		margin-left: auto;
		color: var(--ink-2);
	}
	.as-text {
		font-size: var(--size-body);
		line-height: var(--line-body);
		color: var(--ink);
	}
	.as-text p,
	.as-text ul {
		margin: 0 0 8px;
	}
	.as-text ul {
		padding-left: 20px;
	}
	.as-label {
		padding-bottom: var(--space-xs);
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		color: var(--ink-2);
	}
	.as-subtasks,
	.as-comments {
		display: flex;
		flex-direction: column;
	}
	.as-comments {
		gap: var(--space-m);
	}
	.as-tick {
		display: flex;
		align-items: flex-start;
		gap: var(--space-s);
		padding: 5px var(--space-xs);
		border-radius: var(--radius-row);
		font-size: var(--size-small);
		line-height: var(--line-body);
		text-align: left;
		color: var(--ink);
		cursor: pointer;
	}
	.as-tick:hover {
		background: var(--hover);
	}
	.as-box {
		display: grid;
		place-items: center;
		width: 16px;
		height: 16px;
		margin-top: 2px;
		flex: none;
		box-sizing: border-box;
		border: 1px solid var(--line-strong);
		border-radius: 4px;
		color: var(--bg);
	}
	.as-box .i {
		width: 11px;
		height: 11px;
		visibility: hidden;
	}
	.as-tick.done {
		color: var(--ink-3);
	}
	.as-tick.done .as-box {
		background: var(--ok);
		border-color: var(--ok);
	}
	.as-tick.done .as-box .i {
		visibility: visible;
	}
	.as-who {
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.as-comment p {
		margin: 2px 0 0;
		font-size: var(--size-small);
		line-height: var(--line-body);
		color: var(--ink);
	}
	.as-foot {
		display: flex;
		gap: var(--space-s);
		padding: var(--space-m) var(--space-l);
		border-top: 1px solid var(--line);
		flex: none;
	}
	.as-foot .cp-button {
		height: var(--control-button);
		padding: 0 var(--space-l);
		font-size: var(--size-small);
	}
	/* Follow with its bell, and Following with a tick (acta_ui.rs, follow_button). */
	.as-follow {
		gap: 6px;
		background: none;
		font-family: inherit;
	}
	.as-follow .i {
		width: 12px;
		height: 12px;
	}
	.as-follow .i-check,
	.as-follow[aria-pressed='true'] .i-bell {
		display: none;
	}
	.as-follow[aria-pressed='true'] .i-check {
		display: block;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .acta-preview {
			box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.55);
		}
	}
	:root[data-theme='dark'] .acta-preview {
		box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.55);
	}

	/* Another agent's thread with the open one (app.rs, branch_strip): in the chat's place,
	   with a strip over it that says whose it is, the asker's thread beside its name, and the
	   arrow back to the person's own chat. */
	.strip-wrap {
		display: none;
		padding: 8px 24px 0;
		flex: none;
	}
	.app.in-thread .strip-wrap {
		display: block;
	}
	.strip {
		display: flex;
		align-items: center;
		gap: 12px;
		max-width: var(--space-column);
		margin: 0 auto;
		padding: 8px 12px;
		border: 1px solid var(--line);
		border-radius: var(--radius-button);
	}
	.strip-back {
		display: grid;
		place-items: center;
		width: var(--control-icon);
		height: var(--control-icon);
		flex: none;
		border-radius: var(--radius-row);
		color: var(--ink-2);
		cursor: pointer;
		transition:
			background-color 0.12s,
			color 0.12s;
	}
	.strip-back:hover {
		background: var(--hover);
		color: var(--ink);
	}
	.strip-mark {
		width: 18px;
		height: 22px;
		flex: none;
	}
	.strip-title {
		min-width: 0;
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.msgs.asked,
	.app.in-thread .msgs.mine {
		display: none;
	}
	.app.in-thread .msgs.asked {
		display: block;
	}
	/* While the thread is open, its row is the one lit, and the agent's own row takes you back. */
	.app.in-thread .agent.on {
		background: none;
		cursor: pointer;
	}
	.app.in-thread .agent.on:hover {
		background: var(--hover);
	}
	.ask {
		cursor: pointer;
	}
	.app.in-thread .ask {
		background: var(--active);
		color: var(--ink);
	}
	/* The thread is read only: in the composer's place, the way to the person's own chat
	   (app.rs, continue_button), as tall as the composer. */
	.continue-wrap {
		display: none;
		padding: 4px 24px 16px;
		flex: none;
	}
	.app.in-thread .composer-wrap {
		display: none;
	}
	.app.in-thread .continue-wrap {
		display: block;
	}
	.continue {
		display: grid;
		place-items: center;
		width: 100%;
		max-width: var(--space-column);
		height: calc(var(--control-icon-composer) + 18px);
		margin: 0 auto;
		border: 1px solid var(--line);
		border-radius: var(--radius-composer);
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		color: var(--ink-2);
		cursor: pointer;
		transition:
			background-color 0.12s,
			color 0.12s;
	}
	.continue:hover {
		background: var(--hover);
		color: var(--ink);
	}

	/* Replying (PLAN.md, "Replying to a message"). By a message's corner, just outside the
	   column, as the app has them (app.rs, chat_row): its pin, there while it's pinned and on
	   hover to pin it, then Reply and the ⋯ under it, on hover. */
	.msgs .row[data-msg] {
		position: relative;
		border-radius: var(--radius-bubble);
		transition: background-color 0.3s;
	}
	.pin-btn {
		position: absolute;
		top: 4px;
		right: -32px;
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		color: var(--ink-3);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.12s, background-color 0.12s, color 0.12s;
	}
	.pin-btn .i {
		width: 14px;
		height: 14px;
	}
	.row.pinned > .pin-btn {
		opacity: 1;
		color: var(--ink-2);
	}
	.row:hover > .pin-btn,
	.pin-btn:focus-visible {
		opacity: 1;
	}
	.pin-btn:hover {
		background: var(--hover);
		color: var(--ink);
	}
	.reply-btn {
		position: absolute;
		top: 32px;
		right: -32px;
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		color: var(--ink-3);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.12s, background-color 0.12s, color 0.12s;
	}
	.reply-btn .i,
	.more-btn .i {
		width: 14px;
		height: 14px;
	}
	/* Under Reply, the ⋯ that opens the message's menu. */
	.more-btn {
		position: absolute;
		top: 60px;
		right: -32px;
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		color: var(--ink-3);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.12s, background-color 0.12s, color 0.12s;
	}
	.row:hover > .reply-btn,
	.reply-btn:focus-visible,
	.row:hover > .more-btn,
	.more-btn:focus-visible {
		opacity: 1;
	}
	.reply-btn:hover,
	.more-btn:hover {
		background: var(--hover);
		color: var(--ink);
	}
	@media (max-width: 640px) {
		.pin-btn,
		.reply-btn,
		.more-btn {
			display: none;
		}
	}
	/* The Pinned popover (PLAN.md, "Pinned messages"; app.rs, pins_pop, pins_placed): over the
	   chat, which keeps its width, 8px under the header and centred under the header's pin as the
	   window lets it, 12px inside its edges, with a nub on the pin (demo.ts, placePins). It comes
	   in from the pin, growing a little as it fades in. */
	.pins-at {
		display: inline-flex;
	}
	.pins-btn {
		border: 0;
		background: transparent;
		font: inherit;
		font-size: var(--size-caption);
		color: var(--ink-2);
		cursor: pointer;
		font-variant-numeric: tabular-nums;
	}
	.pins-btn[aria-expanded='true'] {
		background: var(--hover);
		color: var(--ink);
	}
	.pins-pop {
		position: absolute;
		z-index: 20;
		top: calc(var(--layout-titlebar) + 8px);
		left: var(--pop-left, auto);
		right: 12px;
		width: var(--pop-width, var(--layout-pins));
		display: flex;
		transform-origin: var(--nub-in, 50%) -8px;
		animation: pins-in 0.16s cubic-bezier(0.2, 0.7, 0.3, 1);
		flex-direction: column;
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.35);
		overflow: hidden;
		text-align: left;
		white-space: normal;
		font-size: var(--size-body);
		color: var(--ink);
	}
	.pins-pop[hidden],
	.pins-pop[hidden] + .pp-nub {
		display: none;
	}
	/* The nub: a square turned 45°, its top half standing on the popover's edge over its line,
	   in its fill, with the line down its outer sides and its tip a little rounded. */
	.pp-nub {
		position: absolute;
		z-index: 21;
		top: calc(var(--layout-titlebar) + 8px + 0.5px - var(--layout-caret) / 2);
		left: calc(var(--nub-at, 0px) - var(--layout-caret) / 2);
		width: var(--layout-caret);
		height: var(--layout-caret);
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-right: 0;
		border-bottom: 0;
		border-top-left-radius: 2.5px;
		transform: rotate(45deg);
		animation: pins-nub-in 0.16s cubic-bezier(0.2, 0.7, 0.3, 1);
	}
	@keyframes pins-in {
		from {
			opacity: 0;
			transform: scale(0.96);
		}
	}
	@keyframes pins-nub-in {
		from {
			opacity: 0;
		}
	}
	.pp-head {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 12px 16px 10px;
		border-bottom: 1px solid transparent;
		transition: border-color 0.15s;
	}
	.pins-pop.scrolled .pp-head {
		border-bottom-color: var(--line);
	}
	.pp-title {
		font-weight: var(--weight-semibold);
	}
	.pp-count {
		color: var(--ink-3);
		font-size: 13px;
	}
	.pp-wrap {
		position: relative;
	}
	.pp-list {
		max-height: 380px;
		overflow-y: auto;
		padding: 0 8px 8px;
		display: flex;
		flex-direction: column;
		gap: 4px;
		overscroll-behavior: contain;
	}
	.pp-list:focus {
		outline: none;
	}
	.pin {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 8px 10px 10px 16px;
		border-radius: 8px;
		border: 1px solid transparent;
		transition: background-color 0.12s;
	}
	.pin::before {
		content: '';
		position: absolute;
		left: 6px;
		top: 10px;
		bottom: 10px;
		width: 2px;
		border-radius: 2px;
		background: var(--from, var(--ink-3));
		opacity: 0.75;
	}
	.pin:hover,
	.pin.lit {
		background: var(--hover);
	}
	.pin.lit {
		border-color: var(--line-strong);
	}
	.pin:focus {
		outline: none;
	}
	.pin-who {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 18px;
		font-size: var(--size-small);
	}
	.pin-who b {
		font-weight: var(--weight-medium);
	}
	.pin-who time {
		color: var(--ink-3);
		font-size: var(--size-caption);
	}
	.pin-who svg {
		width: 22px;
		height: 10px;
	}
	.pin-msg {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
	}
	.pin-msg .bubble,
	.pin-msg .said {
		max-width: 100%;
	}
	.pp-list[hidden] {
		display: none;
	}
	.pin-more {
		align-self: flex-start;
		margin: -2px 0 0 -4px;
		padding: 1px 4px;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		font: inherit;
		font-size: var(--size-small);
		color: var(--ink-3);
		cursor: pointer;
	}
	.pin-more:hover {
		background: var(--active);
		color: var(--ink);
	}
	.pin-acts {
		position: absolute;
		top: 4px;
		right: 6px;
		display: flex;
		align-items: center;
		gap: 2px;
		padding: 2px;
		border-radius: 8px;
		border: 1px solid var(--line-strong);
		background: var(--raised);
		box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.35);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.12s;
	}
	.pin:hover .pin-acts,
	.pin.lit .pin-acts,
	.pin:focus-within .pin-acts {
		opacity: 1;
		pointer-events: auto;
	}
	.pin-act {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 5px;
		height: 26px;
		min-width: 26px;
		padding: 0 6px;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		font: inherit;
		font-size: var(--size-caption);
		color: var(--ink-2);
		cursor: pointer;
	}
	.pin-act.jump {
		padding: 0 8px;
	}
	.pin-act:hover {
		background: var(--active);
		color: var(--ink);
	}
	.pin-act .i {
		width: 13px;
		height: 13px;
	}
	.pp-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		padding: 24px 24px 30px;
		text-align: center;
	}
	.pp-empty[hidden] {
		display: none;
	}
	.pp-empty b {
		font-weight: var(--weight-medium);
	}
	.pp-empty span:last-child {
		font-size: var(--size-small);
		color: var(--ink-3);
	}
	.pp-ring {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		margin-bottom: 4px;
		border-radius: 50%;
		background: var(--raised-2);
		color: var(--ink-3);
	}
	.pp-ring .i {
		width: 16px;
		height: 16px;
	}
	.pp-note {
		position: absolute;
		left: 50%;
		bottom: 12px;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 6px 6px 6px 12px;
		border-radius: 8px;
		background: var(--button);
		color: var(--button-ink);
		font-size: var(--size-small);
		white-space: nowrap;
		box-shadow: 0 8px 24px -10px rgb(0 0 0 / 0.5);
	}
	.pp-note[hidden] {
		display: none;
	}
	.pp-note.copied {
		padding-right: 12px;
	}
	.pp-note button {
		height: 24px;
		padding: 0 8px;
		border: 0;
		border-radius: var(--radius-row);
		background: color-mix(in srgb, var(--button-ink) 14%, transparent);
		color: var(--button-ink);
		font: inherit;
		font-weight: var(--weight-medium);
		cursor: pointer;
	}
	@media (max-width: 640px) {
		.pins-pop {
			position: fixed;
			top: auto;
			left: 16px;
			right: 16px;
			bottom: 16px;
			width: auto;
			transform-origin: 50% 100%;
		}
		.pp-nub {
			display: none;
		}
	}
	.msg-menu {
		position: absolute;
		z-index: 5;
		display: flex;
		flex-direction: column;
		width: 200px;
		padding: 4px;
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-card);
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
	}
	.msg-menu button {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 8px;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: var(--size-small);
		text-align: left;
		cursor: pointer;
	}
	.msg-menu button:hover,
	.msg-menu button.lit {
		background: var(--hover);
	}
	.msg-menu .i {
		width: 14px;
		height: 14px;
		color: var(--ink-2);
	}
	.msg-menu .danger,
	.msg-menu .danger .i {
		color: var(--bad);
	}
	.menu-line {
		height: 1px;
		margin: 4px 0;
		background: var(--line);
	}
	/* What's left of a deleted message: a quiet line where it was, on its sender's side. */
	.row.deleted > :not(.gone) {
		display: none;
	}
	.gone {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: var(--size-small);
		color: var(--ink-3);
	}
	.row.you .gone {
		margin-left: auto;
	}
	.row.reply .gone {
		padding-left: 26px;
	}
	.gone .i {
		width: 12px;
		height: 12px;
	}
	/* Lit for a moment, once Jump in the pins went to it. */
	.msgs .row.lit {
		background: color-mix(in srgb, var(--tint) 10%, transparent);
	}
	.rb-head {
		font-size: var(--size-caption);
		font-weight: 500;
		color: var(--q, var(--tint));
	}
	/* Over the composer's words while a reply is written, with its ×. */
	.reply-bar {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-left: 4px;
		padding-left: 8px;
		border-left: 2px solid var(--q, var(--tint));
	}
	.reply-bar[hidden] {
		display: none;
	}
	.rb-text {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
	}
	.rb-words {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: var(--size-small);
		color: var(--ink-2);
	}
	.rb-x {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		color: var(--ink-3);
		cursor: pointer;
	}
	.rb-x:hover {
		background: var(--hover);
		color: var(--ink);
	}
	.rb-x .i {
		width: 14px;
		height: 14px;
	}
	/* Words selected in a message: Copy, Quote and Ask about this, where the selection ended. */
	.picked {
		position: absolute;
		z-index: 5;
		display: flex;
		gap: 2px;
		padding: 2px;
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-card);
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
	}
	.picked button {
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 4px 8px;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: var(--size-small);
		white-space: nowrap;
		cursor: pointer;
	}
	.picked button:hover {
		background: var(--hover);
	}
	.picked .i {
		width: 14px;
		height: 14px;
		color: var(--ink-2);
	}

	/* The card frame's fills (app.rs, card_fill, card_inset, card_shadow), for every card in
	   the chat: raised in the dark, the page's own in the light. */
	.app {
		--card-fill: var(--raised);
		--card-inset: var(--bg);
		--card-edge: var(--line);
		--card-shadow: 0 10px 28px -16px rgb(0 0 0 / 0.55);
	}
	@media (prefers-color-scheme: light) {
		:root:not([data-theme='dark']) .app {
			--card-fill: var(--bg);
			--card-inset: var(--raised);
			--card-edge: var(--line-strong);
			--card-shadow: 0 10px 28px -16px rgb(0 0 0 / 0.1);
		}
	}
	:root[data-theme='light'] .app {
		--card-fill: var(--bg);
		--card-inset: var(--raised);
		--card-edge: var(--line-strong);
		--card-shadow: 0 10px 28px -16px rgb(0 0 0 / 0.1);
	}
	/* A T3 thread's card: the card frame, its edge lightly in sky while the thread works. */
	.t3 {
		--tone: var(--thread-sky);
		display: flex;
		flex-direction: column;
		gap: 12px;
		max-width: 600px;
		padding: 16px;
		background: var(--card-fill);
		border: 1px solid color-mix(in srgb, var(--tone) 35%, transparent);
		border-radius: var(--radius-bubble);
		box-shadow: var(--card-shadow);
	}
	.t3[hidden] {
		display: none;
	}
	.t3.done {
		--tone: var(--ok);
		border-color: var(--card-edge);
	}
	.t3-head {
		display: flex;
		align-items: flex-start;
		gap: 12px;
	}
	/* Level with the title's first line, in the colour of where the thread is. */
	.t3-strand {
		flex: none;
		margin-top: 2px;
	}
	.t3 [data-thread] :global(path) {
		stroke: var(--tone) !important;
	}
	.t3-titles {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.t3-title {
		color: var(--ink);
		font-weight: var(--weight-semibold);
		line-height: 1.35;
	}
	.t3-sub {
		overflow: hidden;
		font-family: var(--mono);
		font-size: var(--size-caption);
		color: var(--ink-3);
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.t3-side {
		flex: none;
		font-size: var(--size-small);
		font-weight: var(--weight-semibold);
		color: var(--tone);
		line-height: 1.5;
	}
	.t3-step {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border: 1px solid var(--line);
		border-radius: var(--radius-row);
		background: var(--card-inset);
		font-size: var(--size-small);
		color: var(--ink-2);
	}
	.t3-step .prompt {
		font-family: var(--mono);
		color: var(--ink-3);
	}
	.t3-chips {
		display: none;
		gap: 8px;
	}
	.t3.done .t3-step {
		display: none;
	}
	.t3.done .t3-chips {
		display: flex;
	}
	.t3-chip {
		padding: 2px 8px;
		border: 1px solid var(--line);
		border-radius: var(--radius-row);
		background: var(--card-inset);
		font-family: var(--mono);
		font-size: var(--size-caption);
		color: var(--ink-2);
	}

	/* The composer: the reply bar over the words, then the + , the words and the buttons. */
	.composer-wrap {
		padding: 4px 24px 16px;
		flex: none;
	}
	.composer {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		max-width: var(--space-column);
		margin: 0 auto;
		padding: 8px 12px;
		background: var(--raised);
		border: 1px solid var(--line);
		border-radius: var(--radius-composer);
	}
	.composer-row {
		display: flex;
		align-items: flex-end;
		gap: 8px;
	}
	.icon-btn.c {
		width: var(--control-icon-composer);
		height: var(--control-icon-composer);
	}
	/* The words wrap onto more lines as they grow, as the app's do. */
	.field {
		position: relative;
		flex: 1;
		min-width: 0;
		min-height: 32px;
		display: flex;
		align-items: center;
		padding: 4px 0 4px 4px;
		line-height: 1.5;
		overflow: hidden;
	}
	.placeholder {
		white-space: nowrap;
		color: var(--ink-3);
	}
	.typed:not(:empty) + .placeholder {
