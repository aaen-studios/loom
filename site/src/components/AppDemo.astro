---
// A live copy of loom's desktop app, for the first screen: the sidebar with the agents' threads in their shapes, the
// pinned ones as tiles over the rest, an agent's chat with a reply that thinks, uses a tool, writes and asks before it deploys. Its sizes,
// colours and words are the app's (desktop/src/app.rs, design/tokens.toml); the script that plays
// it is src/scripts/demo.ts. The approval's buttons answer it, a reply's steps open, and the
// sidebar collapses to the rail, as the app's do.
import { brains } from '../lib/registry.mjs';
import shapes from '../../../design/generated/shapes.json';

const agents = [
	{ name: 'Biscuit', color: 'apricot', shape: 'star', pinned: true },
	{ name: 'Pip', color: 'lavender', pinned: true },
	{ name: 'Juniper', color: 'sky', shape: 'yarn', on: true },
	{ name: 'Moss', color: 'mint', shape: 'heart' },
	{ name: 'Otto', color: 'coral', shape: 'snail' },
];
const pinned = agents.filter((a) => a.pinned);
const rest = agents.filter((a) => !a.pinned);
// The brain chip: the program's icon from the ACP Registry, and what the agent is set to on it.
const [claude] = await brains(['claude-acp']);
// An agent's thread where a message mentions it, or over a message it sent: its shape, still,
// in a box 14 by 14, as desktop/src/app.rs, mention_thread, draws it.
function mentionThread(shape: keyof typeof shapes): string {
	const pts = shapes[shape] as number[][];
	let sx = 0;
	let sy = 0;
	for (const [x, y] of pts) {
		sx = Math.max(sx, Math.abs(x));
		sy = Math.max(sy, Math.abs(y));
	}
	const scale = Math.min(6 / Math.max(sx, 0.1), 6 / Math.max(sy, 0.1));
	return pts.map(([x, y], i) => `${i ? 'L' : 'M'}${(7 + x * scale).toFixed(2)} ${(7 + y * scale).toFixed(2)}`).join(' ');
}
const BISCUIT = mentionThread('star');

// GitHub's mark, as its site icon on the reply's link and sources.
const GITHUB =
	'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z';
---

<div class="app" data-demo role="region" aria-label="loom's desktop app, with an agent at work">
	<span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
	<aside class="side">
		<div class="side-top">
			<span class="brand" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
					<mask id="demo-knot" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32">
						<rect width="32" height="32" fill="white"></rect>
						<path d="M13.67 22.24 C 14.8 23.3, 16.3 24.1, 18.14 24.34" stroke="black" stroke-width="5.6"></path>
					</mask>
					<path d="M3 24.5 H12 C 19 24.5, 22 18.5, 22 14 C 22 9.5, 19 7, 16 7 C 13 7, 10 9.5, 10 14" mask="url(#demo-knot)"></path>
					<path d="M10 14 C 10 19, 13.5 24.5, 20 24.5 H29"></path>
				</svg>
				loom
			</span>
			<span class="side-tools">
				<span class="icon-btn small new" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"></path></svg></span>
				<button type="button" class="icon-btn small bar" data-bar aria-label="Collapse the sidebar">
					<svg class="i shut" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18m7 12-3-3 3-3"></path></svg>
					<svg class="i open" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18m5-12 3 3-3 3"></path></svg>
				</button>
			</span>
		</div>
		<div class="list" aria-hidden="true">
			<div class="pins">
				{
					pinned.map((a) => (
						<div class:list={['tile', { on: a.on }]} data-agent={a.name} title={a.name}>
							<svg data-thread data-color={a.color} data-shape={a.shape} width="52" height="36" />
							<span class="tile-name">{a.name}</span>
						</div>
					))
				}
			</div>
			{
				rest.map((a) => (
					<div class:list={['agent', { on: a.on }]} data-agent={a.name}>
						<svg data-thread data-color={a.color} data-shape={a.shape} width="26" height={a.shape ? 22 : 10} />
						<span class="agent-text">
							<span class="agent-name">{a.name}</span>
							<span class="agent-preview" />
						</span>
					</div>
				))
			}
		</div>
		<div class="side-foot" aria-hidden="true">
			<span class="server">
				<svg data-yarn="This computer" width="32" height="32"></svg>
				<span class="server-text">
					<span class="server-name">This computer</span>
					<span class="server-state">Connected</span>
				</span>
			</span>
			<span class="icon-btn gear">
				<svg class="i" viewBox="0 0 24 24"
					><path
						d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
					></path><circle cx="12" cy="12" r="3"></circle></svg
				>
			</span>
		</div>
	</aside>

	<div class="main">
		<div class="titlebar" aria-hidden="true">
			<div class="header">
				<span class="agent-btn">
					<svg data-thread data-color="sky" data-head width="26" height="10"></svg>
					<span>Juniper</span>
					<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
				</span>
				<span class="chips">
					<span class="chip brain">
						{claude?.icon && <span class="brain-icon" style={`--icon: url(${claude.icon})`} />}
						Opus 5.5 · Medium
						<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
					</span>
					<span class="chip">
						Asks when it's risky
						<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
					</span>
				</span>
			</div>
			<div class="winctl">
				<span><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14"></path></svg></span>
				<span><svg class="i" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg></span>
				<span class="close"><svg class="i" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"></path></svg></span>
			</div>
		</div>

		<div class="chat">
			<div class="msgs" aria-live="off">
				<div class="time-line">Today 09:02</div>
				<div class="row from-agent" style="--from: var(--thread-apricot)">
					<div class="from-who"><svg class="mention-thread" viewBox="0 0 14 14" aria-hidden="true"><path d={BISCUIT}></path></svg>Biscuit</div>
					<div class="from-bubble">The billing fix is ready. It needs a review before 2.4 goes out.</div>
				</div>
				<div class="row you">
					<div class="bubble">What's on my plate today?</div>
				</div>
				<div class="row reply">
					<svg data-thread data-color="sky" width="14" height="10" class="reply-thread head"></svg>
					<div class="body">
						<div class="who">Juniper</div>
						<div class="fold" data-fold>
							<button type="button" class="fold-line" aria-expanded="false"><span class="chevron">›</span><span class="words">2 steps</span></button>
							<div class="steps" hidden>
								<div class="tool-line done"><span class="prompt">›_</span><span class="title">Read ~/notes/today.md</span><span class="mark">✓</span></div>
								<div class="sub">
									<button type="button" class="tool-line done sub-line" aria-expanded="false"><span class="prompt">›_</span><span class="title">Check the open pull requests</span><span class="mark">✓</span><span class="count">2 steps</span><span class="chevron">›</span></button>
									<div class="inside" hidden>
										<div class="tool-line done"><span class="prompt">›_</span><span class="title">Fetch github.com/acme/shop/pulls</span><span class="mark">✓</span></div>
										<div class="on-the-way"><p>One waits on a review: the billing fix.</p></div>
									</div>
								</div>
							</div>
						</div>
						<div class="said-wrap">
							<div class="sources">
								<button type="button" class="sources-tab" aria-expanded="false" data-sources
									><span class="site-icons"><svg class="site-icon gh" viewBox="0 0 16 16" aria-hidden="true"><path d={GITHUB}></path></svg></span>2 sources<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg></button
								>
								<div class="sources-list" hidden>
									<span class="source"
										><svg class="site-icon gh" viewBox="0 0 16 16" aria-hidden="true"><path d={GITHUB}></path></svg><span class="t">Pull requests · acme/shop</span><span class="d">github.com</span></span
									>
									<span class="source"
										><svg class="site-icon gh" viewBox="0 0 16 16" aria-hidden="true"><path d={GITHUB}></path></svg><span class="t">Fix double charge on retries</span><span class="d">github.com</span></span
									>
								</div>
							</div>
							<div class="said">
								<p>
									Two things. The notes for 2.4 are due at 15:00, and <span class="mention" style="--from: var(--thread-apricot)"
										><svg class="mention-thread" viewBox="0 0 14 14" aria-hidden="true"><path d={BISCUIT}></path></svg>Biscuit</span
									> is waiting on your review of <span class="link" title="https://github.com/acme/shop/pull/212"
										><svg class="site-icon gh" viewBox="0 0 16 16" aria-hidden="true"><path d={GITHUB}></path></svg>the billing fix</span
									>. Both are at the top of your list.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="composer-wrap" aria-hidden="true">
			<div class="composer">
				<span class="icon-btn c"><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"></path></svg></span>
				<span class="field"><span class="typed"></span><span class="placeholder">Reply to Juniper</span></span>
				<span class="icon-btn c"
					><svg class="i" viewBox="0 0 24 24"
						><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"></path></svg
					></span
				>
				<span class="send">
					<svg class="i up" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7M12 19V5"></path></svg>
					<svg class="i stop" viewBox="0 0 24 24"><rect width="14" height="14" x="5" y="5" rx="2"></rect></svg>
				</span>
			</div>
		</div>
	</div>
</div>

<template id="demo-you">
	<div class="row you fresh"><div class="bubble"></div></div>
</template>
<template id="demo-reply">
	<div class="row reply fresh">
		<svg data-thread data-color="sky" width="14" height="10" class="reply-thread"></svg>
		<div class="body">
			<div class="fold" data-fold>
				<button type="button" class="fold-line" aria-expanded="false"><span class="chevron">›</span><span class="words"></span></button>
				<div class="steps" hidden></div>
			</div>
			<div class="said"></div>
		</div>
	</div>
</template>
<template id="demo-said">
	<div class="on-the-way"></div>
</template>
<template id="demo-tool">
	<div class="tool-line"><span class="prompt">›_</span><span class="title"></span><span class="mark">…</span></div>
</template>
<template id="demo-approval">
	<div class="row approval fresh">
		<div class="card">
			<div class="card-head">
				<span class="card-lead" aria-hidden="true"
					><svg class="i" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="m7 11 2-2-2-2M11 13h4"></path></svg
				></span>
				<div class="card-title"><span class="words"></span><svg data-thread data-color="sky" data-mood="waiting" width="26" height="14" class="card-mark"></svg></div>
				<span class="pill"></span>
			</div>
			<div class="card-buttons">
				<span class="split">
					<button type="button" class="b primary" data-answer="allow">Allow</button>
					<button type="button" class="b primary caret" aria-label="More ways to allow" aria-expanded="false" data-more
						><svg class="i" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg
					></button>
					<span class="menu" hidden>
						<button type="button" class="item" data-answer="always"
							><svg class="i" viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg
							>Always allow</button
						>
					</span>
				</span>
				<button type="button" class="b" data-answer="deny">Deny</button>
			</div>
		</div>
		<div class="card-done"><svg class="i" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></svg><span><b></b><span class="what"></span></span></div>
	</div>
</template>

<style>
	/* The window, as the app is: 1120 wide by default, every size from the tokens. */
	.app {
		--tint: var(--thread-sky);
		position: relative;
		display: flex;
		height: 640px;
		max-width: 1120px;
		margin: 0 auto;
		overflow: hidden;
		text-align: left;
		background: var(--bg);
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		box-shadow: var(--shadow);
		font-size: var(--size-body);
		line-height: 1.618;
		color: var(--ink);
		user-select: none;
		-webkit-user-select: none;
		cursor: default;
	}
	.i {
		width: 14px;
		height: 14px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.chev {
		width: 12px;
		height: 12px;
		color: var(--ink-3);
	}
	.icon-btn {
		display: grid;
		place-items: center;
		border-radius: var(--radius-row);
		color: var(--ink-2);
		transition: background-color 0.12s;
	}
	.icon-btn:hover {
		background: var(--hover);
	}
	button {
		font: inherit;
		color: inherit;
		background: none;
		border: 0;
		padding: 0;
	}

	/* The sidebar, and the rail it collapses to, its width easing between the two. */
	.side {
		display: flex;
		flex-direction: column;
		width: var(--layout-sidebar);
		flex: none;
		overflow: hidden;
		background: var(--side);
		border-right: 1px solid var(--line);
		transition: width 0.22s cubic-bezier(0.2, 0.7, 0.3, 1);
	}
	.side-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--layout-titlebar);
		padding: 0 12px 0 16px;
		flex: none;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: var(--weight-semibold);
		white-space: nowrap;
	}
	.side-tools {
		display: flex;
		gap: 2px;
	}
	.icon-btn.small {
		width: var(--control-icon-small);
		height: var(--control-icon-small);
	}
	.bar {
		color: var(--ink-3);
		cursor: pointer;
	}
	.bar:hover {
		color: var(--ink);
	}
	/* On the rail it's always the control that opens the sidebar. */
	.bar .open,
	.app.railed .bar .shut {
		display: none;
	}
	.app.railed .bar .open {
		display: block;
	}
	/* One column the sidebar's width: a long status after a name cuts off with an
	   ellipsis instead of widening the list and pushing the tiles right. */
	.list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-content: start;
		gap: 2px;
		flex: 1;
		padding: 12px 8px 0;
	}
	.agent {
		display: flex;
		align-items: center;
		min-width: 0;
		gap: 12px;
		padding: 8px 12px;
		border-radius: var(--radius-row);
		transition: background-color 0.12s;
	}
	.agent:hover {
		background: var(--hover);
	}
	.agent.on {
		background: var(--active);
	}
	.agent svg {
		width: 26px;
		height: 10px;
		flex: none;
	}
	.agent svg[data-shape] {
		height: 22px;
	}
	/* One line whatever the agent is doing, as in the app: what it's on sits quietly
	   after its name, so a row never changes height. */
	.agent-text {
		display: flex;
		align-items: center;
		gap: 8px;
		flex: 1;
		min-width: 0;
	}
	.agent-name {
		flex: 1;
		min-width: 0;
		font-weight: var(--weight-medium);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.agent-preview {
		min-width: 0;
		max-width: 55%;
		font-size: var(--size-caption);
		color: var(--ink-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.agent-preview:empty {
		display: none;
	}
	/* The pinned agents over the rest: tiles three across, each with its thread drawn large
	   in its shape and its name under it. */
	.pins {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4px;
		margin-bottom: 6px;
	}
	.pins:empty {
		display: none;
	}
	.tile {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		width: 78px;
		height: 78px;
		padding: 0 8px;
		border-radius: var(--radius-card);
		background: var(--raised);
		transition: background-color 0.12s;
	}
	.tile:hover {
		background: var(--raised-2);
	}
	.tile.on {
		background: var(--active);
	}
	.tile svg {
		width: 52px;
		height: 36px;
		flex: none;
	}
	.tile-name {
		max-width: 100%;
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		color: var(--ink-2);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tile.on .tile-name {
		color: var(--ink);
	}
	.side-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 4px;
		padding: 8px;
		flex: none;
	}
	.server {
		display: flex;
		align-items: center;
		gap: 12px;
		flex: 1;
		min-width: 0;
		height: var(--control-server);
		padding: 0 8px;
		border-radius: var(--radius-row);
		transition: background-color 0.12s;
	}
	.server:hover {
		background: var(--hover);
	}
	.server svg {
		width: 32px;
		height: 32px;
		flex: none;
	}
	.server-text {
		display: grid;
		line-height: 1.45;
		white-space: nowrap;
	}
	.server-name {
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
	}
	.server-state {
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.gear {
		width: var(--control-icon-large);
		height: var(--control-icon-large);
		flex: none;
		color: var(--ink-3);
	}
	.gear .i {
		width: 16px;
		height: 16px;
	}

	/* The rail: the control that opens the sidebar, each agent as its thread, and at the foot
	   the gear over the server's yarn. */
	.app.railed .side {
		width: var(--layout-rail);
	}
	.app.railed .side-top {
		justify-content: center;
		padding: 0;
	}
	.app.railed :is(.brand, .new, .agent-text, .tile-name, .server-text) {
		display: none;
	}
	.app.railed .list {
		justify-items: center;
		padding: 4px 0 0;
	}
	/* On the rail a pinned agent is its thread, as every agent is, first, with a short line
	   under them. */
	.app.railed .pins {
		display: grid;
		justify-items: center;
		gap: 2px;
		margin: 0;
	}
	.app.railed .pins::after {
		content: '';
		width: 16px;
		height: 1px;
		margin: 4px 0;
		background: var(--line-strong);
	}
	.app.railed :is(.agent, .tile) {
		width: 40px;
		height: 40px;
		padding: 0;
		justify-content: center;
	}
	.app.railed .tile:not(.on) {
		background: none;
	}
	.app.railed .tile:not(.on):hover {
		background: var(--hover);
	}
	.app.railed .tile {
		border-radius: var(--radius-row);
	}
	.app.railed .tile svg {
		width: 26px;
		height: 18px;
	}
	.app.railed .side-foot {
		flex-direction: column-reverse;
		padding: 0 0 8px;
	}
	.app.railed .server {
		flex: none;
		width: var(--control-server);
		padding: 0;
		justify-content: center;
	}

	/* The title bar, with the agent's header in it, over the chat only. */
	.main {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
	}
	.titlebar {
		display: flex;
		align-items: center;
		height: var(--layout-titlebar);
		border-bottom: 1px solid var(--line);
		flex: none;
	}
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		flex: 1;
		min-width: 0;
		padding: 0 16px;
	}
	.agent-btn,
	.chip {
		display: inline-flex;
		align-items: center;
		border-radius: var(--radius-row);
		padding: 4px 8px;
		white-space: nowrap;
		transition: background-color 0.12s;
	}
	.agent-btn:hover,
	.chip:hover {
		background: var(--hover);
	}
	.agent-btn {
		gap: 8px;
		font-weight: var(--weight-medium);
	}
	.agent-btn svg[data-thread] {
		width: 26px;
		height: 10px;
	}
	.chips {
		display: flex;
		align-items: center;
		gap: 16px;
		min-width: 0;
	}
	.chip {
		gap: 4px;
		font-size: var(--size-caption);
		color: var(--ink-2);
	}
	.chip.brain {
		gap: 6px;
	}
	/* The program's icon from the ACP Registry, drawn in the chip's ink, as the app draws it. */
	.brain-icon {
		width: 12px;
		height: 12px;
		flex: none;
		background: currentColor;
		-webkit-mask: var(--icon) center / contain no-repeat;
		mask: var(--icon) center / contain no-repeat;
	}
	.winctl {
		display: flex;
		gap: 2px;
		padding: 0 8px;
	}
	.winctl span {
		display: grid;
		place-items: center;
		width: 34px;
		height: 28px;
		border-radius: var(--radius-row);
		color: var(--ink-3);
		transition:
			background-color 0.12s,
			color 0.12s;
	}
	.winctl span:hover {
		background: var(--hover);
		color: var(--ink);
	}
	.winctl .close:hover {
		background: var(--bad);
		color: #fff;
	}

	/* On a Mac (html[data-os], set in Base.astro), the Mac app's window: its traffic lights
	   where the app puts them (desktop/src/app.rs, LIGHTS), the knot after them, and no
	   buttons at the title bar's end. */
	.lights {
		display: none;
		position: absolute;
		top: 17px;
		left: 16px;
		gap: 9px;
		z-index: 1;
	}
	.lights i {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: #ff5f57;
		box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.15);
	}
	.lights i:nth-child(2) {
		background: #febc2e;
	}
	.lights i:nth-child(3) {
		background: #28c840;
	}
	:global(html[data-os='mac']) .lights {
		display: flex;
	}
	:global(html[data-os='mac']) .side-top {
		padding-left: 92px;
	}
	:global(html[data-os='mac']) .winctl {
		display: none;
	}
	/* With the sidebar put away, the lights reach past the rail, so the title bar crosses the
	   window over it, with the control that opens the sidebar after the lights, and the rail
	   begins under it. */
	:global(html[data-os='mac']) .app.railed .side {
		background: none;
		border-right: 0;
	}
	:global(html[data-os='mac']) .app.railed .side-top {
		border-bottom: 1px solid var(--line);
	}
	:global(html[data-os='mac']) .app.railed :is(.list, .side-foot) {
		background: var(--side);
		border-right: 1px solid var(--line);
	}
	:global(html[data-os='mac']) .app.railed .bar {
		position: absolute;
		top: 11px;
		left: 86px;
	}
	:global(html[data-os='mac']) .app.railed .header {
		padding-left: 60px;
	}

	/* The chat: a column 740 wide at most, newest at the bottom. */
	.chat {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 0 24px;
	}
	.msgs {
		width: 100%;
		max-width: var(--space-column);
		margin: 0 auto;
		padding-bottom: 8px;
	}
	/* Across the chat where it paused, or on a new day: when it went on. */
	.time-line {
		padding: 8px 0 4px;
		text-align: center;
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.row {
		padding: 4px 0 8px;
	}
	.row.fresh {
		animation: rise 0.28s cubic-bezier(0.2, 0.7, 0.3, 1) both;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}
	.row.leaving {
		transition: opacity 0.35s;
		opacity: 0;
	}
	.you {
		display: flex;
		justify-content: flex-end;
	}
	/* What the person wrote: the bubble grey with a breath of the agent's colour, a little more
	   in the dark, as the app draws it by default (Vibrant bubbles, the colour itself, is a
	   choice in its settings). */
	.bubble {
		max-width: 520px;
		padding: 10px 16px;
		border-radius: var(--radius-bubble);
		background: color-mix(in srgb, var(--tint) 7%, var(--bubble));
		overflow-wrap: anywhere;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .bubble {
			background: color-mix(in srgb, var(--tint) 12%, var(--bubble));
		}
	}
	:root[data-theme='dark'] .bubble {
		background: color-mix(in srgb, var(--tint) 12%, var(--bubble));
	}
	.reply {
		display: flex;
		gap: 12px;
	}
	/* Beside the agent's name over the first reply after a time line, and level with the
	   bubble's first line beside the rest. */
	.reply-thread {
		width: 14px;
		height: 10px;
		flex: none;
		margin-top: 16px;
	}
	.reply-thread.head {
		margin-top: 4px;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
		flex: 1;
	}
	.who {
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		line-height: 1.4;
	}
	/* The turn's steps under one quiet line: while it runs, the step it's on, and once it's
	   done, how many there were, which opens to show them. */
	.fold {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}
	.fold:not(:has(.words:not(:empty))) {
		display: none;
	}
	.fold-line {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
		font-size: var(--size-small);
		line-height: 1.5;
		color: var(--ink-3);
		text-align: left;
		cursor: pointer;
		transition: color 0.12s;
	}
	.fold-line:hover {
		color: var(--ink);
	}
	.fold-line .words {
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.fold.bare .chevron {
		display: none;
	}
	.fold.bare .fold-line {
		cursor: default;
	}
	.fold.bare .fold-line:hover {
		color: var(--ink-3);
	}
	.steps {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding-left: 12px;
		border-left: 1px solid var(--line-strong);
	}
	.steps[hidden] {
		display: none;
	}
	.tool-line {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: var(--size-small);
		line-height: 1.5;
		min-width: 0;
	}
	.tool-line .prompt {
		color: var(--ink-3);
	}
	.tool-line .title {
		font-family: var(--mono);
		color: var(--ink-2);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tool-line .mark {
		color: var(--ink-3);
	}
	.tool-line.done .mark {
		color: var(--ok);
	}
	.tool-line.denied .mark {
		color: var(--bad);
	}
	/* A subagent's call: how many steps it took, and what its subagent did inside it,
	   opened with a click. */
	.sub {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}
	.sub-line {
		text-align: left;
		cursor: pointer;
	}
	.sub-line .count,
	.sub-line .chevron {
		flex: none;
		color: var(--ink-3);
	}
	.inside {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding-left: 12px;
		border-left: 1px solid var(--line-strong);
	}
	.inside[hidden] {
		display: none;
	}
	/* Words the agent wrote on its way to the answer, among the steps: smaller and quieter
	   than the answer, so they don't read as a message in the chat. */
	.on-the-way {
		font-size: var(--size-small);
		line-height: var(--line-reply);
		color: var(--ink-2);
		overflow-wrap: anywhere;
	}
	/* The answer: a grey bubble, never the agent's colour, which is the person's. Its corner
	   by the thread is squared off as a speech bubble's tail. */
	.said {
		align-self: flex-start;
		max-width: 94%;
		padding: 10px 16px;
		border-radius: var(--radius-bubble-joined) var(--radius-bubble) var(--radius-bubble) var(--radius-bubble);
		background: var(--bubble);
		line-height: var(--line-reply);
	}
	.said:empty {
		display: none;
	}
	.said :global(p + p) {
		margin-top: 12px;
	}
	/* A link: its site's icon before it, underlined, its whole address on hover. */
	/* An agent a message mentions (desktop/src/app.rs, linked_words): its thread and its name in
	   its colour, a little weathered toward the quiet ink, with nothing behind it. */
	.mention {
		color: color-mix(in srgb, var(--from) 70%, var(--ink-3));
		font-weight: var(--weight-medium);
		white-space: nowrap;
	}
	.mention-thread {
		display: inline-block;
		width: 14px;
		height: 14px;
		margin-right: 3px;
		fill: none;
		stroke: color-mix(in srgb, var(--from) 70%, var(--ink-3));
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		vertical-align: -2px;
	}
	/* A message another agent sent (app.rs, person): on the person's side, a breath of the
	   sender's colour, with its thread and name over it. */
	.from-agent {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 4px;
	}
	.from-who {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: var(--size-caption);
		font-weight: var(--weight-medium);
		color: color-mix(in srgb, var(--from) 70%, var(--ink-3));
	}
	.from-who .mention-thread {
		margin: 0;
		stroke: currentColor;
	}
	.from-bubble {
		max-width: 520px;
		padding: 10px 16px;
		border-radius: var(--radius-bubble);
		background: color-mix(in srgb, var(--from) 10%, var(--bubble));
		overflow-wrap: anywhere;
	}
	.link {
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-color: var(--line-strong);
		white-space: nowrap;
	}
	.site-icon {
		width: 14px;
		height: 14px;
		flex: none;
		border-radius: 3px;
	}
	.site-icon.gh {
		fill: var(--ink);
	}
	.link .site-icon {
		display: inline-block;
		vertical-align: -2px;
		margin-right: 4px;
	}

	/* A reply's sources (desktop/src/app.rs, sources_tab): a tab hanging from its bubble's
	   bottom-left corner, tucked under it, a shade lighter than the bubble; open, a shade
	   darker. Its list opens under it, a line each. */
	.said-wrap {
		position: relative;
		align-self: flex-start;
		max-width: 94%;
		padding-bottom: 19px;
	}
	.said-wrap .said {
		position: relative;
		max-width: 100%;
	}
	.sources {
		position: absolute;
		left: 14px;
		bottom: 0;
	}
	.sources-tab {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 26px;
		padding: 7px 8px 0 5px;
		border: 1px solid #e4e4e8;
		border-radius: var(--radius-button);
		background: #f7f7f8;
		font-size: var(--size-caption);
		color: var(--ink-2);
		cursor: pointer;
		transition: background-color 0.12s;
	}
	.sources-tab:hover,
	.sources-tab[aria-expanded='true'] {
		background: #eaeaed;
	}
	.sources-tab .site-icon {
		width: 16px;
		height: 16px;
		border-radius: 4px;
	}
	.site-icons {
		display: flex;
		gap: 3px;
	}
	.sources-list {
		position: absolute;
		left: 0;
		top: calc(100% + 4px);
		z-index: 5;
		width: 340px;
		max-width: calc(100vw - 64px);
		display: grid;
		padding: 4px;
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-card);
		box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.1);
	}
	/* Shut until the tab opens it: its own display would show it whatever `hidden` says. */
	.sources-list[hidden] {
		display: none;
	}
	.sources-list.up {
		top: auto;
		bottom: calc(100% + 4px);
	}
	.source {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 32px;
		padding: 0 8px;
		border-radius: var(--radius-row);
		transition: background-color 0.12s;
	}
	.source:hover {
		background: var(--hover);
	}
	.source .site-icon {
		width: 16px;
		height: 16px;
		border-radius: 4px;
	}
	.source .t {
		flex: 1;
		min-width: 0;
		max-width: 210px;
		font-size: var(--size-small);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.source .d {
		margin-left: auto;
		max-width: 120px;
		font-size: var(--size-caption);
		color: var(--ink-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .sources-tab {
			background: #222226;
			border-color: #2e2e33;
		}
		:root:not([data-theme='light']) .sources-tab:hover,
		:root:not([data-theme='light']) .sources-tab[aria-expanded='true'] {
			background: #2c2c31;
		}
		:root:not([data-theme='light']) .sources-list {
			box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.55);
		}
	}
	:root[data-theme='dark'] .sources-tab {
		background: #222226;
		border-color: #2e2e33;
	}
	:root[data-theme='dark'] .sources-tab:hover,
	:root[data-theme='dark'] .sources-tab[aria-expanded='true'] {
		background: #2c2c31;
	}
	:root[data-theme='dark'] .sources-list {
		box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.55);
	}

	/* An approval: its own row after the messages, lined up with the reply's text, in the
	   card frame every card in the chat has (the app's CardFrame): its icon in the agent's
	   colour, its title with the agent's thread tugging beside it, what it does in a pill,
	   and Allow, split for Always allow, and Deny. Its edge takes the agent's colour while
	   it waits. Answered, it's one quiet line. */
	.approval {
		--card-fill: var(--raised);
		--card-inset: var(--bg);
		--card-edge: var(--line);
		--card-shadow: 0 10px 28px -16px rgb(0 0 0 / 0.55);
		padding-left: 26px;
	}
	@media (prefers-color-scheme: light) {
		:root:not([data-theme='dark']) .approval {
			--card-fill: var(--bg);
			--card-inset: var(--raised);
			--card-edge: var(--line-strong);
			--card-shadow: 0 10px 28px -16px rgb(0 0 0 / 0.1);
		}
	}
	:root[data-theme='light'] .approval {
		--card-fill: var(--bg);
		--card-inset: var(--raised);
		--card-edge: var(--line-strong);
		--card-shadow: 0 10px 28px -16px rgb(0 0 0 / 0.1);
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		max-width: 600px;
		padding: 16px;
		background: var(--card-fill);
		border: 1px solid color-mix(in srgb, var(--tint) 40%, transparent);
		border-radius: var(--radius-bubble);
		box-shadow: var(--card-shadow);
	}
	.card-head {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.card-lead {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: var(--control-icon-large);
		height: var(--control-icon-large);
		border-radius: var(--radius-card);
		background: var(--card-inset);
		color: var(--tint);
	}
	.card-title {
		display: flex;
		flex: 1;
		align-items: center;
		gap: 8px;
		min-width: 0;
		color: var(--ink);
		font-weight: var(--weight-semibold);
		line-height: 1.35;
	}
	.card-mark {
		flex: none;
	}
	/* What it does, as loom knows it: amber for a call that runs something. */
	.pill {
		flex: none;
		padding: 2px 9px;
		border: 1px solid color-mix(in srgb, var(--warn) 70%, transparent);
		border-radius: 999px;
		color: var(--warn);
		font-size: var(--size-caption);
		font-weight: var(--weight-medium);
	}
	.card-buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}
	/* Allow, and beside it the arrow that opens Always allow. */
	.split {
		position: relative;
		display: inline-flex;
		gap: 1px;
	}
	.split .b.primary:first-child {
		border-radius: var(--radius-button) 0 0 var(--radius-button);
	}
	.split .caret {
		display: flex;
		align-items: center;
		padding: 0 7px;
		border-radius: 0 var(--radius-button) var(--radius-button) 0;
	}
	.split .caret .i {
		width: 14px;
		height: 14px;
	}
	/* Opens upward: the approval sits at the bottom of the chat, which clips what's below. */
	.menu {
		position: absolute;
		bottom: calc(100% + 4px);
		left: 0;
		z-index: 2;
		min-width: 180px;
		padding: 4px;
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-card);
		box-shadow: var(--card-shadow);
	}
	.menu[hidden] {
		display: none;
	}
	.menu .item {
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
		padding: 8px 12px;
		border: 0;
		border-radius: var(--radius-row);
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: var(--size-small);
		text-align: left;
		cursor: pointer;
	}
	.menu .item:hover {
		background: var(--hover);
	}
	.menu .item .i {
		width: 14px;
		height: 14px;
		color: var(--ink-2);
	}
	.card-done {
		display: none;
		align-items: center;
		gap: 8px;
		font-size: var(--size-small);
		color: var(--ink-3);
	}
	.card-done b {
		color: var(--ink-2);
		font-weight: var(--weight-medium);
	}
	.card-done .i {
		width: 12px;
		height: 12px;
	}
	.approval.answered .card {
		display: none;
	}
	.approval.answered .card-done {
		display: flex;
	}
	.b {
		height: var(--control-button-small);
		padding: 0 12px;
		border-radius: var(--radius-button);
		border: 1px solid var(--line-strong);
		background: transparent;
		color: var(--ink);
