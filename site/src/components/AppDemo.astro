---
// A live copy of loom's desktop app, for the first screen: the sidebar with the agents' threads, an
// agent's chat with a reply that thinks, uses a tool, writes and asks before it deploys. Its sizes,
// colours and words are the app's (desktop/src/app.rs, design/tokens.toml); the script that plays
// it is src/scripts/demo.ts. The approval's buttons answer it.
const agents = [
	{ name: 'Juniper', color: 'sky', on: true },
	{ name: 'Moss', color: 'mint' },
	{ name: 'Biscuit', color: 'apricot' },
	{ name: 'Pip', color: 'lavender' },
];
---

<div class="app" data-demo role="region" aria-label="loom's desktop app, with an agent at work">
	<aside class="side" aria-hidden="true">
		<div class="side-top">
			<span class="brand">
				<svg width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
					<mask id="demo-knot" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32">
						<rect width="32" height="32" fill="white"></rect>
						<path d="M13.67 22.24 C 14.8 23.3, 16.3 24.1, 18.14 24.34" stroke="black" stroke-width="5.6"></path>
					</mask>
					<path d="M3 24.5 H12 C 19 24.5, 22 18.5, 22 14 C 22 9.5, 19 7, 16 7 C 13 7, 10 9.5, 10 14" mask="url(#demo-knot)"></path>
					<path d="M10 14 C 10 19, 13.5 24.5, 20 24.5 H29"></path>
				</svg>
				loom
			</span>
			<span class="icon-btn small"><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"></path></svg></span>
		</div>
		<div class="search">
			<svg class="i" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
			<span>Search</span>
		</div>
		<div class="list">
			{
				agents.map((a) => (
					<div class:list={['agent', { on: a.on }]} data-agent={a.name}>
						<svg data-thread data-color={a.color} width="26" height="10"></svg>
						<span class="agent-text">
							<span class="agent-name">{a.name}</span>
							<span class="agent-preview"></span>
						</span>
					</div>
				))
			}
		</div>
		<div class="side-foot">
			<span class="server">
				<svg data-yarn="This computer" width="32" height="32"></svg>
				<span class="server-text">
					<span class="server-name">This computer</span>
					<span class="server-state">Connected</span>
				</span>
			</span>
			<span class="icon-btn gear">
				<svg class="i" viewBox="0 0 24 24"
					><path
						d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
					></path><circle cx="12" cy="12" r="3"></circle></svg
				>
			</span>
		</div>
	</aside>

	<div class="main">
		<div class="titlebar" aria-hidden="true">
			<div class="header">
				<span class="agent-btn">
					<svg data-thread data-color="sky" data-head width="26" height="10"></svg>
					<span>Juniper</span>
					<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
				</span>
				<span class="picker">
					Asks when it's risky
					<svg class="i chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
				</span>
			</div>
			<div class="winctl">
				<span><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14"></path></svg></span>
				<span><svg class="i" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg></span>
				<span class="close"><svg class="i" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"></path></svg></span>
			</div>
		</div>

		<div class="chat">
			<div class="msgs" aria-live="off">
				<div class="row you">
					<div class="bubble">What's on my plate today?</div>
				</div>
				<div class="row reply">
					<svg data-thread data-color="sky" width="14" height="10" class="reply-thread"></svg>
					<div class="body">
						<div class="who"><b>Juniper</b><span>09:02</span></div>
						<div class="said">
							<p>Two things. The notes for 2.4 are due at 15:00, and Biscuit is waiting on your review of the billing fix. Both are at the top of your list.</p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="composer-wrap">
			<div class="composer">
				<span class="icon-btn c"><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"></path></svg></span>
				<span class="field"><span class="typed"></span><span class="placeholder">Reply to Juniper</span></span>
				<span class="icon-btn c"
					><svg class="i" viewBox="0 0 24 24"
						><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"></path></svg
					></span
				>
				<span class="send">
					<svg class="i up" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7M12 19V5"></path></svg>
					<svg class="i stop" viewBox="0 0 24 24"><rect width="14" height="14" x="5" y="5" rx="2"></rect></svg>
				</span>
			</div>
		</div>
	</div>
</div>

<template id="demo-you">
	<div class="row you fresh"><div class="bubble"></div></div>
</template>
<template id="demo-reply">
	<div class="row reply fresh">
		<svg data-thread data-color="sky" width="14" height="10" class="reply-thread"></svg>
		<div class="body">
			<div class="who"><b>Juniper</b><span>now</span></div>
			<div class="waiting-words"></div>
			<div class="said"></div>
		</div>
	</div>
</template>
<template id="demo-approval">
	<div class="row approval fresh">
		<div class="card">
			<div class="card-title"></div>
			<div class="card-cmd"></div>
			<div class="card-buttons">
				<button type="button" class="b primary" data-answer="allow">Allow once</button>
				<button type="button" class="b" data-answer="deny">Deny</button>
			</div>
		</div>
	</div>
</template>

<style>
	/* The window, as the app is: 1120 wide by default, every size from the tokens. */
	.app {
		--tint: var(--thread-sky);
		display: flex;
		height: 640px;
		max-width: 1120px;
		margin: 0 auto;
		overflow: hidden;
		text-align: left;
		background: var(--bg);
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		box-shadow: var(--shadow);
		font-size: var(--size-body);
		line-height: 1.618;
		color: var(--ink);
		user-select: none;
		-webkit-user-select: none;
		cursor: default;
	}
	.i {
		width: 14px;
		height: 14px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.chev {
		width: 12px;
		height: 12px;
		color: var(--ink-3);
	}
	.icon-btn {
		display: grid;
		place-items: center;
		border-radius: var(--radius-row);
		color: var(--ink-2);
		transition: background-color 0.12s;
	}
	.icon-btn:hover {
		background: var(--hover);
	}

	/* The sidebar. */
	.side {
		display: flex;
		flex-direction: column;
		width: var(--layout-sidebar);
		flex: none;
		background: var(--side);
		border-right: 1px solid var(--line);
	}
	.side-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--layout-titlebar);
		padding: 0 16px;
		flex: none;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: var(--weight-semibold);
	}
	.icon-btn.small {
		width: var(--control-icon-small);
		height: var(--control-icon-small);
	}
	.search {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 32px;
		margin: 0 12px 8px;
		padding: 0 10px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-input);
		background: var(--bg);
		color: var(--ink-3);
		flex: none;
	}
	.list {
		display: grid;
		align-content: start;
		gap: 2px;
		flex: 1;
		padding: 12px 8px 0;
	}
	.agent {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 12px;
		border-radius: var(--radius-row);
		transition: background-color 0.12s;
	}
	.agent:hover {
		background: var(--hover);
	}
	.agent.on {
		background: var(--active);
	}
	.agent svg {
		width: 26px;
		height: 10px;
		flex: none;
	}
	.agent-text {
		display: grid;
		min-width: 0;
	}
	.agent-name {
		font-weight: var(--weight-medium);
		white-space: nowrap;
	}
	.agent-preview {
		font-size: var(--size-caption);
		color: var(--ink-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		line-height: 1.5;
	}
	.agent-preview:empty {
		display: none;
	}
	.side-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 4px;
		padding: 8px;
		flex: none;
	}
	.server {
		display: flex;
		align-items: center;
		gap: 12px;
		flex: 1;
		min-width: 0;
		height: var(--control-server);
		padding: 0 8px;
		border-radius: var(--radius-row);
		transition: background-color 0.12s;
	}
	.server:hover {
		background: var(--hover);
	}
	.server svg {
		width: 32px;
		height: 32px;
		flex: none;
	}
	.server-text {
		display: grid;
		line-height: 1.45;
	}
	.server-name {
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
	}
	.server-state {
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.gear {
		width: var(--control-icon-large);
		height: var(--control-icon-large);
		color: var(--ink-3);
	}
	.gear .i {
		width: 16px;
		height: 16px;
	}

	/* The title bar, with the agent's header in it, over the chat only. */
	.main {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
	}
	.titlebar {
		display: flex;
		align-items: center;
		height: var(--layout-titlebar);
		border-bottom: 1px solid var(--line);
		flex: none;
	}
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex: 1;
		min-width: 0;
		padding: 0 16px;
	}
	.agent-btn,
	.picker {
		display: inline-flex;
		align-items: center;
		border-radius: var(--radius-row);
		padding: 4px 8px;
		transition: background-color 0.12s;
	}
	.agent-btn:hover,
	.picker:hover {
		background: var(--hover);
	}
	.agent-btn {
		gap: 8px;
		font-weight: var(--weight-medium);
	}
	.agent-btn svg[data-thread] {
		width: 26px;
		height: 10px;
	}
	.picker {
		gap: 4px;
		font-size: var(--size-caption);
		color: var(--ink-2);
	}
	.winctl {
		display: flex;
		gap: 2px;
		padding: 0 8px;
	}
	.winctl span {
		display: grid;
		place-items: center;
		width: 34px;
		height: 28px;
		border-radius: var(--radius-row);
		color: var(--ink-3);
		transition:
			background-color 0.12s,
			color 0.12s;
	}
	.winctl span:hover {
		background: var(--hover);
		color: var(--ink);
	}
	.winctl .close:hover {
		background: var(--bad);
		color: #fff;
	}

	/* The chat: a column 740 wide at most, newest at the bottom. */
	.chat {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 0 24px;
	}
	.msgs {
		width: 100%;
		max-width: var(--space-column);
		margin: 0 auto;
		padding-bottom: 8px;
	}
	.row {
		padding: 8px 0;
	}
	.row.fresh {
		animation: rise 0.28s cubic-bezier(0.2, 0.7, 0.3, 1) both;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}
	.row.leaving {
		transition: opacity 0.35s;
		opacity: 0;
	}
	.you {
		display: flex;
		justify-content: flex-end;
	}
	.bubble {
		max-width: 520px;
		padding: 10px 16px;
		border-radius: var(--radius-bubble);
		background: var(--bubble);
		overflow-wrap: anywhere;
	}
	.reply {
		display: flex;
		gap: 12px;
	}
	.reply-thread {
		width: 14px;
		height: 10px;
		flex: none;
		margin-top: 8px;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
		flex: 1;
	}
	.who {
		display: flex;
		align-items: baseline;
		gap: 8px;
		line-height: 1.4;
		margin-top: 2px;
	}
	.who b {
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
	}
	.who span {
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.said {
		align-self: flex-start;
		max-width: 94%;
		padding: 10px 16px;
		border-radius: 6px var(--radius-bubble) var(--radius-bubble) var(--radius-bubble);
		background: color-mix(in srgb, var(--bubble) 93%, var(--tint));
		line-height: var(--line-reply);
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .said {
			background: color-mix(in srgb, var(--bubble) 88%, var(--tint));
		}
	}
	:root[data-theme='dark'] .said {
		background: color-mix(in srgb, var(--bubble) 88%, var(--tint));
	}
	.said:empty {
		display: none;
	}
	.said :global(p + p) {
		margin-top: 12px;
	}
	.waiting-words {
		font-size: var(--size-small);
		color: var(--ink-3);
	}
	.waiting-words:empty {
		display: none;
	}

	/* An approval: its own row after the messages, lined up with the reply's text. */
	.approval {
		padding-left: 26px;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
		background: var(--raised);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}
	.card-title {
		font-weight: var(--weight-medium);
	}
	.card-cmd {
		padding: 8px 12px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius-input);
		font-family: var(--mono);
		font-size: var(--size-small);
		color: var(--ink-2);
	}
	.card-buttons {
		display: flex;
		gap: 8px;
	}
	.b {
		height: var(--control-button-small);
		padding: 0 12px;
		border-radius: var(--radius-button);
		border: 1px solid var(--line-strong);
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		cursor: pointer;
		transition:
			background-color 0.12s,
			transform 0.1s;
	}
	.b:hover,
	.b.pressed {
		background: var(--hover);
	}
	.b.primary {
		border-color: var(--button);
		background: var(--button);
		color: var(--button-ink);
	}
	.b.primary:hover,
	.b.primary.pressed {
		background: color-mix(in srgb, var(--button) 82%, var(--bg));
	}
	.b.pressed {
		transform: scale(0.97);
	}

	/* The composer. */
	.composer-wrap {
		padding: 4px 24px 16px;
		flex: none;
	}
	.composer {
		display: flex;
		align-items: flex-end;
		gap: 8px;
		max-width: var(--space-column);
		margin: 0 auto;
		padding: 8px 12px;
		background: var(--raised);
		border: 1px solid var(--line);
		border-radius: var(--radius-composer);
	}
	.icon-btn.c {
		width: var(--control-icon-composer);
		height: var(--control-icon-composer);
	}
	.field {
		position: relative;
		flex: 1;
		min-width: 0;
		height: 32px;
		display: flex;
		align-items: center;
		padding-left: 4px;
		white-space: nowrap;
		overflow: hidden;
	}
	.placeholder {
		color: var(--ink-3);
	}
	.typed:not(:empty) + .placeholder {
		display: none;
	}
	.typed:not(:empty)::after {
		content: '';
		display: inline-block;
		width: 1.5px;
		height: 17px;
		margin-left: 1px;
		vertical-align: -3px;
		background: var(--ink);
		animation: caret 1s steps(1) infinite;
	}
	@keyframes caret {
		50% {
			opacity: 0;
		}
	}
	.send {
		display: grid;
		place-items: center;
		width: var(--control-icon-composer);
		height: var(--control-icon-composer);
		border-radius: var(--radius-button);
		background: var(--button);
		color: var(--button-ink);
		flex: none;
	}
	.send .i {
		grid-area: 1 / 1;
	}
	.send .stop {
		display: none;
		width: 12px;
		height: 12px;
		fill: currentColor;
		stroke: none;
	}
	.app.busy .send .stop {
		display: block;
	}
	.app.busy .send .up {
		display: none;
	}

	/* A narrower window: the sidebar goes, as the app's would leave the chat first. */
	@media (max-width: 860px) {
		.side,
		.winctl {
			display: none;
		}
		.app {
			height: 600px;
		}
	}
	@media (max-width: 560px) {
		.app {
			height: 560px;
			border-radius: 12px;
		}
		.chat,
		.composer-wrap {
			padding-left: 14px;
			padding-right: 14px;
		}
		.header {
			padding: 0 8px;
		}
		.said {
			max-width: 100%;
		}
		.bubble {
			max-width: 85%;
		}
		.approval {
			padding-left: 0;
		}
	}
</style>

<script>
	import { play } from '../scripts/demo';
	const demo = document.querySelector<HTMLElement>('[data-demo]');
	if (demo) play(demo);
</script>
