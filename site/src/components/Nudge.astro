---
// The page has no scrollbar, so when someone opens it and hasn't scrolled after a few seconds, a
// small arrow at the bottom bobs to say there's more. It goes once they scroll, and a click scrolls
// down for them.
---

<button class="nudge" type="button" aria-label="Scroll down" hidden>
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M6 9l6 6 6-6"></path>
	</svg>
</button>

<style>
	.nudge {
		position: fixed;
		z-index: 20;
		left: 50%;
		bottom: calc(22px + env(safe-area-inset-bottom, 0px));
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		margin-left: -20px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--bg);
		color: var(--ink-2);
		box-shadow: 0 6px 20px rgb(0 0 0 / 0.08);
		cursor: pointer;
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.4s,
			transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1),
			color 0.15s;
	}
	.nudge[hidden] {
		display: none;
	}
	.nudge:hover {
		color: var(--ink);
	}
	.nudge.on {
		opacity: 1;
		transform: none;
	}
	.nudge.on svg {
		animation: bob 1.6s ease-in-out infinite;
	}
	@keyframes bob {
		50% {
			transform: translateY(3px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.nudge.on svg {
			animation: none;
		}
	}
</style>

<script>
	const nudge = document.querySelector<HTMLButtonElement>('.nudge');
	if (nudge) {
		let done = false;
		const go = () => {
			done = true;
			nudge.classList.remove('on');
			setTimeout(() => (nudge.hidden = true), 400);
		};
		addEventListener('scroll', () => scrollY > 24 && !done && go(), { passive: true });
		setTimeout(() => {
			// Only where there's somewhere to go.
			if (done || scrollY > 24 || document.documentElement.scrollHeight - innerHeight < 200) return;
			nudge.hidden = false;
			requestAnimationFrame(() => nudge.classList.add('on'));
		}, 3500);
		nudge.addEventListener('click', () => {
			scrollBy({ top: innerHeight * 0.8, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
		});
	}
</script>
