---
// The ways to get loom, side by side: the Windows app, the Mac app and a server. Which comes first
// follows the visitor's system (html[data-os], set in Base.astro): on Windows the Windows app, on a
// Mac the Mac app, and elsewhere, as on a phone, the server, with both apps quiet beside it. The Mac
// app shows once the newest release has its disk image.
import { carries, latest, sizeOf } from '../lib/releases.mjs';
import { LATEST, MAC_APP, WINDOWS_APP } from '../lib/site.mjs';

interface Props {
	/** Without the line under the buttons. */
	compact?: boolean;
}
const { compact = false } = Astro.props;
const release = await latest();
const mac = carries(release, MAC_APP);
const line = (...parts: (string | undefined)[]) => [release && `loom ${release.version}`, ...parts].filter(Boolean).join(' · ');
const windowsMeta = line(sizeOf(release, WINDOWS_APP));
const macMeta = line(sizeOf(release, MAC_APP), 'Apple silicon');
---

<div class="get">
	<div class="buttons">
		<a class="btn btn-primary get-windows" href={`${LATEST}/${WINDOWS_APP}`} download>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"></path></svg>
			Download for Windows
		</a>
		{
			mac && (
				<a class="btn btn-quiet get-mac" href={`${LATEST}/${MAC_APP}`} download>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"></path></svg>
					Download for Mac
				</a>
			)
		}
		<a class="btn btn-quiet get-server" href="/download/#server">Run it on a server</a>
	</div>
	{!compact && windowsMeta && <p class="meta meta-windows">{windowsMeta}</p>}
	{!compact && mac && macMeta && <p class="meta meta-mac">{macMeta}</p>}
</div>

<style>
	.get {
		display: grid;
		justify-items: center;
		gap: 14px;
	}
	.buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
	}
	.meta {
		font-size: 13px;
		color: var(--ink-3);
	}
	/* Windows, and before the system is known: the Windows app first. */
	.meta-mac {
		display: none;
	}
	/* On a Mac: the Mac app first, the rest quiet. */
	:global(html[data-os='mac']) .get-mac {
		order: -1;
		background: var(--button);
		color: var(--button-ink);
		border-color: transparent;
	}
	:global(html[data-os='mac']) .meta-mac {
		display: block;
	}
	:global(html[data-os='mac']) .meta-windows {
		display: none;
	}
	/* Anywhere else: the server first, and both apps quiet beside it. */
	:global(html[data-os='other']) .get-server {
		order: -1;
		background: var(--button);
		color: var(--button-ink);
		border-color: transparent;
	}
	:global(html[data-os='mac']) .get-windows,
	:global(html[data-os='other']) .get-windows {
		background: transparent;
		color: var(--ink);
		border-color: var(--line-strong);
	}
	:global(html[data-os='other']) .meta {
		display: none;
	}
	@media (max-width: 480px) {
		.buttons {
			flex-direction: column;
			align-self: stretch;
			width: 100%;
			max-width: 320px;
		}
	}
</style>
