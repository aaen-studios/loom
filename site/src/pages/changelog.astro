---
// Every release's notes, newest first, from GitHub's releases.
import Base from '../layouts/Base.astro';
import { releases, day } from '../lib/releases.mjs';
import { GITHUB } from '../lib/site.mjs';

const all = await releases();
---

<Base title="Changelog" crumb="Changelog" description="What changed in each release of loom, the self-hostable agent app, newest first.">
	<div class="wrap page">
		<h1>Changelog</h1>
		<ol class="list">
			{
				all.map((r) => (
					<li id={r.tag}>
						<div class="side">
							<h2>
								<a href={`#${r.tag}`}>{r.version}</a>
							</h2>
							<time datetime={r.date}>{day(r.date)}</time>
						</div>
						<div class="notes">
							<Fragment set:html={r.html} />
							<a class="files" href={r.url}>
								Files on GitHub
							</a>
						</div>
					</li>
				))
			}
		</ol>
		{all.length === 0 && <p class="none"><a href={`${GITHUB}/releases`}>Releases on GitHub</a></p>}
	</div>
</Base>

<style>
	.page {
		max-width: calc(880px + 2 * var(--gutter));
		padding-top: 72px;
	}
	h1 {
		font-size: clamp(36px, 6vw, 52px);
		letter-spacing: -0.035em;
	}
	.list {
		list-style: none;
		margin: 48px 0 0;
		padding: 0;
	}
	.list > li {
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 32px;
		padding: 36px 0;
		border-top: 1px solid var(--line);
	}
	.side {
		position: sticky;
		top: 84px;
		align-self: start;
	}
	h2 {
		font-size: 24px;
		letter-spacing: -0.03em;
	}
	h2 a {
		text-decoration: none;
	}
	h2 a:hover {
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 5px;
	}
	time {
		display: block;
		margin-top: 6px;
		color: var(--ink-3);
		font-size: 14px;
	}
	.notes {
		min-width: 0;
		font-size: 15px;
		color: var(--ink-2);
	}
	.notes :global(p) {
		margin: 0 0 14px;
	}
	.notes :global(p:has(+ ul)) {
		margin: 22px 0 8px;
		color: var(--ink);
		font-weight: var(--weight-semibold);
	}
	.notes :global(p:first-child) {
		margin-top: 0;
	}
	.notes :global(ul) {
		margin: 0 0 14px;
		padding-left: 20px;
	}
	.notes :global(li) {
		margin: 6px 0;
		padding-left: 2px;
	}
	.notes :global(li::marker) {
		color: var(--ink-3);
	}
	.notes :global(code) {
		font-size: 0.88em;
		padding: 1px 5px;
		border-radius: 5px;
		background: var(--raised);
		border: 1px solid var(--line);
		color: var(--ink);
	}
	.notes :global(a) {
		color: var(--ink);
		text-underline-offset: 3px;
		text-decoration-color: var(--line-strong);
		overflow-wrap: anywhere;
	}
	.notes :global(strong) {
		color: var(--ink);
		font-weight: var(--weight-semibold);
	}
	.files {
		display: inline-block;
		margin-top: 8px;
		font-size: 14px;
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
	}
	.files:hover {
		text-decoration-color: var(--ink);
	}
	.none {
		margin-top: 32px;
	}
	@media (max-width: 720px) {
		.page {
			padding-top: 48px;
		}
		.list > li {
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
		}
		.side {
			position: static;
			display: flex;
			align-items: baseline;
			gap: 12px;
		}
		time {
			margin: 0;
		}
	}
</style>
