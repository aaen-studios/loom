			</div>
		</div>
	</section>

	<section class="feature" aria-labelledby="f-spools">
		<div class="wrap split flip">
			<div class="copy" data-reveal>
				<h2 id="f-spools">Spools connect agents to your apps</h2>
				<p>
					Acta, T3 Code, GitHub, Notion, Linear and more, each connected from its card: fill in what it needs, sign in, and pick the agents that get it, with each tool marked as reading or changing something. The search finds the MCP Registry's servers too, marked Community, and any other MCP server can be added by hand.
				</p>
			</div>
			<div class="visual" data-reveal>
				<div class="page spools" aria-label="Spools in loom's settings">
					<div class="spools-head">
						<span class="page-title">Spools</span>
						<span class="tabs">
							<span class="tab on">Find</span>
							<span class="tab" data-installed="2">Installed · 2</span>
						</span>
					</div>
					<div class="find">
						<svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
						<span>Search Spools</span>
					</div>
					<div class="spool-cards">
						{
							featured.map((e) => (
								<div class="spool-card" data-spool={e.id}>
									<div class="tie">
										<span class="knot-box">
											<Knot size={20} />
										</span>
										<svg data-tie data-taut={e.connected ? '' : undefined} height="28" aria-hidden="true" />
										<span class="badge ink" set:html={e.mark} />
									</div>
									<span class="card-text">
										<span class="spool-name">{e.name}</span>
										<span class="spool-sub">{e.text}</span>
									</span>
									<div class="spool-foot">
										<span class="spool-state" hidden={!e.connected}>
											<svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
											Connected
										</span>
										<span class="spool-actions">{e.connected ? <span class="btn-small">Manage</span> : <span class="btn-small primary">Connect</span>}</span>
									</div>
								</div>
							))
						}
					</div>
					<div class="pills">{PILLS.map((p, i) => <span class:list={['pill', { on: i === 0 }]}>{p}</span>)}</div>
					<div class="spool-tiles">
						{
							tiles.map((t) => (
								<div class:list={['spool-tile', { on: t.connected }]}>
									<span class="spool-tile-top">
										<span class="tile-mark" set:html={t.mark} />
										{t.connected && (
											<span class="tile-check">
												<svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
											</span>
										)}
									</span>
									<span class="spool-tile-name">{t.name}</span>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="feature" aria-labelledby="f-voice">
		<div class="wrap split">
			<div class="copy" data-reveal>
				<h2 id="f-voice">Dictation, and replies read aloud</h2>
				<p>
					The composer's mic writes your words as you say them, with ElevenLabs Scribe, Deepgram, OpenAI or Groq, and replies can be read aloud with ElevenLabs, Fish Audio or OpenAI. Or download Parakeet, Whisper or Kokoro and run them on your computer, with no key. A service's key is kept sealed on your instance, so one key works on every device of yours, and an agent can set it up for you.
				</p>
			</div>
			<div class="visual" data-reveal>
				<div class="page voice" aria-label="Voice in loom's settings">
					<div class="spools-head">
						<span class="page-title">Voice</span>
						<span class="tabs" role="tablist">
							{
								VOICE.map((t, i) => (
									<button type="button" role="tab" class:list={['tab', { on: i === 0 }]} data-voice-tab={t.id} aria-selected={i === 0 ? 'true' : 'false'}>
										{t.name}
									</button>
								))
							}
						</span>
					</div>
					{
						VOICE.map((t, i) => (
							<div class="voice-pane" data-voice-pane={t.id} role="tabpanel" aria-label={t.name} hidden={i !== 0}>
								<div class="voice-tiles">
									{t.engines.map((e) => (
										<div
											class:list={['voice-tile', { on: e.on }]}
											data-engine={e.id}
											data-key={e.key ? '' : undefined}
											data-model={e.model === undefined ? undefined : modelState(e)}
											data-percent={typeof e.model === 'number' ? e.model : undefined}
										>
											<span class="voice-mark" aria-hidden="true" set:html={e.mark} />
											<span class="voice-text">
												<span class="voice-name">{e.name}</span>
												<span class="voice-line">{e.line}</span>
											</span>
											<div class="spool-foot" data-engine-foot>
												<span class="spool-state" hidden={!e.on}>
													<span class="tile-check">
														<svg class="i" viewBox="0 0 24 24" aria-hidden="true">
															<path d={CHECK} />
														</svg>
													</span>
													In use
												</span>
												{e.model !== undefined && (
													<span class="voice-bar" data-bar hidden={typeof e.model !== 'number'}>
														<span class="voice-bar-track">
															<span class="voice-bar-fill" style={`width: ${typeof e.model === 'number' ? e.model : 0}%`} />
														</span>
														<span data-bar-percent>{typeof e.model === 'number' ? e.model : 0}%</span>
													</span>
												)}
												<span class="spool-actions">
													{e.model !== undefined && (
														<button type="button" class:list={['btn-small', { primary: modelState(e) === 'absent' }]} data-model-btn>
															{MODEL_BUTTON[modelState(e)]}
														</button>
													)}
													<button type="button" class="btn-small" data-engine-btn hidden={e.model !== undefined && (e.model !== 'ready' || e.on)}>
														{engineButton(e)}
													</button>
												</span>
											</div>
											<div class="voice-key" data-key-form hidden>
												<span class="input key-input">
													<input type="password" placeholder={`${e.name} key`} aria-label={`${e.name} key`} autocomplete="off" spellcheck="false" data-key-input />
													<button type="button" class="eye" aria-label="Show the key" aria-pressed="false" data-key-eye>
														<svg class="i eye-on" viewBox="0 0 24 24" aria-hidden="true" set:html={EYE} />
														<svg class="i eye-off" viewBox="0 0 24 24" aria-hidden="true" set:html={EYE_OFF} />
													</button>
												</span>
												<span class="spool-actions">
													<button type="button" class="btn-small" data-key-cancel>
														Cancel
													</button>
													<button type="button" class="btn-small primary" data-key-save>
														Save
													</button>
												</span>
											</div>
										</div>
									))}
								</div>
								<div class="box voice-rows">
									{t.id === 'dictation' ? (
										<>
											<div class="row">
												<span class="row-text">
													<span class="row-title">Language</span>
												</span>
												<span class="menu-at">
													<button type="button" class="pick" data-pick aria-haspopup="menu" aria-expanded="false">
														<span data-pick-value>Detect</span>
														<svg class="i" viewBox="0 0 24 24" aria-hidden="true">
															<path d={CHEVRON} />
														</svg>
													</button>
													<span class="voice-menu" role="menu" data-pick-menu hidden>
														{LANGUAGES.map((l, j) => (
															<button type="button" role="menuitemradio" class:list={{ on: j === 0 }} aria-checked={j === 0 ? 'true' : 'false'} data-value={l}>
																{l}
															</button>
														))}
													</span>
												</span>
											</div>
											<div class="row">
												<span class="row-text">
													<span class="row-title">Shortcut</span>
												</span>
												<span class="segments" data-choice>
													{SHORTCUTS.map((s, j) => (
														<button type="button" class:list={['segment', { on: j === 0 }]}>
															{s}
														</button>
													))}
												</span>
											</div>
											<div class="row">
												<span class="row-text">
													<span class="row-title">Hold to talk</span>
												</span>
												<button type="button" class="switch" role="switch" aria-checked="false" aria-label="Hold to talk" data-switch>
													<span class="knob" />
												</button>
											</div>
										</>
									) : (
										<>
											<div class="row">
												<span class="row-text">
													<span class="row-title">Voice</span>
												</span>
												<span class="voice-pick">
													<span class="menu-at">
														<button type="button" class="pick" data-pick aria-haspopup="menu" aria-expanded="false">
															<span data-pick-value>Marin</span>
															<svg class="i" viewBox="0 0 24 24" aria-hidden="true">
																<path d={CHEVRON} />
															</svg>
														</button>
														<span class="voice-menu" role="menu" data-pick-menu hidden>
															{VOICES.map((v) => (
																<button type="button" role="menuitemradio" class:list={{ on: v === 'Marin' }} aria-checked={v === 'Marin' ? 'true' : 'false'} data-value={v}>
																	{v}
																</button>
															))}
														</span>
													</span>
													<button type="button" class="play" aria-label="Play" data-play>
														<svg class="i" viewBox="0 0 24 24" aria-hidden="true">
															<polygon points="6 3 20 12 6 21 6 3" />
														</svg>
													</button>
												</span>
											</div>
											<div class="row">
												<span class="row-text">
													<span class="row-title">Speed</span>
												</span>
												<span class="segments" data-choice>
													{SPEEDS.map((s) => (
														<button type="button" class:list={['segment', { on: s === '1×' }]}>
															{s}
														</button>
													))}
												</span>
											</div>
											<div class="row">
												<span class="row-text">
													<span class="row-title">Read replies aloud</span>
												</span>
												<span class="segments" data-choice>
													{READ_ALOUD.map((s, j) => (
														<button type="button" class:list={['segment', { on: j === 0 }]}>
															{s}
														</button>
													))}
												</span>
											</div>
										</>
									)}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="more" aria-label="More of what loom does">
		<div class="wrap">
			<ul class="grid">
				{
					more.map((m, i) => (
						<li data-reveal data-mood={m.mood} style={`--delay: ${(i % 3) * 0.08}s`}>
							<h3>
								<svg data-thread data-color={m.color} width="26" height="10" aria-hidden="true" />
								{m.title}
							</h3>
							<p>{m.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="questions" aria-labelledby="f-questions">
		<div class="wrap">
			<h2 id="f-questions" data-reveal>Questions</h2>
			<dl>
				{
					questions.map(({ q, a }) => (
						<div data-reveal>
							<dt>{q}</dt>
							<dd set:html={linked(a)} />
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="end" aria-labelledby="f-end">
		<div class="wrap">
			<h2 id="f-end" data-reveal>Open source</h2>
			<p>MIT licensed. The server and the app's core are written in <a href="https://calxlang.com">Calx</a>, and the desktop app is native.</p>
			<Get compact />
		</div>
	</section>
</Base>

<style>
	.hero {
		padding-top: 72px;
		text-align: center;
	}
	/* The heading: the wordmark, and what loom is under it. */
	h1 {
		display: grid;
		justify-items: center;
		gap: 22px;
	}
	/* The knot beside the wordmark: the app's proportions, a little tighter at this size. */
	.wordmark {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		font-size: clamp(64px, 12vw, 110px);
		letter-spacing: -0.035em;
		line-height: 1;
	}
	.wordmark :global(.hero-knot) {
		width: 1.3em;
		height: 1.3em;
		/* The knot's box is mostly air above and below; it shouldn't make the line taller. */
		margin: -0.3em 0;
		/* design/logo/README.md: large uses go down to 2.2. */
		stroke-width: 2.2;
	}
	/* Where the line sits, for the 3D letters to stand on. */
	.base {
		display: inline-block;
		width: 0;
		height: 0;
	}
	/* The agents' threads across the page, behind the wordmark (src/scripts/hero.ts). */
	.weave {
		position: absolute;
		z-index: 0;
		left: calc(50% - 50vw);
		top: calc(50% - 1.7em);
		width: 100vw;
		height: 3.4em;
		pointer-events: none;
	}
	.wordmark :global(.hero-knot),
	.word {
		position: relative;
		z-index: 1;
	}
	.kind {
		font-size: clamp(18px, 2.4vw, 21px);
		font-weight: var(--weight-regular);
		color: var(--ink-2);
		letter-spacing: -0.01em;
		line-height: 1.4;
	}
	.hero :global(.get) {
		margin-top: 32px;
	}
	.demo-wrap {
		margin-top: 56px;
	}

	.feature {
		margin-top: 140px;
	}
	.split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: center;
		gap: 64px;
	}
	.flip .copy {
		order: 2;
	}
	.copy h2 {
		font-size: clamp(26px, 3.4vw, 34px);
		letter-spacing: -0.03em;
	}
	.copy p {
		margin-top: 16px;
		font-size: 17px;
		color: var(--ink-2);
		max-width: 480px;
	}
	.visual {
		display: grid;
		gap: 14px;
	}

	/* A page of loom's settings, as the app draws one (desktop/src/app.rs: settings_page, group, row,
	   and the Brains page's cards), at the app's own sizes. */
	.page {
		display: grid;
		gap: var(--space-xl);
		padding: var(--space-xl);
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--bg);
		box-shadow: var(--shadow);
		text-align: left;
	}
	.page-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-m);
		min-height: var(--control-button);
	}
	.page-title {
		font-size: calc(var(--size-heading) - 2px);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.01em;
	}
	.group {
		display: grid;
		gap: var(--space-s);
	}
	.group-label {
		padding: 0 var(--space-xs);
		font-size: var(--size-caption);
		font-weight: var(--weight-medium);
		color: var(--ink-3);
	}
	.box {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--card);
		overflow: hidden;
	}
	.box > * + * {
		border-top: 1px solid var(--line);
	}
	.row {
		min-height: var(--control-row);
		display: flex;
		align-items: center;
		gap: var(--space-m);
		padding: calc(var(--space-s) + 2px) var(--space-l);
	}
	.row-text {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.row-title {
		font-size: var(--size-body);
		line-height: 1.35;
		color: var(--ink);
	}
	.row-sub {
		font-size: var(--size-caption);
		line-height: 1.35;
		color: var(--ink-3);
	}
	/* What if says why only once it has an answer, as the app does. */
	.row-sub:empty {
		display: none;
	}
	/* A brain's icon from the ACP Registry, drawn in the ink as the app draws it, in a square of its own. */
	.tile {
		--size: 34px;
		position: relative;
		flex: none;
		width: var(--size);
		height: var(--size);
		border: 1px solid var(--line);
		border-radius: calc(var(--radius-row) + 2px);
		background: var(--bg);
	}
	.tile.big {
		--size: 40px;
	}
	.tile::after {
		content: '';
		position: absolute;
		inset: 25%;
		background: var(--ink);
		-webkit-mask: var(--icon) center / contain no-repeat;
		mask: var(--icon) center / contain no-repeat;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-s);
	}
	.card {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-m);
		padding: var(--space-l);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--card);
	}
	.card[hidden] {
		display: none;
	}
	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-s);
	}
	.card-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.card-text .row-title {
		font-weight: var(--weight-medium);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.card-sub {
		height: 32px;
		overflow: hidden;
		font-size: var(--size-caption);
		line-height: 16px;
		color: var(--ink-3);
	}
	.btn-small {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: var(--control-button-small);
		padding: 0 var(--space-m);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-button);
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		color: var(--ink);
		white-space: nowrap;
		transition:
			background-color 0.15s,
			transform 0.15s;
	}
	.btn-small.primary {
		border-color: transparent;
		background: var(--button);
		color: var(--button-ink);
	}
	.btn-small.pressed {
		transform: scale(0.95);
		background: var(--hover);
	}
	.btn-small.primary.pressed {
		background: color-mix(in srgb, var(--button) 82%, var(--bg));
	}
	.brains :global(.installing) {
		flex: none;
		font-size: var(--size-caption);
		color: var(--ink-3);
		white-space: nowrap;
	}
	/* Brains as the app draws it (desktop/src/app.rs, programs_page): one column, Your brains with a
	   row for each brain, the open one's rows set in under its tile (brain_inset), then the ACP
	   Registry's cards under its small heading. */
	.brains {
		--brain-tile: calc(var(--control-lead) + 4px);
		--inset: calc(var(--brain-tile) + var(--space-m));
	}
	.find {
		display: flex;
		align-items: center;
		gap: var(--space-s);
		height: var(--control-button-small);
		padding: 0 10px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-input);
		font-size: var(--size-small);
		color: var(--ink-3);
	}
	.brains .i {
		width: 16px;
		height: 16px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.find .i {
		width: 14px;
		height: 14px;
	}
	.brain-row .tile {
		--size: var(--brain-tile);
	}
	.brain-row .row-title,
	.brain-row .row-sub {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.brains .chevron {
		color: var(--ink-3);
	}
	/* A brain's row opens it in place, and closes it again. */
	.brain-row[data-program] {
		cursor: pointer;
		outline: none;
		transition: background-color 0.12s;
	}
	.brain-row[data-program]:hover,
	.brain-row[data-program]:focus-visible {
		background: var(--hover);
	}
	.open-rows {
		display: flex;
		flex-direction: column;
	}
	.open-rows[hidden] {
		display: none;
	}
	.open-rows > * + * {
		border-top: 1px solid var(--line);
	}
	.registry-label {
		padding: 0 var(--space-xs);
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		color: var(--ink-2);
	}
	/* The plan it's signed in to, its session and its week, each a bar 6 tall with how much is used
	   and when it resets after it: quiet, orange from 75% and red from 90% (program_plan,
	   limit_inks). */
	.field-row {
		display: flex;
		align-items: center;
		gap: var(--space-m);
		padding: calc(var(--space-s) + 2px) var(--space-l);
		font-size: var(--size-body);
	}
	/* The app's label column, narrower in this small copy of the page, so the bar keeps room. */
	.field-name {
		flex: none;
		width: min(var(--layout-field-label), 30%);
		white-space: nowrap;
	}
	.plan-name {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.limit-bar {
		flex: 1;
		min-width: 0;
		height: 6px;
		border-radius: 999px;
		background: var(--line-strong);
		overflow: hidden;
	}
	.limit-bar span {
		display: block;
		height: 100%;
		border-radius: 999px;
		background: var(--ink-3);
	}
	.limit-words {
		flex: none;
		width: var(--layout-limit-words, 88px);
		text-align: right;
		font-size: var(--size-caption);
		color: var(--ink-3);
		white-space: nowrap;
	}
	.limit.warn .limit-bar span {
		background: var(--warn);
	}
	.limit.warn .limit-words {
		color: var(--warn);
	}
	.limit.bad .limit-bar span {
		background: var(--bad);
	}
	.limit.bad .limit-words {
		color: var(--bad);
	}
	/* The pool: a line for the whole of it and one for each account, its name and how it stands,
	   then a bar for each window it reports (pool_line). */
	.pool-line {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-xs) + 2px);
		padding: calc(var(--space-s) + 2px) var(--space-l);
	}
	.pool-head,
	.pool-limit {
		min-width: 0;
		display: flex;
		align-items: center;
		gap: var(--space-m);
	}
	.pool-head {
		font-size: var(--size-small);
	}
	.pool-name,
	.pool-label {
		flex: none;
		width: min(150px, 34%);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.pool-name {
		font-weight: var(--weight-medium);
		color: var(--ink);
	}
	/* An account's name is hidden until the pointer is over it (hidden_name). */
	.pool-name.account {
		filter: blur(5px);
		transition: filter 0.15s;
	}
	.pool-name.account:hover {
		filter: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.pool-name.account {
			transition: none;
		}
	}
	.pool-label {
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.pool-state {
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--ink-3);
	}
	.pool-state.total {
		color: var(--ink-2);
	}
	.pool-state.warn {
		color: var(--warn);
	}
	.pool-state.bad {
		color: var(--bad);
	}
	/* Its settings: one there, the form that adds one, sharing it, and removing it. */
	.add-setting {
		display: flex;
		align-items: center;
		gap: var(--space-s);
		padding: var(--space-m) var(--space-l);
	}
	.placeholder {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--ink-3);
	}
	.wrap-row {
		min-height: var(--control-row);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-m);
		padding: calc(var(--space-s) + 2px) var(--space-l);
	}
	.wrap-row > .row-title {
		flex: 1 0 auto;
		white-space: nowrap;
	}
	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-s);
	}
	.share .input {
		flex: none;
		width: 96px;
	}
	.brain-actions {
		display: flex;
		justify-content: flex-end;
		padding: var(--space-m) var(--space-l);
	}
	.btn-small.danger {
		color: var(--bad);
	}
	/* Set in under the brain's tile. */
	.brains .inset {
		padding-left: calc(var(--space-l) + var(--inset));
	}
	/* On a phone the rows keep the room the bars need. */
	@media (max-width: 560px) {
		.brains {
			--inset: 0px;
		}
		.brains .limit-words {
			width: 80px;
		}
	}
	/* The brain that installed comes into the list, and the cards move up into its place. */
	.brain-row.arrived {
		animation: arrive 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) both;
	}
	@keyframes arrive {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}
	.card.leaving {
		transition:
			opacity 0.25s,
			transform 0.25s;
		opacity: 0;
		transform: scale(0.97);
	}

	/* What if: a choice of a few side by side, a field, and what the action would get. */
	.segments {
		flex: none;
		display: flex;
		gap: 2px;
		padding: 2px;
		border-radius: calc(var(--radius-row) + 2px);
		background: var(--raised-2);
	}
	.segment {
		display: flex;
		align-items: center;
		height: var(--control-segment);
		padding: 0 var(--space-m);
		border-radius: var(--radius-row);
		font-size: var(--size-small);
		color: var(--ink-2);
		white-space: nowrap;
		transition:
			background-color 0.2s,
			color 0.2s,
			box-shadow 0.2s;
	}
	.segment.on {
		background: var(--picked);
		color: var(--ink);
		font-weight: var(--weight-medium);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
	}
	.field-label {
		flex: none;
		width: var(--layout-field-label);
		font-size: var(--size-body);
	}
	.input {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		height: var(--control-button-small);
		padding: 0 10px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-input);
		background: var(--bg);
		font-size: var(--size-small);
		white-space: nowrap;
		overflow: hidden;
	}
	.caret {
		width: 1px;
		height: 15px;
		margin-left: 1px;
		background: var(--ink);
		opacity: 0;
	}
	.input.typing .caret {
		opacity: 1;
	}
	/* Where a row's choices don't fit beside its name, they go under it, across the row, and
	   onto a second line when they must, each line filling it, so every choice stays whole. */
	@media (max-width: 560px) {
		.row:has(.segments) {
			flex-wrap: wrap;
			row-gap: var(--space-s);
		}
		.row:has(.segments) .row-text {
			flex-basis: 100%;
		}
		.segments {
			flex-wrap: wrap;
			width: 100%;
		}
		.segment {
			flex: 1 1 auto;
			justify-content: center;
		}
	}
	.result .row-title {
		font-weight: var(--weight-medium);
	}
	.result .row-text {
		transition: opacity 0.2s;
	}
	.result.asking .row-text {
		opacity: 0.4;
	}
	/* The servers in the app's server popup, each with its ball of yarn. */
	.panel {
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--side);
	}

	.servers {
		display: grid;
		gap: 4px;
		padding: 10px;
	}
	.server-row {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 10px;
		border-radius: 8px;
	}
	.server-row:first-child {
		background: var(--active);
	}
	.server-text {
		display: grid;
		line-height: 1.3;
		text-align: left;
	}
	.server-text b {
		font-size: 14px;
		font-weight: var(--weight-medium);
	}
	.server-text small {
		font-size: 12.5px;
		color: var(--ink-3);
	}
	.server-row svg {
		width: 32px;
		height: 32px;
		flex: none;
	}
	.visual :global(.server-cmd) {
		background: var(--bg);
	}

	/* Spools' Find tab, as the app draws it (desktop/src/spools.rs): Find and Installed beside the
	   title, the search, Acta and T3 Code as wide cards in black and white, the pills, and the rest
	   as tiles four to a row. */
	.spools {
		gap: var(--space-l);
	}
	.spools-head {
		display: flex;
		align-items: center;
		gap: var(--space-m);
		min-height: var(--control-button);
	}
	.tabs {
		display: flex;
		gap: var(--space-xs);
	}
	.tab {
		display: flex;
		align-items: center;
		height: var(--control-segment);
		padding: 0 var(--space-m);
		border-radius: var(--radius-row);
		font-size: var(--size-small);
		color: var(--ink-2);
		white-space: nowrap;
	}
	.tab.on {
		background: var(--active);
		color: var(--ink);
		font-weight: var(--weight-medium);
	}
	.spool-cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-m);
	}
	.spool-card {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-m);
		padding: var(--space-l);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--card);
	}
	/* loom's knot, the tie, and the logo. */
	.tie {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
	}
	.tie svg {
		flex: 1;
		min-width: 0;
		height: 28px;
	}
	.knot-box {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--control-icon-large);
		height: var(--control-icon-large);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-card);
		background: var(--bg);
		color: var(--ink);
	}
	.knot-box :global(svg) {
		flex: none;
	}
	/* A server's badge: its initial on its colour (app.rs, badge_view). */
	.badge {
		--size: var(--control-icon-large);
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--size);
		height: var(--size);
		border-radius: var(--radius-card);
		background: var(--tint);
		font-size: 15px;
		font-weight: var(--weight-semibold);
		color: var(--button-ink);
	}
	/* One of loom's own, Acta or T3 Code: its logo on a tile in ink, black in light and white in
	   dark (spools.rs, spool_mark_ink). */
	.badge.ink {
		background: var(--button);
		color: var(--button-ink);
	}
	/* Its mark, in the initial's place and ink. */
	.badge :global(svg) {
		width: 56%;
		height: 56%;
	}
	.spool-card .card-text {
		min-width: 0;
	}
	.spool-name,
	.spool-sub,
	.spool-tile-name {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.spool-name {
		font-size: var(--size-body);
		font-weight: var(--weight-semibold);
		color: var(--ink);
	}
	.spool-sub {
		font-size: var(--size-small);
		color: var(--ink-2);
	}
	.spool-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-s);
		min-height: var(--control-button-small);
	}
	.spool-state {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
		color: var(--ink);
	}
	.spool-state[hidden] {
		display: none;
	}
	.spool-state.arrived {
		animation: arrive 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) both;
	}
	.spool-actions {
		margin-left: auto;
		display: flex;
		gap: var(--space-s);
	}
	.spools .i {
		width: 14px;
		height: 14px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.pill {
		display: flex;
		align-items: center;
		height: var(--control-segment);
		padding: 0 var(--space-m);
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: var(--size-small);
		color: var(--ink-2);
		white-space: nowrap;
	}
	.pill.on {
		border-color: transparent;
		background: var(--button);
		color: var(--button-ink);
	}
	.spool-tiles {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-s);
	}
	.spool-tile {
		min-width: 0;
		height: var(--control-tile);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: var(--space-m);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--bg);
		color: var(--ink);
	}
	/* Connected: the whole tile in ink, its logo and name in the ink on it. */
	.spool-tile.on {
		border-color: var(--button);
		background: var(--button);
		color: var(--button-ink);
	}
	.spool-tile-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}
	/* Its logo alone, with no box behind it. */
	.tile-mark {
		display: flex;
		width: 24px;
		height: 24px;
	}
	.tile-mark :global(svg) {
		width: 100%;
		height: 100%;
	}
	.tile-check {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 16px;
		border: 1px solid currentColor;
		border-radius: 999px;
	}
	.spools .tile-check .i {
		width: 10px;
		height: 10px;
	}
	.spool-tile-name {
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
	}
	/* Where it's narrow, the cards go one under the other and the tiles two to a row. */
	@media (max-width: 560px) {
		.spool-cards {
			grid-template-columns: minmax(0, 1fr);
		}
		.spool-tiles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Settings › Voice, as the app draws it (PLAN.md, "Voice"): Dictation and Speech beside the
	   title, the engines as tiles in black and white, as Spools' Find draws its tiles, and the
	   tab's rows under them. */
	.voice {
		gap: var(--space-l);
	}
	:where(.voice) button {
		font: inherit;
		color: inherit;
		background: none;
		border: 0;
		padding: 0;
		cursor: pointer;
	}
	.voice .tab {
		transition:
			background-color 0.15s,
			color 0.15s;
	}
	.voice .tab:not(.on):hover {
		background: var(--hover);
	}
	.voice-pane {
		display: grid;
		gap: var(--space-l);
	}
	.voice-pane[hidden] {
		display: none;
	}
	.voice .i {
		width: 14px;
		height: 14px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.voice-tiles {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-s);
	}
	.voice-tile {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		padding: var(--space-m);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--bg);
		color: var(--ink);
		transition: border-color 0.2s;
	}
	/* The engine in use, outlined in ink. */
	.voice-tile.on {
		border-color: var(--ink);
	}
	/* Its maker's logo on a small tile in ink, black in light and white in dark. */
	.voice-mark {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: var(--control-icon);
		height: var(--control-icon);
		border-radius: var(--radius-row);
		background: var(--button);
		color: var(--button-ink);
	}
	.voice-mark :global(svg) {
		width: 56%;
		height: 56%;
	}
	.voice-text {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.voice-name,
	.voice-line {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.voice-name {
		font-size: var(--size-small);
		font-weight: var(--weight-medium);
	}
	.voice-line {
		font-size: var(--size-caption);
		color: var(--ink-3);
	}
	.voice .spool-foot {
		flex-wrap: nowrap;
	}
	.voice .spool-foot[hidden],
	.voice .btn-small[hidden],
	.voice-key[hidden],
	.voice-bar[hidden] {
		display: none;
	}
	/* A model's download: a thin bar, filled in ink as far as it's come, and its percent. */
	.voice-bar {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: var(--space-s);
		font-size: var(--size-small);
		color: var(--ink-2);
		font-variant-numeric: tabular-nums;
	}
	.voice-bar-track {
		flex: 1;
		height: 3px;
		border-radius: 999px;
		background: var(--line);
		overflow: hidden;
	}
	.voice-bar-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--ink);
		transition: width 0.2s linear;
	}
	.voice .tile-check .i {
		width: 10px;
		height: 10px;
	}
	.voice .btn-small:hover {
		background: var(--hover);
	}
	.voice .btn-small.primary:hover {
		background: color-mix(in srgb, var(--button) 86%, var(--bg));
	}
	/* Add key: the key, masked, with an eye to show it, then Cancel and Save. */
	.voice-key {
		display: grid;
		gap: var(--space-s);
	}
	.key-input {
		gap: var(--space-xs);
		padding-right: 4px;
	}
	.key-input input {
		flex: 1;
		min-width: 0;
		height: 100%;
		border: 0;
		outline: none;
		background: none;
		font: inherit;
		color: var(--ink);
	}
	.key-input input::placeholder {
		color: var(--ink-3);
	}
	.key-input:focus-within {
		border-color: var(--ink-3);
	}
	.eye,
	.play {
		flex: none;
		display: grid;
		place-items: center;
		width: var(--control-icon-small);
		height: var(--control-icon-small);
		border-radius: var(--radius-row);
		color: var(--ink-2);
		transition:
			background-color 0.12s,
			transform 0.15s;
	}
	.eye {
		width: 22px;
		height: 22px;
	}
	.eye:hover,
	.play:hover {
		background: var(--hover);
	}
	.play.pressed {
		transform: scale(0.92);
	}
	.eye .eye-off,
	.eye[aria-pressed='true'] .eye-on {
		display: none;
	}
	.eye[aria-pressed='true'] .eye-off {
		display: block;
	}
	/* Its rows: a menu for the language or the voice, a few choices side by side, and a switch. */
	.voice-rows {
		overflow: visible;
	}
	.voice-pick {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
	}
	.menu-at {
		position: relative;
		display: flex;
	}
	.pick {
		display: flex;
		align-items: center;
		gap: 6px;
		height: var(--control-button-small);
		padding: 0 var(--space-s) 0 var(--space-m);
		border-radius: var(--radius-button);
		font-size: var(--size-small);
		color: var(--ink);
		transition: background-color 0.12s;
	}
	.pick:hover,
	.pick[aria-expanded='true'] {
		background: var(--hover);
	}
	.pick .i {
		color: var(--ink-3);
	}
	.voice-menu {
		position: absolute;
		right: 0;
		top: calc(100% + 4px);
		z-index: 5;
		display: flex;
		flex-direction: column;
		width: 160px;
		max-height: 220px;
		overflow-y: auto;
		padding: var(--space-xs);
		background: var(--raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-card);
		box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.25);
		scrollbar-width: thin;
	}
	.voice-menu[hidden] {
		display: none;
	}
	.voice-menu button {
		display: flex;
		align-items: center;
		padding: 6px var(--space-m);
		border-radius: var(--radius-row);
		font-size: var(--size-small);
		text-align: left;
		color: var(--ink);
	}
	.voice-menu button:hover {
		background: var(--hover);
	}
	.voice-menu .on::after {
		content: '✓';
		margin-left: auto;
		color: var(--ink-2);
	}
	/* A switch as the app draws it (app.rs, switch): 38 by 22, its knob 16, in ink when it's on. */
	.switch {
		position: relative;
		flex: none;
		width: 38px;
		height: 22px;
		border-radius: var(--radius-row);
		background: var(--line-strong);
		transition: background-color 0.2s;
	}
	.switch[aria-checked='true'] {
		background: var(--button);
	}
	.knob {
		position: absolute;
		top: 3px;
		left: 3px;
		width: 16px;
		height: 16px;
		border-radius: 4px;
		background: var(--bg);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
		transition:
			transform 0.2s cubic-bezier(0.2, 0.7, 0.3, 1),
			background-color 0.2s;
	}
	.switch[aria-checked='true'] .knob {
		transform: translateX(16px);
		background: var(--button-ink);
	}
	@media (prefers-reduced-motion: reduce) {
		.knob,
		.voice-tile,
		.voice-bar-fill {
			transition: none;
		}
	}
	@media (max-width: 560px) {
		.voice-tiles {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.more {
		margin-top: 140px;
	}
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		border-top: 1px solid var(--line);
	}
	.grid li {
		padding: 28px 28px 32px 0;
		border-bottom: 1px solid var(--line);
	}
	.grid li:not(:nth-child(3n + 1)) {
		padding-left: 28px;
		border-left: 1px solid var(--line);
	}
	.grid h3 {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 16px;
		letter-spacing: -0.01em;
	}
	.grid h3 svg {
		width: 26px;
		height: 10px;
		flex: none;
	}
	.grid p {
		padding-left: 38px;
	}
	.grid p {
		margin-top: 8px;
		font-size: 14.5px;
		color: var(--ink-3);
	}

	.questions {
		margin-top: 140px;
	}
	.questions h2 {
		font-size: clamp(26px, 3.4vw, 34px);
		letter-spacing: -0.03em;
	}
	.questions dl {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 56px;
		margin: 28px 0 0;
		border-top: 1px solid var(--line);
	}
	.questions dl > div {
		padding: 24px 0 26px;
		border-bottom: 1px solid var(--line);
	}
	.questions dt {
		font-size: 16px;
		font-weight: var(--weight-semibold);
		letter-spacing: -0.01em;
	}
	.questions dd {
		margin: 8px 0 0;
		font-size: 15px;
		color: var(--ink-2);
		max-width: 520px;
	}
	.questions dd :global(code) {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink);
		overflow-wrap: anywhere;
	}
	.questions dd :global(a) {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 3px;
	}
	.end {
		margin-top: 140px;
		text-align: center;
	}
	.end h2 {
		font-size: clamp(26px, 3.4vw, 34px);
		letter-spacing: -0.03em;
	}
	.end p {
		margin: 14px auto 0;
		max-width: 520px;
		font-size: 17px;
		color: var(--ink-2);
	}
	.end p a {
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
	}
	.end :global(.get) {
		margin-top: 28px;
	}

	@media (max-width: 900px) {
		.split {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}
		.flip .copy {
			order: 0;
		}
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.grid li,
		.grid li:not(:nth-child(3n + 1)) {
			padding: 24px 24px 28px 0;
			border-left: 0;
		}
		.grid li:nth-child(2n) {
			padding-left: 24px;
			border-left: 1px solid var(--line);
		}
	}
	@media (max-width: 640px) {
		.hero {
			padding-top: 56px;
		}
		.demo-wrap {
			margin-top: 44px;
		}
		.questions dl {
			grid-template-columns: minmax(0, 1fr);
		}
		.feature,
		.more,
		.questions,
		.end {
			margin-top: 96px;
		}
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.grid li,
		.grid li:nth-child(2n) {
			padding: 22px 0 24px;
			border-left: 0;
		}
	}
</style>

<script>
	// The panels' little scenes, each played once when it comes into view, and the grid's threads,
	// which work while their item is hovered.
	import { threadOf, threadsIn, tieOf, tiesIn, yarnsIn, type Mood } from '../scripts/thread';

	const pause = (ms: number) => new Promise((done) => setTimeout(done, ms));
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	/** Runs play once el has risen into view. */
	const whenShown = (el: Element | null, play: () => void) => {
		if (!el) return;
		if (el.classList.contains('shown')) play();
		else el.addEventListener('shown', play, { once: true });
	};

	const ease = 'cubic-bezier(0.2, 0.7, 0.3, 1)';

	// Brains: Claude Agent's row closes it, and opens it again in place, the chevron turning with it
	// (desktop/src/app.rs, programs_page).
	const brains = document.querySelector<HTMLElement>('.brains');
	const opener = brains?.querySelector<HTMLElement>('[data-program]');
	const openRows = brains?.querySelector<HTMLElement>('[data-open-rows]');
	const toggle = () => {
		if (!opener || !openRows) return;
		const open = openRows.hidden;
		openRows.hidden = !open;
		opener.setAttribute('aria-expanded', String(open));
		opener.querySelector('.chevron path')?.setAttribute('d', open ? 'm6 9 6 6 6-6' : 'm9 18 6-6-6-6');
	};
	opener?.addEventListener('click', toggle);
	opener?.addEventListener('keydown', (e) => {
		if (e.key !== 'Enter' && e.key !== ' ') return;
		e.preventDefault();
		toggle();
	});

	// Brains: the first card installs and joins Your brains, as the app lists it once it's in, and
	// the cards move up into its place, the next in the registry coming in last.
	whenShown(brains?.closest('[data-reveal]') ?? null, async () => {
		const mine = brains?.querySelector('.mine');
		const all = [...(brains?.querySelectorAll<HTMLElement>('.card') ?? [])];
		const card = all[0];
		const next = all.find((c) => c.hidden);
		const button = card?.querySelector('.btn-small');
		const model = brains?.querySelector('[data-closed]');
		if (!mine || !card || !button || !model || still) return;
		await pause(1100);
		button.classList.add('pressed');
		await pause(160);
		const busy = document.createElement('span');
		busy.className = 'installing';
		busy.textContent = 'Installing…';
		button.replaceWith(busy);
		await pause(2400);
		const row = model.cloneNode(true) as HTMLElement;
		row.querySelector('.tile')?.setAttribute('style', `--icon: url(${card.dataset.icon})`);
		const title = row.querySelector('.row-title');
		const sub = row.querySelector('.row-sub');
		if (title) title.textContent = card.dataset.name ?? '';
		if (sub) sub.textContent = `Version ${card.dataset.version} · No settings`;
		row.classList.add('arrived');
		const others = all.filter((c) => c !== card && !c.hidden);
		card.classList.add('leaving');
		await pause(250);
		const before = new Map(others.map((c) => [c, c.getBoundingClientRect()]));
		card.remove();
		mine.append(row);
		if (next) next.hidden = false;
		for (const c of others) {
			const a = before.get(c);
			const b = c.getBoundingClientRect();
			if (a) c.animate([{ transform: `translate(${a.left - b.left}px, ${a.top - b.top}px)` }, { transform: 'none' }], { duration: 450, easing: ease });
		}
		next?.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 450, delay: 150, easing: ease, fill: 'backwards' });
	});

	// Rules: What if tries an action at a time and says what it would get, in the server's own words
	// (server/instance.calx, rule.check), going round while it's on screen.
	const rules = document.querySelector<HTMLElement>('.rules');
	const examples = [
		{ on: 0, label: 'Command', text: 'git push origin main', by: 1, verdict: 'Asks you', why: 'Asks, by your rule "Ask before commands like git push *".' },
		{ on: 1, label: 'Path', text: '~/.ssh/id_ed25519', by: 1, verdict: 'Denied', why: 'Denied by your rule "Deny the path ~/.ssh/**".' },
		{ on: 2, label: 'Site', text: 'api.github.com', by: 2, verdict: 'Allowed', why: 'Allowed by your rule "Allow the site github.com".' },
	];
	if (rules) {
		const pick = (list: HTMLElement | null, i: number) => list?.querySelectorAll('.segment').forEach((s, j) => s.classList.toggle('on', i === j));
		const on = rules.querySelector<HTMLElement>('[data-on]');
		const by = rules.querySelector<HTMLElement>('[data-by]');
		const label = rules.querySelector('[data-label]');
		const input = rules.querySelector<HTMLElement>('[data-input]');
		const typed = rules.querySelector('.typed');
		const check = rules.querySelector('[data-check]');
		const result = rules.querySelector('.result');
		const verdict = rules.querySelector('[data-verdict]');
		const why = rules.querySelector('[data-why]');
		const show = (e: (typeof examples)[number]) => {
			pick(on, e.on);
			pick(by, e.by);
			if (label) label.textContent = e.label;
			if (typed) typed.textContent = e.text;
			if (verdict) verdict.textContent = e.verdict;
			if (why) why.textContent = e.why;
		};
		if (still) show(examples[0]);
		else {
			let seen = false;
			let wake = () => {};
			new IntersectionObserver((entries) => {
				const e = entries[entries.length - 1];
				seen = e.isIntersecting;
				if (seen) wake();
			}).observe(rules);
			const onScreen = () => (seen ? Promise.resolve() : new Promise<void>((done) => (wake = done)));
			(async () => {
				for (let i = 0; ; i = (i + 1) % examples.length) {
					await onScreen();
					const e = examples[i];
					await pause(i === 0 ? 700 : 400);
					pick(on, e.on);
					if (label) label.textContent = e.label;
					if (typed) typed.textContent = '';
					input?.classList.add('typing');
					await pause(350);
					for (const ch of e.text) {
						if (typed) typed.textContent += ch;
						await pause(45 + Math.random() * 40);
					}
					input?.classList.remove('typing');
					await pause(250);
					pick(by, e.by);
					await pause(450);
					check?.classList.add('pressed');
					result?.classList.add('asking');
					await pause(160);
					check?.classList.remove('pressed');
					await pause(300);
					if (verdict) verdict.textContent = e.verdict;
					if (why) why.textContent = e.why;
					result?.classList.remove('asking');
					await pause(3200);
				}
			})();
		}
	}

	// Servers: each with its ball of yarn, at rest while it's connected.
	yarnsIn(document.querySelector('.servers') ?? undefined);

	// Spools: Acta's tie is taut and T3 Code's slack. T3 Code's Connect is pressed, and once it's
	// connected its tie pulls straight with a twang, the card says so with Connect another and Manage,
	// as the app's does for one there can be several of, and Installed counts it.
	const spools = document.querySelector<HTMLElement>('.spools');
	tiesIn(spools ?? undefined);
	whenShown(spools?.closest('[data-reveal]') ?? null, async () => {
		const card = spools?.querySelector<HTMLElement>('[data-spool="t3"]');
		const tie = tieOf(card?.querySelector('svg[data-tie]') ?? null);
		const state = card?.querySelector<HTMLElement>('.spool-state');
		const button = card?.querySelector<HTMLElement>('.spool-actions .btn-small');
		const installed = spools?.querySelector<HTMLElement>('[data-installed]');
		if (!tie || !state || !button || still) return;
		await pause(1400);
		button.classList.add('pressed');
		await pause(160);
		button.classList.remove('pressed');
		await pause(1100);
		tie.pull();
		await pause(250);
		state.hidden = false;
		state.classList.add('arrived');
		// Clones, so they keep the page's scoped styles.
		const another = button.cloneNode(true) as HTMLElement;
		another.classList.remove('primary');
		another.textContent = 'Connect another';
		const manage = another.cloneNode(true) as HTMLElement;
		manage.textContent = 'Manage';
		button.replaceWith(another, manage);
		if (installed) {
			const n = Number(installed.dataset.installed) + 1;
			installed.dataset.installed = String(n);
			installed.textContent = `Installed · ${n}`;
		}
	});

	// Voice: the tabs switch between Dictation and Speech; Use moves In use to its tile; Add key
	// and Change key open the masked key field, whose eye shows it and whose Save keeps it, so the
	// tile offers Use; the menus pick a language or a voice; the choices and the switch set
	// themselves.
	const voice = document.querySelector<HTMLElement>('.voice');
	if (voice) {
		const tabs = [...voice.querySelectorAll<HTMLElement>('[data-voice-tab]')];
		for (const tab of tabs) {
			tab.addEventListener('click', () => {
				for (const t of tabs) {
					const on = t === tab;
					t.classList.toggle('on', on);
					t.setAttribute('aria-selected', String(on));
				}
				voice.querySelectorAll<HTMLElement>('[data-voice-pane]').forEach((p) => (p.hidden = p.dataset.voicePane !== tab.dataset.voiceTab));
				closeMenus();
			});
		}

		const label = (tile: HTMLElement) => (tile.classList.contains('on') ? 'Change key' : tile.hasAttribute('data-key') ? 'Use' : 'Add key');
		const draw = (tile: HTMLElement) => {
			const button = tile.querySelector<HTMLElement>('[data-engine-btn]');
			const state = tile.querySelector<HTMLElement>('.spool-state');
			const on = tile.classList.contains('on');
			const model = tile.dataset.model;
			if (button) {
				button.textContent = label(tile);
				button.hidden = model !== undefined && (model !== 'ready' || on);
			}
			if (state) state.hidden = !on;
			if (model === undefined) return;
			const act = tile.querySelector<HTMLElement>('[data-model-btn]');
			if (act) {
				act.textContent = model === 'absent' ? 'Download' : model === 'downloading' ? 'Cancel' : 'Delete';
				act.classList.toggle('primary', model === 'absent');
			}
			const bar = tile.querySelector<HTMLElement>('[data-bar]');
			if (bar) {
				const percent = `${tile.dataset.percent ?? 0}%`;
				bar.hidden = model !== 'downloading';
				bar.querySelector<HTMLElement>('.voice-bar-fill')!.style.width = percent;
				bar.querySelector<HTMLElement>('[data-bar-percent]')!.textContent = percent;
			}
		};
		// A model's download: a percent at a time, then Delete and Use. Cancel and Delete start over.
		const downloads = new Map<HTMLElement, number>();
		const download = (tile: HTMLElement) => {
			tile.dataset.model = 'downloading';
			tile.dataset.percent ??= '0';
			draw(tile);
			downloads.set(
				tile,
				window.setInterval(() => {
					const percent = Number(tile.dataset.percent) + 1;
					tile.dataset.percent = String(percent);
					if (percent >= 100) {
						window.clearInterval(downloads.get(tile));
						downloads.delete(tile);
						tile.dataset.model = 'ready';
						delete tile.dataset.percent;
					}
					draw(tile);
				}, 150),
			);
		};
		const forget = (tile: HTMLElement) => {
			window.clearInterval(downloads.get(tile));
			downloads.delete(tile);
			tile.dataset.model = 'absent';
			delete tile.dataset.percent;
			tile.classList.remove('on');
			draw(tile);
		};
		const downloading = voice.querySelector<HTMLElement>('.voice-tile[data-model="downloading"]');
		if (downloading) whenShown(voice.closest('[data-reveal]'), () => download(downloading));
		const keyForm = (tile: HTMLElement, open: boolean) => {
			const foot = tile.querySelector<HTMLElement>('[data-engine-foot]');
			const form = tile.querySelector<HTMLElement>('[data-key-form]');
			const input = tile.querySelector<HTMLInputElement>('[data-key-input]');
			const eye = tile.querySelector<HTMLElement>('[data-key-eye]');
			if (!foot || !form || !input) return;
			foot.hidden = open;
			form.hidden = !open;
			input.value = '';
			input.type = 'password';
			eye?.setAttribute('aria-pressed', 'false');
			eye?.setAttribute('aria-label', 'Show the key');
			if (open) input.focus({ preventScroll: true });
		};
		for (const pane of voice.querySelectorAll<HTMLElement>('[data-voice-pane]')) {
			const tiles = [...pane.querySelectorAll<HTMLElement>('.voice-tile')];
			for (const tile of tiles) {
				tile.querySelector('[data-engine-btn]')?.addEventListener('click', () => {
					if (label(tile) !== 'Use') return keyForm(tile, true);
					for (const t of tiles) {
						t.classList.toggle('on', t === tile);
						draw(t);
					}
				});
				tile.querySelector('[data-model-btn]')?.addEventListener('click', () => (tile.dataset.model === 'absent' ? download(tile) : forget(tile)));
				tile.querySelector('[data-key-cancel]')?.addEventListener('click', () => keyForm(tile, false));
				const input = tile.querySelector<HTMLInputElement>('[data-key-input]');
				const save = () => {
					if (!input?.value.trim()) return input?.focus({ preventScroll: true });
					tile.setAttribute('data-key', '');
					keyForm(tile, false);
					draw(tile);
				};
				tile.querySelector('[data-key-save]')?.addEventListener('click', save);
				input?.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') save();
					if (e.key === 'Escape') keyForm(tile, false);
				});
				const eye = tile.querySelector<HTMLElement>('[data-key-eye]');
				eye?.addEventListener('click', () => {
					if (!input) return;
					const shown = input.type === 'password';
					input.type = shown ? 'text' : 'password';
					eye.setAttribute('aria-pressed', String(shown));
					eye.setAttribute('aria-label', shown ? 'Hide the key' : 'Show the key');
				});
			}
		}

		// The language's and the voice's menus: one open at a time, closed by a pick, Esc or a click
		// outside.
		const picks = [...voice.querySelectorAll<HTMLElement>('.menu-at')];
		function closeMenus(but?: HTMLElement) {
			for (const at of picks) {
				if (at === but) continue;
				at.querySelector<HTMLElement>('[data-pick-menu]')!.hidden = true;
				at.querySelector('[data-pick]')?.setAttribute('aria-expanded', 'false');
			}
		}
		for (const at of picks) {
			const pick = at.querySelector<HTMLElement>('[data-pick]');
			const menu = at.querySelector<HTMLElement>('[data-pick-menu]');
			const value = at.querySelector<HTMLElement>('[data-pick-value]');
			if (!pick || !menu || !value) continue;
			pick.addEventListener('click', () => {
				closeMenus(at);
				const open = menu.hidden;
				menu.hidden = !open;
				pick.setAttribute('aria-expanded', String(open));
				if (open) menu.querySelector<HTMLElement>('.on')?.scrollIntoView({ block: 'nearest' });
			});
			for (const item of menu.querySelectorAll<HTMLElement>('[data-value]')) {
				item.addEventListener('click', () => {
					menu.querySelectorAll('[data-value]').forEach((i) => {
						i.classList.toggle('on', i === item);
						i.setAttribute('aria-checked', String(i === item));
					});
					value.textContent = item.dataset.value ?? '';
					closeMenus();
				});
			}
		}
		document.addEventListener('pointerdown', (e) => {
			if (!picks.some((at) => at.contains(e.target as Node))) closeMenus();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') closeMenus();
		});

		for (const choice of voice.querySelectorAll<HTMLElement>('[data-choice]')) {
			const segments = [...choice.querySelectorAll<HTMLElement>('.segment')];
			for (const s of segments) s.addEventListener('click', () => segments.forEach((o) => o.classList.toggle('on', o === s)));
		}
		voice.querySelectorAll<HTMLElement>('[data-switch]').forEach((sw) =>
			sw.addEventListener('click', () => sw.setAttribute('aria-checked', String(sw.getAttribute('aria-checked') !== 'true'))),
		);
		const play = voice.querySelector<HTMLElement>('[data-play]');
		play?.addEventListener('click', () => {
			play.classList.add('pressed');
			setTimeout(() => play.classList.remove('pressed'), 160);
		});
	}

	// The grid: each item's thread works while it's hovered, and they all twang as the grid arrives.
	const items = [...document.querySelectorAll<HTMLElement>('.grid li')];
	threadsIn(document.querySelector('.grid') ?? undefined);
	items.forEach((li, i) => {
		const th = threadOf(li.querySelector('svg[data-thread]'));
		if (!th) return;
		li.addEventListener('pointerenter', () => th.set((li.dataset.mood as Mood) ?? 'writing'));
		li.addEventListener('pointerleave', () => th.set('idle'));
		whenShown(li, () => setTimeout(() => th.pluck(1), 350 + (i % 3) * 120));
	});
</script>

<script>
	import { startHero } from '../scripts/hero';
	const mark = document.querySelector<HTMLElement>('.hero .mark');
	const canvas = mark?.querySelector<HTMLCanvasElement>('canvas.weave');
	if (mark && canvas) startHero(mark, canvas);
</script>
