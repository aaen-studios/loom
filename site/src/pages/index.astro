---
// The home page: what loom is, the app itself (a live copy, src/components/AppDemo.astro), what it
// does, and how to get it.
import Base from '../layouts/Base.astro';
import AppDemo from '../components/AppDemo.astro';
import Command from '../components/Command.astro';
import Get from '../components/Get.astro';
import Knot from '../components/Knot.astro';
import { INSTALL } from '../lib/site.mjs';
import { brains } from '../lib/registry.mjs';
import actaMark from '../../../server/catalog/acta.svg?raw';
import githubMark from '../../../server/catalog/github.svg?raw';
import notionMark from '../../../server/catalog/notion.svg?raw';
import linearMark from '../../../server/catalog/linear.svg?raw';
import composioMark from '../../../server/catalog/composio.svg?raw';
import t3Mark from '../../../server/catalog/t3.svg?raw';
import elevenlabsMark from '../../../shared/voice/elevenlabs.svg?raw';
import deepgramMark from '../../../shared/voice/deepgram.svg?raw';
import openaiMark from '../../../shared/voice/openai.svg?raw';
import groqMark from '../../../shared/voice/groq.svg?raw';
import fishAudioMark from '../../../shared/voice/fish-audio.svg?raw';
import nvidiaMark from '../../../shared/voice/nvidia.svg?raw';

// The Brains page as the app draws it (desktop/src/app.rs, programs_page): one column, Your brains
// with a row for each brain, its tile, name, version and settings, and Claude Agent open in place
// under its row (program_open_rows); then the ACP Registry's programs as cards, two across, with the
// registry's own names, versions, descriptions and icons. When the panel comes into view, the first
// card installs and joins the brains, and the next card in the registry takes its place.
const MINE = ['claude-acp', 'codex-acp'];
const CARDS = ['opencode', 'gemini', 'github-copilot-cli', 'goose', 'cursor'];
const listed = await brains([...MINE, ...CARDS]);
const mine = listed.filter((b) => MINE.includes(b.id)).map((b) => ({ ...b, settings: b.id === 'claude-acp' ? '1 setting' : 'No settings' }));
const cards = listed.filter((b) => CARDS.includes(b.id));
const claude = mine.find((b) => b.id === 'claude-acp');
const closed = mine.filter((b) => b !== claude);
// Claude Agent's plan (app.rs, program_plan): who it's signed in as and the plan's limits as bars,
// orange from 75% and red from 90% (desktop/src/meter.rs, Level::of).
const LIMITS = [
	{ name: 'Session', used: 42, resets: '15:30' },
	{ name: 'This week', used: 78, resets: 'Mon' },
];
const level = (used: number) => ({ warn: used >= 75 && used < 90, bad: used >= 90 });
type Limit = { label: string; used: number; resets: string };
// The usage pool it draws from (app.rs, program_pool; server/pools.calx): the whole pool's windows,
// then each account with how it stands, in its state's colour, and the windows it reports, which
// differ between accounts.
const POOL: { total: Limit[]; accounts: { name: string; state: string; ink?: 'warn' | 'bad'; limits: Limit[] }[] } = {
	total: [
		{ label: '5 hours', used: 61, resets: '16:12' },
		{ label: 'Week', used: 47, resets: 'Mon' },
	],
	accounts: [
		{
			name: 'you@example.com',
			state: 'Ready',
			limits: [
				{ label: '5 hours', used: 22, resets: '17:40' },
				{ label: 'Week', used: 41, resets: 'Mon' },
			],
		},
		{
			name: 'work@example.com',
			state: 'Over its quota · 42 min',
			ink: 'bad',
			limits: [
				{ label: '5 hours', used: 100, resets: '16:12' },
				{ label: 'Week', used: 64, resets: 'Tue' },
			],
		},
		{
			name: 'team@example.com',
			state: 'Cooling down · 1 min',
			ink: 'warn',
			limits: [
				{ label: 'Week', used: 30, resets: 'Thu' },
				{ label: 'Week · Fable', used: 81, resets: 'Thu' },
			],
		},
		{ name: 'old@example.com', state: 'Signed out at the pool', ink: 'warn', limits: [] },
	],
};
const ready = POOL.accounts.filter((a) => a.state === 'Ready').length;

// The Rules page as the app draws it (desktop/src/rules.rs), each rule in the server's own words
// (server/rules.calx, said).
const rules = [
	{ said: 'Ask before commands like git push *', then: 'Asks you' },
	{ said: 'Deny the path ~/.ssh/**', then: 'Denies' },
	{ said: 'Allow the site github.com', then: 'Allows' },
];
const ON = ['Command', 'Path', 'Site', 'Tool'];
const STARTERS = ['You', 'An agent', 'Routine', 'Webhook', 'Script'];

// Each server's yarn is drawn from its name, as the app draws it.
const servers = ['This computer', 'loom.example.com', 'loom.acme.dev'];

// Spools' Find tab as the app draws it (desktop/src/spools.rs): Acta and T3 Code as wide cards in
// black and white, each with loom's knot tied to its own logo on a tile in ink, the category pills,
// and the rest as tiles four to a row, in the catalog's own words, each with its mark in black and
// white (server/catalog.calx, server/catalog/): outlined with its logo in ink until it's connected,
// then the whole tile in ink with its logo and name in the ink on it (spools.rs, spool_tile).
// Composio is connected. When the panel comes into view, T3 Code connects: its tie pulls taut and
// Installed counts it.
const featured = [
	{ id: 'acta', name: 'Acta', text: 'Boards, tasks and comments in Acta.', mark: actaMark, connected: true },
	{ id: 't3', name: 'T3 Code', text: 'Projects and coding threads in T3 Code.', mark: t3Mark, connected: false },
];
const PILLS = ['All', 'Work', 'Code', 'Mail & calendar', 'Files', 'Home', 'Fun'];
const tiles = [
	{ name: 'GitHub', mark: githubMark, connected: false },
	{ name: 'Notion', mark: notionMark, connected: false },
	{ name: 'Linear', mark: linearMark, connected: false },
	{ name: 'Composio', mark: composioMark, connected: true },
];

// Settings › Voice as the app draws it (PLAN.md, "Voice"): Dictation and Speech beside the title,
// as Spools has Find and Installed, each its engines as tiles in black and white, an ink tile with
// its maker's logo in its ink (shared/voice/, as the app draws it), its name, one quiet line and
// Use, Add key or Change key; the one in use outlined in ink with a check in a ring and In use; then
// its rows. Deepgram Nova-3 dictates and OpenAI speaks, with Marin at 1×, and replies aren't read
// aloud. The models on the device have Download, then a thin bar with its percent and Cancel while
// it downloads, then Delete and Use (voice_ui.rs, tile_state); Kokoro, whose authors have no logo,
// has Lucide's laptop. Parakeet is downloading, and carries on when the panel comes into view.
const LAPTOP =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z"></path><path d="M20.054 15.987H3.946"></path></svg>';
type Engine = { id: string; name: string; line: string; mark: string; key: boolean; on: boolean; model?: 'absent' | 'ready' | number };
const VOICE: { id: string; name: string; engines: Engine[] }[] = [
	{
		id: 'dictation',
		name: 'Dictation',
		engines: [
			{ id: 'elevenlabs-scribe', name: 'ElevenLabs Scribe', line: 'Words as you say them', mark: elevenlabsMark, key: false, on: false },
			{ id: 'deepgram', name: 'Deepgram Nova-3', line: 'Words as you say them', mark: deepgramMark, key: true, on: true },
			{ id: 'openai-transcribe', name: 'OpenAI', line: 'gpt-4o-transcribe, words as you say them', mark: openaiMark, key: false, on: false },
			{ id: 'groq', name: 'Groq', line: 'Whisper large v3, writes once you stop', mark: groqMark, key: false, on: false },
			{ id: 'parakeet', name: 'Parakeet v2', line: 'English, 660 MB', mark: nvidiaMark, key: true, on: false, model: 62 },
			{ id: 'whisper', name: 'Whisper large v3 turbo', line: '99 languages, 1 GB', mark: openaiMark, key: true, on: false, model: 'absent' },
		],
	},
	{
		id: 'speech',
		name: 'Speech',
		engines: [
			{ id: 'elevenlabs', name: 'ElevenLabs', line: "Flash v2.5, your voices and the library's", mark: elevenlabsMark, key: false, on: false },
			{ id: 'fish', name: 'Fish Audio', line: 'S2.1 Pro, the voice library', mark: fishAudioMark, key: false, on: false },
			{ id: 'openai-tts', name: 'OpenAI', line: 'gpt-4o-mini-tts, 13 voices', mark: openaiMark, key: true, on: true },
			{ id: 'kokoro', name: 'Kokoro', line: 'English and Chinese, 350 MB', mark: LAPTOP, key: true, on: false, model: 'absent' },
		],
	},
];
const MODEL_BUTTON = { absent: 'Download', downloading: 'Cancel', ready: 'Delete' };
const modelState = (e: Engine) => (typeof e.model === 'number' ? 'downloading' : (e.model ?? 'absent'));
const engineButton = (e: Engine) => (e.on ? 'Change key' : e.key ? 'Use' : 'Add key');
const LANGUAGES = ['Detect', 'English', 'Norwegian', 'Swedish', 'Danish', 'Finnish', 'German', 'Dutch', 'French', 'Spanish', 'Italian', 'Portuguese', 'Polish', 'Ukrainian', 'Turkish', 'Hindi', 'Japanese', 'Korean', 'Chinese', 'Arabic'];
const VOICES = ['Alloy', 'Ash', 'Ballad', 'Cedar', 'Coral', 'Echo', 'Fable', 'Marin', 'Nova', 'Onyx', 'Sage', 'Shimmer', 'Verse'];
const SHORTCUTS = ['Ctrl+Shift+Space', 'Off'];
const SPEEDS = ['0.8×', '0.9×', '1×', '1.1×', '1.2×'];
const READ_ALOUD = ['Never', 'Only in live', 'Always'];
// Lucide's icons: check, chevron-down, play, eye and eye-off.
const CHECK = 'M20 6 9 17l-5-5';
const CHEVRON = 'm6 9 6 6 6-6';
const EYE =
	'<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle>';
const EYE_OFF =
	'<path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path>';

// Each with an agent's thread, which works while the item is hovered.
const more = [
	{ title: 'Routines and webhooks', color: 'periwinkle', mood: 'thinking', text: 'An agent works on a schedule, or when a webhook comes in, out of the chat, and posts there only when it has something to say.' },
	{ title: 'Tasks', color: 'mint', mood: 'tool', text: 'Long jobs run beside the chat, carry on after a restart, and can be paused, resumed or retried.' },
	{ title: 'A browser of its own', color: 'apricot', mood: 'writing', text: 'Watch an agent browse, take over for a login, and hand it back. Secrets go in without the agent seeing them.' },
	{ title: 'Notes, skills and tables', color: 'pink', mood: 'thinking', text: 'Agents remember, keep skills, and share tables. Do a task once in its browser and the agent writes it up as a skill.' },
	{ title: 'A backup brain', color: 'gold', mood: 'tool', text: 'When an agent’s program runs out of usage, another one takes the chat over, and the reply says so.' },
	{ title: 'Plugins', color: 'lavender', mood: 'writing', text: 'Panels and tools that agents write themselves, walled off from the network and from the rest of loom.' },
];

// What people ask about loom, answered on the page and given to search engines as an FAQ. Each
// answer is plain text with its links marked [like this](url) and its commands `like this`.
const questions = [
	{
		q: 'Is loom free?',
		a: 'Yes. loom is free and open source, under the MIT license. The agent programs it runs use your own account or API key with their provider, such as Anthropic or OpenAI.',
	},
	{
		q: 'Do I need a server?',
		a: 'No. The desktop app can run everything on your computer. On a Linux server, your agents keep working while your computer is off, and you can invite people, each with agents of their own in a sandbox.',
	},
	{
		q: 'How do I put it on a server?',
		a: 'As root on a Linux server, run `curl -fsSL https://loom.rip/install.sh | sudo sh`. It installs loom as a service, served over HTTPS by Caddy when you give it a domain, or on your tailnet with Tailscale. It runs in Docker too.',
	},
	{
		q: 'Which AI agents does it work with?',
		a: 'Any agent program in the ACP Registry, such as Claude Agent, Codex, Gemini CLI, OpenCode, goose, GitHub Copilot and Cursor, or any other program that speaks the Agent Client Protocol. loom installs them for you.',
	},
	{
		q: 'Where are my chats and files kept?',
		a: "On your computer or your server, in one folder: loom's database, your files, and the key that seals your secrets. A whole instance moves from one machine to another.",
	},
	{
		q: 'Who makes loom?',
		a: '[Aaen Studios](https://aaenz.no/), which also makes [Calx](https://calxlang.com), the language loom’s server and the app’s core are written in. The source is [on GitHub](https://github.com/aaen-studios/loom).',
	},
];
const plain = (s: string) => s.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/`([^`]+)`/g, '$1');
const linked = (s: string) =>
	s
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
		.replace(/`([^`]+)`/g, '<code>$1</code>');
const faq = {
	'@type': 'FAQPage',
	mainEntity: questions.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: plain(a) } })),
};
---

<Base
	description="loom, by Aaen Studios, is a self-hostable agent app: chat with your own AI agents on Claude, Codex or any ACP agent program, on your server or your computer. Open source."
	data={faq}
>
	<section class="hero">
		<div class="wrap">
			<div class="mark">
				<h1>
					<span class="wordmark">
						<canvas class="weave" aria-hidden="true"></canvas>
						<Knot size={64} class="hero-knot" />
						<span class="word">loom<span class="base"></span></span>
					</span>
					<span class="kind">A self-hostable agent app.</span>
				</h1>
			</div>
			<Get />
		</div>
		<div class="wrap demo-wrap">
			<AppDemo />
		</div>
	</section>

	<section class="feature" aria-labelledby="f-programs">
		<div class="wrap split">
			<div class="copy" data-reveal>
				<h2 id="f-programs">Every agent runs on an agent program</h2>
				<p>
					Claude Agent, Codex, OpenCode, goose, Gemini CLI, or any other program that speaks the Agent Client Protocol. loom installs them from the ACP Registry, and gives each agent a name, a colour, its instructions and a folder to work in. A brain can draw from a usage pool of several accounts, and its page shows how each one stands.
				</p>
			</div>
			<div class="visual" data-reveal>
				<div class="page brains" aria-label="The Brains page in loom's settings">
					<div class="page-head"><span class="page-title">Brains</span></div>
					<div class="group">
						<div class="group-label">Your brains</div>
						<div class="box mine">
							{
								claude && (
									<div class="row brain-row" data-program role="button" tabindex="0" aria-expanded="true">
										<span class="tile" style={`--icon: url(${claude.icon})`} />
										<span class="row-text">
											<span class="row-title">{claude.name}</span>
											<span class="row-sub">{`Version ${claude.version} · ${claude.settings}`}</span>
										</span>
										<svg class="i chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
									</div>
								)
							}
							{
								claude && (
									<div class="open-rows" data-open-rows>
										<div class="field-row inset">
											<span class="field-name">Signed in</span>
											<span class="plan-name">Claude Max</span>
										</div>
										{LIMITS.map((l) => (
											<div class:list={['field-row', 'limit', 'inset', level(l.used)]}>
												<span class="field-name">{l.name}</span>
												<span class="limit-bar">
													<span style={`width: ${l.used}%`} />
												</span>
												<span class="limit-words">{`${l.used}% · ${l.resets}`}</span>
											</div>
										))}
										<div class="row inset">
											<span class="row-text">
												<span class="row-title">Usage pool · CLIProxyAPI</span>
												<span class="row-sub">Read just now</span>
											</span>
											<span class="btn-small">Unlink</span>
										</div>
										{[{ name: 'All accounts', state: `${ready} of ${POOL.accounts.length} ready`, ink: 'total', limits: POOL.total, whole: true }, ...POOL.accounts].map((a) => (
											<div class="pool-line inset">
												<div class="pool-head">
													<span class:list={['pool-name', { account: !('whole' in a) }]}>{a.name}</span>
													<span class:list={['pool-state', a.ink]}>{a.state}</span>
												</div>
												{a.limits.map((l) => (
													<div class:list={['pool-limit', 'limit', level(l.used)]}>
														<span class="pool-label">{l.label}</span>
														<span class="limit-bar">
															<span style={`width: ${l.used}%`} />
														</span>
														<span class="limit-words">{`${l.used}% · ${l.resets}`}</span>
													</div>
												))}
											</div>
										))}
										<div class="row inset">
											<span class="row-text">
												<span class="row-title">CLAUDE_CODE_OAUTH_TOKEN</span>
												<span class="row-sub">••••••••</span>
											</span>
											<span class="btn-small">Remove</span>
										</div>
										<div class="add-setting inset">
											<span class="input"><span class="placeholder">ANTHROPIC_API_KEY</span></span>
											<span class="input"><span class="placeholder">Its value</span></span>
											<span class="btn-small">Add setting</span>
										</div>
										<div class="wrap-row inset">
											<span class="row-title">Share it</span>
											<span class="share">
												<span class="input"><span class="placeholder">Tokens</span></span>
												<span class="segments"><span class="segment on">a day</span><span class="segment">a month</span></span>
												<span class="btn-small">Share</span>
											</span>
										</div>
										<div class="brain-actions"><span class="btn-small danger">Remove</span></div>
									</div>
								)
							}
							{
								closed.map((b) => (
									<div class="row brain-row" data-closed>
										<span class="tile" style={`--icon: url(${b.icon})`} />
										<span class="row-text">
											<span class="row-title">{b.name}</span>
											<span class="row-sub">{`Version ${b.version} · ${b.settings}`}</span>
										</span>
										<svg class="i chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
									</div>
								))
							}
						</div>
					</div>
					<div class="group">
						<div class="registry-label">ACP Registry</div>
						<div class="cards">
							{
								cards.map((b, i) => (
									<div class="card" data-brain={b.id} data-name={b.name} data-version={b.version} data-icon={b.icon} hidden={i >= 4}>
										<div class="card-top">
											<span class="tile big" style={`--icon: url(${b.icon})`} />
											<span class="btn-small">Install</span>
										</div>
										<span class="card-text">
											<span class="row-title">{b.name}</span>
											<span class="card-sub">{b.description}</span>
										</span>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="feature" aria-labelledby="f-asks">
		<div class="wrap split flip">
			<div class="copy" data-reveal>
				<h2 id="f-asks">It asks before anything that matters</h2>
				<p>
					Each agent asks about everything, about what's risky, or nothing, as you choose. Rules allow, ask or deny by site, file, command or tool, and every action is recorded before it happens.
				</p>
			</div>
			<div class="visual" data-reveal>
				<div class="page rules" aria-label="The Rules page in loom's settings">
					<div class="page-head">
						<span class="page-title">Rules</span>
						<span class="btn-small">New rule</span>
					</div>
					<div class="group">
						<div class="group-label">Every agent</div>
						<div class="box">
							{
								rules.map((r) => (
									<div class="row">
										<span class="row-text">
											<span class="row-title">{r.said}</span>
											<span class="row-sub">{r.then}</span>
										</span>
										<span class="btn-small">Remove</span>
									</div>
								))
							}
						</div>
					</div>
					<div class="group what-if">
						<div class="group-label">What if</div>
						<div class="box">
							<div class="row">
								<span class="row-text"><span class="row-title">On</span></span>
								<span class="segments" data-on>{ON.map((o, i) => <span class:list={['segment', { on: i === 0 }]}>{o}</span>)}</span>
							</div>
							<div class="row field">
								<span class="field-label" data-label>Command</span>
								<span class="input" data-input><span class="typed"></span><span class="caret"></span></span>
							</div>
							<div class="row">
								<span class="row-text"><span class="row-title">Started by</span></span>
								<span class="segments" data-by>{STARTERS.map((s, i) => <span class:list={['segment', { on: i === 0 }]}>{s}</span>)}</span>
							</div>
							<div class="row result">
								<span class="row-text">
									<span class="row-title" data-verdict>What would it get?</span>
									<span class="row-sub" data-why></span>
								</span>
								<span class="btn-small primary" data-check>Check</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="feature" aria-labelledby="f-where">
		<div class="wrap split">
			<div class="copy" data-reveal>
				<h2 id="f-where">On your computer, or on a server</h2>
				<p>
					The desktop app can run everything itself, with no server. Or put loom on a Linux server with one command, invite people, and each person's agents run in a sandbox of their own. One app signs in to as many servers as you like, and a whole instance moves between machines.
				</p>
			</div>
			<div class="visual" data-reveal>
				<div class="panel servers">
					{
						servers.map((s) => (
							<div class="server-row">
								<svg data-yarn={s} width="32" height="32" aria-hidden="true" />
								<span class="server-text">
									<b>{s}</b>
									<small>Connected</small>
								</span>
							</div>
						))
					}
				</div>
