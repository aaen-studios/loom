---
// Every page's frame: the head (title, description, link previews, icons, structured data), the
// header and the footer. The theme follows the system's unless the footer's switch picked one.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Nudge from '../components/Nudge.astro';
import { GITHUB, LATEST, ORIGIN, STUDIO } from '../lib/site.mjs';
import { latest } from '../lib/releases.mjs';
// The UI font's Latin file, fetched before the CSS asks for it, so the wordmark is drawn in it at once.
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
	/** The page's own title; the home page has none, and is just "loom". */
	title?: string;
	description: string;
	/** Where this page sits under the home page, for search results: its name in the trail. */
	crumb?: string;
	/** Kept out of search engines, as the 404 page is. */
	hidden?: boolean;
	/** Extra structured data for this page. */
	data?: object;
}
const { title, description, crumb, hidden, data } = Astro.props;
const full = title ? `${title} | loom` : 'loom';
const canonical = new URL(Astro.url.pathname, ORIGIN).href;
const image = new URL('/og.png', ORIGIN).href;
const release = await latest();

const graph = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Organization', '@id': `${STUDIO.url}#organization`, name: STUDIO.name, url: STUDIO.url, sameAs: ['https://github.com/aaen-studios'] },
		{
			'@type': 'WebSite',
			'@id': `${ORIGIN}/#website`,
			name: 'loom',
			url: `${ORIGIN}/`,
			inLanguage: 'en',
			publisher: { '@id': `${STUDIO.url}#organization` },
		},
		{
			'@type': 'SoftwareApplication',
			'@id': `${ORIGIN}/#app`,
			name: 'loom',
			description: 'A self-hostable agent app: chat with your own AI agents, running on Claude, Codex or any program that speaks the Agent Client Protocol, on your server or on your PC.',
			url: `${ORIGIN}/`,
			image,
			screenshot: image,
			applicationCategory: 'DeveloperApplication',
			applicationSubCategory: 'AI agents',
			operatingSystem: 'Windows, Linux, macOS',
			...(release
				? {
						softwareVersion: release.version,
						datePublished: release.date,
						releaseNotes: `${ORIGIN}/changelog/#${release.tag}`,
						downloadUrl: [`${LATEST}/loom-setup.exe`, `${ORIGIN}/download/`],
					}
				: {}),
			featureList: [
				'Agents on Claude, Codex, OpenCode, Gemini CLI, goose or any ACP agent program',
				'Approvals and rules for what agents may do',
				'Runs on your PC, on a Linux server, or in Docker',
				'Routines, webhooks and long tasks',
				'A browser of its own for each agent',
				'Plugins that agents write themselves',
			],
			license: 'https://opensource.org/licenses/MIT',
			isAccessibleForFree: true,
			codeRepository: GITHUB,
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
			author: { '@id': `${STUDIO.url}#organization` },
			publisher: { '@id': `${STUDIO.url}#organization` },
		},
		...(crumb
			? [
					{
						'@type': 'BreadcrumbList',
						itemListElement: [
							{ '@type': 'ListItem', position: 1, name: 'loom', item: `${ORIGIN}/` },
							{ '@type': 'ListItem', position: 2, name: crumb, item: canonical },
						],
					},
				]
			: []),
		...(data ? [data] : []),
	],
};
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{full}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={hidden ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
		{!hidden && <link rel="canonical" href={canonical} />}
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
		<link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/atom+xml" title="loom releases" href="/changelog.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="loom" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={full} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="loom's knot and wordmark" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={full} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content="loom's knot and wordmark" />

		<script type="application/ld+json" set:html={JSON.stringify(graph)} />

		<!-- Light is loom's main look. The footer's switch can pick dark, or the system's; that's
		     set before the page paints, so it never flashes. -->
		<script is:inline>
			document.documentElement.classList.add('js');
			try {
				const t = localStorage.getItem('theme');
				if (t === 'dark') document.documentElement.dataset.theme = 'dark';
				else if (t === 'system') delete document.documentElement.dataset.theme;
			} catch {}
		</script>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<Nudge />
		<script>
			// Each [data-reveal] rises into place the first time it's on screen, and says so with a
			// "shown" event, which the home page's panels start their little scenes on.
			const seen = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue;
						e.target.classList.add('shown');
						e.target.dispatchEvent(new CustomEvent('shown'));
						seen.unobserve(e.target);
					}
				},
				{ rootMargin: '0px 0px -12% 0px' },
			);
			for (const el of document.querySelectorAll('[data-reveal]')) seen.observe(el);
		</script>
	</body>
</html>
