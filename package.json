{
  "name": "loom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:selectors": "node scripts/audit-selectors.mjs --self-test && node scripts/audit-selectors.mjs",
    "check": "bun run typecheck && node scripts/check-encoding.mjs && node scripts/audit-selectors.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/make-icons.mjs && bun run tauri icon src-tauri/icons/icon-1024.png && node scripts/sync-setup-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@streamdown/code": "^1.1.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "streamdown": "^2.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
