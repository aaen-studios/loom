module server.acp

// The ACP side of the instance: each agent program runs as a child process,
// which a thread of its own writes to and reads from, so the instance's loop
// never waits on an agent. What the agent writes comes to the loop as Lines,
// and what the loop sends goes to the thread as Outs.
//
// ACP is JSON-RPC 2.0 with one message a line (https://agentclientprotocol.com).
import std.bytes
import std.fs
import std.json.{Json, parse}
import std.net.{Waker as LoopWaker}
import std.process.{Child, Command, Stdio, Waker}
import std.thread.{Task}
import shared.obj.{Obj, at, str_at}
import shared.tools

// A line an agent program wrote, or its end.
pub struct Line {
    pub agent: String
    pub text: String?
    pub exit: i32?    // set once, when the program has ended
}

// An image sent to an agent, which its thread reads and puts in base64 as the
// prompt goes out, rather than the instance's loop, which answers no one
// meanwhile: ~26 ms for a 5 MB picture.
pub struct Image {
    pub at: usize       // its place in the prompt
    pub path: String    // the file
    pub mime: String
    pub instead: Json   // what goes in its place if it can't be read: a link to the file
}

// What the loop asks of an agent's thread.
pub enum Out {
    Send(String)
    Prompt(i64, String, List<Json>, List<Image>)    // session/prompt: its id, the session, the prompt's blocks, and the images to read into them
    Stop
}

// The end the loop sends to an agent's thread with: each send wakes the
// thread's read of the program, so it goes out at once.
pub struct To {
    out: Sender<Out>
    waker: Waker
}

impl To {
    pub fn send(self: mut To, o: own Out) {
        self.out.send(o)
        self.waker.wake()
    }
}

struct Worker {
    agent: String
    child: Child
    outbox: Receiver<Out>
    lines: Sender<Line>
    wake: LoopWaker    // the loop's, woken after each line
    stopped: Sender<String>    // told once a program the loop stopped has ended, with what it started
}

impl Task for Worker {
    fn run(own self) {
        var w = self
        loop {
            // Write what's waiting first, so a prompt goes out at once.
            while let out = w.outbox.next() {
                match out {
                    Out.Send(text) => {
                        match w.child.write_text("{text}\n") {
                            ok => {},
                            err(e) => eprintln("loom: can't write to agent {w.agent}: {e}"),
                        }
                    },
                    Out.Prompt(id, session, blocks, images) => {
                        match w.child.write_text("{prompt(id, session, blocks, images)}\n") {
                            ok => {},
                            err(e) => eprintln("loom: can't write to agent {w.agent}: {e}"),
                        }
                    },
                    Out.Stop => {
                        // The loop has let go of this program already, and
                        // may have started the agent again: nothing more
                        // comes from this one. What it started goes too: npx's
                        // node, Claude Code, its loom mcp and their Deno.
                        w.child.kill_tree()
                        _ = w.child.wait()
                        w.stopped.send(w.agent.copy())
                        w.wake.wake()
                        return
                    },
                }
            }
            // The loop's sends wake this read, so it can wait long.
            if let line = w.child.read_line(1000) {
                w.lines.send(Line { agent: w.agent.copy(), text: some(line), exit: none })
                w.wake.wake()
                continue
            }
            if w.child.ended() {
                // Nothing it started outlives it.
                w.child.kill_tree()
                let out = w.child.wait()
                w.lines.send(Line { agent: w.agent.copy(), text: none, exit: some(out.status.code ?? -1) })
                w.wake.wake()
                return
            }
        }
    }
}

// Starts an agent program in `dir`, and gives the end that sends to it.
// Everything it writes comes to `lines`, tagged with `agent`. `env` is a JSON
// object of the environment variables it gets on top of the instance's. It
// runs in a group of its own, so stopping it stops what it started too, and
// `stopped` hears once a stop has ended them.
pub fn start(agent: String, command: String, args: List<String>, env: Json, dir: String, lines: Sender<Line>, wake: LoopWaker, stopped: Sender<String>) -> To ! Error {
    var c = Command.new(command).args(args).dir(dir).stdin(Stdio.Pipe).stdout(Stdio.Pipe).own_group()
    if let Json.Object(vars) = env {
        for (k, v) in vars {
            if let value = v.as_str() { c = c.env(k.copy(), value) }
        }
    }
    let child = try c.spawn()
    let outbox = Receiver<Out>()
    let to = To { out: outbox.sender(), waker: child.waker() }
    _ = unsafe { Thread.spawn(Worker { agent: agent.copy(), child: child, outbox: outbox, lines: lines.copy(), wake: wake, stopped: stopped.copy() }) }
    return to
}

pub fn request(id: i64, method: str, params: Json) -> String {
    return "{Obj.new().s("jsonrpc", String("2.0")).i("id", id).s("method", String(method)).j("params", params).done()}"
}

// session/prompt with `id` for `session`: `blocks`, with each of `images` read
// into its place, in base64, or what's instead if it can't be.
pub fn prompt(id: i64, session: String, blocks: own List<Json>, images: List<Image>) -> String {
    var all = blocks
    for image in images {
        if image.at >= all.len() { continue }
        all[image.at] = match fs.read(image.path.copy()) {
            ok(data) => Obj.new().s("type", String("image")).s("mimeType", image.mime.copy()).s("data", bytes.base64(data)).done(),
            err(e) => {
                eprintln("loom: reading {image.path} for an agent: {e}")
                image.instead.copy()
            },
        }
    }
    return request(id, "session/prompt", Obj.new().s("sessionId", session).j("prompt", Json.Array(all)).done())
}

pub fn notify(method: str, params: Json) -> String {
    return "{Obj.new().s("jsonrpc", String("2.0")).s("method", String(method)).j("params", params).done()}"
}

pub fn respond(id: Json, result: Json) -> String {
    return "{Obj.new().s("jsonrpc", String("2.0")).j("id", id).j("result", result).done()}"
}

pub fn respond_error(id: Json, code: i64, message: String) -> String {
    let e = Obj.new().i("code", code).s("message", message).done()
    return "{Obj.new().s("jsonrpc", String("2.0")).j("id", id).j("error", e).done()}"
}

// What loom tells an agent about itself when it starts one.
pub fn initialize_params() -> Json {
    let files = Obj.new().b("readTextFile", false).b("writeTextFile", false).done()
    let caps = Obj.new().j("fs", files).b("terminal", false).done()
    let info = Obj.new().s("name", String("loom")).s("version", String("0.2.0-dev")).done()
    return Obj.new().i("protocolVersion", 1).j("clientCapabilities", caps).j("clientInfo", info).done()
}

// --- Code Mode's tools, which the agent program doesn't ask about ---
//
// Loom asks for each call in a script, by the agent's permission mode, and
// before a script in `ask` (PLAN.md, "Permissions"), so an agent program
// asking before search_tools or run_code would ask twice. Codex reads their
// MCP annotations (shared/tools.calx). Claude's adapter takes allowedTools
// in session/new's _meta, as Claude Code names MCP tools: mcp__loom__run_code.
// OpenCode takes a permission rule for each, named loom_run_code, in the
// config in OPENCODE_CONFIG_CONTENT. Each program leaves the others' alone.

// session/new's, session/load's and session/resume's _meta.
pub fn session_meta() -> Json {
    var allowed = List<Json>()
    for t in tools.CODE_TOOLS.split(" ") {
        allowed.push(Json.Str("mcp__loom__{t}"))
    }
    let options = Obj.new().j("allowedTools", Json.Array(allowed)).done()
    return Obj.new().j("claudeCode", Obj.new().j("options", options).done()).done()
}

const OPENCODE_CONFIG: str = "OPENCODE_CONFIG_CONTENT"

// An agent program's environment (a JSON object), with OpenCode's config
// allowing Code Mode's tools: added to the config the settings give, where
// they give one, which keeps any rule of its own for them.
pub fn program_env(env: Json) -> Json {
    var vars = LinkedMap<String, Json>()
    if let Json.Object(m) = env { vars = m.copy() }
    var config = LinkedMap<String, Json>()
    if let given = str_at(Json.Object(vars.copy()), OPENCODE_CONFIG) {
        match parse(given) {
            ok(Json.Object(m)) => config = m.copy(),
            _ => return Json.Object(vars),    // not one loom can add to: as it is
        }
    }
    var rules = LinkedMap<String, Json>()
    match at(Json.Object(config.copy()), "permission") {
        Json.Object(m) => rules = m.copy(),
        Json.Str(all) => rules.insert(String("*"), Json.Str(all.copy())),
        _ => {},
    }
    for t in tools.CODE_TOOLS.split(" ") {
        let name = "loom_{t}"
        if not rules.contains(name.copy()) { rules.insert(name, Json.Str(String("allow"))) }
    }
    config.insert(String("permission"), Json.Object(rules))
    vars.insert(String(OPENCODE_CONFIG), Json.Str("{Json.Object(config)}"))
    return Json.Object(vars)
}

@test
fn code_tools_are_allowed_in_each_program() {
    let meta = "{session_meta()}"
    assert(meta == #"{"claudeCode":{"options":{"allowedTools":["mcp__loom__search_tools","mcp__loom__run_code"]}}}"#)
    let fresh = program_env(Obj.new().s("KEY", String("k")).done())
    assert(str_at(fresh.copy(), "KEY") == some(String("k")))
    assert(str_at(fresh, OPENCODE_CONFIG) == some(String(#"{"permission":{"loom_search_tools":"allow","loom_run_code":"allow"}}"#)))
    // The person's own config keeps its rules, its own for run_code among them,
    // and a rule for everything stays first, as OpenCode's last match wins.
    let theirs = program_env(Obj.new().s(OPENCODE_CONFIG, String(#"{"model":"m","permission":{"loom_run_code":"ask"}}"#)).done())
    assert(str_at(theirs, OPENCODE_CONFIG) == some(String(#"{"model":"m","permission":{"loom_run_code":"ask","loom_search_tools":"allow"}}"#)))
    let all = program_env(Obj.new().s(OPENCODE_CONFIG, String(#"{"permission":"ask"}"#)).done())
    assert(str_at(all, OPENCODE_CONFIG) == some(String(#"{"permission":{"*":"ask","loom_search_tools":"allow","loom_run_code":"allow"}}"#)))
    let broken = program_env(Obj.new().s(OPENCODE_CONFIG, String("not json")).done())
    assert(str_at(broken, OPENCODE_CONFIG) == some(String("not json")))
}

// Whether a permission mode asks before a script runs: only `ask`, which asks
// about everything. In any other, each call in the script is put to the mode.
pub fn asks_before_scripts(mode: String) -> bool {
    return mode == "ask"
}

// A run's end, from session/prompt's stopReason, as loom's run.finished
// status names it.
pub fn status_of(stop_reason: String) -> String {
    if stop_reason == "end_turn" { return String("done") }
    if stop_reason == "cancelled" { return String("cancelled") }
    if stop_reason == "max_tokens" or stop_reason == "max_turn_requests" { return String("limit") }
    if stop_reason == "refusal" { return String("failed") }
    return String("done")
}

// ACP's tool kinds are loom's, apart from ones it doesn't know.
pub fn tool_kind(kind: String) -> String {
    for k in "read edit delete move search execute think fetch".split(" ") {
        if kind == k { return kind.copy() }
    }
    return String("other")
}

// The most bytes of a tool call's title the apps are given, before "…".
const TITLE_MOST: usize = 100

// A tool call's title as the apps show it: a few words on one line. Claude's
// adapter titles a shell call with the command itself, heredoc and all, and
// gives the few words Claude wrote for it as rawInput's `description`, so
// those come first. Then the title's first line (without the backticks an
// older adapter put round a command), and with no title, what kind of call it
// is and the file it touches. The command stays in the call's `input`.
pub fn tool_title(call: Json) -> String {
    if let said = str_at(at(call.copy(), "rawInput"), "description") {
        let line = first_line(said)
        if line.len() > 0 { return line }
    }
    let title = first_line(str_at(call.copy(), "title") ?? String())
    if title.len() > 0 { return title }
    let file = first_file(at(call.copy(), "locations"))
    let kind = tool_kind(str_at(call, "kind") ?? String())
    let what = if kind == "read" { "Read" } else if kind == "edit" { "Edit" } else if kind == "delete" { "Delete" } else if kind == "move" { "Move" } else { "" }
    if what.len() > 0 { return if file.len() > 0 { "{what} {file}" } else { "{what} a file" } }
    if kind == "execute" { return String("Run a command") }
    if kind == "search" { return String("Search") }
    if kind == "fetch" { return String("Fetch a page") }
    if kind == "think" { return String("Think") }
    return String("Use a tool")
}

// Whether a tool call update says anything of the title: a title, or a
// shell command's description.
pub fn names_tool(call: Json) -> bool {
    return str_at(call.copy(), "title") != none or str_at(at(call, "rawInput"), "description") != none
}

// The subagent call an update came from, as Claude's adapter tags a subagent's
// tool calls, words and permission requests: the toolCallId of the Task or
// Agent call that started it, in `_meta.claudeCode.parentToolUseId`. None for
// the agent's own.
pub fn parent_of(update: Json) -> String? {
    let id = str_at(at(at(update, "_meta"), "claudeCode"), "parentToolUseId") ?? String()
    return if id.len() > 0 { some(id) } else { none }
}

@test
fn a_subagents_update_names_the_call_that_started_it() {
    let meta = Obj.new().j("claudeCode", Obj.new().s("parentToolUseId", String("toolu_1")).done()).done()
    assert(parent_of(Obj.new().s("sessionUpdate", String("tool_call")).j("_meta", meta).done()) == some(String("toolu_1")))
    assert(parent_of(Obj.new().s("sessionUpdate", String("tool_call")).done()) == none)
    assert(parent_of(Obj.new().j("_meta", Obj.new().j("claudeCode", Obj.new().s("parentToolUseId", String()).done()).done()).done()) == none)
}

// The first line of `text` with words on it, trimmed, cut at TITLE_MOST bytes,
// with "…" when there's more after it.
fn first_line(text: String) -> String {
    var all = text.trim().copy()
    if all.len() > 1 and all.starts_with("`") and all.ends_with("`") and not all.starts_with("```") {
        all = all[1..all.len() - 1].trim().copy()
    }
    var line = String()
    var more = false
    for l in all.split("\n") {
        let t = l.trim()
        if t.len() == 0 { continue }
        if line.len() > 0 {
            more = true
            break
        }
        line = t.copy()
    }
    var out = String()
    for r in line.runes() {
        if out.len() >= TITLE_MOST {
            more = true
            break
        }
        out.push(r)
    }
    if more { out.push_str("…") }
    return out
}

// The name of the first file in a tool call's locations, or "".
fn first_file(locations: Json) -> String {
    if let Json.Array(list) = locations {
        for l in list {
            let path = (str_at(l, "path") ?? String()).replace("\\", "/")
            let name = match path.find_last("/") {
                some(i) => path[i + 1..].copy(),
                none => path.copy(),
            }
            if name.len() > 0 { return name }
        }
    }
    return String()
}

@test
fn a_tool_call_is_titled_in_a_few_words_on_one_line() {
    // Claude's Bash: the command as the title, its few words in rawInput.
    let heredoc = "M=/var/lib/loom/.claude/projects/x/memory; cat > $M/spoons.md <<'EOF'\n---\nname: spoons\n---\nEOF"
    let bash = Obj.new().s("title", String(heredoc)).s("kind", String("execute")).j("rawInput", Obj.new().s("command", String(heredoc)).s("description", String("Save a memory about spoons")).done()).done()
    assert(tool_title(bash) == "Save a memory about spoons")
    assert(names_tool(Obj.new().j("rawInput", Obj.new().s("description", String("x")).done()).done()))
    assert(not names_tool(Obj.new().s("status", String("completed")).done()))
    // Without one, the command's first line, marked as cut.
    let plain = Obj.new().s("title", String(heredoc)).s("kind", String("execute")).j("rawInput", Obj.new().s("command", String(heredoc)).done()).done()
    assert(tool_title(plain) == "M=/var/lib/loom/.claude/projects/x/memory; cat > $M/spoons.md <<'EOF'…")
    assert(not tool_title(plain).contains("\n"))
    // An older adapter's backticks go, a short title stays as it is.
    assert(tool_title(Obj.new().s("title", String("`ls -la`")).done()) == "ls -la")
    assert(tool_title(Obj.new().s("title", String("rm -rf build")).done()) == "rm -rf build")
    assert(tool_title(Obj.new().s("title", String("\n\n  Read notes.md  \n")).done()) == "Read notes.md")
    // A long line is cut.
    let long = tool_title(Obj.new().s("title", "x".repeat(300)).done())
    assert(long.len() == TITLE_MOST + "…".len() and long.ends_with("…"))
    // No title: its kind, and the file it touches.
    let edit = Obj.new().s("kind", String("edit")).j("locations", Json.Array([Obj.new().s("path", String("/home/e/food-log.csv")).done()])).done()
    assert(tool_title(edit) == "Edit food-log.csv")
    assert(tool_title(Obj.new().s("kind", String("execute")).done()) == "Run a command")
    assert(tool_title(Obj.new().s("title", String("  ")).done()) == "Use a tool")
}

// What the `auto` permission mode allows without asking: tools that only look.
pub const SAFE_KINDS: str = "read search think fetch"

// Whether an agent's permission mode answers a request for a tool of `kind`
// (one of tool_kind's) by itself. `ask` asks about everything, `allow` allows
// everything, `auto` allows the SAFE_KINDS, and a list like "read,search,edit"
// allows the kinds it names. Anything else asks.
pub fn allows(mode: String, kind: String) -> bool {
    if mode == "allow" { return true }
    if mode == "ask" or kind == "other" { return false }
    let kinds = if mode == "auto" { String(SAFE_KINDS).replace(" ", ",") } else { mode.copy() }
    for k in kinds.split(",") {
        if k.trim() == kind { return true }
    }
    return false
}

// The option of a permission request that matches the person's answer:
// allow_once, allow_always, reject_once or reject_always, falling back to any
// allow or reject. none if the agent offered nothing that fits.
pub fn pick_option(options: Json, allow: bool, always: bool) -> String? {
    let want = if allow { if always { "allow_always" } else { "allow_once" } } else { if always { "reject_always" } else { "reject_once" } }
    let prefix = if allow { "allow" } else { "reject" }
    var fallback: String? = none
    if let Json.Array(list) = options {
        for o in list {
            let kind = (o.get(String("kind")) ?? Json.Null).as_str() ?? String()
            let id = (o.get(String("optionId")) ?? Json.Null).as_str() ?? String()
            if kind == want { return some(id) }
            if fallback == none and kind.starts_with(prefix) { fallback = some(id) }
        }
    }
    return fallback
}

// --- Session config options: an agent's model, reasoning effort and the like ---

// A select option's values, from a flat list or from its groups.
fn values_of(option: Json) -> List<Json> {
    var out = List<Json>()
    if let Json.Array(list) = option.get(String("options")) ?? Json.Null {
        for o in list {
            if let Json.Array(grouped) = o.get(String("options")) ?? Json.Null {
                for g in grouped { out.push(g.copy()) }
            } else {
                out.push(o.copy())
            }
        }
    }
    return out
}

fn str_of(j: Json, key: str) -> String? {
    return (j.get(String(key)) ?? Json.Null).as_str()
}

// What a session's configOptions offer, as loom keeps it with the agent:
// each select option's `id`, `name`, `category`, `value` (what a new session
// starts on) and `options`, flat, each with `value`, `name` and maybe
// `description`. Options of other types are left out.
pub fn offered(config: Json) -> Json {
    var out = List<Json>()
    if let Json.Array(list) = config {
        for c in list {
            if (str_of(c.copy(), "type") ?? String("select")) != "select" { continue }
            var values = List<Json>()
            for v in values_of(c.copy()) {
                values.push(Obj.new().s("value", str_of(v.copy(), "value") ?? String()).s("name", str_of(v.copy(), "name") ?? String()).maybe("description", str_of(v, "description")).done())
            }
            out.push(Obj.new().s("id", str_of(c.copy(), "id") ?? String()).s("name", str_of(c.copy(), "name") ?? String()).s("category", str_of(c.copy(), "category") ?? String()).s("value", str_of(c, "currentValue") ?? String()).j("options", Json.Array(values)).done())
        }
    }
    return Json.Array(out)
}

// Whether option `id` of a session's configOptions offers `value`.
pub fn offers(config: Json, id: String, value: String) -> bool {
    if let Json.Array(list) = config {
        for c in list {
            if str_of(c.copy(), "id") != some(id.copy()) { continue }
            for v in values_of(c) {
                if str_of(v, "value") == some(value.copy()) { return true }
            }
        }
    }
    return false
}

// Option `id`'s value now, in a session's configOptions.
pub fn current(config: Json, id: String) -> String? {
    if let Json.Array(list) = config {
        for c in list {
            if str_of(c.copy(), "id") == some(id.copy()) { return str_of(c, "currentValue") }
        }
    }
    return none
}

// What to set in a session so it runs as the agent's `config` (option id ->
// value) says: each option the session offers that value for, and isn't on
// it yet, as (id, value). Values it doesn't offer are let be.
pub fn config_todo(config: Json, wanted: Json) -> List<(String, String)> {
    var out = List<(String, String)>()
    if let Json.Object(m) = wanted {
        for (id, v) in m {
            let value = v.as_str() else continue
            if offers(config.copy(), id.copy(), value.copy()) and current(config.copy(), id.copy()) != some(value.copy()) { out.push((id.copy(), value)) }
        }
    }
    return out
}

@test
fn config_options_are_set_to_what_the_agent_says() {
    let model = Obj.new().s("id", String("model")).s("name", String("Model")).s("category", String("model")).s("type", String("select")).s("currentValue", String("a")).j("options", Json.Array([Obj.new().s("value", String("a")).s("name", String("A")).done(), Obj.new().s("group", String("more")).s("name", String("More")).j("options", Json.Array([Obj.new().s("value", String("b")).s("name", String("B")).done()])).done()])).done()
    let config = Json.Array([model])
    assert(offers(config.copy(), String("model"), String("b")))
    assert(not offers(config.copy(), String("model"), String("c")))
    assert(current(config.copy(), String("model")) == some(String("a")))
    let todo = config_todo(config.copy(), Obj.new().s("model", String("b")).s("effort", String("high")).done())
    assert(todo.len() == 1)
    assert(todo[0].1 == "b")
    assert(config_todo(config.copy(), Obj.new().s("model", String("a")).done()).len() == 0)
    assert(config_todo(config.copy(), Obj.new().s("model", String("zzz")).done()).len() == 0)
    let shown = "{offered(config)}"
    assert(shown.contains(#""value":"b""#))
    assert(shown.contains(#""value":"a","options""#))
}

@test
fn stop_reasons_map_to_statuses() {
    assert(status_of(String("end_turn")) == "done")
    assert(status_of(String("max_tokens")) == "limit")
    assert(status_of(String("cancelled")) == "cancelled")
}

@test
fn permission_modes_allow_what_they_say() {
    assert(allows(String("allow"), String("execute")))
    assert(allows(String("allow"), String("other")))
    assert(not allows(String("ask"), String("read")))
    assert(allows(String("auto"), String("read")))
    assert(allows(String("auto"), String("fetch")))
    assert(not allows(String("auto"), String("execute")))
    assert(not allows(String("auto"), String("edit")))
    assert(not allows(String("auto"), String("other")))
    assert(allows(String("read, edit"), String("edit")))
    assert(not allows(String("read,edit"), String("delete")))
    assert(not allows(String("something new"), String("read")))
}

@test
fn picks_the_option_that_fits() {
    var list = List<Json>()
    for k in "allow_once reject_once".split(" ") {
        list.push(Obj.new().s("optionId", "id_{k}").s("kind", k.copy()).done())
    }
    let options = Json.Array(list)
    assert(pick_option(options.copy(), true, false) == some(String("id_allow_once")))
    assert(pick_option(options.copy(), true, true) == some(String("id_allow_once")))
    assert(pick_option(options.copy(), false, true) == some(String("id_reject_once")))
    assert(pick_option(Json.Array(List<Json>()), true, false) == none)
}

@test
fn a_prompts_images_are_read_into_it_on_the_agents_thread() {
    let dir = fs.temp_dir()!
    let png: List<u8> = [137, 80, 78, 71]
    fs.write("{dir}/pic", png.copy())!
    let blocks: List<Json> = [Obj.new().s("type", String("text")).s("text", String("look")).done(), Json.Null, Json.Null]
    let link = Obj.new().s("type", String("resource_link")).s("uri", String("file:///gone")).done()
    let images: List<Image> = [Image { at: 1, path: "{dir}/pic", mime: String("image/png"), instead: Json.Null }, Image { at: 2, path: "{dir}/gone", mime: String("image/png"), instead: link }]
    let text = prompt(7, String("s_1"), blocks, images)
    assert(text == #"{"jsonrpc":"2.0","id":7,"method":"session/prompt","params":{"sessionId":"s_1","prompt":[{"type":"text","text":"look"},{"type":"image","mimeType":"image/png","data":"iVBORw=="},{"type":"resource_link","uri":"file:///gone"}]}}"#)
    fs.remove_dir_all(dir)!
}
