module server.browser

// The agent's browser (PLAN.md, "The agent's browser"): a headless Chrome,
// Edge or Chromium for each agent that uses one, which the instance drives
// over the DevTools protocol. Each runs on a thread of its own, which starts
// the browser on its first call, does each call in turn, and answers the
// instance's loop with the call's MCP result, so the loop never waits on a
// page. The loop stops it once the agent's turn ends and no one is watching
// it or has it, or once it's been idle, and the next call starts it again, on
// the page it was on.
//
// It's Chrome's own headless mode everywhere, which since Chrome 112 is the
// same browser as the one with a window, drawing pages the same, only without
// the window: so a server with no display needs no virtual one. What a bare
// Linux server lacks is the browser itself and fonts, which `missing` names
// and `loom install` installs (server/setup.calx). On one set up without them,
// the browser's first start fetches Chrome for Testing's headless shell and
// Noto fonts into the instance's data, without root (server/chrome.calx).
//
// The browser's profile, its cookies and logins among them, is in the
// instance's data, not in the agent's folder, so the agent can't read it. A
// guarded browser, a sandboxed person's, opens only http and https pages, and
// loads nothing from the instance's computer or the network it's on.
import std.bytes
import std.env
import std.fs
import std.http.{Header, get}
import std.http.websocket.{Message, WebSocket, connect}
import std.json.{Json, parse}
import std.net.{Waker as LoopWaker}
import std.process.{Child, Command, ProcessError, Stdio, which}
import std.thread.{Task, sleep}
import shared.obj.{Obj, at, bool_at, int_at, merge, str_at}
import shared.protocol
import server.store.{now}
import server.chrome

// How long a browser with nothing to do stays open, in minutes, when no
// turn's end has closed it: an agent that's stopped browsing to think or run
// commands, in a long turn, or a page the person watches and leaves. An agent
// that pauses browsing mostly comes back within a few minutes, and a browser
// that's gone costs it its open page and a second or two to start again, so
// not less; and an idle Chromium holds a few hundred megabytes, so not more.
pub const IDLE_MINUTES: i64 = 5

// How long one DevTools call may take, and how long a page may take to load.
const CALL_MS: i64 = 30000
const LOAD_MS: i64 = 15000
// How long the browser may take to start: a cold start on a slow machine, as a
// CI runner, can take well past 20 s.
const LAUNCH_MS: i64 = 60000
// How long a browser asked to close may take to, before it's ended.
const CLOSE_MS: u64 = 5000
// How much of a page's outline goes to the agent.
const OUTLINE_MOST: usize = 40000
const FRAME_GAP_MS: i64 = 80    // the least time between the frames the page sends
const NAVIGATION_LOOK_MS: i64 = 120    // how long after an act a new page may still be asked for
// The page's size in its own pixels, as the browser's window is, and so the
// biggest a frame of it is.
pub const PAGE_WIDTH: i64 = 1280
pub const PAGE_HEIGHT: i64 = 800
// The smallest a frame is asked for, however small an app shows it.
const FRAME_LEAST: i64 = 64

// A tool call for the browser: browser_open's name is "open", and so on.
pub struct Op {
    pub call: String
    pub name: String
    pub args: Json
}

// Who watches a browser, as the loop tells its thread: frames come only while
// someone does, no bigger than the biggest any of them shows the page at, in
// the forms their apps take.
pub struct Watching {
    pub on: bool
    pub width: i64     // the most a frame is wide, in pixels
    pub height: i64    // and high
    pub text: bool     // an app of protocol version 1 watches: JSON text, the JPEG in base64
    pub binary: bool   // a newer one does: a binary message (shared/protocol.calx)
}

// Nobody watching.
pub fn unwatched() -> Watching {
    return Watching { on: false, width: PAGE_WIDTH, height: PAGE_HEIGHT, text: false, binary: false }
}

// The size a frame is asked for when an app shows the page `width` × `height`
// pixels: the page's own size when it doesn't say (0), and never more than it.
pub fn frame_size(width: i64, height: i64) -> (i64, i64) {
    if width <= 0 or height <= 0 { return (PAGE_WIDTH, PAGE_HEIGHT) }
    return (width.max(FRAME_LEAST).min(PAGE_WIDTH), height.max(FRAME_LEAST).min(PAGE_HEIGHT))
}

pub enum In {
    Do(Op)
    Watch(Watching)    // who watches it now
    Input(Json)    // the person's click, wheel, key or text, while they've taken over
    Record(bool)    // start or stop keeping what the person does, as steps
    Stop
}

// What a browser's thread tells the loop. Each names the agent by its key.
pub enum Back {
    Done(String, String, Json)    // a call, and its MCP result
    Frame(String, String, List<u8>)    // a picture of the page, as browser.frame's text for protocol version 1 and as its binary message for later ones, each empty when no one takes it so
    Open(String, bool)    // whether its browser is open now
    Steps(String, Json, bool)    // what the person's done while recording, as steps, and whether the recording's ended
    Stopped(u64)    // the thread numbered so is ending, with its browser stopped, for the loop to join
}

// Where a browser's thread sends what happens: each send wakes the loop, so a
// tool's result is taken at once.
pub struct BackTo {
    pub to: Sender<Back>
    pub waker: LoopWaker
}

impl BackTo {
    pub fn send(self: mut BackTo, b: own Back) {
        self.to.send(b)
        self.waker.wake()
    }
}

struct Worker {
    n: u64    // which thread it is, for Stopped
    key: String
    data: String    // the instance's data, absolute
    profile: String
    guarded: bool
    proxy: u16    // the agent's egress on the instance's loopback, when its network is closed, or 0
    inbox: Receiver<In>
    back: BackTo
    child: Child?
    page: WebSocket?
    port: String    // where its DevTools listen, for html_preview's tab
    next_id: i64
    refs: Map<String, i64>    // e1, e2, ... -> the node each is, from the last outline
    hidden: List<(String, String)>    // secrets filled into this browser, and their names, kept out of what the agent reads
    watch: Watching
    casting: bool    // whether the page sends frames
    cast_width: i64     // the most they're wide, as the page was asked
    cast_height: i64    // and high
    recording: bool    // whether what the person does is kept as steps
    steps: List<Json>    // what they've done since they started recording
    last_url: String    // the page the last step was on
    was_on: String    // the page the last call left it on
    reopen: String    // the page to open again when the browser starts, where it was before it closed
    told_fonts: bool    // whether the agent's been told the computer has no fonts
    ack: i64       // the last frame's session, to answer
    ack_at: i64    // when to answer it, or 0
    navigating: bool    // a new page has been asked for since the act began
    loaded: bool        // and has loaded
    before: Thread?    // the thread of the agent's browser before this one, still closing on the profile, which its first start waits for
}

impl Task for Worker {
    fn run(own self) {
        var w = self
        loop {
            // While frames come, they're taken often, so the person sees the page as it changes.
            let wait: u64 = if w.casting { 30000000 } else { 1000000000 }
            match unsafe { w.inbox.wait_for(wait) } {
                some(In.Do(op)) => {
                    let result = match w.op(op.name.copy(), op.args.copy()) {
                        ok(r) => r,
                        err(e) => {
                            // A browser that's gone is started again on the next call.
                            if not w.alive() { w.close() }
                            error("{e}")
                        },
                    }
                    // The page's host and address as the call left it, for the person's
                    // rules on sites and to open it again after a close; the instance
                    // takes them off before the agent gets the result.
                    var site = String()
                    var url = String()
                    if op.name != "preview" and w.page != none {
                        if let ok(u) = w.url() {
                            site = host_of(u.copy())
                            if kept_page(u.copy()) { w.was_on = u.copy() }
                            url = w.was_on.copy()
                        }
                    }
                    w.back.send(Back.Done(w.key.copy(), op.call.copy(), merge(result, Obj.new().s("loom_site", site).s("loom_url", url).done())))
                },
                some(In.Record(on)) => w.record(on),
                some(In.Watch(on)) => {
                    w.watch = on
                    w.cast()
                },
                some(In.Input(e)) => {
                    if let err(why) = w.input(e) { eprintln("loom: the browser: {why}") }
                },
                some(In.Stop) => {
                    w.close()
                    // One stopped before it ever started still waits for the browser
                    // before it, so an instance that stops leaves neither running.
                    if let t = w.before.take() { t.join() }
                    w.back.send(Back.Stopped(w.n))
                    return
                },
                none => w.drain(),
            }
        }
    }
}

// Starts the thread for the agent `key` names, whose browser keeps its profile
// in `profile`, in the instance's `data`, where a browser and fonts it fetches
// for itself go (server/chrome.calx). What it has to say comes to `back`. The thread ends once it's
// sent Stop, with its browser stopped, and said Stopped with `n`. `reopen` is the page it was on when it
// last closed, or "", which its first call that isn't browser_open opens again.
// `before` is the thread of the agent's browser before, while it's still closing, which the
// browser waits for before it first starts, since that one holds the profile until it ends.
pub fn start(n: u64, key: String, data: String, profile: String, guarded: bool, proxy: u16, reopen: String, before: own Thread?, back: BackTo) -> (Sender<In>, Thread) {
    let inbox = Receiver<In>()
    let to = inbox.sender()
    let t = unsafe { Thread.spawn(Worker { n: n, key: key.copy(), data: data.copy(), profile: profile.copy(), guarded: guarded, proxy: proxy, inbox: inbox, back: back.copy(), child: none, page: none, port: String(), next_id: 0, refs: Map<String, i64>(), hidden: List<(String, String)>(), watch: unwatched(), casting: false, cast_width: 0, cast_height: 0, recording: false, steps: List<Json>(), last_url: String(), was_on: String(), reopen: reopen.copy(), told_fonts: false, ack: 0, ack_at: 0, navigating: false, loaded: false, before: before }) }
    return (to, t)
}

// The browser to run: LOOM_BROWSER, or the first Chrome, Edge or Chromium found
// where they're installed, or on PATH. On Linux, a snap's comes last: a snap
// can't keep its profile in a service's folder, as /var/lib/loom.
pub fn find() -> String? {
    if let set = env.variable(String("LOOM_BROWSER")) {
        if set.trim().len() > 0 { return some(set.trim().copy()) }
    }
    var places = List<String>()
    for base in ["PROGRAMFILES", "PROGRAMFILES(X86)", "LOCALAPPDATA"] {
        if let root = env.variable(String(base)) {
            places.push("{root}\\Google\\Chrome\\Application\\chrome.exe")
            places.push("{root}\\Microsoft\\Edge\\Application\\msedge.exe")
            places.push("{root}\\Chromium\\Application\\chrome.exe")
        }
    }
    places.push(String("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"))
    places.push(String("/Applications/Chromium.app/Contents/MacOS/Chromium"))
    places.push(String("/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"))
    for p in places {
        if fs.is_file(p.copy()) { return some(p.copy()) }
    }
    var snaps = List<String>()
    for name in ["chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "microsoft-edge", "chrome"] {
        if let found = which(String(name)) {
            if not is_snap(found.copy()) { return some(found) }
            snaps.push(found)
        }
    }
    if snaps.len() > 0 { return some(snaps[0].copy()) }
    return none
}

// Whether `path` is a snap's browser, or Ubuntu's chromium-browser, which only
// starts the snap.
pub fn is_snap(path: String) -> bool {
    if path.starts_with("/snap/") { return true }
    if let ok(real) = fs.real_path(path.copy()) {
        if real.starts_with("/snap/") or real.ends_with("/snap") { return true }
    }
    // Ubuntu's is a short script; a real browser is a program of its own.
    if path.ends_with("/chromium-browser") {
        if let ok(m) = fs.metadata(path.copy()) {
            if m.size < 16384 {
                if let ok(some(t)) = fs.read_text(path) { return t.contains("snap") }
            }
        }
    }
    return false
}

// What the computer lacks for the browser to show pages as a desktop does,
// in a few words each: a browser, or fonts. Only Linux lacks them: Windows and
// macOS come with fonts, and the desktop app finds the Edge or Chrome that's
// there. Empty when nothing's missing.
pub fn missing() -> List<String> {
    var gaps = List<String>()
    if env.os() != "linux" { return gaps }
    match find() {
        some(exe) => {
            if is_snap(exe.copy()) { gaps.push(String("a browser that isn't a snap")) }
        },
        none => gaps.push(String("a browser")),
    }
    gaps.extend(font_gaps(fonts(String())))
    return gaps
}

// The fonts the browser can draw with, by family, a line each, and the lines
// after "lang=zh" and "emoji" headers the ones for Chinese and emoji: as
// fontconfig, which Chrome on Linux uses, lists them. Without fc-list, the
// font files in the usual folders, by name. With the instance's `data`, the
// fonts it fetched for itself count too; "" for only the system's.
fn fonts(data: String) -> List<String> {
    var lines = List<String>()
    let conf = if data.len() > 0 { chrome.font_config(data.copy()) } else { none }
    if which(String("fc-list")) != none {
        for (header, pattern) in [("all", ":"), ("lang=zh", ":lang=zh"), ("emoji", ":charset=1f600")] {
            lines.push("# {header}")
            var list = Command.new(String("fc-list")).arg(String(pattern)).arg(String("family")).timeout(20000)
            if let c = conf.copy() { list = list.env(String("FONTCONFIG_FILE"), c) }
            if let ok(out) = list.output() {
                for line in out.text().lines() {
                    if line.trim().len() > 0 { lines.push(line.trim().copy()) }
                }
            }
        }
        return lines
    }
    var dirs: List<String> = ["/usr/share/fonts", "/usr/local/share/fonts"]
    if let home = env.variable(String("HOME")) {
        dirs.push("{home}/.fonts")
        dirs.push("{home}/.local/share/fonts")
    }
    if conf != none { dirs.push("{chrome.home(data)}/fonts") }
    for dir in dirs {
        if not fs.is_dir(dir.copy()) { continue }
        if let ok(found) = fs.walk(dir) {
            for e in found {
                let lower = e.path.to_lower_root()
                if lower.ends_with(".ttf") or lower.ends_with(".otf") or lower.ends_with(".ttc") or lower.ends_with(".otc") or lower.ends_with(".pfb") or lower.ends_with(".woff2") { lines.push("file {e.path}") }
            }
        }
    }
    return lines
}

// What's missing from the fonts `fonts` gives: any at all, ones for Chinese,
// Japanese and Korean, and emoji.
pub fn font_gaps(lines: List<String>) -> List<String> {
    var any = false
    var cjk = false
    var emoji = false
    var part = String("all")
    for line in lines {
        if line.starts_with("# ") {
            part = line[2..].copy()
            continue
        }
        if part == "all" { any = true }
        if part == "lang=zh" { cjk = true }
        if part == "emoji" { emoji = true }
        // Files, by name, without fontconfig to ask.
        if line.starts_with("file ") {
            let name = line.to_lower_root()
            if name.contains("cjk") or name.contains("wqy") or name.contains("droidsansfallback") or name.contains("unifont") { cjk = true }
            if name.contains("emoji") { emoji = true }
        }
    }
    var gaps = List<String>()
    if not any { return [String("fonts")] }
    if not cjk { gaps.push(String("fonts for Chinese, Japanese and Korean")) }
    if not emoji { gaps.push(String("an emoji font")) }
    return gaps
}

// What to say a computer missing `gaps` should have, for the person who runs it.
pub fn missing_text(gaps: List<String>) -> String {
    return "This server lacks {join_and(gaps)} for its browser. Its owner can run sudo loom install again, which installs them, or install them: on Debian, apt install chromium fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji."
}

fn join_and(parts: List<String>) -> String {
    if parts.len() == 0 { return String() }
    if parts.len() == 1 { return parts[0].copy() }
    var head = List<String>()
    for k in 0usize..parts.len() - 1 { head.push(parts[k].copy()) }
    return "{head.join(", ")} and {parts[parts.len() - 1]}"
}

// Whether a page is one to open again after the browser closes: a web page or
// a file, not a blank one or the browser's own.
fn kept_page(url: String) -> bool {
    let lower = url.to_lower_root()
    return lower.starts_with("http://") or lower.starts_with("https://") or lower.starts_with("file:")
}

// Stops the browsers a loom that ended without stopping them left running,
// as one that crashed would: each profile in `root` (a person's folder each,
// an agent's in that) whose browser still listens where it wrote it does is
// told to close, by the address only that browser has.
pub fn stop_leftovers(root: String) {
    let found = match fs.glob("{root}/*/*/DevToolsActivePort") {
        ok(f) => f,
        err(_) => return,
    }
    for file in found {
        if let ok(some(t)) = fs.read_text(file.copy()) {
            let lines = t.lines()
            if lines.len() >= 2 {
                let port = lines[0].trim().copy()
                let path = lines[1].trim().copy()
                if path.starts_with("/devtools/browser/") {
                    // On this computer's own loopback a browser that's there
                    // answers at once; a closed port would run out the whole wait.
                    if let ok(ws) = connect("ws://127.0.0.1:{port}{path}", List<Header>(), 300) {
                        if let ok = ws.send_text("{Obj.new().i("id", 1).s("method", String("Browser.close")).j("params", Obj.new().done()).done()}") {
                            match ws.receive(2000) {
                                ok(_) => {},
                                err(_) => {},
                            }
                        }
                        ws.close()
                        // It's gone once nothing listens there: till then its profile
                        // is its, and the agent's next browser would hand its pages to it.
                        let until = now() + i64.wrap(CLOSE_MS)
                        var gone = false
                        while not gone and now() < until {
                            match connect("ws://127.0.0.1:{port}{path}", List<Header>(), 300) {
                                ok(still) => {
                                    still.close()
                                    unsafe { sleep(100000000) }
                                },
                                err(_) => gone = true,
                            }
                        }
                        if gone { eprintln("loom: stopped a browser left running from before, in {file}") } else { eprintln("loom: a browser left running from before, in {file}, didn't close when asked") }
                    }
                }
            }
        }
        if let err(e) = fs.remove_file(file) { eprintln("loom: a browser's old port file: {e}") }
    }
}

fn text(t: String) -> Json {
    return Obj.new().j("content", Json.Array([Obj.new().s("type", String("text")).s("text", t).done()])).done()
}

fn error(t: String) -> Json {
    return Obj.new().j("content", Json.Array([Obj.new().s("type", String("text")).s("text", t).done()])).b("isError", true).done()
}

// A result with `note` as a text before the rest of it, when there's one.
fn noted(result: own Json, note: String) -> Json {
    if note.len() == 0 { return result }
    var content: List<Json> = [Obj.new().s("type", String("text")).s("text", note).done()]
    if let Json.Array(had) = at(result.copy(), "content") { content.extend(had) }
    return merge(result, Obj.new().j("content", Json.Array(content)).done())
}

impl Worker {
    fn alive(w: Worker) -> bool {
        if let p = w.page { return p.is_open() }
        return false
    }

    // Stops the browser and what it started. It's asked to close first, so it
    // writes its profile, the logins the person made in it among it, and then
    // it and every process it started are ended, whether it has or not.
    fn close(w: mut Worker) {
        let was = w.child != none
        if let p = w.page.take() {
            if let c = w.child {
                if c.try_wait() == none {
                    w.next_id += 1
                    if let ok = p.send_text("{Obj.new().i("id", w.next_id).s("method", String("Browser.close")).j("params", Obj.new().done()).done()}") { _ = c.wait_timeout(CLOSE_MS) }
                }
            }
            p.close()
        }
        if let c = w.child {
            c.kill_tree()
            _ = c.wait_timeout(5000)
            // Chrome leaves its port file behind; one found at the next start
            // costs a connect that times out.
            let port_file = "{w.profile}/DevToolsActivePort"
            if fs.exists(port_file.copy()) { if let err(_) = fs.remove_file(port_file) {} }
        }
        w.child = none
        w.refs.clear()
        w.casting = false
        w.ack_at = 0
        // A browser that went by itself opens where it was on the next call.
        if w.was_on.len() > 0 { w.reopen = w.was_on.copy() }
        // A recording ends with its browser, keeping what it had.
        if w.recording {
            w.recording = false
            w.back.send(Back.Steps(w.key.copy(), Json.Array(w.steps.copy()), true))
            w.steps.clear()
        }
        if was { w.back.send(Back.Open(w.key.copy(), false)) }
    }

    // Takes what the page sent meanwhile: frames, while someone watches. And
    // what the browser wrote, so it never waits on a full pipe.
    fn drain(w: mut Worker) {
        if let c = w.child {
            while let _ = c.read_line(0) {}
        }
        loop {
            w.ack_frame()
            let m = match w.receive(0) {
                ok(some(m)) => m,
                _ => return,
            }
            if let Message.Text(t) = m {
                if let ok(e) = parse(t) { w.event(e) }
            }
        }
    }

    // Answers the last frame once its time has come, so the page sends the next.
    fn ack_frame(w: mut Worker) {
        if w.ack_at == 0 or now() < w.ack_at { return }
        w.ack_at = 0
        let session = w.ack
        if let err(e) = w.send("Page.screencastFrameAck", Obj.new().i("sessionId", session).done()) { eprintln("loom: the browser: {e}") }
    }

    // An event from the page. A frame goes to the loop, and the page is told
    // it came, so it sends the next.
    fn event(w: mut Worker, e: Json) {
        let method = str_at(e.copy(), "method") ?? String()
        // What settle waits on: a new page asked for or loading, and loaded.
        if method == "Page.frameRequestedNavigation" or method == "Page.frameStartedLoading" { w.navigating = true }
        if method == "Page.loadEventFired" { w.loaded = true }
        if method != "Page.screencastFrame" { return }
        let params = at(e, "params")
        // The page sends the next frame once this one is answered, so answering
        // a little later keeps them to about twelve a second: a page that moves
        // all the time would otherwise send a hundred, each 100 KB or more.
        w.ack = int_at(params.copy(), "sessionId") ?? 0
        w.ack_at = now() + FRAME_GAP_MS
        // The page's size, which the person's clicks are in, whatever size the picture is.
        let meta = at(params.copy(), "metadata")
        let width = i64.round(at(meta.copy(), "deviceWidth").as_f64() ?? 0.0)
        let height = i64.round(at(meta, "deviceHeight").as_f64() ?? 0.0)
        let data = str_at(params, "data") ?? String()
        let (_, agent) = w.key.split_once("/") ?? (String(), String())
        // Made here, not on the instance's loop: the text, with the JPEG as the
        // page sent it, in base64, and the binary message, with it as it is.
        var as_text = String()
        if w.watch.text { as_text = #"{"t":"browser.frame","agent":#{Json.Str(agent.copy())},"data":"#{data}","width":#{width},"height":#{height}}"# }
        var as_binary = List<u8>()
        if w.watch.binary {
            if let jpeg = bytes.from_base64(data) {
                as_binary = protocol.binary(#"{"t":"browser.frame","agent":#{Json.Str(agent)},"width":#{width},"height":#{height}}"#, jpeg)
            }
        }
        w.back.send(Back.Frame(w.key.copy(), as_text, as_binary))
    }

    // Starts or stops the page's frames, as whether someone watches says, and
    // starts them again at the size they're shown at when it changes.
    fn cast(w: mut Worker) {
        if w.page == none { return }
        let on = w.watch.on
        if w.casting and (not on or w.cast_width != w.watch.width or w.cast_height != w.watch.height) {
            if let err(e) = w.call("Page.stopScreencast", Obj.new().done()) { eprintln("loom: the browser: {e}") }
            w.casting = false
            w.ack_at = 0
        }
        if on and not w.casting {
            // Chrome scales each frame down to fit, so a small window gets a small JPEG.
            let params = Obj.new().s("format", String("jpeg")).i("quality", 60).i("maxWidth", w.watch.width).i("maxHeight", w.watch.height).done()
            if let ok(_) = w.call("Page.startScreencast", params) {
                w.casting = true
                w.cast_width = w.watch.width
                w.cast_height = w.watch.height
            }
        }
    }

    // The person's click, wheel, key or text, while they've taken over.
    fn input(w: mut Worker, e: Json) ! Error {
        if w.page == none { return }
        // Kept before it's done: what a click lands on is what's under it now.
        if w.recording {
            if let err(why) = w.keep_step(e.copy()) { eprintln("loom: recording in the browser: {why}") }
        }
        let kind = str_at(e.copy(), "kind") ?? String()
        let x = at(e.copy(), "x").as_f64() ?? 0.0
        let y = at(e.copy(), "y").as_f64() ?? 0.0
        if kind == "click" {
            try w.mouse("mouseMoved", x, y, Obj.new())
            try w.mouse("mousePressed", x, y, Obj.new().s("button", String("left")).i("clickCount", 1))
            try w.mouse("mouseReleased", x, y, Obj.new().s("button", String("left")).i("clickCount", 1))
        } else if kind == "move" {
            try w.mouse("mouseMoved", x, y, Obj.new())
        } else if kind == "wheel" {
            try w.mouse("mouseWheel", x, y, Obj.new().j("deltaX", Json.Float(0.0)).j("deltaY", Json.Float(at(e.copy(), "dy").as_f64() ?? 0.0)))
        } else if kind == "key" {
            try w.press_key(str_at(e, "key") ?? String())
        } else if kind == "text" {
            _ = try w.call("Input.insertText", Obj.new().s("text", str_at(e, "text") ?? String()).done())
        }
        w.refs.clear()
    }

    // Starts or stops recording what the person does (PLAN.md, "Teach a
    // task"). Stopping sends what was kept, as the recording's end.
    fn record(w: mut Worker, on: bool) {
        if on {
            if w.page == none or w.recording { return }
            w.recording = true
            w.steps.clear()
            w.last_url = String()
            if let err(why) = w.note_page() { eprintln("loom: recording in the browser: {why}") }
            w.back.send(Back.Steps(w.key.copy(), Json.Array(w.steps.copy()), false))
            return
        }
        if not w.recording { return }
        // A click or a key just before may have opened a page that's still loading.
        if w.page != none {
            w.settle()
            if let err(why) = w.note_page() { eprintln("loom: recording in the browser: {why}") }
        }
        w.recording = false
        w.back.send(Back.Steps(w.key.copy(), Json.Array(w.steps.copy()), true))
        w.steps.clear()
    }

    // A step for the page the browser is on, when it's another than the last
    // step's.
    fn note_page(w: mut Worker) ! Error {
        let h = try w.call("Page.getNavigationHistory", Obj.new().done())
        let k = int_at(h.copy(), "currentIndex") ?? 0
        let entry = at(h, "entries").at(usize.wrap(k)) ?? Json.Null
        let url = str_at(entry.copy(), "url") ?? String()
        if url == w.last_url or url.len() == 0 { return }
        w.last_url = url.copy()
        let step = Obj.new().s("kind", String("page")).s("title", w.hide(short(str_at(entry, "title") ?? String(), 200))).s("url", w.hide(short(url, STEP_TEXT_MOST))).done()
        w.push_step(step)
    }

    fn last_step(w: Worker) -> Json? {
        if w.steps.len() == 0 { return none }
        return some(w.steps[w.steps.len() - 1].copy())
    }

    // What the person just did, as a step: a click on what's under it, text
    // typed into the field that has the focus (never what goes into a password
    // field), a key, or a scroll.
    fn keep_step(w: mut Worker, e: Json) ! Error {
        let kind = str_at(e.copy(), "kind") ?? String()
        if kind == "move" { return }
        try w.note_page()
        if kind == "click" {
            let x = at(e.copy(), "x").as_f64() ?? 0.0
            let y = at(e, "y").as_f64() ?? 0.0
            let (what, _) = try w.describe("document.elementFromPoint({x}, {y})")
            w.push_step(Obj.new().s("kind", String("click")).s("on", what).done())
            return
        }
        if kind == "text" {
            let typed = str_at(e, "text") ?? String()
            if typed.len() == 0 { return }
            let (into, secret) = try w.describe(String("document.activeElement"))
            if secret {
                // Only that something secret went in, never what.
                if let last = w.last_step() {
                    if str_at(last.copy(), "kind") == some(String("type")) and str_at(last.copy(), "into") == some(into.copy()) and bool_at(last, "secret") == some(true) { return }
                }
                w.push_step(Obj.new().s("kind", String("type")).s("into", into).b("secret", true).done())
                return
            }
            // Typing goes on in the same field as one step.
            if let last = w.last_step() {
                if str_at(last.copy(), "kind") == some(String("type")) and str_at(last.copy(), "into") == some(into.copy()) and bool_at(last.copy(), "secret") != some(true) {
                    let had = str_at(last, "text") ?? String()
                    let n = w.steps.len() - 1
                    w.steps[n] = Obj.new().s("kind", String("type")).s("into", into).s("text", w.hide(short("{had}{typed}", STEP_TEXT_MOST))).done()
                    w.back.send(Back.Steps(w.key.copy(), Json.Array(w.steps.copy()), false))
                    return
                }
            }
            let step = Obj.new().s("kind", String("type")).s("into", into).s("text", w.hide(short(typed, STEP_TEXT_MOST))).done()
            w.push_step(step)
            return
        }
        if kind == "key" {
            let key = str_at(e, "key") ?? String()
            // Backspace while typing takes the last character back out of the step.
            if key == "Backspace" {
                if let last = w.last_step() {
                    let had = str_at(last.copy(), "text") ?? String()
                    if str_at(last.copy(), "kind") == some(String("type")) and had.len() > 0 {
                        var runes = List<rune>()
                        for r in had.runes() { runes.push(r) }
                        _ = runes.pop()
                        var less = String()
                        for r in runes { less.push(r) }
                        let n = w.steps.len() - 1
                        w.steps[n] = Obj.new().s("kind", String("type")).s("into", str_at(last, "into") ?? String()).s("text", less).done()
                        w.back.send(Back.Steps(w.key.copy(), Json.Array(w.steps.copy()), false))
                        return
                    }
                }
            }
            if key.len() > 0 { w.push_step(Obj.new().s("kind", String("key")).s("key", key).done()) }
            return
        }
        if kind == "wheel" {
            let direction = if (at(e, "dy").as_f64() ?? 0.0) < 0.0 { String("up") } else { String("down") }
            // A run of scrolls one way is one step.
            if let last = w.last_step() {
                if str_at(last.copy(), "kind") == some(String("scroll")) and str_at(last, "direction") == some(direction.copy()) { return }
            }
            w.push_step(Obj.new().s("kind", String("scroll")).s("direction", direction).done())
        }
    }

    fn push_step(w: mut Worker, step: own Json) {
        if w.steps.len() >= STEPS_MOST { return }
        w.steps.push(step)
        w.back.send(Back.Steps(w.key.copy(), Json.Array(w.steps.copy()), false))
    }

    // The part of the page `element` (a script that gives one) is in, as an
    // outline line names it, such as button "Sign in", and whether it takes
    // something secret, as a password field does.
    fn describe(w: mut Worker, element: String) -> (String, bool) ! Error {
        let r = try w.call("Runtime.evaluate", Obj.new().s("expression", "({DESCRIBE})({element})").b("returnByValue", true).done())
        let v = at(at(r, "result"), "value")
        let role = str_at(v.copy(), "role") ?? String("page")
        let name = w.hide(short(str_at(v.copy(), "name") ?? String(), 120))
        let what = if name.len() > 0 { "{role} \"{name}\"" } else { role }
        return (what, bool_at(v, "secret") ?? false)
    }

    // Starts the browser, and opens the DevTools connection to its page. Gives
    // the fonts it still lacks, on Linux before the agent's been told of them,
    // and none otherwise.
    fn open_browser(w: mut Worker) -> List<String> ! Error {
        let exe = try w.program()
        // Fonts the server lacks are fetched before the browser starts, which reads them only then.
        var gaps = List<String>()
        if env.os() == "linux" and not w.told_fonts {
            gaps = font_gaps(fonts(w.data.copy()))
            if gaps.len() > 0 {
                if let err(e) = chrome.fetch_fonts(w.data.copy(), gaps.copy()) { eprintln("loom: fetching fonts for the agents' browser: {e}") }
                // Only a fetch changes what's there, so only then is it listed again.
                gaps = font_gaps(fonts(w.data.copy()))
            }
        }
        try fs.make_dir_all(w.profile.copy())
        // The agent's browser before this one may still be closing on the profile.
        if let t = w.before.take() { t.join() }
        let port = match w.launch(exe.copy(), true) {
            ok(p) => p,
            err(e) => {
                // Linux may not let the browser make its sandbox, as Ubuntu's AppArmor
                // doesn't for a Chrome it has no profile for, and a container doesn't.
                // Then it runs without one, and says so.
                if env.os() != "linux" or not "{e}".contains("sandbox") { fail "{e}" }
                eprintln("loom: the browser can't make its sandbox here, so it runs without one: {e}")
                try w.launch(exe, false)
            },
        }
        w.port = port.copy()
        var asked = get("http://127.0.0.1:{port}/json/list", List<Header>(), 10000, 4000000)
        let got = try asked.wait()
        let targets = try parse(String.from_utf8(got.body) ?? String())
        var address = String()
        if let Json.Array(list) = targets {
            for t in list {
                if address.len() == 0 and str_at(t.copy(), "type") == some(String("page")) { address = str_at(t, "webSocketDebuggerUrl") ?? String() }
            }
        }
        if address.len() == 0 {
            w.close()
            fail "The browser started without a page."
        }
        w.page = some(try connect(address))
        w.next_id = 0
        // Headless Chrome says so in its user agent, and some sites turn it away.
        let version = try w.call("Browser.getVersion", Obj.new().done())
        let agent = (str_at(version, "userAgent") ?? String()).replace("HeadlessChrome", "Chrome")
        _ = try w.call("Emulation.setUserAgentOverride", Obj.new().s("userAgent", agent).done())
        _ = try w.call("Page.setDownloadBehavior", Obj.new().s("behavior", String("deny")).done())
        _ = try w.call("Page.enable", Obj.new().done())
        if w.guarded {
            var blocked = List<Json>()
            for p in guarded_patterns() { blocked.push(Json.Str(p.copy())) }
            _ = try w.call("Network.enable", Obj.new().done())
            _ = try w.call("Network.setBlockedURLs", Obj.new().j("urls", Json.Array(blocked)).done())
        }
        w.back.send(Back.Open(w.key.copy(), true))
        w.cast()
        return gaps
    }

    // The browser to start: the computer's own, or on a Linux server without one,
    // the one the instance fetched for itself, fetched now if it hasn't been, or
    // again once it's old.
    fn program(w: Worker) -> String ! Error {
        if let exe = find() { return exe }
        if env.os() != "linux" { fail "There's no Chrome, Edge or Chromium on the computer the instance runs on. Your person can install one, or set LOOM_BROWSER to the one to use. Don't open pages on their devices instead unless they ask you to." }
        var exe = String()
        if let (had, old) = chrome.fetched(w.data.copy()) {
            exe = had.copy()
            if old {
                match chrome.fetch_browser(w.data.copy()) {
                    ok(newer) => exe = newer,
                    err(e) => eprintln("loom: the agents' browser is four weeks old, and a newer one didn't fetch: {e}"),
                }
            }
        } else {
            exe = match chrome.fetch_browser(w.data.copy()) {
                ok(got) => got,
                err(e) => fail "There's no Chrome or Chromium on the server the instance runs on, and it couldn't fetch one for itself: {e}. {missing_text(missing())} Or set LOOM_BROWSER to the browser to use. Don't open pages on your person's devices instead unless they ask you to.",
            }
        }
        let lacking = chrome.libraries_missing(exe.copy())
        if lacking.len() > 0 { fail "The browser the instance fetched for itself needs libraries this server lacks: {lacking.join(", ")}. {missing_text([String("the libraries a browser needs")])} Don't open pages on your person's devices instead unless they ask you to." }
        return exe
    }

    // Sends a DevTools call without waiting for its answer, and gives its id.
    fn send(w: mut Worker, method: str, params: Json) -> i64 ! Error {
        w.next_id += 1
        let p = w.page else fail "The browser isn't open."
        try p.send_text("{Obj.new().i("id", w.next_id).s("method", String(method)).j("params", params).done()}")
        return w.next_id
    }

    fn receive(w: Worker, ms: u32) -> Message? ! Error {
        let p = w.page else fail "The browser isn't open."
        return try p.receive(ms)
    }

    // Starts the browser and gives the port it listens on, or fails with why it
    // didn't start, in its own words.
    fn launch(w: mut Worker, exe: String, sandbox: bool) -> String ! Error {
        let port_file = "{w.profile}/DevToolsActivePort"
        if fs.exists(port_file.copy()) { try fs.remove_file(port_file.copy()) }
        var args: List<String> = ["--headless=new", "--remote-debugging-port=0", "--user-data-dir={w.profile}", "--no-first-run", "--no-default-browser-check", "--disable-background-networking", "--window-size=1280,800"]
        if not sandbox { args.push(String("--no-sandbox")) }
        // A container's /dev/shm is 64 MB, which a page can fill and crash its tab;
        // /tmp does as well everywhere.
        if env.os() == "linux" { args.push(String("--disable-dev-shm-usage")) }
        // An agent closed to the network browses through its egress, which lets it
        // reach only the hosts on its list: every request, the computer's own too,
        // and nothing over UDP, which a proxy doesn't carry.
        if w.proxy > 0 {
            args.extend(["--proxy-server=http://127.0.0.1:{w.proxy}", String("--proxy-bypass-list=<-loopback>"), String("--disable-quic"), String("--force-webrtc-ip-handling-policy=disable_non_proxied_udp")])
        }
        args.push(String("about:blank"))
        var command = Command.new(exe).args(args).stdin(Stdio.Null).stdout(Stdio.Pipe).stderr(Stdio.Stdout).own_group()
        // With the fonts the instance fetched for itself, as well as the system's.
        if let conf = chrome.font_config(w.data.copy()) { command = command.env(String("FONTCONFIG_FILE"), conf) }
        // It ends with the instance however the instance ends, killed or crashed too,
        // and every process it started with it. The instance in the desktop app is in
        // a library, which can't start one so on Linux and macOS: there it ends when
        // the instance stops it, and one a crashed app left once it starts again.
        let child = match command.copy().ends_with_this().spawn() {
            ok(c) => c,
            err(ProcessError.BadArgument(_)) => try command.spawn(),
            err(e) => fail "{e}",
        }
        // The browser writes the port it took, and its own address, once it listens.
        var said = List<String>()
        let until = now() + LAUNCH_MS
        loop {
            while let line = child.read_line(0) {
                said.push(line)
                // The first lines say why, as "No usable sandbox!"; a crash's stack comes after.
                if said.len() > 8 { _ = said.pop() }
            }
            if let ok(some(t)) = fs.read_text(port_file.copy()) {
                let lines = t.lines()
                if lines.len() >= 2 {
                    w.child = some(child)
                    return lines[0].trim().copy()
                }
            }
            if child.try_wait() != none or now() > until {
                child.kill_tree()
                _ = child.wait_timeout(5000)
                let why = said.join(" ").trim().copy()
                // A browser copied onto a bare server, without the libraries it needs.
                if why.contains("error while loading shared libraries") { fail "The browser didn't start: {short(why, 400)} {missing_text([String("the libraries a browser needs")])}" }
                fail if why.len() > 0 { "The browser didn't start: {short(why, 600)}" } else { String("The browser didn't start.") }
            }
            unsafe { sleep(100000000) }
        }
    }

    // One DevTools call, and its result. The page's events that come
    // meanwhile are taken as they come.
    fn call(w: mut Worker, method: str, params: Json) -> Json ! Error {
        let id = try w.send(method, params)
        let until = now() + CALL_MS
        loop {
            w.ack_frame()
            let left = until - now()
            if left <= 0 { fail "The browser didn't answer {method} in time." }
            let m = try w.receive(u32.wrap(left)) else continue
            let Message.Text(t) = m else continue
            let reply = try parse(t)
            if reply.get(String("method")) != none {
                w.event(reply)
                continue
            }
            if int_at(reply.copy(), "id") != some(id) { continue }
            if let e = reply.get(String("error")) { fail "{str_at(e, "message") ?? String("The browser refused it.")}" }
            return at(reply, "result")
        }
    }

    // Waits for the page to finish loading, after something that may have
    // started a new one.
    //
    // The page says when a new one is asked for, so an act that started none
    // is done after a short look, and one that did is done once it has loaded.
    // Until a new page has been asked for, the old one says it's complete, so
    // readyState is asked only once one has, or once the old wait has passed.
    fn settle(w: mut Worker) {
        let started = now()
        while not w.navigating and now() - started < NAVIGATION_LOOK_MS {
            w.pump(started + NAVIGATION_LOOK_MS - now())
        }
        if w.navigating {
            let until = now() + LOAD_MS
            var asked: i64 = 0
            while now() < until and not w.loaded {
                w.pump(100)
                if w.loaded { break }
                if now() - started < 300 or now() - asked < 100 { continue }
                asked = now()
                match w.call("Runtime.evaluate", Obj.new().s("expression", String("document.readyState")).b("returnByValue", true).done()) {
                    ok(r) => if str_at(at(r, "result"), "value") == some(String("complete")) { break },
                    err(_) => {},
                }
            }
        }
        w.navigating = false
        w.loaded = false
    }

    // Takes the page's events for up to `ms` milliseconds.
    fn pump(w: mut Worker, ms: i64) {
        if ms <= 0 { return }
        w.ack_frame()
        let m = match w.receive(u32.wrap(ms)) {
            ok(some(m)) => m,
            _ => return,
        }
        if let Message.Text(t) = m {
            if let ok(e) = parse(t) {
                if e.get(String("method")) != none { w.event(e) }
            }
        }
    }

    // Where the page is: its title and address.
    fn where(w: mut Worker) -> String ! Error {
        let h = try w.call("Page.getNavigationHistory", Obj.new().done())
        let k = int_at(h.copy(), "currentIndex") ?? 0
        let entry = at(h, "entries").at(usize.wrap(k)) ?? Json.Null
        return "{str_at(entry.copy(), "title") ?? String()} ({str_at(entry, "url") ?? String()})"
    }

    // The page as the agent reads it, with a ref for each part it can act on.
    fn outline(w: mut Worker) -> String ! Error {
        let tree = try w.call("Accessibility.getFullAXTree", Obj.new().done())
        let Json.Array(nodes) = at(tree, "nodes") else fail "The browser gave no outline of the page."
        w.refs.clear()
        var t = outline_of(nodes, mut w.refs)
        if t.len() > OUTLINE_MOST {
            var cut = String()
            for line in t.lines() {
                if cut.len() + line.len() > OUTLINE_MOST { break }
                cut.push_str(line)
                cut.push('\n')
            }
            cut.push_str("(The page goes on past here.)")
            t = cut
        }
        return w.hide("Page: {try w.where()}\n\n{t}")
    }

    // `t` with every secret filled into this browser in it named, not said.
    fn hide(w: Worker, t: String) -> String {
        var out = t.copy()
        for (value, label) in w.hidden {
            if value.len() > 0 { out = out.replace(value.copy(), "[secret {label}]") }
        }
        return out
    }

    // The page's host, as a secret is allowed for it: example.com, or
    // localhost:8080. A file has none.
    fn host(w: mut Worker) -> String ! Error {
        return host_of(try w.url())
    }

    // The address of the page it's on.
    fn url(w: mut Worker) -> String ! Error {
        let h = try w.call("Page.getNavigationHistory", Obj.new().done())
        let k = int_at(h.copy(), "currentIndex") ?? 0
        let entry = at(h, "entries").at(usize.wrap(k)) ?? Json.Null
        return str_at(entry, "url") ?? String()
    }

    // The node a ref names, from the last outline.
    fn node(w: Worker, args: Json) -> i64 ! Error {
        let r = str_at(args, "ref") ?? String()
        let id = w.refs.get(r.copy()) else fail "There's no {r} on the page now. Take a new browser_snapshot, and use a ref from it."
        return id
    }

    // The middle of a node on the screen, scrolled into view.
    fn middle(w: mut Worker, id: i64) -> (f64, f64) ! Error {
        match w.call("DOM.scrollIntoViewIfNeeded", Obj.new().i("backendNodeId", id).done()) {
            ok(_) => {},
            err(_) => {},
        }
        let box = try w.call("DOM.getBoxModel", Obj.new().i("backendNodeId", id).done())
        let Json.Array(q) = at(at(box, "model"), "content") else fail "That isn't on the screen."
        if q.len() < 8 { fail "That isn't on the screen." }
        var x = 0.0
        var y = 0.0
        for k in 0usize..4 {
            x += q[k * 2].as_f64() ?? 0.0
            y += q[k * 2 + 1].as_f64() ?? 0.0
        }
        return (x / 4.0, y / 4.0)
    }

    fn mouse(w: mut Worker, kind: str, x: f64, y: f64, extra: own Obj) ! Error {
        let params = extra.s("type", String(kind)).j("x", Json.Float(x)).j("y", Json.Float(y)).done()
        _ = try w.call("Input.dispatchMouseEvent", params)
    }

    fn press_key(w: mut Worker, name: String) ! Error {
        let (code, typed) = key_code(name.copy()) else fail "browser_press takes a key such as Enter, Tab, Escape, Backspace, ArrowDown or PageDown, or a single character."
        var down = Obj.new().s("type", String(if typed.len() > 0 { "keyDown" } else { "rawKeyDown" })).s("key", name.copy()).i("windowsVirtualKeyCode", code)
        if typed.len() > 0 { down = down.s("text", typed.copy()) }
        _ = try w.call("Input.dispatchKeyEvent", down.done())
        _ = try w.call("Input.dispatchKeyEvent", Obj.new().s("type", String("keyUp")).s("key", name).i("windowsVirtualKeyCode", code).done())
    }

    // A call, on a browser started for it if it isn't open. One started again
    // after it closed opens the page it was on first, unless the call opens
    // another, and the result says so.
    fn op(w: mut Worker, name: String, args: Json) -> Json ! Error {
        // What the page did before this call isn't what settle waits on.
        w.navigating = false
        w.loaded = false
        var note = String()
        if w.page == none {
            let gaps = try w.open_browser()
            if env.os() == "linux" and not w.told_fonts {
                w.told_fonts = true
                if gaps.len() > 0 { eprintln("loom: {missing_text(gaps)}") }
                // Without any font, a picture of a page has no words in it, though its outline does.
                if gaps.len() > 0 and gaps[0] == "fonts" { note = "[loom: {missing_text(gaps)} Until then, pictures of pages show no text: read pages with browser_snapshot.]" }
            }
            let back_to = w.reopen.copy()
            w.reopen = String()
            if name != "open" and name != "preview" and back_to.len() > 0 and refused(back_to.copy(), w.guarded) == none {
                let r = try w.call("Page.navigate", Obj.new().s("url", back_to.copy()).done())
                if str_at(r, "errorText") == none {
                    w.settle()
                    let again = "[loom: Your browser had closed since you last used it, so it opened {back_to} again, where you were. Refs from before are gone: take them from a new outline.]"
                    note = if note.len() > 0 { "{note}\n{again}" } else { again }
                }
            }
        }
        let result = match w.act(name, args) {
            ok(r) => r,
            err(e) => {
                if note.len() == 0 { fail "{e}" }
                error("{note}\n\n{e}")
            },
        }
        return noted(result, note)
    }

    fn act(w: mut Worker, name: String, args: Json) -> Json ! Error {
        if name == "open" {
            let url = (str_at(args, "url") ?? String()).trim().copy()
            if let why = refused(url.copy(), w.guarded) { return error(why) }
            let r = try w.call("Page.navigate", Obj.new().s("url", url.copy()).done())
            if let failed = str_at(r, "errorText") { return error("Couldn't open {url}: {failed}.") }
            w.settle()
            return text(try w.outline())
        }
        if name == "snapshot" { return text(try w.outline()) }
        if name == "click" {
            let id = try w.node(args)
            let (x, y) = try w.middle(id)
            try w.mouse("mouseMoved", x, y, Obj.new())
            try w.mouse("mousePressed", x, y, Obj.new().s("button", String("left")).i("clickCount", 1))
            try w.mouse("mouseReleased", x, y, Obj.new().s("button", String("left")).i("clickCount", 1))
            w.settle()
            return text(try w.outline())
        }
        if name == "type" {
            let id = try w.node(args.copy())
            _ = try w.call("DOM.focus", Obj.new().i("backendNodeId", id).done())
            if bool_at(args.copy(), "clear") ?? true {
                let found = try w.call("DOM.resolveNode", Obj.new().i("backendNodeId", id).done())
                let object = str_at(at(found, "object"), "objectId") ?? String()
                _ = try w.call("Runtime.callFunctionOn", Obj.new().s("objectId", object).s("functionDeclaration", String(SELECT_ALL)).done())
            }
            let what = str_at(args.copy(), "text") ?? String()
            if what.len() > 0 {
                _ = try w.call("Input.insertText", Obj.new().s("text", what).done())
            } else {
                try w.press_key(String("Backspace"))
            }
            if bool_at(args, "submit") ?? false {
                try w.press_key(String("Enter"))
                w.settle()
                return text(try w.outline())
            }
            return text(String("Typed."))
        }
        // A secret, typed into a field without the agent seeing it. With
        // `hosts`, only on a page of one of them; otherwise the result names
        // the host it needs (`needs`), for the person's yes.
        if name == "fill" {
            let label = str_at(args.copy(), "name") ?? String()
            let value = str_at(args.copy(), "value") ?? String()
            if let Json.Array(hosts) = at(args.copy(), "hosts") {
                let here = try w.host()
                if not hosts.contains(Json.Str(here.copy())) { return Obj.new().s("needs", here).done() }
            }
            let id = try w.node(args.copy())
            _ = try w.call("DOM.focus", Obj.new().i("backendNodeId", id).done())
            let found = try w.call("DOM.resolveNode", Obj.new().i("backendNodeId", id).done())
            _ = try w.call("Runtime.callFunctionOn", Obj.new().s("objectId", str_at(at(found, "object"), "objectId") ?? String()).s("functionDeclaration", String(SELECT_ALL)).done())
            if not w.hidden.contains((value.copy(), label.copy())) { w.hidden.push((value.copy(), label.copy())) }
            _ = try w.call("Input.insertText", Obj.new().s("text", value).done())
            if bool_at(args, "submit") ?? false {
                try w.press_key(String("Enter"))
                w.settle()
                return text("Filled in {label}, and submitted.\n\n{try w.outline()}")
            }
            return text("Filled in {label}.")
        }
        if name == "press" {
            try w.press_key(str_at(args, "key") ?? String())
            w.settle()
            return text(try w.outline())
        }
        if name == "scroll" {
            let down = str_at(args, "direction") != some(String("up"))
            try w.mouse("mouseWheel", 640.0, 400.0, Obj.new().j("deltaX", Json.Float(0.0)).j("deltaY", Json.Float(if down { 600.0 } else { -600.0 })))
            return text(String("Scrolled."))
        }
        if name == "back" {
            let h = try w.call("Page.getNavigationHistory", Obj.new().done())
            let k = int_at(h.copy(), "currentIndex") ?? 0
            if k <= 0 { return error(String("There's no page to go back to.")) }
            let entry = at(h, "entries").at(usize.wrap(k - 1)) ?? Json.Null
            _ = try w.call("Page.navigateToHistoryEntry", Obj.new().i("entryId", int_at(entry, "id") ?? 0).done())
            w.settle()
            return text(try w.outline())
        }
        // browser_ask_person's answer, once the person hands the browser back.
        if name == "handed_back" {
            let actions = int_at(args, "actions") ?? 0
            let did = if actions == 0 { String("without doing anything in it") } else if actions == 1 { String("after one click or key") } else { "after {actions} clicks and keys" }
            return text("Your person handed the browser back {did}. Take it from here.\n\n{try w.outline()}")
        }
        if name == "screenshot" {
            let shot = try w.call("Page.captureScreenshot", Obj.new().s("format", String("jpeg")).i("quality", 70).done())
            let image = Obj.new().s("type", String("image")).s("data", str_at(shot, "data") ?? String()).s("mimeType", String("image/jpeg")).done()
            return Obj.new().j("content", Json.Array([image, Obj.new().s("type", String("text")).s("text", "Page: {try w.where()}").done()])).done()
        }
        // html_preview: the page drawn in a tab of its own, so the one the agent
        // has open stays as it was, and the tab closed once its picture is taken.
        if name == "preview" {
            let html = str_at(args.copy(), "html") ?? String()
            if html.trim().len() == 0 { return error(String("html is empty: give the whole page.")) }
            if html.len() > HTML_MOST { return error("The page is {html.len()} bytes, and html_preview takes {HTML_MOST} at most.") }
            let width = (int_at(args.copy(), "width") ?? 1280).max(200).min(3840)
            let height = (int_at(args.copy(), "height") ?? 800).max(200).min(2400)
            let made = try w.call("Target.createTarget", Obj.new().s("url", String("about:blank")).b("background", true).done())
            let target = str_at(made, "targetId") ?? String()
            if target.len() == 0 { fail "The browser didn't open a tab for the page." }
            let drawn = match w.preview(target.copy(), html, width, height, bool_at(args, "full_page") ?? false) {
                ok(r) => r,
                err(e) => error("{e}"),
            }
            if let err(e) = w.call("Target.closeTarget", Obj.new().s("targetId", target).done()) { eprintln("loom: the browser: {e}") }
            // The agent's page in front again, so it draws, and sends frames to whoever watches.
            if let err(e) = w.call("Page.bringToFront", Obj.new().done()) { eprintln("loom: the browser: {e}") }
            return drawn
        }
        return error("The browser has no {name}.")
    }

    fn preview(w: Worker, target: String, html: String, width: i64, height: i64, full_page: bool) -> Json ! Error {
        var t = Tab { sock: try connect("ws://127.0.0.1:{w.port}/devtools/page/{target}"), next_id: 0, said: List<String>() }
        for domain in ["Page", "Runtime", "Log"] { _ = try t.call("{domain}.enable", Obj.new().done()) }
        if w.guarded {
            var blocked = List<Json>()
            for p in guarded_patterns() { blocked.push(Json.Str(p.copy())) }
            _ = try t.call(String("Network.enable"), Obj.new().done())
            _ = try t.call(String("Network.setBlockedURLs"), Obj.new().j("urls", Json.Array(blocked)).done())
        }
        _ = try t.call(String("Emulation.setDeviceMetricsOverride"), Obj.new().i("width", width).i("height", height).i("deviceScaleFactor", 1).b("mobile", false).done())
        let tree = try t.call(String("Page.getFrameTree"), Obj.new().done())
        let frame = str_at(at(at(tree, "frameTree"), "frame"), "id") ?? String()
        _ = try t.call(String("Page.setDocumentContent"), Obj.new().s("frameId", frame).s("html", html).done())
        t.settle()
        var shot_args = Obj.new().s("format", String("jpeg")).i("quality", 80)
        var size = "{width} × {height}"
        if full_page {
            let metrics = try t.call(String("Page.getLayoutMetrics"), Obj.new().done())
            let tall = (at(at(metrics, "cssContentSize"), "height").as_f64() ?? f64.nearest(height)).max(f64.nearest(height)).min(FULL_PAGE_MOST)
            shot_args = shot_args.b("captureBeyondViewport", true).j("clip", Obj.new().i("x", 0).i("y", 0).i("width", width).j("height", Json.Float(tall)).i("scale", 1).done())
            size = "{width} × {i64.saturate(tall)}, the whole page"
        }
        // A tab in the background draws no frames, or only now and then, and a picture
        // waits for one: seconds, or past CALL_MS. In front, it draws at once.
        _ = try t.call(String("Page.bringToFront"), Obj.new().done())
        let shot = try t.call(String("Page.captureScreenshot"), shot_args.done())
        t.sock.close()
        let image = Obj.new().s("type", String("image")).s("data", str_at(shot, "data") ?? String()).s("mimeType", String("image/jpeg")).done()
        var said = if t.said.len() == 0 { String("Its console said nothing.") } else { "Its console said:\n{t.said.join("\n")}" }
        if t.said.len() >= SAID_MOST { said.push_str("\n(It said more after that.)") }
        return Obj.new().j("content", Json.Array([image, Obj.new().s("type", String("text")).s("text", "The page, at {size}. {said}").done()])).done()
    }
}

// How big a page html_preview takes, and how tall a picture of a whole page
// gets.
pub const HTML_MOST: usize = 2097152
const FULL_PAGE_MOST: f64 = 16000.0
// How many lines of a preview's console go to the agent.
const SAID_MOST: usize = 50

// html_preview's tab, while it draws the page: what its console says is kept
// as it comes.
struct Tab {
    sock: WebSocket
    next_id: i64
    said: List<String>
}

impl Tab {
    fn call(t: mut Tab, method: String, params: Json) -> Json ! Error {
        t.next_id += 1
        let id = t.next_id
        try t.sock.send_text("{Obj.new().i("id", id).s("method", method.copy()).j("params", params).done()}")
        let until = now() + CALL_MS
        loop {
            let left = until - now()
            if left <= 0 { fail "The browser didn't answer {method} in time." }
            let m = try t.sock.receive(u32.wrap(left)) else continue
            let Message.Text(said) = m else continue
            let reply = try parse(said)
            if let event = str_at(reply.copy(), "method") {
                t.heard(event, at(reply, "params"))
                continue
            }
            if int_at(reply.copy(), "id") != some(id) { continue }
            if let e = reply.get(String("error")) { fail "{str_at(e, "message") ?? String("The browser refused it.")}" }
            return at(reply, "result")
        }
    }

    // Waits for the page to load, and a moment more for what its scripts draw.
    fn settle(t: mut Tab) {
        let until = now() + LOAD_MS
        while now() < until {
            match t.call(String("Runtime.evaluate"), Obj.new().s("expression", String("document.readyState")).b("returnByValue", true).done()) {
                ok(r) => if str_at(at(r, "result"), "value") == some(String("complete")) { break },
                err(_) => {},
            }
            unsafe { sleep(100000000) }
        }
        unsafe { sleep(300000000) }
        // What was said meanwhile comes with the answer to a last call.
        match t.call(String("Runtime.evaluate"), Obj.new().s("expression", String("0")).done()) {
            ok(_) => {},
            err(_) => {},
        }
    }

    fn heard(t: mut Tab, event: String, p: Json) {
        if t.said.len() >= SAID_MOST { return }
        if let line = console_line(event, p) { t.said.push(short(line, 400)) }
    }
}

// A line of what a page's console said, from a DevTools event: a log, an
// error thrown, or the browser's own word, as a request that failed.
pub fn console_line(event: String, p: Json) -> String? {
    if event == "Runtime.consoleAPICalled" {
        var parts = List<String>()
        if let Json.Array(args) = at(p.copy(), "args") {
            for a in args {
                if let s = str_at(a.copy(), "value") {
                    parts.push(s)
                } else if let v = a.get(String("value")) {
                    parts.push("{v}")
                } else {
                    parts.push(str_at(a.copy(), "description") ?? str_at(a, "type") ?? String())
                }
            }
        }
        return some("{str_at(p, "type") ?? String("log")}: {parts.join(" ")}")
    }
    if event == "Runtime.exceptionThrown" {
        let d = at(p, "exceptionDetails")
        let what = str_at(at(d.copy(), "exception"), "description") ?? str_at(d.copy(), "text") ?? String("An error")
        return some("error, line {(int_at(d, "lineNumber") ?? 0) + 1}: {what}")
    }
    if event == "Log.entryAdded" {
        let e = at(p, "entry")
        let place = str_at(e.copy(), "url") ?? String()
        let said = "{str_at(e.copy(), "level") ?? String("info")}: {str_at(e, "text") ?? String()}"
        return some(if place.len() > 0 { "{said} ({place})" } else { said })
    }
    return none
}

// How many steps a recording keeps, and how long a step's text gets.
pub const STEPS_MOST: usize = 300
const STEP_TEXT_MOST: usize = 500

// Names the part of the page an element is in, as an outline would: its role,
// its name, and whether it takes a secret (a password or a one-time code).
const DESCRIBE: str = #"
function(e) {
  if (!e) return null;
  const pick = (e.closest && e.closest('a,button,input,select,textarea,label,summary,[role],[contenteditable],[onclick]')) || e;
  const tag = (pick.tagName || '').toLowerCase();
  const type = (pick.getAttribute && pick.getAttribute('type') || '').toLowerCase();
  const roles = {a: 'link', button: 'button', select: 'combobox', textarea: 'textbox', summary: 'button', label: 'label'};
  let role = pick.getAttribute && pick.getAttribute('role') || roles[tag] || '';
  if (!role && tag === 'input') role = type === 'submit' || type === 'button' ? 'button' : (type === 'checkbox' || type === 'radio' ? type : 'textbox');
  if (!role && pick.isContentEditable) role = 'textbox';
  if (!role) role = 'text';
  const attr = (n) => (pick.getAttribute && pick.getAttribute(n)) || '';
  let name = attr('aria-label');
  if (!name && pick.labels && pick.labels.length) name = pick.labels[0].innerText;
  if (!name) name = attr('placeholder') || attr('title') || attr('alt');
  if (!name && (type === 'submit' || type === 'button')) name = pick.value || '';
  if (!name && tag !== 'input' && tag !== 'textarea') name = pick.innerText || '';
  if (!name) name = attr('name');
  const auto = attr('autocomplete').toLowerCase();
  const secret = type === 'password' || auto.includes('password') || auto.includes('one-time-code');
  return {role: role, name: String(name).replace(/\s+/g, ' ').trim(), secret: secret};
}
"#

// A recording's steps, as the agent reads them to write a skill: one line
// each, numbered.
pub fn steps_text(steps: Json) -> String {
    var lines = List<String>()
    let Json.Array(list) = steps else return String()
    for s in list {
        let kind = str_at(s.copy(), "kind") ?? String()
        var line = String()
        if kind == "page" {
            line = "On the page {str_at(s.copy(), "title") ?? String()} ({str_at(s, "url") ?? String()})"
        } else if kind == "click" {
            line = "Clicked {str_at(s, "on") ?? String()}"
        } else if kind == "type" {
            let into = str_at(s.copy(), "into") ?? String()
            line = if bool_at(s.copy(), "secret") == some(true) { "Typed something secret into {into} (it isn't kept)" } else { "Typed \"{str_at(s, "text") ?? String()}\" into {into}" }
        } else if kind == "key" {
            line = "Pressed {str_at(s, "key") ?? String()}"
        } else if kind == "scroll" {
            line = "Scrolled {str_at(s, "direction") ?? String()}"
        }
        if line.len() > 0 { lines.push("{lines.len() + 1}. {line}") }
    }
    return lines.join("\n")
}

// Selects what an element holds, so typing replaces it.
const SELECT_ALL: str = "function() \{ if (this.select) \{ this.select(); return; \} const r = document.createRange(); r.selectNodeContents(this); const s = getSelection(); s.removeAllRanges(); s.addRange(r); \}"

// A key's Windows virtual key code, which Chrome goes by, and the text it types.
fn key_code(name: String) -> (i64, String)? {
    let named: List<(str, i64, str)> = [("Enter", 13, "\r"), ("Tab", 9, ""), ("Escape", 27, ""), ("Backspace", 8, ""), ("Delete", 46, ""), ("ArrowUp", 38, ""), ("ArrowDown", 40, ""), ("ArrowLeft", 37, ""), ("ArrowRight", 39, ""), ("Home", 36, ""), ("End", 35, ""), ("PageUp", 33, ""), ("PageDown", 34, ""), ("Space", 32, " ")]
    for (n, code, typed) in named {
        if name == n { return some((code, String(typed))) }
    }
    var count = 0
    var code: i64 = 0
    for r in name.to_upper_root().runes() {
        count += 1
        if (r >= 'A' and r <= 'Z') or (r >= '0' and r <= '9') { code = i64(u32(r)) }
    }
    if count != 1 { return none }
    return some((code, name.copy()))
}

// What a guarded browser loads nothing from: files, the computer itself, and
// the private networks it may be on. Chrome matches them against each request's
// address as it writes it, so 2130706433 is 127.0.0.1 here too.
fn guarded_patterns() -> List<String> {
    var p: List<String> = ["file:*", "*://localhost/*", "*://localhost:*", "*://*.localhost/*", "*://*.localhost:*", "*://127.*", "*://0.*", "*://10.*", "*://192.168.*", "*://169.254.*", "*://[*"]
    for n in 16..32 { p.push("*://172.{n}.*") }
    return p
}

// An address's host and port, lowercase, without who's logged in: what a
// secret is allowed for. "" for a file or a page with none.
pub fn host_of(url: String) -> String {
    let (_, rest) = url.split_once("://") ?? (String(), String())
    var host = rest.copy()
    for end in ["/", "?", "#"] {
        if let k = host.find(end) { host = host[..k].copy() }
    }
    if let k = host.find_last("@") { host = host[k + 1..].copy() }
    return host.to_lower_root()
}

// Why the browser won't open `url`, or none if it will. Every browser opens
// web pages; a guarded one opens nothing else.
pub fn refused(url: String, guarded: bool) -> String? {
    if url.len() == 0 { return some(String("url is empty.")) }
    let lower = url.to_lower_root()
    let web = lower.starts_with("http://") or lower.starts_with("https://")
    if guarded and not web { return some(String("The browser opens only http and https pages.")) }
    if not web and not lower.starts_with("file:") and not lower.starts_with("about:") { return some(String("The browser opens http, https, file and about pages.")) }
    return none
}

// The accessibility tree DevTools gives, as an outline: a line for each part
// of the page that means something, indented under what it's in, each that can
// be acted on with a ref. `refs` gets the node each ref is.
pub fn outline_of(nodes: List<Json>, refs: mut Map<String, i64>) -> String {
    var index = Map<String, usize>()
    for (k, n) in nodes.enumerate() {
        if let id = str_at(n, "nodeId") { index.insert(id, k) }
    }
    var lines = List<String>()
    if nodes.len() > 0 { walk(nodes, index, 0, 0, String(), mut lines, mut refs) }
    return lines.join("\n")
}

// Roles that only hold other parts, shown only when they're named.
const PLAIN: str = " generic none presentation group LayoutTable LayoutTableRow LayoutTableCell section Section paragraph div ListMarker "
// Roles whose words are what's in them, said by the text under them already.
const SAID: str = " InlineTextBox LineBreak "

fn walk(nodes: List<Json>, index: Map<String, usize>, k: usize, depth: usize, parent_name: String, lines: mut List<String>, refs: mut Map<String, i64>) {
    let role = str_at(at(nodes[k], "role"), "value") ?? String()
    let name = (str_at(at(nodes[k], "name"), "value") ?? String()).trim().copy()
    let ignored = bool_at(nodes[k], "ignored") ?? false
    var shown = not ignored and role != "RootWebArea" and not SAID.contains(" {role} ")
    if shown and PLAIN.contains(" {role} ") and name.len() == 0 { shown = false }
    if shown and role == "StaticText" and (name.len() == 0 or name == parent_name) { shown = false }
    var inner = depth
    var named = parent_name.copy()
    if shown {
        var line = "{"  ".repeat(depth)}- "
        if role == "StaticText" {
            line.push_str("text \"{short(name.copy(), 300)}\"")
        } else {
            line.push_str(role.copy())
            if name.len() > 0 { line.push_str(" \"{short(name.copy(), 200)}\"") }
            if let value = str_at(at(nodes[k], "value"), "value") {
                if value.len() > 0 { line.push_str(": {short(value, 200)}") }
            }
            line.push_str(states(at(nodes[k], "properties")))
            if let backend = int_at(nodes[k], "backendDOMNodeId") {
                let r = "e{refs.len() + 1}"
                line.push_str(" [ref={r}]")
                refs.insert(r, backend)
            }
        }
        lines.push(line)
        inner = depth + 1
        named = name.copy()
    }
    if let Json.Array(children) = at(nodes[k], "childIds") {
        for c in children {
            if let id = c.as_str() {
                if let child = index.get(id) { walk(nodes, index, child, inner, named.copy(), mut lines, mut refs) }
            }
        }
    }
}

// The states of a node worth saying: checked, disabled and so on.
fn states(properties: Json) -> String {
    var out = String()
    let Json.Array(list) = properties else return out
    for p in list {
        let name = str_at(p.copy(), "name") ?? String()
        let value = at(at(p, "value"), "value")
        if name == "checked" or name == "pressed" or name == "selected" or name == "expanded" {
            if value == Json.Str(String("true")) or value == Json.Bool(true) { out.push_str(" [{name}]") }
            if name == "checked" and value == Json.Str(String("mixed")) { out.push_str(" [mixed]") }
        }
        if (name == "disabled" or name == "required") and value == Json.Bool(true) { out.push_str(" [{name}]") }
        if name == "level" {
            if let l = value.as_i64() { out.push_str(" [level={l}]") }
        }
    }
    return out
}

fn short(t: String, most: usize) -> String {
    let one = t.replace("\n", " ")
    if one.len() <= most { return one }
    var cut = String()
    for r in one.runes() {
        if cut.len() >= most { break }
        cut.push(r)
    }
    cut.push_str("…")
    return cut
}

@test
fn outlines_a_page() {
    let tree = parse(#"
        {"nodes":[
        {"nodeId":"1","ignored":false,"role":{"value":"RootWebArea"},"name":{"value":"Shop"},"childIds":["2","3","6"],"backendDOMNodeId":1},
        {"nodeId":"2","ignored":false,"role":{"value":"heading"},"name":{"value":"Welcome"},"properties":[{"name":"level","value":{"type":"integer","value":1}}],"childIds":["7"],"backendDOMNodeId":5},
        {"nodeId":"7","ignored":false,"role":{"value":"StaticText"},"name":{"value":"Welcome"},"childIds":[]},
        {"nodeId":"3","ignored":false,"role":{"value":"generic"},"name":{"value":""},"childIds":["4","5"],"backendDOMNodeId":8},
        {"nodeId":"4","ignored":false,"role":{"value":"textbox"},"name":{"value":"Search"},"value":{"value":"socks"},"childIds":[],"backendDOMNodeId":9},
        {"nodeId":"5","ignored":false,"role":{"value":"checkbox"},"name":{"value":"In stock"},"properties":[{"name":"checked","value":{"type":"tristate","value":"true"}}],"childIds":[],"backendDOMNodeId":10},
        {"nodeId":"6","ignored":true,"role":{"value":"none"},"childIds":["8"]},
        {"nodeId":"8","ignored":false,"role":{"value":"StaticText"},"name":{"value":"Free returns"},"childIds":[]}
    ]}
    "#)!
    let Json.Array(nodes) = at(tree, "nodes") else return
    var refs = Map<String, i64>()
    let t = outline_of(nodes, mut refs)
    assert(t == "- heading \"Welcome\" [level=1] [ref=e1]\n- textbox \"Search\": socks [ref=e2]\n- checkbox \"In stock\" [checked] [ref=e3]\n- text \"Free returns\"")
    assert(refs.get(String("e2")) == some(9))
    assert(refs.len() == 3)
}

@test
fn a_guarded_browser_opens_only_the_web() {
    assert(refused(String("https://example.com"), true) == none)
    assert(refused(String("file:///etc/passwd"), true) != none)
    assert(refused(String("file:///C:/notes.txt"), false) == none)
    assert(refused(String("javascript:alert(1)"), false) != none)
    assert(refused(String(""), false) != none)
    assert(guarded_patterns().len() == 27)
}

@test
fn hosts_are_what_a_secret_is_for() {
    assert(host_of(String("https://Example.com/login?next=/")) == "example.com")
    assert(host_of(String("http://me:pw@localhost:8080#top")) == "localhost:8080")
    assert(host_of(String("file:///C:/x.html")) == "")
    assert(host_of(String("about:blank")) == "")
}

@test
fn steps_read_as_lines() {
    let steps = parse(#"[{"kind":"page","title":"Shop","url":"https://shop.example"},{"kind":"click","on":"link \"Socks\""},{"kind":"type","into":"textbox \"Search\"","text":"wool"},{"kind":"type","into":"textbox \"Password\"","secret":true},{"kind":"key","key":"Enter"},{"kind":"scroll","direction":"down"}]"#)!
    let t = steps_text(steps)
    assert(t == "1. On the page Shop (https://shop.example)\n2. Clicked link \"Socks\"\n3. Typed \"wool\" into textbox \"Search\"\n4. Typed something secret into textbox \"Password\" (it isn't kept)\n5. Pressed Enter\n6. Scrolled down")
}

@test
fn fonts_say_what_is_missing() {
    let full: List<String> = ["# all", "DejaVu Sans", "Noto Sans CJK SC", "Noto Color Emoji", "# lang=zh", "Noto Sans CJK SC", "# emoji", "Noto Color Emoji"]
    assert(font_gaps(full).len() == 0)
    let plain: List<String> = ["# all", "DejaVu Sans", "Liberation Serif", "# lang=zh", "# emoji"]
    let gaps = font_gaps(plain)
    assert(gaps.len() == 2 and gaps[0] == "fonts for Chinese, Japanese and Korean" and gaps[1] == "an emoji font")
    let none_at_all: List<String> = ["# all", "# lang=zh", "# emoji"]
    assert(font_gaps(none_at_all) == [String("fonts")])
    assert(font_gaps(List<String>()) == [String("fonts")])
    // Without fontconfig, by the files' names.
    let files: List<String> = ["file /usr/share/fonts/truetype/noto/NotoColorEmoji.ttf", "file /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"]
    assert(font_gaps(files).len() == 0)
    assert(missing_text([String("a browser"), String("fonts")]).starts_with("This server lacks a browser and fonts for its browser."))
}

@test
fn only_pages_are_opened_again() {
    assert(kept_page(String("https://example.com/a")) and kept_page(String("file:///tmp/x.html")))
    assert(not kept_page(String("about:blank")) and not kept_page(String("chrome-error://chromewebdata/")))
    let r = noted(text(String("Page: Shop")), String("[loom: again]"))
    assert("{r}" == #"{"content":[{"type":"text","text":"[loom: again]"},{"type":"text","text":"Page: Shop"}]}"#)
    assert(noted(text(String("x")), String()) == text(String("x")))
}

@test
fn frames_are_asked_for_at_the_size_they_are_shown() {
    assert(frame_size(0, 0) == (PAGE_WIDTH, PAGE_HEIGHT))
    assert(frame_size(420, 263) == (420i64, 263i64))
    assert(frame_size(2560, 1600) == (PAGE_WIDTH, PAGE_HEIGHT))
    assert(frame_size(10, 6) == (FRAME_LEAST, FRAME_LEAST))
}

@test
fn keys_have_codes() {
    assert(key_code(String("Enter")) == some((13, String("\r"))))
    assert(key_code(String("a")) == some((65, String("a"))))
    assert(key_code(String("Banana")) == none)
}
