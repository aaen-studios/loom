module server.links

// Links in the chat (PLAN.md, "Links and sources"): the addresses in a
// message, the Sources list at the end of an agent's reply, which comes out
// of its text and goes under the reply as a tab, and each page's title and
// its site's icon, which the instance looks up so the apps show a link by
// its page and its site.
//
// Pages are looked up only over https, on a thread of their own, as the
// person's agents could name any address. A redirect never leaves https, so
// a lookup reaches only a host with a certificate for its name: not the
// person's router, their other computers or the instance itself. An address
// of a network of the person's own, or a name only it knows, isn't looked
// up at all.
import std.json.{Json, parse}
import std.http.{Header, get}
import std.net.{Ip}
import std.thread.{Task}
import std.text.utf8.{decode_lossy}
import std.url.{Url, decode, encode}
import shared.obj.{Obj, str_at}
import server.files

// The most links in one message that are looked up.
pub const MOST: usize = 12
// The most of a page that's read for its title, and how long it's waited for.
const PAGE_MOST: usize = 2097152
const ICON_MOST: usize = 262144
// The most of a page's preview picture that's read.
const PICTURE_MOST: usize = 4194304
// The most of an oEmbed answer that's read.
const EMBED_MOST: usize = 65536
const WAIT_MS: u32 = 6000
// The longest title kept.
const TITLE_MOST: usize = 160

// --- What's in a message ---

fn rune_len(r: rune) -> usize {
    let n = u32(r)
    return if n < 0x80 { 1 } else if n < 0x800 { 2 } else if n < 0x10000 { 3 } else { 4 }
}

fn url_end(r: rune) -> bool {
    return r == ' ' or r == '\n' or r == '\t' or r == '\r' or r == '<' or r == '>' or r == '"' or r == '`'
}

// An address as it's written in text, without what usually ends a sentence
// after it: a full stop, a comma, a closing bracket it didn't open.
fn trimmed(raw: String) -> String {
    var s = raw.copy()
    loop {
        if s.len() == 0 { break }
        let last = s[s.len() - 1..].copy()
        if ".,;:!?'*_".contains(last.copy()) {
            s = s[..s.len() - 1].copy()
            continue
        }
        if last == ")" and s.split("(").len() <= s.split(")").len() - 1 {
            s = s[..s.len() - 1].copy()
            continue
        }
        break
    }
    return s
}

/// The http and https addresses in `text`, in the order they come, each once:
/// a Markdown link's and a bare one's.
pub fn urls_in(text: String) -> List<String> {
    var out = List<String>()
    var rest = text.copy()
    loop {
        let a = rest.find("http://")
        let b = rest.find("https://")
        let at = match (a, b) {
            (some(x), some(y)) => if x < y { x } else { y },
            (some(x), none) => x,
            (none, some(y)) => y,
            (none, none) => break,
        }
        var end = at
        for r in rest[at..].runes() {
            if url_end(r) { break }
            end += rune_len(r)
        }
        let url = trimmed(rest[at..end].copy())
        if url.len() > 8 and not out.contains(url.copy()) { out.push(url) }
        rest = rest[end..].copy()
    }
    return out
}

/// The site an address is on, as it's shown: its host without `www.`.
pub fn site_of(url: String) -> String {
    let u = match Url.parse(url) {
        ok(x) => x,
        err(_) => return String(),
    }
    let host = u.host ?? String()
    return if host.starts_with("www.") { host[4..].copy() } else { host }
}

// A Sources list's item: `- [title](url)`, `- title: url`, `- url`, or a
// numbered one. Gives the source, or none for a line that isn't one.
fn source_line(line: String) -> Json? {
    var s = line.trim().copy()
    if s.starts_with("- ") or s.starts_with("* ") or s.starts_with("• ") {
        s = s[s.find(" ")! + 1..].trim().copy()
    } else {
        var digits: usize = 0
        for r in s.runes() {
            if r >= '0' and r <= '9' { digits += 1 } else { break }
        }
        if digits > 0 and (s[digits..].starts_with(". ") or s[digits..].starts_with(") ")) { s = s[digits + 2..].trim().copy() }
    }
    if s.starts_with("[") {
        let close = s.find("](") else return none
        let rest = s[close + 2..].copy()
        let end = rest.find(")") else return none
        let url = rest[..end].trim().copy()
        if not url.starts_with("https://") and not url.starts_with("http://") { return none }
        return some(Obj.new().s("url", url.copy()).s("title", s[1..close].trim().copy()).s("site", site_of(url)).done())
    }
    let urls = urls_in(s.copy())
    if urls.len() != 1 { return none }
    let url = urls[0].copy()
    var title = s.replace(url.copy(), String()).trim().copy()
    while title.ends_with(":") or title.ends_with("-") or title.ends_with("–") or title.ends_with("—") {
        title = title[..title.len() - if title.ends_with(":") or title.ends_with("-") { 1usize } else { 3usize }].trim().copy()
    }
    return some(Obj.new().s("url", url.copy()).s("title", title).s("site", site_of(url)).done())
}

// Whether `line` heads a Sources list: "Sources", "Sources:", "**Sources**",
// "## Sources", and the same for "Source" and "References".
fn sources_heading(line: String) -> bool {
    var s = line.trim().to_lower_root()
    while s.starts_with("#") { s = s[1..].trim().copy() }
    s = s.replace(String("*"), String()).replace(String("_"), String()).trim().copy()
    if s.ends_with(":") { s = s[..s.len() - 1].trim().copy() }
    return s == "sources" or s == "source" or s == "references" or s == "kilder"
}

/// A reply's text without the Sources list at its end, and the sources in
/// it, each `{url, title, site}`. A list that has anything but links under
/// its heading, or isn't at the end, stays in the text.
pub fn split_sources(text: String) -> (String, List<Json>) {
    let lines = text.split("\n")
    var k = lines.len()
    // Past the blank lines at the end.
    while k > 0 and lines[k - 1].trim().len() == 0 { k -= 1 }
    var found = List<Json>()
    while k > 0 {
        let line = lines[k - 1].copy()
        if line.trim().len() == 0 {
            k -= 1
            continue
        }
        if sources_heading(line.copy()) {
            if found.len() == 0 { return (text.copy(), List<Json>()) }
            var kept = List<String>()
            for l in lines[..k - 1] { kept.push(l.copy()) }
            var sources = List<Json>()
            var k2 = found.len()
            while k2 > 0 {
                sources.push(found[k2 - 1].copy())
                k2 -= 1
            }
            return (kept.join("\n").trim_end().copy(), sources)
        }
        let source = source_line(line) else return (text.copy(), List<Json>())
        found.push(source)
        k -= 1
    }
    return (text.copy(), List<Json>())
}

// --- Which pages are looked up ---

// A name only the person's own network knows: one with no dot, or under a
// name kept for local networks.
fn local_name(host: String) -> bool {
    if not host.contains(".") { return true }
    for end in [".local", ".localhost", ".lan", ".home", ".internal", ".intranet", ".corp", ".home.arpa", ".test", ".invalid", ".example"] {
        if host.ends_with(end) { return true }
    }
    return false
}

/// Whether the page at `url` is looked up: an https address of a public
/// host, by its name, on the usual port.
pub fn lookable(url: String) -> bool {
    let u = match Url.parse(url) {
        ok(x) => x,
        err(_) => return false,
    }
    if u.scheme != "https" { return false }
    if let _ = u.user { return false }
    if let port = u.port {
        if port != 443 { return false }
    }
    let host = (u.host ?? String()).trim_suffix(".").copy()
    if host.len() == 0 or local_name(host.copy()) { return false }
    // An address, not a name: only a name has a certificate a stranger can't fake.
    if Ip.parse(host) != none { return false }
    return true
}

// --- A page's title and icon ---

fn entity(name: String) -> String? {
    let named = [("amp", "&"), ("lt", "<"), ("gt", ">"), ("quot", "\""), ("apos", "'"), ("nbsp", " "), ("ndash", "–"), ("mdash", "—"), ("hellip", "…"), ("rsquo", "’"), ("lsquo", "‘"), ("ldquo", "“"), ("rdquo", "”")]
    for (n, v) in named {
        if name == n { return some(String(v)) }
    }
    if not name.starts_with("#") { return none }
    let hex = name.starts_with("#x") or name.starts_with("#X")
    let digits = if hex { name[2..].copy() } else { name[1..].copy() }
    let code = (if hex { u32.parse_radix(digits, 16) } else { u32.parse(digits) }) else return none
    let r = rune.try_from(code) else return none
    var one = String()
    one.push(r)
    return some(one)
}

// Text from HTML: its entities read, and its white space one space.
fn text_of(html: String) -> String {
    var out = String()
    var rest = html.copy()
    loop {
        let amp = rest.find("&") else {
            out.push_str(rest.copy())
            break
        }
        out.push_str(rest[..amp].copy())
        let after = rest[amp + 1..].copy()
        if let semi = after.find(";") {
            if semi <= 10 {
                if let e = entity(after[..semi].copy()) {
                    out.push_str(e)
                    rest = after[semi + 1..].copy()
                    continue
                }
            }
        }
        out.push_str(String("&"))
        rest = after
    }
    var spaced = String()
    var space = false
    for r in out.runes() {
        if r == ' ' or r == '\n' or r == '\t' or r == '\r' {
            space = true
            continue
        }
        if space and spaced.len() > 0 { spaced.push_str(String(" ")) }
        space = false
        spaced.push(r)
    }
    return spaced
}

// An attribute's value in a tag, as `name="v"`, `name='v'` or `name=v`.
fn attr(tag: String, name: str) -> String? {
    let low = tag.to_lower_root()
    var from: usize = 0
    loop {
        let at = low[from..].find(name) else return none
        let k = from + at
        from = k + name.len()
        // The name stands alone: a space before it, and = after.
        if k == 0 or not " \t\n\r".contains(low[k - 1..k].copy()) { continue }
        var rest = tag[k + name.len()..].trim_start().copy()
        if not rest.starts_with("=") { continue }
        rest = rest[1..].trim_start().copy()
        if rest.starts_with("\"") or rest.starts_with("'") {
            let q = rest[..1].copy()
            let end = rest[1..].find(q) else return none
            return some(rest[1..end + 1].copy())
        }
        var end: usize = 0
        for r in rest.runes() {
            if r == ' ' or r == '>' or r == '/' or r == '\t' or r == '\n' { break }
            end += rune_len(r)
        }
        return some(rest[..end].copy())
    }
}

// Each tag of a kind in `html`, as `<name ...>`.
fn tags(html: String, name: str) -> List<String> {
    let low = html.to_lower_root()
    var out = List<String>()
    var from: usize = 0
    let open = "<{name}"
    loop {
        let at = low[from..].find(open.copy()) else break
        let k = from + at
        let end = low[k..].find(">") else break
        out.push(html[k..k + end + 1].copy())
        from = k + end + 1
        if out.len() >= 200 { break }
    }
    return out
}

// Text cut to the longest title kept.
fn cut_short(text: String) -> String {
    var t = text.trim().copy()
    if t.len() > TITLE_MOST {
        var cut: usize = 0
        for r in t.runes() {
            if cut + rune_len(r) > TITLE_MOST { break }
            cut += rune_len(r)
        }
        t = "{t[..cut].trim_end()}…"
    }
    return t
}

// What a page's `<meta>` of this property or name says, read as text, or none.
fn meta_of(html: String, name: str) -> String? {
    for m in tags(html, "meta") {
        let p = (attr(m.copy(), "property") ?? attr(m.copy(), "name") ?? String()).to_lower_root()
        if p == name {
            let v = cut_short(text_of(attr(m, "content") ?? String()))
            if v.len() > 0 { return some(v) }
        }
    }
    return none
}

// A title without the marks that join a page's title to its site's name.
fn unmarked(title: String) -> String {
    var s = title.trim().copy()
    loop {
        var cut = false
        for mark in ["-", "–", "—", "|", ":", "·", "•", "»", "«", "/"] {
            if s.starts_with(mark) {
                s = s[mark.len()..].trim().copy()
                cut = true
            }
            if s.ends_with(mark) {
                s = s[..s.len() - mark.len()].trim().copy()
                cut = true
            }
        }
        if not cut { break }
    }
    return s
}

// Only the letters and digits, in lowercase.
fn letters(text: String) -> String {
    var out = String()
    for r in text.to_lower_root().runes() {
        if (r >= 'a' and r <= 'z') or (r >= '0' and r <= '9') { out.push(r) }
    }
    return out
}

/// Whether `title` is the page's own: not empty, not only its site's name or a
/// piece of a title around it ("- YouTube", which YouTube's page has until its
/// script fills it in), and not a page a site shows in place of the one asked
/// for ("Just a moment...", "Before you continue to YouTube"). `site_name` is
/// what the page calls its site (`og:site_name`), maybe empty.
pub fn real_title(title: String, url: String, site_name: String) -> bool {
    let t = unmarked(title)
    if t.len() == 0 { return false }
    let low = t.to_lower_root()
    for junk in ["untitled", "untitled document", "error", "forbidden", "403 forbidden", "not found", "404 not found", "page not found", "home", "loading", "loading...", "loading…", "redirecting", "redirecting...", "please wait", "sign in", "log in", "login"] {
        if low == junk { return false }
    }
    for junk in ["just a moment", "attention required", "access denied", "before you continue", "are you a robot", "are you a human", "verify you are human", "one moment, please"] {
        if low.starts_with(junk) { return false }
    }
    // Only the site's name, or its address.
    let site = site_of(url)
    let parts = site.split(".")
    var names = [letters(site.copy()), letters(site_name)].to_list()
    if parts.len() > 1 {
        names.push(letters(parts[0].copy()))
        names.push(letters(parts[..parts.len() - 1].join(".")))
    }
    let mine = letters(t)
    for n in names {
        if n.len() > 0 and mine == n { return false }
    }
    return true
}

/// A page's own title (`real_title`), read as text and cut short: its
/// `og:title`, or else its `twitter:title`, or else its `<title>`; or "" when
/// it has none.
pub fn title_of(html: String, url: String) -> String {
    let site_name = meta_of(html.copy(), "og:site_name") ?? meta_of(html.copy(), "application-name") ?? String()
    var titles = List<String>()
    if let t = meta_of(html.copy(), "og:title") { titles.push(t) }
    if let t = meta_of(html.copy(), "twitter:title") { titles.push(t) }
    let low = html.to_lower_root()
    if let open = low.find("<title") {
        if let gt = low[open..].find(">") {
            let from = open + gt + 1
            let close = low[from..].find("</title") ?? 0
            titles.push(cut_short(text_of(html[from..from + close].copy())))
        }
    }
    for t in titles {
        if real_title(t.copy(), url.copy(), site_name.copy()) { return t.copy() }
    }
    return String()
}

/// An address as it's shown when its page has no title of its own: without its
/// scheme, `www.`, its fragment, a slash at its end and the parts of its query
/// that only track where it was shared from, its path read as text, and cut
/// short: `youtube.com/watch?v=dQw4w9WgXcQ`.
pub fn bare_address(url: String) -> String {
    var s = url.trim().copy()
    for scheme in ["https://", "http://"] {
        if s.to_lower_root().starts_with(scheme) { s = s[scheme.len()..].copy() }
    }
    if let k = s.find("#") { s = s[..k].copy() }
    var query = String()
    if let k = s.find("?") {
        query = s[k + 1..].copy()
        s = s[..k].copy()
    }
    var host = s.copy()
    var path = String()
    if let k = s.find("/") {
        host = s[..k].copy()
        path = decode(s[k..].copy())
    }
    host = host.to_lower_root()
    if host.starts_with("www.") { host = host[4..].copy() }
    while path.ends_with("/") { path = path[..path.len() - 1].copy() }
    var kept = List<String>()
    for pair in query.split("&") {
        let name = pair.split("=")[0].to_lower_root()
        if name.len() == 0 or name.starts_with("utm_") { continue }
        var tracks = false
        for t in ["fbclid", "gclid", "dclid", "msclkid", "igshid", "mc_cid", "mc_eid", "si", "feature", "ref_src", "ref_url"] {
            if name == t { tracks = true }
        }
        if not tracks { kept.push(pair.copy()) }
    }
    var out = "{host}{path}"
    if kept.len() > 0 { out = "{out}?{kept.join("&")}" }
    return cut_short(out)
}

// --- oEmbed ---

/// The oEmbed address for a page on a site whose page may not carry its title
/// without its script, which loom asks first: a YouTube video's, short's or
/// list's, or none.
pub fn oembed_for(url: String) -> String? {
    let site = site_of(url.copy())
    if not (site == "youtube.com" or site.ends_with(".youtube.com") or site == "youtu.be") { return none }
    let u = match Url.parse(url.copy()) {
        ok(x) => x,
        err(_) => return none,
    }
    if u.path.trim_suffix("/").len() == 0 { return none }
    return some("https://www.youtube.com/oembed?format=json&url={encode(url, safe: "")}")
}

/// The oEmbed address a page names for itself (`<link rel="alternate"
/// type="application/json+oembed">`), as an https address of a public host, or
/// none.
pub fn oembed_of(html: String, page: String) -> String? {
    let base = match Url.parse(page) {
        ok(x) => x,
        err(_) => return none,
    }
    for l in tags(html, "link") {
        let kind = (attr(l.copy(), "type") ?? String()).to_lower_root()
        if kind != "application/json+oembed" { continue }
        let href = text_of(attr(l, "href") ?? String()).trim().copy()
        if href.len() == 0 { continue }
        let full = match base.join(href) {
            ok(x) => x,
            err(_) => continue,
        }
        let u = "{full}"
        if lookable(u.copy()) { return some(u) }
    }
    return none
}

/// What an oEmbed answer says of its page: its title, cut short ("" when it has
/// none), and its picture (`thumbnail_url`), an https address of a public host.
pub struct Embed {
    pub title: String
    pub picture: String?
}

pub fn embed_of(body: String) -> Embed {
    var e = Embed { title: String(), picture: none }
    let j = match parse(body) {
        ok(x) => x,
        err(_) => return e,
    }
    e.title = cut_short(text_of(str_at(j.copy(), "title") ?? String()))
    let thumb = (str_at(j, "thumbnail_url") ?? String()).trim().copy()
    if lookable(thumb.copy()) { e.picture = some(thumb) }
    return e
}

/// Where a page's icon may be, best first: the icons it names that loom can
/// draw (not an SVG), then the site's `/favicon.ico`. Each an https address.
pub fn icons_of(html: String, page: String) -> List<String> {
    let base = match Url.parse(page) {
        ok(x) => x,
        err(_) => return List<String>(),
    }
    var named = List<(i64, String)>()
    for l in tags(html, "link") {
        let rel = (attr(l.copy(), "rel") ?? String()).to_lower_root()
        if not rel.contains("icon") or rel.contains("mask-icon") { continue }
        let href = (attr(l.copy(), "href") ?? String()).trim().copy()
        if href.len() == 0 or href.starts_with("data:") { continue }
        let kind = (attr(l.copy(), "type") ?? String()).to_lower_root()
        if kind.contains("svg") or href.to_lower_root().split("?")[0].ends_with(".svg") { continue }
        let full = match base.join(href) {
            ok(x) => x,
            err(_) => continue,
        }
        // Bigger than drawn, for a sharp icon, but not a whole picture.
        let sizes = (attr(l, "sizes") ?? String()).to_lower_root()
        let w = i64.parse(sizes.split("x")[0].copy()) ?? 0
        let score: i64 = if rel.contains("apple-touch") { 40 } else if w == 0 { 20 } else if w >= 32 { w - 32 } else { (32 - w) * 3 }
        named.push((score, "{full}"))
    }
    named.sort_by(|a, b| a.0.cmp(b.0))
    var out = List<String>()
    for (_, u) in named {
        if lookable(u.copy()) and not out.contains(u.copy()) { out.push(u.copy()) }
    }
    let host = base.host ?? String()
    let fav = "https://{host}/favicon.ico"
    if not out.contains(fav.copy()) { out.push(fav) }
    return out
}

/// Where a page's preview picture is: its `og:image` (or `og:image:secure_url`,
/// or `twitter:image`), as an https address of a public host, or none.
pub fn picture_of(html: String, page: String) -> String? {
    let base = match Url.parse(page) {
        ok(x) => x,
        err(_) => return none,
    }
    var found = String()
    var rank = 9
    for m in tags(html, "meta") {
        let p = (attr(m.copy(), "property") ?? attr(m.copy(), "name") ?? String()).to_lower_root()
        let r = if p == "og:image:secure_url" { 0 } else if p == "og:image" or p == "og:image:url" { 1 } else if p == "twitter:image" or p == "twitter:image:src" { 2 } else { 9 }
        if r >= rank { continue }
        let href = (attr(m, "content") ?? String()).trim().copy()
        if href.len() == 0 or href.starts_with("data:") { continue }
        let full = match base.join(href) {
            ok(x) => x,
            err(_) => continue,
        }
        let u = "{full}"
        if not lookable(u.copy()) { continue }
        found = u
        rank = r
    }
    return if found.len() > 0 { some(found) } else { none }
}

// --- The lookups, on a thread of their own ---

pub struct Job {
    pub url: String
    pub icon: bool    // the site's icon is wanted too: the instance has none for it yet
    pub picture: bool    // its preview picture is wanted too, for a link pasted in the composer
}

pub struct Done {
    pub url: String
    pub title: String    // the page's own, or else its address as it's shown (`bare_address`); "" for one that isn't looked up
    pub icon: List<u8>    // the icon's bytes, as they came, or empty
    pub icon_asked: bool    // the job asked for it, so empty means the site has none
    pub picture: List<u8>    // its preview picture, made small (files.page_picture), or empty
    pub picture_asked: bool
}

struct Worker {
    jobs: Receiver<Job>
    done: Sender<Done>
}

impl Task for Worker {
    fn run(own self) {
        var w = self
        while let job = w.jobs.wait() {
            w.done.send(look_up(job))
        }
    }
}

pub fn start() -> (Sender<Job>, Receiver<Done>) {
    let jobs = Receiver<Job>()
    let to = jobs.sender()
    let done = Receiver<Done>()
    _ = unsafe { Thread.spawn(Worker { jobs: jobs, done: done.sender() }) }
    return (to, done)
}

fn fetch(url: String, most: usize, accept: str) -> List<u8> ! Error {
    var req = get(url, [Header { name: String("Accept"), value: String(accept) }, Header { name: String("User-Agent"), value: String("Mozilla/5.0 (compatible; loom)") }], WAIT_MS, most)
    let r = try req.wait()
    if r.status != 200 { fail "it answered {r.status}" }
    return r.body
}

// An oEmbed answer, or one with nothing in it when it couldn't be had.
fn embed_at(url: String) -> Embed {
    return match fetch(url, EMBED_MOST, "application/json") {
        ok(b) => embed_of(decode_lossy(b.copy(), 0, b.len())),
        err(_) => Embed { title: String(), picture: none },
    }
}

// A page's title, its site's icon and its preview picture. The title is the
// page's own: from its site's oEmbed first where its page may not carry it
// (YouTube's), else from its page (`title_of`), else from the oEmbed the page
// names; and when there's none of those, its address as it's shown
// (`bare_address`), never a piece of one like "- YouTube".
fn look_up(job: Job) -> Done {
    var done = Done { url: job.url.copy(), title: String(), icon: List<u8>(), icon_asked: job.icon, picture: List<u8>(), picture_asked: job.picture }
    if not lookable(job.url.copy()) { return done }
    var embed = Embed { title: String(), picture: none }
    if let e = oembed_for(job.url.copy()) { embed = embed_at(e) }
    var title = if real_title(embed.title.copy(), job.url.copy(), String()) { embed.title.copy() } else { String() }
    // The page, unless the oEmbed gave all that's wanted. Only its start, where
    // its head is: a page over the limit isn't read at all.
    let want_page = title.len() == 0 or job.icon or (job.picture and embed.picture == none)
    let page = if not want_page { String() } else {
        match fetch(job.url.copy(), PAGE_MOST, "text/html,application/xhtml+xml") {
            ok(b) => decode_lossy(b.copy(), 0, b.len()),
            err(_) => String(),
        }
    }
    if title.len() == 0 { title = title_of(page.copy(), job.url.copy()) }
    if title.len() == 0 {
        if let e = oembed_of(page.copy(), job.url.copy()) {
            embed = embed_at(e)
            if real_title(embed.title.copy(), job.url.copy(), String()) { title = embed.title.copy() }
        }
    }
    done.title = if title.len() > 0 { title } else { bare_address(job.url.copy()) }
    if job.picture {
        if let src = picture_of(page.copy(), job.url.copy()) ?? embed.picture.copy() {
            if let ok(b) = fetch(src, PICTURE_MOST, "image/*") {
                match files.page_picture(b) {
                    ok(small) => done.picture = small,
                    err(_) => {},
                }
            }
        }
    }
    if not job.icon { return done }
    let base = if page.len() > 0 { job.url.copy() } else { "https://{site_of(job.url.copy())}/" }
    for src in icons_of(page, base) {
        match fetch(src, ICON_MOST, "image/*") {
            ok(b) => {
                if b.len() > 0 {
                    done.icon = b
                    break
                }
            },
            err(_) => {},
        }
    }
    return done
}

@test
fn finds_the_addresses_in_a_message() {
    let text = "See https://9to5google.com/2026/11/18/neon/, and [the notes](https://ai.google.dev/notes) (https://x.example.org/a_(b)). Again: https://9to5google.com/2026/11/18/neon/"
    let urls = urls_in(String(text))
    assert(urls.len() == 3)
    assert(urls[0] == "https://9to5google.com/2026/11/18/neon/")
    assert(urls[1] == "https://ai.google.dev/notes")
    assert(urls[2] == "https://x.example.org/a_(b)")
    assert(site_of(String("https://www.theverge.com/x")) == "theverge.com")
}

@test
fn takes_the_sources_off_the_end_of_a_reply() {
    let reply = "Yes. Google has picked up the pace.\n\nGood for you either way.\n\nSources:\n\n- [9to5Google: Gemini 4 Neon](https://9to5google.com/neon)\n- The Decoder: Neon vs. flagship: https://the-decoder.com/neon\n3. https://www.techtarget.com/x\n"
    let (text, sources) = split_sources(String(reply))
    assert(text == "Yes. Google has picked up the pace.\n\nGood for you either way.")
    assert(sources.len() == 3)
    assert(str_at(sources[0].copy(), "title") == some(String("9to5Google: Gemini 4 Neon")) and str_at(sources[0].copy(), "site") == some(String("9to5google.com")))
    assert(str_at(sources[1].copy(), "title") == some(String("The Decoder: Neon vs. flagship")) and str_at(sources[1].copy(), "url") == some(String("https://the-decoder.com/neon")))
    assert(str_at(sources[2].copy(), "title") == some(String("")) and str_at(sources[2].copy(), "site") == some(String("techtarget.com")))
    // A heading in bold or as a heading, too.
    let (_, bold) = split_sources(String("Hi.\n\n**Sources**\n- https://a.example.org/x"))
    assert(bold.len() == 1)
    // A list with something else in it, or that isn't at the end, stays.
    let mixed = "Hi.\n\nSources:\n- https://a.example.org/x\n- and my own guess"
    assert(split_sources(String(mixed)).0 == mixed)
    let middle = "Sources:\n- https://a.example.org/x\n\nThen more words."
    assert(split_sources(String(middle)).1.len() == 0)
    assert(split_sources(String("Sources:")).1.len() == 0)
}

@test
fn looks_up_only_public_https_pages() {
    assert(lookable(String("https://9to5google.com/neon")))
    assert(not lookable(String("http://9to5google.com/neon")))
    assert(not lookable(String("https://192.168.1.1/")))
    assert(not lookable(String("https://[::1]/")))
    assert(not lookable(String("https://localhost/")))
    assert(not lookable(String("https://router/")))
    assert(not lookable(String("https://nas.local/")))
    assert(not lookable(String("https://example.com:8443/")))
    assert(not lookable(String("https://me:pw@example.com/")))
}

@test
fn reads_a_pages_title_and_icons() {
    let html = "<html><head><title>\n  Gemini 4 Neon &amp; you &#8211; 9to5Google\n</title><link rel=\"icon\" href=\"/i/16.png\" sizes=\"16x16\"><link rel='icon' type='image/png' sizes='32x32' href='/i/32.png'><link rel=\"icon\" href=\"/i.svg\" type=\"image/svg+xml\"><link rel=\"apple-touch-icon\" href=\"https://cdn.9to5google.com/t.png\"></head>"
    let page = String("https://9to5google.com/2026/neon")
    assert(title_of(String(html), page.copy()) == "Gemini 4 Neon & you – 9to5Google")
    let og = "<meta name=\"x\" content=\"y\"><meta property=\"og:title\" content=\"Neon, explained\"><title>Other</title>"
    assert(title_of(String(og), page.copy()) == "Neon, explained")
    assert(title_of(String("<p>no title</p>"), page.copy()) == "")
    let icons = icons_of(String(html), String("https://9to5google.com/2026/neon"))
    assert(icons.len() == 4)
    assert(icons[0] == "https://9to5google.com/i/32.png")
    // A big touch icon, made small, before one smaller than it's drawn.
    assert(icons[1] == "https://cdn.9to5google.com/t.png")
    assert(icons[2] == "https://9to5google.com/i/16.png")
    assert(icons[3] == "https://9to5google.com/favicon.ico")
}

@test
fn finds_a_pages_preview_picture() {
    let page = String("https://9to5google.com/2026/neon")
    let og = "<meta name=\"twitter:image\" content=\"https://cdn.example.org/t.jpg\"><meta property=\"og:image\" content=\"/img/neon.jpg\">"
    assert(picture_of(String(og), page.copy()) == some(String("https://9to5google.com/img/neon.jpg")))
    // The secure one before the plain one, and twitter's when there's no other.
    let both = "<meta property=\"og:image\" content=\"https://a.example.org/a.jpg\"><meta property=\"og:image:secure_url\" content=\"https://a.example.org/b.jpg\">"
    assert(picture_of(String(both), page.copy()) == some(String("https://a.example.org/b.jpg")))
    assert(picture_of(String("<meta name=\"twitter:image\" content=\"https://cdn.example.org/t.jpg\">"), page.copy()) == some(String("https://cdn.example.org/t.jpg")))
    // Not over http, nor on the person's own network, nor none at all.
    assert(picture_of(String("<meta property=\"og:image\" content=\"http://a.example.org/a.jpg\">"), page.copy()) == none)
    assert(picture_of(String("<meta property=\"og:image\" content=\"https://192.168.1.2/a.jpg\">"), page.copy()) == none)
    assert(picture_of(String("<title>x</title>"), page) == none)
}

@test
fn takes_a_title_only_when_its_the_pages_own() {
    let video = String("https://www.youtube.com/watch?v=dQw4w9WgXcQ")
    // YouTube's page without its script: a piece of a title, and its site's name.
    assert(title_of(String("<title> - YouTube</title><meta property=\"og:site_name\" content=\"YouTube\">"), video.copy()) == "")
    assert(title_of(String("<title>YouTube</title>"), video.copy()) == "")
    assert(title_of(String("<title>Before you continue to YouTube</title>"), video.copy()) == "")
    assert(title_of(String("<title>Just a moment...</title>"), String("https://news.example.org/a")) == "")
    // og:title, then twitter:title, then <title>, past one that isn't real.
    let page = String("https://news.example.org/a")
    let both = "<meta property=\"og:title\" content=\"News\"><meta name=\"twitter:title\" content=\"Neon is out\"><title>Other</title>"
    assert(title_of(String(both), page.copy()) == "Neon is out")
    assert(title_of(String("<meta property=\"og:title\" content=\"\"><title>Neon &amp; you</title>"), page.copy()) == "Neon & you")
    // A title that only has its site's name in it is still its own.
    assert(title_of(String("<title>GitHub - aaen/loom: the app</title>"), String("https://github.com/aaen/loom")) == "GitHub - aaen/loom: the app")
    assert(title_of(String("<title>GitHub</title>"), String("https://github.com/")) == "")
    // Words in any script are words.
    assert(real_title(String("ネオンの話"), page.copy(), String()))
    assert(not real_title(String(" — | "), page, String()))
}

@test
fn shows_an_address_cleaned_up_when_its_page_has_no_title() {
    assert(bare_address(String("https://www.youtube.com/watch?v=dQw4w9WgXcQ&si=abc123&feature=shared")) == "youtube.com/watch?v=dQw4w9WgXcQ")
    assert(bare_address(String("https://youtu.be/dQw4w9WgXcQ?si=x")) == "youtu.be/dQw4w9WgXcQ")
    assert(bare_address(String("https://Example.org/")) == "example.org")
    assert(bare_address(String("https://en.wikipedia.org/wiki/Caf%C3%A9#History")) == "en.wikipedia.org/wiki/Café")
    assert(bare_address(String("https://shop.example.org/a/?utm_source=x&id=7&fbclid=y")) == "shop.example.org/a?id=7")
}

@test
fn reads_a_videos_title_from_its_oembed() {
    let video = String("https://www.youtube.com/watch?v=dQw4w9WgXcQ")
    assert(oembed_for(video.copy()) == some(String("https://www.youtube.com/oembed?format=json&url=https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3DdQw4w9WgXcQ")))
    assert(oembed_for(String("https://youtu.be/dQw4w9WgXcQ")) != none)
    assert(oembed_for(String("https://m.youtube.com/shorts/abc")) != none)
    // Not YouTube's own page, nor another site.
    assert(oembed_for(String("https://www.youtube.com/")) == none)
    assert(oembed_for(String("https://vimeo.com/76979871")) == none)
    // YouTube's answer: the video's title and its picture.
    let answer = #"{"title":"Rick Astley - Never Gonna Give You Up (Official Video)","author_name":"Rick Astley","type":"video","thumbnail_url":"https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg"}"#
    let e = embed_of(String(answer))
    assert(e.title == "Rick Astley - Never Gonna Give You Up (Official Video)")
    assert(real_title(e.title.copy(), video.copy(), String()))
    assert(e.picture == some(String("https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg")))
    // An answer that isn't one, or a picture over http.
    assert(embed_of(String("<html>")).title == "")
    assert(embed_of(String(#"{"title":"A","thumbnail_url":"http://a.example.org/a.jpg"}"#)).picture == none)
    // The oEmbed a page names for itself, its entities read.
    let named = "<link rel=\"alternate\" type=\"application/json+oembed\" href=\"https://vimeo.com/api/oembed.json?url=https%3A%2F%2Fvimeo.com%2F1&amp;w=1\">"
    assert(oembed_of(String(named), String("https://vimeo.com/1")) == some(String("https://vimeo.com/api/oembed.json?url=https%3A%2F%2Fvimeo.com%2F1&w=1")))
    assert(oembed_of(String("<link rel=\"alternate\" type=\"application/json+oembed\" href=\"http://a.example.org/o\">"), String("https://vimeo.com/1")) == none)
}
