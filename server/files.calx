module server.files

// Files and images (PLAN.md, "Files and images"). Each file is kept once, in
// the data folder's files/ under its SHA-256, and belongs to everyone who
// uploaded it. Thumbnails of PNG and JPEG images are made on a thread of their
// own, since decoding a photo takes long enough to hold up the loop, and are
// written beside the file as <sha256>.thumb.
import std.bytes
import std.fs
import std.image.{Color, Image, Kind, decode_ico, encode_ico}
import std.net.{Waker as LoopWaker}
import std.thread.{Task}

/// The longest side of a thumbnail, in pixels.
pub const THUMB: usize = 512

/// The biggest image sent to an agent inline, as an image block. Bigger ones go as a link.
pub const INLINE_IMAGE: i64 = 5000000

pub struct Thumb {
    pub src: String
    pub dst: String
}

struct Worker {
    jobs: Receiver<Thumb>
}

impl Task for Worker {
    fn run(own self) {
        var w = self
        while let job = w.jobs.wait() {
            match make_thumb(job.src.copy(), job.dst.copy()) {
                ok => {},
                err(e) => eprintln("loom: the thumbnail of {job.src}: {e}"),
            }
        }
    }
}

/// Starts the thumbnail thread, and gives the end that sends it work.
pub fn start() -> Sender<Thumb> {
    let jobs = Receiver<Thumb>()
    let to = jobs.sender()
    _ = unsafe { Thread.spawn(Worker { jobs: jobs }) }
    return to
}

/// Writes a thumbnail of the image at `src` to `dst`: a JPEG, or a PNG when it has
/// alpha. It's written beside `dst` first and moved, so half a thumbnail is never served.
pub fn make_thumb(src: String, dst: String) ! Error {
    let (small, _) = try thumb_of(try fs.read(src))
    let part = "{dst}.part"
    try fs.write(part.copy(), small)
    try fs.rename(part, dst)
}

/// A thumbnail of an image, at most `THUMB` pixels a side: a JPEG, or a PNG when it
/// has alpha, and which of the two.
pub fn thumb_of(data: List<u8>) -> (List<u8>, String) ! Error {
    let im = match Image.decode(data) {
        ok(i) => i,
        err(why) => fail "it isn't an image loom can read: {why}",
    }
    let small = im.thumbnail(THUMB, THUMB)
    if small.kind().has_alpha() { return (small.encode_png(), String("image/png")) }
    return (small.to(Kind.Rgb).encode_jpeg(80), String("image/jpeg"))
}

// --- Pictures a reply names (PLAN.md, "Mentions") ---

/// A picture in an agent's folder or the shared one that a reply names, to make a
/// thumbnail of: the reply's `message`, of `user`, names it as `named`, and it's at
/// `path`.
pub struct Picture {
    pub user: String
    pub message: String
    pub named: String
    pub path: String
    pub key: String    // the picture's path, size and time, which its thumbnail is kept by
}

/// Its thumbnail, or why there's none.
pub struct Pictured {
    pub user: String
    pub message: String
    pub named: String
    pub path: String
    pub key: String
    pub thumb: List<u8>    // empty when it couldn't be made
    pub mime: String
    pub error: String
}

fn picture_thumb(path: String) -> (List<u8>, String) ! Error {
    return try thumb_of(try fs.read(path))
}

struct PictureWorker {
    jobs: Receiver<Picture>
    done: Sender<Pictured>
    wake: LoopWaker
}

impl Task for PictureWorker {
    fn run(own self) {
        var w = self
        while let job = w.jobs.wait() {
            let out = match picture_thumb(job.path.copy()) {
                ok(t) => Pictured { user: job.user, message: job.message, named: job.named, path: job.path, key: job.key, thumb: t.0.copy(), mime: t.1.copy(), error: String() },
                err(e) => Pictured { user: job.user, message: job.message, named: job.named, path: job.path, key: job.key, thumb: List<u8>(), mime: String(), error: "{e}" },
            }
            w.done.send(out)
            w.wake.wake()
        }
    }
}

/// Starts the thread that makes thumbnails of the pictures replies name, and gives the
/// end that sends it work and the one its thumbnails come back on. It wakes the loop
/// with each.
pub fn start_pictures(wake: LoopWaker) -> (Sender<Picture>, Receiver<Pictured>) {
    let jobs = Receiver<Picture>()
    let to = jobs.sender()
    let done = Receiver<Pictured>()
    _ = unsafe { Thread.spawn(PictureWorker { jobs: jobs, done: done.sender(), wake: wake }) }
    return (to, done)
}

/// The type of an image or a PDF, from how its bytes start, or none.
pub fn sniff(head: List<u8>) -> String? {
    let n = head.len()
    if n >= 8 and head[0] == 0x89 and head[1] == 0x50 and head[2] == 0x4e and head[3] == 0x47 { return some(String("image/png")) }
    if n >= 3 and head[0] == 0xff and head[1] == 0xd8 and head[2] == 0xff { return some(String("image/jpeg")) }
    if n >= 6 and head[0] == 0x47 and head[1] == 0x49 and head[2] == 0x46 and head[3] == 0x38 { return some(String("image/gif")) }
    if n >= 12 and head[0] == 0x52 and head[1] == 0x49 and head[2] == 0x46 and head[3] == 0x46 and head[8] == 0x57 and head[9] == 0x45 and head[10] == 0x42 and head[11] == 0x50 { return some(String("image/webp")) }
    if n >= 5 and head[0] == 0x25 and head[1] == 0x50 and head[2] == 0x44 and head[3] == 0x46 and head[4] == 0x2d { return some(String("application/pdf")) }
    return none
}

/// The longest side of an MCP server's icon as loom keeps it, in pixels.
pub const ICON: usize = 128
/// The most pixels a side of an icon may have before it's read.
const ICON_MOST: u32 = 1024

/// A PNG's or a JPEG's width and height, from its header, or none.
fn header_size(data: List<u8>) -> (u32, u32)? {
    let n = data.len()
    let mime = sniff(data[..if n < 12 { n } else { 12 }]) ?? String()
    if mime == "image/png" {
        if n < 24 { return none }
        return some((bytes.u32_be(data.copy(), 16), bytes.u32_be(data, 20)))
    }
    if mime != "image/jpeg" { return none }
    // The frame's header, among the segments after the start.
    var i: usize = 2
    while i + 9 < n {
        if data[i] != 0xff { return none }
        let marker = data[i + 1]
        if marker == 0xff {
            i += 1
            continue
        }
        if marker >= 0xc0 and marker <= 0xcf and marker != 0xc4 and marker != 0xc8 and marker != 0xcc {
            return some((u32(bytes.u16_be(data.copy(), i + 7)), u32(bytes.u16_be(data, i + 5))))
        }
        i += 2 + usize(bytes.u16_be(data.copy(), i + 2))
    }
    return none
}

/// An MCP server's icon (PLAN.md, "Cards in the chat"), checked and made ready
/// to keep: a PNG or a JPEG of at most 1024 pixels a side, read, made at most
/// `ICON` pixels a side, and written as a PNG. Anything else isn't one.
pub fn icon_png(data: List<u8>) -> List<u8> ! Error {
    let (w, h) = header_size(data.copy()) else { fail "it isn't a PNG or a JPEG" }
    if w == 0 or h == 0 or w > ICON_MOST or h > ICON_MOST { fail "it's {w} by {h} pixels: an icon is at most {ICON_MOST} a side" }
    let im = match Image.decode(data) {
        ok(i) => i,
        err(why) => fail "it isn't a picture loom can read: {why}",
    }
    return im.thumbnail(ICON, ICON).encode_png()
}

/// The longest side of a site's icon as loom keeps it, in pixels: four times
/// the 16 it's drawn at.
pub const SITE_ICON: usize = 64

/// A site's icon (PLAN.md, "Links and sources"), as its page or its
/// `/favicon.ico` gave it: a PNG, a JPEG or an ICO, whose biggest picture is
/// taken, made at most `SITE_ICON` pixels a side and written as a PNG.
pub fn site_icon_png(data: List<u8>) -> List<u8> ! Error {
    let n = data.len()
    let ico = n >= 6 and data[0] == 0 and data[1] == 0 and data[2] == 1 and data[3] == 0
    if not ico {
        let png = try icon_png(data)
        let im = match Image.decode(png) {
            ok(i) => i,
            err(why) => fail "it isn't a picture loom can read: {why}",
        }
        return im.thumbnail(SITE_ICON, SITE_ICON).encode_png()
    }
    let images = match decode_ico(data) {
        ok(list) => list,
        err(why) => fail "it isn't an icon loom can read: {why}",
    }
    var best = 0usize
    var found = false
    for k in 0usize..images.len() {
        if not found or images[k].width() > images[best].width() {
            best = k
            found = true
        }
    }
    if not found { fail "the icon has no pictures in it" }
    return images[best].thumbnail(SITE_ICON, SITE_ICON).encode_png()
}

/// Whether loom makes thumbnails of this type.
pub fn thumbable(mime: String) -> bool {
    return mime == "image/png" or mime == "image/jpeg"
}

/// Whether an agent can be given this type as an image.
pub fn agent_image(mime: String) -> bool {
    return mime == "image/png" or mime == "image/jpeg" or mime == "image/gif" or mime == "image/webp"
}

@test
fn types_are_sniffed() {
    assert(sniff([0x89u8, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]) == some(String("image/png")))
    assert(sniff([0xffu8, 0xd8, 0xff, 0xe0]) == some(String("image/jpeg")))
    assert(sniff([0x25u8, 0x50, 0x44, 0x46, 0x2d, 0x31]) == some(String("application/pdf")))
    assert(sniff([1u8, 2, 3]) == none)
}

@test
fn an_icon_is_a_small_picture() {
    let big = Image.new(300, 200, Kind.Rgba, Color.rgba(10, 20, 30, 200))
    let png = icon_png(big.encode_png())!
    let back = Image.decode(png)!
    assert(back.width() == ICON and back.height() == 85 and back.kind().has_alpha())
    let photo = Image.new(64, 48, Kind.Rgb, Color.rgb(200, 10, 10)).encode_jpeg(80)
    assert(header_size(photo.copy()) == some((64u32, 48u32)))
    let kept = Image.decode(icon_png(photo)!)!
    assert(kept.width() == 64 and kept.height() == 48)
    // Not a picture, a picture that's cut short, and one too big to read.
    assert(refused("<svg></svg>".to_bytes()))
    let cut = Image.new(32, 32, Kind.Rgb, Color.rgb(0, 0, 0)).encode_png()
    assert(refused(cut[..40]))
    assert(refused(Image.new(1100, 10, Kind.Gray, Color.gray(0)).encode_png()))
}

@test
fn a_sites_icon_is_read_from_an_ico_too() {
    // A favicon.ico with a 16 and a 48: the 48 is taken.
    let ico = encode_ico([Image.new(16, 16, Kind.Rgba, Color.rgba(255, 0, 0, 255)), Image.new(48, 48, Kind.Rgba, Color.rgba(0, 0, 255, 255))])
    let from_ico = Image.decode(site_icon_png(ico)!)!
    assert(from_ico.width() == 48 and from_ico.height() == 48)
    // A big PNG is made small.
    let big = Image.decode(site_icon_png(Image.new(180, 180, Kind.Rgba, Color.rgba(0, 0, 0, 255)).encode_png())!)!
    assert(big.width() == SITE_ICON)
    assert(match site_icon_png("<svg></svg>".to_bytes()) {
        ok(_) => false,
        err(_) => true,
    })
}

@test
fn a_thumbnail_is_a_small_jpeg_or_png() {
    let (photo, kind) = thumb_of(Image.new(1600, 800, Kind.Rgb, Color.rgb(20, 120, 200)).encode_png())!
    let small = Image.decode(photo)!
    assert(kind == "image/jpeg" and small.width() == THUMB and small.height() == 256)
    let (clear, clear_kind) = thumb_of(Image.new(40, 30, Kind.Rgba, Color.rgba(0, 0, 0, 100)).encode_png())!
    assert(clear_kind == "image/png" and Image.decode(clear)!.width() == 40)
}

fn refused(data: List<u8>) -> bool {
    return match icon_png(data) {
        ok(_) => false,
        err(_) => true,
    }
}
