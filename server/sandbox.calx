module server.sandbox

// Where the agents of everyone but the owner run, and the owner's that are
// isolated (PLAN.md, "Sandboxes"): a container for each person, in rootless
// Podman or Docker, which sees their own folder, `sandboxes/<user>` in the data
// folder, and the instance's downloaded agent programs, `acp/`, read-only, and
// nothing else of the instance's. Both are mounted at the same paths as outside,
// so an agent's folder, the files loom copies into it and the links the agent
// sends back mean the same inside and out.
//
// The person's container has the internet, but not the server's loopback,
// except one port: the gate (server/gate.calx), which passes only `loom mcp`'s
// calls on to the instance. Podman's reaches it through pasta, at 127.0.0.1;
// Docker's are on a network of loom's own, `loom`, and reach the gate at its
// gateway, as loom's own user rather than root, with no capabilities. The
// person's agent programs run in it with `exec`, and loom's own tools reach them
// through the image's `loom mcp`. It keeps running between agents, so what the
// person installs in it stays until the instance moves or the person is removed.
//
// An agent with an outbound allowlist, or with no network, has a container of
// its own, `loom-<user>-<agent>`, made with `--network none`: it sees the same
// folders, but has nothing but its own loopback, where `loom egress` (server/
// egress.calx) passes loom's tools on to the gate and lets out only what the
// agent's list lets. Its HTTP_PROXY and HTTPS_PROXY name the egress.
//
// A private agent has a container of its own too, `loom-<user>-<agent>`, which
// sees only that agent's own folder, `sandboxes/<user>.private/<agent>`, and
// `acp/`: none of its person's folder, so neither it nor their other agents
// reach the other's files (PLAN.md, "Private agents"). Its network is the
// person's sandbox's, or none but its egress, as any agent's is.
//
// Each has at most 2 GB of memory, two CPUs and 512 processes, and its own
// layer at most DISK, where the system's storage lets loom say so (overlay on
// XFS with project quotas). The person's folder is outside that layer, so loom
// measures it before each run, and a run doesn't start while it's over DISK.
import std.env
import std.fs
import std.io
import std.process.{Child, Command, Stdio}
import std.tar
import std.tar.{Kind, StreamReader, StreamWriter}
import std.thread.{Task}
import std.time.{Timestamp}
import server.egress

// The image a sandbox runs, unless `loom serve --sandbox-image` names another:
// loom's own, which has Node for the agents that start with npx, git, and `loom`
// for `loom mcp` and `loom egress`. A release runs its own version's (`image_for`).
pub const IMAGE: str = "ghcr.io/aaen-studios/loom"

// The image of loom `version`'s sandboxes: the one a release of it pushed, tagged
// with its version, so their `loom mcp` and `loom egress` are the instance's own.
// A build from source, whose version no image has, takes the newest.
pub fn image_for(version: String) -> String {
    if version.len() == 0 or version.contains("-dev") or version.starts_with("0.0.0") { return String(IMAGE) }
    return "{IMAGE}:{version}"
}

@test
fn a_release_runs_its_own_versions_image() {
    assert(image_for(String("0.2.11")) == "ghcr.io/aaen-studios/loom:0.2.11")
    assert(image_for(String("0.3.0-beta.1")) == "ghcr.io/aaen-studios/loom:0.3.0-beta.1")
    assert(image_for(String("0.2.0-dev")) == IMAGE and image_for(String("0.0.0-docker")) == IMAGE)
}

// The sandboxes made from another image than `id`, from what `container inspect`
// said of each: its name and its image's id. Docker's names start with a slash.
pub fn stale(said: String, id: String) -> List<String> {
    var out = List<String>()
    for line in said.lines() {
        let (box, image) = line.trim().split_once(" ") ?? (String(), String())
        if box.len() == 0 { continue }
        if image.trim() != id { out.push(box.trim_prefix("/").copy()) }
    }
    return out
}

@test
fn a_sandbox_from_another_image_is_stale() {
    let said = String("loom-u_2 abc\n/loom-u_3 def\nloom-u_3-a_1 abc\n")
    assert(stale(said.copy(), String("abc")).join(" ") == "loom-u_3")
    assert(stale(said, String("new")).join(" ") == "loom-u_2 loom-u_3 loom-u_3-a_1")
    assert(stale(String(), String("abc")).len() == 0)
}

// What each sandbox may use, at most.
const MEMORY: str = "2g"
const CPUS: str = "2"
const PIDS: str = "512"
const DISK: str = "10g"
pub const DISK_BYTES: i64 = 10737418240

// Docker's network for sandboxes, on the server's bridge `loom0`.
const NETWORK: str = "loom"

// What the `loom.gate` label of an agent's own sandbox says, in place of the gate.
const CLOSED: str = "closed"

pub struct Sandboxes {
    pub runtime: String    // podman or docker
    pub image: String
    pub root: String       // the data folder's sandboxes/, absolute
    pub acp: String        // the data folder's acp/, absolute
    pub gate_host: String  // where the gate listens: 127.0.0.1, or Docker's gateway on `loom`
    pub gate: u16          // and its port
}

// Which sandbox an agent runs in: its person's, or one of its own, for an
// agent closed to the network or a private one (PLAN.md, "Private agents").
pub struct Place {
    pub user: String
    pub agent: String    // the agent whose own sandbox it is, or "" for the person's
    pub closed: bool     // with no network but its egress
    pub private: bool    // seeing only the agent's own folder, not its person's
}

// `user`'s own sandbox, which their agents share.
pub fn person(user: String) -> Place {
    return Place { user: user.copy(), agent: String(), closed: false, private: false }
}

impl Place {
    // Whether it's an agent's own sandbox rather than its person's.
    pub fn its_own(self) -> bool {
        return self.agent.len() > 0
    }

    // The container's name.
    pub fn name(self) -> String {
        if self.its_own() { return "loom-{self.user}-{self.agent}" }
        return name(self.user.copy())
    }
}

@test
fn a_private_or_closed_agent_has_a_sandbox_of_its_own() {
    assert(person(String("u_2")).name() == "loom-u_2" and not person(String("u_2")).its_own())
    let private = Place { user: String("u_2"), agent: String("a_1"), closed: false, private: true }
    assert(private.its_own() and private.name() == "loom-u_2-a_1")
    let closed = Place { user: String("u_2"), agent: String("a_1"), closed: true, private: false }
    assert(closed.name() == private.name() and closed != private)
}

impl Sandboxes {
    // Where a sandbox reaches the gate.
    pub fn gate_url(self) -> String {
        return "http://{self.gate_host}:{self.gate}"
    }

    // Where `place`'s `loom mcp` reaches loom's tools: the gate, or the egress
    // in a sandbox closed to the network.
    pub fn tools_url(self, place: Place) -> String {
        if place.closed { return "http://127.0.0.1:{egress.PORT}" }
        return self.gate_url()
    }
}

// Where the gate listens for `runtime`'s sandboxes: 127.0.0.1 for Podman's, which
// reach it through pasta, or the gateway of Docker's network `loom`, made the first time.
pub fn gate_host(runtime: String) -> String ! Error {
    if runtime != "docker" { return String("127.0.0.1") }
    let format = String(#"{{range .IPAM.Config}}{{.Gateway}}{{end}}"#)
    var looked = try Command.new(runtime.copy()).args([String("network"), String("inspect"), String("--format"), format.copy(), String(NETWORK)]).output()
    if not looked.status.success() {
        let made = try Command.new(runtime.copy()).args([String("network"), String("create"), String("--driver"), String("bridge"), String("--opt"), String("com.docker.network.bridge.name=loom0"), String(NETWORK)]).output()
        if not made.status.success() { fail "docker didn't make the network {NETWORK}: {made.error_text().trim()}" }
        looked = try Command.new(runtime).args([String("network"), String("inspect"), String("--format"), format, String(NETWORK)]).output()
    }
    let gateway = looked.text().trim().copy()
    if not looked.status.success() or gateway.len() == 0 { fail "docker's network {NETWORK} has no gateway: {looked.error_text().trim()}" }
    return gateway
}

// What `runtime run` takes to make a sandbox, after the name and the label, but
// before the limits: its network, and for Docker, loom's own user and no
// capabilities. One closed to the network has none, and its programs' proxy
// is the egress.
fn isolation(runtime: String, gate: u16, closed: bool) -> List<String> {
    var out = List<String>()
    if closed {
        out.extend([String("--network"), String("none")])
        let proxy = "http://127.0.0.1:{egress.PORT}"
        for n in ["HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy", "ALL_PROXY", "all_proxy"] {
            out.push(String("-e"))
            out.push("{n}={proxy}")
        }
        for n in ["NO_PROXY", "no_proxy"] {
            out.push(String("-e"))
            out.push("{n}=localhost,127.0.0.1,::1")
        }
        // Node's own fetch and http follow the proxy only when told to.
        out.extend([String("-e"), String("NODE_USE_ENV_PROXY=1")])
    } else if runtime != "docker" {
        return [String("--network"), "pasta:-T,{gate}"]
    } else {
        out.extend([String("--network"), String(NETWORK)])
    }
    if runtime != "docker" { return out }
    out.extend([String("--cap-drop"), String("ALL"), String("--security-opt"), String("no-new-privileges")])
    // Its group too, once std.env gives it (CLX-425).
    if let uid = env.user_id() {
        out.push(String("--user"))
        out.push("{uid}")
    }
    return out
}

@test
fn a_closed_sandbox_has_no_network_but_the_relay() {
    let podman = isolation(String("podman"), 4000, true)
    assert(podman[0] == "--network" and podman[1] == "none")
    assert(podman.contains("HTTPS_PROXY=http://127.0.0.1:{egress.PORT}"))
    assert(not podman.contains(String("--cap-drop")))
    let docker = isolation(String("docker"), 4000, true)
    assert(docker[1] == "none" and docker.contains(String("--cap-drop")))
    let open = isolation(String("podman"), 4000, false)
    assert(open[1] == "pasta:-T,4000")
}

// What `exec` runs to make `dirs` and write a tar stream's files in the sandbox `box`:
// each folder with mkdir -p, then tar from its input, at the paths the archive names
// from /. Files go as the sandbox's user, as `cat >` wrote them, not the archive's.
fn write_all_args(box: String, dirs: List<String>) -> List<String> {
    let script = String(#"for d in "$@"; do mkdir -p -- "$d" || exit 1; done; exec tar -x --no-same-owner -f - -C /"#)
    var out: List<String> = [String("exec"), String("-i"), box.copy(), String("sh"), String("-c"), script, String("loom")]
    out.extend(dirs)
    return out
}

// `files`, each an absolute path and what goes there, as a tar stream for
// `write_all_args`: each a file of its own, named from /, dated now, with no folder
// entries, so the folders on the way are made as tar needs them and those that are
// there keep their own modes and times.
fn archive(files: List<(String, List<u8>)>) -> List<u8> {
    var w = tar.Writer.new()
    w.set_time(unsafe { Timestamp.now() })
    for (path, data) in files {
        w.add(path.trim_prefix("/").copy(), data.copy())
    }
    return w.finish()
}

@test
fn files_go_in_with_one_exec() {
    let args = write_all_args(String("loom-u_2"), [String("/srv/loom/sandboxes/u_2/agents/a_1")])
    assert(args[0] == "exec" and args[1] == "-i" and args[2] == "loom-u_2" and args[3] == "sh" and args[4] == "-c" and args[6] == "loom")
    assert(args[5].contains("mkdir -p --") and args[5].contains("tar -x --no-same-owner -f - -C /"))
    assert(args.len() == 8 and args[7] == "/srv/loom/sandboxes/u_2/agents/a_1")
    assert(write_all_args(String("loom-u_2"), List<String>()).len() == 7)
    let bytes = archive([(String("/srv/loom/sandboxes/u_2/agents/a_1/AGENTS.md"), "Be brief.".to_bytes()), (String("/srv/loom/sandboxes/u_2/agents/a_1/.claude/skills/review/SKILL.md"), "---\nname: review\n---\n".to_bytes())])
    let t = tar.Tar.open(bytes)!
    let entries = t.entries()
    assert(entries.len() == 2)
    assert(entries[0].name == "srv/loom/sandboxes/u_2/agents/a_1/AGENTS.md" and entries[0].kind == Kind.File and entries[0].mode == 0o644)
    assert(t.read(0) == "Be brief.".to_bytes())
    assert(entries[1].name == "srv/loom/sandboxes/u_2/agents/a_1/.claude/skills/review/SKILL.md" and t.read(1) == "---\nname: review\n---\n".to_bytes())
    // Dated now, so what reads a file's time sees it's new.
    assert(entries[0].modified.unix_ms > 1700000000000)
}

// The size of a folder, in bytes, from what `du -sk` says.
fn kilobytes(said: String) -> i64? {
    let first = said.trim().split("\t")[0].split(" ")[0].copy()
    let k = i64.parse(first) else return none
    return some(k * 1024)
}

@test
fn du_says_kilobytes() {
    assert(kilobytes(String("2048\t/data/sandboxes/u_2\n")) == some(2097152))
    assert(kilobytes(String("du: cannot read")) == none)
}

// What `sh -c` runs at each end of a move (`Sandboxes.move_folder`), with the folder as
// $1, in the sandbox that sees it. Each goes into the folder only when it's a folder of
// its own, not a link nor reached through one: `cd -P` follows what's there, and the
// folder it lands in must be the one named. tar doesn't follow a link inside it either.
// A folder that isn't there, or is a link, has nothing to move, and the link stays.
const PACK: str = #"[ -d "$1" ] && [ ! -L "$1" ] || exit 0; cd -P -- "$1" && [ "$(pwd -P)" = "$1" ] || { echo "$1 isn't a folder of its own" >&2; exit 1; }; exec tar -c -f - ."#
const UNPACK: str = #"mkdir -p -- "$1" && cd -P -- "$1" && [ "$(pwd -P)" = "$1" ] || { echo "$1 isn't a folder of its own" >&2; exit 1; }; exec tar -x --no-same-owner -f -"#
// Empties the old folder once what it held is in the new one, and removes it where it
// isn't a sandbox's mount. rm doesn't follow the links it removes.
const CLEAR: str = #"[ -d "$1" ] && [ ! -L "$1" ] || exit 0; cd -P -- "$1" && [ "$(pwd -P)" = "$1" ] || { echo "$1 isn't a folder of its own" >&2; exit 1; }; chmod -R u+rwX . 2>/dev/null; find . -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + || exit 1; cd / && rmdir -- "$1" 2>/dev/null; exit 0"#

// How long a move waits for the old folder's sandbox to send more, in seconds, before
// it takes it to have stopped.
const QUIET_MOST: i64 = 120

// The path an entry of the old folder's archive goes to in the new folder, or none for
// the folder itself and for a path that would climb out of it.
fn inside(entry: String) -> String? {
    var path = entry.copy()
    while path.starts_with("./") { path = path[2..].copy() }
    if path.len() == 0 or path == "." or path.starts_with("/") { return none }
    for part in path.split("/") {
        if part == ".." { return none }
    }
    return some(path)
}

@test
fn a_moved_entry_stays_in_its_folder() {
    assert(inside(String("./notes/a.md")) == some(String("notes/a.md")))
    assert(inside(String("./")) == none and inside(String(".")) == none and inside(String("")) == none)
    assert(inside(String("./../x")) == none and inside(String("a/../../x")) == none and inside(String("/etc/passwd")) == none)
    assert(inside(String("a..b/c")) == some(String("a..b/c")))
}

// Passes on the folders and regular files of the archive `r` reads to `w`, each with
// its time and permission bits: no link, hard link, device, pipe or socket, and nothing
// whose path climbs out. How many went.
fn only_files<R: io.Reader, W: io.Writer>(r: mut StreamReader<R>, w: mut StreamWriter<W>) -> usize ! String {
    var n: usize = 0
    while let e = try r.next() {
        let path = inside(e.name.copy()) else continue
        w.set_time(e.modified)
        if e.kind == Kind.Dir {
            try w.add_dir(path)
            n += 1
        } else if e.kind == Kind.File {
            try w.add_from(path, u64(e.size), mut r, e.mode & 0o777)
            n += 1
        }
    }
    return n
}

@test
fn a_move_passes_on_only_folders_and_files() {
    var t = tar.Writer.new()
    t.add_dir("./")
    t.add_dir("./notes")
    t.add("./notes/a.md", "kept".to_bytes(), mode: 0o4755)
    t.add_symlink("./key", "/srv/loom/secret.key")
    t.add_symlink("./up", "..")
    t.add("./../out.md", "out".to_bytes())
    t.add("/etc/passwd", "root".to_bytes())
    t.add("./b.md", "also".to_bytes())
    var r = StreamReader.new(io.ByteReader.new(t.finish()))
    var w = StreamWriter.new(List<u8>())
    assert(only_files(mut r, mut w)! == 3)
    let got = tar.Tar.open(w.finish()!)!
    let entries = got.entries()
    assert(entries.len() == 3)
    assert(entries[0].name == "notes" and entries[0].kind == Kind.Dir)
    assert(entries[1].name == "notes/a.md" and entries[1].kind == Kind.File and entries[1].mode == 0o755 and got.read(1) == "kept".to_bytes())
    assert(entries[2].name == "b.md" and got.read(2) == "also".to_bytes())
}

// The old folder's archive, as its sandbox sends it, a piece at a time.
struct Packed {
    child: Child
    left: List<u8>
    at: usize
}

impl io.Reader for Packed {
    fn read(mut self, buf: mut List<u8>, n: usize) -> usize ! String {
        if n == 0 { return 0 }
        var quiet: i64 = 0
        while self.at >= self.left.len() {
            if self.child.ended() { return 0 }
            self.left = self.child.read(1000)
            self.at = 0
            if self.left.len() == 0 {
                quiet += 1
                if quiet >= QUIET_MOST { fail "the old folder's sandbox stopped sending it" }
            }
        }
        let k = if n < self.left.len() - self.at { n } else { self.left.len() - self.at }
        buf.extend(self.left[self.at..self.at + k])
        self.at += k
        return k
    }
}

// The new folder's sandbox, taking the archive in.
struct Unpacking {
    child: Child
}

impl io.Writer for Unpacking {
    fn write(mut self, bytes: List<u8>) ! String {
        match self.child.write(bytes) {
            ok => {},
            err(e) => fail "the new folder's sandbox stopped taking it: {e}",
        }
    }
}

// Runs `pack`, which sends a folder as a tar stream, and `unpack`, which takes one in,
// with only the folders and regular files of the first passed on to the second
// (`only_files`). Both are waited for, whatever goes wrong.
fn carry(pack: own Command, unpack: own Command) ! Error {
    var packer = try pack.stdin(Stdio.Null).stdout(Stdio.Pipe).stderr(Stdio.Pipe).spawn()
    let unpacker = match unpack.stdin(Stdio.Pipe).stdout(Stdio.Null).stderr(Stdio.Pipe).spawn() {
        ok(c) => c,
        err(e) => {
            packer.kill()
            _ = packer.wait()
            fail "{e}"
        },
    }
    var r = StreamReader.new(Packed { child: packer, left: List<u8>(), at: 0 })
    var w = StreamWriter.new(Unpacking { child: unpacker })
    var why = match only_files(mut r, mut w) {
        ok(_) => String(),
        err(e) => e,
    }
    var sent = r.into_inner().child
    if why.len() > 0 { sent.kill() }
    let packed = sent.wait()
    match w.finish() {
        ok(u) => {
            var taking = u.child
            let unpacked = taking.wait()
            if why.len() == 0 and not unpacked.status.success() { why = "the new folder didn't take it: {unpacked.error_text().trim()}" }
        },
        err(e) => if why.len() == 0 { why = e },
    }
    if why.len() == 0 and not packed.status.success() { why = "the old folder couldn't be read: {packed.error_text().trim()}" }
    if why.len() > 0 { fail why }
}

struct Puller {
    boxes: Sandboxes
    done: Sender<String>
}

impl Task for Puller {
    fn run(own self) {
        var p = self
        let said = match p.boxes.pull() {
            ok => String(),
            err(e) => "{e}",
        }
        p.done.send(said)
    }
}

// Fetches the sandboxes' image on a thread of its own, and sends `done` "" once it's
// here, or why it isn't.
pub fn pull_on_thread(boxes: own Sandboxes, done: own Sender<String>) {
    _ = unsafe { Thread.spawn(Puller { boxes: boxes, done: done }) }
}

// The name of `user`'s own sandbox.
pub fn name(user: String) -> String {
    return "loom-{user}"
}

// Why `runtime` can't run sandboxes here, or none if it can: it's on the PATH and
// says its version. A sandbox mounts the instance's folders at the same paths
// as outside, which takes Linux.
pub fn missing(runtime: String) -> String? {
    if env.os() == "windows" { return some(String("a sandbox sees the instance's folders at the same paths as outside, which takes Linux; on Windows, run the instance in WSL or on a server")) }
    return match Command.new(runtime).arg(String("--version")).output() {
        ok(out) => if out.status.success() { none } else { some(out.error_text().trim().copy()) },
        err(e) => some("{e}"),
    }
}

impl Sandboxes {
    // `user`'s own folder, which their sandboxes see.
    pub fn home(self, user: String) -> String {
        return "{self.root}/{user}"
    }

    // Where `user`'s private agent `agent` has its folder, which its own sandbox
    // sees: beside its person's folder, not in it, since their other agents see
    // theirs, and a link one of them put at its path would have its sandbox
    // mount wherever the link led. No user's id has a dot in it.
    pub fn private_folder(self, user: String, agent: String) -> String {
        return "{self.root}/{user}.private/{agent}"
    }

    // The one folder `place`'s sandbox sees of the person's, besides acp/: its
    // private agent's own, or else its person's.
    pub fn seen(self, place: Place) -> String {
        if place.private and place.its_own() { return self.private_folder(place.user.copy(), place.agent.copy()) }
        return self.home(place.user.copy())
    }

    // Makes sure `place`'s sandbox is running: the person's, made for this
    // gate's port, or an agent's own, closed to the network or private.
    pub fn ready(self, place: Place) ! Error {
        let user = place.user.copy()
        let home = self.seen(place.copy())
        try fs.make_dir_all(home.copy())
        try fs.make_dir_all(self.acp.copy())
        let box = place.name()
        let closed = place.closed
        let label = if closed { String(CLOSED) } else { self.gate_url() }
        // Made for a gate somewhere else, or seeing another folder (an agent's own
        // that was made private, or normal again): made again, keeping the folders.
        let looked = try Command.new(self.runtime.copy()).args([String("inspect"), String("--format"), String(#"{{.State.Running}} {{index .Config.Labels "loom.gate"}} {{index .Config.Labels "loom.sees"}}"#), box.copy()]).output()
        if looked.status.success() {
            let said = looked.text().trim().copy()
            if said == "true {label} {home}" { return }
            if said == "false {label} {home}" {
                try self.run([String("start"), box])
                return
            }
            try self.run([String("rm"), String("-f"), box.copy()])
        }
        let head: List<String> = [String("run"), String("-d"), String("--name"), box.copy(), String("--label"), "loom.gate={label}", String("--label"), "loom.sees={home}", String("--label"), "loom.user={user}", String("--init")]
        let rest: List<String> = [String("-v"), "{home}:{home}:Z", String("-v"), "{self.acp}:{self.acp}:ro,z", String("-e"), "HOME={home}", String("-w"), home.copy(), String("--entrypoint"), String("sleep"), self.image.copy(), String("infinity")]
        // With every limit first. Where the system doesn't let loom set one (no
        // cgroup controllers delegated to its user, or storage without quotas), the
        // sandbox goes without that one, and still keeps the person apart.
        var limits = true
        var disk = true
        loop {
            var args = head.copy()
            args.extend(isolation(self.runtime.copy(), self.gate, closed))
            if limits {
                args.extend([String("--memory"), String(MEMORY), String("--cpus"), String(CPUS), String("--pids-limit"), String(PIDS)])
            }
            if disk {
                args.extend([String("--storage-opt"), "size={DISK}"])
            }
            args.extend(rest.copy())
            let made = try Command.new(self.runtime.copy()).args(args).output()
            if made.status.success() { return }
            let why = made.error_text().trim().copy()
            match Command.new(self.runtime.copy()).args([String("rm"), String("-f"), box.copy()]).output() {
                ok(_) => {},
                err(_) => {},
            }
            let lower = why.to_lower_root()
            if disk and (lower.contains("storage-opt") or lower.contains("storage opt") or lower.contains("quota") or lower.contains("size")) {
                eprintln("loom: {box} has no limit on its own disk, which this system's storage doesn't let loom set (it takes overlay on XFS with project quotas); its person's folder is still kept to 10 GB: {why}")
                disk = false
            } else if limits and lower.contains("cgroup") {
                eprintln("loom: {box} runs without limits on memory and CPU, which this system doesn't let loom set: {why}")
                limits = false
            } else {
                fail "{self.runtime} didn't start the sandbox: {why}"
            }
        }
    }

    // How much the folder `place`'s sandbox sees holds, in bytes, measured in the
    // sandbox, or none when it can't be told (the sandbox isn't running).
    pub fn used(self, place: Place) -> i64? {
        let home = self.seen(place.copy())
        let out = match Command.new(self.runtime.copy()).args([String("exec"), place.name(), String("du"), String("-sk"), String("--"), home]).output() {
            ok(o) => o,
            err(_) => return none,
        }
        // du gives the total even past a folder it can't read, saying so on stderr.
        return kilobytes(out.text())
    }

    // What runs `command` with `args` in `place`'s sandbox, in `folder`, with the
    // environment variables `names` from the program's own environment.
    pub fn wrap(self, place: Place, folder: String, names: List<String>, command: String, args: List<String>) -> (String, List<String>) {
        var out: List<String> = [String("exec"), String("-i"), String("-w"), folder.copy()]
        for n in names {
            out.push(String("-e"))
            out.push(n.copy())
        }
        out.push(place.name())
        out.push(command.copy())
        out.extend(args.copy())
        return (self.runtime.copy(), out)
    }

    // Stops and removes an agent's own sandbox, once its network opens up again
    // and it isn't private, or it's deleted. The folders stay.
    pub fn drop_place(self, place: Place) {
        if not place.its_own() { return }
        self.drop_box(place.name())
    }

    // Stops and removes the sandbox `box`. The folders it sees stay.
    pub fn drop_box(self, box: own String) {
        let stop: List<String> = if self.runtime == "docker" { [String("rm"), String("-f"), box.copy()] } else { [String("rm"), String("-f"), String("-t"), String("0"), box] }
        match Command.new(self.runtime.copy()).args(stop).output() {
            ok(_) => {},
            err(e) => eprintln("loom: removing a sandbox: {e}"),
        }
    }

    // The id of the image sandboxes are made from, or none while the runtime doesn't
    // have it here.
    pub fn image_id(self) -> String? {
        let out = match Command.new(self.runtime.copy()).args([String("image"), String("inspect"), String("--format"), String(#"{{.Id}}"#), self.image.copy()]).output() {
            ok(o) => o,
            err(_) => return none,
        }
        let id = out.text().trim().copy()
        if not out.status.success() or id.len() == 0 { return none }
        return some(id)
    }

    // Fetches the image sandboxes are made from: slow, so on a thread of its own.
    pub fn pull(self) ! Error {
        try self.run([String("pull"), String("-q"), self.image.copy()])
    }

    // The sandboxes made from another image than `id`, the image's they're made from
    // now: from an image an older loom ran, whose `loom` is the older one's.
    pub fn stale_boxes(self, id: String) -> List<String> {
        let listed = match Command.new(self.runtime.copy()).args([String("ps"), String("-a"), String("--filter"), String("label=loom.user"), String("--format"), String(#"{{.Names}}"#)]).output() {
            ok(o) => o.text(),
            err(_) => return List<String>(),
        }
        var names = List<String>()
        for line in listed.lines() {
            let n = line.trim().copy()
            if n.len() > 0 { names.push(n) }
        }
        if names.len() == 0 { return names }
        var args: List<String> = [String("container"), String("inspect"), String("--format"), String(#"{{.Name}} {{.Image}}"#)]
        args.extend(names)
        return match Command.new(self.runtime.copy()).args(args).output() {
            ok(o) => stale(o.text(), id),
            err(_) => List<String>(),
        }
    }

    // Stops `user`'s sandboxes and removes them, with their folder and their private
    // agents' (`private_folder`). In Podman, what
    // their agents made there may belong to other ids of the sandbox's, so the
    // folder goes in the sandboxes' user namespace (`podman unshare`). In Docker
    // it's all loom's own user's, which may first need to be let into folders an
    // agent closed.
    pub fn remove(self, user: String) {
        if user.len() == 0 or user.contains("/") or user.contains(".") { return }
        let docker = self.runtime == "docker"
        var boxes: List<String> = [name(user.copy())]
        match Command.new(self.runtime.copy()).args([String("ps"), String("-a"), String("--filter"), "label=loom.user={user}", String("--format"), String(#"{{.Names}}"#)]).output() {
            ok(out) => {
                for line in out.text().split("\n") {
                    let n = line.trim().copy()
                    if n.starts_with("{name(user.copy())}-") and not boxes.contains(n.copy()) { boxes.push(n) }
                }
            },
            err(_) => {},
        }
        for box in boxes {
            let stop: List<String> = if docker { [String("rm"), String("-f"), box.copy()] } else { [String("rm"), String("-f"), String("-t"), String("0"), box.copy()] }
            match Command.new(self.runtime.copy()).args(stop).output() {
                ok(_) => {},
                err(e) => eprintln("loom: removing a sandbox: {e}"),
            }
        }
        self.remove_folder(self.home(user.copy()))
        self.remove_folder("{self.root}/{user}.private")
    }

    // Removes the folder `home`, in the data folder's sandboxes/, as `remove` says.
    fn remove_folder(self, home: String) {
        let docker = self.runtime == "docker"
        if self.root.len() < 2 or not home.starts_with("{self.root}/") or not fs.exists(home.copy()) { return }
        if docker {
            match Command.new(String("chmod")).args([String("-R"), String("u+rwX"), String("--"), home.copy()]).output() {
                ok(_) => {},
                err(_) => {},
            }
        }
        let removing = if docker { Command.new(String("rm")).args([String("-rf"), String("--"), home.copy()]) } else { Command.new(self.runtime.copy()).args([String("unshare"), String("rm"), String("-rf"), String("--"), home.copy()]) }
        match removing.output() {
            ok(out) => if not out.status.success() { eprintln("loom: removing {home}: {out.error_text().trim()}") },
            err(e) => eprintln("loom: removing {home}: {e}"),
        }
    }

    // Writes `data` at `path` in `place`'s sandbox, making its folders. The
    // instance never writes in a person's folder itself: a link the person's
    // agent put there could lead it to the instance's own files.
    pub fn write(self, place: Place, path: String, data: List<u8>) ! Error {
        let script = String(#"mkdir -p -- "$(dirname -- "$1")" && cat > "$1""#)
        let out = try Command.new(self.runtime.copy()).args([String("exec"), String("-i"), place.name(), String("sh"), String("-c"), script, String("loom"), path.copy()]).input(data).output()
        if not out.status.success() { fail "writing {path} in the sandbox didn't work: {out.error_text().trim()}" }
    }

    // Makes the folders `dirs` and writes `files`, each a path and what goes there, in
    // `place`'s sandbox, all with one exec: a tar stream on its input, which tar there
    // takes apart, rather than an exec for each file, which took 50-150 ms each.
    pub fn write_all(self, place: Place, dirs: List<String>, files: List<(String, List<u8>)>) ! Error {
        if dirs.len() == 0 and files.len() == 0 { return }
        let out = try Command.new(self.runtime.copy()).args(write_all_args(place.name(), dirs)).input(archive(files)).output()
        if not out.status.success() { fail "writing in the sandbox didn't work: {out.error_text().trim()}" }
    }

    // Moves what an agent's folder holds from `from`, which `out`'s sandbox sees, to `to`,
    // which `into`'s sees: as an agent made private goes from its person's folder to its
    // own, and back (PLAN.md, "Private agents"). The instance touches neither folder
    // itself, since the sandboxes can put links in them: tar in `out` reads the old one
    // without following a link at its path or in it, the instance passes on only its
    // folders and regular files (`only_files`), and tar in `into` writes them, so nothing
    // outside the old folder is read and nothing outside the new one is written. Once
    // they're all in, the old folder is emptied, in `out`. If anything fails, the old
    // folder is as it was, and what got into the new one stays there.
    pub fn move_folder(self, out: Place, from: String, into: Place, to: String) ! Error {
        try self.ready(out.copy())
        try self.ready(into.copy())
        try carry(self.script(out.copy(), false, PACK, from.copy()), self.script(into, true, UNPACK, to.copy()))
        let cleared = try self.script(out, false, CLEAR, from.copy()).output()
        if not cleared.status.success() { fail "its old folder, {from}, couldn't be emptied: {cleared.error_text().trim()}" }
    }

    // What runs `script` with `sh -c` in `place`'s sandbox, with `folder` as $1, and
    // with its standard input if `input`.
    fn script(self, place: Place, input: bool, script: str, folder: own String) -> Command {
        var args: List<String> = [String("exec")]
        if input { args.push(String("-i")) }
        args.extend([place.name(), String("sh"), String("-c"), String(script), String("loom"), folder])
        return Command.new(self.runtime.copy()).args(args)
    }

    // Removes the file `path` in `place`'s sandbox, or the folder, if it's empty.
    pub fn remove_file(self, place: Place, path: String) ! Error {
        try self.run([String("exec"), place.name(), String("rm"), String("-f"), String("--"), path.copy()])
    }

    pub fn remove_dir(self, place: Place, path: String) ! Error {
        try self.run([String("exec"), place.name(), String("rmdir"), String("--"), path.copy()])
    }

    // The file at `path` as `place`'s sandbox sees it, for a file its agent
    // sends: read in the sandbox, so a link can't lead to the instance's own files.
    pub fn read(self, place: Place, path: String) -> List<u8>? {
        let out = match Command.new(self.runtime.copy()).args([String("exec"), place.name(), String("cat"), String("--"), path.copy()]).output() {
            ok(o) => o,
            err(_) => return none,
        }
        if not out.status.success() { return none }
        return some(out.stdout)
    }

    fn run(self, args: List<String>) ! Error {
        let out = try Command.new(self.runtime.copy()).args(args.copy()).output()
        if not out.status.success() { fail "{self.runtime} {args.join(" ")} didn't work: {out.error_text().trim()}" }
    }
}

// What runs `script` with `sh -c` here, with `folder` as $1, as a sandbox would.
fn here(script: str, folder: own String) -> Command {
    return Command.new(String("sh")).args([String("-c"), String(script), String("loom"), folder])
}

// The scripts of a move, run here rather than in sandboxes, which this test can't
// count on: a folder's files and folders go across, its links don't and aren't
// followed, and the old folder is emptied without following one either.
@test
fn a_move_follows_no_link() {
    // On macOS, its tar gives each file binary xattrs in pax headers, which std.tar
    // doesn't read yet (CLX-478); the sandboxes' GNU tar writes none.
    if env.os() == "windows" or env.os() == "macos" { return }
    let dir = fs.temp_dir()!
    fs.make_dir_all("{dir}/old/notes/deep")!
    fs.write_text("{dir}/old/notes/a.md", "kept")!
    fs.write_text("{dir}/old/notes/deep/b.md", "deep")!
    fs.write_text("{dir}/secret.key", "the instance's")!
    fs.make_dir_all("{dir}/elsewhere")!
    fs.write_text("{dir}/elsewhere/x.md", "elsewhere")!
    fs.make_link("{dir}/secret.key", "{dir}/old/key")!
    fs.make_link("{dir}/elsewhere", "{dir}/old/notes/up")!
    if let err(e) = carry(here(PACK, "{dir}/old"), here(UNPACK, "{dir}/new")) { panic("the move: {e}") }
    assert(fs.read_text("{dir}/new/notes/a.md")! == some(String("kept")) and fs.read_text("{dir}/new/notes/deep/b.md")! == some(String("deep")))
    assert(fs.kind("{dir}/new/key")! == none and fs.kind("{dir}/new/notes/up")! == none)
    assert(here(CLEAR, "{dir}/old").output()!.status.success())
    assert(fs.kind("{dir}/old")! == none and fs.read_text("{dir}/secret.key")! == some(String("the instance's")) and fs.read_text("{dir}/elsewhere/x.md")! == some(String("elsewhere")))

    // A link at the old folder's path isn't followed: nothing moves, and it stays.
    fs.make_link("{dir}/elsewhere", "{dir}/linked")!
    carry(here(PACK, "{dir}/linked"), here(UNPACK, "{dir}/new2"))!
    assert(fs.kind("{dir}/new2/x.md")! == none)
    assert(here(CLEAR, "{dir}/linked").output()!.status.success())
    assert(fs.kind("{dir}/linked")! == some(fs.Kind.Link) and fs.read_text("{dir}/elsewhere/x.md")! == some(String("elsewhere")))

    // Nor one on the way to it: the move fails, and the new folder gets nothing.
    fs.make_link(dir.copy(), "{dir}/via")!
    assert(match carry(here(PACK, "{dir}/via/elsewhere"), here(UNPACK, "{dir}/new3")) { ok => false, err(_) => true })
    assert(fs.kind("{dir}/new3/x.md")! == none)
    assert(not here(CLEAR, "{dir}/via/elsewhere").output()!.status.success() and fs.read_text("{dir}/elsewhere/x.md")! == some(String("elsewhere")))
    // And a new folder reached through one takes nothing.
    assert(match carry(here(PACK, "{dir}/new"), here(UNPACK, "{dir}/via/elsewhere")) { ok => false, err(_) => true })
    assert(fs.kind("{dir}/elsewhere/notes")! == none)
    fs.remove_dir_all(dir)!
}

@test
fn a_private_agents_sandbox_sees_only_its_own_folder() {
    let b = Sandboxes { runtime: String("podman"), image: String(IMAGE), root: String("/srv/loom/sandboxes"), acp: String("/srv/loom/acp"), gate_host: String("127.0.0.1"), gate: 4000 }
    assert(b.seen(person(String("u_2"))) == "/srv/loom/sandboxes/u_2")
    assert(b.seen(Place { user: String("u_2"), agent: String("a_1"), closed: true, private: false }) == "/srv/loom/sandboxes/u_2")
    let private = Place { user: String("u_2"), agent: String("a_1"), closed: false, private: true }
    assert(b.seen(private.copy()) == "/srv/loom/sandboxes/u_2.private/a_1" and b.tools_url(private) == "http://127.0.0.1:4000")
    let both = Place { user: String("u_2"), agent: String("a_1"), closed: true, private: true }
    assert(b.seen(both.copy()) == "/srv/loom/sandboxes/u_2.private/a_1" and b.tools_url(both) == "http://127.0.0.1:{egress.PORT}")
}
