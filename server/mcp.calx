module server.mcp

// `loom mcp`: loom's own tools as an MCP server over standard input and output
// (PLAN.md, "Loom's own tools"). The instance passes it to every ACP session,
// with LOOM_URL and a token for that agent, LOOM_MCP_TOKEN, in its
// environment. It asks the instance for the tools and hands each call to it,
// so what an agent may do is decided there, with its person's rights.
//
// In Code Mode (PLAN.md, "Code Mode"), with LOOM_CODE_MODE=1, it offers
// search_tools and run_code, with loom's tools that reach the person's app and
// devices beside them (tools.DIRECT_TOOLS), and is itself the client of the agent's MCP
// servers and its person's plugins' tool servers, which the instance gives it
// and the agent program isn't given. A script's calls come here, and go to the
// instance (loom's own tools) or to the server, once the instance says the
// agent's permission mode allows the call or the person said yes.
//
// MCP is JSON-RPC 2.0, one message a line. Requests are answered in turn: a
// message_agent call waits for the other agent's reply. It speaks both eras of
// MCP (PLAN.md, "MCP versions"): a request whose `_meta` says
// 2026-07-28 is answered as that version says, with no initialize, and a
// client that says initialize is answered in the legacy era's version it
// asks for, or 2025-11-25.
import std.bytes
import std.env
import std.fs
import std.http.{Header, Request, get, post}
import std.io
import std.json.{Json, parse}
import std.process.{Child}
import std.thread.{Task}
import std.time.{Instant}
import shared.obj.{Obj, at, int_at, merge, str_at}
import shared.tools
import server.codemode
import server.codemode.{Tool}
import server.icons
import server.mcpclient.{Server}
import server.mcpclient
import server.t3

const CALL_WAIT: u32 = 3600000    // message_agent waits on a whole reply
const DENO_WAIT: u32 = 900000     // the first script waits while Deno is fetched
const MAX_ANSWER: usize = 16777216

fn reply(id: Json, result: Json) {
    println("{Obj.new().s("jsonrpc", String("2.0")).j("id", id).j("result", result).done()}")
}

fn reply_error(id: Json, number: i64, message: String) {
    println("{Obj.new().s("jsonrpc", String("2.0")).j("id", id).j("error", Obj.new().i("code", number).s("message", message).done()).done()}")
}

fn server_info() -> Json {
    return Obj.new().s("name", String("loom")).s("version", String("1")).done()
}

// Every version of MCP loom mcp speaks, newest first.
fn versions() -> Json {
    var out = List<Json>()
    out.push(Json.Str(String(mcpclient.MODERN)))
    for v in mcpclient.LEGACY {
        out.push(Json.Str(String(v)))
    }
    return Json.Array(out)
}

// A result as the modern era gives it: saying it's final, and in its `_meta`
// who gives it.
fn modern_result(result: Json) -> Json {
    let first = merge(Obj.new().s("resultType", String("complete")).done(), result)
    return merge(first, Obj.new().j("_meta", Obj.new().j("io.modelcontextprotocol/serverInfo", server_info()).done()).done())
}

// A list's result in the modern era: what loom offers an agent changes with
// its person's plugins and rights, so it's stale at once, and it's theirs.
fn modern_list(result: Json) -> Json {
    return modern_result(merge(result, Obj.new().i("ttlMs", 0).s("cacheScope", String("private")).done()))
}

// What server/discover answers, before modern_list.
fn discovered() -> Json {
    return Obj.new().j("supportedVersions", versions()).j("capabilities", Obj.new().j("tools", Obj.new().done()).done()).done()
}

// A tool result for the agent to read.
fn said(text: String) -> Json {
    return Obj.new().j("content", Json.Array([Obj.new().s("type", String("text")).s("text", text).done()])).done()
}

// A tool result that says what went wrong, for the agent to read.
fn failed(text: String) -> Json {
    return Obj.new().j("content", Json.Array([Obj.new().s("type", String("text")).s("text", text).done()])).b("isError", true).done()
}

fn is_error(result: Json) -> bool {
    return at(result, "isError") == Json.Bool(true)
}

struct Link {
    base: String
    token: String
}

impl Link {
    fn headers(self) -> List<Header> {
        return [Header { name: String("Authorization"), value: "Bearer {self.token}" }, Header { name: String("Content-Type"), value: String("application/json") }]
    }

    fn fetch(self, path: str, wait: u32) -> Json ! Error {
        var req = get("{self.base}{path}", self.headers(), wait, MAX_ANSWER)
        return try answer_of(mut req)
    }

    fn ask_tools(self) -> Request {
        return get("{self.base}/api/mcp/tools", self.headers(), 30000, MAX_ANSWER)
    }
}

fn answer_of(req: mut Request) -> Json ! Error {
    let r = try req.wait()
    let text = String.from_utf8(r.body) ?? String()
    if r.status != 200 { fail "the instance answered {r.status}: {text}" }
    return try parse(text)
}

// loom's own tools. The session asks for them as it starts, which also opens
// its connection to the instance (the first costs a few ms), and the first to
// want them takes that answer.
fn own_tools(link: Link, c: mut Code) -> Json ! Error {
    var req = c.warm.take() else { var fresh = link.ask_tools(); return try answer_of(mut fresh) }
    return try answer_of(mut req)
}

impl Link {
    // A POST to the instance, whose answer is a tool result.
    fn send(self, path: str, body: Json) -> Json {
        var req = post("{self.base}{path}", self.headers(), "{body}".to_bytes(), CALL_WAIT, MAX_ANSWER)
        match req.wait() {
            ok(r) => {
                let text = String.from_utf8(r.body) ?? String()
                if r.status != 200 { return failed("loom couldn't do that ({r.status}): {text}") }
                return match parse(text) {
                    ok(j) => j,
                    err(_) => failed(String("loom's answer wasn't JSON")),
                }
            },
            err(e) => return failed("loom didn't answer: {e}"),
        }
    }

    fn call(self, name: String, arguments: Json) -> Json {
        return self.send("/api/mcp/call", Obj.new().s("name", name).j("arguments", arguments).done())
    }

    // A tool call answered with the instance's own text, passed on as it came
    // rather than read and written again (a screenshot is megabytes of it).
    fn call_text(self, name: String, arguments: Json) -> String {
        var req = post("{self.base}/api/mcp/call", self.headers(), "{Obj.new().s("name", name).j("arguments", arguments).done()}".to_bytes(), CALL_WAIT, MAX_ANSWER)
        match req.wait() {
            ok(r) => {
                let text = String.from_utf8(r.body) ?? String()
                if r.status != 200 { return "{failed("loom couldn't do that ({r.status}): {text}")}" }
                // One line, an object, as the answer to its request must be.
                if text.starts_with("\{") and text.find("\n") == none { return text }
                return "{failed(String("loom's answer wasn't JSON"))}"
            },
            err(e) => return "{failed("loom didn't answer: {e}")}",
        }
    }
}

fn reply_text(id: Json, result: String) {
    println("\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":{result}\}")
}

// The instance's text for a tool's result, an object on one line, saying it's
// final as the modern era's results do.
fn final_text(result: String) -> String {
    let rest = result[1..].trim_start().copy()
    if rest.starts_with("\}") { return String("\{\"resultType\":\"complete\"\}") }
    return "\{\"resultType\":\"complete\",{rest}"
}

// --- Code Mode ---

struct Code {
    on: bool
    deno: String
    loaded: bool
    tools: List<Tool>
    servers: Map<String, Server>
    trouble: List<String>    // servers that didn't start, and why
    said_trouble: List<String>    // the trouble search_tools has said in this session
    signing: List<String>    // servers that wait for their person to sign in
    added: bool    // an add_mcp_server call went, so the agent may have a server more
    runs: i64
    warm: Request?    // loom's own tools, asked for as the session starts
    folder: String    // the session's prelude and Deno's cache, made at the first
    spare: Child?    // a Deno waiting for the next script (codemode.wait)
    spare_at: Instant?    // when it started
    done: Child?    // the last script's Deno, ended once its result has gone
    known_icons: Json    // what the icons the instance keeps of each server are known by (icons.key)
}

// Starts one of the person's MCP servers and lists its tools.
struct Starter {
    at: usize
    spec: Json
    back: Sender<Started>
}

struct Started {
    at: usize
    name: String
    server: Server?
    tools: List<Json>
    trouble: String
}

impl Task for Starter {
    fn run(own self) {
        let n = self.at
        var back = self.back
        let name = str_at(self.spec.copy(), "name") ?? String()
        let done = match mcpclient.start(self.spec) {
            ok(s) => {
                var server = s
                match server.tools() {
                    ok(listed) => Started { at: n, name: name, server: some(server), tools: listed, trouble: String() },
                    err(e) => Started { at: n, name: name.copy(), server: some(server), tools: List<Json>(), trouble: "{name}: {e}" },
                }
            },
            err(e) => Started { at: n, name: name.copy(), server: none, tools: List<Json>(), trouble: "{name} didn't start: {e}" },
        }
        back.send(done)
    }
}

// Fetches a server's icons (server/icons.calx) where the agent runs, and gives
// them to the instance, which keeps them for its badge. It runs on a thread
// of its own, which nothing waits for: a slow icon never holds up the tools.
struct IconFetch {
    link: Link
    server: String
    info: Json
    known: String
}

impl Task for IconFetch {
    fn run(own self) {
        let got = icons.of_server(self.info, self.known)
        if not got.fresh { return }
        // Icons it couldn't fetch are tried again by the next session.
        if got.key.len() > 0 and got.light.len() == 0 and got.dark.len() == 0 { return }
        let body = Obj.new().s("server", self.server).s("key", got.key).s("icon", bytes.base64(got.light)).s("icon_dark", bytes.base64(got.dark)).done()
        let answer = self.link.send("/api/mcp/icon", body)
        if is_error(answer.copy()) { eprintln("loom mcp: an icon: {codemode.error_of(answer)}") }
    }
}

impl Code {
    // A server just started: its icons are fetched when they aren't the ones
    // the instance keeps.
    fn note_icons(self, link: Link, name: own String, info: own Json) {
        // A plugin's tool server has its plugin's icon, not one of its own.
        if name.starts_with("plugin-") { return }
        let known = (self.known_icons.get(name.copy()) ?? Json.Null).as_str() ?? String()
        _ = unsafe { Thread.spawn(IconFetch { link: Link { base: link.base.copy(), token: link.token.copy() }, server: name, info: info, known: known }) }
    }

    // Every tool a script can call: loom's own, and each server's, which are
    // started the first time.
    fn load(self: mut Code, link: Link) {
        if self.loaded {
            if self.signing.len() > 0 { self.signed_since(link) }
            if self.added {
                self.added = false
                self.take_added(link)
            }
            self.relist(link)
            return
        }
        self.loaded = true
        match own_tools(link, mut self) {
            ok(t) => {
                var listed = List<Json>()
                if let Json.Array(l) = at(t, "tools") { listed = l.copy() }
                self.tools.extend(codemode.tools_of(String("loom"), listed))
            },
            err(e) => self.trouble.push("loom's own tools: {e}"),
        }
        let given = match link.fetch("/api/mcp/servers", 30000) {
            ok(g) => g,
            err(e) => {
                self.trouble.push("the MCP servers: {e}")
                Json.Null
            },
        }
        self.known_icons = at(given.copy(), "icons")
        if let Json.Array(specs) = at(given, "servers") { self.take_in(link, specs.copy()) }
    }

    // Starts the servers `specs` give, and takes in their tools. They start side
    // by side, each on a thread of its own, and are taken in the order given.
    fn take_in(self: mut Code, link: Link, specs: List<Json>) {
        var back = Receiver<Started>()
        var n: usize = 0
        for spec in specs {
            _ = unsafe { Thread.spawn(Starter { at: n, spec: spec.copy(), back: back.sender() }) }
            n += 1
        }
        if n == 0 { return }
        var got = Map<usize, Started>()
        while let s = back.wait() {
            got.insert(s.at, s)
            if got.len() == n { break }
        }
        for k in 0..n {
            let s = got.remove(k) else { continue }
            let name = s.name
            let started = s.server
            // A server that wants a sign-in gets a renewed token, when
            // there's one to be had, or its person a card for it.
            if mcpclient.asks_sign_in(s.trouble.copy()) {
                if let r = self.signed_start(link, name.copy(), specs[k].copy()) {
                    let (server, listed) = r
                    self.tools.extend(codemode.tools_of(name.copy(), listed))
                    self.note_icons(link, name.copy(), server.info.copy())
                    self.servers.insert(name, server)
                }
                continue
            }
            if s.trouble.len() > 0 { self.trouble.push(s.trouble) }
            self.tools.extend(codemode.tools_of(name.copy(), s.tools))
            if let server = started {
                self.note_icons(link, name.copy(), server.info.copy())
                self.servers.insert(name, server)
            }
        }
    }

    // After add_mcp_server (PLAN.md, "Signing in to MCP servers"): the servers
    // the agent has now that this session hasn't started yet, started, so their
    // tools are the agent's without a new session.
    fn take_added(self: mut Code, link: Link) {
        let given = match link.fetch("/api/mcp/servers", 30000) {
            ok(g) => g,
            err(_) => return,
        }
        self.known_icons = at(given.copy(), "icons")
        let renamed = at(given.copy(), "renamed")
        let Json.Array(specs) = at(given, "servers") else return
        var fresh = List<Json>()
        for spec in specs {
            // One renamed since this session started it is the one it has.
            let name = self.known_as(str_at(spec.copy(), "name") ?? String(), renamed.copy())
            if not self.knows(name) { fresh.push(spec.copy()) }
        }
        self.take_in(link, fresh)
    }

    // Whether this session has the server `name`: started, waiting for a
    // sign-in, or with tools it found.
    fn knows(self, name: String) -> bool {
        if self.servers.contains(name.copy()) or self.signing.contains(name.copy()) { return true }
        for t in self.tools {
            if t.server == name { return true }
        }
        return false
    }

    // The name this session knows the server `name` by: its own, or one it
    // had before a rename since the session started (`renamed`, from
    // /api/mcp/servers), which the instance still takes to it.
    fn known_as(self, name: String, renamed: Json) -> String {
        if self.knows(name.copy()) { return name.copy() }
        if let Json.Array(olds) = renamed.get(name.copy()) ?? Json.Null {
            for old in olds {
                let was = old.as_str() ?? String()
                if was.len() > 0 and self.knows(was.copy()) { return was }
            }
        }
        return name.copy()
    }

    // After a 401 (PLAN.md, "Signing in to MCP servers"): the instance
    // renews the person's sign-in and the server starts again with it, or the
    // person is shown Sign in, and the server waits for them.
    fn signed_start(self: mut Code, link: Link, name: String, spec: Json) -> (Server, List<Json>)? {
        if let header = renewed(link, name.copy()) {
            match start_listed(with_auth(spec, header)) {
                ok(got) => return some(got),
                err(e) => {
                    if not mcpclient.asks_sign_in("{e}") {
                        self.trouble.push("{name} didn't start: {e}")
                        return none
                    }
                },
            }
        }
        self.wait_for_sign_in(link, name)
        return none
    }

    fn wait_for_sign_in(self: mut Code, link: Link, name: String) {
        _ = link.send("/api/mcp/sign_in", Obj.new().s("server", name.copy()).done())
        if not self.signing.contains(name.copy()) { self.signing.push(name.copy()) }
    }

    // Servers that waited for a sign-in, started once the person has.
    fn signed_since(self: mut Code, link: Link) {
        let given = match link.fetch("/api/mcp/servers", 30000) {
            ok(g) => g,
            err(_) => return,
        }
        self.known_icons = at(given.copy(), "icons")
        let renamed = at(given.copy(), "renamed")
        let Json.Array(specs) = at(given, "servers") else return
        for spec in specs {
            let name = self.known_as(str_at(spec.copy(), "name") ?? String(), renamed.copy())
            if not self.signing.contains(name.copy()) or auth_of(spec.copy()).len() == 0 { continue }
            if let ok(got) = start_listed(spec.copy()) {
                let (server, listed) = got
                var kept = List<Tool>()
                for t in self.tools {
                    if t.server != name { kept.push(t.copy()) }
                }
                self.tools = kept
                self.tools.extend(codemode.tools_of(name.copy(), listed))
                self.note_icons(link, name.copy(), server.info.copy())
                self.servers.insert(name.copy(), server)
                var left = List<String>()
                for w in self.signing {
                    if w != name { left.push(w.copy()) }
                }
                self.signing = left
            }
        }
    }

    // The servers that said their tools changed since they were listed
    // (notifications/tools/list_changed) have them listed again, so the
    // session has them as they are now without a new one, and the instance
    // keeps them as the server's, for Spools.
    fn relist(self: mut Code, link: Link) {
        var names = List<String>()
        for (name, _) in self.servers { names.push(name.copy()) }
        for name in names {
            var server = self.servers.remove(name.copy()) else continue
            if server.tools_changed() {
                match server.tools() {
                    ok(listed) => {
                        var kept = List<Tool>()
                        for t in self.tools {
                            if t.server != name { kept.push(t.copy()) }
                        }
                        self.tools = kept
                        self.tools.extend(codemode.tools_of(name.copy(), listed.copy()))
                        var found = List<Json>()
                        for t in listed { found.push(Json.Str(str_at(t, "name") ?? String())) }
                        if not name.starts_with("plugin-") { _ = link.send("/api/mcp/listed", Obj.new().s("server", name.copy()).j("tools", Json.Array(found)).done()) }
                    },
                    err(e) => eprintln("loom mcp: {name}'s tools: {e}"),
                }
            }
            self.servers.insert(name.copy(), server)
        }
    }

    // What search_tools says of the servers that didn't start.
    fn not_reached(self) -> List<String> {
        var out = self.trouble.copy()
        for name in self.signing {
            out.push(sign_in_text(name.copy()))
        }
        return out
    }

    fn search(self: mut Code, link: Link, args: Json) -> Json {
        // A script is likely next: a Deno starts waiting for it.
        self.ready_spare(link)
        self.load(link)
        let limit = int_at(args.copy(), "limit") ?? 10
        let most: usize = if limit < 1 { 1 } else if limit > 30 { 30 } else { usize.wrap(limit) }
        // A server that didn't start is said once a session, and again when the
        // search names it.
        let query = str_at(args, "query") ?? String()
        let trouble = codemode.trouble_to_say(self.not_reached(), self.said_trouble.copy(), query.copy())
        for t in trouble.copy() {
            if not self.said_trouble.contains(t.copy()) { self.said_trouble.push(t.copy()) }
        }
        return said(codemode.search(self.tools.copy(), query, most, trouble))
    }

    // Where Deno is, asking the instance, which fetches it the first time.
    fn deno_path(self: mut Code, link: Link) -> String ! Error {
        if self.deno.len() > 0 { return self.deno.copy() }
        let got = try link.fetch("/api/mcp/deno", DENO_WAIT)
        if let e = str_at(got.copy(), "error") { fail "{e}" }
        self.deno = str_at(got, "path") ?? String()
        if self.deno.len() == 0 { fail "the instance didn't say where Deno is" }
        return self.deno.copy()
    }

    fn run(self: mut Code, link: Link, args: Json) -> Json {
        let script = str_at(args.copy(), "code") ?? String()
        if script.trim().len() == 0 { return failed(String("code is empty: give the script.")) }
        if script.len() > codemode.CODE_MOST { return failed("The script is over {codemode.CODE_MOST} bytes.") }
        let asked = int_at(args, "timeout") ?? 0
        let limit_ms: u64 = if asked <= 0 { codemode.TIME_MS } else if u64.wrap(asked) * 1000 > codemode.TIME_MOST_MS { codemode.TIME_MOST_MS } else { u64.wrap(asked) * 1000 }
        // The agent program doesn't ask before run_code, so the instance says
        // whether the script may run: at once, unless the agent's permission
        // mode is `ask`, when the person sees the script and says yes first.
        let allowed = link.send("/api/mcp/allow", Obj.new().s("server", String("loom")).s("tool", String("run_code")).b("script", true).j("arguments", Obj.new().s("code", script.copy()).done()).done())
        if is_error(allowed.copy()) { return failed(codemode.error_of(allowed)) }
        let deno = match self.deno_path(link) {
            ok(d) => d,
            err(e) => return failed("Scripts can't run here: Deno couldn't be fetched ({e}). Use the tools some other way."),
        }
        if let err(e) = self.make_folder() { return failed("Scripts can't run here: there's no folder for them ({e}).") }
        self.load(link)
        self.runs += 1
        let n = self.runs
        // The Deno waiting already, or one started now.
        var c = match self.take_spare() {
            some(waiting) => waiting,
            none => match codemode.wait(deno, self.folder.copy()) {
                ok(child) => child,
                err(e) => return failed("Deno didn't start: {e}"),
            },
        }
        let line = codemode.run_line(script)
        let result = match c.write_text(line) {
            ok => self.drive(link, mut c, n, limit_ms),
            err(e) => failed("Deno didn't take the script: {e}"),
        }
        // Ended by `tidy`, once the result has gone to the agent.
        self.done = some(c)
        return result
    }

    // After a script's result has gone: its Deno is ended, and the next
    // script's starts, while the agent reads the result.
    fn tidy(self: mut Code, link: Link) {
        if let c = self.done.take() {
            var ended = c
            ended.kill_tree()
            _ = ended.wait()
        }
        self.ready_spare(link)
    }

    // One folder for the session, so Deno's cache carries over from one
    // script to the next. It goes when the session ends.
    fn make_folder(self: mut Code) ! Error {
        if self.folder.len() == 0 { self.folder = try fs.temp_dir() }
    }

    // Starts a Deno waiting for the next script, unless one is, where Deno
    // has been fetched (never fetching it for this).
    fn ready_spare(self: mut Code, link: Link) {
        if not self.on or self.spare != none { return }
        if self.deno.len() == 0 {
            let got = match link.fetch("/api/mcp/deno?here", 30000) {
                ok(g) => g,
                err(_) => return,
            }
            let path = str_at(got, "path") else return
            self.deno = path
        }
        if let err(_) = self.make_folder() { return }
        match codemode.wait(self.deno.copy(), self.folder.copy()) {
            ok(child) => {
                self.spare = some(child)
                self.spare_at = some(unsafe { Instant.now() })
            },
            err(e) => eprintln("loom mcp: Deno didn't start: {e}"),
        }
    }

    // The waiting Deno, while it surely still waits: one near its own end
    // of waiting, or ended, is let go.
    fn take_spare(self: mut Code) -> Child? {
        var c = self.spare.take() else return none
        let since = self.spare_at ?? unsafe { Instant.now() }
        self.spare_at = none
        let waited_ms = unsafe { Instant.now() }.nanos_since(since) / 1000000
        if c.try_wait() == none and i64.wrap(waited_ms) < codemode.WAIT_IDLE_MS - 30000 { return some(c) }
        c.kill_tree()
        _ = c.wait()
        return none
    }

    // Reads the script's lines, answering its calls, until it ends, runs out
    // of time, or stops.
    fn drive(self: mut Code, link: Link, c: mut Child, n: i64, limit_ms: u64) -> Json {
        var logged = List<String>()
        var size: usize = 0
        var spent: u64 = 0
        var calls: usize = 0
        loop {
            if spent >= limit_ms {
                return failed(codemode.told(logged, true, "it ran out of time, after {limit_ms / 1000} seconds of its own."))
            }
            let began = unsafe { Instant.now() }
            let line = c.read_line(limit_ms - spent)
            spent += unsafe { Instant.now() }.nanos_since(began) / 1000000
            let text = line else {
                if not c.ended() { continue }
                let out = c.wait()
                let why = codemode.said_of(out.error_text().trim().copy(), n)
                return failed(codemode.told(logged, true, if why.len() > 0 { why } else { "Deno stopped: {out.status}" }))
            }
            let m = match parse(text.copy()) {
                ok(j) => j,
                err(_) => Json.Null,
            }
            let kind = str_at(m.copy(), "t") ?? String()
            if kind == "call" {
                calls += 1
                let id = at(m.copy(), "id")
                let path = str_at(m.copy(), "tool") ?? String()
                let answer = if calls > codemode.CALLS_MOST { Obj.new().j("id", id).b("ok", false).s("error", "A script makes {codemode.CALLS_MOST} tool calls at most, and this one has.").done() } else {
                    match self.call(link, path, at(m, "args")) {
                        ok(v) => Obj.new().j("id", id).b("ok", true).j("value", v).done(),
                        err(e) => Obj.new().j("id", id).b("ok", false).s("error", "{e}").done(),
                    }
                }
                if let err(_) = c.write_text("{answer}\n") { continue }
                continue
            }
            if kind == "end" {
                if at(m.copy(), "ok") == Json.Bool(true) { return said(codemode.told(logged, false, codemode.shown(at(m, "value")))) }
                return failed(codemode.told(logged, true, codemode.said_of(str_at(m, "error") ?? String(), n)))
            }
            // A line it logged, or one it wrote itself.
            let line_text = if kind == "log" { str_at(m, "text") ?? String() } else { text }
            if size <= codemode.OUTPUT_MOST {
                size += line_text.len() + 1
                logged.push(line_text)
            }
        }
    }

    // A script's call to the tool at `path`: its value, or why it failed.
    fn call(self: mut Code, link: Link, path: String, args: Json) -> Json ! Error {
        let t = codemode.find(self.tools, path.copy()) else { fail "There's no tool {path}. search_tools finds them." }
        if self.signing.contains(t.server.copy()) { fail "{sign_in_text(t.server.copy())}" }
        if t.server == "loom" {
            if t.name == "add_mcp_server" { self.added = true }
            let result = link.call(t.name.copy(), args)
            if is_error(result.copy()) { fail "{codemode.error_of(result)}" }
            return codemode.value_of(result)
        }
        // The instance says whether it may: by the agent's permission mode, or
        // the person's yes, which this waits for.
        let allowed = link.send("/api/mcp/allow", Obj.new().s("server", t.server.copy()).s("tool", t.name.copy()).b("read_only", t.read_only).j("arguments", args.copy()).done())
        if is_error(allowed.copy()) { fail "{codemode.error_of(allowed)}" }
        let act = int_at(allowed, "act") ?? 0
        var server = self.servers.remove(t.server.copy()) else { fail "{t.server} isn't running." }
        // What came of it, for the activity log.
        var why = String()
        var value = Json.Null
        var (result, failure) = outcome(mut server, t.name.copy(), args.copy())
        // A 401: the token is renewed and the call made again, once, or the
        // person is asked to sign in.
        var signing = mcpclient.asks_sign_in(failure.copy())
        if signing {
            if let header = renewed(link, t.server.copy()) {
                server.bearer(header[7..].copy())
                let (again, failed_again) = outcome(mut server, t.name.copy(), args.copy())
                result = again
                failure = failed_again
                signing = mcpclient.asks_sign_in(failure.copy())
            }
        }
        // A 403 for want of scopes (step-up): the token is renewed, for a
        // person who has signed in with them since, and the call made again,
        // once; or they're asked to sign in again with them. Its other tools
        // go on working meanwhile.
        var challenge = mcpclient.scope_challenge(failure.copy())
        if challenge != none {
            if let header = renewed(link, t.server.copy()) {
                server.bearer(header[7..].copy())
                let (again, failed_again) = outcome(mut server, t.name.copy(), args)
                result = again
                failure = failed_again
                challenge = mcpclient.scope_challenge(failure.copy())
            }
        }
        if failure.len() > 0 {
            why = failure
        } else if is_error(result.copy()) {
            why = codemode.error_of(result)
        } else {
            value = codemode.value_of(result)
        }
        if let wanted = challenge {
            why = step_up_text(t.server.copy())
            _ = link.send("/api/mcp/sign_in", Obj.new().s("server", t.server.copy()).s("challenge", wanted).done())
        }
        if signing {
            why = sign_in_text(t.server.copy())
            server.stop()
            self.wait_for_sign_in(link, t.server.copy())
        } else {
            self.servers.insert(t.server.copy(), server)
        }
        // A T3 tool that started a thread or sent it work: the instance puts its card
        // on the reply (PLAN.md, "T3 threads").
        var threads = List<Json>()
        if why.len() == 0 {
            if let r = t3.started_by("{value}") { threads.push(Obj.new().s("env", r.env.copy()).s("thread", r.thread.copy()).done()) }
        }
        if act > 0 or threads.len() > 0 {
            var done = Obj.new().i("act", act).b("ok", why.len() == 0).s("why", why.copy())
            // A thread started on T3: the instance wakes the agent when it finishes.
            if act > 0 and why.len() == 0 and t.name == "t3_thread_launch" { done = done.s("server", t.server.copy()).j("launched", value.copy()) }
            if threads.len() > 0 { done = done.j("threads", Json.Array(threads)) }
            _ = link.send("/api/mcp/done", done.done())
        }
        if why.len() > 0 { fail "{why}" }
        return value
    }

    fn stop(self: mut Code) {
        for (_, s) in self.servers {
            s.stop()
        }
        for c in [self.spare.take(), self.done.take()] {
            if let child = c {
                var left = child
                left.kill_tree()
                _ = left.wait()
            }
        }
        if self.folder.len() > 0 {
            if let err(e) = fs.remove_dir_all(self.folder) { eprintln("loom mcp: {e}") }
        }
    }
}

// What an agent is told of a server that waits for its person to sign in.
fn sign_in_text(name: String) -> String {
    return "{name} needs your person to sign in. Loom has shown them Sign in in the chat: don't sign in yourself, in your browser or any other way. Its tools work once they have."
}

// What an agent is told of a call its person's sign-in doesn't reach far enough for.
fn step_up_text(name: String) -> String {
    return "{name} needs your person to sign in again to let you do that. Loom has shown them Sign in in the chat: don't sign in yourself, in your browser or any other way. Try it again once they have."
}

// The Authorization header a server's spec gives, or "".
fn auth_of(spec: Json) -> String {
    if let Json.Array(headers) = at(spec, "headers") {
        for h in headers {
            if (str_at(h.copy(), "name") ?? String()).to_lower_root() == "authorization" { return str_at(h, "value") ?? String() }
        }
    }
    return String()
}

// The spec with `header` as its Authorization.
fn with_auth(spec: Json, header: String) -> Json {
    var headers = List<Json>()
    if let Json.Array(given) = at(spec.copy(), "headers") {
        for h in given {
            if (str_at(h.copy(), "name") ?? String()).to_lower_root() != "authorization" { headers.push(h.copy()) }
        }
    }
    headers.push(Obj.new().s("name", String("Authorization")).s("value", header).done())
    return merge(spec, Obj.new().j("headers", Json.Array(headers)).done())
}

// The instance's renewal of the person's sign-in to `name`: the new
// Authorization header, or none when they must sign in again.
fn renewed(link: Link, name: String) -> String? {
    let got = link.send("/api/mcp/token", Obj.new().s("server", name).done())
    if let Json.Array(headers) = at(got, "headers") {
        for h in headers {
            if let v = str_at(h, "value") {
                if v.starts_with("Bearer ") { return some(v) }
            }
        }
    }
    return none
}

// A call to one of a server's tools: its result, or why it failed.
fn outcome(server: mut Server, name: String, args: Json) -> (Json, String) {
    return match server.call(name, args) {
        ok(r) => (r, String()),
        err(e) => (Json.Null, "{e}"),
    }
}

// Starts the server `spec` gives and lists its tools.
fn start_listed(spec: Json) -> (Server, List<Json>) ! Error {
    var server = try mcpclient.start(spec)
    match server.tools() {
        ok(listed) => return (server, listed),
        err(e) => {
            server.stop()
            fail "{e}"
        },
    }
}

fn is_object(j: Json) -> bool {
    if let Json.Object(_) = j { return true }
    return false
}

// Answers one message. A request whose `_meta` names its version is of the
// modern era, and answered as it stands; any other is of the legacy era,
// after initialize.
fn handle(link: Link, c: mut Code, m: Json) {
    let id = m.get(String("id")) else return    // a notification, such as notifications/initialized
    let method = str_at(m.copy(), "method") ?? String()
    let params = at(m, "params")
    let meta = at(params.copy(), "_meta")
    let named = meta.get(String("io.modelcontextprotocol/protocolVersion")) else {
        if method == "server/discover" {
            reply_error(id, -32602, String("server/discover says the version it's asked in, as _meta's io.modelcontextprotocol/protocolVersion"))
            return
        }
        handle_legacy(link, mut c, id, method, params)
        return
    }
    let version = named.as_str() ?? String()
    if version != mcpclient.MODERN {
        let data = Obj.new().j("supported", versions()).s("requested", version.copy()).done()
        println("{Obj.new().s("jsonrpc", String("2.0")).j("id", id).j("error", Obj.new().i("code", -32022).s("message", "loom doesn't speak MCP {version}").j("data", data).done()).done()}")
        return
    }
    if not is_object(at(meta, "io.modelcontextprotocol/clientCapabilities")) {
        reply_error(id, -32602, String("A request in MCP 2026-07-28 says what its client can do, as _meta's io.modelcontextprotocol/clientCapabilities"))
        return
    }
    if method == "server/discover" {
        reply(id, modern_list(discovered()))
    } else if method == "tools/list" or method == "tools/call" {
        tools_request(link, mut c, id, method, params, true)
    } else {
        reply_error(id, -32601, "loom doesn't offer {method}")
    }
}

fn handle_legacy(link: Link, c: mut Code, id: Json, method: String, params: Json) {
    if method == "initialize" {
        let asked = str_at(params, "protocolVersion") ?? String()
        let version = if mcpclient.legacy(asked.copy()) { asked } else { String(mcpclient.LEGACY[0]) }
        reply(id, Obj.new().s("protocolVersion", version).j("capabilities", Obj.new().j("tools", Obj.new().done()).done()).j("serverInfo", server_info()).done())
    } else if method == "ping" {
        reply(id, Obj.new().done())
    } else if method == "tools/list" or method == "tools/call" {
        tools_request(link, mut c, id, method, params, false)
    } else {
        reply_error(id, -32601, "loom doesn't offer {method}")
    }
}

fn reply_as(id: Json, result: Json, modern: bool, list: bool) {
    if not modern {
        reply(id, result)
    } else if list {
        reply(id, modern_list(result))
    } else {
        reply(id, modern_result(result))
    }
}

// tools/list and tools/call, in either era.
fn tools_request(link: Link, c: mut Code, id: Json, method: String, params: Json, modern: bool) {
    if method == "tools/list" {
        if c.on {
            reply_as(id, Obj.new().j("tools", Json.Array(tools.code_mode_tools())).done(), modern, true)
            return
        }
        match own_tools(link, mut c) {
            ok(t) => reply_as(id, t, modern, true),
            err(e) => reply_error(id, -32603, "loom's instance didn't answer: {e}"),
        }
        return
    }
    let name = str_at(params.copy(), "name") ?? String()
    let arguments = at(params, "arguments")
    // In Code Mode a call by a tool's own name still goes to the instance,
    // which decides it as ever.
    if c.on and name == "search_tools" {
        reply_as(id, c.search(link, arguments), modern, false)
    } else if c.on and name == "run_code" {
        reply_as(id, c.run(link, arguments), modern, false)
        c.tidy(link)
    } else {
        // A server the agent proposed and its person added is started at
        // its next search or script.
        if name == "add_mcp_server" { c.added = true }
        let text = link.call_text(name, arguments)
        reply_text(id, if modern { final_text(text) } else { text })
    }
}

// Serves MCP on standard input and output until input ends.
pub fn serve() ! Error {
    let base = env.variable(String("LOOM_URL")) else { fail "LOOM_URL isn't set: loom mcp is started by loom's instance" }
    let token = env.variable(String("LOOM_MCP_TOKEN")) else { fail "LOOM_MCP_TOKEN isn't set: loom mcp is started by loom's instance" }
    let link = Link { base: base, token: token }
    var c = Code { on: env.variable(String("LOOM_CODE_MODE")) == some(String("1")), deno: String(), loaded: false, tools: List<Tool>(), servers: Map<String, Server>(), trouble: List<String>(), said_trouble: List<String>(), signing: List<String>(), added: false, runs: 0, folder: String(), warm: some(link.ask_tools()), spare: none, spare_at: none, done: none, known_icons: Json.Null }
    var input = io.Lines()
    while let line = input.next() {
        if line.trim().len() == 0 { continue }
        match parse(line.copy()) {
            ok(m) => handle(link, mut c, m),
            err(_) => reply_error(Json.Null, -32700, String("that line isn't JSON")),
        }
    }
    c.stop()
}

@test
fn answers_as_the_modern_era_does() {
    assert(final_text(String(#"{"content":[]}"#)) == #"{"resultType":"complete","content":[]}"#)
    assert(final_text(String("\{\}")) == #"{"resultType":"complete"}"#)
    assert("{modern_list(discovered())}" == #"{"resultType":"complete","supportedVersions":["2026-07-28","2025-11-25","2025-06-18","2025-03-26","2024-11-05"],"capabilities":{"tools":{}},"ttlMs":0,"cacheScope":"private","_meta":{"io.modelcontextprotocol/serverInfo":{"name":"loom","version":"1"}}}"#)
}
