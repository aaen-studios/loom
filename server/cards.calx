module server.cards

// Cards in the chat (PLAN.md, "Cards in the chat"): small things an agent
// puts in its reply with show_card, which the apps draw as part of it.
//
// - `choices`: up to six answers, each a button; the person's click sends it
//   as their next message;
// - `checklist`: up to 30 items, each done or not;
// - `table`: up to 8 columns and 50 rows of text;
// - `progress`: how far along something is, 0 to 1, with a label;
// - `facts`: up to 12 labels, each with its value;
// - `form`: up to 8 fields the person fills in, each text, a choice, a toggle
//   or a number, sent back with one Send as one answer.
//
// Each has a `title`, which may be empty, and an `id` the agent uses to change
// it later in the same reply. What's here only checks and tidies the JSON the
// agent gave; the instance keeps it as a `card` block.
import std.json.{Json}
import shared.obj.{Obj, at, bool_at, merge, without, str_at}
import shared.badge

pub const TYPES: str = "choices checklist table progress facts form"
// The most tool names an added MCP server's card lists.
const TOOLS_MOST: usize = 50
const TITLE_MOST: usize = 80
const OPTION_MOST: usize = 80
const OPTIONS_MOST: usize = 6
const ITEMS_MOST: usize = 30
const FACTS_MOST: usize = 12
const COLUMNS_MOST: usize = 8
const ROWS_MOST: usize = 50
const CELL_MOST: usize = 200

// `text`, trimmed, on one line, and cut at `most` bytes with "…".
fn tidy(text: String, most: usize) -> String {
    var out = String()
    for r in text.trim().runes() {
        if out.len() >= most {
            out.push_str("…")
            break
        }
        out.push(if r == '\n' or r == '\r' or r == '\t' { ' ' } else { r })
    }
    return out
}

// A cell, an option or a value as text: a string as it is, a number or a
// true or false as JSON writes it, and nothing for null.
fn words(v: Json) -> String {
    if let s = v.as_str() { return s }
    if v == Json.Null { return String() }
    return "{v}"
}

fn list(v: Json) -> List<Json> {
    if let Json.Array(xs) = v { return xs.copy() }
    return List<Json>()
}

// The card `args` describes, tidied, with `id`, or why it can't be one.
// `args` is show_card's: `type`, `title`, and the fields of its type.
pub fn card_of(args: Json, id: String) -> (Json, String) {
    let kind = (str_at(args.copy(), "type") ?? String()).trim().copy()
    var known = false
    for t in TYPES.split(" ") {
        if kind == t { known = true }
    }
    if not known { return (Json.Null, "type is {if kind.len() == 0 { String("missing") } else { "\"{kind}\"" }}: it's one of choices, form, checklist, table, progress or facts.") }
    let title = tidy(str_at(args.copy(), "title") ?? String(), TITLE_MOST)
    var card = Obj.new().s("id", id).s("type", kind.copy()).s("title", title)
    if kind == "choices" {
        var options = List<Json>()
        for o in list(at(args.copy(), "options")) {
            let w = tidy(words(o), OPTION_MOST)
            if w.len() > 0 { options.push(Json.Str(w)) }
        }
        if options.len() < 2 or options.len() > OPTIONS_MOST { return (Json.Null, "options has {options.len()} answers: give 2 to {OPTIONS_MOST}, each a few words.") }
        card = card.j("options", Json.Array(options))
    } else if kind == "checklist" {
        var items = List<Json>()
        for item in list(at(args.copy(), "items")) {
            let text = tidy(if let s = item.as_str() { s } else { words(at(item.copy(), "text")) }, CELL_MOST)
            if text.len() == 0 { continue }
            let done = at(item, "done") == Json.Bool(true)
            items.push(Obj.new().s("text", text).b("done", done).done())
        }
        if items.len() == 0 or items.len() > ITEMS_MOST { return (Json.Null, "items has {items.len()}: give 1 to {ITEMS_MOST}, each \{\"text\", \"done\"\}.") }
        card = card.j("items", Json.Array(items))
    } else if kind == "facts" {
        var items = List<Json>()
        for item in list(at(args.copy(), "items")) {
            let label = tidy(words(at(item.copy(), "label")), OPTION_MOST)
            let value = tidy(words(at(item, "value")), CELL_MOST)
            if label.len() == 0 and value.len() == 0 { continue }
            items.push(Obj.new().s("label", label).s("value", value).done())
        }
        if items.len() == 0 or items.len() > FACTS_MOST { return (Json.Null, "items has {items.len()}: give 1 to {FACTS_MOST}, each \{\"label\", \"value\"\}.") }
        card = card.j("items", Json.Array(items))
    } else if kind == "table" {
        var columns = List<Json>()
        for c in list(at(args.copy(), "columns")) {
            columns.push(Json.Str(tidy(words(c), OPTION_MOST)))
        }
        if columns.len() == 0 or columns.len() > COLUMNS_MOST { return (Json.Null, "columns has {columns.len()}: give 1 to {COLUMNS_MOST} names.") }
        var rows = List<Json>()
        for row in list(at(args.copy(), "rows")) {
            var cells = List<Json>()
            for c in list(row) {
                if cells.len() < columns.len() { cells.push(Json.Str(tidy(words(c), CELL_MOST))) }
            }
            while cells.len() < columns.len() {
                cells.push(Json.Str(String()))
            }
            rows.push(Json.Array(cells))
        }
        if rows.len() > ROWS_MOST { return (Json.Null, "rows has {rows.len()}: {ROWS_MOST} at most. Show the rest with html_render, or a shared table.") }
        card = card.j("columns", Json.Array(columns)).j("rows", Json.Array(rows))
    } else if kind == "form" {
        let (fields, why) = form_fields(at(args.copy(), "fields"))
        if why.len() > 0 { return (Json.Null, why) }
        card = card.j("fields", Json.Array(fields))
    } else {
        let v = at(args.copy(), "value").as_f64() else return (Json.Null, String("value is missing: give how far along it is, from 0 to 1."))
        if v < 0.0 or v > 1.0 { return (Json.Null, "value is {v}: give it from 0 to 1, such as 0.4 for 40%.") }
        card = card.s("label", tidy(str_at(args, "label") ?? String(), TITLE_MOST)).j("value", Json.Float(v))
    }
    return (card.done(), String())
}

// Where a new card goes in its reply (PLAN.md, "Cards in the chat"): `end`,
// after all the reply's words, shown once the reply is finished, or `here`,
// after what the agent has said so far, at once. A question goes at the end
// whatever order the agent called in, so the person reads the reply before
// answering it: choices and forms go there unless `args` says `here`, and the
// rest go here unless it says `end`. Or why `place` can't be.
pub fn place_of(args: Json) -> (String, String) {
    let kind = (str_at(args.copy(), "type") ?? String()).trim().copy()
    let asked = (str_at(args, "place") ?? String()).trim().copy()
    if asked == "end" or asked == "here" { return (asked, String()) }
    if asked.len() > 0 { return (String(), "place is \"{asked}\": it's end (after all you say, once your reply is done) or here (after what you've said so far, at once).") }
    return (String(if kind == "choices" or kind == "form" { "end" } else { "here" }), String())
}

// The kinds of field a form has: `text`, `choice` (one of its options),
// `toggle` (on or off) and `number`.
pub const FIELD_KINDS: str = "text choice toggle number"
const FORM_FIELDS_MOST: usize = 8
// The most bytes a text answer keeps.
const ANSWER_MOST: usize = 1000

// A form's fields, from show_card's `fields`, tidied, or why they can't be.
// Each has its `label`, its `kind`, whether it must be answered (`required`,
// yes unless the agent says no, and never for a toggle, which is always on or
// off), what it starts as (`value`: text, one of a choice's options or "",
// on or off, or a number or null), a choice's `options` and a text's or a
// number's `placeholder`. Labels are told apart, since answers go back by them.
fn form_fields(given: Json) -> (List<Json>, String) {
    var out = List<Json>()
    var labels = List<String>()
    let all = list(given)
    if all.len() == 0 or all.len() > FORM_FIELDS_MOST { return (List<Json>(), "fields has {all.len()}: give 1 to {FORM_FIELDS_MOST}, each \{\"label\", \"kind\"\}.") }
    for f in all {
        let label = tidy(words(at(f.copy(), "label")), OPTION_MOST)
        if label.len() == 0 { return (List<Json>(), String("Each of fields needs a label: a few words saying what it asks.")) }
        if labels.contains(label.copy()) { return (List<Json>(), "Two fields are labelled \"{label}\": give each its own, since the answers come back by label.") }
        labels.push(label.copy())
        let kind = (str_at(f.copy(), "kind") ?? String("text")).trim().copy()
        if not " {FIELD_KINDS} ".contains(" {kind} ") { return (List<Json>(), "kind is \"{kind}\" for {label}: it's text, choice, toggle or number.") }
        var shape = Obj.new().s("label", label.copy()).s("kind", kind.copy())
        if kind == "toggle" {
            out.push(shape.b("required", false).b("value", bool_at(f.copy(), "value") ?? false).done())
            continue
        }
        shape = shape.b("required", bool_at(f.copy(), "required") ?? true)
        if kind == "choice" {
            var options = List<Json>()
            var names = List<String>()
            for o in list(at(f.copy(), "options")) {
                let w = tidy(words(o), OPTION_MOST)
                if w.len() > 0 and not names.contains(w.copy()) {
                    names.push(w.copy())
                    options.push(Json.Str(w))
                }
            }
            if options.len() < 2 or options.len() > OPTIONS_MOST { return (List<Json>(), "options has {options.len()} for {label}: give 2 to {OPTIONS_MOST}, each a few words.") }
            let start = tidy(words(at(f.copy(), "value")), OPTION_MOST)
            shape = shape.j("options", Json.Array(options)).s("value", if names.contains(start.copy()) { start } else { String() })
        } else if kind == "number" {
            let start = at(f.copy(), "value")
            shape = shape.j("value", if start.as_f64() != none { start } else { Json.Null })
        } else {
            shape = shape.s("value", tidy(words(at(f.copy(), "value")), ANSWER_MOST))
        }
        out.push(shape.s("placeholder", tidy(str_at(f, "placeholder") ?? String(), OPTION_MOST)).done())
    }
    return (out, String())
}

// Whether `n` is a whole number an i64 holds exactly.
fn whole(n: f64) -> bool {
    return n == n.floor() and n > -1.0e15 and n < 1.0e15
}

// A number as a form says it: 3 for 3.0, and 2.5 as it is.
fn number_words(n: f64) -> String {
    if whole(n) { return "{i64.saturate(n)}" }
    return "{n}"
}

// A form's answers as the person sent them (`given`, by each field's label),
// checked against its card: the answers, tidied, as the agent gets them; the
// lines the person's message says them in, "Label: answer" each; and why they
// can't be, if they can't. A text answer is cut at ANSWER_MOST bytes, a choice
// is one of its options, a toggle is true or false, and a number is a number,
// or text that reads as one. A required field left empty is refused, and an
// optional one is left out. A form answers once.
pub fn form_answer(card: Json, given: Json) -> (Json, String, String) {
    if str_at(card.copy(), "type") != some(String("form")) { return (Json.Null, String(), String("That card isn't a form.")) }
    if at(card.copy(), "answers") != Json.Null { return (Json.Null, String(), String("That form was sent already.")) }
    var out = Obj.new()
    var lines = List<String>()
    for f in list(at(card, "fields")) {
        let label = str_at(f.copy(), "label") ?? String()
        let kind = str_at(f.copy(), "kind") ?? String()
        let required = bool_at(f.copy(), "required") ?? false
        let v = given.get(label.copy()) ?? Json.Null
        if kind == "toggle" {
            let on = v.as_bool() ?? false
            out.m.insert(label.copy(), Json.Bool(on))
            lines.push("{label}: {if on { "Yes" } else { "No" }}")
            continue
        }
        if kind == "number" {
            var n: f64? = v.as_f64()
            if n == none {
                if let s = v.as_str() {
                    if s.trim().len() > 0 {
                        n = f64.parse(s.trim().replace(String(","), String(".")))
                        if n == none { return (Json.Null, String(), "{label} is \"{s.trim()}\", which isn't a number.") }
                    }
                }
            }
            match n {
                some(x) => {
                    out.m.insert(label.copy(), if whole(x) { Json.Int(i64.saturate(x)) } else { Json.Float(x) })
                    lines.push("{label}: {number_words(x)}")
                },
                none => if required { return (Json.Null, String(), "{label} needs an answer.") },
            }
            continue
        }
        let text = if kind == "choice" { tidy(words(v), OPTION_MOST) } else { tidy_answer(words(v)) }
        if text.len() == 0 {
            if required { return (Json.Null, String(), "{label} needs an answer.") }
            continue
        }
        if kind == "choice" {
            var known = false
            for o in list(at(f.copy(), "options")) {
                if o.as_str() == some(text.copy()) { known = true }
            }
            if not known { return (Json.Null, String(), "{label} is \"{text}\", which isn't one of its options.") }
        }
        out.m.insert(label.copy(), Json.Str(text.copy()))
        lines.push("{label}: {text}")
    }
    return (out.done(), lines.join("\n"), String())
}

// A text answer: trimmed, its lines kept, and cut at ANSWER_MOST bytes with "…".
fn tidy_answer(text: String) -> String {
    var out = String()
    for r in text.trim().runes() {
        if out.len() >= ANSWER_MOST {
            out.push_str("…")
            break
        }
        out.push(if r == '\r' or r == '\t' { ' ' } else { r })
    }
    return out
}

// A form's card once it's answered: the answers on it, so every device draws
// it sent, with what was sent.
pub fn form_answered(card: Json, answers: Json) -> Json {
    return merge(card, Obj.new().j("answers", answers).done())
}

// The card loom itself puts in a reply when the agent found that one of its
// MCP servers needs its person to sign in (PLAN.md, "Signing in to MCP
// servers"): the apps draw it with Sign in, and the server's badge
// (`shared/badge.calx`). Agents can't make one with show_card, whose types
// don't have it.
pub fn sign_in_card(server: String, icon: String, dark: String) -> Json {
    return Obj.new().s("id", "sign_in_{server}").s("type", String("sign_in")).s("title", tidy("Sign in to {server}", TITLE_MOST)).s("server", server.copy()).j("badge", badge.badge(server, icon, dark)).done()
}

// The states an MCP server an agent proposed goes through on its card:
// `asking` (Add and Cancel), `adding` (being kept and tried), `sign_in` (it
// wants its person to sign in: Sign in and Later), `later` (added, the agent
// told, and Sign in still there), `ready` (it answered with its tools),
// `added` (kept, but it can't be tried here: a sandboxed person's), `failed`
// (kept, but it didn't start, with why) and `cancelled`.
pub const MCP_ADD_STATES: str = "asking adding sign_in later ready added failed cancelled"

// The card loom puts in a reply for add_mcp_server (PLAN.md, "Signing in to
// MCP servers"): what would be added, as mcp.put takes it (`spec`), and how
// it stands. Each of its settings is shown as it is, or, for a secret, by
// name, with whether the person has it (`have`, their secrets' names), never
// its value. `said` is a line in plain words: the tools it offers, or what
// went wrong; once it's `ready`, `tools` has the tools' names too, each on its
// own. The server's badge is `shared/badge.calx`'s, with its own icons
// (`icon`, `dark`) when it gave them. Agents can't make one with
// show_card.
pub fn mcp_add_card(call: String, spec: Json, have: List<String>, state: String, said: String, icon: String, dark: String) -> Json {
    let name = str_at(spec.copy(), "name") ?? String()
    var card = Obj.new().s("id", "mcp_add_{call}").s("type", String("mcp_add")).s("title", tidy("Add the MCP server {name}", TITLE_MOST)).s("call", call).s("server", name.copy()).j("badge", badge.badge(name, icon, dark))
    if state == "ready" {
        var tools = List<Json>()
        for t in said.split(", ") {
            if t.trim().len() > 0 and tools.len() < TOOLS_MOST { tools.push(Json.Str(tidy(t.copy(), OPTION_MOST))) }
        }
        card = card.j("tools", Json.Array(tools))
    }
    var place = "env"
    if let address = str_at(spec.copy(), "url") {
        card = card.s("url", tidy(address, CELL_MOST))
        place = "header"
    } else {
        var args = List<Json>()
        for a in list(at(spec.copy(), "args")) {
            args.push(Json.Str(tidy(words(a), CELL_MOST)))
        }
        card = card.s("command", tidy(str_at(spec.copy(), "command") ?? String(), CELL_MOST)).j("args", Json.Array(args))
    }
    var settings = List<Json>()
    if let Json.Object(m) = at(spec, if place == "env" { "env" } else { "headers" }) {
        for (k, v) in m {
            var s = Obj.new().s("name", tidy(k.copy(), OPTION_MOST)).s("in", String(place))
            if let secret = str_at(v.copy(), "secret") {
                s = s.s("secret", secret.copy()).b("have", have.contains(secret))
            } else {
                s = s.s("value", tidy(words(v), CELL_MOST))
            }
            settings.push(s.done())
        }
    }
    return card.j("settings", Json.Array(settings)).s("state", state).s("said", tidy(said, CELL_MOST)).done()
}

// The secrets a proposed server names that the person doesn't have, once each.
pub fn secrets_missing(spec: Json, have: List<String>) -> List<String> {
    var out = List<String>()
    for key in ["env", "headers"] {
        if let Json.Object(m) = at(spec.copy(), key) {
            for (_, v) in m {
                if let secret = str_at(v, "secret") {
                    if not have.contains(secret.copy()) and not out.contains(secret.copy()) { out.push(secret) }
                }
            }
        }
    }
    return out
}

@test
fn makes_the_mcp_add_card() {
    let spec = Obj.new().s("name", String("acta")).s("command", String("npx")).j("args", Json.Array([Json.Str(String("-y")), Json.Str(String("@acta/mcp"))])).j("env", Obj.new().j("ACTA_KEY", Obj.new().s("secret", String("ACTA_KEY")).done()).s("ACTA_URL", String("https://acta.example")).done()).done()
    let card = mcp_add_card(String("tc_4"), spec.copy(), [String("OTHER")], "asking", String(), String(), String())
    assert("{card}" == "\{\"id\":\"mcp_add_tc_4\",\"type\":\"mcp_add\",\"title\":\"Add the MCP server acta\",\"call\":\"tc_4\",\"server\":\"acta\",\"badge\":{badge.badge(String("acta"), String(), String())},\"command\":\"npx\",\"args\":[\"-y\",\"@acta/mcp\"],\"settings\":[\{\"name\":\"ACTA_KEY\",\"in\":\"env\",\"secret\":\"ACTA_KEY\",\"have\":false\},\{\"name\":\"ACTA_URL\",\"in\":\"env\",\"value\":\"https://acta.example\"\}],\"state\":\"asking\",\"said\":\"\"\}")
    assert(secrets_missing(spec.copy(), [String("OTHER")]).join(",") == "ACTA_KEY" and secrets_missing(spec, [String("ACTA_KEY")]).len() == 0)
    let hosted = mcp_add_card(String("tc_5"), Obj.new().s("name", String("docs")).s("url", String("https://docs.example/mcp")).j("headers", Obj.new().done()).done(), List<String>(), "sign_in", String("It didn't sign you in"), String(), String())
    assert(str_at(hosted.copy(), "url") == some(String("https://docs.example/mcp")) and str_at(hosted.copy(), "command") == none and str_at(hosted, "said") == some(String("It didn't sign you in")))
    // Ready, its tools each on their own.
    let ready = mcp_add_card(String("tc_6"), spec.copy(), List<String>(), "ready", String("list_issues, create_issue, search"), String("ab12"), String("cd34"))
    assert("{at(ready.copy(), "tools")}" == #"["list_issues","create_issue","search"]"#)
    // With the server's own icons, its badge carries them.
    assert(str_at(at(ready.copy(), "badge"), "icon") == some(String("ab12")) and str_at(at(ready, "badge"), "icon_dark") == some(String("cd34")))
    let (_, why) = card_of(Obj.new().s("type", String("mcp_add")).done(), String("card_1"))
    assert(why.starts_with("type is \"mcp_add\""))
}

// The kinds of thing browser_ask_secret asks for, each a field on its card:
// `password` (hidden as it's typed, and offered to keep), `username` (an
// email or a user name: shown, and offered to keep) and `code` (a one-time
// code: shown, and not offered, since it's good once).
pub const SECRET_KINDS: str = "password username code"

// The states a secret_ask card goes through: `asking` (Fill and Not now),
// `filled` (it went into the page; `saved` has the names it's kept as),
// `declined` (Not now) and `closed` (the browser closed, or the turn ended,
// before the person answered).
pub const SECRET_STATES: str = "asking filled declined closed"

const FIELDS_MOST: usize = 4

// Whether `name` can name a secret: letters, digits, _, - and ., up to 64.
pub fn good_secret_name(name: String) -> bool {
    if name.len() == 0 or name.len() > 64 { return false }
    for r in name.runes() {
        let fine = (r >= 'a' and r <= 'z') or (r >= 'A' and r <= 'Z') or (r >= '0' and r <= '9') or r == '_' or r == '-' or r == '.'
        if not fine { return false }
    }
    return true
}

// The name a secret for `site` is offered to be kept as: the site's own name
// and what it is, such as ntnu-password for innsida.ntnu.no, or
// microsoftonline-username for login.microsoftonline.com. A file's is only
// what it is. A code is never offered, so it has none.
pub fn save_name(site: String, kind: String) -> String {
    if kind == "code" { return String() }
    let what = if kind == "username" { String("username") } else { String("password") }
    let name = site_name(site)
    if name.len() == 0 { return what }
    let out = "{name}-{what}"
    return if good_secret_name(out.copy()) { out } else { what }
}

// A site's own name, as its badge shows it: ntnu for innsida.ntnu.no, example
// for www.shop.example.co.uk, and an address for itself. A file has none, and
// neither has an IPv6 address.
pub fn site_name(site: String) -> String {
    var host = site.trim().to_lower_root()
    if host.starts_with("[") { return String() }
    if let k = host.find(":") { host = host[..k].copy() }
    var labels = List<String>()
    for label in host.split(".") {
        if label.len() > 0 { labels.push(label.copy()) }
    }
    if labels.len() > 0 and labels[0] == "www" { _ = labels.remove(0) }
    if labels.len() == 0 { return String() }
    // An address is itself; a name is its label before the top-level one, or
    // before both of one such as co.uk.
    var name = labels[labels.len() - 1].copy()
    var numeric = true
    for r in host.runes() {
        if not ((r >= '0' and r <= '9') or r == '.') { numeric = false }
    }
    if numeric {
        name = host.copy()
    } else if labels.len() >= 2 {
        name = labels[labels.len() - 2].copy()
        let second = " co com org net ac gov edu "
        if labels.len() >= 3 and second.contains(" {name} ") and labels[labels.len() - 1].len() == 2 { name = labels[labels.len() - 3].copy() }
    }
    return name
}

// A field of a card the person fills in: what it's for (`label`), its
// `kind`, whether it's hidden as it's typed (`masked`), and `save`, the name
// it's offered to be kept as among the person's secrets, or "" when it isn't.
// A form's card could take the same.
pub fn field(label: String, kind: String, masked: bool, save: String) -> Json {
    return Obj.new().s("label", tidy(label, OPTION_MOST)).s("kind", kind).b("masked", masked).s("save", save).done()
}

// The kind a field is when the agent didn't say, from what it wrote about it
// (`said`: its label or why): a password if it says so, a code if it names
// one, an email or a user name if it names one, and otherwise a password.
pub fn kind_from(said: String) -> String {
    let w = said.to_lower_root()
    for p in ["password", "passord", "passphrase"] {
        if w.contains(p) { return String("password") }
    }
    for c in ["code", "kode", "otp", "one-time", "2fa"] {
        if w.contains(c) { return String("code") }
    }
    for u in ["email", "e-mail", "e-post", "epost", "user name", "username", "user id", "brukernavn", "login name", "@"] {
        if w.contains(u) { return String("username") }
    }
    return String("password")
}

fn kind_label(kind: String) -> String {
    if kind == "username" { return String("Email or user name") }
    if kind == "code" { return String("Code") }
    return String("Password")
}

// browser_ask_secret's fields, from its `ref`, `kind`, `masked` and `save`,
// or its `fields` (each a ref, label, kind, masked and save) for several on
// one page, each with its `ref`; or why they can't be. `site` is the page's
// host, which names what each is offered to be kept as.
pub fn ask_fields(args: Json, site: String) -> (List<Json>, String) {
    var given = List<Json>()
    var many = false
    if let Json.Array(asked) = at(args.copy(), "fields") {
        given = asked.copy()
        many = true
        if given.len() == 0 or given.len() > FIELDS_MOST { return (List<Json>(), "fields has {given.len()}: give 1 to {FIELDS_MOST}, each \{\"ref\", \"label\", \"kind\"\}.") }
    } else {
        given.push(args.copy())
    }
    let why = str_at(args.copy(), "why") ?? String()
    var out = List<Json>()
    for g in given {
        let r = (str_at(g.copy(), "ref") ?? String()).trim().copy()
        if r.len() == 0 { return (List<Json>(), if many { String("Each of fields needs the ref of its field on the page, such as e12.") } else { String("ref is missing: give the field's ref, such as e12, from the page's outline.") }) }
        // Left out, the kind is what the label, or for one field the why, says it is.
        let said = if many { str_at(g.copy(), "label") ?? String() } else { why.copy() }
        let kind = (str_at(g.copy(), "kind") ?? kind_from(said)).trim().copy()
        if not " {SECRET_KINDS} ".contains(" {kind} ") { return (List<Json>(), "kind is \"{kind}\": it's password, username (an email or a user name) or code (a one-time code).") }
        let masked = bool_at(g.copy(), "masked") ?? (kind == "password")
        var save = save_name(site.copy(), kind.copy())
        if let asked = str_at(g.copy(), "save") {
            save = asked.trim().copy()
            if save.len() > 0 and not good_secret_name(save.copy()) { return (List<Json>(), "save is \"{save}\": a secret's name is letters, digits, _, - and ., such as ntnu-password.") }
        }
        let label = (str_at(g, "label") ?? String()).trim().copy()
        let f = field(if label.len() > 0 { label } else { kind_label(kind.copy()) }, kind, masked, save)
        out.push(merge(f, Obj.new().s("ref", r).done()))
    }
    return (out, String())
}

// The card browser_ask_secret puts in the agent's reply (PLAN.md, "The
// agent's browser"): what's asked (`title`), on which site, and its fields,
// with how it stands and the names what was given is kept as. Never a value.
// A site with a name has its badge (`shared/badge.calx`). Agents can't make
// one with show_card.
pub fn secret_card(call: String, agent: String, why: String, site: String, fields: List<Json>) -> Json {
    var shown = List<Json>()
    for f in fields {
        shown.push(without(f, "ref"))
    }
    let place = if site.len() > 0 { site.copy() } else { String("a file on this computer") }
    var card = Obj.new().s("id", "secret_{call}").s("type", String("secret_ask")).s("title", tidy(why, TITLE_MOST)).s("call", call).s("agent", agent).s("site", place)
    let name = site_name(site)
    if name.len() > 0 { card = card.j("badge", badge.badge(name, String(), String())) }
    return card.j("fields", Json.Array(shown)).s("state", String("asking")).j("saved", Json.Array(List<Json>())).done()
}

// A secret_ask card as it stands now: `state`, and the names kept.
pub fn secret_card_now(card: Json, state: str, saved: List<String>) -> Json {
    var names = List<Json>()
    for s in saved {
        names.push(Json.Str(s.copy()))
    }
    return merge(card, Obj.new().s("state", String(state)).j("saved", Json.Array(names)).done())
}

// A card as a reply keeps it once its turn is over: a secret_ask still
// asking is closed, since nothing can answer it now.
pub fn ended(card: own Json) -> Json {
    if str_at(card.copy(), "type") == some(String("secret_ask")) and str_at(card.copy(), "state") == some(String("asking")) { return secret_card_now(card, "closed", List<String>()) }
    return card
}

@test
fn names_what_a_secret_is_kept_as() {
    assert(save_name(String("innsida.ntnu.no"), String("password")) == "ntnu-password")
    assert(save_name(String("login.microsoftonline.com"), String("username")) == "microsoftonline-username")
    assert(save_name(String("www.shop.example.co.uk"), String("password")) == "example-password")
    assert(save_name(String("localhost:8080"), String("password")) == "localhost-password")
    assert(save_name(String("10.0.0.5:3000"), String("password")) == "10.0.0.5-password")
    assert(save_name(String("[::1]:8080"), String("password")) == "password")
    assert(save_name(String(), String("password")) == "password")
    assert(save_name(String("bank.example"), String("code")) == "")
    assert(good_secret_name(String("ntnu-password")) and not good_secret_name(String("my password")) and not good_secret_name(String()))
}

@test
fn makes_the_secret_card() {
    let (one, none_why) = ask_fields(Obj.new().s("ref", String("e12")).done(), String("innsida.ntnu.no"))
    assert(none_why.len() == 0)
    assert("{one[0]}" == "\{\"label\":\"Password\",\"kind\":\"password\",\"masked\":true,\"save\":\"ntnu-password\",\"ref\":\"e12\"\}")
    let (two, _) = ask_fields(Obj.new().j("fields", Json.Array([Obj.new().s("ref", String("e3")).s("kind", String("username")).s("label", String("Email")).done(), Obj.new().s("ref", String("e4")).s("save", String("")).done()])).done(), String("innsida.ntnu.no"))
    assert(two.len() == 2 and str_at(two[0].copy(), "label") == some(String("Email")) and at(two[0].copy(), "masked") == Json.Bool(false) and str_at(two[0].copy(), "save") == some(String("ntnu-username")) and str_at(two[1].copy(), "save") == some(String("")))
    let (code, _) = ask_fields(Obj.new().s("ref", String("e5")).s("kind", String("code")).done(), String("bank.example"))
    assert(str_at(code[0].copy(), "label") == some(String("Code")) and at(code[0].copy(), "masked") == Json.Bool(false) and str_at(code[0].copy(), "save") == some(String("")))
    // Without a kind, the why or the label says what it is.
    let (email, _) = ask_fields(Obj.new().s("ref", String("e2")).s("why", String("Your NTNU email (user@ntnu.no) to sign in to Canvas")).done(), String("login.microsoftonline.com"))
    assert(str_at(email[0].copy(), "kind") == some(String("username")) and str_at(email[0].copy(), "label") == some(String("Email or user name")) and at(email[0].copy(), "masked") == Json.Bool(false) and str_at(email[0].copy(), "save") == some(String("microsoftonline-username")))
    let (labelled, _) = ask_fields(Obj.new().s("why", String("Sign in to NTNU")).j("fields", Json.Array([Obj.new().s("ref", String("e3")).s("label", String("Email")).done(), Obj.new().s("ref", String("e4")).s("label", String("Password")).done()])).done(), String("innsida.ntnu.no"))
    assert(str_at(labelled[0].copy(), "kind") == some(String("username")) and str_at(labelled[1].copy(), "kind") == some(String("password")))
    assert(kind_from(String("Your password for user@ntnu.no")) == "password" and kind_from(String("The code from your authenticator")) == "code" and kind_from(String("Your shopping account")) == "password")
    let (_, no_ref) = ask_fields(Obj.new().done(), String())
    assert(no_ref.starts_with("ref is missing"))
    let (_, odd) = ask_fields(Obj.new().s("ref", String("e1")).s("kind", String("pin")).done(), String())
    assert(odd.starts_with("kind is \"pin\""))
    let (_, bad_name) = ask_fields(Obj.new().s("ref", String("e1")).s("save", String("my password")).done(), String())
    assert(bad_name.starts_with("save is \"my password\""))
    let card = secret_card(String("bc_7"), String("a_1"), String(" Your NTNU password "), String("innsida.ntnu.no"), one)
    assert("{card}" == "\{\"id\":\"secret_bc_7\",\"type\":\"secret_ask\",\"title\":\"Your NTNU password\",\"call\":\"bc_7\",\"agent\":\"a_1\",\"site\":\"innsida.ntnu.no\",\"badge\":{badge.badge(String("ntnu"), String(), String())},\"fields\":[\{\"label\":\"Password\",\"kind\":\"password\",\"masked\":true,\"save\":\"ntnu-password\"\}],\"state\":\"asking\",\"saved\":[]\}")
    let filled = secret_card_now(card.copy(), "filled", [String("ntnu-password")])
    assert(str_at(filled.copy(), "state") == some(String("filled")) and "{at(filled.copy(), "saved")}" == "[\"ntnu-password\"]")
    assert(str_at(ended(card.copy()), "state") == some(String("closed")) and str_at(ended(filled), "state") == some(String("filled")))
    let file = secret_card(String("bc_8"), String("a_1"), String("Code"), String(), List<Json>())
    assert(str_at(file.copy(), "site") == some(String("a file on this computer")) and at(file, "badge") == Json.Null)
    assert(site_name(String("www.shop.example.co.uk")) == "example" and site_name(String("10.0.0.5:3000")) == "10.0.0.5" and site_name(String("[::1]:80")) == "")
    let (_, why) = card_of(Obj.new().s("type", String("secret_ask")).done(), String("card_1"))
    assert(why.starts_with("type is \"secret_ask\""))
}

@test
fn makes_the_sign_in_card() {
    assert(str_at(at(sign_in_card(String("acta"), String("ab12"), String()), "badge"), "icon") == some(String("ab12")))
    assert("{sign_in_card(String("acta"), String(), String())}" == "\{\"id\":\"sign_in_acta\",\"type\":\"sign_in\",\"title\":\"Sign in to acta\",\"server\":\"acta\",\"badge\":{badge.badge(String("acta"), String(), String())}\}")
    let (_, why) = card_of(Obj.new().s("type", String("sign_in")).s("server", String("acta")).done(), String("card_1"))
    assert(why.starts_with("type is \"sign_in\""))
}

@test
fn checks_and_tidies() {
    let (c, why) = card_of(Obj.new().s("type", String("choices")).s("title", String(" Which one? ")).j("options", Json.Array([Json.Str(String("Red")), Json.Str(String("  ")), Json.Int(2)])).done(), String("card_1"))
    assert(why.len() == 0)
    assert("{c}" == "\{\"id\":\"card_1\",\"type\":\"choices\",\"title\":\"Which one?\",\"options\":[\"Red\",\"2\"]\}")
    let (_, one) = card_of(Obj.new().s("type", String("choices")).j("options", Json.Array([Json.Str(String("Only"))])).done(), String("card_2"))
    assert(one.starts_with("options has 1"))
    let (_, odd) = card_of(Obj.new().s("type", String("chart")).done(), String("card_3"))
    assert(odd.starts_with("type is \"chart\""))
    let (t, _) = card_of(Obj.new().s("type", String("table")).j("columns", Json.Array([Json.Str(String("A")), Json.Str(String("B"))])).j("rows", Json.Array([Json.Array([Json.Str(String("1"))]), Json.Array([Json.Str(String("x")), Json.Str(String("y")), Json.Str(String("z"))])])).done(), String("card_4"))
    assert("{at(t, "rows")}" == "[[\"1\",\"\"],[\"x\",\"y\"]]")
    let (p, _) = card_of(Obj.new().s("type", String("progress")).s("label", String("Uploading")).j("value", Json.Float(0.5)).done(), String("card_5"))
    assert(at(p, "value").as_f64() == some(0.5))
    let (_, far) = card_of(Obj.new().s("type", String("progress")).j("value", Json.Int(3)).done(), String("card_6"))
    assert(far.starts_with("value is 3"))
    let (l, _) = card_of(Obj.new().s("type", String("checklist")).j("items", Json.Array([Json.Str(String("Plain")), Obj.new().s("text", String("Done one")).b("done", true).done()])).done(), String("card_7"))
    assert("{at(l, "items")}" == "[\{\"text\":\"Plain\",\"done\":false\},\{\"text\":\"Done one\",\"done\":true\}]")
}

fn place_for(kind: str, asked: str) -> String {
    var a = Obj.new().s("type", String(kind))
    if asked.len() > 0 { a = a.s("place", String(asked)) }
    let (p, _) = place_of(a.done())
    return p
}

@test
fn puts_questions_at_the_end() {
    assert(place_for("choices", "") == "end" and place_for("form", "") == "end")
    assert(place_for("progress", "") == "here" and place_for("checklist", "") == "here" and place_for("table", "") == "here" and place_for("facts", "") == "here")
    assert(place_for("choices", "here") == "here" and place_for("facts", "end") == "end")
    let (_, why) = place_of(Obj.new().s("type", String("choices")).s("place", String("top")).done())
    assert(why.starts_with("place is \"top\""))
}

fn form_args() -> Json {
    let fields = Json.Array([
        Obj.new().s("label", String(" Name ")).s("placeholder", String("Your name")).done(),
        Obj.new().s("label", String("Size")).s("kind", String("choice")).j("options", Json.Array([Json.Str(String("Small")), Json.Str(String("Large")), Json.Str(String("Large"))])).s("value", String("Huge")).done(),
        Obj.new().s("label", String("Gift wrap")).s("kind", String("toggle")).b("required", true).done(),
        Obj.new().s("label", String("How many")).s("kind", String("number")).j("value", Json.Int(1)).done(),
        Obj.new().s("label", String("Note")).b("required", false).done(),
    ])
    return Obj.new().s("type", String("form")).s("title", String("Your order")).j("fields", fields).done()
}

fn refused(fields: Json) -> String {
    let (_, w) = card_of(Obj.new().s("type", String("form")).j("fields", fields).done(), String("card_2"))
    return w
}

@test
fn makes_a_form() {
    let (c, why) = card_of(form_args(), String("card_1"))
    assert(why.len() == 0)
    assert("{at(c.copy(), "fields")}" == #"[{"label":"Name","kind":"text","required":true,"value":"","placeholder":"Your name"},{"label":"Size","kind":"choice","required":true,"options":["Small","Large"],"value":"","placeholder":""},{"label":"Gift wrap","kind":"toggle","required":false,"value":false},{"label":"How many","kind":"number","required":true,"value":1,"placeholder":""},{"label":"Note","kind":"text","required":false,"value":"","placeholder":""}]"#)
    assert(refused(Json.Array(List<Json>())).starts_with("fields has 0"))
    assert(refused(Json.Array([Obj.new().s("label", String("A")).done(), Obj.new().s("label", String("A")).done()])).starts_with("Two fields are labelled \"A\""))
    assert(refused(Json.Array([Obj.new().s("label", String("When")).s("kind", String("date")).done()])).starts_with("kind is \"date\" for When"))
    assert(refused(Json.Array([Obj.new().s("label", String("Pick")).s("kind", String("choice")).j("options", Json.Array([Json.Str(String("Only"))])).done()])).starts_with("options has 1 for Pick"))
    assert(refused(Json.Array([Obj.new().done()])).starts_with("Each of fields needs a label"))
}

@test
fn takes_a_form_s_answers() {
    let (c, _) = card_of(form_args(), String("card_1"))
    let given = Obj.new().s("Name", String("  Elliot ")).s("Size", String("Large")).b("Gift wrap", true).s("How many", String("3")).s("Note", String("")).done()
    let (answers, text, why) = form_answer(c.copy(), given)
    assert(why.len() == 0)
    assert("{answers}" == #"{"Name":"Elliot","Size":"Large","Gift wrap":true,"How many":3}"#)
    assert(text == "Name: Elliot\nSize: Large\nGift wrap: Yes\nHow many: 3")
    // A required field left empty, an answer that isn't an option, and a number that isn't one.
    let (_, _, empty) = form_answer(c.copy(), Obj.new().s("Size", String("Large")).j("How many", Json.Int(1)).done())
    assert(empty == "Name needs an answer.")
    let (_, _, odd) = form_answer(c.copy(), Obj.new().s("Name", String("E")).s("Size", String("Huge")).j("How many", Json.Int(1)).done())
    assert(odd.starts_with("Size is \"Huge\""))
    let (_, _, nan) = form_answer(c.copy(), Obj.new().s("Name", String("E")).s("Size", String("Small")).s("How many", String("lots")).done())
    assert(nan.starts_with("How many is \"lots\""))
    let (half, _, _) = form_answer(c.copy(), Obj.new().s("Name", String("E")).s("Size", String("Small")).j("How many", Json.Float(2.5)).done())
    assert("{at(half, "How many")}" == "2.5")
    // Once answered, it's sent, and doesn't answer again.
    let sent = form_answered(c.copy(), answers.copy())
    assert(at(sent.copy(), "answers") == answers)
    let (_, _, again) = form_answer(sent, Obj.new().done())
    assert(again == "That form was sent already.")
    let (_, _, choices) = form_answer(Obj.new().s("type", String("choices")).done(), Obj.new().done())
    assert(choices == "That card isn't a form.")
}
