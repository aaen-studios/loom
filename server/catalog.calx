// The marks loom knows a server by when it isn't an entry, or is a registry
// server with no logo of its own: each file in catalog/, the names it goes by
// (a server's name, or the last part of its registry name, such as
// `com.foreverworks/notion`, or a word of either) and the hosts its servers
// are at (a host or one under it).
const KNOWN: str = #"
    [
      {"logo": "acta.svg", "names": ["acta"], "hosts": ["acta.aaenz.no"]},
      {"logo": "t3.svg", "names": ["t3", "t3code"], "hosts": []},
