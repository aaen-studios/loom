    ]
    "#

// Every entry, in the order the catalog shows them.
pub fn entries() -> List<Json> {
    return match parse(String(DATA)) {
        ok(Json.Array(xs)) => xs,
        _ => List<Json>(),
    }
}

// The entry `id`, or none.
pub fn find(id: String) -> Json? {
    for e in entries() {
        if str_at(e.copy(), "id") == some(id.copy()) { return some(e.copy()) }
    }
    return none
}

pub fn list(j: Json) -> List<Json> {
    if let Json.Array(xs) = j { return xs.copy() }
    return List<Json>()
}

fn names(j: Json) -> List<String> {
    var out = List<String>()
    for x in list(j) {
        if let s = x.as_str() { out.push(s) }
    }
    return out
}

// Where an entry's server runs: `remote`, reached over HTTP, or `instance`, a
// program the instance starts.
pub fn runs(entry: Json) -> String {
    return if at(entry, "package") == Json.Null { String("remote") } else { String("instance") }
}

// The names of the secrets an entry asks for.
pub fn secret_names(entry: Json) -> List<String> {
    var out = List<String>()
    for s in list(at(entry, "secrets")) {
        out.push(str_at(s, "name") ?? String())
    }
    return out
}

// What fills each `{field}`: the person's value, or its `default` when they
// leave it empty, checked, or why it can't be. One that's part of an address
// has no spaces, and one with `choices` is one of them.
fn field_values(entry: Json, given: Json) -> (List<(String, String)>, String) {
    var out = List<(String, String)>()
    let remote = runs(entry.copy()) == "remote"
    for f in list(at(entry.copy(), "fields")) {
        let name = str_at(f.copy(), "name") ?? String()
        let label = str_at(f.copy(), "label") ?? name.copy()
        var value = ((given.get(name.copy()) ?? Json.Null).as_str() ?? String()).trim().copy()
        if value.len() == 0 { value = str_at(f.copy(), "default") ?? String() }
        if value.len() == 0 { return (List<(String, String)>(), "Fill in {label} first.") }
        if value.contains("\n") or value.contains("\{") or value.contains("\}") or (remote and value.contains(" ")) { return (List<(String, String)>(), if remote { "{label} can't have spaces or braces in it." } else { "{label} can't have braces or line breaks in it." }) }
        let choices = names(at(f.copy(), "choices"))
        if not choices.is_empty() and not choices.contains(value.copy()) { return (List<(String, String)>(), "{label} is one of {choices.join(", ")}.") }
        if str_at(f, "kind") == some(String("address")) {
            if not value.starts_with("https://") and not value.starts_with("http://") { return (List<(String, String)>(), "{label} is an address starting with https:// or http://.") }
            value = value.trim_suffix("/").copy()
            let after = value.find("://") ?? 0
            if value[after + 3..].contains("/") { return (List<(String, String)>(), "{label} is only the server's address, such as https://pc.tail1234.ts.net, with no path.") }
        }
        // A whole address, path and all, at one of the entry's hosts where it names them.
        if str_at(f, "kind") == some(String("url")) {
            if not value.starts_with("https://") { return (List<(String, String)>(), "{label} is an address starting with https://.") }
            if not at_hosts(entry.copy(), value.copy()) { return (List<(String, String)>(), "{label} is an address at {names(at(entry.copy(), "hosts")).join(" or ")}.") }
        }
        out.push((name, value))
    }
    return (out, String())
}

// Whether `address` is at one of the hosts `entry` names (`hosts`), or a
// host under one; true for an entry that names none.
fn at_hosts(entry: Json, address: String) -> bool {
    let hosts = names(at(entry, "hosts"))
    if hosts.is_empty() { return true }
    let host = host_of(address)
    for h in hosts {
        if under(host.copy(), h) { return true }
    }
    return false
}

fn filled(text: String, values: List<(String, String)>) -> String {
    var out = text.copy()
    for (k, v) in values {
        out = out.replace("\{{k}\}", v.copy())
    }
    return out
}

// A secret's place in a server's settings: {"secret": NAME}, with its prefix.
fn secret_value(s: Json) -> Json {
    var o = Obj.new().s("secret", str_at(s.copy(), "name") ?? String())
    let prefix = str_at(s, "prefix") ?? String()
    if prefix.len() > 0 { o = o.s("prefix", prefix) }
    return o.done()
}

// The server an entry becomes, as mcp.put takes it, named `name`, or the
// entry's own name when that's empty, with `fields` ({name: value}) filling
// each `{field}`; or why it can't be.
pub fn spec_of(entry: Json, fields: Json, name: String) -> (Json, String) {
    let server = if name.trim().len() > 0 { name.trim().copy() } else { str_at(entry.copy(), "server") ?? String() }
    let (values, why) = field_values(entry.copy(), fields)
    if why.len() > 0 { return (Json.Null, why) }
    var settings = Obj.new()
    let place = if runs(entry.copy()) == "remote" { "header" } else { "env" }
    if let Json.Object(env) = at(entry.copy(), if place == "header" { "headers" } else { "env" }) {
        for (k, v) in env {
            settings.m.insert(k.copy(), Json.Str(filled(v.as_str() ?? String(), values.copy())))
        }
    }
    for s in list(at(entry.copy(), "secrets")) {
        if str_at(s.copy(), "in") != some(String(place)) { return (Json.Null, "The secret {str_at(s, "name") ?? String()} goes in a {place}.") }
        settings.m.insert(str_at(s.copy(), "key") ?? String(), secret_value(s))
    }
    if let address = str_at(entry.copy(), "url") {
        let url = filled(address, values)
        if url.contains("\{") or url.contains("\}") { return (Json.Null, "{url} has a field no one fills in.") }
        return (Obj.new().s("name", server).s("url", url).j("headers", settings.done()).done(), String())
    }
    let (command, args, bad) = program(at(entry, "package"), values)
    if bad.len() > 0 { return (Json.Null, bad) }
    return (Obj.new().s("name", server).s("command", command).j("args", Json.Array(args)).j("env", settings.done()).done(), String())
}

// The program a package runs as, and its arguments, each `{field}` filled
// from `values` (and left as it is without one); or why it isn't one loom runs.
fn program(package: Json, values: List<(String, String)>) -> (String, List<Json>, String) {
    let id = str_at(package.copy(), "name") ?? String()
    let version = str_at(package.copy(), "version") ?? String("latest")
    let registry = str_at(package.copy(), "registry") ?? String()
    var args = List<Json>()
    var command = String()
    // What npx or uvx itself is given goes before the package.
    var runtime = List<Json>()
    for a in names(at(package.copy(), "runtime_args")) {
        runtime.push(Json.Str(filled(a, values.copy())))
    }
    if registry == "npm" {
        command = String("npx")
        args.push(Json.Str(String("-y")))
        args.extend(runtime)
        args.push(Json.Str("{id}@{version}"))
    } else if registry == "pypi" {
        command = String("uvx")
        args.extend(runtime)
        args.push(Json.Str(if version == "latest" { "{id}@latest" } else { "{id}=={version}" }))
    } else {
        return (String(), List<Json>(), "A {registry} package isn't one loom runs: only npm and pypi.")
    }
    for a in names(at(package, "args")) {
        args.push(Json.Str(filled(a, values.copy())))
    }
    return (command, args, String())
}

// `spec` without the headers or variables that are one of the secrets
// `names`: the optional ones the person has none of.
pub fn without_secrets(spec: Json, left_out: List<String>) -> Json {
    if left_out.is_empty() { return spec.copy() }
    var m = LinkedMap<String, Json>()
    if let Json.Object(o) = spec {
        for (k, v) in o {
            if let Json.Object(settings) = v.copy() {
                if k == "env" or k == "headers" {
                    var kept = LinkedMap<String, Json>()
                    for (name, value) in settings {
                        if not left_out.contains(str_at(value.copy(), "secret") ?? String()) { kept.insert(name.copy(), value.copy()) }
                    }
                    m.insert(k.copy(), Json.Object(kept))
                    continue
                }
            }
            m.insert(k.copy(), v.copy())
        }
    }
    return Json.Object(m)
}

// The ways an entry is reached, as mcpregistry.ways gives a server.json's,
// to tell a registry server is one in the catalog: its fixed address, or its
// package as `npm:name`.
pub fn ways(entry: Json) -> List<String> {
    if let address = str_at(entry.copy(), "url") {
        if address.contains("\{") { return List<String>() }
        return [address.to_lower_root().trim_suffix("/").copy()]
    }
    let p = at(entry, "package")
    let name = (str_at(p.copy(), "name") ?? String()).to_lower_root()
    if name.len() == 0 { return List<String>() }
    return ["{str_at(p, "registry") ?? String()}:{name}"]
}

// Whether the person's server `had` is what `spec` would add: the same address,
// or the same program with the same arguments.
pub fn same_server(had: Json, spec: Json) -> bool {
    if str_at(had.copy(), "url") != none or str_at(spec.copy(), "url") != none { return str_at(had, "url") == str_at(spec, "url") }
    return str_at(had.copy(), "command") == str_at(spec.copy(), "command") and at(had, "args") == at(spec, "args")
}

// Whether the person's server `server` is reached as `entry`'s would be, for one
// added by hand that's the same: by its fixed address, or its program.
pub fn matches(entry: Json, server: Json) -> bool {
    if not list(at(entry.copy(), "fields")).is_empty() { return false }
    let (spec, why) = spec_of(entry, Obj.new().done(), String())
    return why.len() == 0 and same_server(server, spec)
}

// The `{field}` values that would make `entry`'s address `url`, for an entry
// whose address is made of its fields, such as T3 Code's `{address}/mcp`: an
// object by field name, or none when `url` hasn't that shape.
pub fn fields_of(entry: Json, url: String) -> Json? {
    let template = str_at(entry.copy(), "url") else return none
    if list(at(entry.copy(), "fields")).is_empty() { return none }
    if not at_hosts(entry.copy(), url.copy()) { return none }
    let wanted = url.trim().trim_suffix("/").copy()
    var rest = template.copy()
    var left = wanted.copy()
    var given = Obj.new()
    while let open = rest.find("\{") {
        let before = rest[..open].copy()
        if not left.starts_with(before[..]) { return none }
        left = left[before.len()..].copy()
        let close = rest.find("\}") else return none
        let name = rest[open + 1..close].copy()
        rest = rest[close + 1..].copy()
        // What follows the field, up to the next: the field's value ends where it starts.
        let next = match rest.find("\{") {
            some(k) => rest[..k].copy(),
            none => rest.copy(),
        }
        var value = String()
        if rest.find("\{") == none {
            if not left.ends_with(next[..]) { return none }
            value = left[..left.len() - next.len()].copy()
        } else {
            if next.len() == 0 { return none }
            let at_next = left.find(next[..]) else return none
            value = left[..at_next].copy()
        }
        if value.len() == 0 { return none }
        left = left[value.len()..].copy()
        given.m.insert(name, Json.Str(value))
    }
    let values = given.done()
    let (spec, why) = spec_of(entry, values.copy(), String())
    if why.len() > 0 or (str_at(spec, "url") ?? String()).trim_suffix("/") != wanted[..] { return none }
    return some(values)
}

// Whether a server reached at an address of `entry`'s shape (fields_of) is
// one of `entry`'s, as what loom knows of it says: the name the metadata of its
// sign-in gives it (`resource_name`, RFC 9728) is the entry's, or the tools its
// last test found are at least half of the entry's, and two or more.
pub fn recognised(entry: Json, resource_name: String, tools: List<String>) -> bool {
    let name = (str_at(entry.copy(), "name") ?? String()).to_lower_root()
    if resource_name.trim().len() > 0 and resource_name.trim().to_lower_root() == name { return true }
    var known = names(at(entry.copy(), "reads"))
    known.extend(names(at(entry, "changes")))
    var found: usize = 0
    for t in known.copy() {
        if tools.contains(t) { found += 1 }
    }
    return found >= 2 and found * 2 >= known.len()
}

// Whether the person's server `server`, added by hand or by an agent, is one of
// `entry`'s with fields, by its shape: its address fits the entry's, and
// recognised says so of it, or, for an entry that names its hosts (Composio's
// backend.composio.dev and rube.app), it's at one of them, which says so alone.
pub fn matches_by_shape(entry: Json, server: Json, resource_name: String, tools: List<String>) -> bool {
    let address = str_at(server, "url") else return false
    if fields_of(entry.copy(), address) == none { return false }
    if not names(at(entry.copy(), "hosts")).is_empty() { return true }
    return recognised(entry, resource_name, tools)
}

// An entry as catalog.list gives it, with `have`, the names of the person's
// secrets, `servers`, the names of their servers made from it, `icons`, the
// icon and the dark one that one of those servers gave of its own (each a
// file's SHA-256, or ""), which its badge shows over the entry's mark, and
// `connecting`, a connect under way for it, or null.
pub fn listed(entry: Json, have: List<String>, servers: List<String>, icons: (String, String), connecting: Json) -> Json {
    let e = entry.copy()
    // Its mark, in one colour (mark_of), and its file's name without .svg where
    // it's one of loom's own, which the iPhone has built in.
    let (mark, file) = mark_of(e.copy())
    var o = Obj.new().s("id", str_at(e.copy(), "id") ?? String()).s("name", str_at(e.copy(), "name") ?? String()).s("category", str_at(e.copy(), "category") ?? String()).s("description", str_at(e.copy(), "description") ?? String()).s("maker", str_at(e.copy(), "maker") ?? String()).maybe("website", str_at(e.copy(), "website")).maybe("icon_svg", mark)
    if file.len() > 0 { o = o.s("mark", file.trim_suffix(".svg").copy()) }
    o = o.j("badge", badge.badge(str_at(e.copy(), "server") ?? String(), icons.0.copy(), icons.1.copy())).s("server", str_at(e.copy(), "server") ?? String()).s("runs", runs(e.copy()))
    // One from the MCP Registry (server/mcpregistry.calx).
    if bool_at(e.copy(), "community") == some(true) {
        o = o.b("community", true).s("registry", str_at(e.copy(), "registry") ?? String()).s("version", str_at(e.copy(), "version") ?? String())
        if at(e.copy(), "also") != Json.Null { o = o.j("also", at(e.copy(), "also")) }
    }
    if let why = str_at(e.copy(), "unsupported") {
        o = o.s("unsupported", why)
    } else if let address = str_at(e.copy(), "url") {
        o = o.s("url", address)
    } else {
        // With a `{field}` for each field, as an address has.
        let (command, args, _) = program(at(e.copy(), "package"), List<(String, String)>())
        o = o.s("command", command).j("args", Json.Array(args))
    }
    var fields = List<Json>()
    for f in list(at(e.copy(), "fields")) {
        var field = Obj.new().s("name", str_at(f.copy(), "name") ?? String()).s("label", str_at(f.copy(), "label") ?? String()).maybe("placeholder", str_at(f.copy(), "placeholder")).maybe("default", str_at(f.copy(), "default")).maybe("description", str_at(f.copy(), "description"))
        if at(f.copy(), "choices") != Json.Null { field = field.j("choices", at(f, "choices")) }
        fields.push(field.done())
    }
    var secrets = List<Json>()
    for s in list(at(e.copy(), "secrets")) {
        let name = str_at(s.copy(), "name") ?? String()
        var secret = Obj.new().s("name", name.copy()).s("label", str_at(s.copy(), "label") ?? String()).maybe("placeholder", str_at(s.copy(), "placeholder")).maybe("description", str_at(s.copy(), "description")).b("have", have.contains(name))
        if bool_at(s, "optional") == some(true) { secret = secret.b("optional", true) }
        secrets.push(secret.done())
    }
    var tools = List<Json>()
    for (key, kind) in [("reads", "read"), ("changes", "change")] {
        for n in names(at(e.copy(), key)) {
            tools.push(Obj.new().s("name", n).s("kind", String(kind)).done())
        }
    }
    var on = List<Json>()
    for s in servers {
        on.push(Json.Str(s.copy()))
    }
    o = o.j("fields", Json.Array(fields)).s("sign_in", str_at(e.copy(), "sign_in") ?? String()).j("secrets", Json.Array(secrets)).maybe("note", str_at(e.copy(), "note")).j("tools", Json.Array(tools)).s("tools_from", str_at(e.copy(), "tools_from") ?? String()).b("tools_checked", bool_at(e.copy(), "tools_checked") ?? false)
    o = o.j("servers", Json.Array(on)).b("connected", not servers.is_empty())
    // One whose fields make its address, such as T3 Code's, can be connected
    // once for each: the person's T3 on each of their computers.
    if not list(at(e, "fields")).is_empty() { o = o.b("several", true) }
    if connecting != Json.Null { o = o.j("connecting", connecting) }
    return o.done()
}

// The categories that have entries, in CATEGORIES' order.
pub fn categories() -> List<String> {
    var out = List<String>()
    let all = entries()
    for c in CATEGORIES {
        for e in all.copy() {
            if str_at(e, "category") == some(String(c)) {
                out.push(String(c))
                break
            }
        }
    }
    return out
}

fn good_name(name: String) -> bool {
    if name.len() == 0 or name.len() > 64 { return false }
    for r in name.runes() {
        if not ((r >= 'a' and r <= 'z') or (r >= '0' and r <= '9') or r == '-') { return false }
    }
    return true
}

@test
fn every_entry_is_whole() {
    let all = entries()
    assert(all.len() >= 9)
    assert(str_at(all[0].copy(), "id") == some(String("acta")))
    var ids = List<String>()
    for e in all {
        let id = str_at(e.copy(), "id") ?? String()
        assert(id.len() > 0 and not ids.contains(id.copy()))
        ids.push(id.copy())
        assert(good_name(str_at(e.copy(), "server") ?? String()))
        let category = str_at(e.copy(), "category") ?? String()
        var known = false
        for c in CATEGORIES {
            if category == c { known = true }
        }
        assert(known)
        for key in ["name", "description", "maker", "tools_from"] {
            assert((str_at(e.copy(), key) ?? String()).len() > 0)
        }
        let sign_in = str_at(e.copy(), "sign_in") ?? String()
        assert(sign_in == "oauth" or sign_in == "secret" or sign_in == "none")
        assert((sign_in == "secret") == not list(at(e.copy(), "secrets")).is_empty())
        assert(names(at(e.copy(), "reads")).len() + names(at(e.copy(), "changes")).len() > 0)
        assert(bool_at(e.copy(), "tools_checked") != none)
        // Each converts, with a value for every field.
        var given = Obj.new()
        let hosts = names(at(e.copy(), "hosts"))
        let host = if hosts.is_empty() { String("example.com") } else { hosts[0].copy() }
        for f in list(at(e.copy(), "fields")) {
            given.m.insert(str_at(f, "name") ?? String(), Json.Str("https://{host}"))
        }
        let (spec, why) = spec_of(e.copy(), given.done(), String())
        assert(why.len() == 0)
        let address = str_at(spec.copy(), "url") ?? String()
        assert(address.starts_with("https://") or str_at(spec, "command") != none)
        // A logo is a mark that's there, in one colour.
        if let logo = str_at(e.copy(), "logo") {
            let svg = logo_svg(logo) ?? String()
            assert(svg.starts_with("<svg ") and svg.ends_with("</svg>") and svg.contains("currentColor"))
        }
    }
    assert(logo_svg(String("nothing.svg")) == none)
    assert(categories() == [String("Work"), String("Code"), String("Home")])
    // Every entry has a mark of its own.
    for e in entries() {
        let (svg, file) = mark_of(e.copy())
        assert(svg != none and file == (str_at(e, "logo") ?? String()))
    }
}

@test
fn turns_an_entry_into_a_server() {
    let acta = find(String("acta"))!
    let (a, _) = spec_of(acta.copy(), Json.Null, String())
    assert("{a}" == #"{"name":"acta","url":"https://acta.aaenz.no/api/mcp","headers":{}}"#)
    assert(runs(acta.copy()) == "remote" and matches(acta, a))
    // A field fills the address, and the person can name it.
    let t3 = find(String("t3"))!
    let (t, _) = spec_of(t3.copy(), Obj.new().s("address", String(" https://pc.tail1234.ts.net/ ")).done(), String("t3-pc"))
    assert("{t}" == #"{"name":"t3-pc","url":"https://pc.tail1234.ts.net/mcp","headers":{}}"#)
    assert(not matches(t3.copy(), t))
    for (bad, why) in [(#"{}"#, "Fill in Address first."), (#"{"address":"pc.local"}"#, "Address is an address starting with https:// or http://."), (#"{"address":"https://pc/x"}"#, "Address is only the server's address, such as https://pc.tail1234.ts.net, with no path."), (#"{"address":"https://{x}"}"#, "Address can't have spaces or braces in it.")] {
        let (none_made, said) = spec_of(t3.copy(), parse(String(bad))!, String())
        assert(none_made == Json.Null and said == why)
    }
    // A secret goes in its header, after its prefix.
    let (g, _) = spec_of(find(String("github"))!, Json.Null, String())
    assert("{g}" == #"{"name":"github","url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":{"secret":"GITHUB_TOKEN","prefix":"Bearer "}}}"#)
    let (h, _) = spec_of(find(String("home-assistant"))!, Obj.new().s("address", String("http://homeassistant.local:8123")).done(), String())
    assert("{h}" == #"{"name":"home-assistant","url":"http://homeassistant.local:8123/api/mcp","headers":{"Authorization":{"secret":"HOME_ASSISTANT_TOKEN","prefix":"Bearer "}}}"#)
    // A package runs on the instance.
    let playwright = find(String("playwright"))!
    let (p, _) = spec_of(playwright.copy(), Json.Null, String())
    assert("{p}" == #"{"name":"playwright","command":"npx","args":["-y","@playwright/mcp@latest"],"env":{}}"#)
    assert(runs(playwright.copy()) == "instance" and matches(playwright, p))
    let py = parse(String(#"{"id":"x","server":"x","package":{"registry":"pypi","name":"mcp-x","version":"1.2","args":["--key","{key}"]},"fields":[{"name":"key","label":"Key"}],"env":{"X_HOME":"{key}"},"secrets":[{"name":"X_TOKEN","in":"env","key":"X_TOKEN"}]}"#))!
    let (q, _) = spec_of(py, Obj.new().s("key", String("k1")).done(), String())
    assert("{q}" == #"{"name":"x","command":"uvx","args":["mcp-x==1.2","--key","k1"],"env":{"X_HOME":"k1","X_TOKEN":{"secret":"X_TOKEN"}}}"#)
    let oci = parse(String(#"{"id":"o","server":"o","package":{"registry":"oci","name":"x"}}"#))!
    let (_, no) = spec_of(oci, Json.Null, String())
    assert(no == "A oci package isn't one loom runs: only npm and pypi.")
}

@test
fn knows_an_entry_with_fields_by_its_shape() {
    let t3 = find(String("t3"))!
    // The address fits T3's, and gives its field back.
    assert("{fields_of(t3.copy(), String("https://aaen-vps.tailb27d4f.ts.net:8444/mcp")) ?? Json.Null}" == #"{"address":"https://aaen-vps.tailb27d4f.ts.net:8444"}"#)
    assert(fields_of(t3.copy(), String("https://pc.tail1234.ts.net/mcp/")) != none)
    for bad in ["https://pc.tail1234.ts.net/api/mcp", "https://pc.tail1234.ts.net/sse", "pc.local/mcp", "/mcp"] {
        assert(fields_of(t3.copy(), String(bad)) == none)
    }
    assert(fields_of(find(String("acta"))!, String("https://acta.aaenz.no/api/mcp")) == none)
    let ha = find(String("home-assistant"))!
    assert("{fields_of(ha.copy(), String("http://homeassistant.local:8123/api/mcp")) ?? Json.Null}" == #"{"address":"http://homeassistant.local:8123"}"#)
    assert(fields_of(ha, String("http://homeassistant.local:8123/mcp")) == none)
    // A server of that shape is T3's by its sign-in's metadata, or by its tools.
    let server = Obj.new().s("name", String("t3-vps")).s("url", String("https://aaen-vps.tailb27d4f.ts.net:8444/mcp")).j("headers", Obj.new().done()).done()
    assert(matches_by_shape(t3.copy(), server.copy(), String("T3 Code"), List<String>()))
    let tools: List<String> = [String("t3_project_list"), String("t3_thread_list"), String("t3_thread_read"), String("t3_thread_search"), String("t3_thread_launch"), String("t3_thread_send"), String("other")]
    assert(matches_by_shape(t3.copy(), server.copy(), String(), tools))
    // Not by its shape alone, nor with another's tools or name.
    assert(not matches_by_shape(t3.copy(), server.copy(), String(), List<String>()))
    assert(not matches_by_shape(t3.copy(), server.copy(), String("Acta"), [String("list_boards"), String("t3_thread_list")]))
    let elsewhere = Obj.new().s("name", String("x")).s("url", String("https://mcp.example.com/api/mcp")).done()
    assert(not matches_by_shape(t3.copy(), elsewhere, String("T3 Code"), List<String>()))
    assert(not matches(t3, server))
}

@test
fn lists_an_entry() {
    let github = find(String("github"))!
    let l = listed(github.copy(), [String("GITHUB_TOKEN")], [String("github")], (String(), String()), Json.Null)
    assert(str_at(l.copy(), "runs") == some(String("remote")) and str_at(l.copy(), "sign_in") == some(String("secret")) and bool_at(l.copy(), "connected") == some(true))
    assert("{at(l.copy(), "secrets")}" == #"[{"name":"GITHUB_TOKEN","label":"Personal access token","placeholder":"github_pat_…","have":true}]"#)
    let tools = list(at(l.copy(), "tools"))
    assert("{tools[0]}" == #"{"name":"get_me","kind":"read"}"#)
    assert("{tools[tools.len() - 1]}" == #"{"name":"pull_request_review_write","kind":"change"}"#)
    assert(at(l.copy(), "connecting") == Json.Null and "{at(l.copy(), "badge")}" == "{badge.badge(String("github"), String(), String())}")
    assert(str_at(l, "icon_svg") == logo_svg(String("github.svg")))
    // The icon the person's server gave is on its badge.
    let iconed = listed(github, List<String>(), [String("github")], (String("ab12"), String("cd34")), Json.Null)
    assert("{at(iconed, "badge")}" == "{badge.badge(String("github"), String("ab12"), String("cd34"))}")
    // Playwright's mark, and the name the iPhone has it by.
    let p = listed(find(String("playwright"))!, List<String>(), List<String>(), (String(), String()), Json.Null)
    assert(str_at(p.copy(), "command") == some(String("npx")) and str_at(p.copy(), "url") == none and bool_at(p.copy(), "connected") == some(false) and str_at(p.copy(), "icon_svg") == logo_svg(String("playwright.svg")) and str_at(p.copy(), "mark") == some(String("playwright")) and bool_at(p, "several") == none)
    // One with fields can be connected once for each of them.
    let t = listed(find(String("t3"))!, List<String>(), [String("t3-vps"), String("t3-pc")], (String(), String()), Json.Null)
    assert(bool_at(t.copy(), "several") == some(true) and "{at(t, "servers")}" == #"["t3-vps","t3-pc"]"#)
}

@test
fn finds_a_mark_in_order() {
    // The entry's own logo first.
    let (github, file) = mark_of(find(String("github"))!)
    assert(github == logo_svg(String("github.svg")) and file == "github.svg")
    // Then the one loom knows the server by: by its host, then by its name.
    assert(known_logo(String("x"), String("https://mcp.notion.com/mcp")) == some(String("notion.svg")))
    assert(known_logo(String("io.github.someone/linear-mcp"), String()) == some(String("linear.svg")))
    assert(known_logo(String("hass_mcp"), String()) == some(String("home-assistant.svg")))
    assert(known_logo(String("mcp-home-assistant"), String()) == some(String("home-assistant.svg")))
    assert(known_logo(String("io.github.x/lights"), String("https://lights.example.com/mcp")) == none)
    assert(known_logo(String("notionist"), String()) == none and known_logo(String("x"), String("https://evilnotion.com")) == none)
    let registry = Obj.new().s("id", String("registry:com.foreverworks/notion")).s("registry", String("com.foreverworks/notion")).s("server", String("notion")).s("url", String("https://notion.foreverworks.com/mcp")).s("icon_svg", String(#"<svg viewBox="0 0 1 1"><path fill="red" d="M0 0"/></svg>"#)).done()
    let (n, nf) = mark_of(registry)
    assert(n == logo_svg(String("notion.svg")) and nf == "notion.svg")
    // Then its own icon, in one colour.
    let lights = Obj.new().s("id", String("registry:io.github.x/lights")).s("registry", String("io.github.x/lights")).s("url", String("https://lights.example.com/mcp")).s("icon_svg", String(#"<svg viewBox="0 0 24 24"><rect width="24" height="24" fill="white"/><path fill="rgb(255,136,0)" stroke='red' d="M1 1"/><circle style="fill:#0a0;stroke:none" data-fill="x"/></svg>"#)).done()
    let (l, lf) = mark_of(lights)
    assert(lf.len() == 0)
    assert(l == some(String(#"<svg fill="currentColor" viewBox="0 0 24 24"><path fill="currentColor" stroke='currentColor' d="M1 1"/><circle style="fill:currentColor;stroke:none" data-fill="x"/></svg>"#)))
    // Else nothing, and the apps draw its initial.
    let pictured = Obj.new().s("id", String("registry:io.github.x/pic")).s("registry", String("io.github.x/pic")).s("icon_svg", String(#"<svg><image href="a.png"/></svg>"#)).done()
    let (p, _) = mark_of(pictured)
    assert(p == none and mono(String("not a picture")) == none)
    let (bare, _) = mark_of(parse(String(#"{"id":"registry:io.github.x/bare","registry":"io.github.x/bare"}"#))!)
    assert(bare == none)
    // A server of the person's that's no entry's has the one loom knows it by.
    let (s, sf) = server_mark(Json.Null, Obj.new().s("name", String("my-gmail")).s("url", String("https://mail.example.com/mcp")).done())
    assert(s == logo_svg(String("gmail.svg")) and sf == "gmail.svg")
    let (none_known, _) = server_mark(Json.Null, Obj.new().s("name", String("things")).done())
    assert(none_known == none)
}

@test
fn knows_composio_by_its_host() {
    let composio = find(String("composio"))!
    let backend = Obj.new().s("name", String("composio")).s("url", String("https://backend.composio.dev/v3/mcp/0f1e2d3c-aaaa/mcp?user_id=me")).j("headers", Obj.new().j("x-api-key", Obj.new().s("secret", String("COMPOSIO_API_KEY")).done()).done()).done()
    let rube = Obj.new().s("name", String("composio")).s("url", String("https://rube.app/mcp")).j("headers", Obj.new().done()).done()
    for s in [backend.copy(), rube.copy()] {
        assert(matches_by_shape(composio.copy(), s, String(), List<String>()))
    }
    // Not one somewhere else, nor one that isn't https.
    for bad in ["https://mcp.example.com/mcp", "https://composio.dev.example.com/mcp", "http://rube.app/mcp"] {
        let other = Obj.new().s("name", String("composio")).s("url", String(bad)).done()
        assert(not matches_by_shape(composio.copy(), other, String("Composio"), List<String>()))
    }
    // No other entry takes them.
    for e in entries() {
        if str_at(e.copy(), "id") == some(String("composio")) { continue }
        assert(not matches(e.copy(), backend.copy()) and not matches_by_shape(e.copy(), backend.copy(), String(), List<String>()))
        assert(not matches_by_shape(e, rube.copy(), String(), List<String>()))
    }
    // Connecting one: the address as it's given, with the key as its x-api-key header.
    let (spec, why) = spec_of(composio.copy(), Obj.new().s("address", String("https://backend.composio.dev/v3/mcp/abc/mcp?user_id=me")).done(), String())
    assert(why.len() == 0 and "{spec}" == #"{"name":"composio","url":"https://backend.composio.dev/v3/mcp/abc/mcp?user_id=me","headers":{"x-api-key":{"secret":"COMPOSIO_API_KEY"}}}"#)
    assert("{without_secrets(spec, [String("COMPOSIO_API_KEY")])}" == #"{"name":"composio","url":"https://backend.composio.dev/v3/mcp/abc/mcp?user_id=me","headers":{}}"#)
    let (_, elsewhere) = spec_of(composio.copy(), Obj.new().s("address", String("https://mcp.example.com/mcp")).done(), String())
    assert(elsewhere == "MCP address is an address at composio.dev or rube.app.")
    let (_, plain) = spec_of(composio, Obj.new().s("address", String("http://rube.app/mcp")).done(), String())
    assert(plain == "MCP address is an address starting with https://.")
}
