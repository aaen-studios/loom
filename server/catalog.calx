module server.catalog

// The integrations catalog (PLAN.md, "The integrations catalog"): MCP servers
// loom ships a list of, each with what it is, how it's reached, how it signs
// in and the tools it offers, each marked as one that only reads or one that
// changes something, which neither the MCP Registry nor a server says before
// the person has signed in. `catalog.list` gives it to the apps, and
// `catalog.connect` turns an entry, with what the person filled in, into a
// server as `mcp.put` takes it (`spec_of`), then adds it, signs in and asks
// which agents get it.
//
// The list is `DATA` below, JSON, and ships with each release: changing it is a
// pull request. Each entry:
//
//     id, name, category (one of CATEGORIES), description (one line), maker,
//     website?, logo? (its mark's file in catalog/, one colour in currentColor,
//     which goes to the apps as `icon_svg`: logo_svg below, and catalog/README.md
//     says where each came from), server (the name it's added as), and how it's
//     reached: `url` (an https address, with
//     `{field}` for each field), or `package` ({registry: npm or pypi, name,
//     version, args?}), which runs on the instance, with `env`? ({NAME: text}).
//     fields? ([{name, label, placeholder?, kind?}]: `address` is an http(s)
//     address with no / at its end), sign_in (`oauth`, `secret` or `none`),
//     secrets? (for `secret`: [{name, label, placeholder?, in: header or env,
//     key, prefix?}], each a secret of the person's by that name, sent as the
//     header or variable `key`, after `prefix`), note? (one line, only where the
//     person would go wrong without it), reads and changes (the tools' names),
//     tools_from (where they were read) and tools_checked (false where the
//     names couldn't be checked against the server or its own docs).
//
// An entry from the MCP Registry (server/mcpregistry.calx) has the same
// shape, with `community`, `registry`, `version` and `also`?, and may have
// more: `headers` ({NAME: text}) for a remote, `runtime_args` in its package
// (what npx or uvx is given before it), a field's `default`, `choices` and
// `description`, a secret's `description` and `optional`, and `unsupported`,
// why it can't be connected, in place of how it's reached.
import std.json.{Json, parse}
import shared.badge
import shared.obj.{Obj, at, bool_at, str_at}

pub const CATEGORIES: [str; 7] = ["Work", "Code", "Mail & calendar", "Files", "Money", "Home", "Fun"]

// The entries' marks (catalog/README.md), built into the program as their files are.
const ACTA: [u8; 532] = embed("catalog/acta.svg")
const GITHUB: [u8; 811] = embed("catalog/github.svg")
const NOTION: [u8; 967] = embed("catalog/notion.svg")
const LINEAR: [u8; 442] = embed("catalog/linear.svg")
const VERCEL: [u8; 121] = embed("catalog/vercel.svg")
const CLOUDFLARE: [u8; 1163] = embed("catalog/cloudflare.svg")
const HOME_ASSISTANT: [u8; 662] = embed("catalog/home-assistant.svg")
const T3: [u8; 869] = embed("catalog/t3.svg")

// The SVG of the mark an entry's `logo` names, or none.
pub fn logo_svg(name: String) -> String? {
    let text = if name == "acta.svg" {
        String.from_utf8(ACTA[..])
    } else if name == "github.svg" {
        String.from_utf8(GITHUB[..])
    } else if name == "notion.svg" {
        String.from_utf8(NOTION[..])
    } else if name == "linear.svg" {
        String.from_utf8(LINEAR[..])
    } else if name == "vercel.svg" {
        String.from_utf8(VERCEL[..])
    } else if name == "cloudflare.svg" {
        String.from_utf8(CLOUDFLARE[..])
    } else if name == "home-assistant.svg" {
        String.from_utf8(HOME_ASSISTANT[..])
    } else if name == "t3.svg" {
        String.from_utf8(T3[..])
    } else {
        return none
    }
    return some((text ?? String()).trim().copy())
}

