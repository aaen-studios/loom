      {"logo": "notion.svg", "names": ["notion"], "hosts": ["notion.com", "notion.so"]},
      {"logo": "linear.svg", "names": ["linear"], "hosts": ["linear.app"]},
      {"logo": "vercel.svg", "names": ["vercel"], "hosts": ["vercel.com"]},
      {"logo": "cloudflare.svg", "names": ["cloudflare"], "hosts": ["cloudflare.com"]},
      {"logo": "playwright.svg", "names": ["playwright"], "hosts": ["playwright.dev"]},
      {"logo": "home-assistant.svg", "names": ["home-assistant", "homeassistant", "hass"], "hosts": ["home-assistant.io", "nabu.casa"]},
      {"logo": "composio.svg", "names": ["composio", "rube"], "hosts": ["composio.dev", "rube.app"]},
      {"logo": "gmail.svg", "names": ["gmail"], "hosts": ["gmail.com"]},
      {"logo": "discord.svg", "names": ["discord"], "hosts": ["discord.com"]}
    ]
    "#

// The SVG of the mark an entry's `logo` names, or none.
pub fn logo_svg(name: String) -> String? {
    let text = if name == "acta.svg" {
        String.from_utf8(ACTA[..])
    } else if name == "github.svg" {
        String.from_utf8(GITHUB[..])
    } else if name == "notion.svg" {
        String.from_utf8(NOTION[..])
    } else if name == "linear.svg" {
        String.from_utf8(LINEAR[..])
    } else if name == "vercel.svg" {
        String.from_utf8(VERCEL[..])
    } else if name == "cloudflare.svg" {
        String.from_utf8(CLOUDFLARE[..])
    } else if name == "home-assistant.svg" {
        String.from_utf8(HOME_ASSISTANT[..])
    } else if name == "t3.svg" {
        String.from_utf8(T3[..])
    } else if name == "playwright.svg" {
        String.from_utf8(PLAYWRIGHT[..])
    } else if name == "composio.svg" {
        String.from_utf8(COMPOSIO[..])
    } else if name == "gmail.svg" {
        String.from_utf8(GMAIL[..])
    } else if name == "discord.svg" {
        String.from_utf8(DISCORD[..])
    } else {
        return none
    }
    return some((text ?? String()).trim().copy())
}

// The host of `address`, lowercased, or "".
pub fn host_of(address: String) -> String {
    return match Url.parse(address.trim().copy()) {
        ok(u) => u.host.copy() ?? String(),
        err(_) => String(),
    }
}

// Whether `host` is `known` or a host under it.
fn under(host: String, known: String) -> bool {
    return host.len() > 0 and (host == known or host.ends_with(".{known}"[..]))
}

// The words of a name, split at anything that isn't a letter or a digit.
fn words_of(name: String) -> List<String> {
    var out = List<String>()
    var word = String()
    for r in name.to_lower_root().runes() {
        if (r >= 'a' and r <= 'z') or (r >= '0' and r <= '9') {
            word.push(r)
        } else if word.len() > 0 {
            out.push(word.copy())
            word = String()
        }
    }
    if word.len() > 0 { out.push(word) }
    return out
}

// The file of the mark loom knows a server by (KNOWN): first by the host of
// its address, then by its name, whole or by a word of it; or none.
pub fn known_logo(name: String, address: String) -> String? {
    let known = match parse(String(KNOWN)) {
        ok(Json.Array(xs)) => xs,
        _ => List<Json>(),
    }
    let host = host_of(address)
    for k in known.copy() {
        for h in names(at(k.copy(), "hosts")) {
            if under(host.copy(), h) { return str_at(k, "logo") }
        }
    }
    // A registry name's last part (`io.github.x/notion-mcp`) is its own name.
    let parts = name.to_lower_root().split("/")
    let last = parts[parts.len() - 1].copy()
    let whole = last.replace("_", "-")
    let words = words_of(last)
    for k in known {
        for n in names(at(k.copy(), "names")) {
            if whole == n or words.contains(n.copy()) or (n.contains("-") and whole.contains(n[..])) { return str_at(k, "logo") }
        }
    }
    return none
}

// `svg` made one colour, drawn in currentColor, for a server's icon that has
// colours of its own (a registry server's): every fill and stroke that's a
// colour becomes currentColor, the root fills in it where it says nothing, and
// a background as wide and high as the picture is left out, since it would
// fill the whole tile. None for one that isn't an SVG, or that has a picture
// or a script in it, which can't be one colour.
pub fn mono(svg: String) -> String? {
    let text = svg.trim().copy()
    let lower = text.to_lower_root()
    let start = lower.find("<svg") else return none
    if not lower.ends_with("</svg>") { return none }
    for bad in ["<image", "<script", "<foreignobject", "<use"] {
        if lower.contains(bad) { return none }
    }
    var out = text[start..].copy()
    out = without_background(out)
    for attr in ["fill", "stroke"] {
        out = recoloured(out, attr)
    }
    // The root draws in currentColor unless it says otherwise.
    let root_end = out.find(">") else return none
    let root = out[..root_end].copy()
    if not root.contains(" fill=") and not root.contains("fill:") {
        out = "{out[..4]} fill=\"currentColor\"{out[4..]}"
    }
    return some(out)
}

// `text` with each `attr="…"`, and `attr:…` in a style, that's a colour made
// currentColor; `none` and `transparent` stay.
fn recoloured(text: String, attr: str) -> String {
    var out = text.copy()
    for (open, close) in [("{attr}=\"", "\""), ("{attr}='", "'"), ("{attr}:", ";")] {
        var made = String()
        var rest = out.copy()
        while let at_key = rest.find(open[..]) {
            // Only the attribute itself, not one whose name ends in it (`data-fill`).
            let before: u8 = if at_key == 0 { 32 } else { rest.byte_at(at_key - 1) }
            let after = rest[at_key + open.len()..].copy()
            made.push_str(rest[..at_key + open.len()])
            let quoted = close != ";"
            let end = if quoted { after.find(close[..]) ?? after.len() } else {
                var e = after.len()
                for stop in [";", "\"", "'"] {
                    if let k = after.find(stop) { if k < e { e = k } }
                }
                e
            }
            let value = after[..end].trim().to_lower_root()
            // A space, a line break, a tab, a quote or a `;` before it.
            let named = before == 32 or before == 10 or before == 9 or before == 13 or before == 34 or before == 39 or before == 59
            if named and value != "none" and value != "transparent" and value != "currentcolor" and value.len() > 0 {
                made.push_str("currentColor")
            } else {
                made.push_str(after[..end])
            }
            rest = after[end..].copy()
        }
        made.push_str(rest[..])
        out = made
    }
    return out
}

// The width and height of `svg`'s picture, from its viewBox, as written.
fn view_size(svg: String) -> (String, String) {
    let root_end = svg.find(">") ?? svg.len()
    let root = svg[..root_end].copy()
    let at_box = root.find("viewBox=\"") else return (String(), String())
    let rest = root[at_box + 9..].copy()
    let end = rest.find("\"") ?? rest.len()
    let parts = rest[..end].replace(",", " ").split_whitespace()
    if parts.len() != 4 { return (String(), String()) }
    return (parts[2].copy(), parts[3].copy())
}

// The value of `name="…"` in the tag `tag`, or "".
fn attr_of(tag: String, name: str) -> String {
    let key = " {name}=\""
    let k = tag.find(key[..]) else return String()
    let rest = tag[k + key.len()..].copy()
    let end = rest.find("\"") ?? rest.len()
    return rest[..end].trim().copy()
}

// `svg` without each `<rect>` that covers the whole picture.
fn without_background(svg: String) -> String {
    let (w, h) = view_size(svg.copy())
    var made = String()
    var rest = svg.copy()
    while let k = rest.find("<rect") {
        let tail = rest[k..].copy()
        let close = tail.find(">") else break
        let tag = tail[..close + 1].copy()
        let width = attr_of(tag.copy(), "width")
        let height = attr_of(tag.copy(), "height")
        let x = attr_of(tag.copy(), "x")
        let y = attr_of(tag.copy(), "y")
        let whole = (width == "100%" or (w.len() > 0 and width == w)) and (height == "100%" or (h.len() > 0 and height == h)) and (x.len() == 0 or x == "0") and (y.len() == 0 or y == "0")
        made.push_str(rest[..k])
        if whole {
            var skip = close + 1
            if not tag.ends_with("/>") {
                if let e = tail.find("</rect>") { skip = e + 7 }
            }
            rest = tail[skip..].copy()
        } else {
            made.push_str(tag[..])
            rest = tail[close + 1..].copy()
        }
    }
    made.push_str(rest[..])
    return made
}

// The mark a tile and a row draw for `entry`, one colour in currentColor, and
// its file in catalog/ where it's one of loom's own ("" for another), in this
// order: the entry's own `logo`; the mark loom knows its server by
// (known_logo), by its address's host or its name; its server's own SVG icon
// (`icon_svg`, a registry server's) made one colour (mono); or none, where the
// apps draw its initial in the same black and white.
pub fn mark_of(entry: Json) -> (String?, String) {
    if let logo = str_at(entry.copy(), "logo") {
        if let svg = logo_svg(logo.copy()) { return (some(svg), logo) }
    }
    let name = str_at(entry.copy(), "registry") ?? str_at(entry.copy(), "server") ?? str_at(entry.copy(), "id") ?? String()
    let address = str_at(entry.copy(), "url") ?? String()
    if let logo = known_logo(name, address) {
        if let svg = logo_svg(logo.copy()) { return (some(svg), logo) }
    }
    if let svg = str_at(entry, "icon_svg") {
        if let one = mono(svg) { return (some(one), String()) }
    }
    return (none, String())
}

// The mark the Installed list draws for the person's server `server`: its
// entry's (mark_of), where it's one of an entry's, else the one loom knows it
// by, by its address's host or its name; with its file, as mark_of gives it.
pub fn server_mark(entry: Json, server: Json) -> (String?, String) {
    if entry != Json.Null {
        let (svg, file) = mark_of(entry)
        if svg != none { return (svg, file) }
    }
    let logo = known_logo(str_at(server.copy(), "name") ?? String(), str_at(server, "url") ?? String()) else return (none, String())
    return (logo_svg(logo.copy()), logo)
}

