module server.main

// The `loom` program: the instance, and the commands that look after it.
//
//     loom serve [--data DIR] [--port N] [--host ADDR] [--backups DIR [--backups-keep N]] [--sandboxes podman|docker [--sandbox-image IMAGE]] [--allow-root]
//     loom user add NAME [--data DIR]          reads the password from standard input
//     loom user list [--data DIR]
//     loom link [NAME] [--data DIR]            a link code for an agent's add_server
//     loom acp add NAME COMMAND [ARG...] [--data DIR]
//     loom acp list [--data DIR]
//     loom acp install ID [--env NAME=value]... [--registry URL] [--data DIR]
//     loom acp settings NAME NAME=value|NAME=... [--data DIR]
//     loom receive [--data DIR] [--port N] [--host ADDR]
//     loom status [--data DIR]
//     loom import openbot|grokbot [PATH] [--carry-provider]   through the running instance, with a script token
//     loom import openbot [PATH] --from-user USER [--carry-provider]   as root, staged into --data
//     loom files limit MB|off [--data DIR]
//     loom install [--domain DOMAIN] [--port N] [--no-sandboxes] [--no-tailscale] [--https-port N|auto]
//                  [--import openbot[:USER]] [--carry-provider]   as root, on a Linux server
//     loom update [--check]
//     loom egress                              in a sandbox closed to the network, started by the instance
//     loom version
//
// Each but serve, mcp and egress takes --json, to answer in JSON.
//
// Run from source: calx server/main.calx serve
import std.crypto.{PasswordHasher, random_bytes}
import std.bytes
import std.env
import std.fs
import std.hash.{sha256}
import std.http.{Header, get, post}
import std.http.server.{Server}
import std.io
import std.json.{Json, parse}
import std.process.{Command, current_exe, exit}
import std.thread.{sleep}
import shared.client
import shared.obj.{Obj, at, bool_at, merge, str_at}
import shared.protocol
import shared.release.{newer}
import server.instance.{Config, EventLife, Instance, SCRIPT_GRANT_MS, account_link_code, owner_link_code}
import server.mcp
import server.egress
import server.backup
import server.push
import server.installer
import server.importer
import server.stage
import server.move
import server.store.{AcpAgent, Store, now}
import server.setup
import server.update

const VERSION: str = "0.2.0-dev"

fn usage() -> String {
    return #"
usage: loom <command>

  serve                     run the instance (--port, default 8790; --host, default 127.0.0.1;
                            --registry, the ACP Registry's address, for a mirror of it). It won't run
                            as root or an elevated Administrator, whose rights its agents would get,
                            unless given --allow-root. --backups DIR writes a backup there each day, as
                            export does, and keeps the newest 7 (--backups-keep N). --lan, on a PC, lets
                            phones reach it on the network over Noise, once the owner turns them on.
                            --sandboxes podman (or docker) runs the agents of everyone but the owner in a sandbox
                            each, from loom's image or --sandbox-image IMAGE: without, only the owner's run
  user add NAME             add an account; the password comes on standard input
  user list                 list the accounts
  link [NAME]               a link code, once, for 15 minutes, for an agent's add_server: on an instance no
                            one has set up, it makes the owner when the person says yes in the app; else it
                            signs in to NAME, or the owner
  user password NAME        give NAME a new password, from standard input, and sign them out everywhere:
                            the owner's own reset
  acp add NAME COMMAND ...  add an ACP agent program, such as: acp add claude npx -y @agentclientprotocol/claude-agent-acp
  acp list                  list the ACP agent programs
  acp install ID            install an agent program from the ACP Registry, such as claude-acp, with its settings
                            as --env NAME=value (each its own --env). Says what to install when it needs npx or uvx
  acp settings NAME NAME=value ...
                            set an agent program's settings, kept sealed; NAME= removes one
  files limit MB|off        cap the files each person can keep, in megabytes
  push key FILE KEY_ID TEAM_ID BUNDLE_ID
                            send push to the iPhone app through APNs, signed with Apple's AuthKey_<id>.p8
  push off                  send no push
  export FILE               write the whole instance to FILE, a .tar.zst, while it runs or not: a backup, which
                            holds the key to its secrets, so keep it as safe
  import FILE               make a new instance in --data from a backup
  import openbot [PATH]     bring agents, chats, memories, routines, skills, MCP servers and tables over
  import grokbot [PATH]     from OpenBot or Grok Bot on this computer, or from PATH, a copy of its data
                            folder, without their secrets. Through the running instance, as the four below, or
                            with no token, where it can open --data, with one it makes itself for the owner
                            that only imports, for 15 minutes.
                            --carry-provider gives OpenBot's Claude endpoint and token to the Claude agent program
  import openbot --from-user USER
                            as root: take OpenBot's data from USER's folder (or from PATH), as a snapshot, into
                            --data's imports/, and import it for the owner, now or once they set up
  receive                   take a move into --data: prints a one-time move code, listens on --port and
                            --host, and returns once the instance has come. --data must hold no instance,
                            or one no one has set up yet
  ask AGENT TEXT ...        your script asks AGENT, by name, in its chat (or --conversation ID), and
                            prints its answer once it's done
  routine run NAME          your script runs one of your routines now
  approvals                 list what waits for your yes
  approve CALL yes|no       answer one of them
                            These four reach the running instance on this computer, at --url (or LOOM_URL,
                            or 127.0.0.1 at --port), with the script token you made in the app's server
                            settings: --token, or LOOM_SCRIPTS_TOKEN
  status                    say what the instance holds
  install                   set loom up on a Linux server, as root: the loom user, a systemd service,
                            and Caddy for TLS with --domain DOMAIN, or Tailscale without one, and Podman
                            for the sandboxes of everyone but the owner, unless given --no-sandboxes. Tailscale keeps
                            what it serves: loom takes the first HTTPS port with nothing at / or /api (443, then
                            8443, 10000 and on), or --https-port N; --no-tailscale leaves it out. --import
                            openbot[:USER] stages OpenBot's data from USER (openbot) for the owner
  update                    update this program to the newest signed release (--check: only say if there's one)
  version                   print loom's version and the protocol versions it speaks
  mcp                       loom's own tools as an MCP server on standard input and output, which the instance starts for its agents
  egress                    in a sandbox closed to the network: carries loom's tools and the proxy on 127.0.0.1:3128
                            to the instance, over standard input and output

Every command but version and mcp takes --data DIR, the instance's folder (default: loom-data).
Every command but serve and mcp takes --json, to answer in JSON: an object, or {"error": {"code", "message"}} with a non-zero exit.
"#
}

fn version_line() -> String {
    return "loom {VERSION}, protocol {protocol.OLDEST}-{protocol.NEWEST}"
}

// The arguments, with `--name value` options taken out.
struct Args {
    words: List<String>
    data: String
    port: u16
    host: String
    fast_hashes: bool
    keep_events: i64?
    registry: String
    minute_ms: i64
    allow_root: bool
    json: bool
    domain: String
    apns: String    // where APNs is, for a test, or "" for Apple's
    backups: String
    backups_keep: usize
    backup_every_ms: i64
    lan: bool    // phones may reach it on the network, over Noise
    sandboxes: String    // what runs everyone else's agents: podman, or "" for nothing
    sandbox_image: String
    no_sandboxes: bool    // loom install sets no sandboxes up
    url: String    // for scripts: the instance's address
    token: String    // and the person's script token
    conversation: String
    release: String    // for tests only: a manifest's address, in place of loom's releases
    release_key: String    // and the public key, in hex, its releases are signed with
    env: List<String>    // acp install: settings, as NAME=value
    from_user: String    // import: the user whose data it takes, as root
    from_home: String    // for tests only: that user's home folder, without root
    carry_provider: bool    // import: give OpenBot's provider to the Claude agent program
    https_port: i64    // install: Tailscale's HTTPS port, or 0 for the first free one
    no_tailscale: bool
    import_from: String    // install: openbot[:USER], staged for the owner
}

fn read_args(given: List<String>) -> Args ! Error {
    var a = Args { words: List<String>(), data: String("loom-data"), port: 8790, host: String("127.0.0.1"), fast_hashes: false, keep_events: none, registry: String(installer.REGISTRY), minute_ms: 60000, allow_root: false, json: false, domain: String(), apns: String(), backups: String(), backups_keep: 7, backup_every_ms: 86400000, lan: false, sandboxes: String(), sandbox_image: String(), no_sandboxes: false, url: String(), token: String(), conversation: String(), release: String(), release_key: String(), env: List<String>(), from_user: String(), from_home: String(), carry_provider: false, https_port: 0, no_tailscale: false, import_from: String() }
    var i: usize = 0
    while i < given.len() {
        let w = given[i].copy()
        // acp install's settings, import's user, and install's Tailscale port and import.
        if w == "--env" or w == "--from-user" or w == "--test-from-home" or w == "--https-port" or w == "--import" {
            if i + 1 >= given.len() { fail "{w} needs a value" }
            let v = given[i + 1].copy()
            if w == "--env" {
                if not v.contains("=") or v.starts_with("=") { fail "--env takes NAME=value, not {v}" }
                a.env.push(v)
            } else if w == "--from-user" {
                a.from_user = v
            } else if w == "--test-from-home" {
                a.from_home = v
            } else if w == "--import" {
                a.import_from = v
            } else if v != "auto" {
                let port = i64.parse(v.copy()) else { fail "--https-port takes a port or auto, not {v}" }
                if port < 1 or port > 65535 { fail "--https-port takes a port from 1 to 65535, or auto" }
                a.https_port = port
            }
            i += 2
            continue
        }
        if w == "--carry-provider" or w == "--no-tailscale" {
            if w == "--carry-provider" { a.carry_provider = true } else { a.no_tailscale = true }
            i += 1
            continue
        }
        // Where the ACP Registry is: a mirror of it, or a test's.
        if w == "--registry" {
            if i + 1 >= given.len() { fail "{w} needs an address" }
            a.registry = given[i + 1].copy()
            i += 2
            continue
        }
        // For tests only: a routine's minute lasts this many ms.
        if w == "--test-minute-ms" {
            if i + 1 >= given.len() { fail "{w} needs a number" }
            a.minute_ms = i64.parse(given[i + 1].copy()) ?? 60000
            i += 2
            continue
        }
        // Sandboxes for everyone but the owner, and the image they run.
        if w == "--sandboxes" or w == "--sandbox-image" {
            if i + 1 >= given.len() { fail "{w} needs a value" }
            if w == "--sandboxes" { a.sandboxes = given[i + 1].copy() } else { a.sandbox_image = given[i + 1].copy() }
            i += 2
            continue
        }
        // Scheduled backups: where, and how many stay.
        if w == "--backups" or w == "--backups-keep" {
            if i + 1 >= given.len() { fail "{w} needs a value" }
            let v = given[i + 1].copy()
            if w == "--backups" { a.backups = v } else {
                let keep = usize.parse(v.copy()) else { fail "--backups-keep takes a number, not {v}" }
                if keep == 0 { fail "--backups-keep takes 1 or more" }
                a.backups_keep = keep
            }
            i += 2
            continue
        }
        // For tests only: a backup this many ms apart, not a day.
        if w == "--test-backup-every-ms" {
            if i + 1 >= given.len() { fail "{w} needs a number" }
            a.backup_every_ms = i64.parse(given[i + 1].copy()) ?? 86400000
            i += 2
            continue
        }
        // For tests only: keeps just the newest N events, of any age.
        if w == "--test-keep-events" {
            if i + 1 >= given.len() { fail "{w} needs a number" }
            a.keep_events = some(i64.parse(given[i + 1].copy()) ?? 0)
            i += 2
            continue
        }
        if w == "--no-sandboxes" {
            a.no_sandboxes = true
            i += 1
            continue
        }
        if w == "--domain" {
            if i + 1 >= given.len() { fail "{w} needs a domain" }
            a.domain = given[i + 1].copy()
            i += 2
            continue
        }
        // For scripts: where the instance is, the script token, and the conversation to ask in.
        if w == "--url" or w == "--token" or w == "--conversation" {
            if i + 1 >= given.len() { fail "{w} needs a value" }
            let v = given[i + 1].copy()
            if w == "--url" { a.url = v } else if w == "--token" { a.token = v } else { a.conversation = v }
            i += 2
            continue
        }
        if w == "--data" or w == "--port" or w == "--host" {
            if i + 1 >= given.len() { fail "{w} needs a value" }
            let v = given[i + 1].copy()
            if w == "--data" { a.data = v } else if w == "--host" { a.host = v } else {
                let port = u16.parse(v.copy()) else { fail "--port takes a number, not {v}" }
                a.port = port
            }
            i += 2
            continue
        }
        // JSON instead of words, for programs and agents.
        if w == "--json" {
            a.json = true
            i += 1
            continue
        }
        // To serve as root or an elevated Administrator anyway.
        // An instance on a PC, as the desktop app runs one: phones may reach it over Noise.
        if w == "--lan" {
            a.lan = true
            i += 1
            continue
        }
        if w == "--allow-root" {
            a.allow_root = true
            i += 1
            continue
        }
        // For tests only: where APNs is, a fake one, in place of Apple's.
        if w == "--test-apns" {
            if i + 1 >= given.len() { fail "{w} needs an address" }
            a.apns = given[i + 1].copy()
            i += 2
            continue
        }
        // For tests only: releases from a test's own manifest, signed with its own key.
        // serve refuses it without --test-fast-hashes, so one stray flag can't point a
        // real instance at releases loom didn't sign.
        if w == "--test-release" {
            if i + 2 >= given.len() { fail "{w} needs a manifest's address and a public key in hex" }
            a.release = given[i + 1].copy()
            a.release_key = given[i + 2].copy()
            i += 3
            continue
        }
        // For tests only: hashes that take microseconds instead of 65 ms.
        if w == "--test-fast-hashes" {
            a.fast_hashes = true
            i += 1
            continue
        }
        a.words.push(w)
        i += 1
    }
    return a
}

fn event_life(a: Args) -> EventLife {
    if let keep = a.keep_events { return EventLife { age_ms: 0, keep: keep, every_ms: 200 } }
    return EventLife.standard()
}

fn hasher(a: Args) -> PasswordHasher {
    if a.fast_hashes { return PasswordHasher { memory_kib: 64, iterations: 1, parallelism: 1 } }
    return PasswordHasher()
}

fn open_store(a: Args) -> Store ! Error {
    try fs.make_dir_all(a.data.copy())
    return try Store.open("{a.data}/loom.db", hasher(a))
}

// Who the instance runs as, for `loom status`.
fn runs_as() -> String {
    let name = env.user_name() ?? String("an unnamed user")
    if env.is_elevated() {
        return "{name}, with the system's full rights"
    }
    return name
}

// Why `loom serve` won't run with the system's full rights, and what to do instead.
fn elevated_refusal() -> String {
    let name = env.user_name() ?? String("root")
    if env.os() == "windows" {
        return "loom: refusing to serve as {name} with an Administrator's full rights, which every agent would get too.\nStart it from a terminal that isn't \"Run as administrator\", or pass --allow-root to serve anyway."
    }
    return "loom: refusing to serve as {name}, with root's rights, which every agent would get too.\nRun it as an ordinary user, such as one named loom of its own (sudo -u loom loom serve), or pass --allow-root to serve anyway."
}

fn serve(a: Args) ! Error {
    // A mistake in the arguments is said first, before anything about how it runs.
    if a.release.len() > 0 and not a.fast_hashes {
        eprintln("loom: --test-release is for loom's own tests, which give --test-fast-hashes too: it points the instance at releases loom didn't sign")
        exit(2)
    }
    if env.is_elevated() and not a.allow_root {
        eprintln(elevated_refusal())
        exit(2)
    }
    let source = if a.release.len() > 0 { update.Source { manifest: a.release.copy(), key: a.release_key.copy() } } else { update.Source.official() }
    let config = Config { data: a.data.copy(), port: a.port, host: a.host.copy(), hasher: hasher(a.copy()), events: event_life(a.copy()), registry: a.registry.copy(), minute_ms: a.minute_ms, apns: a.apns.copy(), version: String(VERSION), lan: a.lan, sandboxes: a.sandboxes.copy(), sandbox_image: a.sandbox_image.copy(), release: source, in_app: false }
    var i = try open_waiting(config)
    if a.backups.len() > 0 {
        // Backups inside the instance's folder would go into the next one.
        let dir = try fs.absolute(a.backups.copy())
        let data = try fs.absolute(a.data.copy())
        if dir == data or dir.starts_with("{data}/") or dir.starts_with("{data}\\") { fail "keep --backups outside the instance's folder, {a.data}, or each backup would hold the ones before" }
        backup.start(backup.Schedule { data: a.data.copy(), dir: dir, every_ms: a.backup_every_ms, keep: a.backups_keep, version: String(VERSION) })
    }
    println("loom: serving {a.data} at {i.url()}")
    if let code = try i.setup_code() {
        println("loom: no owner yet. Set one up with POST /api/setup and this code:")
        println("setup code: {code}")
    }
    io.flush()
    try i.serve()
    // An update swapped the program in while the loop stopped: the new one runs now.
    if i.restart_wanted() {
        io.flush()
        update.come_back(update.host(false), i.program(), i.port())
    }
    println("loom: stopped")
}

// Opens the instance. Started by an update of itself, it waits up to 10 s for the port,
// which the program before it is letting go of.
fn open_waiting(config: Config) -> Instance ! Error {
    if not update.restarted() { return try Instance.open(config) }
    var tries: usize = 0
    loop {
        match Instance.open(config.copy()) {
            ok(i) => return i,
            err(e) => {
                tries += 1
                if tries >= 40 { fail "{e}" }
                unsafe { sleep(250000000) }
            },
        }
    }
}

// What a command answers: words for a person, and the same as JSON for a
// program, which `--json` prints instead (PLAN.md, "Scriptable to the end").
struct Said {
    text: String
    value: Json
}

fn said(text: own String, value: own Json) -> Said {
    return Said { text: text, value: value }
}

fn main() ! Error {
    let a = try read_args(env.args())
    if a.words.len() == 0 {
        if a.json { println("{failure("usage", String("Give a command, such as status."))}") } else { eprint(usage()) }
        exit(2)
    }
    let cmd = a.words[0].copy()
    // These don't answer once: one serves until it's stopped, one speaks MCP, and one
    // carries a closed sandbox's connections until the instance ends its input.
    if cmd == "mcp" {
        try mcp.serve()
        return
    }
    if cmd == "egress" {
        try egress.serve_inside()
        return
    }
    if cmd == "serve" {
        try serve(a)
        return
    }
    match run(a.copy()) {
        ok(s) => if a.json { println("{s.value}") } else if s.text.len() > 0 { println(s.text) },
        err(e) => {
            let message = "{e}"
            let code = if message.starts_with("unknown command") { "unknown_command" } else { "failed" }
            if a.json { println("{failure(code, message.copy())}") } else if code == "unknown_command" { eprint("{message}\n\n{usage()}") } else { eprintln("loom: {message}") }
            exit(if code == "unknown_command" { 2 } else { 1 })
        },
    }
}

// A call to the running instance's scripts API, on this computer: POST with
// `body`, or GET without. The address is --url, or LOOM_URL, or the instance at
// --port here; the token is --token, or LOOM_SCRIPTS_TOKEN.
fn script(a: Args, op: str, body: Json?) -> Json ! Error {
    var token = if a.token.len() > 0 { a.token.copy() } else { env.variable(String("LOOM_SCRIPTS_TOKEN")) ?? String() }
    // An import with no token, run where it can open the instance's folder, makes
    // itself one for the owner that only imports, for 15 minutes, and drops it after
    // (protocol.md, "/api/scripts/*"). Whoever can open the folder could do more.
    var grant = String()
    if token.len() == 0 and op == "import" and fs.exists("{a.data}/loom.db") {
        let store = try open_store(a.copy())
        var owner = String()
        for u in try store.users() {
            if u.role == "owner" { owner = u.id.copy() }
        }
        if owner.len() == 0 { fail "no one has set this instance up yet: add it to your app first, with the link code (add_server, or loom link)" }
        token = "loom-script-{bytes.hex(random_bytes(24))}"
        grant = bytes.hex(sha256(token.to_bytes()))
        try store.add_script_grant(grant.copy(), owner, "import", now() + SCRIPT_GRANT_MS)
    }
    if token.len() == 0 { fail "give your script token with --token or LOOM_SCRIPTS_TOKEN: turn scripts on in the app, under the server, to get one" }
    if grant.len() == 0 { return try script_call(a, op, body, token) }
    let answer = match script_call(a.copy(), op, body, token) {
        ok(v) => v,
        err(e) => {
            let store = try open_store(a.copy())
            try store.drop_script_grant(grant)
            fail "{e}"
        },
    }
    let store = try open_store(a)
    try store.drop_script_grant(grant)
    return answer
}

// The call itself, with `token`.
fn script_call(a: Args, op: str, body: Json?, token: String) -> Json ! Error {
    let base = if a.url.len() > 0 { a.url.copy() } else { env.variable(String("LOOM_URL")) ?? "http://127.0.0.1:{a.port}" }
    let url = "{base.trim_suffix("/")}/api/scripts/{op}"
    let auth = Header { name: String("Authorization"), value: "Bearer {token}" }
    var req = match body {
        some(b) => post(url, [auth, Header { name: String("Content-Type"), value: String("application/json") }], "{b}".to_bytes(), SCRIPT_WAIT, SCRIPT_ANSWER_MOST),
        none => get(url, [auth], SCRIPT_WAIT, SCRIPT_ANSWER_MOST),
    }
    let got = try req.wait()
    let reply = match parse(String.from_utf8(got.body) ?? String()) {
        ok(j) => j,
        err(_) => Json.Null,
    }
    if got.status != 200 { fail str_at(at(reply, "error"), "message") ?? "the instance answered {got.status}" }
    return reply
}

// How long a script waits for an agent's answer, and how big it may be.
const SCRIPT_WAIT: u32 = 3600000
const SCRIPT_ANSWER_MOST: usize = 16777216

// An error, as --json gives it.
fn failure(code: str, message: String) -> Json {
    return Obj.new().j("error", Obj.new().s("code", String(code)).s("message", message).done()).done()
}

// Runs every command but serve and mcp.
fn run(a: Args) -> Said ! Error {
    let cmd = a.words[0].copy()
    let sub = if a.words.len() > 1 { a.words[1].copy() } else { String() }
    if cmd == "version" {
        return said(version_line(), Obj.new().s("version", String(VERSION)).i("protocol_oldest", i64(protocol.OLDEST)).i("protocol_newest", i64(protocol.NEWEST)).done())
    }
    // Scripts (PLAN.md, "Scripts"): the person's own, through the running instance.
    if cmd == "ask" and a.words.len() >= 3 {
        var words = List<String>()
        for k in 2usize..a.words.len() { words.push(a.words[k].copy()) }
        var body = Obj.new().s("agent", a.words[1].copy()).s("text", words.join(" "))
        if a.conversation.len() > 0 { body = body.s("conversation", a.conversation.copy()) }
        let v = try script(a.copy(), "ask", some(body.done()))
        return said(str_at(v.copy(), "reply") ?? String(), v)
    }
    if cmd == "routine" and sub == "run" and a.words.len() == 3 {
        let v = try script(a.copy(), "routine", some(Obj.new().s("routine", a.words[2].copy()).done()))
        return said(String("Started."), v)
    }
    if cmd == "approvals" and a.words.len() == 1 {
        let v = try script(a.copy(), "approvals", none)
        var lines = List<String>()
        if let Json.Array(list) = at(v.copy(), "approvals") {
            for x in list {
                let where = if bool_at(x.copy(), "on_a_device") == some(true) { " (answer it on a device)" } else { "" }
                lines.push("{str_at(x.copy(), "call") ?? String()}  {str_at(x.copy(), "agent_name") ?? String()}: {str_at(x, "title") ?? String()}{where}")
            }
        }
        return said(if lines.len() == 0 { String("Nothing is waiting for you.") } else { lines.join("\n") }, v)
    }
    if cmd == "approve" and a.words.len() == 3 {
        let answer = a.words[2].copy()
        if answer != "yes" and answer != "no" { fail "approve takes CALL and yes or no, not {answer}" }
        let v = try script(a.copy(), "approve", some(Obj.new().s("call", a.words[1].copy()).b("allow", answer == "yes").done()))
        return said(if answer == "yes" { String("Allowed.") } else { String("Denied.") }, v)
    }
    if cmd == "user" and sub == "add" and a.words.len() == 3 {
        let store = try open_store(a.copy())
        var lines = io.Lines()
        let password = lines.next() ?? String()
        if password.len() < 8 { fail "a password needs at least 8 characters" }
        let role = if try store.user_count() == 0 { "owner" } else { "member" }
        let u = try store.add_user(a.words[2].copy(), password, role)
        try store.log_people("joined", "{u.username} was added from the command line, as {if role == "owner" { "the owner" } else { "a member" }}", String())
        return said("added {u.username} ({u.id}, {role})", Obj.new().s("id", u.id.copy()).s("username", u.username.copy()).s("role", String(role)).done())
    }
    // The owner's own reset (PLAN.md, "Accounts and invites"), or anyone's: a new
    // password from standard input, and every device of theirs signed out.
    if cmd == "user" and sub == "password" and a.words.len() == 3 {
        let store = try open_store(a.copy())
        let u = try store.find_username(a.words[2].copy()) else { fail "there's no one called {a.words[2]} here" }
        var lines = io.Lines()
        let password = lines.next() ?? String()
        if password.len() < 8 { fail "a password needs at least 8 characters" }
        try store.set_password(u.id.copy(), password)
        let gone = try store.revoke_all(u.id.copy())
        try store.log_people("password", "{u.username} was given a new password from the command line, and signed out everywhere", String())
        return said("{u.username} has a new password, and is signed out on {gone.len()} devices", Obj.new().s("id", u.id.copy()).s("username", u.username.copy()).i("signed_out", i64.wrap(gone.len())).done())
    }
    // A link code (protocol.md, "Link codes") for an agent to hand add_server, which
    // the person's yes in the app signs in with: on an instance no one has set up,
    // it makes the owner; else it signs in to NAME, or the owner.
    if cmd == "link" and a.words.len() <= 2 {
        let store = try open_store(a.copy())
        if a.words.len() == 1 and try store.user_count() == 0 {
            let (code, expires) = try owner_link_code(store, "cli")
            return said("link code: {code}\nIt makes the owner, once, for 15 minutes: an agent hands it to add_server, and the person says yes in the app.", Obj.new().s("link_code", code).i("expires", expires).b("owner", true).done())
        }
        var name = sub.copy()
        if name.len() == 0 {
            for u in try store.users() {
                if u.role == "owner" { name = u.username.copy() }
            }
        }
        let u = try store.find_username(name.copy()) else { fail "there's no one called {name} here" }
        let (code, expires) = try account_link_code(store, u.id.copy(), String("cli"))
        try store.log_people("link", "A link code to sign in as {u.username} was made from the command line", String())
        return said("link code: {code}\nIt signs a device in as {u.username}, once, for 15 minutes.", Obj.new().s("link_code", code).i("expires", expires).b("owner", false).s("username", u.username.copy()).done())
    }
    if cmd == "user" and sub == "list" {
        let store = try open_store(a)
        var lines = List<String>()
        var users = List<Json>()
        for u in try store.users() {
            lines.push("{u.id}  {u.username}  {u.role}")
            users.push(Obj.new().s("id", u.id.copy()).s("username", u.username.copy()).s("role", u.role.copy()).done())
        }
        return said(lines.join("\n"), Obj.new().j("users", Json.Array(users)).done())
    }
    if cmd == "acp" and sub == "add" and a.words.len() >= 4 {
        let store = try open_store(a.copy())
        var args = List<String>()
        var given = List<Json>()
        for w in a.words[4..] {
            args.push(w.copy())
            given.push(Json.Str(w.copy()))
        }
        try store.set_acp_agent(a.words[2].copy(), a.words[3].copy(), args)
        return said("added ACP agent {a.words[2]}", Obj.new().s("name", a.words[2].copy()).s("command", a.words[3].copy()).j("args", Json.Array(given)).done())
    }
    if cmd == "acp" and sub == "list" {
        let store = try open_store(a)
        var lines = List<String>()
        var programs = List<Json>()
        for p in try store.acp_agents() {
            lines.push("{p.name}  {p.command} {p.args.join(" ")}")
            var args = List<Json>()
            for w in p.args {
                args.push(Json.Str(w.copy()))
            }
            programs.push(Obj.new().s("name", p.name.copy()).s("command", p.command.copy()).j("args", Json.Array(args)).done())
        }
        return said(lines.join("\n"), Obj.new().j("programs", Json.Array(programs)).done())
    }
    if cmd == "push" and sub == "key" and a.words.len() == 6 {
        // The APNs key (Apple's AuthKey_<id>.p8) loom signs push with, kept sealed.
        let store = try open_store(a.copy())
        let pem = try fs.read_text(a.words[2].copy()) ?? String()
        if not push.is_key(pem.copy()) { fail "{a.words[2]} isn't an APNs key, a P-256 key in PKCS#8: Apple gives it as AuthKey_<key id>.p8" }
        try store.set_apns(Obj.new().s("key", pem).s("key_id", a.words[3].copy()).s("team", a.words[4].copy()).s("topic", a.words[5].copy()).done())
        return said("push goes to APNs for {a.words[5]}, signed with key {a.words[3]} of team {a.words[4]}", Obj.new().j("push", Obj.new().s("topic", a.words[5].copy()).s("key_id", a.words[3].copy()).s("team", a.words[4].copy()).done()).done())
    }
    if cmd == "push" and sub == "off" {
        let store = try open_store(a.copy())
        try store.delete_meta("apns")
        return said(String("no push; phones get notifications while the app is open"), Obj.new().j("push", Json.Null).done())
    }
    if cmd == "files" and sub == "limit" and a.words.len() == 3 {
        let store = try open_store(a.copy())
        if a.words[2] == "off" {
            try store.delete_meta("file_limit")
            return said(String("each person can keep as many files as fit"), Obj.new().j("limit_mb", Json.Null).done())
        }
        let mb = i64.parse(a.words[2].copy()) else {
            fail "the limit is a number of megabytes, or off"
        }
        try store.set_meta("file_limit", "{mb * 1000000}")
        return said("each person can keep {mb} MB of files", Obj.new().i("limit_mb", mb).done())
    }
    if cmd == "export" and a.words.len() == 2 {
        let m = try backup.export(a.data.copy(), a.words[1].copy(), String(VERSION))
        return said("wrote {a.words[1]}: the instance {str_at(m.copy(), "instance") ?? String()}, with the key to its secrets, so keep it as safe as them", Obj.new().s("file", a.words[1].copy()).j("backup", m).done())
    }
    // OpenBot's data from the user it runs as, as root: staged into the instance's
    // folder (server/stage.calx), and imported for its owner.
    if cmd == "import" and sub == "openbot" and a.words.len() <= 3 and a.from_user.len() > 0 {
        return try import_from_user(a)
    }
    // From another agent app (PLAN.md, "Importing from OpenBot and Grok Bot"),
    // through the running instance, as the person's script.
    if cmd == "import" and (sub == "openbot" or sub == "grokbot") and a.words.len() <= 3 {
        var body = Obj.new().s("from", sub.copy()).b("carry_provider", a.carry_provider)
        if a.words.len() == 3 { body = body.s("path", try fs.absolute(a.words[2].copy())) }
        let v = try script(a.copy(), "import", some(body.done()))
        var lines: List<String> = [str_at(v.copy(), "text") ?? String()]
        if let Json.Array(left) = at(v.copy(), "not") {
            for n in left { lines.push("- {n.as_str() ?? String()}") }
        }
        return said(lines.join("\n"), v)
    }
    if cmd == "import" and a.words.len() == 2 {
        let m = try backup.restore(a.words[1].copy(), a.data.copy())
        let programs = at(m.copy(), "acp_agents")
        return said("made the instance {str_at(m.copy(), "instance") ?? String()} in {a.data}. Install its ACP agents again here: {programs}", Obj.new().s("data", a.data.copy()).j("backup", m).done())
    }
    if cmd == "install" {
        // What --import names is checked before anything is installed.
        var import_user = String()
        if a.import_from.len() > 0 {
            let parts = a.import_from.split(":")
            if parts[0] != "openbot" or parts.len() > 2 { fail "--import takes openbot or openbot:USER, not {a.import_from}" }
            import_user = if parts.len() == 2 { parts[1].copy() } else { String("openbot") }
        }
        var d = try setup.install(setup.Plan { domain: a.domain.copy(), port: a.port, sandboxes: not a.no_sandboxes, tailscale: not a.no_tailscale, https_port: a.https_port, version: String(VERSION) })
        if import_user.len() > 0 {
            let staged = try stage_into(try user_home(import_user.copy()), String(), String(setup.HOME), a.carry_provider)
            d.steps.push("staged OpenBot's data from {import_user}, which comes into the owner's account once they set up: {importer.summary(at(staged.copy(), "counts"))}")
            d.imported = merge(staged, Obj.new().s("from", String("openbot")).s("user", import_user).b("pending", true).done())
        }
        return said(setup.done_text(d.copy()), setup.done_json(d))
    }
    if cmd == "acp" and sub == "install" and a.words.len() == 3 {
        return try acp_install(a.copy(), a.words[2].copy())
    }
    if cmd == "acp" and sub == "settings" and a.words.len() >= 3 {
        return try acp_settings(a.copy(), a.words[2].copy())
    }
    if cmd == "receive" and a.words.len() == 1 {
        // The move code is said first, and the answer once the instance has come.
        try move.check_empty(a.data.copy())
        var server = try Server.listen(a.port, a.host.copy())
        server.log = false
        let code = move.new_code()
        let address = "http://{a.host}:{server.port}"
        if a.json { println("{Obj.new().s("code", code.copy()).s("listening", address.copy()).done()}") } else {
            println("loom: waiting for a move into {a.data}, at {address}")
            println("move code: {code}")
        }
        io.flush()
        let m = try move.receive(mut server, a.data.copy(), code)
        server.shutdown()
        let programs = at(m.copy(), "acp_agents")
        return said("received the instance {str_at(m.copy(), "instance") ?? String()} in {a.data}. Install its ACP agents again here: {programs}. Then start it with loom serve", Obj.new().s("data", a.data.copy()).j("received", m).done())
    }
    if cmd == "update" {
        return try update_self(a.words.contains(String("--check")))
    }
    if cmd == "status" {
        let store = try open_store(a.copy())
        let accounts = try store.user_count()
        let programs = try store.acp_agents()
        let apns = try store.apns()
        let topic = if let c = apns.copy() { str_at(c, "topic") ?? String() } else { String() }
        let pushing = if apns != none { "APNs, for {topic}" } else { String("off") }
        let text = "{version_line()}\ndata: {a.data}\naccounts: {accounts}\nACP agents: {programs.len()}\nruns as: {runs_as()}\npush: {pushing}"
        return said(text, Obj.new().s("version", String(VERSION)).s("data", a.data.copy()).i("accounts", accounts).i("acp_agents", i64.wrap(programs.len())).s("user", env.user_name() ?? String()).b("elevated", env.is_elevated()).j("push", if apns != none { Obj.new().s("topic", topic).done() } else { Json.Null }).done())
    }
    fail "unknown command: {a.words.join(" ")}"
}

@test
fn version_names_the_protocol() {
    assert(version_line().contains("protocol 1-1"))
}

@test
fn reads_options_anywhere() {
    let given: List<String> = [String("user"), String("--data"), String("d"), String("add"), String("ann")]
    let a = read_args(given)!
    assert(a.data == "d" and a.words.len() == 3 and a.words[2] == "ann")
}

// --- Commands that work on the data folder for an agent setting loom up (PLAN.md, "Agents can do anything the app can") ---

// Gives files root wrote in the instance's folder to whoever owns that folder (the
// loom user, on a server loom install set up), so the instance can read and change them.
fn own_like_data(data: String, paths: List<String>) ! Error {
    if env.os() == "windows" or not env.is_elevated() { return }
    for p in paths {
        if not fs.exists(p.copy()) { continue }
        let out = try Command.new(String("chown")).arg(String("-R")).arg("--reference={data}").arg(p.copy()).output()
        if not out.status.success() { fail "couldn't give {p} to {data}'s owner: {out.error_text().trim()}" }
    }
}

// The database's files and the key to its secrets, which a command run as root may have made.
fn store_files(data: String) -> List<String> {
    return ["{data}/loom.db", "{data}/loom.db-wal", "{data}/loom.db-shm", "{data}/secret.key"]
}

// An ACP agent program as `acp install` and `acp settings` give it: its settings by name only.
fn program_said(p: AcpAgent) -> Json {
    var args = List<Json>()
    for w in p.args { args.push(Json.Str(w.copy())) }
    var names = List<Json>()
    if let Json.Object(m) = p.env.copy() {
        for (k, _) in m { names.push(Json.Str(k.copy())) }
    }
    return Obj.new().s("name", p.name.copy()).s("command", p.command.copy()).j("args", Json.Array(args)).s("source", p.source.copy()).s("version", p.version.copy()).j("settings", Json.Array(names)).done()
}

fn names_of(program: Json) -> String {
    var out = List<String>()
    if let Json.Array(list) = at(program, "settings") {
        for n in list { out.push(n.as_str() ?? String()) }
    }
    return if out.len() == 0 { String("none") } else { out.join(", ") }
}

// `loom acp install ID [--env NAME=value]...`: an agent program from the ACP Registry
// (--registry for a mirror), as acp.install installs it, straight into the data folder.
fn acp_install(a: Args, id: String) -> Said ! Error {
    if importer.skill_name(id.copy()) != id { fail "{id} isn't an ACP Registry id, such as claude-acp" }
    let registry = try installer.read_registry(a.registry.copy())
    var entry = Json.Null
    if let Json.Array(agents) = at(registry, "agents") {
        for x in agents {
            if str_at(x.copy(), "id") == some(id.copy()) { entry = x.copy() }
        }
    }
    if entry == Json.Null { fail "There's no {id} in the ACP Registry at {a.registry}." }
    let npx = installer.on_path("npx")
    let uvx = installer.on_path("uvx")
    let how = installer.pick(entry.copy(), installer.platform(), npx, uvx) else { fail installer.missing(entry, installer.platform()) }
    let data = try fs.absolute(a.data.copy())
    let folder = "{data.replace("\\", "/")}/acp/{id}"
    try fs.make_dir_all("{data}/acp")
    let got = try installer.install(how.copy(), folder.copy())
    var args = List<String>()
    if let Json.Array(items) = at(got.copy(), "args") {
        for x in items { args.push(x.as_str() ?? String()) }
    }
    let store = try open_store(a.copy())
    // The registry's settings, under what it had, under what's given now.
    var settings = at(got.copy(), "env")
    if let had = try store.acp_agent(id.copy()) { settings = merge(settings, had.env) }
    var given = Obj.new()
    for kv in a.env {
        let cut = kv.find("=") ?? 0
        given.m.insert(kv[..cut].copy(), Json.Str(kv[cut + 1..].copy()))
    }
    settings = merge(settings, given.done())
    try store.set_acp_agent(id.copy(), str_at(got, "command") ?? String(), args)
    try store.set_acp_settings(id.copy(), id.copy(), str_at(how, "version") ?? String(), settings)
    let kept = try store.acp_agent(id.copy()) else { fail "{id} wasn't kept" }
    let program = program_said(kept)
    var owned = store_files(data.copy())
    owned.push(folder)
    try own_like_data(data, owned)
    let text = "installed {id} {str_at(program.copy(), "version") ?? String()}: {str_at(program.copy(), "command") ?? String()}\nsettings: {names_of(program.copy())}\nAgents on it start with these at their next message, once it isn't running."
    return said(text, Obj.new().j("program", program).done())
}

// `loom acp settings NAME NAME=value...`: sets an agent program's settings, sealed as
// acp.settings keeps them; NAME= with nothing after removes one.
fn acp_settings(a: Args, name: String) -> Said ! Error {
    let store = try open_store(a.copy())
    let program = try store.acp_agent(name.copy()) else { fail "There's no ACP agent {name}: loom acp list lists them." }
    var settings = Obj.new()
    if let Json.Object(had) = program.env.copy() {
        for (k, v) in had { settings.m.insert(k.copy(), v.copy()) }
    }
    for kv in a.words[3..] {
        let cut = kv.find("=") else { fail "settings are NAME=value, or NAME= to remove one, not {kv}" }
        let key = kv[..cut].copy()
        if key.len() == 0 { fail "settings are NAME=value, or NAME= to remove one, not {kv}" }
        let v = kv[cut + 1..].copy()
        if v.len() == 0 { _ = settings.m.remove(key) } else { settings.m.insert(key, Json.Str(v)) }
    }
    try store.set_acp_settings(name.copy(), program.source.copy(), program.version.copy(), settings.done())
    let kept = try store.acp_agent(name.copy()) else { fail "{name} wasn't kept" }
    let changed = program_said(kept)
    let data = try fs.absolute(a.data.copy())
    try own_like_data(data.copy(), store_files(data))
    return said("{name}'s settings: {names_of(changed.copy())}\nAgents on it start with these at their next message, once it isn't running.", Obj.new().j("program", changed).done())
}

// The home folder of `user`, whose data only root may read.
fn user_home(user: String) -> String ! Error {
    if env.os() == "windows" { fail "--from-user takes another user's data on a Linux or Mac server" }
    if not env.is_elevated() and env.user_name() != some(user.copy()) { fail "reading {user}'s data needs root: run it with sudo" }
    let passwd = try fs.read_text(String("/etc/passwd")) ?? String()
    let home = stage.home_of(user.copy(), passwd) else { fail "There's no user {user} on this computer." }
    return home
}

// Stages OpenBot's data from `home` into `data`'s imports/openbot, and leaves it
// waiting for the instance in imports/pending.json. `path` is OpenBot's data
// folder, or "" to find it in `home`.
fn stage_into(home: String, path: String, data: String, carry: bool) -> Json ! Error {
    let found = if path.len() > 0 { some(path.copy()) } else { stage.openbot_data(home.copy()) }
    let openbot_data = found else { fail "There's no OpenBot data in {home}: no openbot.db there or a few folders down. Give its folder: loom import openbot DIR --from-user USER" }
    let workspace = stage.openbot_workspace(home.copy(), openbot_data.copy())
    let instance = (try fs.absolute(data)).replace("\\", "/")
    try fs.make_dir_all("{instance}/imports")
    let staged = try stage.stage_openbot(home, openbot_data, workspace, "{instance}/imports/openbot")
    let done = "{instance}/{stage.DONE}"
    if fs.exists(done.copy()) { try fs.remove_file(done) }
    let pending = Obj.new().s("from", String("openbot")).s("path", str_at(staged.copy(), "path") ?? String()).b("carry_provider", carry).done()
    try fs.write_text("{instance}/{stage.PENDING}", "{pending}")
    try own_like_data(instance.copy(), ["{instance}/imports"])
    return staged
}

// `loom import openbot [PATH] --from-user USER [--carry-provider]`, as root: stages
// it, then waits for the running instance to import it for its owner. With no
// owner yet, or no instance answering, it comes in once there's one.
fn import_from_user(a: Args) -> Said ! Error {
    let path = if a.words.len() == 3 { (try fs.absolute(a.words[2].copy())).replace("\\", "/") } else { String() }
    if not fs.is_file("{a.data}/loom.db") { fail "{a.data} holds no instance: give its folder with --data, such as --data /var/lib/loom" }
    let home = if a.from_home.len() > 0 { a.from_home.copy() } else { try user_home(a.from_user.copy()) }
    let staged = try stage_into(home, path, a.data.copy(), a.carry_provider)
    let where = str_at(staged.copy(), "path") ?? String()
    let brought = importer.summary(at(staged.copy(), "counts"))
    let base = if a.url.len() > 0 { a.url.copy() } else { env.variable(String("LOOM_URL")) ?? "http://127.0.0.1:{a.port}" }
    let (answered, _) = client.version(base.copy())
    let set_up = bool_at(answered, "set_up")
    let waiting = Obj.new().s("from", String("openbot")).s("user", a.from_user.copy()).j("staged", staged.copy()).b("pending", true)
    if set_up == none { return said("Staged OpenBot's data from {a.from_user} in {where} ({brought}). No instance answers at {base}, so it comes in once loom runs and has its owner.", waiting.done()) }
    if set_up == some(false) { return said("Staged OpenBot's data from {a.from_user} in {where} ({brought}). It comes into the owner's account once they set loom up.", waiting.done()) }
    // The instance takes it within a second, and writes what came.
    let instance = (try fs.absolute(a.data.copy())).replace("\\", "/")
    let done = "{instance}/{stage.DONE}"
    var waited: i64 = 0
    while not fs.is_file(done.copy()) {
        // Still waiting after 15 s: the instance answering there isn't the one in --data.
        if waited >= 15000 and fs.is_file("{instance}/{stage.PENDING}") { return said("Staged OpenBot's data in {where}, but the instance at {base} hasn't taken it: is {a.data} its folder? It comes in once the instance that keeps its data there runs.", waiting.done()) }
        if waited >= IMPORT_WAIT_MS { return said("Staged OpenBot's data in {where}; the instance hasn't finished importing it after {IMPORT_WAIT_MS / 60000} minutes, and goes on.", waiting.done()) }
        unsafe { sleep(250000000) }
        waited += 250
    }
    let answer = json_text(try fs.read_text(done.copy()) ?? String())
    try fs.remove_file(done)
    if at(answer.copy(), "error") != Json.Null { fail str_at(at(answer, "error"), "message") ?? String("the import failed") }
    var lines: List<String> = [str_at(answer.copy(), "text") ?? String()]
    if let p = str_at(at(answer.copy(), "provider"), "program") { lines.push("{p} uses OpenBot's provider now.") } else if let why = str_at(at(answer.copy(), "provider"), "why") { lines.push(why) }
    if let Json.Array(left) = at(answer.copy(), "not") {
        for n in left { lines.push("- {n.as_str() ?? String()}") }
    }
    return said(lines.join("\n"), merge(answer, Obj.new().j("staged", staged).done()))
}

// How long `loom import --from-user` waits for the instance's import.
const IMPORT_WAIT_MS: i64 = 600000

fn json_text(text: String) -> Json {
    return match parse(text) {
        ok(j) => j,
        err(_) => Json.Null,
    }
}

// `loom update`: the newest release, if its manifest is signed with the release key and
// it's newer, takes this program's place once its SHA-256 is the manifest's
// (server/update.calx, which the instance's instance.update uses too). The old
// program stays beside it, as .old, until the next update. A running instance
// runs the new one once it's restarted; the app's Update restarts it too.
fn update_self(check_only: bool) -> Said ! Error {
    let manifest = try update.manifest(update.Source.official())
    let version = update.version_of(manifest.copy())
    let answer = Obj.new().s("version", String(VERSION)).s("newest", version.copy())
    if not newer(version.copy(), String(VERSION)) {
        return said("loom {VERSION} is the newest", answer.b("updated", false).done())
    }
    if check_only {
        return said("loom {version} is out; this is {VERSION}. `loom update` takes it.", answer.b("updated", false).done())
    }
    let exe = current_exe()
    try update.writable(exe.copy())
    let data = try update.download(manifest)
    _ = try update.stage(exe.copy(), data)
    try update.swap(exe)
    return said("updated loom {VERSION} to {version}; restart the instance to run it", answer.b("updated", true).done())
}
