    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL,
    kind TEXT NOT NULL, tz TEXT NOT NULL, token TEXT NOT NULL UNIQUE, at INTEGER NOT NULL,
    revoked INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS acp_agents (name TEXT PRIMARY KEY, command TEXT NOT NULL, args TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS acp_settings (
    name TEXT PRIMARY KEY, source TEXT NOT NULL, version TEXT NOT NULL, env TEXT NOT NULL);
