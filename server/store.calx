    let id = (c.get(String("id")) ?? Json.Null).as_str() ?? String()
    assert(s.conversation(a.id.copy(), id.copy())! != none)
    assert(s.conversation(b.id.copy(), id)! == none)
    assert(s.conversations(b.id.copy())!.len() == 0)
}

@test
fn another_agents_thread_is_never_the_chat() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    let chat = str_at(s.add_conversation(a.id.copy(), String("a_1"), String())!, "id") ?? String()
    s.put_message(a.id.copy(), Obj.new().s("id", String("msg_1")).s("conversation", chat.copy()).i("at", 10).done())!
    // Newer than the chat, and kept as message_agent kept them before they were marked.
    let asked = str_at(s.add_conversation(a.id.copy(), String("a_1"), String("From Casper"))!, "id") ?? String()
    s.put_message(a.id.copy(), Obj.new().s("id", String("msg_2")).s("conversation", asked.copy()).i("at", 20).done())!
    s.set_meta("talk:{a.id}:a_2:a_1", asked.copy())!
    let panel = str_at(s.add_conversation(a.id.copy(), String("a_1"), String("From Notes"))!, "id") ?? String()
    s.set_meta("talk:{a.id}:plugin:notes:a_1", panel.copy())!
    assert(str_at(s.newest_conversation(a.id.copy(), String("a_1"))! ?? Json.Null, "id") == some(panel.copy()))
    let marked = s.mark_old_asks()!
    assert(marked.len() == 2)
    assert(str_at(s.newest_conversation(a.id.copy(), String("a_1"))! ?? Json.Null, "id") == some(chat.copy()))
    assert(str_at(s.conversation(a.id.copy(), asked.copy())! ?? Json.Null, "asked_by") == some(String("a_2")))
    assert(str_at(s.conversation(a.id.copy(), panel)! ?? Json.Null, "asked_by") == some(String("plugin:notes")))
    assert(str_at(s.conversation(a.id.copy(), chat)! ?? Json.Null, "asked_by") == none)
    // Once marked, they aren't again.
    assert(s.mark_old_asks()!.len() == 0)
}

@test
fn messages_page_newest_last() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    for i in 1i64..6 {
        s.put_message(a.id.copy(), Obj.new().s("id", "msg_{i}").s("conversation", String("c_1")).i("at", i).done())!
    }
    let (page, more) = s.messages(a.id.copy(), String("c_1"), none, 2)!
    assert(more and page.len() == 2)
    assert("{page[1]}".contains("msg_5") and "{page[0]}".contains("msg_4"))
    let (older, more2) = s.messages(a.id.copy(), String("c_1"), some(String("msg_4")), 10)!
    assert(not more2 and older.len() == 3 and "{older[0]}".contains("msg_1"))
}

@test
fn a_routines_runs_are_kept_newest_first_and_go_with_it() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    let b = s.add_user(String("b"), String("password2"), "member")!
    for n in 1i64..4 {
        s.put_routine_run(a.id.copy(), String("rt_1"), Obj.new().s("run", "run_{n}").i("at", n).s("status", String("running")).done())!
    }
    s.put_routine_run(a.id.copy(), String("rt_2"), Obj.new().s("run", String("run_9")).i("at", 9).s("status", String("waiting")).done())!
    s.put_routine_run(a.id.copy(), String("rt_1"), Obj.new().s("run", String("run_3")).i("at", 3).s("status", String("quiet")).done())!
    let runs = s.routine_runs(a.id.copy(), String("rt_1"), none, 10)!
    assert(runs.len() == 3 and "{runs[0]}".contains("run_3") and "{runs[0]}".contains("quiet") and "{runs[2]}".contains("run_1"))
    let older = s.routine_runs(a.id.copy(), String("rt_1"), some(String("run_3")), 1)!
    assert(older.len() == 1 and "{older[0]}".contains("run_2"))
    assert(s.routine_runs(b.id.copy(), String("rt_1"), none, 10)!.len() == 0 and s.routine_run(b.id.copy(), String("rt_1"), String("run_1"))! == none)
    // A restart fails the ones it cut short.
    s.fail_running_routine_runs()!
    assert("{s.routine_run(a.id.copy(), String("rt_1"), String("run_2"))!}".contains("The instance restarted."))
    // And skips one that waited for its chat.
    let waited = s.routine_run(a.id.copy(), String("rt_2"), String("run_9"))! ?? Json.Null
    assert(str_at(waited.copy(), "status") == some(String("skipped")) and str_at(waited, "error") == some(String(RESTARTED_WAITING)))
    s.put_routine(a.id.copy(), Obj.new().s("id", String("rt_1")).done())!
    assert(s.delete_routine(a.id.copy(), String("rt_1"))! and s.routine_runs(a.id.copy(), String("rt_1"), none, 10)!.len() == 0)
}

fn file_message(id: str, conversation: String, names: List<str>, at: i64) -> Json {
    var blocks = List<Json>()
    for n in names {
        blocks.push(Obj.new().s("kind", String("file")).s("file", "sha-{n}").s("name", String(n)).s("mime", String("text/plain")).i("size", 3).done())
    }
    return Obj.new().s("id", String(id)).s("conversation", conversation).i("at", at).j("blocks", Json.Array(blocks)).done()
}

@test
fn recent_files_are_the_newest_sent_each_once() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    let b = s.add_user(String("b"), String("password2"), "member")!
    let c1 = s.add_conversation(a.id.copy(), String("a_1"), String("One"))!
    let c2 = s.add_conversation(a.id.copy(), String("a_2"), String("Two"))!
    let cb = s.add_conversation(b.id.copy(), String("a_3"), String("Theirs"))!
    let id1 = str_at(c1, "id") ?? String()
    let id2 = str_at(c2, "id") ?? String()
    let idb = str_at(cb, "id") ?? String()
    s.put_message(a.id.copy(), file_message("msg_1", id1.copy(), ["old.md", "hours.md"], 100))!
    s.put_message(a.id.copy(), text_message("msg_2", id1.copy(), "a_1", "No files here.", 200))!
    s.put_message(a.id.copy(), file_message("msg_3", id2.copy(), ["shot.png", "hours.md"], 300))!
    s.put_message(b.id.copy(), file_message("msg_4", idb, ["theirs.pdf"], 400))!
    let found = s.recent_files(a.id.copy(), 10)!
    assert(found.len() == 3)
    assert(str_at(found[0].copy(), "name") == some(String("shot.png")) and str_at(found[0].copy(), "conversation") == some(id2.copy()))
    assert(str_at(found[1].copy(), "name") == some(String("hours.md")) and int_at(found[1].copy(), "at") == some(300))
    assert(str_at(found[2].copy(), "name") == some(String("old.md")))
    assert(s.recent_files(a.id.copy(), 1)!.len() == 1)
    // A deleted chat's files don't show.
    s.delete_conversation(a.id.copy(), id2)!
    let left = s.recent_files(a.id.copy(), 10)!
    assert(left.len() == 2 and str_at(left[0].copy(), "name") == some(String("old.md")))
}

fn text_message(id: str, conversation: String, agent: str, words: str, at: i64) -> Json {
    let block = Obj.new().s("kind", String("text")).s("text", String(words)).done()
    var o = Obj.new().s("id", String(id)).s("conversation", conversation).i("at", at).j("blocks", Json.Array([block]))
    if agent.len() > 0 { o = o.s("agent", String(agent)) }
    return o.done()
}

@test
fn search_finds_words_per_person() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    let b = s.add_user(String("b"), String("password2"), "member")!
    let c1 = s.add_conversation(a.id.copy(), String("a_1"), String("Builds"))!
    let c2 = s.add_conversation(a.id.copy(), String("a_2"), String("Mail"))!
    let cb = s.add_conversation(b.id.copy(), String("a_3"), String("Theirs"))!
    let id1 = (c1.get(String("id")) ?? Json.Null).as_str() ?? String()
    let id2 = (c2.get(String("id")) ?? Json.Null).as_str() ?? String()
    let idb = (cb.get(String("id")) ?? Json.Null).as_str() ?? String()
    s.put_message(a.id.copy(), text_message("msg_1", id1.copy(), "", "Did the build on main pass?", 100))!
    s.put_message(a.id.copy(), text_message("msg_2", id1.copy(), "a_1", "Yes, the last build passed.", 200))!
    s.put_message(a.id.copy(), text_message("msg_3", id2.copy(), "a_2", "Café receipts are in the inbox.", 300))!
    s.put_message(b.id.copy(), text_message("msg_4", idb, "a_3", "Their build too", 400))!
    assert(s.search(a.id.copy(), String("build"), none, none, none, 10)!.len() == 2)
    // Prefixes, accents, and quotes that aren't FTS5 syntax.
    assert(s.search(a.id.copy(), String("pas"), none, none, none, 10)!.len() == 2)
    assert(s.search(a.id.copy(), String("cafe"), none, none, none, 10)!.len() == 1)
    assert(s.search(a.id.copy(), String("\"build OR"), none, none, none, 10)!.len() == 0)
    // The person's message counts as the conversation's agent's.
    assert(s.search(a.id.copy(), String("build"), some(String("a_1")), none, none, 10)!.len() == 2)
    assert(s.search(a.id.copy(), String("build"), some(String("a_2")), none, none, 10)!.len() == 0)
    assert(s.search(a.id.copy(), String("build"), none, some(150), none, 10)!.len() == 1)
    assert(s.search(a.id.copy(), String("build"), none, none, some(150), 10)!.len() == 1)
    let found = s.search(a.id.copy(), String("receipts"), none, none, none, 10)!
    assert(found[0].1.contains("{MARK_START}receipts{MARK_END}"))
    // Storing a message again replaces its words, and a deleted conversation's don't show.
    s.put_message(a.id.copy(), text_message("msg_3", id2.copy(), "a_2", "Nothing here now", 300))!
    assert(s.search(a.id.copy(), String("receipts"), none, none, none, 10)!.len() == 0)
    s.delete_conversation(a.id.copy(), id1)!
    assert(s.search(a.id.copy(), String("build"), none, none, none, 10)!.len() == 0)
    assert(s.search(a.id.copy(), String("   "), none, none, none, 10)!.len() == 0)
}

@test
fn files_are_per_person() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    let b = s.add_user(String("b"), String("password2"), "member")!
    let sha = "a".repeat(64)
    s.add_file(a.id.copy(), sha.copy(), String("x.png"), String("image/png"), 10, none)!
    assert(int_at(s.file(a.id.copy(), sha.copy())! ?? Json.Null, "width") == none)
    // Sent again once its size is known, it gets it, and keeps its first name.
    s.add_file(a.id.copy(), sha.copy(), String("again.png"), String("image/png"), 10, some((4000u32, 3000u32)))!
    let f = s.file(a.id.copy(), sha.copy())! ?? Json.Null
    assert("{f}".contains("x.png") and int_at(f.copy(), "width") == some(4000i64) and int_at(f, "height") == some(3000i64))
    assert(s.file(b.id.copy(), sha)! == none)
    assert(s.file_usage(a.id.copy())! == 10 and s.file_usage(b.id.copy())! == 0)
}

@test
fn acp_sessions_are_kept_per_conversation_and_program() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    assert(s.acp_session(a.id.copy(), String("c_1"), String("claude"))! == none)
    s.put_acp_session(a.id.copy(), String("c_1"), String("claude"), String("s_1"), "code")!
    assert(s.acp_session(a.id.copy(), String("c_1"), String("claude"))! == some(String("s_1")))
    // It keeps the tools it started with.
    assert(s.acp_session_tools(a.id.copy(), String("c_1"), String("s_1"))! == "code")
    assert(s.acp_session_tools(a.id.copy(), String("c_1"), String("s_9"))! == "")
    // Another program can't take up claude's session.
    assert(s.acp_session(a.id.copy(), String("c_1"), String("codex"))! == none)
    s.put_acp_session(a.id.copy(), String("c_1"), String("codex"), String("s_2"), "plain")!
    assert(s.acp_session_tools(a.id.copy(), String("c_1"), String("s_2"))! == "plain")
    assert(s.acp_session(a.id.copy(), String("c_1"), String("claude"))! == none)
    assert(s.acp_session(a.id.copy(), String("c_1"), String("codex"))! == some(String("s_2")))
    // It keeps when it was last used, for closing it once it's been idle long.
    _ = s.db.execute(String("UPDATE acp_sessions SET at = 5 WHERE session = 's_2'"), [])!
    assert(s.acp_session_at(a.id.copy(), String("c_1"), String("s_2"))! == 5)
    s.used_acp_session(a.id.copy(), String("c_1"), String("s_2"))!
    assert(s.acp_session_at(a.id.copy(), String("c_1"), String("s_2"))! > 5)
    assert(s.acp_session_at(a.id.copy(), String("c_1"), String("s_1"))! == 0)
}

@test
fn a_moved_chat_keeps_its_program_and_hands_its_summary_once() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    let c = s.add_conversation(a.id.copy(), String("a_1"), String("Chat"))!
    let id = field(c, "id")
    assert(s.conversation_program(a.id.copy(), id.copy())! == none)
    assert(field(s.conversation(a.id.copy(), id.copy())! ?? Json.Null, "program").len() == 0)
    s.set_conversation_program(a.id.copy(), id.copy(), String("codex"), String("claude"))!
    assert(s.conversation_program(a.id.copy(), id.copy())! == some(String("codex")))
    assert(field(s.conversation(a.id.copy(), id.copy())! ?? Json.Null, "program") == "codex")
    assert(s.summary_to_hand(a.id.copy(), id.copy())! == some(String("claude")))
    s.summary_handed(id.copy())!
    assert(s.summary_to_hand(a.id.copy(), id.copy())! == none)
    s.delete_conversation(a.id.copy(), id.copy())!
    assert(s.conversation_program(a.id.copy(), id)! == none)
}

@test
fn memory_is_kept_per_agent_and_shared() {
    let s = test_store()
    let a = s.add_user(String("ann"), String("pw"), "owner")!
    let b = s.add_user(String("bob"), String("pw"), "member")!
    _ = s.remember(a.id.copy(), String("a_1"), String("The deploy key is in 1Password, under Servers."), String("a_1"))!
    _ = s.remember(a.id.copy(), String(""), String("Ann prefers short answers."), String("d_1"))!
    _ = s.remember(a.id.copy(), String("a_2"), String("The deploy runs on Fridays."), String("a_2"))!
    _ = s.remember(b.id.copy(), String("a_9"), String("Bob's deploy notes."), String("a_9"))!
    let mine = s.memories(a.id.copy(), some(String("a_1")), String("deploy keys"), 10)!
    assert(mine.len() == 1 and "{mine[0]}".contains("1Password"))
    let all = s.memories(a.id.copy(), some(String("a_1")), String(), 10)!
    assert(all.len() == 2 and "{all[0]}".contains("short answers"))
    assert(s.memories(a.id.copy(), none, String("deploy"), 10)!.len() == 2)
    let id = (all[1].get(String("id")) ?? Json.Null).as_i64() ?? 0
    assert(not s.forget(a.id.copy(), id, some(String("a_2")))!)
    assert(s.forget(a.id.copy(), id, some(String("a_1")))!)
    assert(s.memories(a.id.copy(), some(String("a_1")), String("1Password"), 10)!.len() == 0)
}

@test
fn rules_are_kept_per_person_and_go_with_their_agent() {
    let s = test_store()
    let a = s.add_user(String("ann"), String("pw"), "owner")!
    let b = s.add_user(String("bob"), String("pw"), "member")!
    s.put_rule(a.id.copy(), Obj.new().s("id", String("r_1")).s("agent", String()).s("then", String("deny")).s("command", String("rm")).i("at", 5).done())!
    s.put_rule(a.id.copy(), Obj.new().s("id", String("r_2")).s("agent", String("a_1")).s("then", String("ask")).s("site", String("github.com")).done())!
    s.put_rule(a.id.copy(), Obj.new().s("id", String("r_1")).s("agent", String()).s("then", String("ask")).s("command", String("rm")).i("at", 5).done())!
    let kept = s.rules(a.id.copy())!
    assert(kept.len() == 2 and "{kept[0]}".contains(#""then":"ask""#) and str_at(kept[1].copy(), "agent") == some(String("a_1")))
    assert(s.rules(b.id.copy())!.len() == 0)
    assert(not s.delete_rule(b.id.copy(), String("r_1"))!)
    s.delete_agent(a.id.copy(), String("a_1"))!
    assert(s.rules(a.id.copy())!.len() == 1)
    assert(s.delete_rule(a.id.copy(), String("r_1"))! and s.rules(a.id.copy())!.len() == 0)
}

@test
fn notes_can_be_tied_to_a_site() {
    assert(site_of(String("https://www.Example.com/login?next=/")) == "example.com")
    assert(site_of(String("me@Shop.example.com:8443")) == "shop.example.com:8443")
    assert(site_of(String("file:///C:/x.html")) == "")
    assert(site_covers(String("example.com"), String("mail.example.com")) and not site_covers(String("example.com"), String("badexample.com")))
    let s = test_store()
    let a = s.add_user(String("ann"), String("pw"), "owner")!
    _ = s.remember_on(a.id.copy(), String("a_1"), String("Log in with the work account."), String("a_1"), String("example.com"))!
    _ = s.remember_on(a.id.copy(), String(""), String("Prices are in NOK."), String("d_1"), String("shop.example.com"))!
    _ = s.remember_on(a.id.copy(), String("a_2"), String("Not a_1's."), String("a_2"), String("example.com"))!
    _ = s.remember(a.id.copy(), String("a_1"), String("Not tied to a site."), String("a_1"))!
    let notes = s.site_notes(a.id.copy(), String("a_1"), String("shop.example.com"))!
    assert(notes.len() == 2 and "{notes[0]}".contains("NOK") and "{notes[1]}".contains("work account"))
    assert(s.site_notes(a.id.copy(), String("a_1"), String("example.org"))!.len() == 0)
    assert("{s.memories(a.id.copy(), some(String("a_1")), String("NOK"), 10)!}".contains("\"site\":\"shop.example.com\""))
}

@test
fn proposals_wait_for_the_person() {
    let s = test_store()
    let a = s.add_user(String("ann"), String("pw"), "owner")!
    let steps = parse(#"[{"kind":"page","url":"https://example.com"}]"#)!
    let rec = s.add_recording(a.id.copy(), String("a_1"), steps)!
    assert(s.unwritten_recording(a.id.copy(), String("a_1"))! == some(rec.copy()))
    let skill = Obj.new().s("name", String("order-socks")).s("description", String("Ordering socks.")).s("body", String("1. Open the shop.")).done()
    let p = s.add_proposal(a.id.copy(), String("a_1"), "skill", skill.copy(), String("You showed me."), rec.copy())!
    let id = field(p.copy(), "id")
    s.recording_written(a.id.copy(), rec.copy(), id.copy())!
    assert(s.unwritten_recording(a.id.copy(), String("a_1"))! == none)
    assert(field(p.copy(), "status") == "waiting" and "{p}".contains(#""steps":[{"kind":"page""#))
    _ = s.add_proposal(a.id.copy(), String("a_1"), "note", Obj.new().s("text", String("Ann likes wool.")).done(), String("From Tuesday's chat."), String())!
    assert(s.proposals(a.id.copy(), String("waiting"), 50)!.len() == 2)
    assert(s.decide_proposal(a.id.copy(), id.copy(), "kept", skill.copy(), String("d_1"))!)
    assert(not s.decide_proposal(a.id.copy(), id.copy(), "dropped", skill, String("d_1"))!)
    assert(s.proposals(a.id.copy(), String("waiting"), 50)!.len() == 1)
    assert(field(s.proposal(a.id.copy(), id)! ?? Json.Null, "by") == "d_1")
}

@test
fn agent_defaults_are_kept_per_person() {
    let s = test_store()
    let a = s.add_user(String("ann"), String("pw"), "owner")!
    let b = s.add_user(String("bob"), String("pw"), "member")!
    let blank_now = s.defaults(a.id.copy())!
    assert(int_at(blank_now.copy(), "revision") == some(0) and "{blank_now}".contains(#""permission":"ask""#))
    _ = s.put_defaults(a.id.copy(), Obj.new().s("permission", String("auto")).s("busy", String("steer")).done(), String("d_1"))!
    let kept = s.put_defaults(a.id.copy(), merge(s.defaults(a.id.copy())!, Obj.new().s("instructions", String("Be brief.")).done()), String("a_1"))!
    assert(int_at(kept.copy(), "revision") == some(2))
    let now_kept = s.defaults(a.id.copy())!
    assert("{now_kept}".contains(#""permission":"auto""#) and "{now_kept}".contains(#""busy":"steer""#) and "{now_kept}".contains("Be brief.") and "{now_kept}".contains(#""by":"a_1""#))
    assert("{s.defaults(b.id.copy())!}".contains(#""busy":"queue""#))
}

@test
fn settings_and_hook_secrets_are_kept_sealed() {
    let s = test_store()
    let a = s.add_user(String("ann"), String("pw"), "owner")!
    s.set_acp_agent(String("x"), String("x"), List<String>())!
    s.set_acp_settings(String("x"), String(""), String("1"), parse(#"{"X_KEY":"sk-live-123"}"#)!)!
    s.put_routine(a.id.copy(), parse(#"{"id":"rt_1","name":"Build","hook":"h_1","secret":"hook-secret-456","next":0}"#)!)!
    var raw = String()
    for r in s.db.query(String("SELECT env FROM acp_settings UNION ALL SELECT json FROM routines"))! {
        raw.push_str(text(r[0].copy()))
    }
    assert(not raw.contains("sk-live-123") and not raw.contains("hook-secret-456"))
    assert("{(s.acp_agent(String("x"))! ?? panic("no program")).env}".contains("sk-live-123"))
    assert("{s.routine(a.id.copy(), String("rt_1"))! ?? Json.Null}".contains("hook-secret-456"))
    let (_, hooked) = s.routine_by_hook(String("h_1"))! ?? panic("no hook")
    assert("{hooked}".contains("hook-secret-456"))
    // Moved to another program, sealed settings don't open.
    _ = s.db.execute(String("INSERT INTO acp_settings (name, source, version, env) SELECT 'y', source, version, env FROM acp_settings WHERE name = 'x'"), List<Value>())!
    s.set_acp_agent(String("y"), String("y"), List<String>())!
    let opens = match s.acp_agent(String("y")) {
        ok(_) => true,
        err(_) => false,
    }
    assert(not opens)
}

@test
fn snippets_lose_their_markdown() {
    let mark = |w: str| "\u{2}{w}\u{3}"
    assert(plain_snippet("- `{mark("report")}.csv`, last month's **numbers**") == "{mark("report")}.csv, last month's numbers")
    assert(plain_snippet("see [the {mark("guide")}](https://example.com/x) and ~~old~~") == "see the {mark("guide")} and old")
    assert(plain_snippet("# Title\n> quoted {mark("word")}\n1. first") == "Title quoted {mark("word")} first")
    assert(plain_snippet(String("snake_case stays, and so does a * b")) == "snake_case stays, and so does a * b")
}
