    hash TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), by TEXT NOT NULL,
    expires INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS owner_codes (
    hash TEXT PRIMARY KEY, by TEXT NOT NULL, expires INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS script_grants (
    hash TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), scope TEXT NOT NULL,
