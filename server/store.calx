-- The limits of a person's plan with an agent program, as the program last reported them
-- (PLAN.md, "Usage limits"): its plan's name, and how much of the session and the week
-- is used, with when each resets.
CREATE TABLE IF NOT EXISTS plan_limits (
    user TEXT NOT NULL REFERENCES users(id), program TEXT NOT NULL, json TEXT NOT NULL,
