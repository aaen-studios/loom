CREATE TABLE IF NOT EXISTS files (
    sha TEXT NOT NULL, user TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL,
    mime TEXT NOT NULL, size INTEGER NOT NULL, at INTEGER NOT NULL, width INTEGER NOT NULL DEFAULT 0,
