    input INTEGER NOT NULL, output INTEGER NOT NULL, total INTEGER NOT NULL,
    shared INTEGER NOT NULL, at INTEGER NOT NULL);
CREATE INDEX IF NOT EXISTS usage_by_user ON usage (user, program, at);
CREATE TABLE IF NOT EXISTS agents (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), json TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS agent_revisions (
    agent TEXT NOT NULL, user TEXT NOT NULL REFERENCES users(id), revision INTEGER NOT NULL,
    json TEXT NOT NULL, by TEXT NOT NULL, at INTEGER NOT NULL, PRIMARY KEY (agent, revision));
