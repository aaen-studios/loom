CREATE VIRTUAL TABLE IF NOT EXISTS memories_fts USING fts5 (
    text, user UNINDEXED, agent UNINDEXED,
    tokenize = 'unicode61 remove_diacritics 2');
CREATE VIRTUAL TABLE IF NOT EXISTS messages_fts USING fts5 (
    text, user UNINDEXED, agent UNINDEXED, at UNINDEXED,
    tokenize = 'unicode61 remove_diacritics 2');
CREATE TABLE IF NOT EXISTS shared_tables (
    user TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, description TEXT NOT NULL,
    owner TEXT NOT NULL, at INTEGER NOT NULL, PRIMARY KEY (user, name));
