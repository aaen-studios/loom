CREATE TABLE IF NOT EXISTS sent (
    device TEXT NOT NULL, cid TEXT NOT NULL, message TEXT NOT NULL, run TEXT NOT NULL,
    at INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (device, cid));
