    id INTEGER PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), agent TEXT NOT NULL,
    kind TEXT NOT NULL, text TEXT NOT NULL, by TEXT NOT NULL, at INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT '', input TEXT NOT NULL DEFAULT '', why TEXT NOT NULL DEFAULT '',
    ended INTEGER NOT NULL DEFAULT 0);
CREATE INDEX IF NOT EXISTS activity_by_agent ON activity (user, agent, id);
CREATE INDEX IF NOT EXISTS activity_by_user ON activity (user, id);
CREATE TABLE IF NOT EXISTS secrets (
    user TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, nonce TEXT NOT NULL,
    sealed TEXT NOT NULL, at INTEGER NOT NULL, PRIMARY KEY (user, name));
CREATE TABLE IF NOT EXISTS mcp_servers (
    user TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, json TEXT NOT NULL,
    at INTEGER NOT NULL, PRIMARY KEY (user, name));
CREATE TABLE IF NOT EXISTS mcp_auth (
    user TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, nonce TEXT NOT NULL,
    sealed TEXT NOT NULL, due INTEGER NOT NULL DEFAULT 0, at INTEGER NOT NULL,
    PRIMARY KEY (user, name));
CREATE INDEX IF NOT EXISTS mcp_auth_due ON mcp_auth (due);
CREATE TABLE IF NOT EXISTS mcp_icons (
    user TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, key TEXT NOT NULL,
    icon TEXT NOT NULL, dark TEXT NOT NULL, at INTEGER NOT NULL, PRIMARY KEY (user, name));
CREATE TABLE IF NOT EXISTS skills (
    user TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, description TEXT NOT NULL,
    body TEXT NOT NULL, at INTEGER NOT NULL, PRIMARY KEY (user, name));
CREATE TABLE IF NOT EXISTS conversations (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), agent TEXT NOT NULL,
    title TEXT NOT NULL, at INTEGER NOT NULL, deleted INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS messages (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), conversation TEXT NOT NULL,
    json TEXT NOT NULL, at INTEGER NOT NULL);
CREATE INDEX IF NOT EXISTS messages_by_conversation ON messages (user, conversation, at);
CREATE INDEX IF NOT EXISTS conversations_by_agent ON conversations (user, agent);
-- The newest messages in any chat, for the files sent lately (recent_files).
CREATE INDEX IF NOT EXISTS messages_newest ON messages (user, at);
-- A page of a chat goes by rowid, which this index ends in, so it needs no sort.
CREATE INDEX IF NOT EXISTS messages_in_order ON messages (user, conversation);
-- Only the pinned messages, so the pins of a long chat are found without reading it.
CREATE INDEX IF NOT EXISTS messages_pinned ON messages (user, conversation, json_extract(json, '$.pinned.at')) WHERE json_extract(json, '$.pinned') IS NOT NULL;
CREATE TABLE IF NOT EXISTS runs (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), conversation TEXT NOT NULL,
    status TEXT NOT NULL, at INTEGER NOT NULL, routine TEXT NOT NULL DEFAULT '',
    outcome TEXT NOT NULL DEFAULT '');
-- Only the runs still going, which start looks for: runs are kept, so they add up.
CREATE INDEX IF NOT EXISTS runs_running ON runs (id) WHERE status = 'running';
CREATE TABLE IF NOT EXISTS branches (
    conversation TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), from_conversation TEXT NOT NULL,
    from_message TEXT NOT NULL, handed INTEGER NOT NULL DEFAULT 0);
