    user TEXT PRIMARY KEY REFERENCES users(id), hash TEXT NOT NULL UNIQUE, at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS status_tokens (
    user TEXT PRIMARY KEY REFERENCES users(id), hash TEXT NOT NULL UNIQUE, at INTEGER NOT NULL,
    path TEXT NOT NULL DEFAULT '', agent TEXT NOT NULL DEFAULT '');
CREATE TABLE IF NOT EXISTS imported (
    user TEXT NOT NULL REFERENCES users(id), source TEXT NOT NULL, kind TEXT NOT NULL,
    id TEXT NOT NULL, loom TEXT NOT NULL, at INTEGER NOT NULL, PRIMARY KEY (user, source, kind, id));
"#

/// What search marks a matched word with, before and after.
pub const MARK_START: str = "\u{2}"
pub const MARK_END: str = "\u{3}"

// How many of each routine's runs are kept, the newest.
const ROUTINE_RUNS_KEPT: i64 = 100

// How many of the newest messages recent_files looks through for files.
const RECENT_LOOKED: i64 = 2000

pub fn now() -> i64 {
    return unsafe { Timestamp.now() }.unix_ms
}

pub struct User {
    pub id: String
    pub username: String
    pub role: String
}

pub struct Device {
    pub id: String
    pub user: String
    pub name: String
    pub kind: String
}

pub struct AcpAgent {
    pub name: String
    pub command: String
    pub args: List<String>
    pub source: String    // the ACP Registry id it was installed from, or "" for one added by hand
    pub version: String
    pub env: Json    // its settings: the environment variables it starts with
}

pub struct Store {
    db: Database
    hasher: PasswordHasher
    sealer: XChaCha20Poly1305
}

// How a sealed value starts, in the column that holds it.
const SEALED: str = "sealed:"

// The instance's key for sealing (PLAN.md, "Accounts and invites"), in
// secret.key in the data folder: made on the first start, and readable only by
// the instance's own user. It's kept out of the database, so a copy of loom.db
// alone opens nothing.
pub fn secret_key(data: String) -> XChaCha20Poly1305 ! Error {
    let path = "{data}/secret.key"
    if fs.exists(path.copy()) {
        let key = try fs.read(path.copy())
        if key.len() != 32 { fail "{path} isn't a 32-byte key" }
        return XChaCha20Poly1305.new(key)
    }
    let key = XChaCha20Poly1305.generate_key()
    let part = "{path}.part"
    try fs.write(part.copy(), key.copy())
    if os() != "windows" { try fs.set_mode(part.copy(), 0o600) }
    try fs.rename(part, path)
    return XChaCha20Poly1305.new(key)
}

fn text(v: Value) -> String {
    match v {
        Value.Text(s) => return s.copy(),
        Value.Int(n) => return "{n}",
        _ => return String(),
    }
}

// A JSON object's string field, or "".
fn field(j: Json, key: str) -> String {
    return (j.get(String(key)) ?? Json.Null).as_str() ?? String()
}

// A conversation from its row: id, agent, title, at, and the task it is, if any.
fn conversation_of(r: List<Value>) -> Json {
    var o = Obj.new().s("id", text(r[0].copy())).s("agent", text(r[1].copy())).s("title", text(r[2].copy())).i("at", int(r[3].copy()))
    let task = text(r[4].copy())
    if task.len() > 0 { o = o.s("task", task) }
    // Where side questions about the agent's chat are asked: no chat of its own.
    if text(r[5].copy()).len() > 0 { o = o.b("side", true) }
    // A branch of a chat: the chat, and the message it branches at.
    let from = text(r[6].copy())
    if from.len() > 0 { o = o.s("branch_of", from).s("branch_at", text(r[7].copy())) }
    // A routine's thread of its own: the routine.
    let routine = text(r[8].copy())
    if routine.len() > 0 { o = o.s("routine", routine) }
    // A chat moved to another program than its agent's, by hand or to its backup.
    let program = text(r[9].copy())
    if program.len() > 0 { o = o.s("program", program) }
    // Another agent's thread with it, or a plugin panel's: who asks.
    let asked_by = text(r[10].copy())
    if asked_by.len() > 0 { o = o.s("asked_by", asked_by) }
    // A group chat's room (PLAN.md, "Group chats").
    let room = text(r[11].copy())
    if room.len() > 0 {
        if let ok(j) = parse(room) { o = o.j("room", j) }
    }
    return o.done()
}

fn int(v: Value) -> i64 {
    match v {
        Value.Int(n) => return n,
        _ => return 0,
    }
}

// A shared table's row, from id, data, by, at and updated.
fn row_of(r: List<Value>) -> Json {
    let data = match parse(text(r[1].copy())) {
        ok(j) => j,
        err(_) => Obj.new().done(),
    }
    return Obj.new().i("id", int(r[0].copy())).s("by", text(r[2].copy())).i("at", int(r[3].copy())).i("updated", int(r[4].copy())).j("data", data).done()
}

fn t(s: String) -> Value {
    return Value.Text(s.copy())
}

// A device token: 32 random bytes as hex. Only its SHA-256 is stored.
pub fn new_token() -> String {
    return bytes.hex(random_bytes(32))
}

// What a program's sealed settings are bound to.
fn settings_aad(name: String) -> String {
    return "loom acp settings {name}"
}

// What a routine's sealed webhook secret is bound to.
fn hook_aad(routine: String) -> String {
    return "loom hook {routine}"
}

fn token_hash(token: String) -> String {
    return bytes.hex(sha256(token.to_bytes()))
}

impl Store {
    // Closes the database, so its files can be moved or removed.
    pub fn close(own self) ! Error {
        try self.db.close()
    }

    // Opens (or makes) the database at `path`. `hasher` hashes passwords;
    // tests pass a cheap one.
    // This connection stops checkpointing by itself: the instance's loop has
    // shared/checkpoint.calx do it on another thread.
    pub fn checkpoint_elsewhere(self) ! Error {
        try self.db.execute_script(String("PRAGMA wal_autocheckpoint = 0;"))
    }

    // Truncates the log once the checkpoint thread says it grew long, between the
    // loop's transactions (shared/checkpoint.calx, `truncate`).
    pub fn truncate_log(self, big: mut Receiver<bool>) ! Error {
        try checkpoint.truncate(self.db, mut big)
    }

    pub fn open(path: String, hasher: PasswordHasher) -> Store ! Error {
        // The key sits beside the database; one in memory gets a key of its own.
        let sealer = if path == ":memory:" { XChaCha20Poly1305.new(XChaCha20Poly1305.generate_key()) } else { try secret_key(if let cut = path.replace("\\", "/").find_last("/") { path[..cut].copy() } else { String(".") }) }
        let db = try Database.open(path)
        // A page cache of up to 64 MB, rather than SQLite's 2 MB: a snapshot or an export reads
        // a few MB, which a small cache fetched from the system again each time. And the
        // write-ahead log goes back to 64 MB after a burst.
        try db.execute_script(String("PRAGMA journal_mode = WAL; PRAGMA foreign_keys = ON; PRAGMA cache_size = -65536; PRAGMA journal_size_limit = 67108864;"))
        try db.execute_script(String(SCHEMA))
        let s = Store { db: db, hasher: hasher, sealer: sealer }
        // An activity log from before actions were recorded gets their columns.
        var recorded = false
        for r in try s.db.query(String("PRAGMA table_info(activity)")) {
            if text(r[1].copy()) == "status" { recorded = true }
        }
        if not recorded {
            try s.db.execute_script(String("ALTER TABLE activity ADD COLUMN status TEXT NOT NULL DEFAULT ''; ALTER TABLE activity ADD COLUMN input TEXT NOT NULL DEFAULT ''; ALTER TABLE activity ADD COLUMN why TEXT NOT NULL DEFAULT ''; ALTER TABLE activity ADD COLUMN ended INTEGER NOT NULL DEFAULT 0;"))
        }
        // Only what is still going, which start marks failed after a restart: activity is
        // kept for good, so it adds up.
        try s.db.execute_script(String("CREATE INDEX IF NOT EXISTS activity_started ON activity (id) WHERE status = 'started';"))
        // Notes from before a note could be tied to a site get the column.
        var sited = false
        for r in try s.db.query(String("PRAGMA table_info(memories)")) {
            if text(r[1].copy()) == "site" { sited = true }
        }
        if not sited { try s.db.execute_script(String("ALTER TABLE memories ADD COLUMN site TEXT NOT NULL DEFAULT '';")) }
        // ACP sessions from before a session kept its tools get the column,
        // empty for not known.
        var tooled = false
        for r in try s.db.query(String("PRAGMA table_info(acp_sessions)")) {
            if text(r[1].copy()) == "tools" { tooled = true }
        }
        if not tooled { try s.db.execute_script(String("ALTER TABLE acp_sessions ADD COLUMN tools TEXT NOT NULL DEFAULT '';")) }
        // Runs from before a run kept the routine that started it, and how that
        // routine said it went, get the columns, empty for none or not known.
        var routined = false
        for r in try s.db.query(String("PRAGMA table_info(runs)")) {
            if text(r[1].copy()) == "routine" { routined = true }
        }
        if not routined { try s.db.execute_script(String("ALTER TABLE runs ADD COLUMN routine TEXT NOT NULL DEFAULT ''; ALTER TABLE runs ADD COLUMN outcome TEXT NOT NULL DEFAULT '';")) }
        // Status tokens from before one could be saved to a file get where it
        // was saved and the agent that asked, empty for one made in the app.
        var saved = false
        for r in try s.db.query(String("PRAGMA table_info(status_tokens)")) {
            if text(r[1].copy()) == "path" { saved = true }
        }
        if not saved { try s.db.execute_script(String("ALTER TABLE status_tokens ADD COLUMN path TEXT NOT NULL DEFAULT ''; ALTER TABLE status_tokens ADD COLUMN agent TEXT NOT NULL DEFAULT '';")) }
        // Devices from before the instance kept when each was last connected get the
        // column, 0 for not known.
        var seen = false
        for r in try s.db.query(String("PRAGMA table_info(devices)")) {
            if text(r[1].copy()) == "seen" { seen = true }
        }
        if not seen { try s.db.execute_script(String("ALTER TABLE devices ADD COLUMN seen INTEGER NOT NULL DEFAULT 0;")) }
        // A person's routine runs by when they started, which the status reads for the last 24 hours.
        try s.db.execute_script(String("CREATE INDEX IF NOT EXISTS runs_by_routine ON runs (user, at) WHERE routine != '';"))
        // Files from before a picture kept its width and height get the columns, 0 for not
        // known: the apps size those by their thumbnails.
        var sized = false
        for r in try s.db.query(String("PRAGMA table_info(files)")) {
            if text(r[1].copy()) == "width" { sized = true }
        }
        if not sized { try s.db.execute_script(String("ALTER TABLE files ADD COLUMN width INTEGER NOT NULL DEFAULT 0; ALTER TABLE files ADD COLUMN height INTEGER NOT NULL DEFAULT 0;")) }
        // Client ids from before they kept when they came count from now, so they're
        // pruned as old a while after the update, not at once.
        var dated = false
        for r in try s.db.query(String("PRAGMA table_info(sent)")) {
            if text(r[1].copy()) == "at" { dated = true }
        }
        if not dated {
            try s.db.execute_script(String("ALTER TABLE sent ADD COLUMN at INTEGER NOT NULL DEFAULT 0;"))
            _ = try s.db.execute(String("UPDATE sent SET at = ?"), [Value.Int(now())])
        }
        // What prune_rows looks for, by age.
        try s.db.execute_script(String("CREATE INDEX IF NOT EXISTS runs_by_at ON runs (at); CREATE INDEX IF NOT EXISTS sent_by_at ON sent (at); CREATE INDEX IF NOT EXISTS usage_by_at ON usage (at);"))
        // Settings kept before they were sealed are sealed once.
        for r in try s.db.query(String("SELECT name, env FROM acp_settings")) {
            let env = text(r[1].copy())
            if env.len() > 0 and not env.starts_with(SEALED) {
                let name = text(r[0].copy())
                _ = try s.db.execute(String("UPDATE acp_settings SET env = ? WHERE name = ?"), [t(s.seal(env, settings_aad(name.copy()))), t(name)])
            }
        }
        // Messages stored before search came are indexed once.
        if try s.meta("search") == none {
            let began = try s.begin()
            match s.index_all() {
                ok => {},
                err(e) => {
                    s.rollback(began)
                    fail e
                },
            }
            try s.commit(began)
        }
        return s
    }

    // Indexes every message for search, for a database from before search came.
    fn index_all(self) ! Error {
        for r in try self.db.query(String("SELECT user, json FROM messages")) {
            try self.index_message(text(r[0].copy()), try parse(text(r[1].copy())))
        }
        try self.set_meta("search", String("1"))
    }

    // `plain`, sealed under the instance's key and bound to `aad`, as text:
    // "sealed:", then the nonce and the sealed bytes in hex, with a colon between.
    fn seal(self, plain: String, aad: String) -> String {
        let nonce = random_bytes(24)
        let sealed = self.sealer.encrypt(nonce.copy(), plain.to_bytes(), aad.to_bytes())
        return "{SEALED}{bytes.hex(nonce)}:{bytes.hex(sealed)}"
    }

    // What `seal` sealed, or `kept` itself when it isn't sealed.
    fn unseal(self, kept: String, aad: String) -> String ! Error {
        if not kept.starts_with(SEALED) { return kept.copy() }
        let rest = kept[SEALED.len()..].copy()
        let colon = rest.find(":") else { fail "a sealed value is damaged" }
        let nonce = bytes.from_hex(rest[..colon].copy()) else { fail "a sealed value is damaged" }
        let sealed = bytes.from_hex(rest[colon + 1..].copy()) else { fail "a sealed value is damaged" }
        let opened = self.sealer.decrypt(nonce, sealed, aad.to_bytes()) else { fail "a sealed value doesn't open with this instance's key" }
        return String.from_utf8(opened) ?? String()
    }

    // The next id of a kind: "u" gives u_1, u_2, ...
    pub fn new_id(self, kind: str) -> String ! Error {
        _ = try self.db.execute(String("INSERT INTO ids (kind, next) VALUES (?, 1) ON CONFLICT (kind) DO UPDATE SET next = next + 1"), [t(String(kind))])
        let row = try self.db.query_one(String("SELECT next FROM ids WHERE kind = ?"), [t(String(kind))])
        let n = int((row ?? List<Value>())[0].copy())
        return "{kind}_{n}"
    }

    pub fn meta(self, key: String) -> String? ! Error {
        let row = try self.db.query_one(String("SELECT value FROM meta WHERE key = ?"), [t(key)])
        let r = row else return none
        return some(text(r[0].copy()))
    }

    pub fn set_meta(self, key: String, value: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO meta (key, value) VALUES (?, ?) ON CONFLICT (key) DO UPDATE SET value = excluded.value"), [t(key), t(value)])
    }

    pub fn delete_meta(self, key: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM meta WHERE key = ?"), [t(key)])
    }

    // Work that lands together or not at all: a savepoint, in a transaction of its own
    // or in the one `hold` keeps. Gives whether it began the transaction, which
    // `commit` and `rollback` take; every error path after it calls `rollback`, so no
    // transaction is left open holding the write lock.
    //
    // A transaction of its own takes the write lock as it begins (BEGIN IMMEDIATE), as
    // `hold` does: one that took it at its first write, after reading, failed at once
    // with "database is locked" whenever another connection (a `loom` command) had
    // written since, or was writing, whatever the busy timeout, since SQLite can't
    // wait there without risking a deadlock. Taken first, it waits as long as the busy
    // timeout.
    pub fn begin(self) -> bool ! Error {
        var began = false
        if not self.db.in_transaction() {
            _ = try self.db.execute(String("BEGIN IMMEDIATE"))
            began = true
        }
        match self.db.execute(String("SAVEPOINT work")) {
            ok(_) => {},
            err(e) => {
                if began { self.abandon() }
                fail e
            },
        }
        return began
    }

    pub fn commit(self, began: bool) ! Error {
        match self.db.execute(String("RELEASE work")) {
            ok(_) => {},
            err(e) => {
                self.rollback(began)
                fail e
            },
        }
        if not began { return }
        match self.db.commit() {
            ok => {},
            err(e) => {
                self.abandon()
                fail e
            },
        }
    }

    pub fn rollback(self, began: bool) {
        if not self.db.in_transaction() { return }
        match self.db.execute(String("ROLLBACK TO work")) {
            ok(_) => match self.db.execute(String("RELEASE work")) {
                ok(_) => {},
                err(e) => eprintln("loom: rollback failed: {e}"),
            },
            err(e) => eprintln("loom: rollback failed: {e}"),
        }
        if began { self.abandon() }
    }

    // Rolls back whatever transaction is open: what a request that failed part way
    // left, outside `hold`, which would keep the write lock from every other
    // connection until the next frame.
    pub fn abandon(self) {
        if not self.db.in_transaction() { return }
        match self.db.rollback() {
            ok => {},
            err(e) => eprintln("loom: rollback failed: {e}"),
        }
    }

    // Keeps every write from here on in one transaction until `let_go`, so the writes
    // of one frame, or of one burst of agent lines, are saved once rather than each on
    // its own. It takes the write lock at once, as `begin` does.
    pub fn hold(self) ! Error {
        if not self.db.in_transaction() { _ = try self.db.execute(String("BEGIN IMMEDIATE")) }
    }

    pub fn let_go(self) ! Error {
        if not self.db.in_transaction() { return }
        match self.db.commit() {
            ok => {},
            err(e) => {
                match self.db.rollback() {
                    ok => {},
                    err(_) => {},
                }
                fail e
            },
        }
    }

    // --- Accounts ---

    pub fn user_count(self) -> i64 ! Error {
        let row = try self.db.query_one(String("SELECT count(*) FROM users"))
        return int((row ?? List<Value>())[0].copy())
    }

    pub fn add_user(self, username: String, password: String, role: str) -> User ! Error {
        let id = try self.new_id("u")
        let hash = self.hasher.hash(password)
        _ = try self.db.execute(String("INSERT INTO users (id, username, password, role, at) VALUES (?, ?, ?, ?, ?)"), [t(id.copy()), t(username.copy()), t(hash), t(String(role)), Value.Int(now())])
        return User { id: id, username: username.copy(), role: String(role) }
    }

    // An account whose password hash was made elsewhere, on the hashing thread.
    pub fn add_user_hashed(self, username: String, hash: String, role: str) -> User ! Error {
        let id = try self.new_id("u")
        _ = try self.db.execute(String("INSERT INTO users (id, username, password, role, at) VALUES (?, ?, ?, ?, ?)"), [t(id.copy()), t(username.copy()), t(hash), t(String(role)), Value.Int(now())])
        return User { id: id, username: username.copy(), role: String(role) }
    }

    // The account and its stored hash, for checking a login elsewhere.
    pub fn login_record(self, username: String) -> (User, String)? ! Error {
        let row = try self.db.query_one(String("SELECT id, username, role, password FROM users WHERE username = ?"), [t(username)])
        let r = row else return none
        return some((User { id: text(r[0].copy()), username: text(r[1].copy()), role: text(r[2].copy()) }, text(r[3].copy())))
    }

    pub fn set_password_hash(self, user: String, hash: String) ! Error {
        _ = try self.db.execute(String("UPDATE users SET password = ? WHERE id = ?"), [t(hash), t(user)])
    }

    pub fn set_password(self, user: String, password: String) ! Error {
        try self.set_password_hash(user, self.hasher.hash(password))
    }

    pub fn find_username(self, username: String) -> User? ! Error {
        let row = try self.db.query_one(String("SELECT id, username, role FROM users WHERE username = ?"), [t(username)])
        let r = row else return none
        return some(User { id: text(r[0].copy()), username: text(r[1].copy()), role: text(r[2].copy()) })
    }

    // The user, if the password is theirs. A username that doesn't exist
    // still costs a hash, so the two can't be told apart by time.
    pub fn check_password(self, username: String, password: String) -> User? ! Error {
        let row = try self.db.query_one(String("SELECT id, username, role, password FROM users WHERE username = ?"), [t(username)])
        let r = row else {
            _ = self.hasher.hash(password)
            return none
        }
        let stored = text(r[3].copy())
        // An account with no password yet takes none.
        if stored.len() == 0 { return none }
        if not verify_password(stored.copy(), password.copy()) { return none }
        if self.hasher.needs_rehash(stored) {
            _ = try self.db.execute(String("UPDATE users SET password = ? WHERE id = ?"), [t(self.hasher.hash(password)), r[0].copy()])
        }
        return some(User { id: text(r[0].copy()), username: text(r[1].copy()), role: text(r[2].copy()) })
    }

    pub fn users(self) -> List<User> ! Error {
        var out = List<User>()
        for r in try self.db.query(String("SELECT id, username, role FROM users ORDER BY at")) {
            out.push(User { id: text(r[0].copy()), username: text(r[1].copy()), role: text(r[2].copy()) })
        }
        return out
    }

    // --- Devices ---

    // A new device for `user`, and its token.
    pub fn add_device(self, user: String, name: String, kind: String, tz: String) -> (Device, String) ! Error {
        let id = try self.new_id("d")
        let token = new_token()
        _ = try self.db.execute(String("INSERT INTO devices (id, user, name, kind, tz, token, at) VALUES (?, ?, ?, ?, ?, ?, ?)"), [t(id.copy()), t(user.copy()), t(name.copy()), t(kind.copy()), t(tz), t(token_hash(token.copy())), Value.Int(now())])
        return (Device { id: id, user: user.copy(), name: name.copy(), kind: kind.copy() }, token)
    }

    // The device a token belongs to, unless it was revoked.
    pub fn device_for_token(self, token: String) -> Device? ! Error {
        let row = try self.db.query_one(String("SELECT id, user, name, kind FROM devices WHERE token = ? AND revoked = 0"), [t(token_hash(token))])
        let r = row else return none
        return some(Device { id: text(r[0].copy()), user: text(r[1].copy()), name: text(r[2].copy()), kind: text(r[3].copy()) })
    }

    pub fn device(self, user: String, id: String) -> Device? ! Error {
        let row = try self.db.query_one(String("SELECT id, user, name, kind FROM devices WHERE id = ? AND user = ? AND revoked = 0"), [t(id), t(user)])
        let r = row else return none
        return some(Device { id: text(r[0].copy()), user: text(r[1].copy()), name: text(r[2].copy()), kind: text(r[3].copy()) })
    }

    // The time zone a device last said it's in, an IANA name.
    pub fn device_tz(self, id: String) -> String ! Error {
        let r = try self.db.query_one(String("SELECT tz FROM devices WHERE id = ?"), [t(id)]) else return String()
        return text(r[0].copy())
    }

    // The time zone `user`'s newest device is in, or "" with none.
    pub fn user_tz(self, user: String) -> String ! Error {
        let r = try self.db.query_one(String("SELECT tz FROM devices WHERE user = ? AND revoked = 0 AND tz != '' ORDER BY at DESC LIMIT 1"), [t(user)]) else return String()
        return text(r[0].copy())
    }

    pub fn rename_device(self, id: String, name: String) ! Error {
        _ = try self.db.execute(String("UPDATE devices SET name = ? WHERE id = ?"), [t(name), t(id)])
    }

    // Keeps `time` as when device `id` was last connected.
    pub fn touch_device(self, id: String, time: i64) ! Error {
        _ = try self.db.execute(String("UPDATE devices SET seen = ? WHERE id = ?"), [Value.Int(time), t(id)])
    }

    // `user`'s devices still signed in, oldest first: each `id`, `name`, `kind`, `at`
    // (when it signed in) and `seen` (when it was last connected, or 0 for never).
    pub fn devices(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT id, name, kind, at, seen FROM devices WHERE user = ? AND revoked = 0 ORDER BY at"), [t(user)]) {
            out.push(Obj.new().s("id", text(r[0].copy())).s("name", text(r[1].copy())).s("kind", text(r[2].copy())).i("at", int(r[3].copy())).i("seen", int(r[4].copy())).done())
        }
        return out
    }

    pub fn update_device_tz(self, id: String, tz: String) ! Error {
        _ = try self.db.execute(String("UPDATE devices SET tz = ? WHERE id = ?"), [t(tz), t(id)])
    }

    pub fn revoke_device(self, id: String) ! Error {
        _ = try self.db.execute(String("UPDATE devices SET revoked = 1 WHERE id = ?"), [t(id.copy())])
        // A device signed out gets no more push.
        _ = try self.db.execute(String("DELETE FROM push_tokens WHERE device = ?"), [t(id)])
    }

    // --- Push (PLAN.md, "Notifications and push") ---

    // Keeps device `device`'s APNs token, `env` production or development,
    // in place of any it had. A phone that takes push through the relay keeps its
    // sealed token, base64, with `env` `relay:` and its X25519 key, base64.
    pub fn set_push_token(self, user: String, device: String, token: String, env: String, time: i64) ! Error {
        _ = try self.db.execute(String("INSERT OR REPLACE INTO push_tokens (device, user, token, env, at) VALUES (?, ?, ?, ?, ?)"), [t(device), t(user), t(token), t(env), Value.Int(time)])
    }

    pub fn delete_push_token(self, device: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM push_tokens WHERE device = ?"), [t(device)])
    }

    // Forgets `device`'s token if it's still `token`, which APNs says is
    // gone; one the phone has handed over since stays.
    pub fn drop_push_token(self, device: String, token: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM push_tokens WHERE device = ? AND token = ?"), [t(device), t(token)])
    }

    // `user`'s devices that take push: each one's id, token and env.
    pub fn push_tokens(self, user: String) -> List<(String, String, String)> ! Error {
        var out = List<(String, String, String)>()
        for r in try self.db.query(String("SELECT device, token, env FROM push_tokens WHERE user = ? ORDER BY at"), [t(user)]) {
            out.push((text(r[0].copy()), text(r[1].copy()), text(r[2].copy())))
        }
        return out
    }

    // The APNs key loom signs push with, and what goes with it (the key's id,
    // the team and the app's bundle id), or none until the owner sets it up.
    // The key is kept sealed.
    pub fn apns(self) -> Json? ! Error {
        let kept = try self.meta(String("apns")) ?? String()
        if kept.len() == 0 { return none }
        return some(try parse(try self.unseal(kept, String("loom apns"))))
    }

    pub fn set_apns(self, config: Json) ! Error {
        try self.set_meta(String("apns"), self.seal("{config}", String("loom apns")))
    }

    // --- ACP agent programs ---

    pub fn set_acp_agent(self, name: String, command: String, args: List<String>) ! Error {
        var list = List<Json>()
        for a in args {
            list.push(Json.Str(a.copy()))
        }
        _ = try self.db.execute(String("INSERT INTO acp_agents (name, command, args) VALUES (?, ?, ?) ON CONFLICT (name) DO UPDATE SET command = excluded.command, args = excluded.args"), [t(name), t(command), t("{Json.Array(list)}")])
    }

    pub fn acp_agent(self, name: String) -> AcpAgent? ! Error {
        let row = try self.db.query_one(String("SELECT a.name, a.command, a.args, s.source, s.version, s.env FROM acp_agents a LEFT JOIN acp_settings s ON s.name = a.name WHERE a.name = ?"), [t(name)])
        let r = row else return none
        var args = List<String>()
        if let Json.Array(items) = try parse(text(r[2].copy())) {
            for a in items {
                args.push(a.as_str() ?? String())
            }
        }
        let env_text = try self.unseal(text(r[5].copy()), settings_aad(text(r[0].copy())))
        let env = if env_text.len() > 0 { try parse(env_text) } else { Obj.new().done() }
        return some(AcpAgent { name: text(r[0].copy()), command: text(r[1].copy()), args: args, source: text(r[3].copy()), version: text(r[4].copy()), env: env })
    }

    // Where an ACP agent came from (a registry id, or "" for one added by
    // hand), its version, and its settings: the environment variables loom
    // starts it with, as a JSON object. Keys are among them, so they're sealed.
    pub fn set_acp_settings(self, name: String, source: String, version: String, env: Json) ! Error {
        let sealed = self.seal("{env}", settings_aad(name.copy()))
        _ = try self.db.execute(String("INSERT INTO acp_settings (name, source, version, env) VALUES (?, ?, ?, ?) ON CONFLICT (name) DO UPDATE SET source = excluded.source, version = excluded.version, env = excluded.env"), [t(name), t(source), t(version), t(sealed)])
    }

    pub fn delete_acp_agent(self, name: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM acp_agents WHERE name = ?"), [t(name.copy())])
        _ = try self.db.execute(String("DELETE FROM acp_shares WHERE name = ?"), [t(name.copy())])
        _ = try self.db.execute(String("DELETE FROM acp_people WHERE name = ?"), [t(name.copy())])
        _ = try self.db.execute(String("DELETE FROM acp_settings WHERE name = ?"), [t(name)])
    }

    // Who an agent program is for: `kind` "use" is who may run agents on it,
    // and "keys" who gets the settings the owner shares. none is everyone.
    pub fn set_acp_people(self, name: String, kind: str, users: List<String>?) ! Error {
        let list = users else {
            _ = try self.db.execute(String("DELETE FROM acp_people WHERE name = ? AND kind = ?"), [t(name), t(String(kind))])
            return
        }
        var ids = List<Json>()
        for u in list {
            ids.push(Json.Str(u.copy()))
        }
        _ = try self.db.execute(String("INSERT INTO acp_people (name, kind, users) VALUES (?, ?, ?) ON CONFLICT (name, kind) DO UPDATE SET users = excluded.users"), [t(name), t(String(kind)), t("{Json.Array(ids)}")])
    }

    // Who an agent program is for, as set_acp_people keeps it: none is everyone.
    // People since removed are left out.
    pub fn acp_people(self, name: String, kind: str) -> List<String>? ! Error {
        let row = try self.db.query_one(String("SELECT users FROM acp_people WHERE name = ? AND kind = ?"), [t(name), t(String(kind))])
        let r = row else return none
        var out = List<String>()
        if let Json.Array(items) = try parse(text(r[0].copy())) {
            for u in items {
                let id = u.as_str() ?? String()
                if try self.role(id.copy()) != none { out.push(id) }
            }
        }
        return some(out)
    }

    // A person's role, "owner" or "member", or none for no such person.
    pub fn role(self, user: String) -> String? ! Error {
        let row = try self.db.query_one(String("SELECT role FROM users WHERE id = ?"), [t(user)])
        let r = row else return none
        return some(text(r[0].copy()))
    }

    // An agent program's settings shared with everyone but the owner: `tokens` a
    // person may use with them each `per` (day or month). `tokens` 0 stops it.
    pub fn set_share(self, name: String, tokens: i64, per: String) ! Error {
        if tokens <= 0 {
            _ = try self.db.execute(String("DELETE FROM acp_shares WHERE name = ?"), [t(name)])
            return
        }
        _ = try self.db.execute(String("INSERT INTO acp_shares (name, tokens, per) VALUES (?, ?, ?) ON CONFLICT (name) DO UPDATE SET tokens = excluded.tokens, per = excluded.per"), [t(name), Value.Int(tokens), t(per)])
    }

    pub fn share(self, name: String) -> (i64, String)? ! Error {
        let row = try self.db.query_one(String("SELECT tokens, per FROM acp_shares WHERE name = ?"), [t(name)])
        let r = row else return none
        return some((int(r[0].copy()), text(r[1].copy())))
    }

    // The tokens a turn used, as its agent program reported them, and whether on
    // settings the owner shared.
    pub fn add_usage(self, user: String, program: String, run: String, input: i64, output: i64, total: i64, shared: bool) ! Error {
        _ = try self.db.execute(String("INSERT INTO usage (user, program, run, input, output, total, shared, at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)"), [t(user), t(program), t(run), Value.Int(input), Value.Int(output), Value.Int(total), Value.Int(if shared { 1 } else { 0 }), Value.Int(now())])
    }

    // What an agent has, counted: its own `memories`, the person's `skills`
    // (every agent has them), the shared `tables` it owns, its `routines`, and
    // the `tokens_today` and `tokens_month` its runs used since `day` and
    // `month`.
    pub fn agent_counts(self, user: String, agent: String, day: i64, month: i64) -> Json ! Error {
        let used = "SELECT COALESCE(SUM(u.total), 0) FROM usage u JOIN runs r ON r.id = u.run JOIN conversations c ON c.id = r.conversation WHERE u.user = ? AND c.agent = ? AND u.at >= ?"
        let memories = try self.count("SELECT COUNT(*) FROM memories WHERE user = ? AND agent = ?", [t(user.copy()), t(agent.copy())])
        let skills = try self.count("SELECT COUNT(*) FROM skills WHERE user = ?", [t(user.copy())])
        let tables = try self.count("SELECT COUNT(*) FROM shared_tables WHERE user = ? AND owner = ?", [t(user.copy()), t(agent.copy())])
        let routines = try self.count("SELECT COUNT(*) FROM routines WHERE user = ? AND json_extract(json, '$.agent') = ?", [t(user.copy()), t(agent.copy())])
        let today = try self.count(used, [t(user.copy()), t(agent.copy()), Value.Int(day)])
        let this_month = try self.count(used, [t(user), t(agent), Value.Int(month)])
        return Obj.new().i("memories", memories).i("skills", skills).i("tables", tables).i("routines", routines).i("tokens_today", today).i("tokens_month", this_month).done()
    }

    // The one number a query gives.
    fn count(self, sql: str, args: List<Value>) -> i64 ! Error {
        let row = try self.db.query_one(String(sql), args)
        let r = row else return 0
        return int(r[0].copy())
    }

    // The tokens `user` used on `program`'s shared settings since `since`.
    pub fn shared_used(self, user: String, program: String, since: i64) -> i64 ! Error {
        let row = try self.db.query_one(String("SELECT COALESCE(SUM(total), 0) FROM usage WHERE user = ? AND program = ? AND shared = 1 AND at >= ?"), [t(user), t(program), Value.Int(since)])
        let r = row else return 0
        return int(r[0].copy())
    }

    pub fn acp_agents(self) -> List<AcpAgent> ! Error {
        var out = List<AcpAgent>()
        for r in try self.db.query(String("SELECT name FROM acp_agents ORDER BY name")) {
            if let a = try self.acp_agent(text(r[0].copy())) {
                out.push(a)
            }
        }
        return out
    }

    // --- Agents, conversations and messages, each as the JSON the protocol sends ---

    // Stores an agent, and keeps this revision of it, made `by` a device or
    // an agent, for rolling back to.
    pub fn put_agent(self, user: String, agent: Json, by: String) ! Error {
        let id = (agent.get(String("id")) ?? Json.Null).as_str() ?? String()
        let revision = (agent.get(String("revision")) ?? Json.Null).as_i64() ?? 0
        _ = try self.db.execute(String("INSERT INTO agents (id, user, json) VALUES (?, ?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json"), [t(id.copy()), t(user.copy()), t("{agent}")])
        _ = try self.db.execute(String("INSERT INTO agent_revisions (agent, user, revision, json, by, at) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT (agent, revision) DO UPDATE SET json = excluded.json, by = excluded.by, at = excluded.at"), [t(id), t(user), Value.Int(revision), t("{agent}"), t(by), Value.Int(now())])
    }

    // Stores an agent without a revision of it: for what loom learns about
    // it, such as the options its program offers, rather than a change made.
    pub fn put_agent_json(self, user: String, agent: Json) ! Error {
        let id = (agent.get(String("id")) ?? Json.Null).as_str() ?? String()
        _ = try self.db.execute(String("UPDATE agents SET json = ? WHERE id = ? AND user = ?"), [t("{agent}"), t(id), t(user)])
    }

    // An agent's revisions, newest first: `revision`, `by`, `at`, and the
    // agent as it was.
    pub fn agent_revisions(self, user: String, id: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT revision, by, at, json FROM agent_revisions WHERE agent = ? AND user = ? ORDER BY revision DESC"), [t(id), t(user)]) {
            out.push(Obj.new().i("revision", int(r[0].copy())).s("by", text(r[1].copy())).i("at", int(r[2].copy())).j("agent", try parse(text(r[3].copy()))).done())
        }
        return out
    }

    pub fn agent(self, user: String, id: String) -> Json? ! Error {
        let row = try self.db.query_one(String("SELECT json FROM agents WHERE id = ? AND user = ? AND deleted = 0"), [t(id), t(user)])
        let r = row else return none
        return some(try parse(text(r[0].copy())))
    }

    pub fn agents(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM agents WHERE user = ? AND deleted = 0 ORDER BY rowid"), [t(user)]) {
            out.push(try parse(text(r[0].copy())))
        }
        return out
    }

    // `user`'s agents on `program` whose options aren't `options` (JSON text),
    // found without reading every agent: what a new session's options change.
    pub fn agents_to_tell(self, user: String, program: String, options: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM agents WHERE user = ? AND deleted = 0 AND json_extract(json, '$.acp_agent') = ? AND json_extract(json, '$.options') IS NOT json(?) ORDER BY rowid"), [t(user), t(program), t(options)]) {
            out.push(try parse(text(r[0].copy())))
        }
        return out
    }

    pub fn delete_agent(self, user: String, id: String) ! Error {
        _ = try self.db.execute(String("UPDATE agents SET deleted = 1 WHERE id = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        // Its own rules go with it.
        _ = try self.db.execute(String("DELETE FROM rules WHERE agent = ? AND user = ?"), [t(id), t(user)])
    }

    pub fn add_conversation(self, user: String, agent: String, title: String) -> Json ! Error {
        return try self.add_conversation_at(user, agent, title, now())
    }

    // A conversation made at `at`, such as one brought over from another app.
    pub fn add_conversation_at(self, user: String, agent: String, title: String, at: i64) -> Json ! Error {
        let id = try self.new_id("c")
        _ = try self.db.execute(String("INSERT INTO conversations (id, user, agent, title, at) VALUES (?, ?, ?, ?, ?)"), [t(id.copy()), t(user), t(agent.copy()), t(title.copy()), Value.Int(at)])
        return Obj.new().s("id", id).s("agent", agent).s("title", title).i("at", at).done()
    }

    pub fn conversation(self, user: String, id: String) -> Json? ! Error {
        let row = try self.db.query_one(String("SELECT c.id, c.agent, c.title, c.at, k.id, s.agent, b.from_conversation, b.from_message, rt.routine, cp.program, ak.by, rm.json FROM conversations c LEFT JOIN tasks k ON k.conversation = c.id LEFT JOIN sides s ON s.conversation = c.id LEFT JOIN branches b ON b.conversation = c.id LEFT JOIN routine_threads rt ON rt.conversation = c.id LEFT JOIN conversation_programs cp ON cp.conversation = c.id LEFT JOIN asks ak ON ak.conversation = c.id LEFT JOIN rooms rm ON rm.conversation = c.id WHERE c.id = ? AND c.user = ? AND c.deleted = 0"), [t(id), t(user)])
        let r = row else return none
        return some(conversation_of(r))
    }

    // `agent`'s conversation with the newest message, as the apps show its
    // chat. A task's conversation is the task's, not the chat, and another
    // agent's thread with it (`asks`) is that agent's.
    pub fn newest_conversation(self, user: String, agent: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT c.id, c.agent, c.title, c.at, NULL, NULL, NULL, NULL, NULL, (SELECT program FROM conversation_programs WHERE conversation = c.id), NULL, NULL FROM conversations c WHERE c.user = ? AND c.agent = ? AND c.deleted = 0 AND c.id NOT IN (SELECT conversation FROM tasks) AND c.id NOT IN (SELECT conversation FROM sides) AND c.id NOT IN (SELECT conversation FROM branches) AND c.id NOT IN (SELECT conversation FROM routine_threads) AND c.id NOT IN (SELECT conversation FROM asks) ORDER BY coalesce((SELECT max(m.at) FROM messages m WHERE m.user = c.user AND m.conversation = c.id), c.at) DESC, c.rowid DESC LIMIT 1"), [t(user), t(agent)]) else return none
        return some(conversation_of(r))
    }

    // The conversation of `user`'s newest turn that wasn't a routine's or another agent's ask: the
    // chat they last wrote in, most likely.
    pub fn last_chat(self, user: String) -> Json? ! Error {
        let row = try self.db.query_one(String("SELECT r.conversation FROM runs r JOIN conversations c ON c.id = r.conversation WHERE r.user = ? AND r.routine = '' AND c.deleted = 0 AND r.conversation NOT IN (SELECT conversation FROM asks) ORDER BY r.rowid DESC LIMIT 1"), [t(user.copy())])
        let r = row else return none
        return try self.conversation(user, text(r[0].copy()))
    }

    pub fn conversations(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT c.id, c.agent, c.title, c.at, k.id, s.agent, b.from_conversation, b.from_message, rt.routine, cp.program, ak.by, rm.json FROM conversations c LEFT JOIN tasks k ON k.conversation = c.id LEFT JOIN sides s ON s.conversation = c.id LEFT JOIN branches b ON b.conversation = c.id LEFT JOIN routine_threads rt ON rt.conversation = c.id LEFT JOIN conversation_programs cp ON cp.conversation = c.id LEFT JOIN asks ak ON ak.conversation = c.id LEFT JOIN rooms rm ON rm.conversation = c.id WHERE c.user = ? AND c.deleted = 0 ORDER BY c.at"), [t(user)]) {
            out.push(conversation_of(r))
        }
        return out
    }

    pub fn rename_conversation(self, user: String, id: String, title: String) ! Error {
        _ = try self.db.execute(String("UPDATE conversations SET title = ? WHERE id = ? AND user = ?"), [t(title), t(id), t(user)])
    }

    pub fn delete_conversation(self, user: String, id: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM queue WHERE conversation = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        _ = try self.db.execute(String("DELETE FROM tasks WHERE conversation = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        _ = try self.db.execute(String("DELETE FROM sides WHERE conversation = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        _ = try self.db.execute(String("DELETE FROM branches WHERE conversation = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        _ = try self.db.execute(String("DELETE FROM routine_threads WHERE conversation = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        _ = try self.db.execute(String("DELETE FROM asks WHERE conversation = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        _ = try self.db.execute(String("DELETE FROM conversation_programs WHERE conversation = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        _ = try self.db.execute(String("DELETE FROM rooms WHERE conversation = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        _ = try self.db.execute(String("UPDATE conversations SET deleted = 1 WHERE id = ? AND user = ?"), [t(id), t(user)])
    }

    // --- Group chats (PLAN.md, "Group chats") ---

    // Keeps `conversation`'s room as `room`; Everyone is marked `everyone`.
    pub fn put_room(self, user: String, conversation: String, room: Json) ! Error {
        let everyone: i64 = if (room.get(String("everyone")) ?? Json.Null).as_bool() ?? false { 1 } else { 0 }
        _ = try self.db.execute(String("INSERT INTO rooms (conversation, user, json, everyone) VALUES (?, ?, ?, ?) ON CONFLICT (conversation) DO UPDATE SET json = excluded.json"), [t(conversation), t(user), t("{room}"), Value.Int(everyone)])
    }

    // The conversation of `user`'s Everyone chat, if they have one.
    pub fn everyone_room(self, user: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT rm.conversation FROM rooms rm JOIN conversations c ON c.id = rm.conversation WHERE rm.user = ? AND rm.everyone = 1 AND c.deleted = 0 ORDER BY c.rowid LIMIT 1"), [t(user)]) else return none
        return some(text(r[0].copy()))
    }

    // `user`'s group chats, as (conversation, room), oldest first.
    pub fn rooms(self, user: String) -> List<(String, Json)> ! Error {
        var out = List<(String, Json)>()
        for r in try self.db.query(String("SELECT rm.conversation, rm.json FROM rooms rm JOIN conversations c ON c.id = rm.conversation WHERE rm.user = ? AND c.deleted = 0 ORDER BY c.rowid"), [t(user)]) {
            out.push((text(r[0].copy()), try parse(text(r[1].copy()))))
        }
        return out
    }

    // The newest agent reply in `conversation`: its agent, or "".
    pub fn last_answered(self, user: String, conversation: String) -> String ! Error {
        let r = try self.db.query_one(String("SELECT json_extract(json, '$.agent') FROM messages WHERE user = ? AND conversation = ? AND json_extract(json, '$.role') = 'agent' ORDER BY rowid DESC LIMIT 1"), [t(user), t(conversation)]) else return String()
        return text(r[0].copy())
    }

    // --- Routine threads (PLAN.md, "Routines say when there's nothing to say") ---

    // Marks `conversation` as routine `routine`'s thread of its own, which is
    // never its agent's chat.
    pub fn mark_routine_thread(self, user: String, conversation: String, routine: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO routine_threads (conversation, user, routine) VALUES (?, ?, ?)"), [t(conversation), t(user), t(routine)])
    }

    // Routine `routine`'s thread, the newest if it has had more than one.
    pub fn routine_thread(self, user: String, routine: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT rt.conversation FROM routine_threads rt JOIN conversations c ON c.id = rt.conversation WHERE rt.user = ? AND rt.routine = ? AND c.deleted = 0 ORDER BY c.rowid DESC LIMIT 1"), [t(user), t(routine)]) else return none
        return some(text(r[0].copy()))
    }

    // --- Agents' threads with agents (PLAN.md, "Agents talk to each other") ---

    // Marks `conversation` as the one `by` (an agent's id, or plugin:ID for a
    // plugin's panel) keeps with its agent, which is never that agent's chat.
    pub fn mark_ask(self, user: String, conversation: String, by: String) ! Error {
        _ = try self.db.execute(String("INSERT OR IGNORE INTO asks (conversation, user, by) VALUES (?, ?, ?)"), [t(conversation), t(user), t(by)])
    }

    // The conversations message_agent and plugin panels kept before they were
    // marked, as `talk:USER:BY:TO` (or `talk:USER:plugin:ID:TO`) in meta: each
    // is marked now, and given as (user, conversation, by), for the devices
    // to hear of.
    pub fn mark_old_asks(self) -> List<(String, String, String)> ! Error {
        var out = List<(String, String, String)>()
        for r in try self.db.query(String("SELECT key, value FROM meta WHERE key LIKE 'talk:%' AND value NOT IN (SELECT conversation FROM asks)")) {
            let parts = text(r[0].copy()).split(":")
            if parts.len() < 4 { continue }
            let user = parts[1].copy()
            let by = if parts[2] == "plugin" and parts.len() >= 5 { "plugin:{parts[3]}" } else { parts[2].copy() }
            let conversation = text(r[1].copy())
            if try self.db.query_one(String("SELECT id FROM conversations WHERE id = ? AND user = ? AND deleted = 0"), [t(conversation.copy()), t(user.copy())]) == none { continue }
            try self.mark_ask(user.copy(), conversation.copy(), by.copy())
            out.push((user, conversation, by))
        }
        return out
    }

    // --- Branches (PLAN.md, "Branching a chat") ---

    pub fn add_branch(self, user: String, conversation: String, from_conversation: String, from_message: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO branches (conversation, user, from_conversation, from_message) VALUES (?, ?, ?, ?)"), [t(conversation), t(user), t(from_conversation), t(from_message)])
    }

    // The chat and the message a branch starts from, while its agent hasn't been
    // handed what came before; and from then on, none.
    pub fn branch_to_hand(self, user: String, conversation: String) -> (String, String)? ! Error {
        let r = try self.db.query_one(String("SELECT from_conversation, from_message FROM branches WHERE conversation = ? AND user = ? AND handed = 0"), [t(conversation), t(user)]) else return none
        return some((text(r[0].copy()), text(r[1].copy())))
    }

    pub fn branch_handed(self, conversation: String) ! Error {
        _ = try self.db.execute(String("UPDATE branches SET handed = 1 WHERE conversation = ?"), [t(conversation)])
    }

    // --- Moved chats (PLAN.md, "A backup brain") ---

    // Puts `conversation` on the agent program `program`, in place of its
    // agent's. With `from`, the program it was on, its next turn starts with
    // loom's summary of it; with "", it doesn't.
    pub fn set_conversation_program(self, user: String, conversation: String, program: String, from: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO conversation_programs (conversation, user, program, summary_from) VALUES (?, ?, ?, ?) ON CONFLICT (conversation) DO UPDATE SET program = excluded.program, summary_from = excluded.summary_from"), [t(conversation), t(user), t(program), t(from)])
    }

    // The program `conversation` was moved to, if it was.
    pub fn conversation_program(self, user: String, conversation: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT program FROM conversation_programs WHERE conversation = ? AND user = ?"), [t(conversation), t(user)]) else return none
        return some(text(r[0].copy()))
    }

    // The program `conversation` moved from by hand, while its next turn is to
    // start with loom's summary of it; none once it has.
    pub fn summary_to_hand(self, user: String, conversation: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT summary_from FROM conversation_programs WHERE conversation = ? AND user = ? AND summary_from != ''"), [t(conversation), t(user)]) else return none
        return some(text(r[0].copy()))
    }

    pub fn summary_handed(self, conversation: String) ! Error {
        _ = try self.db.execute(String("UPDATE conversation_programs SET summary_from = '' WHERE conversation = ?"), [t(conversation)])
    }

    // --- Scripts (PLAN.md, "Scripts") ---

    // A person's script token, kept as its SHA-256: a new one replaces the last.
    pub fn set_script_token(self, user: String, hash: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO script_tokens (user, hash, at) VALUES (?, ?, ?) ON CONFLICT (user) DO UPDATE SET hash = excluded.hash, at = excluded.at"), [t(user), t(hash), Value.Int(now())])
    }

    pub fn drop_script_token(self, user: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM script_tokens WHERE user = ?"), [t(user)])
    }

    // When the person's scripts were turned on, or none while they're off.
    pub fn scripts_since(self, user: String) -> i64? ! Error {
        let r = try self.db.query_one(String("SELECT at FROM script_tokens WHERE user = ?"), [t(user)]) else return none
        return some(int(r[0].copy()))
    }

    // Whose script token has this SHA-256.
    pub fn script_token_user(self, hash: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT user FROM script_tokens WHERE hash = ?"), [t(hash)]) else return none
        return some(text(r[0].copy()))
    }

    // A person's status token, kept as its SHA-256: it only reads their status
    // (GET /api/scripts/status), and a new one replaces the last. One an agent
    // had saved to a file keeps the file's `path` and the agent's name, `agent`;
    // one made in the app has both empty.
    pub fn set_status_token(self, user: String, hash: String, path: String, agent: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO status_tokens (user, hash, at, path, agent) VALUES (?, ?, ?, ?, ?) ON CONFLICT (user) DO UPDATE SET hash = excluded.hash, at = excluded.at, path = excluded.path, agent = excluded.agent"), [t(user), t(hash), Value.Int(now()), t(path), t(agent)])
    }

    // Where the person's status token was saved and by which agent, empty for
    // one made in the app, or none while there's none.
    pub fn status_saved(self, user: String) -> (String, String)? ! Error {
        let r = try self.db.query_one(String("SELECT path, agent FROM status_tokens WHERE user = ?"), [t(user)]) else return none
        return some((text(r[0].copy()), text(r[1].copy())))
    }

    pub fn drop_status_token(self, user: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM status_tokens WHERE user = ?"), [t(user)])
    }

    // When the person's status token was made, or none while there's none.
    pub fn status_since(self, user: String) -> i64? ! Error {
        let r = try self.db.query_one(String("SELECT at FROM status_tokens WHERE user = ?"), [t(user)]) else return none
        return some(int(r[0].copy()))
    }

    // Whose status token has this SHA-256.
    pub fn status_token_user(self, hash: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT user FROM status_tokens WHERE hash = ?"), [t(hash)]) else return none
        return some(text(r[0].copy()))
    }

    // `user`'s routine runs that started at or after `since` (Unix ms), oldest
    // first, at most `most` of the newest: when, how it went (as the routine
    // says once it ended, else the run's status), and the routine's id.
    pub fn routine_runs_since(self, user: String, since: i64, most: i64) -> List<(i64, String, String)> ! Error {
        var out = List<(i64, String, String)>()
        for r in try self.db.query(String("SELECT at, status, routine FROM (SELECT at, CASE WHEN outcome != '' THEN outcome ELSE status END AS status, routine, rowid AS n FROM runs WHERE user = ? AND routine != '' AND at >= ? ORDER BY at DESC, rowid DESC LIMIT ?) ORDER BY at, n"), [t(user), Value.Int(since), Value.Int(most)]) {
            out.push((int(r[0].copy()), text(r[1].copy()), text(r[2].copy())))
        }
        return out
    }

    // A script token that one script makes for itself from the data folder, as
    // `loom import` does: for `user`, taken only for `scope` (a script route's
    // name), until `expires` (Unix ms). Those past their time go.
    pub fn add_script_grant(self, hash: String, user: String, scope: str, expires: i64) ! Error {
        _ = try self.db.execute(String("DELETE FROM script_grants WHERE expires <= ?"), [Value.Int(now())])
        _ = try self.db.execute(String("INSERT INTO script_grants (hash, user, scope, expires) VALUES (?, ?, ?, ?)"), [t(hash), t(user), t(String(scope)), Value.Int(expires)])
    }

    // Whose grant has this SHA-256, what it's for, and when it ends.
    pub fn script_grant(self, hash: String) -> (String, String, i64)? ! Error {
        let r = try self.db.query_one(String("SELECT user, scope, expires FROM script_grants WHERE hash = ?"), [t(hash)]) else return none
        return some((text(r[0].copy()), text(r[1].copy()), int(r[2].copy())))
    }

    pub fn drop_script_grant(self, hash: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM script_grants WHERE hash = ?"), [t(hash)])
    }

    // --- Imports (PLAN.md, "Importing from OpenBot and Grok Bot") ---

    // What the thing another app calls `id`, of `kind` (agent, message, ...),
    // became in loom when it was brought over from `source`, if it was.
    pub fn imported(self, user: String, source: String, kind: str, id: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT loom FROM imported WHERE user = ? AND source = ? AND kind = ? AND id = ?"), [t(user), t(source), t(String(kind)), t(id)]) else return none
        return some(text(r[0].copy()))
    }

    // What came from imports of `kind`: each one's source, its id there, and
    // what it is in loom.
    pub fn imported_of(self, user: String, kind: str) -> List<(String, String, String)> ! Error {
        var out = List<(String, String, String)>()
        for r in try self.db.query(String("SELECT source, id, loom FROM imported WHERE user = ? AND kind = ? ORDER BY at"), [t(user), t(String(kind))]) {
            out.push((text(r[0].copy()), text(r[1].copy()), text(r[2].copy())))
        }
        return out
    }

    pub fn mark_imported(self, user: String, source: String, kind: str, id: String, loom: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO imported (user, source, kind, id, loom, at) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT (user, source, kind, id) DO UPDATE SET loom = excluded.loom"), [t(user), t(source), t(String(kind)), t(id), t(loom), Value.Int(now())])
    }

    // --- Shared tables (PLAN.md, "Shared tables") ---

    // The person's tables: name, description, owner (an agent's id, or empty
    // for the person), at, and how many rows each has.
    pub fn shared_tables(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT t.name, t.description, t.owner, t.at, (SELECT count(*) FROM shared_rows r WHERE r.user = t.user AND r.tbl = t.name) FROM shared_tables t WHERE t.user = ? ORDER BY t.name"), [t(user)]) {
            out.push(Obj.new().s("name", text(r[0].copy())).s("description", text(r[1].copy())).s("owner", text(r[2].copy())).i("at", int(r[3].copy())).i("rows", int(r[4].copy())).done())
        }
        return out
    }

    pub fn shared_table(self, user: String, name: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT t.name, t.description, t.owner, t.at, (SELECT count(*) FROM shared_rows r WHERE r.user = t.user AND r.tbl = t.name) FROM shared_tables t WHERE t.user = ? AND t.name = ?"), [t(user), t(name)]) else return none
        return some(Obj.new().s("name", text(r[0].copy())).s("description", text(r[1].copy())).s("owner", text(r[2].copy())).i("at", int(r[3].copy())).i("rows", int(r[4].copy())).done())
    }

    pub fn add_shared_table(self, user: String, name: String, description: String, owner: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO shared_tables (user, name, description, owner, at) VALUES (?, ?, ?, ?, ?)"), [t(user), t(name), t(description), t(owner), Value.Int(now())])
    }

    pub fn drop_shared_table(self, user: String, name: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM shared_rows WHERE user = ? AND tbl = ?"), [t(user.copy()), t(name.copy())])
        _ = try self.db.execute(String("DELETE FROM shared_tables WHERE user = ? AND name = ?"), [t(user), t(name)])
    }

    // How many rows the person's tables hold in all.
    pub fn shared_row_count(self, user: String) -> i64 ! Error {
        let r = try self.db.query_one(String("SELECT count(*) FROM shared_rows WHERE user = ?"), [t(user)]) else return 0
        return int(r[0].copy())
    }

    // A row of `tbl`: id, by (an agent's id, or empty for the person), at,
    // updated, and its data.
    pub fn shared_row(self, user: String, tbl: String, id: i64) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT id, data, by, at, updated FROM shared_rows WHERE user = ? AND tbl = ? AND id = ?"), [t(user), t(tbl), Value.Int(id)]) else return none
        return some(row_of(r))
    }

    pub fn add_shared_row(self, user: String, tbl: String, data: String, by: String) -> i64 ! Error {
        let at = now()
        _ = try self.db.execute(String("INSERT INTO shared_rows (user, tbl, data, by, at, updated) VALUES (?, ?, ?, ?, ?, ?)"), [t(user), t(tbl), t(data), t(by), Value.Int(at), Value.Int(at)])
        let r = try self.db.query_one(String("SELECT last_insert_rowid()"), List<Value>()) else return 0
        return int(r[0].copy())
    }

    pub fn put_shared_row(self, user: String, id: i64, data: String, by: String) ! Error {
        _ = try self.db.execute(String("UPDATE shared_rows SET data = ?, by = ?, updated = ? WHERE user = ? AND id = ?"), [t(data), t(by), Value.Int(now()), t(user), Value.Int(id)])
    }

    pub fn delete_shared_row(self, user: String, id: i64) ! Error {
        _ = try self.db.execute(String("DELETE FROM shared_rows WHERE user = ? AND id = ?"), [t(user), Value.Int(id)])
    }

    // Rows of `tbl` whose fields equal what `filters` says, in the order of
    // the field `order` (or their ids, for "id"), `limit` of them from `offset`.
    pub fn shared_rows(self, user: String, tbl: String, filters: List<(String, Json)>, order: String, desc: bool, limit: i64, offset: i64) -> List<Json> ! Error {
        var sql = String("SELECT id, data, by, at, updated FROM shared_rows WHERE user = ? AND tbl = ?")
        var params: List<Value> = [t(user), t(tbl)]
        for (name, value) in filters {
            let path = "$.{name}"
            match value {
                Json.Null => {
                    sql.push_str(" AND json_extract(data, ?) IS NULL")
                    params.push(t(path))
                },
                Json.Bool(b) => {
                    sql.push_str(" AND json_extract(data, ?) = ?")
                    params.push(t(path))
                    params.push(Value.Int(if b { 1 } else { 0 }))
                },
                Json.Int(n) => {
                    sql.push_str(" AND json_extract(data, ?) = ?")
                    params.push(t(path))
                    params.push(Value.Int(n))
                },
                Json.Float(f) => {
                    sql.push_str(" AND json_extract(data, ?) = ?")
                    params.push(t(path))
                    params.push(Value.Real(f))
                },
                Json.Str(s) => {
                    sql.push_str(" AND json_extract(data, ?) = ?")
                    params.push(t(path))
                    params.push(t(s.copy()))
                },
                _ => {},
            }
        }
        let dir = if desc { " DESC" } else { "" }
        if order == "id" {
            sql.push_str(" ORDER BY id{dir}")
        } else {
            sql.push_str(" ORDER BY json_extract(data, ?){dir}, id{dir}")
            params.push(t("$.{order}"))
        }
        sql.push_str(" LIMIT ? OFFSET ?")
        params.push(Value.Int(limit))
        params.push(Value.Int(offset))
        var out = List<Json>()
        for r in try self.db.query(sql, params) { out.push(row_of(r)) }
        return out
    }

    // --- Side questions (PLAN.md, "Side questions") ---

    // The conversation where `agent` answers side questions, if it has one yet.
    pub fn side_conversation(self, user: String, agent: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT s.conversation FROM sides s JOIN conversations c ON c.id = s.conversation WHERE s.user = ? AND s.agent = ? AND c.deleted = 0"), [t(user), t(agent)]) else return none
        return some(text(r[0].copy()))
    }

    pub fn put_side(self, user: String, agent: String, conversation: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO sides (user, agent, conversation) VALUES (?, ?, ?) ON CONFLICT (user, agent) DO UPDATE SET conversation = excluded.conversation"), [t(user), t(agent), t(conversation)])
    }

    // --- Tasks (PLAN.md, "Work that waits its turn") ---

    // Keeps a task as it is now: its `id`, `agent`, `conversation` and `status`, and the rest.
    pub fn put_task(self, user: String, task: Json) ! Error {
        _ = try self.db.execute(String("INSERT INTO tasks (id, user, agent, conversation, status, json, at) VALUES (?, ?, ?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET status = excluded.status, json = excluded.json"), [t(field(task.copy(), "id")), t(user), t(field(task.copy(), "agent")), t(field(task.copy(), "conversation")), t(field(task.copy(), "status")), t("{task}"), Value.Int(now())])
    }

    pub fn task(self, user: String, id: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT json FROM tasks WHERE id = ? AND user = ?"), [t(id), t(user)]) else return none
        let ok(j) = parse(text(r[0].copy())) else return none
        return some(j)
    }

    // The task a conversation is, if it's one.
    pub fn task_in(self, user: String, conversation: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT json FROM tasks WHERE conversation = ? AND user = ?"), [t(conversation), t(user)]) else return none
        let ok(j) = parse(text(r[0].copy())) else return none
        return some(j)
    }

    // Up to `limit` of a person's tasks, newest first, after the task `before` if it's
    // given, but not those of agents that were deleted, and whether there are older ones.
    pub fn tasks(self, user: String, before: String?, limit: usize) -> (List<Json>, bool) ! Error {
        var out = List<Json>()
        let cut = if let b = before { Value.Text(b.copy()) } else { Value.Null }
        let rows = try self.db.query(String("SELECT k.json FROM tasks k JOIN agents a ON a.id = k.agent AND a.deleted = 0 WHERE k.user = ?1 AND (?2 IS NULL OR (k.at, k.rowid) < (SELECT at, rowid FROM tasks WHERE id = ?2 AND user = ?1)) ORDER BY k.at DESC, k.rowid DESC LIMIT ?3"), [t(user), cut, Value.Int(i64.wrap(u64(limit + 1)))])
        let more = rows.len() > limit
        var n: usize = 0
        for r in rows {
            if n == limit { break }
            n += 1
            if let ok(j) = parse(text(r[0].copy())) { out.push(j) }
        }
        return (out, more)
    }

    // How many of `agent`'s tasks are running.
    pub fn tasks_running(self, user: String, agent: String) -> i64 ! Error {
        let row = try self.db.query_one(String("SELECT count(*) FROM tasks WHERE user = ? AND agent = ? AND status = 'running'"), [t(user), t(agent)])
        return int((row ?? List<Value>())[0].copy())
    }

    // Every task that was running, as (user, task), for after a restart.
    pub fn running_tasks(self) -> List<(String, Json)> ! Error {
        var out = List<(String, Json)>()
        for r in try self.db.query(String("SELECT k.user, k.json FROM tasks k JOIN agents a ON a.id = k.agent AND a.deleted = 0 WHERE k.status = 'running' ORDER BY k.at")) {
            if let ok(j) = parse(text(r[1].copy())) { out.push((text(r[0].copy()), j)) }
        }
        return out
    }

    // --- The queue (PLAN.md, "Work that waits its turn") ---

    // What waits in a conversation for its agent to finish, first first: each
    // the item as put, with its `id`, `text`, `files`, `from` and `at`.
    pub fn queued(self, user: String, conversation: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM queue WHERE user = ? AND conversation = ? ORDER BY pos"), [t(user), t(conversation)]) {
            if let ok(j) = parse(text(r[0].copy())) { out.push(j) }
        }
        return out
    }

    // Puts an item at the end of a conversation's queue, or first. One that's
    // there already keeps its place, unless it goes first.
    pub fn put_queued(self, user: String, conversation: String, item: Json, first: bool) ! Error {
        let id = (item.get(String("id")) ?? Json.Null).as_str() ?? String()
        if not first and try self.db.query_one(String("SELECT pos FROM queue WHERE user = ? AND id = ?"), [t(user.copy()), t(id.copy())]) != none {
            _ = try self.db.execute(String("UPDATE queue SET json = ? WHERE user = ? AND id = ?"), [t("{item}"), t(user), t(id)])
            return
        }
        let edge = try self.db.query_one(String(if first { "SELECT COALESCE(MIN(pos), 0) - 1 FROM queue WHERE user = ? AND conversation = ?" } else { "SELECT COALESCE(MAX(pos), 0) + 1 FROM queue WHERE user = ? AND conversation = ?" }), [t(user.copy()), t(conversation.copy())])
        let pos = if let r = edge { int(r[0].copy()) } else { 0 }
        _ = try self.db.execute(String("INSERT INTO queue (id, user, conversation, pos, json) VALUES (?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET pos = excluded.pos, json = excluded.json"), [t(id), t(user), t(conversation), Value.Int(pos), t("{item}")])
    }

    // One queued item, and the conversation it waits in.
    pub fn queued_item(self, user: String, id: String) -> (String, Json)? ! Error {
        let row = try self.db.query_one(String("SELECT conversation, json FROM queue WHERE user = ? AND id = ?"), [t(user), t(id)]) else return none
        let ok(item) = parse(text(row[1].copy())) else return none
        return some((text(row[0].copy()), item))
    }

    pub fn drop_queued(self, user: String, id: String) -> bool ! Error {
        return try self.db.execute(String("DELETE FROM queue WHERE user = ? AND id = ?"), [t(user), t(id)]) > 0
    }

    // Puts a conversation's queue in the order of `ids`, the ones it names
    // first and the rest after, as they were.
    pub fn order_queued(self, user: String, conversation: String, ids: List<String>) ! Error {
        var order = ids.copy()
        for item in try self.queued(user.copy(), conversation.copy()) {
            let id = (item.get(String("id")) ?? Json.Null).as_str() ?? String()
            if not order.contains(id.copy()) { order.push(id) }
        }
        let began = try self.begin()
        for (k, id) in order.enumerate() {
            match self.db.execute(String("UPDATE queue SET pos = ? WHERE user = ? AND conversation = ? AND id = ?"), [Value.Int(i64.wrap(u64(k))), t(user.copy()), t(conversation.copy()), t(id.copy())]) {
                ok(_) => {},
                err(e) => {
                    self.rollback(began)
                    fail e
                },
            }
        }
        try self.commit(began)
    }

    pub fn put_message(self, user: String, message: Json) ! Error {
        let id = (message.get(String("id")) ?? Json.Null).as_str() ?? String()
        let conversation = (message.get(String("conversation")) ?? Json.Null).as_str() ?? String()
        let at = (message.get(String("at")) ?? Json.Null).as_i64() ?? now()
        _ = try self.db.execute(String("INSERT INTO messages (id, user, conversation, json, at) VALUES (?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json"), [t(id), t(user.copy()), t(conversation), t("{message}"), Value.Int(at)])
        try self.index_message(user, message)
    }

    // Puts a message's words in the search index: its text, and its files' names.
    // A message's row there has the message's rowid, so storing it again replaces it.

    fn index_message(self, user: String, message: Json) ! Error {
        let id = (message.get(String("id")) ?? Json.Null).as_str() ?? String()
        let row = try self.db.query_one(String("SELECT rowid, conversation, at FROM messages WHERE id = ?"), [t(id)]) else return
        var agent = (message.get(String("agent")) ?? Json.Null).as_str() ?? String()
        if agent.len() == 0 {
            if let c = try self.db.query_one(String("SELECT agent FROM conversations WHERE id = ?"), [row[1].copy()]) {
                agent = text(c[0].copy())
            }
        }
        var words = String()
        if let Json.Array(blocks) = message.get(String("blocks")) ?? Json.Null {
            for b in blocks {
                let kind = (b.get(String("kind")) ?? Json.Null).as_str() ?? String()
                let piece = if kind == "text" { (b.get(String("text")) ?? Json.Null).as_str() } else if kind == "file" { (b.get(String("name")) ?? Json.Null).as_str() } else { none }
                if let p = piece {
                    if words.len() > 0 { words.push_str("\n") }
                    words.push_str(p)
                }
            }
        }
        _ = try self.db.execute(String("DELETE FROM messages_fts WHERE rowid = ?"), [row[0].copy()])
        if words.len() > 0 {
            _ = try self.db.execute(String("INSERT INTO messages_fts (rowid, text, user, agent, at) VALUES (?, ?, ?, ?, ?)"), [row[0].copy(), t(words), t(user), t(agent), row[2].copy()])
        }
    }

    // `user`'s messages that have every word of `query`, the last one as a prefix, best
    // first: each message, and the words around the match with each matched word
    // between MARK_START and MARK_END. Only in conversations that aren't deleted; with
    // `agent`, only that agent's; with `after` or `before`, only from that time on, or
    // before it (Unix ms).
    pub fn search(self, user: String, query: String, agent: String?, after: i64?, before: i64?, limit: usize) -> List<(Json, String)> ! Error {
        return try search_in(self.db, user, query, agent, after, before, limit)
    }

    // `messages.search`'s answer for `args` (protocol/protocol.md).
    pub fn search_answer(self, user: String, args: Json) -> Json ! Error {
        return try search_answer_in(self.db, user, args)
    }

    // --- Skills (PLAN.md, "Agents") ---

    // Adds or replaces `user`'s skill `name`.
    pub fn put_skill(self, user: String, name: String, description: String, body: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO skills (user, name, description, body, at) VALUES (?, ?, ?, ?, ?) ON CONFLICT (user, name) DO UPDATE SET description = excluded.description, body = excluded.body, at = excluded.at"), [t(user), t(name), t(description), t(body), Value.Int(now())])
    }

    // `user`'s skills, by name: `name`, `description`, `at`, and `body` when
    // `bodies` is true.
    pub fn skills(self, user: String, bodies: bool) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT name, description, at, body FROM skills WHERE user = ? ORDER BY name"), [t(user)]) {
            var o = Obj.new().s("name", text(r[0].copy())).s("description", text(r[1].copy())).i("at", int(r[2].copy()))
            if bodies { o = o.s("body", text(r[3].copy())) }
            out.push(o.done())
        }
        return out
    }

    pub fn skill(self, user: String, name: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT name, description, body, at FROM skills WHERE user = ? AND name = ?"), [t(user), t(name)]) else return none
        return some(Obj.new().s("name", text(r[0].copy())).s("description", text(r[1].copy())).s("body", text(r[2].copy())).i("at", int(r[3].copy())).done())
    }

    pub fn delete_skill(self, user: String, name: String) -> bool ! Error {
        return try self.db.execute(String("DELETE FROM skills WHERE user = ? AND name = ?"), [t(user), t(name)]) > 0
    }

    // --- Plugins (PLAN.md, "Plugins") ---

    // Keeps `user`'s plugin, as JSON (its `id`, what its manifest says,
    // `allowed`, `revision`, `by` and `at`), and its files, a revision too.
    pub fn put_plugin(self, user: String, plugin: Json, files: Json) ! Error {
        let id = (plugin.get(String("id")) ?? Json.Null).as_str() ?? String()
        let revision = (plugin.get(String("revision")) ?? Json.Null).as_i64() ?? 0
        _ = try self.db.execute(String("INSERT INTO plugins (user, id, json, files) VALUES (?, ?, ?, ?) ON CONFLICT (user, id) DO UPDATE SET json = excluded.json, files = excluded.files"), [t(user.copy()), t(id.copy()), t("{plugin}"), t("{files}")])
        _ = try self.db.execute(String("INSERT INTO plugin_revisions (user, id, revision, json, files) VALUES (?, ?, ?, ?, ?) ON CONFLICT (user, id, revision) DO UPDATE SET json = excluded.json, files = excluded.files"), [t(user), t(id), Value.Int(revision), t("{plugin}"), t("{files}")])
    }

    // Changes what's allowed of a plugin, without a new revision.
    pub fn set_plugin(self, user: String, plugin: Json) ! Error {
        let id = (plugin.get(String("id")) ?? Json.Null).as_str() ?? String()
        _ = try self.db.execute(String("UPDATE plugins SET json = ? WHERE user = ? AND id = ?"), [t("{plugin}"), t(user), t(id)])
    }

    pub fn plugin(self, user: String, id: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT json FROM plugins WHERE user = ? AND id = ?"), [t(user), t(id)]) else return none
        return some(try parse(text(r[0].copy())))
    }

    // A plugin's files, {path: text}.
    pub fn plugin_files(self, user: String, id: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT files FROM plugins WHERE user = ? AND id = ?"), [t(user), t(id)]) else return none
        return some(try parse(text(r[0].copy())))
    }

    pub fn plugins(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM plugins WHERE user = ? ORDER BY id"), [t(user)]) {
            out.push(try parse(text(r[0].copy())))
        }
        return out
    }

    // A plugin's revisions, newest first: each as it was, without its files.
    pub fn plugin_revisions(self, user: String, id: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM plugin_revisions WHERE user = ? AND id = ? ORDER BY revision DESC"), [t(user), t(id)]) {
            out.push(try parse(text(r[0].copy())))
        }
        return out
    }

    // Deletes a plugin, its revisions and its panel's data.
    pub fn delete_plugin(self, user: String, id: String) -> bool ! Error {
        let gone = try self.db.execute(String("DELETE FROM plugins WHERE user = ? AND id = ?"), [t(user.copy()), t(id.copy())]) > 0
        _ = try self.db.execute(String("DELETE FROM plugin_revisions WHERE user = ? AND id = ?"), [t(user.copy()), t(id.copy())])
        _ = try self.db.execute(String("DELETE FROM plugin_data WHERE user = ? AND plugin = ?"), [t(user), t(id)])
        return gone
    }

    // What a plugin's panel kept under `key`, or none.
    pub fn plugin_data(self, user: String, plugin: String, key: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT value FROM plugin_data WHERE user = ? AND plugin = ? AND key = ?"), [t(user), t(plugin), t(key)]) else return none
        return some(try parse(text(r[0].copy())))
    }

    // Keeps `value` under `key` for a plugin's panel; null forgets it.
    pub fn put_plugin_data(self, user: String, plugin: String, key: String, value: Json) ! Error {
        if value == Json.Null {
            _ = try self.db.execute(String("DELETE FROM plugin_data WHERE user = ? AND plugin = ? AND key = ?"), [t(user), t(plugin), t(key)])
            return
        }
        _ = try self.db.execute(String("INSERT INTO plugin_data (user, plugin, key, value, at) VALUES (?, ?, ?, ?, ?) ON CONFLICT (user, plugin, key) DO UPDATE SET value = excluded.value, at = excluded.at"), [t(user), t(plugin), t(key), t("{value}"), Value.Int(now())])
    }

    // How many bytes a plugin's panel keeps, in all.
    pub fn plugin_data_size(self, user: String, plugin: String) -> i64 ! Error {
        let r = try self.db.query_one(String("SELECT COALESCE(SUM(LENGTH(key) + LENGTH(value)), 0) FROM plugin_data WHERE user = ? AND plugin = ?"), [t(user), t(plugin)]) else return 0
        return int(r[0].copy())
    }

    // --- MCP servers (PLAN.md, "Agents") ---

    // A person's MCP server, as JSON: `name`, and `command` with `args` and
    // `env`, or `url` with `headers`. A value in `env` or `headers` is text,
    // or {"secret": NAME} for one of the person's secrets.
    pub fn put_mcp_server(self, user: String, server: Json) ! Error {
        let name = (server.get(String("name")) ?? Json.Null).as_str() ?? String()
        _ = try self.db.execute(String("INSERT INTO mcp_servers (user, name, json, at) VALUES (?, ?, ?, ?) ON CONFLICT (user, name) DO UPDATE SET json = excluded.json, at = excluded.at"), [t(user), t(name), t("{server}"), Value.Int(now())])
    }

    pub fn mcp_servers(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM mcp_servers WHERE user = ? ORDER BY name"), [t(user)]) {
            out.push(try parse(text(r[0].copy())))
        }
        return out
    }

    pub fn mcp_server(self, user: String, name: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT json FROM mcp_servers WHERE user = ? AND name = ?"), [t(user), t(name)]) else return none
        return some(try parse(text(r[0].copy())))
    }

    pub fn delete_mcp_server(self, user: String, name: String) -> bool ! Error {
        _ = try self.db.execute(String("DELETE FROM mcp_icons WHERE user = ? AND name = ?"), [t(user.copy()), t(name.copy())])
        return try self.db.execute(String("DELETE FROM mcp_servers WHERE user = ? AND name = ?"), [t(user), t(name)]) > 0
    }

    // A person's MCP server's own icons (PLAN.md, "Cards in the chat"): what
    // the ones it gave are known by (`icons.key`), and the files kept of them,
    // by SHA-256, for a light background and a dark one, each "" for none.
    pub fn put_mcp_icon(self, user: String, name: String, key: String, icon: String, dark: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO mcp_icons (user, name, key, icon, dark, at) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT (user, name) DO UPDATE SET key = excluded.key, icon = excluded.icon, dark = excluded.dark, at = excluded.at"), [t(user), t(name), t(key), t(icon), t(dark), Value.Int(now())])
    }

    // The icons kept for a person's MCP server: (key, icon, dark), or none.
    pub fn mcp_icon(self, user: String, name: String) -> (String, String, String)? ! Error {
        let r = try self.db.query_one(String("SELECT key, icon, dark FROM mcp_icons WHERE user = ? AND name = ?"), [t(user), t(name)]) else return none
        return some((text(r[0].copy()), text(r[1].copy()), text(r[2].copy())))
    }

    // A sign-in to a person's MCP server (PLAN.md, "Signing in to MCP
    // servers"), as the instance sealed it: its nonce and sealed JSON, in hex,
    // and when its token is next renewed (0 for never).
    pub fn put_mcp_auth(self, user: String, name: String, nonce: String, sealed: String, due: i64) ! Error {
        _ = try self.db.execute(String("INSERT INTO mcp_auth (user, name, nonce, sealed, due, at) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT (user, name) DO UPDATE SET nonce = excluded.nonce, sealed = excluded.sealed, due = excluded.due, at = excluded.at"), [t(user), t(name), t(nonce), t(sealed), Value.Int(due), Value.Int(now())])
    }

    pub fn mcp_auth(self, user: String, name: String) -> (String, String)? ! Error {
        let r = try self.db.query_one(String("SELECT nonce, sealed FROM mcp_auth WHERE user = ? AND name = ?"), [t(user), t(name)]) else return none
        return some((text(r[0].copy()), text(r[1].copy())))
    }

    pub fn delete_mcp_auth(self, user: String, name: String) -> bool ! Error {
        return try self.db.execute(String("DELETE FROM mcp_auth WHERE user = ? AND name = ?"), [t(user), t(name)]) > 0
    }

    // Sign-ins whose tokens are due to be renewed by `at`: each person and server.
    pub fn mcp_auth_due(self, at: i64) -> List<(String, String)> ! Error {
        var out = List<(String, String)>()
        for r in try self.db.query(String("SELECT user, name FROM mcp_auth WHERE due > 0 AND due <= ? ORDER BY due LIMIT 50"), [Value.Int(at)]) {
            out.push((text(r[0].copy()), text(r[1].copy())))
        }
        return out
    }

    // Puts off renewing a sign-in's token until `due`.
    pub fn put_off_mcp_auth(self, user: String, name: String, due: i64) ! Error {
        _ = try self.db.execute(String("UPDATE mcp_auth SET due = ? WHERE user = ? AND name = ?"), [Value.Int(due), t(user), t(name)])
    }

    // --- Secrets (PLAN.md, "Accounts and invites") ---

    // A secret as the instance sealed it: its nonce and the sealed bytes, in
    // hex. Only the instance holds the key that opens it.
    pub fn put_secret(self, user: String, name: String, nonce: String, sealed: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO secrets (user, name, nonce, sealed, at) VALUES (?, ?, ?, ?, ?) ON CONFLICT (user, name) DO UPDATE SET nonce = excluded.nonce, sealed = excluded.sealed, at = excluded.at"), [t(user), t(name), t(nonce), t(sealed), Value.Int(now())])
    }

    pub fn sealed_secret(self, user: String, name: String) -> (String, String)? ! Error {
        let r = try self.db.query_one(String("SELECT nonce, sealed FROM secrets WHERE user = ? AND name = ?"), [t(user), t(name)]) else return none
        return some((text(r[0].copy()), text(r[1].copy())))
    }

    // `user`'s secrets' names, with when each was set: never their values.
    pub fn secret_names(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT name, at FROM secrets WHERE user = ? ORDER BY name"), [t(user)]) {
            out.push(Obj.new().s("name", text(r[0].copy())).i("at", int(r[1].copy())).done())
        }
        return out
    }

    pub fn delete_secret(self, user: String, name: String) -> bool ! Error {
        return try self.db.execute(String("DELETE FROM secrets WHERE user = ? AND name = ?"), [t(user), t(name)]) > 0
    }

    // --- Memory (PLAN.md, "Memory") ---

    // Keeps a note for `agent`, or for all of the person's agents when
    // `agent` is "". Gives its id.
    pub fn remember(self, user: String, agent: String, what: String, by: String) -> i64 ! Error {
        return try self.remember_at(user, agent, what, by, now())
    }

    // The same, kept at `at`, such as a note brought over from another app.
    pub fn remember_at(self, user: String, agent: String, what: String, by: String, at: i64) -> i64 ! Error {
        return try self.remember_note(user, agent, what, by, at, String())
    }

    // A note tied to a site (site_of gives it), which the agent is shown when
    // its browser visits that site. "" ties it to none.
    pub fn remember_on(self, user: String, agent: String, what: String, by: String, site: String) -> i64 ! Error {
        return try self.remember_note(user, agent, what, by, now(), site)
    }

    fn remember_note(self, user: String, agent: String, what: String, by: String, at: i64, site: String) -> i64 ! Error {
        let began = try self.begin()
        let id = match self.add_note(user, agent, what, by, at, site) {
            ok(id) => id,
            err(e) => {
                self.rollback(began)
                fail e
            },
        }
        try self.commit(began)
        return id
    }

    fn add_note(self, user: String, agent: String, what: String, by: String, at: i64, site: String) -> i64 ! Error {
        _ = try self.db.execute(String("INSERT INTO memories (user, agent, text, by, at, site) VALUES (?, ?, ?, ?, ?, ?)"), [t(user.copy()), t(agent.copy()), t(what.copy()), t(by), Value.Int(at), t(site)])
        let id = self.db.last_insert_id()
        _ = try self.db.execute(String("INSERT INTO memories_fts (rowid, text, user, agent) VALUES (?, ?, ?, ?)"), [Value.Int(id), t(what), t(user), t(agent)])
        return id
    }

    // Writes `new` for `old` in each of the person's memories that has it, as a
    // folder that moved.
    pub fn repath_memories(self, user: String, old: String, new: String) ! Error {
        for table in ["memories", "memories_fts"] {
            _ = try self.db.execute("UPDATE {table} SET text = replace(text, ?, ?) WHERE user = ? AND instr(text, ?) > 0", [t(old.copy()), t(new.copy()), t(user.copy()), t(old.copy())])
        }
    }

    // What `agent` remembers (its own notes and the shared ones), best match
    // first for `query`, or newest first without one. Each note is `id`,
    // `text`, `shared`, `by` and `at`. With `agent` none, every note of the
    // person's.
    pub fn memories(self, user: String, agent: String?, query: String, limit: usize) -> List<Json> ! Error {
        var out = List<Json>()
        var sql = String()
        var args = List<Value>()
        if let fts = fts_any(query) {
            sql = String("SELECT m.id, m.agent, m.text, m.by, m.at, m.site FROM memories_fts f JOIN memories m ON m.id = f.rowid WHERE memories_fts MATCH ? AND m.user = ?")
            args = [t(fts), t(user)]
        } else {
            sql = String("SELECT m.id, m.agent, m.text, m.by, m.at, m.site FROM memories m WHERE m.user = ?")
            args = [t(user)]
        }
        if let a = agent {
            sql.push_str(" AND (m.agent = ? OR m.agent = '')")
            args.push(t(a))
        }
        sql.push_str(if query.trim().len() > 0 { " ORDER BY rank LIMIT ?" } else { " ORDER BY m.id DESC LIMIT ?" })
        args.push(Value.Int(i64.wrap(u64(limit))))
        for r in try self.db.query(sql, args) {
            let owner = text(r[1].copy())
            out.push(Obj.new().i("id", int(r[0].copy())).s("agent", owner.copy()).b("shared", owner.len() == 0).s("text", text(r[2].copy())).s("by", text(r[3].copy())).i("at", int(r[4].copy())).s("site", text(r[5].copy())).done())
        }
        return out
    }

    // The notes `agent` reads that are tied to `host`'s site, or a site it's
    // under (mail.example.com is under example.com), newest first: each
    // `id`, `text`, `site` and `shared`.
    pub fn site_notes(self, user: String, agent: String, host: String) -> List<Json> ! Error {
        var out = List<Json>()
        let here = site_of(host)
        if here.len() == 0 { return out }
        for r in try self.db.query(String("SELECT id, agent, text, site FROM memories WHERE user = ? AND (agent = ? OR agent = '') AND site != '' ORDER BY id DESC"), [t(user), t(agent)]) {
            let site = text(r[3].copy())
            if not site_covers(site.copy(), here.copy()) { continue }
            out.push(Obj.new().i("id", int(r[0].copy())).s("text", text(r[2].copy())).s("site", site).b("shared", text(r[1].copy()).len() == 0).done())
            if out.len() >= SITE_NOTES_MOST { break }
        }
        return out
    }

    // --- Teaching a task, and proposals (PLAN.md, "Sharing and learning") ---

    // Keeps the steps the person recorded in `agent`'s browser. Gives its id.
    pub fn add_recording(self, user: String, agent: String, steps: Json) -> String ! Error {
        let id = try self.new_id("rec")
        _ = try self.db.execute(String("INSERT INTO recordings (id, user, agent, steps, at) VALUES (?, ?, ?, ?, ?)"), [t(id.copy()), t(user), t(agent), t("{steps}"), Value.Int(now())])
        return id
    }

    // A recording: `id`, `agent`, `steps`, `proposal` (the skill written from
    // it, once one is) and `at`.
    pub fn recording(self, user: String, id: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT id, agent, steps, proposal, at FROM recordings WHERE user = ? AND id = ?"), [t(user), t(id)]) else return none
        return some(recording_of(r))
    }

    // `agent`'s newest recording that no skill has been written from yet.
    pub fn unwritten_recording(self, user: String, agent: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT id FROM recordings WHERE user = ? AND agent = ? AND proposal = '' ORDER BY at DESC, rowid DESC LIMIT 1"), [t(user), t(agent)]) else return none
        return some(text(r[0].copy()))
    }

    pub fn recording_written(self, user: String, id: String, proposal: String) ! Error {
        _ = try self.db.execute(String("UPDATE recordings SET proposal = ? WHERE user = ? AND id = ?"), [t(proposal), t(user), t(id)])
    }

    // Keeps an agent's proposal, waiting for the person: `kind` is skill or
    // note, and `data` its skill (name, description, body) or note (text,
    // site, shared). Gives it as proposal() does.
    pub fn add_proposal(self, user: String, agent: String, kind: str, data: Json, why: String, recording: String) -> Json ! Error {
        let id = try self.new_id("prop")
        _ = try self.db.execute(String("INSERT INTO proposals (id, user, agent, kind, data, why, recording, status, at) VALUES (?, ?, ?, ?, ?, ?, ?, 'waiting', ?)"), [t(id.copy()), t(user.copy()), t(agent), t(String(kind)), t("{data}"), t(why), t(recording), Value.Int(now())])
        return try self.proposal(user, id) ?? Json.Null
    }

    // A proposal: `id`, `agent`, `kind`, `skill` or `note`, `why`, `status`
    // (waiting, kept or dropped), `at`, and once decided, `decided` and `by`;
    // and for a skill written from a recording, `recording` and its `steps`.
    pub fn proposal(self, user: String, id: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT p.id, p.agent, p.kind, p.data, p.why, p.recording, p.status, p.at, p.decided, p.by, coalesce(r.steps, '') FROM proposals p LEFT JOIN recordings r ON r.id = p.recording AND r.user = p.user WHERE p.user = ? AND p.id = ?"), [t(user), t(id)]) else return none
        return some(proposal_of(r))
    }

    // The person's proposals with `status`, or every one with "", newest first.
    pub fn proposals(self, user: String, status: String, limit: usize) -> List<Json> ! Error {
        var out = List<Json>()
        var sql = String("SELECT p.id, p.agent, p.kind, p.data, p.why, p.recording, p.status, p.at, p.decided, p.by, coalesce(r.steps, '') FROM proposals p LEFT JOIN recordings r ON r.id = p.recording AND r.user = p.user WHERE p.user = ?")
        var args: List<Value> = [t(user)]
        if status.len() > 0 {
            sql.push_str(" AND p.status = ?")
            args.push(t(status))
        }
        sql.push_str(" ORDER BY p.at DESC, p.rowid DESC LIMIT ?")
        args.push(Value.Int(i64.wrap(u64(limit))))
        for r in try self.db.query(sql, args) { out.push(proposal_of(r)) }
        return out
    }

    // Keeps or drops a waiting proposal, as `by` said, with what was kept in
    // place of what was proposed. False when it isn't waiting.
    pub fn decide_proposal(self, user: String, id: String, status: str, data: Json, by: String) -> bool ! Error {
        return try self.db.execute(String("UPDATE proposals SET status = ?, data = ?, decided = ?, by = ? WHERE user = ? AND id = ? AND status = 'waiting'"), [t(String(status)), t("{data}"), Value.Int(now()), t(by), t(user), t(id)]) > 0
    }

    // Forgets note `id` of the person's, if `agent` (when given) may: its
    // own, or a shared one.
    pub fn forget(self, user: String, id: i64, agent: String?) -> bool ! Error {
        var sql = String("DELETE FROM memories WHERE id = ? AND user = ?")
        var args: List<Value> = [Value.Int(id), t(user)]
        if let a = agent {
            sql.push_str(" AND (agent = ? OR agent = '')")
            args.push(t(a))
        }
        let began = try self.begin()
        let gone = match self.forget_note(sql, args, id) {
            ok(g) => g,
            err(e) => {
                self.rollback(began)
                fail e
            },
        }
        try self.commit(began)
        return gone
    }

    fn forget_note(self, sql: String, args: List<Value>, id: i64) -> bool ! Error {
        let gone = try self.db.execute(sql, args) > 0
        if gone { _ = try self.db.execute(String("DELETE FROM memories_fts WHERE rowid = ?"), [Value.Int(id)]) }
        return gone
    }

    // --- The person's profile (PLAN.md, "Memory") ---

    // The person's profile as it is now: `text`, `revision`, `by` and `at`.
    pub fn profile(self, user: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT text, revision, by, at FROM profiles WHERE user = ? ORDER BY revision DESC LIMIT 1"), [t(user)]) else return none
        return some(Obj.new().s("text", text(r[0].copy())).i("revision", int(r[1].copy())).s("by", text(r[2].copy())).i("at", int(r[3].copy())).done())
    }

    // Keeps a new revision of the person's profile, by a device or an agent.
    pub fn put_profile(self, user: String, what: String, by: String) -> Json ! Error {
        let revision = (try self.profile(user.copy())).map(|p| (p.get(String("revision")) ?? Json.Null).as_i64() ?? 0) ?? 0
        let at = now()
        _ = try self.db.execute(String("INSERT INTO profiles (user, revision, text, by, at) VALUES (?, ?, ?, ?, ?)"), [t(user), Value.Int(revision + 1), t(what.copy()), t(by.copy()), Value.Int(at)])
        return Obj.new().s("text", what).i("revision", revision + 1).s("by", by).i("at", at).done()
    }

    // --- The person's agent defaults (PLAN.md, "Agent defaults") ---

    // What every agent of the person's follows unless it sets its own, as
    // kept: its fields, `revision`, `by` and `at`. Blank until they're put.
    pub fn defaults(self, user: String) -> Json ! Error {
        let r = try self.db.query_one(String("SELECT json, revision, by, at FROM defaults WHERE user = ?"), [t(user)]) else return blank()
        let kept = try parse(text(r[0].copy()))
        return filled(merge(kept, Obj.new().i("revision", int(r[1].copy())).s("by", text(r[2].copy())).i("at", int(r[3].copy())).done()))
    }

    // Keeps the person's defaults anew, by a device or an agent, as the next revision.
    pub fn put_defaults(self, user: String, fields: Json, by: String) -> Json ! Error {
        let revision = (int_at(try self.defaults(user.copy()), "revision") ?? 0) + 1
        let at = now()
        let kept = filled(fields)
        let stored = without(without(without(kept.copy(), "revision"), "by"), "at")
        _ = try self.db.execute(String("INSERT INTO defaults (user, json, revision, by, at) VALUES (?, ?, ?, ?, ?) ON CONFLICT (user) DO UPDATE SET json = excluded.json, revision = excluded.revision, by = excluded.by, at = excluded.at"), [t(user), t("{stored}"), Value.Int(revision), t(by.copy()), Value.Int(at)])
        return merge(kept, Obj.new().i("revision", revision).s("by", by).i("at", at).done())
    }

    // --- The sidebar's folders (PLAN.md, "The sidebar") ---

    // The person's folders, in the order they were made: each `id`, `name`,
    // `collapsed` and `at`.
    pub fn groups(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM agent_groups WHERE user = ? ORDER BY rowid"), [t(user)]) {
            out.push(try parse(text(r[0].copy())))
        }
        return out
    }

    pub fn group(self, user: String, id: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT json FROM agent_groups WHERE id = ? AND user = ?"), [t(id), t(user)]) else return none
        return some(try parse(text(r[0].copy())))
    }

    // Keeps a folder, new or changed, where it was in the order.
    pub fn put_group(self, user: String, group: Json) ! Error {
        let id = str_at(group.copy(), "id") ?? String()
        _ = try self.db.execute(String("INSERT INTO agent_groups (id, user, json) VALUES (?, ?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json WHERE agent_groups.user = excluded.user"), [t(id), t(user), t("{group}")])
    }

    pub fn delete_group(self, user: String, id: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM agent_groups WHERE id = ? AND user = ?"), [t(id), t(user)])
    }

    // --- Rules on what's touched (PLAN.md, "Rules, records and limits") ---

    // The person's rules, oldest first, each with its `id` and `agent` ("" for
    // every agent). One whose JSON can't be read comes as a rule that can't be
    // read, which denies everything, rather than being left out.
    pub fn rules(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT id, agent, json, at FROM rules WHERE user = ? ORDER BY rowid"), [t(user)]) {
            let kept = match parse(text(r[2].copy())) {
                ok(j) => j,
                err(_) => Obj.new().s("unreadable", String("its JSON")).done(),
            }
            out.push(merge(kept, Obj.new().s("id", text(r[0].copy())).s("agent", text(r[1].copy())).i("at", int(r[3].copy())).done()))
        }
        return out
    }

    // Keeps a rule, new or changed: `rule` has its `id` and `agent`.
    pub fn put_rule(self, user: String, rule: Json) ! Error {
        let id = str_at(rule.copy(), "id") ?? String()
        let agent = str_at(rule.copy(), "agent") ?? String()
        let at = int_at(rule.copy(), "at") ?? now()
        let stored = without(without(without(rule, "id"), "agent"), "at")
        _ = try self.db.execute(String("INSERT INTO rules (id, user, agent, json, at) VALUES (?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET agent = excluded.agent, json = excluded.json"), [t(id), t(user), t(agent), t("{stored}"), Value.Int(at)])
    }

    // Removes one of the person's rules. Gives whether there was one.
    pub fn delete_rule(self, user: String, id: String) -> bool ! Error {
        let had = try self.db.query_one(String("SELECT id FROM rules WHERE id = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        if had == none { return false }
        _ = try self.db.execute(String("DELETE FROM rules WHERE id = ? AND user = ?"), [t(id), t(user)])
        return true
    }

    // --- Routines (PLAN.md, "Routines") ---

    // A routine as it's kept: its webhook's secret sealed.
    fn sealed_routine(self, routine: Json) -> Json {
        let id = (routine.get(String("id")) ?? Json.Null).as_str() ?? String()
        let secret = (routine.get(String("secret")) ?? Json.Null).as_str() ?? String()
        if secret.len() == 0 or secret.starts_with(SEALED) { return routine.copy() }
        return merge(routine, Obj.new().s("secret", self.seal(secret, hook_aad(id))).done())
    }

    // A routine as it was kept, its secret opened.
    fn routine_of(self, kept: String) -> Json ! Error {
        let routine = try parse(kept)
        let id = (routine.get(String("id")) ?? Json.Null).as_str() ?? String()
        let secret = (routine.get(String("secret")) ?? Json.Null).as_str() ?? String()
        if not secret.starts_with(SEALED) { return routine }
        return merge(routine, Obj.new().s("secret", try self.unseal(secret, hook_aad(id))).done())
    }

    // Adds or replaces one of `user`'s routines, as JSON with its `id`, and
    // `next`, when it runs next (0 when it's off).
    pub fn put_routine(self, user: String, routine: Json) ! Error {
        let id = (routine.get(String("id")) ?? Json.Null).as_str() ?? String()
        let next = (routine.get(String("next")) ?? Json.Null).as_i64() ?? 0
        _ = try self.db.execute(String("INSERT INTO routines (id, user, json, next) VALUES (?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json, next = excluded.next"), [t(id), t(user), t("{self.sealed_routine(routine.copy())}"), Value.Int(next)])
    }

    pub fn routine(self, user: String, id: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT json FROM routines WHERE id = ? AND user = ?"), [t(id), t(user)]) else return none
        return some(try self.routine_of(text(r[0].copy())))
    }

    // `user`'s routines, oldest first.
    pub fn routines(self, user: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM routines WHERE user = ? ORDER BY rowid"), [t(user)]) {
            out.push(try self.routine_of(text(r[0].copy())))
        }
        return out
    }

    // Every routine on the instance, with whose it is.
    pub fn every_routine(self) -> List<(String, Json)> ! Error {
        var out = List<(String, Json)>()
        for r in try self.db.query(String("SELECT user, json FROM routines")) {
            out.push((text(r[0].copy()), try self.routine_of(text(r[1].copy()))))
        }
        return out
    }

    // Every routine due by `time`, with whose it is, soonest first.
    pub fn due_routines(self, time: i64) -> List<(String, Json)> ! Error {
        var out = List<(String, Json)>()
        for r in try self.db.query(String("SELECT user, json FROM routines WHERE next > 0 AND next <= ? ORDER BY next"), [Value.Int(time)]) {
            out.push((text(r[0].copy()), try self.routine_of(text(r[1].copy()))))
        }
        return out
    }

    // The routine whose webhook is `hook`, with whose it is.
    pub fn routine_by_hook(self, hook: String) -> (String, Json)? ! Error {
        let r = try self.db.query_one(String("SELECT user, json FROM routines WHERE json_extract(json, '$.hook') = ?"), [t(hook)]) else return none
        return some((text(r[0].copy()), try self.routine_of(text(r[1].copy()))))
    }

    pub fn delete_routine(self, user: String, id: String) -> bool ! Error {
        _ = try self.db.execute(String("DELETE FROM routine_runs WHERE routine = ? AND user = ?"), [t(id.copy()), t(user.copy())])
        return try self.db.execute(String("DELETE FROM routines WHERE id = ? AND user = ?"), [t(id), t(user)]) > 0
    }

    // Keeps one of routine `routine`'s runs, as JSON with its `run` and `at`, or
    // changes it, and lets the oldest go past the newest ROUTINE_RUNS_KEPT.
    pub fn put_routine_run(self, user: String, routine: String, run: Json) ! Error {
        let id = (run.get(String("run")) ?? Json.Null).as_str() ?? String()
        let at = (run.get(String("at")) ?? Json.Null).as_i64() ?? now()
        _ = try self.db.execute(String("INSERT INTO routine_runs (id, user, routine, json, at) VALUES (?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json"), [t(id), t(user.copy()), t(routine.copy()), t("{run}"), Value.Int(at)])
        _ = try self.db.execute(String("DELETE FROM routine_runs WHERE user = ?1 AND routine = ?2 AND id NOT IN (SELECT id FROM routine_runs WHERE user = ?1 AND routine = ?2 ORDER BY at DESC, rowid DESC LIMIT ?3)"), [t(user), t(routine), Value.Int(ROUTINE_RUNS_KEPT)])
    }

    // One of routine `routine`'s runs, by its run id.
    pub fn routine_run(self, user: String, routine: String, run: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT json FROM routine_runs WHERE id = ? AND user = ? AND routine = ?"), [t(run), t(user), t(routine)]) else return none
        return some(try parse(text(r[0].copy())))
    }

    // Up to `limit` of routine `routine`'s runs, newest first, before the run
    // `before` when it's given.
    pub fn routine_runs(self, user: String, routine: String, before: String?, limit: i64) -> List<Json> ! Error {
        var rows = List<List<Value>>()
        if let b = before {
            rows = try self.db.query(String("SELECT json FROM routine_runs WHERE user = ?1 AND routine = ?2 AND rowid < (SELECT rowid FROM routine_runs WHERE id = ?3 AND user = ?1) ORDER BY at DESC, rowid DESC LIMIT ?4"), [t(user), t(routine), t(b), Value.Int(limit)])
        } else {
            rows = try self.db.query(String("SELECT json FROM routine_runs WHERE user = ? AND routine = ? ORDER BY at DESC, rowid DESC LIMIT ?"), [t(user), t(routine), Value.Int(limit)])
        }
        var out = List<Json>()
        for r in rows { out.push(try parse(text(r[0].copy()))) }
        return out
    }

    // Routine runs a crash or a restart cut short are failed, saying so, and
    // those that waited for their chat are skipped.
    pub fn fail_running_routine_runs(self) ! Error {
        _ = try self.db.execute(String("UPDATE routine_runs SET json = json_set(json, '$.status', 'failed', '$.error', 'The instance restarted.') WHERE json_extract(json, '$.status') = 'running'"))
        _ = try self.db.execute(String("UPDATE routine_runs SET json = json_set(json, '$.status', 'skipped', '$.error', ?) WHERE json_extract(json, '$.status') = 'waiting'"), [t(String(RESTARTED_WAITING))])
    }

    // --- Routine flows that are running (PLAN.md, "Routine flows") ---

    // Keeps a running flow, as flows.kept gives it, across a restart.
    pub fn keep_flow(self, id: String, user: String, flow: Json) ! Error {
        _ = try self.db.execute(String("INSERT INTO flows (id, user, json) VALUES (?, ?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json"), [t(id), t(user), t("{flow}")])
    }

    // A flow that finished, and isn't kept any more.
    pub fn drop_flow(self, id: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM flows WHERE id = ?"), [t(id)])
    }

    // Every flow kept, oldest first, to pick up after a restart.
    pub fn kept_flows(self) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM flows ORDER BY rowid")) { out.push(try parse(text(r[0].copy()))) }
        return out
    }

    // --- Codes that add a device by QR code (PLAN.md, "Connecting devices") ---

    // Keeps a one-time code, as its SHA-256 `hash`, for `user`, made on device
    // `by`, until `expires` (Unix ms). Codes already past their time go.
    pub fn add_link_code(self, hash: String, user: String, by: String, expires: i64, time: i64) ! Error {
        _ = try self.db.execute(String("DELETE FROM link_codes WHERE expires <= ?"), [Value.Int(time)])
        _ = try self.db.execute(String("INSERT INTO link_codes (hash, user, by, expires) VALUES (?, ?, ?, ?)"), [t(hash), t(user), t(by), Value.Int(expires)])
    }

    // Takes the code whose SHA-256 is `hash`, once: whose it is and when it
    // expires, or none for a code there isn't. Taken, it's gone.
    pub fn take_link_code(self, hash: String) -> (String, i64)? ! Error {
        let r = try self.db.query_one(String("SELECT user, expires FROM link_codes WHERE hash = ?"), [t(hash.copy())]) else return none
        _ = try self.db.execute(String("DELETE FROM link_codes WHERE hash = ?"), [t(hash)])
        return some((text(r[0].copy()), int(r[1].copy())))
    }

    // A link code that makes the owner on an instance no one has set up yet
    // (protocol.md, "Link codes"), as its SHA-256, made by `by` ("setup" or
    // "cli"), until `expires`. There's one at a time: a new one replaces the last.
    pub fn add_owner_code(self, hash: String, by: str, expires: i64) ! Error {
        _ = try self.db.execute(String("DELETE FROM owner_codes"))
        _ = try self.db.execute(String("INSERT INTO owner_codes (hash, by, expires) VALUES (?, ?, ?)"), [t(hash), t(String(by)), Value.Int(expires)])
    }

    // When the owner code whose SHA-256 is `hash` expires, or none for one there
    // isn't. It stays until `drop_owner_codes`, once the owner is made.
    pub fn owner_code(self, hash: String) -> i64? ! Error {
        let r = try self.db.query_one(String("SELECT expires FROM owner_codes WHERE hash = ?"), [t(hash)]) else return none
        return some(int(r[0].copy()))
    }

    pub fn drop_owner_codes(self) ! Error {
        _ = try self.db.execute(String("DELETE FROM owner_codes"))
    }

    // Whether the account has a password: one made from a link code has none
    // until the person sets one.
    pub fn has_password(self, user: String) -> bool ! Error {
        let r = try self.db.query_one(String("SELECT password FROM users WHERE id = ?"), [t(user)]) else return false
        return text(r[0].copy()).len() > 0
    }

    // --- Invites (PLAN.md, "Accounts and invites") ---

    // An invite whose code's SHA-256 is `hash`, giving `role`, for `uses`
    // accounts until `expires` (Unix ms), made by `by`. Gives its id.
    pub fn add_invite(self, hash: String, role: String, uses: i64, expires: i64, by: String) -> String ! Error {
        _ = try self.db.execute(String("DELETE FROM invites WHERE expires <= ? OR uses <= 0"), [Value.Int(now())])
        let id = try self.new_id("inv")
        _ = try self.db.execute(String("INSERT INTO invites (id, hash, role, uses, expires, by, at) VALUES (?, ?, ?, ?, ?, ?, ?)"), [t(id.copy()), t(hash), t(role), Value.Int(uses), Value.Int(expires), t(by), Value.Int(now())])
        return id
    }

    // The invites still open, newest first, as invite.list gives them.
    pub fn invites(self) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT id, role, uses, expires, by, at FROM invites WHERE expires > ? AND uses > 0 ORDER BY at DESC"), [Value.Int(now())]) {
            out.push(Obj.new().s("invite", text(r[0].copy())).s("role", text(r[1].copy())).i("uses", int(r[2].copy())).i("expires", int(r[3].copy())).s("by", text(r[4].copy())).i("at", int(r[5].copy())).done())
        }
        return out
    }

    // The invite whose code's SHA-256 is `hash`: its id, role, uses left and
    // when it expires, or none for no such invite.
    pub fn invite(self, hash: String) -> (String, String, i64, i64)? ! Error {
        let r = try self.db.query_one(String("SELECT id, role, uses, expires FROM invites WHERE hash = ?"), [t(hash)]) else return none
        return some((text(r[0].copy()), text(r[1].copy()), int(r[2].copy()), int(r[3].copy())))
    }

    // Who made the invite `id`, if it's still kept.
    pub fn invite_by(self, id: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT by FROM invites WHERE id = ?"), [t(id)]) else return none
        return some(text(r[0].copy()))
    }

    // Takes one use of the invite `id`. False if it had none left.
    pub fn use_invite(self, id: String) -> bool ! Error {
        return try self.db.execute(String("UPDATE invites SET uses = uses - 1 WHERE id = ? AND uses > 0"), [t(id)]) > 0
    }

    pub fn delete_invite(self, id: String) -> bool ! Error {
        return try self.db.execute(String("DELETE FROM invites WHERE id = ?"), [t(id)]) > 0
    }

    // --- Password resets (PLAN.md, "Accounts and invites") ---

    // Keeps a reset code, as its SHA-256 `hash`, for `user`, made by `by`, until
    // `expires`. Any older code of theirs, and codes past their time, go.
    pub fn add_reset(self, hash: String, user: String, by: String, expires: i64) ! Error {
        _ = try self.db.execute(String("DELETE FROM resets WHERE expires <= ? OR user = ?"), [Value.Int(now()), t(user.copy())])
        _ = try self.db.execute(String("INSERT INTO resets (hash, user, by, expires) VALUES (?, ?, ?, ?)"), [t(hash), t(user), t(by), Value.Int(expires)])
    }

    // Whose the reset code with SHA-256 `hash` is, and when it expires.
    pub fn reset(self, hash: String) -> (String, i64)? ! Error {
        let r = try self.db.query_one(String("SELECT user, expires FROM resets WHERE hash = ?"), [t(hash)]) else return none
        return some((text(r[0].copy()), int(r[1].copy())))
    }

    // Takes the reset code, once. False if it was taken already.
    pub fn take_reset(self, hash: String) -> bool ! Error {
        return try self.db.execute(String("DELETE FROM resets WHERE hash = ?"), [t(hash)]) > 0
    }

    // Signs `user` out everywhere: every device of theirs, whose ids it gives.
    pub fn revoke_all(self, user: String) -> List<String> ! Error {
        var out = List<String>()
        for r in try self.db.query(String("SELECT id FROM devices WHERE user = ? AND revoked = 0"), [t(user)]) {
            let id = text(r[0].copy())
            try self.revoke_device(id.copy())
            out.push(id)
        }
        return out
    }

    // --- The people log (PLAN.md, "Accounts and invites") ---

    // Keeps what happened to people here: `kind` (joined, invited, role,
    // removed, left, reset, password), what in words, and the username of who
    // did it ("" for the command line). Names, not ids, so it outlives them.
    pub fn log_people(self, kind: str, what: String, by: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO people_log (kind, text, by, at) VALUES (?, ?, ?, ?)"), [t(String(kind)), t(what), t(by), Value.Int(now())])
    }

    // The people log, newest first: up to `limit` entries before entry `before`.
    pub fn people_log(self, before: i64?, limit: usize) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT id, kind, text, by, at FROM people_log WHERE id < ? ORDER BY id DESC LIMIT ?"), [Value.Int(before ?? i64.MAX), Value.Int(i64.wrap(u64(limit)))]) {
            out.push(Obj.new().i("id", int(r[0].copy())).s("kind", text(r[1].copy())).s("text", text(r[2].copy())).s("by", text(r[3].copy())).i("at", int(r[4].copy())).done())
        }
        return out
    }

    // The username of `user`, if they're here.
    pub fn username(self, user: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT username FROM users WHERE id = ?"), [t(user)]) else return none
        return some(text(r[0].copy()))
    }

    // --- People ---

    // Everyone's account, oldest first, as user.list gives it.
    pub fn people(self) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT id, username, role, at FROM users ORDER BY at")) {
            out.push(Obj.new().s("user", text(r[0].copy())).s("username", text(r[1].copy())).s("role", text(r[2].copy())).i("at", int(r[3].copy())).done())
        }
        return out
    }

    pub fn set_role(self, user: String, role: String) ! Error {
        _ = try self.db.execute(String("UPDATE users SET role = ? WHERE id = ?"), [t(role), t(user)])
    }

    // Everything of `user`'s in the database, and the account: what's left
    // are the files on disk other people may share, and folders the instance
    // removes itself. Gives the ids of their agents, for their folders.
    pub fn remove_user(self, user: String) -> List<String> ! Error {
        var agents = List<String>()
        for r in try self.db.query(String("SELECT id FROM agents WHERE user = ?"), [t(user.copy())]) {
            agents.push(text(r[0].copy()))
        }
        let began = try self.begin()
        match self.remove_rows(user) {
            ok => try self.commit(began),
            err(e) => {
                self.rollback(began)
                fail "{e}"
            },
        }
        return agents
    }

    fn remove_rows(self, user: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM sent WHERE device IN (SELECT id FROM devices WHERE user = ?)"), [t(user.copy())])
        for table in ["push_tokens", "link_codes", "script_grants", "resets", "agent_revisions", "agents", "activity", "secrets", "mcp_auth", "mcp_icons", "mcp_servers", "skills", "messages", "conversations", "runs", "queue", "tasks", "sides", "branches", "routine_threads", "asks", "rooms", "events", "acp_sessions", "plan_limits", "files", "profiles", "defaults", "agent_groups", "rules", "routine_runs", "routines", "flows", "plugin_data", "plugin_revisions", "plugins", "usage", "memories", "memories_fts", "messages_fts", "shared_rows", "shared_tables", "script_tokens", "status_tokens", "imported", "recordings", "proposals", "devices"] {
            _ = try self.db.execute("DELETE FROM {table} WHERE user = ?", [t(user.copy())])
        }
        _ = try self.db.execute(String("DELETE FROM invites WHERE by = ?"), [t(user.copy())])
        _ = try self.db.execute(String("DELETE FROM users WHERE id = ?"), [t(user)])
    }

    // --- The activity log (PLAN.md, "Machines and devices") ---

    // Notes what `agent` did, or what was done to it: `kind` is tool,
    // approval, agent, message or notify, and `by` the device or agent that
    // did it ("" for the agent itself, "auto" for its permission mode).
    pub fn log(self, user: String, agent: String, kind: str, what: String, by: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO activity (user, agent, kind, text, by, at) VALUES (?, ?, ?, ?, ?, ?)"), [t(user), t(agent), t(String(kind)), t(what), t(by), Value.Int(now())])
    }

    // Notes an action before it happens (PLAN.md, "Every action is recorded
    // before it happens"): `input` is what it was given, with secrets already
    // shown only as their length. Its status is "started" until `settle`
    // marks it done, failed or refused. Gives the entry's id.
    pub fn record(self, user: String, agent: String, kind: str, what: String, input: String, by: String) -> i64 ! Error {
        _ = try self.db.execute(String("INSERT INTO activity (user, agent, kind, text, by, at, status, input) VALUES (?, ?, ?, ?, ?, ?, 'started', ?)"), [t(user), t(agent), t(String(kind)), t(what), t(by), Value.Int(now()), t(input)])
        return self.db.last_insert_id()
    }

    // Marks the action `id` done, failed or refused, with why for the last two:
    // a refusal's why starts with the rule that refused it.
    pub fn settle(self, id: i64, status: str, why: String) ! Error {
        _ = try self.db.execute(String("UPDATE activity SET status = ?, why = ?, ended = ? WHERE id = ? AND status = 'started'"), [t(String(status)), t(why), Value.Int(now()), Value.Int(id)])
    }

    // Actions a restart cut short are marked failed, once.
    pub fn settle_cut_short(self) ! Error {
        _ = try self.db.execute(String("UPDATE activity SET status = 'failed', why = 'The instance stopped before it finished.', ended = ? WHERE status = 'started'"), [Value.Int(now())])
    }

    // `user`'s activity, newest first: all of it, or one agent's, from
    // before the entry `before`.
    pub fn activity(self, user: String, agent: String?, before: i64?, limit: usize) -> List<Json> ! Error {
        var out = List<Json>()
        let below = before ?? i64.MAX
        let rows = match agent {
            some(a) => try self.db.query(String("SELECT id, agent, kind, text, by, at, status, input, why, ended FROM activity WHERE user = ? AND agent = ? AND id < ? ORDER BY id DESC LIMIT ?"), [t(user), t(a), Value.Int(below), Value.Int(i64.wrap(u64(limit)))]),
            none => try self.db.query(String("SELECT id, agent, kind, text, by, at, status, input, why, ended FROM activity WHERE user = ? AND id < ? ORDER BY id DESC LIMIT ?"), [t(user), Value.Int(below), Value.Int(i64.wrap(u64(limit)))]),
        }
        for r in rows {
            var e = Obj.new().i("id", int(r[0].copy())).s("agent", text(r[1].copy())).s("kind", text(r[2].copy())).s("text", text(r[3].copy())).s("by", text(r[4].copy())).i("at", int(r[5].copy()))
            let status = text(r[6].copy())
            if status.len() > 0 {
                e = e.s("status", status).s("input", text(r[7].copy())).s("why", text(r[8].copy()))
                let ended = int(r[9].copy())
                if ended > 0 { e = e.i("ended", ended) }
            }
            out.push(e.done())
        }
        return out
    }

    // --- ACP sessions ---

    // The ACP session `conversation` last had in the agent program `program`, to pick up
    // again after a restart.
    pub fn acp_session(self, user: String, conversation: String, program: String) -> String? ! Error {
        let r = try self.db.query_one(String("SELECT session FROM acp_sessions WHERE user = ? AND conversation = ? AND program = ?"), [t(user), t(conversation), t(program)]) else return none
        return some(text(r[0].copy()))
    }

    // The tools `session` was started with: "code" (Code Mode) or "plain", or
    // empty for one kept before sessions kept them.
    pub fn acp_session_tools(self, user: String, conversation: String, session: String) -> String ! Error {
        let r = try self.db.query_one(String("SELECT tools FROM acp_sessions WHERE user = ? AND conversation = ? AND session = ?"), [t(user), t(conversation), t(session)]) else return String()
        return text(r[0].copy())
    }

    // Marks the session `conversation` has as one whose tools have changed since it
    // started (a server added for its agent, which it has only from a session's
    // start), so its next message goes to a fresh session.
    pub fn stale_acp_session(self, user: String, conversation: String) ! Error {
        _ = try self.db.execute(String("UPDATE acp_sessions SET tools = 'stale' WHERE user = ? AND conversation = ?"), [t(user), t(conversation)])
    }

    // When `session` was last used: a turn in it ended, or it was started or
    // picked up for one. 0 when it isn't `conversation`'s.
    pub fn acp_session_at(self, user: String, conversation: String, session: String) -> i64 ! Error {
        let r = try self.db.query_one(String("SELECT at FROM acp_sessions WHERE user = ? AND conversation = ? AND session = ?"), [t(user), t(conversation), t(session)]) else return 0
        return int(r[0].copy())
    }

    // A turn in `session` ended now.
    pub fn used_acp_session(self, user: String, conversation: String, session: String) ! Error {
        _ = try self.db.execute(String("UPDATE acp_sessions SET at = ? WHERE user = ? AND conversation = ? AND session = ?"), [Value.Int(now()), t(user), t(conversation), t(session)])
    }

    // The limits of `user`'s plan with `program`, as it last reported them, or none.
    pub fn plan_limits(self, user: String, program: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT json FROM plan_limits WHERE user = ? AND program = ?"), [t(user), t(program)]) else return none
        return some(try parse(text(r[0].copy())))
    }

    pub fn put_plan_limits(self, user: String, program: String, limits: Json) ! Error {
        _ = try self.db.execute(String("INSERT INTO plan_limits (user, program, json) VALUES (?, ?, ?) ON CONFLICT (user, program) DO UPDATE SET json = excluded.json"), [t(user), t(program), t("{limits}")])
    }

    pub fn put_acp_session(self, user: String, conversation: String, program: String, session: String, tools: str) ! Error {
        _ = try self.db.execute(String("INSERT INTO acp_sessions (user, conversation, program, session, at, tools) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT (user, conversation) DO UPDATE SET program = excluded.program, session = excluded.session, at = excluded.at, tools = excluded.tools"), [t(user), t(conversation), t(program), t(session), Value.Int(now()), t(String(tools))])
    }

    // --- Files ---

    // Notes that `user` has the file `sha`, and a picture's width and height (`files.picture_size`,
    // none for anything else). The first name and type they gave it stay; a picture kept
    // before its size was known gets it.
    pub fn add_file(self, user: String, sha: String, name: String, mime: String, size: i64, shown: (u32, u32)?) ! Error {
        let (w, h) = shown ?? (0u32, 0u32)
        _ = try self.db.execute(String("INSERT INTO files (sha, user, name, mime, size, at, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT (sha, user) DO UPDATE SET width = excluded.width, height = excluded.height WHERE files.width = 0"), [t(sha), t(user), t(name), t(mime), Value.Int(size), Value.Int(now()), Value.Int(i64(w)), Value.Int(i64(h))])
    }

    // The files sent or received in `user`'s chats, newest first, each once by
    // its `file`: as its file block has it, with `at` and `conversation`. The
    // newest RECENT_LOOKED messages are looked through, in chats not deleted.
    pub fn recent_files(self, user: String, most: usize) -> List<Json> ! Error {
        var out = List<Json>()
        var seen = List<String>()
        let rows = try self.db.query(String("SELECT b.value, m.conversation, m.at FROM (SELECT rowid AS r, json, conversation, at FROM messages WHERE user = ? AND conversation NOT IN (SELECT id FROM conversations WHERE user = ? AND deleted = 1) ORDER BY at DESC, rowid DESC LIMIT ?) m, json_each(m.json, '$.blocks') b WHERE json_extract(b.value, '$.kind') = 'file' ORDER BY m.at DESC, m.r DESC, b.key"), [t(user.copy()), t(user), Value.Int(RECENT_LOOKED)])
        for r in rows {
            if out.len() >= most { break }
            let block = try parse(text(r[0].copy()))
            let sha = str_at(block.copy(), "file") ?? String()
            if sha.len() == 0 or seen.contains(sha.copy()) { continue }
            seen.push(sha.copy())
            var o = Obj.new().s("file", sha).s("name", str_at(block.copy(), "name") ?? String()).s("mime", str_at(block.copy(), "mime") ?? String()).i("size", int_at(block.copy(), "size") ?? 0).i("at", int(r[2].copy())).s("conversation", text(r[1].copy()))
            // A picture's size, where its block has it, so it opens at its size.
            let (w, h) = (int_at(block.copy(), "width") ?? 0, int_at(block, "height") ?? 0)
            if w > 0 and h > 0 { o = o.i("width", w).i("height", h) }
            out.push(o.done())
        }
        return out
    }

    // The file `sha`, if `user` has it: `file`, `name`, `mime` and `size`, as a file block has
    // them, and a picture's `width` and `height` where they're known.
    pub fn file(self, user: String, sha: String) -> Json? ! Error {
        let r = try self.db.query_one(String("SELECT sha, name, mime, size, width, height FROM files WHERE sha = ? AND user = ?"), [t(sha), t(user)]) else return none
        let f = Obj.new().s("file", text(r[0].copy())).s("name", text(r[1].copy())).s("mime", text(r[2].copy())).i("size", int(r[3].copy()))
        let (w, h) = (int(r[4].copy()), int(r[5].copy()))
        if w > 0 and h > 0 { return some(f.i("width", w).i("height", h).done()) }
        return some(f.done())
    }

    // The bytes of the files `user` has, counting each once.
    pub fn file_usage(self, user: String) -> i64 ! Error {
        let row = try self.db.query_one(String("SELECT coalesce(sum(size), 0) FROM files WHERE user = ?"), [t(user)])
        return int((row ?? List<Value>())[0].copy())
    }

    // Messages for a snapshot, as a JSON array's text, as they were stored, without
    // reading them in and writing them out again: up to the newest `per` of each of
    // `user`'s conversations that aren't deleted, the conversation with the newest
    // message first, while they come to no more than `budget` bytes. A conversation
    // gets its newest messages or none, never a gap. With them, the conversations
    // that have messages the array leaves out, which the app fetches with
    // messages.list (protocol.md, "snapshot").
    pub fn snapshot_messages(self, user: String, per: i64, budget: i64) -> (String, List<String>) ! Error {
        // First only the sizes, so a big account's messages aren't all read in to be
        // left out: 1000 conversations' newest 50 were a 40 MB frame.
        let sizes = "SELECT w.conversation, w.r, w.n, w.total, length(CAST(m.json AS BLOB)) FROM (SELECT rowid AS r, conversation, row_number() OVER (PARTITION BY conversation ORDER BY rowid DESC) AS n, count(*) OVER (PARTITION BY conversation) AS total, max(rowid) OVER (PARTITION BY conversation) AS newest FROM messages WHERE user = ?1) w JOIN conversations c ON c.id = w.conversation AND c.user = ?1 AND c.deleted = 0 JOIN messages m ON m.rowid = w.r WHERE w.n <= ?2 ORDER BY w.newest DESC, w.n"
        var taken = List<Json>()
        var partial = List<String>()
        var used: i64 = 1    // the brackets, less the first message's comma
        var current = String()
        var total: i64 = 0
        var got: i64 = 0
        var open = true
        var started = false
        for r in try self.db.query(String(sizes), [t(user), Value.Int(per)]) {
            let conversation = text(r[0].copy())
            if not started or conversation != current {
                if started and got < total { partial.push(current.copy()) }
                started = true
                current = conversation.copy()
                total = int(r[3].copy())
                got = 0
                open = true
            }
            if not open { continue }
            // Each message and the comma before it.
            let size = int(r[4].copy()) + 1
            if used + size > budget {
                open = false
                continue
            }
            used += size
            got += 1
            taken.push(Json.Int(int(r[1].copy())))
        }
        if started and got < total { partial.push(current) }
        var out = String("[")
        var first = true
        if taken.len() > 0 {
            for r in try self.db.query(String("SELECT json FROM messages WHERE rowid IN (SELECT value FROM json_each(?)) ORDER BY rowid"), [t("{Json.Array(taken)}")]) {
                if not first { out.push_str(",") }
                first = false
                out.push_str(text(r[0].copy()))
            }
        }
        out.push_str("]")
        return (out, partial)
    }

    // Up to `limit` messages of a conversation, newest last, before the
    // message `before` if it's given, and whether there are older ones.
    pub fn messages(self, user: String, conversation: String, before: String?, limit: usize) -> (List<Json>, bool) ! Error {
        var rows = List<List<Value>>()
        if let b = before {
            rows = try self.db.query(String("SELECT json FROM messages WHERE user = ? AND conversation = ? AND rowid < (SELECT rowid FROM messages WHERE id = ? AND user = ?) ORDER BY rowid DESC LIMIT ?"), [t(user.copy()), t(conversation), t(b), t(user), Value.Int(i64.wrap(u64(limit + 1)))])
        } else {
            rows = try self.db.query(String("SELECT json FROM messages WHERE user = ? AND conversation = ? ORDER BY rowid DESC LIMIT ?"), [t(user), t(conversation), Value.Int(i64.wrap(u64(limit + 1)))])
        }
        let more = rows.len() > limit
        var out = List<Json>()
        var i = if more { limit } else { rows.len() }
        while i > 0 {
            i -= 1
            out.push(try parse(text(rows[i][0].copy())))
        }
        return (out, more)
    }

    // A message of `user`'s, by id.
    pub fn message(self, user: String, id: String) -> Json? ! Error {
        let row = try self.db.query_one(String("SELECT json FROM messages WHERE id = ? AND user = ?"), [t(id), t(user)]) else return none
        return some(try parse(text(row[0].copy())))
    }

    // The pinned messages in a conversation, the newest pin first (and of two in
    // the same millisecond, the later message).
    pub fn pinned(self, user: String, conversation: String) -> List<Json> ! Error {
        var out = List<Json>()
        for r in try self.db.query(String("SELECT json FROM messages WHERE user = ? AND conversation = ? AND json_extract(json, '$.pinned') IS NOT NULL ORDER BY json_extract(json, '$.pinned.at') DESC, rowid DESC"), [t(user), t(conversation)]) {
            out.push(try parse(text(r[0].copy())))
        }
        return out
    }

    pub fn add_run(self, user: String, id: String, conversation: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO runs (id, user, conversation, status, at) VALUES (?, ?, ?, 'running', ?)"), [t(id), t(user), t(conversation), Value.Int(now())])
    }

    pub fn finish_run(self, id: String, status: String) ! Error {
        _ = try self.db.execute(String("UPDATE runs SET status = ? WHERE id = ?"), [t(status), t(id)])
    }

    // Marks run `id` as one routine `routine` started.
    pub fn mark_run_routine(self, id: String, routine: String) ! Error {
        _ = try self.db.execute(String("UPDATE runs SET routine = ? WHERE id = ?"), [t(routine), t(id)])
    }

    // How routine run `id` went, as its routine keeps it: done, quiet, failed, ...
    pub fn routine_run_went(self, id: String, outcome: String) ! Error {
        _ = try self.db.execute(String("UPDATE runs SET outcome = ? WHERE id = ?"), [t(outcome), t(id)])
    }

    // Runs a crash or a restart left unfinished, as (user, run, conversation).
    pub fn unfinished_runs(self) -> List<(String, String, String)> ! Error {
        var out = List<(String, String, String)>()
        for r in try self.db.query(String("SELECT user, id, conversation FROM runs WHERE status = 'running'")) {
            out.push((text(r[0].copy()), text(r[1].copy()), text(r[2].copy())))
        }
        return out
    }

    // --- Client ids of sent messages, for the outbox's resends ---

    pub fn sent(self, device: String, cid: String) -> (String, String)? ! Error {
        let row = try self.db.query_one(String("SELECT message, run FROM sent WHERE device = ? AND cid = ?"), [t(device), t(cid)])
        let r = row else return none
        return some((text(r[0].copy()), text(r[1].copy())))
    }

    pub fn remember_sent(self, device: String, cid: String, message: String, run: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO sent (device, cid, message, run, at) VALUES (?, ?, ?, ?, ?)"), [t(device), t(cid), t(message), t(run), Value.Int(now())])
    }

    // Removes up to `most` each of the runs that started before `before` (ms) and are
    // over, the client ids of messages sent before it, and the tokens turns used before
    // it: none of them is read once it's that old. Gives how many of each went.
    pub fn prune_rows(self, before: i64, most: i64) -> (i64, i64, i64) ! Error {
        let runs = try self.db.execute(String("DELETE FROM runs WHERE rowid IN (SELECT rowid FROM runs WHERE at < ? AND status != 'running' LIMIT ?)"), [Value.Int(before), Value.Int(most)])
        let sent = try self.db.execute(String("DELETE FROM sent WHERE rowid IN (SELECT rowid FROM sent WHERE at < ? LIMIT ?)"), [Value.Int(before), Value.Int(most)])
        let usage = try self.db.execute(String("DELETE FROM usage WHERE rowid IN (SELECT rowid FROM usage WHERE at < ? LIMIT ?)"), [Value.Int(before), Value.Int(most)])
        return (i64.wrap(u64(runs)), i64.wrap(u64(sent)), i64.wrap(u64(usage)))
    }

    // --- The event log ---

    // Stores an event for `user`: `fields` with `t`, `seq`, `kind` and `at`
    // added. Gives the event frame, ready to send.
    pub fn append(self, user: String, kind: str, fields: Json) -> Json ! Error {
        return try parse(try self.append_text(user, kind, fields))
    }

    // As append, giving the frame as the text stored, so it's written once.
    pub fn append_text(self, user: String, kind: str, fields: Json) -> String ! Error {
        let row = try self.db.query_one(String("SELECT coalesce(max(seq), 0) FROM events WHERE user = ?"), [t(user.copy())])
        let seq = int((row ?? List<Value>())[0].copy()) + 1
        let at = now()
        let head = Obj.new().s("t", String("event")).i("seq", seq).s("kind", String(kind)).i("at", at).done()
        let frame = "{merge(head, fields)}"
        _ = try self.db.execute(String("INSERT INTO events (user, seq, json, at) VALUES (?, ?, ?, ?)"), [t(user), Value.Int(seq), t(frame.copy()), Value.Int(at)])
        return frame
    }

    // The newest seq `user` has, or 0.
    pub fn last_seq(self, user: String) -> i64 ! Error {
        let row = try self.db.query_one(String("SELECT coalesce(max(seq), 0) FROM events WHERE user = ?"), [t(user)])
        return int((row ?? List<Value>())[0].copy())
    }

    // The oldest seq `user` still has, or 0 with none.
    pub fn first_seq(self, user: String) -> i64 ! Error {
        let row = try self.db.query_one(String("SELECT coalesce(min(seq), 0) FROM events WHERE user = ?"), [t(user)])
        return int((row ?? List<Value>())[0].copy())
    }

    // Removes everyone's events from before `before` (ms), but keeps each
    // person's newest `keep`, so the next seq still follows on. A device whose
    // cursor is older than what's left gets reset: true and a snapshot.
    // Gives how many went.
    pub fn prune_events(self, before: i64, keep: i64) -> i64 ! Error {
        // A person at a time, by seq, which grows with at: the oldest go up to the
        // first event that's new enough, keeping the newest `keep` whatever their age.
        var gone: u64 = 0
        var users = List<String>()
        for r in try self.db.query(String("SELECT id FROM users"), List<Value>()) { users.push(text(r[0].copy())) }
        for user in users {
            gone += u64(try self.db.execute(String("DELETE FROM events WHERE user = ?1 AND seq <= min((SELECT max(seq) FROM events WHERE user = ?1) - ?3, coalesce((SELECT seq FROM events WHERE user = ?1 AND at >= ?2 ORDER BY seq LIMIT 1) - 1, (SELECT max(seq) FROM events WHERE user = ?1)))"), [t(user.copy()), Value.Int(before), Value.Int(keep)]))
        }
        return i64.wrap(gone)
    }

    // Up to `most` of `user`'s events after `after`, in order, each its seq and the text stored.
    pub fn events_after(self, user: String, after: i64, most: usize) -> List<(i64, String)> ! Error {
        var out = List<(i64, String)>()
        for r in try self.db.query(String("SELECT seq, json FROM events WHERE user = ? AND seq > ? ORDER BY seq LIMIT ?"), [t(user), Value.Int(after), Value.Int(i64.wrap(u64(most)))]) {
            out.push((int(r[0].copy()), text(r[1].copy())))
        }
        return out
    }

    // Run `run`'s tool calls among `user`'s events after `after`, in the order they
    // started: each with how it ended (tool.finished's status), or "" for one still
    // open, and whether a rule or the person said no to it (approval.answered).
    pub fn run_calls(self, user: String, run: String, after: i64) -> List<(String, String, bool)> ! Error {
        var ends = LinkedMap<String, String>()
        var refused = List<String>()
        let sql = "SELECT json_extract(json, '$.kind'), json_extract(json, '$.call'), json_extract(json, '$.run'), json_extract(json, '$.status'), json_extract(json, '$.allow'), json_extract(json, '$.by') FROM events WHERE user = ? AND seq > ? AND json_extract(json, '$.kind') IN ('tool.started', 'tool.finished', 'approval.answered') ORDER BY seq"
        for r in try self.db.query(String(sql), [t(user), Value.Int(after)]) {
            let kind = text(r[0].copy())
            let call = text(r[1].copy())
            if kind == "tool.started" {
                if text(r[2].copy()) == run { ends.insert(call, String()) }
            } else if let _ = ends.find(call.copy()) {
                if kind == "tool.finished" {
                    ends.insert(call, text(r[3].copy()))
                } else if int(r[4].copy()) == 0 and text(r[5].copy()) != "cancel" {
                    // A no from a rule or the person, not the turn ending.
                    refused.push(call)
                }
            }
        }
        var out = List<(String, String, bool)>()
        for (call, status) in ends { out.push((call.copy(), status.copy(), refused.contains(call.copy()))) }
        return out
    }

    // The seq of `user`'s last event before run `run` started, for run_calls.
    pub fn seq_before_run(self, user: String, run: String) -> i64 ! Error {
        let sql = "SELECT coalesce((SELECT min(seq) - 1 FROM events WHERE user = ?1 AND at >= (SELECT at FROM runs WHERE id = ?2)), (SELECT max(seq) FROM events WHERE user = ?1), 0)"
        let row = try self.db.query_one(String(sql), [t(user), t(run)])
        return int((row ?? List<Value>())[0].copy())
    }
}

// A recall as FTS5 reads it: any of the words, each in quotes and a prefix,
// best match first. None when it has no words.
// How many site notes an agent is shown on a visit.
const SITE_NOTES_MOST: usize = 20

// A site, as a note is tied to it: an address's or a host's host and port,
// lowercase, without who's logged in or a leading www. So
// "https://www.Example.com/login" is example.com. "" for a file or nothing.
pub fn site_of(given: String) -> String {
    var s = given.trim().to_lower_root()
    if let k = s.find("://") { s = s[k + 3..].copy() }
    for end in ["/", "?", "#"] {
        if let k = s.find(end) { s = s[..k].copy() }
    }
    if let k = s.find_last("@") { s = s[k + 1..].copy() }
    if s.starts_with("www.") { s = s[4..].copy() }
    return s
}

// Whether a note tied to `site` is for a page on `here`: the same site, or one
// under it. Both as site_of gives them.
pub fn site_covers(site: String, here: String) -> bool {
    if site.len() == 0 or here.len() == 0 { return false }
    return here == site or here.ends_with(".{site}")
}

// A recording from id, agent, steps, proposal and at.
fn recording_of(r: List<Value>) -> Json {
    let steps = match parse(text(r[2].copy())) {
        ok(j) => j,
        err(_) => Json.Array(List<Json>()),
    }
    return Obj.new().s("id", text(r[0].copy())).s("agent", text(r[1].copy())).j("steps", steps).s("proposal", text(r[3].copy())).i("at", int(r[4].copy())).done()
}

// A proposal from id, agent, kind, data, why, recording, status, at, decided,
// by and its recording's steps.
fn proposal_of(r: List<Value>) -> Json {
    let kind = text(r[2].copy())
    let data = match parse(text(r[3].copy())) {
        ok(j) => j,
        err(_) => Obj.new().done(),
    }
    var o = Obj.new().s("id", text(r[0].copy())).s("agent", text(r[1].copy())).s("kind", kind.copy()).j(if kind == "skill" { "skill" } else { "note" }, data).s("why", text(r[4].copy())).s("status", text(r[6].copy())).i("at", int(r[7].copy()))
    let decided = int(r[8].copy())
    if decided > 0 { o = o.i("decided", decided).s("by", text(r[9].copy())) }
    let recording = text(r[5].copy())
    if recording.len() > 0 {
        let steps = match parse(text(r[10].copy())) {
            ok(j) => j,
            err(_) => Json.Array(List<Json>()),
        }
        o = o.s("recording", recording).j("steps", steps)
    }
    return o.done()
}

fn fts_any(query: String) -> String? {
    var parts = List<String>()
    for w in query.split_whitespace() {
        parts.push("\"{w.replace("\"", "\"\"")}\"*")
    }
    if parts.len() == 0 { return none }
    return some(parts.join(" OR "))
}

// A search as FTS5 reads it: each word in quotes, so nothing in it is taken as
// FTS5's own syntax, and the last a prefix, for searching while typing. None when
// it has no words.
fn fts_query(query: String) -> String? {
    var parts = List<String>()
    for w in query.split_whitespace() {
        parts.push("\"{w.replace("\"", "\"\"")}\"")
    }
    if parts.len() == 0 { return none }
    let n = parts.len()
    parts[n - 1].push_str("*")
    return some(parts.join(" "))
}

// `user`'s messages that have every word of `query`, the last one as a prefix, best
// first: each message, and the words around the match with each matched word
// between MARK_START and MARK_END. Only in conversations that aren't deleted; with
// `agent`, only that agent's; with `after` or `before`, only from that time on, or
// before it (Unix ms). On any connection to the database, so server/searcher.calx
// runs it off the loop.
pub fn search_in(db: Database, user: String, query: String, agent: String?, after: i64?, before: i64?, limit: usize) -> List<(Json, String)> ! Error {
    var out = List<(Json, String)>()
    let fts = fts_query(query) else return out
    var sql = String("SELECT m.json, snippet(messages_fts, 0, char(2), char(3), '…', 16) FROM messages_fts f JOIN messages m ON m.rowid = f.rowid JOIN conversations c ON c.id = m.conversation AND c.deleted = 0 WHERE messages_fts MATCH ? AND f.user = ?")
    var args: List<Value> = [t(fts), t(user)]
    if let a = agent {
        sql.push_str(" AND f.agent = ?")
        args.push(t(a))
    }
    if let a = after {
        sql.push_str(" AND m.at >= ?")
        args.push(Value.Int(a))
    }
    if let b = before {
        sql.push_str(" AND m.at < ?")
        args.push(Value.Int(b))
    }
    sql.push_str(" ORDER BY rank LIMIT ?")
    args.push(Value.Int(i64.wrap(u64(limit))))
    for r in try db.query(sql, args) {
        out.push((try parse(text(r[0].copy())), plain_snippet(text(r[1].copy()))))
    }
    return out
}

// `messages.search`'s answer for `args`: `results`, each a `message` and its `snippet`,
// 30 unless `limit` says otherwise, from 1 to 100.
pub fn search_answer_in(db: Database, user: String, args: Json) -> Json ! Error {
    let limit = int_at(args.copy(), "limit") ?? 30
    let n: i64 = if limit < 1 { 1 } else if limit > 100 { 100 } else { limit }
    var results = List<Json>()
    for (message, snippet) in try search_in(db, user, str_at(args.copy(), "query") ?? String(), str_at(args.copy(), "agent"), int_at(args.copy(), "after"), int_at(args, "before"), usize.try_from(n) ?? 30) {
        results.push(Obj.new().j("message", message).s("snippet", snippet).done())
    }
    return Obj.new().j("results", Json.Array(results)).done()
}

fn test_store() -> Store {
    return Store.open(String(":memory:"), PasswordHasher { memory_kib: 64, iterations: 1, parallelism: 1 })!
}

@test
fn an_old_activity_log_gets_the_record_columns() {
    let dir = fs.temp_dir()!
    let path = "{dir}/loom.db"
    let old = Database.open(path.copy())!
    old.execute_script(String("CREATE TABLE activity (id INTEGER PRIMARY KEY, user TEXT NOT NULL, agent TEXT NOT NULL, kind TEXT NOT NULL, text TEXT NOT NULL, by TEXT NOT NULL, at INTEGER NOT NULL); INSERT INTO activity (user, agent, kind, text, by, at) VALUES ('u_1', 'a_1', 'notify', 'Notified you: Build', 'a_1', 1);"))!
    old.close()!
    let entries = record_in(path)
    assert(entries.len() == 2 and "{entries[0]}".contains(#""status":"done""#) and not "{entries[1]}".contains("status"))
    fs.remove_dir_all(dir)!
}

@test
fn old_runs_get_the_routine_columns_and_the_status_reads_routine_runs_only() {
    let dir = fs.temp_dir()!
    let path = "{dir}/loom.db"
    let old = Database.open(path.copy())!
    old.execute_script(String("CREATE TABLE runs (id TEXT PRIMARY KEY, user TEXT NOT NULL, conversation TEXT NOT NULL, status TEXT NOT NULL, at INTEGER NOT NULL); INSERT INTO runs VALUES ('run_old', 'u_1', 'c_1', 'done', 5); INSERT INTO runs VALUES ('run_chat', 'u_1', 'c_1', 'done', 6); INSERT INTO runs VALUES ('run_long_ago', 'u_1', 'c_1', 'done', 1); INSERT INTO runs VALUES ('run_theirs', 'u_2', 'c_2', 'done', 7);"))!
    old.close()!
    let s = Store.open(path, PasswordHasher { memory_kib: 64, iterations: 1, parallelism: 1 })!
    for id in ["run_old", "run_long_ago", "run_theirs"] {
        s.mark_run_routine(String(id), String("rt_1"))!
    }
    assert(s.routine_runs_since(String("u_1"), 2, 10)! == [(5, String("done"), String("rt_1"))])
    // How the routine said it went, over how the turn ended.
    s.routine_run_went(String("run_old"), String("failed"))!
    assert(s.routine_runs_since(String("u_1"), 2, 10)! == [(5, String("failed"), String("rt_1"))])
    assert(s.routine_runs_since(String("u_1"), 0, 1)!.len() == 1)
    s.close()!
    fs.remove_dir_all(dir)!
}

@test
fn an_old_status_token_gets_where_it_was_saved_and_a_new_one_keeps_it() {
    let dir = fs.temp_dir()!
    let path = "{dir}/loom.db"
    let old = Database.open(path.copy())!
    old.execute_script(String("CREATE TABLE status_tokens (user TEXT PRIMARY KEY, hash TEXT NOT NULL UNIQUE, at INTEGER NOT NULL); INSERT INTO status_tokens VALUES ('u_1', 'h_1', 5);"))!
    old.close()!
    let s = Store.open(path, PasswordHasher { memory_kib: 64, iterations: 1, parallelism: 1 })!
    assert(s.status_saved(String("u_1"))! == some((String(), String())))
    s.set_status_token(String("u_1"), String("h_2"), String("/srv/dash/token"), String("Ada"))!
    assert(s.status_saved(String("u_1"))! == some((String("/srv/dash/token"), String("Ada"))))
    assert(s.status_token_user(String("h_2"))! == some(String("u_1")) and s.status_token_user(String("h_1"))! == none)
    // One made in the app again was saved nowhere.
    s.set_status_token(String("u_1"), String("h_3"), String(), String())!
    assert(s.status_saved(String("u_1"))! == some((String(), String())))
    s.drop_status_token(String("u_1"))!
    assert(s.status_saved(String("u_1"))! == none)
    s.close()!
    fs.remove_dir_all(dir)!
}

// Opens the store at `path`, records an action and settles it, and gives
// the log. The store is closed once it's given.
fn record_in(path: String) -> List<Json> {
    let s = Store.open(path, PasswordHasher { memory_kib: 64, iterations: 1, parallelism: 1 })!
    let id = s.record(String("u_1"), String("a_1"), "tool", String("remember"), String("args"), String("a_1"))!
    s.settle(id, "done", String())!
    let entries = s.activity(String("u_1"), none, none, 10)!
    s.close()!
    return entries
}

// Writes to the store at `path` from a connection of its own, as a `loom` command
// does while the instance runs, and says how it went.
struct OtherProcess {
    path: String
    said: Sender<String>
}

impl Task for OtherProcess {
    fn run(own self) {
        let s = match Store.open(self.path.copy(), PasswordHasher { memory_kib: 64, iterations: 1, parallelism: 1 }) {
            ok(s) => s,
            err(e) => {
                self.said.send("{e}")
                return
            },
        }
        let how = match s.begin() {
            ok(began) => match s.set_meta(String("other"), String("1")) {
                ok => match s.commit(began) {
                    ok => String("ok"),
                    err(e) => "{e}",
                },
                err(e) => {
                    s.rollback(began)
                    "{e}"
                },
            },
            err(e) => "{e}",
        }
        self.said.send(how)
        match s.close() {
            ok => {},
            err(_) => {},
        }
    }
}

@test
fn a_held_frame_waits_for_another_connection_rather_than_failing() {
    // A connection that had read in its transaction couldn't write once another had
    // written since: "database is locked", at once, whatever the busy timeout.
    let dir = fs.temp_dir()!
    let path = "{dir}/loom.db"
    let s = Store.open(path.copy(), PasswordHasher { memory_kib: 64, iterations: 1, parallelism: 1 })!
    s.hold()!
    _ = s.meta(String("mine"))!
    var said = Receiver<String>()
    let other = unsafe { Thread.spawn(OtherProcess { path: path.copy(), said: said.sender() }) }
    unsafe { sleep(300000000) }
    s.set_meta(String("mine"), String("1"))!
    s.let_go()!
    other.join()
    assert((said.wait() ?? String()) == "ok")
    assert(s.meta(String("other"))! == some(String("1")) and s.meta(String("mine"))! == some(String("1")))
    s.close()!
    fs.remove_dir_all(dir)!
}

@test
fn work_that_fails_leaves_no_transaction_open() {
    let s = test_store()
    let began = s.begin()!
    assert(began)
    s.set_meta(String("half"), String("1"))!
    s.rollback(began)
    assert(not s.db.in_transaction() and s.meta(String("half"))! == none)
    // Inside a held transaction it's a savepoint: undone alone, and the hold goes on.
    s.hold()!
    s.set_meta(String("kept"), String("1"))!
    let inner = s.begin()!
    assert(not inner)
    s.set_meta(String("half"), String("1"))!
    s.rollback(inner)
    assert(s.db.in_transaction())
    s.let_go()!
    assert(s.meta(String("kept"))! == some(String("1")) and s.meta(String("half"))! == none)
    // A failed request's leftover is rolled back.
    _ = s.begin()!
    s.set_meta(String("left"), String("1"))!
    s.abandon()
    assert(not s.db.in_transaction() and s.meta(String("left"))! == none)
}

@test
fn ids_count_per_kind() {
    let s = test_store()
    assert(s.new_id("u")! == "u_1")
    assert(s.new_id("u")! == "u_2")
    assert(s.new_id("d")! == "d_1")
}

@test
fn passwords_and_tokens() {
    let s = test_store()
    let u = s.add_user(String("elliot"), String("correct horse"), "owner")!
    assert(s.check_password(String("elliot"), String("correct horse"))! != none)
    assert(s.check_password(String("elliot"), String("wrong"))! == none)
    assert(s.check_password(String("nobody"), String("correct horse"))! == none)
    let (d, token) = s.add_device(u.id.copy(), String("Desk"), String("windows"), String("Europe/Oslo"))!
    assert((s.device_for_token(token.copy())! ?? Device { id: String(), user: String(), name: String(), kind: String() }).id == d.id)
    s.revoke_device(d.id.copy())!
    assert(s.device_for_token(token)! == none)
}

@test
fn events_are_counted_per_person() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    let b = s.add_user(String("b"), String("password2"), "member")!
    let e1 = s.append(a.id.copy(), "x", Obj.new().s("n", String("one")).done())!
    _ = s.append(a.id.copy(), "x", Obj.new().done())!
    let f1 = s.append(b.id.copy(), "x", Obj.new().done())!
    assert("{e1}".contains("\"seq\":1") and "{e1}".contains("\"n\":\"one\""))
    assert("{f1}".contains("\"seq\":1"))
    assert(s.last_seq(a.id.copy())! == 2)
    assert(s.events_after(a.id.copy(), 1, 100)!.len() == 1)
    assert(s.events_after(b.id.copy(), 0, 100)!.len() == 1)
}

@test
fn a_runs_calls_say_how_they_ended() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    _ = s.append(a.id.copy(), "x", Obj.new().done())!
    s.add_run(a.id.copy(), String("run_1"), String("c_1"))!
    let before = s.seq_before_run(a.id.copy(), String("run_1"))!
    // At most the last event before it: one in the same millisecond counts as after.
    assert(before <= 1)
    _ = s.append(a.id.copy(), "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).done())!
    _ = s.append(a.id.copy(), "tool.started", Obj.new().s("run", String("run_2")).s("call", String("tc_2")).done())!
    _ = s.append(a.id.copy(), "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_3")).done())!
    _ = s.append(a.id.copy(), "tool.finished", Obj.new().s("call", String("tc_1")).s("status", String("done")).done())!
    _ = s.append(a.id.copy(), "tool.finished", Obj.new().s("call", String("tc_2")).s("status", String("failed")).done())!
    // A rule's no to one, and a turn's end answering another's question.
    _ = s.append(a.id.copy(), "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_4")).done())!
    _ = s.append(a.id.copy(), "approval.answered", Obj.new().s("call", String("tc_3")).b("allow", false).s("by", String("rule")).done())!
    _ = s.append(a.id.copy(), "approval.answered", Obj.new().s("call", String("tc_4")).b("allow", false).s("by", String("cancel")).done())!
    let calls = s.run_calls(a.id.copy(), String("run_1"), before)!
    assert(calls.len() == 3)
    assert(calls[0].0 == "tc_1" and calls[0].1 == "done" and not calls[0].2)
    assert(calls[1].0 == "tc_3" and calls[1].1 == "" and calls[1].2)
    assert(calls[2].0 == "tc_4" and calls[2].1 == "" and not calls[2].2)
}

// A message of 100 bytes as it's stored, in conversation `c`.
fn sized_message(c: String, n: i64) -> Json {
    let m = Obj.new().s("id", "msg_{c}_{n}").s("conversation", c.copy()).s("role", String("person")).i("at", n).done()
    // `,"t":""` adds 7, and the padding the rest.
    let pad = 100 - "{m}".len() - 7
    return Obj.new().s("id", "msg_{c}_{n}").s("conversation", c).s("role", String("person")).i("at", n).s("t", " ".repeat(pad)).done()
}

// The ids of the messages in a JSON array's text.
fn message_ids(array: String) -> List<String> {
    var out = List<String>()
    if let ok(Json.Array(ms)) = parse(array) {
        for m in ms {
            out.push(str_at(m.copy(), "id") ?? String())
        }
    }
    return out
}

// The ids of a page of tasks.
fn task_ids(tasks: List<Json>) -> List<String> {
    var out = List<String>()
    for k in tasks {
        out.push(str_at(k.copy(), "id") ?? String())
    }
    return out
}

@test
fn a_snapshot_keeps_to_its_budget_newest_conversations_first() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    var ids = List<String>()
    for name in ["one", "two", "three", "empty"] {
        ids.push(str_at(s.add_conversation(a.id.copy(), String("a_1"), String(name))!, "id") ?? String())
    }
    // One's three messages, then two's five, then three's one, the newest of all.
    for n in 1..4 {
        s.put_message(a.id.copy(), sized_message(ids[0].copy(), i64(n)))!
    }
    for n in 4..9 {
        s.put_message(a.id.copy(), sized_message(ids[1].copy(), i64(n)))!
    }
    s.put_message(a.id.copy(), sized_message(ids[2].copy(), 9))!
    assert("{sized_message(ids[0].copy(), 1)}".len() == 100)
    // Room for everything.
    let (all, none_left) = s.snapshot_messages(a.id.copy(), 50, 10000)!
    assert(none_left.len() == 0 and message_ids(all).len() == 9)
    // Room for four: three's one, two's newest three, and none of one's.
    let (some_of, left) = s.snapshot_messages(a.id.copy(), 50, 405)!
    assert(left == [ids[1].copy(), ids[0].copy()])
    assert(some_of.len() <= 405)
    assert(message_ids(some_of) == ["msg_{ids[1]}_6", "msg_{ids[1]}_7", "msg_{ids[1]}_8", "msg_{ids[2]}_9"])
    // At most `per` of each.
    let (_, cut) = s.snapshot_messages(a.id.copy(), 2, 10000)!
    assert(cut == [ids[1].copy(), ids[0].copy()])
    // None at all: every conversation with messages is named, and the empty one isn't.
    let (empty, every) = s.snapshot_messages(a.id.copy(), 50, 0)!
    assert(empty == "[]" and every == [ids[2].copy(), ids[1].copy(), ids[0].copy()])
}

@test
fn tasks_come_a_page_at_a_time_newest_first() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    s.put_agent(a.id.copy(), Obj.new().s("id", String("a_1")).done(), String("d_1"))!
    s.put_agent(a.id.copy(), Obj.new().s("id", String("a_2")).done(), String("d_1"))!
    for n in 1..6 {
        s.put_task(a.id.copy(), Obj.new().s("id", "k_{n}").s("agent", String("a_1")).s("conversation", "c_{n}").s("status", String("done")).done())!
    }
    s.put_task(a.id.copy(), Obj.new().s("id", String("k_gone")).s("agent", String("a_2")).s("conversation", String("c_9")).s("status", String("done")).done())!
    s.delete_agent(a.id.copy(), String("a_2"))!
    // A change keeps a task's place.
    s.put_task(a.id.copy(), Obj.new().s("id", String("k_2")).s("agent", String("a_1")).s("conversation", String("c_2")).s("status", String("failed")).done())!
    let (first, more) = s.tasks(a.id.copy(), none, 2)!
    assert(task_ids(first) == ["k_5", "k_4"] and more)
    let (second, more_again) = s.tasks(a.id.copy(), some(String("k_4")), 2)!
    assert(task_ids(second) == ["k_3", "k_2"] and more_again)
    let (last, no_more) = s.tasks(a.id.copy(), some(String("k_2")), 2)!
    assert(task_ids(last) == ["k_1"] and not no_more)
    let (all, _) = s.tasks(a.id.copy(), none, 200)!
    assert(all.len() == 5)
}

@test
fn old_runs_sent_ids_and_usage_are_pruned_but_not_a_run_still_going() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    for id in ["run_old", "run_going", "run_new", "run_old2"] {
        s.add_run(a.id.copy(), String(id), String("c_1"))!
        s.remember_sent(String("d_1"), "m_{id}", "msg_{id}", String(id))!
        s.add_usage(a.id.copy(), String("fake"), String(id), 1, 1, 2, false)!
    }
    // Three are old, one of them still going.
    s.db.execute_script(String("UPDATE runs SET at = 1000 WHERE id != 'run_new'; UPDATE runs SET status = 'done' WHERE id != 'run_going'; UPDATE sent SET at = 1000 WHERE run != 'run_new'; UPDATE usage SET at = 1000 WHERE run != 'run_new';"))!
    // Nothing is that old.
    assert(s.prune_rows(500, 100)! == (0, 0, 0))
    // At most one of each a pass.
    assert(s.prune_rows(2000, 1)! == (1, 1, 1))
    assert(s.prune_rows(2000, 100)! == (1, 2, 2))
    assert(s.prune_rows(2000, 100)! == (0, 0, 0))
    assert(s.count("SELECT count(*) FROM runs", List<Value>())! == 2)
    assert(s.unfinished_runs()!.len() == 1)
    assert(s.sent(String("d_1"), String("m_run_new"))! != none and s.sent(String("d_1"), String("m_run_old"))! == none)
    assert(s.shared_used(a.id.copy(), String("fake"), 0)! == 0 and s.count("SELECT count(*) FROM usage", List<Value>())! == 1)
}

@test
fn sent_ids_from_before_they_were_dated_count_from_the_update() {
    let dir = fs.temp_dir()!
    let path = "{dir}/loom.db"
    let old = Database.open(path.copy())!
    old.execute_script(String("CREATE TABLE sent (device TEXT NOT NULL, cid TEXT NOT NULL, message TEXT NOT NULL, run TEXT NOT NULL, PRIMARY KEY (device, cid)); INSERT INTO sent VALUES ('d_1', 'm_1', 'msg_1', 'run_1');"))!
    old.close()!
    let s = Store.open(path, PasswordHasher { memory_kib: 64, iterations: 1, parallelism: 1 })!
    assert(s.prune_rows(now() - 60000, 100)! == (0, 0, 0))
    assert(s.sent(String("d_1"), String("m_1"))! == some((String("msg_1"), String("run_1"))))
    s.close()!
    fs.remove_dir_all(dir)!
}

@test
fn old_events_are_pruned_but_the_newest_kept() {
    let s = test_store()
    let a = s.add_user(String("a"), String("password1"), "owner")!
    let b = s.add_user(String("b"), String("password2"), "member")!
    for _ in 0..5 {
        _ = s.append(a.id.copy(), "x", Obj.new().done())!
    }
    _ = s.append(b.id.copy(), "x", Obj.new().done())!
    // Nothing is old yet.
    assert(s.prune_events(0, 2)! == 0)
    // Everything is old: a keeps its newest 2, b its only one.
    assert(s.prune_events(now() + 1000, 2)! == 3)
    assert(s.first_seq(a.id.copy())! == 4 and s.last_seq(a.id.copy())! == 5)
    assert(s.last_seq(b.id.copy())! == 1)
    let next = s.append(a.id.copy(), "x", Obj.new().done())!
    assert("{next}".contains("\"seq\":6"))
}

@test
fn conversations_are_per_person() {
