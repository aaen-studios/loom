CREATE TABLE IF NOT EXISTS profiles (
    user TEXT NOT NULL REFERENCES users(id), revision INTEGER NOT NULL, text TEXT NOT NULL,
    by TEXT NOT NULL, at INTEGER NOT NULL, PRIMARY KEY (user, revision));
CREATE TABLE IF NOT EXISTS defaults (
    user TEXT PRIMARY KEY REFERENCES users(id), json TEXT NOT NULL, revision INTEGER NOT NULL,
    by TEXT NOT NULL, at INTEGER NOT NULL);
-- The folders the person put agents in, in the sidebar, in the order they were made.
CREATE TABLE IF NOT EXISTS agent_groups (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS rules (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), agent TEXT NOT NULL,
    json TEXT NOT NULL, at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS routines (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), json TEXT NOT NULL,
    next INTEGER NOT NULL);
CREATE INDEX IF NOT EXISTS routines_by_next ON routines (next);
-- Each routine's runs, which its person sees in place of the chat: the newest of each kept.
CREATE TABLE IF NOT EXISTS routine_runs (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), routine TEXT NOT NULL,
    json TEXT NOT NULL, at INTEGER NOT NULL);
CREATE INDEX IF NOT EXISTS routine_runs_newest ON routine_runs (user, routine, at);
CREATE TABLE IF NOT EXISTS flows (
    id TEXT PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), json TEXT NOT NULL);
