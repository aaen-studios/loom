module server.store

// The instance's SQLite database. Every row that belongs to someone carries
// their user id, and every query that reads one filters by it, so one
// person's data never reaches another.
//
// The event log lives here too: every change for a person is an event with a
// seq counted per person from 1, stored before it's sent (protocol.md, "The
// event log").
//
// What only the instance should read is sealed with XChaCha20-Poly1305 under
// secret.key, which sits beside the database: an ACP program's settings, and
// a routine's webhook secret. Each is bound to what it belongs to, so a
// sealed value moved to another row doesn't open.
import std.bytes
import std.crypto.{PasswordHasher, XChaCha20Poly1305, random_bytes, verify_password}
import std.env.{os}
import std.fs
import std.hash.{sha256}
import std.json.{Json, parse}
import std.regex.{Regex}
import std.sqlite.{Database, Value}
import std.thread.{Task, sleep}
import std.time.{Timestamp}
import shared.obj.{Obj, int_at, merge, str_at, without}
import server.defaults.{blank, filled}
import server.routines.{RESTARTED_WAITING}
import shared.checkpoint

// A search snippet as words, without the Markdown it was written in: a link
// as its text, no code ticks, bold or strike marks, list and heading marks,
// and on one line. The marks around matched words (U+0002 and U+0003) stay
// where they are, since only the Markdown around them goes.
pub fn plain_snippet(snippet: String) -> String {
    var s = snippet.copy()
    let steps = [
        (#"!?\[([^\]]*)\]\([^)]*\)"#, #"${1}"#),
        (#"(^|\n)[ \t]*(#+|[-*+]|>|\d+\.)[ \t]+"#, #"${1}"#),
        (#"\*\*|__|~~|`+"#, ""),
        (#"\s*\n\s*"#, " "),
    ]
    for (pattern, with) in steps {
        match Regex.new(String(pattern)) {
            ok(found) => {
                var re = found
                s = re.replace_all(s.copy(), String(with))
            },
            err(_) => {},
        }
    }
    return s
}

const SCHEMA: str = #"
