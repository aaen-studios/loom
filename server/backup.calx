module server.backup

// Backups, and what moving sends (PLAN.md, "Moving an instance"): an
// instance's data folder as one .tar.zst, written a file at a time, so a
// folder bigger than memory fits. It has:
//
// - loom.json: the format, loom's version, the instance's id, when, and the
//   ACP agents to install again where it lands;
// - loom.db: the database as a consistent snapshot, from SQLite's VACUUM
//   INTO, which is safe while the instance runs;
// - secret.key, which the sealed secrets need, so the archive is as secret
//   as they are;
// - everything else in the folder: files, agents' folders, the rest.
//
// Installed ACP agent programs (acp/) stay out, as they're for one machine
// and are installed again from the registry, and so do plugins' tool
// folders (plugins/), which the instance writes again from the database.
// `loom import` makes a new data folder from one, with `restore`.
import std.fs
import std.json.{Json, parse}
import std.sqlite.{Database, Value}
import std.tar.{StreamReader, StreamWriter}
import std.thread.{Task, sleep}
import std.time.{Timestamp}
import std.zstd
import shared.obj.{Obj}
import server.store.{now}

pub const FORMAT: i64 = 1

// The top of the data folder that doesn't go: the live database, which goes
// as its snapshot, and what's made again where it lands.
const LEFT_OUT: [str; 5] = ["loom.db", "loom.db-wal", "loom.db-shm", "acp", "plugins"]

// Writes the instance in `data` to the file `to`, and gives its loom.json.
// The file appears whole or not at all.
pub fn export(data: String, to: String, version: String) -> Json ! Error {
    let live = "{data}/loom.db"
    if not fs.exists(live.copy()) { fail "{data} has no loom.db, so it isn't an instance's folder" }
    let snapshot = "{to}.db.making"
    let making = "{to}.making"
    for leftover in [snapshot.copy(), making.copy()] {
        if fs.exists(leftover.copy()) { try fs.remove_file(leftover) }
    }
    let db = try Database.open(live)
    _ = try db.execute(String("VACUUM INTO ?"), [Value.Text(snapshot.copy())])
    try db.close()
    let copy = try Database.open(snapshot.copy())
    let instance = match try copy.query_one(String("SELECT value FROM meta WHERE key = 'instance'"), List<Value>()) {
        some(r) => text(r[0].copy()),
        none => String(),
    }
    var programs = List<Json>()
    for r in try copy.query(String("SELECT name FROM acp_agents ORDER BY name"), List<Value>()) {
        programs.push(Json.Str(text(r[0].copy())))
    }
    try copy.close()
    let manifest = Obj.new().i("format", FORMAT).s("version", version).s("instance", instance).i("at", now()).j("acp_agents", Json.Array(programs)).done()
    var w = StreamWriter.new(zstd.Writer.new(try fs.create(making.copy()), level: 9, checksum: true))
    try w.add(String("loom.json"), "{manifest}".to_bytes(), mode: 0o600)
    try w.add_file(String("loom.db"), snapshot.copy())
    for name in try fs.list(data.copy()) {
        var skip = name.ends_with(".making")
        for out in LEFT_OUT {
            if name == out { skip = true }
        }
        if skip { continue }
        let path = "{data}/{name}"
        if fs.is_dir(path.copy()) {
            try w.add_tree(name, path)
        } else {
            try w.add_file(name, path)
        }
    }
    let z = try w.finish()
    let file = try z.finish()
    try file.close()
    try fs.remove_file(snapshot)
    // It holds the key to the instance's secrets: only its owner reads it.
    if fs.separator() == "/" { try fs.set_mode(making.copy(), 0o600) }
    try fs.rename_synced(making, to)
    return manifest
}

// Makes a new instance's data folder, `data`, from the file `from`, and gives
// its loom.json. `data` must hold no instance already.
pub fn restore(from: String, data: String) -> Json ! Error {
    if fs.exists("{data}/loom.db") { fail "{data} holds an instance already: import makes a new one, in a folder of its own" }
    try fs.make_dir_all(data.copy())
    var r = StreamReader.new(zstd.Reader.new(try fs.open_read(from.copy())))
    try r.extract(data.copy())
    let file = (try r.finish()).into_inner()
    try file.close()
    let told = "{data}/loom.json"
    let written = try fs.read_text(told.copy()) ?? String()
    let manifest = match parse(written) {
        ok(m) => m,
        err(_) => fail "{from} isn't a loom backup: it has no loom.json",
    }
    let format = (manifest.get(String("format")) ?? Json.Null).as_i64() ?? 0
    if format != FORMAT { fail "{from} is a backup of format {format}, and this loom reads format {FORMAT}: update loom" }
    try fs.remove_file(told)
    if not fs.exists("{data}/loom.db") { fail "{from} has no database in it" }
    if fs.separator() == "/" {
        try fs.set_mode(data.copy(), 0o700)
        if fs.exists("{data}/secret.key") { try fs.set_mode("{data}/secret.key", 0o600) }
    }
    return manifest
}

fn text(v: Value) -> String {
    return match v {
        Value.Text(t) => t.copy(),
        _ => String(),
    }
}

// --- Scheduled backups ---

// Backups on a schedule (`loom serve --backups DIR`): on a thread of its own,
// so the instance goes on while one is written, a backup to `dir` every
// `every_ms`, named by when it was made, in UTC, as
// loom-2026-11-21-081200.tar.zst. The newest `keep` stay. The first comes
// `every_ms` after the newest one in `dir`, or at once when there's none, so
// restarting the instance doesn't make an extra one.
pub struct Schedule {
    pub data: String
    pub dir: String
    pub every_ms: i64
    pub keep: usize
    pub version: String
}

// After a backup that failed, the next try is this much later, or `every_ms`
// if that's sooner.
const RETRY_MS: i64 = 3600000

impl Task for Schedule {
    fn run(own self) {
        var tried: i64 = 0
        loop {
            let newest = match self.newest() {
                ok(n) => n,
                err(e) => {
                    eprintln("loom: backups in {self.dir}: {e}")
                    0
                },
            }
            var due = if newest > 0 { newest + self.every_ms } else { 0 }
            let retry = tried + (if self.every_ms < RETRY_MS { self.every_ms } else { RETRY_MS })
            if tried > 0 and retry > due { due = retry }
            let wait = due - now()
            if wait > 0 { unsafe { sleep(u64.wrap(wait) * 1000000) } }
            tried = now()
            match self.once() {
                ok(name) => println("loom: backed up to {name}"),
                err(e) => eprintln("loom: a scheduled backup to {self.dir}: {e}"),
            }
        }
    }
}

impl Schedule {
    // Writes one backup, and lets the oldest go past `keep`. Gives its path.
    fn once(self) -> String ! Error {
        try fs.make_dir_all(self.dir.copy())
        let name = "loom-{Timestamp { unix_ms: now() }.format("%Y-%m-%d-%H%M%S", 0)}.tar.zst"
        let path = "{self.dir}/{name}"
        _ = try export(self.data.copy(), path.copy(), self.version.copy())
        let kept = try self.backups()
        if kept.len() > self.keep {
            for old in kept[..kept.len() - self.keep] {
                try fs.remove_file("{self.dir}/{old}")
            }
        }
        return path
    }

    // When the newest backup in `dir` was made, in Unix ms, or 0 for none.
    fn newest(self) -> i64 ! Error {
        let kept = try self.backups()
        if kept.len() == 0 { return 0 }
        return (try fs.metadata("{self.dir}/{kept[kept.len() - 1]}")).modified.unix_ms
    }

    // The backups in `dir`, oldest first, which their names sort.
    fn backups(self) -> List<String> ! Error {
        var out = List<String>()
        if not fs.exists(self.dir.copy()) { return out }
        for name in try fs.list(self.dir.copy()) {
            if is_backup(name.copy()) { out.push(name.copy()) }
        }
        out.sort()
        return out
    }
}

// Whether `name` is one of the scheduled backups' names.
fn is_backup(name: String) -> bool {
    return name.starts_with("loom-") and name.ends_with(".tar.zst") and name.len() == "loom-2026-11-21-081200.tar.zst".len()
}

// Starts the scheduled backups' thread.
pub fn start(s: own Schedule) {
    _ = unsafe { Thread.spawn(s) }
}

@test
fn only_backups_are_backups() {
    assert(is_backup(String("loom-2026-11-21-081200.tar.zst")))
    assert(not is_backup(String("loom-notes.tar.zst")) and not is_backup(String("other-2026-11-21-081200.tar.zst")))
}
