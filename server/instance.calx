pub struct Config {
    pub data: String
    pub port: u16
    pub host: String
    pub hasher: PasswordHasher
    pub events: EventLife
    pub registry: String    // the ACP Registry's address
    pub minute_ms: i64    // how long a minute is, for routines: 60,000, but less in tests
    pub apns: String    // where APNs is, or "" for Apple's: a test's fake one
    pub version: String    // loom's version, for what a move says it came from
    pub lan: bool    // whether phones may reach it on the network, through the Noise bridge: an instance in the desktop app
    pub sandboxes: String    // what runs sandboxes for everyone but the owner (podman), or "" for none
    pub sandbox_image: String    // the image they run
}

// How long events are kept (PLAN.md, "Sync"): `age_ms`, but always each
// person's newest `keep`, looked at every `every_ms`. A device further behind
// gets reset: true and a snapshot.
pub struct EventLife {
    pub age_ms: i64
    pub keep: i64
    pub every_ms: i64
}

impl EventLife {
    // 30 days, the newest 10,000, looked at every hour.
    pub fn standard() -> EventLife {
        return EventLife { age_ms: 30 * 86400000, keep: 10000, every_ms: 3600000 }
    }
}

struct Session {
    socket: ServerSocket
    user: String
    device: String
    live: bool
    key: String    // the device's public key, as it says it
    tools: Json    // what it offers as a tool, and how: {run_command: "ask", ...}
}

// A call to one of the person's devices, until its result comes.
struct DeviceCall {
    user: String
    device: String
    agent: String
    title: String
}

struct Block {
    kind: String
    text: String
    call: String
    entries: Json
    file: Json    // a file block's `file`, `name`, `mime` and `size`
    card: Json    // a card block's card (server/cards.calx)
}

fn new_block(kind: str) -> Block {
    return Block { kind: String(kind), text: String(), call: String(), entries: Json.Null, file: Json.Null, card: Json.Null }
}

struct Run {
    id: String
    user: String
    conversation: String
    agent: String
    message: String    // the reply's id
    answering: String
    prompt: String
    files: List<Json>    // the files sent with the prompt
    session: String    // the ACP session, once there is one
    blocks: List<Block>
    tools: LinkedMap<String, String>    // ACP toolCallId -> tc_ id
    denied: List<String>
    from: String    // where the person is writing from, as the agent is told it
    usage: Json    // the tokens the turn used, as its program reported them: input, output and total
    note: String    // what loom tells the agent with this prompt, such as that it was stopped for it, or ""
    program: String    // the agent program answering it: the agent's, the one its chat moved to, or its backup
    proc: String    // the key of the program's process in `procs`, proc_key(agent, program)
    tried: List<String>    // the programs that couldn't answer it, before its backup took over
    starter: String    // who started the turn, as rules name it: person, agent, routine, webhook, script or plugin
}

struct Approval {
    call: String
    run: String
    agent: String
    rpc: Json
    options: Json
    title: String    // what it asks, for the activity log
    action: Json    // for one of loom's own tools: the command to run if allowed, {name, args}; null for an ACP request
    proc: String    // for an ACP request: the key of the process that asked, in `procs`
}

// A command's answer: its value, or its error's code and message.
enum Answer {
    Value(Json)
    Refused(String, String)
}

enum Pending {
    Init
    NewSession(String)
    Resume(String, String)    // the run, and the session picked up again
    Prompt(String)
    Config(String, String, String, String)    // the run, its session, and the option and value being set
}

struct Proc {
    agent: String
    user: String
    to: Sender<Out>
    ready: bool
    images: bool    // whether the program takes images in a prompt
    program: String    // the ACP agent it runs, by loom's name for it
    resume: bool    // whether it offers session/resume
    load: bool    // whether it offers session/load
    mcp_http: bool    // whether it connects to MCP servers over HTTP itself
    boxed: bool    // whether it runs in its person's sandbox
    shared: bool    // whether it runs on the program's settings the owner shared, under a budget
    next_id: i64
    pending: Map<i64, Pending>
    sessions: Map<String, String>    // conversation -> ACP session
    told: Map<String, String>    // ACP session -> where it was last told the person is
    profiled: Map<String, i64>    // ACP session -> the revision of the person's profile it has
    configs: Map<String, Json>    // ACP session -> its configOptions, as it last gave them
    waiting: List<String>
    key: String    // its key in `procs`: proc_key(agent, program)
    stopped: bool    // whether it was told to stop, so it's let go of
}

pub struct Instance {
    store: Store
    server: Server
    data: String
    sessions: Map<u32, Session>
    runs: LinkedMap<String, Run>
    procs: LinkedMap<String, Proc>
    approvals: LinkedMap<String, Approval>
    lines: Receiver<Line>
    lines_to: Sender<Line>
    hash_to: Sender<Job>
    hash_done: Receiver<Done>
    next_job: i64
    auths: Map<i64, Auth>
    dummy_hash: String
    failures: LinkedMap<String, List<i64>>
    thumbs: Sender<Thumb>
    events: EventLife
    next_prune: i64
    grants: Map<String, Grant>    // token -> whose tools
    calls: Map<String, Request>    // run -> a message_agent call waiting on it
    context: Map<String, (i64, i64)>    // ACP session -> the tokens in its context, and its window, as usage_update last said
    registry_at: String    // the ACP Registry's address
    registry: Json    // what it last said, or null
    registry_time: i64    // when
    registry_fetching: bool    // whether a read of it is under way
    install_to: Sender<installer.Job>
    install_done: Receiver<installer.Done>
    fetching: List<Waiter>    // commands waiting on the registry
    installs: Map<i64, Install>    // installs on the installer's thread
    deno_job: i64    // the installer's job fetching Deno for Code Mode, or 0
    deno_waiters: List<Request>    // loom mcp's asks for Deno, answered once it's fetched
    code_acts: Map<i64, String>    // a script's call to an MCP server, as recorded -> the token it came with
    leftovers: List<String>    // folders of removed ACP agents and plugins, removed once their programs have let go
    device_calls: Map<String, DeviceCall>    // tc_ id -> a call sent to a device
    sealer: XChaCha20Poly1305    // seals and opens secrets, with secret.key, which only the instance reads
    next_sweep: i64
    minute_ms: i64
    next_due: i64    // when to look for routines that are due
    routine_runs: Map<String, RoutineRun>    // run -> the routine it's for
    routine_marks: Map<String, (String, String)>    // a routine run -> how its agent said it went: quiet or failed, and why
    run_chains: Map<String, List<String>>    // a run message_agent started -> the agents that asked on the way, oldest first
    panel_calls: Map<String, Waiter>    // run -> a panel's plugin.message waiting on it
    script_calls: Map<String, Request>    // a script's ask, by its run, answered when the run ends
    running_flows: LinkedMap<String, flows.Flow>    // routine flows that are running, by id
    flow_steps: Map<String, (String, usize)>    // a step's run -> its flow and which step
    advancing: List<String>    // flows advance_flow has out of running_flows, newest last
    flow_results: List<(String, usize, bool, String)>    // steps that ended meanwhile: flow, step, whether it worked, its answer
    flows_due: List<String>    // flows to move along from the loop, by id
    slow_calls: Map<String, String>    // call -> user, for an agent's slow command its person allowed
    acting: i64    // the action a tool call being done is recorded as, while it is
    call_actions: Map<String, i64>    // a call held in calls -> the action it is
    tool_actions: Map<String, i64>    // an ACP tool call (tc_ id) -> the action it is
    push_to: Sender<push.Job>    // the thread that sends to APNs
    push_gone: Receiver<push.Gone>    // tokens APNs says are gone
    move_to: Sender<move.Job>    // the thread that sends a move
    move_done: Receiver<move.Done>
    lan: bool    // whether phones may reach it on the network: an instance in the desktop app
    bridge: Thread?    // the Noise bridge on the network (server/noise.calx), while phones are on
    stop_bridge: Sender<bool>?
    lan_port: u16    // its port, while it runs
    announcer: Thread?    // says where it is on the local network, with mDNS, while phones are on (server/announce.calx)
    stop_announcer: Sender<bool>?
    to_close: List<ServerSocket>    // sessions of someone removed, closed once the command that did it is answered
    boxes: sandbox.Sandboxes?    // where the agents of everyone but the owner run (server/sandbox.calx)
    gate: Thread?    // the sandboxes' way to loom's tools (server/gate.calx)
    stop_gate: Sender<bool>?
    moving: String    // where the instance is moving to, while it is
    move_waiters: List<Waiter>    // instance.move commands waiting on the move
    moved: Json    // once the instance has moved: the signed moved frame, which every device gets
    version: String
    browsers: LinkedMap<String, Browser>    // "user/agent" -> that agent's browser, while it's open
    browser_done: Receiver<browser.Back>
    watchers: Map<u32, String>    // a session -> the browser it watches, by its key
    browser_to: Sender<browser.Back>
    stopped_browsers: List<Thread>    // browsers told to stop, joined at shutdown
    fills: Map<String, Fill>    // browser_fill_secret calls on their browser
    turns_ended: List<(String, String, String)>    // a person, a conversation and how its turn ended, for the queue
    next_browser_sweep: i64
    task_stops: Map<String, String>    // a task's run -> "pause" or "cancel", as the person asked
    resumes: List<(String, String)>    // a person and a task the restart cut short, to carry on from the loop
}

// An agent's browser (server/browser.calx), on its thread.
struct Browser {
    to: Sender<browser.In>
    thread: Thread
    busy: i64    // calls sent that haven't come back
    used: i64    // when the last one did
    open: bool    // whether the browser itself is running
    person: bool    // whether the person has taken it over
    asked: String    // what browser_ask_person said, while it waits
    asks: List<String>    // browser_ask_person calls, answered when the person hands it back
    held: List<browser.Op>    // the agent's calls while the person has it
    actions: i64    // the person's clicks and keys since they took over
    secret_ask: Json    // browser_ask_secret, while it waits: its call, why, ref and submit; or null
    site: String    // the host of the page it's on, as its last call left it, for rules on sites
    recording: bool    // whether what the person does is being recorded, to teach the agent
    steps: i64    // how many steps the recording has
    record_by: String    // the device that started it
    told: String    // the site whose notes the agent was told of last
}

// A browser_fill_secret call, until its secret is in: what it fills, for the
// person's yes when the page is on a site the secret hasn't gone to.
struct Fill {
    user: String
    agent: String
    name: String
    ref_id: String
    submit: bool
}

// A command answered later: on a device's socket, or, with none, an agent's
// run_command call, by its id in `calls`.
struct Waiter {
    socket: ServerSocket?
    id: String
}

// A run a routine started: whose, and which routine.
struct RoutineRun {
    user: String
    routine: String
}

struct Install {
    waiter: Waiter
    name: String
    version: String
    env: Json    // the person's settings for it
}

