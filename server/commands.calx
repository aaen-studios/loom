    Command { name: "plugin.put", args: #"id, files ({path: text}, plugin.toml among them)"#, does: "Makes or changes a plugin. What it asks for waits for the person." },
    Command { name: "plugin.revisions", args: "id", does: "A plugin's revisions." },
    Command { name: "plugin.delete", args: "id", does: "Deletes a plugin and its panel's data." },
    Command { name: "mcp.list", args: "", does: "The person's MCP servers." },
