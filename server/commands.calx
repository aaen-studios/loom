    Command { name: "instance.move", args: "to (the new place's address), code (from loom receive)", does: "Moves the whole instance to another computer." },
]

// Whether an agent may run `name`, and how.
pub fn access(name: String) -> Access {
    if name == "account.delete" or name == "password.reset" { return Access.Never(String("That's your person's own to do, in the app.")) }
    if name == "secret.put" { return Access.Never(String("A secret's value is never an agent's: ask your person to keep it in the app, or use browser_ask_secret.")) }
    if name == "plugin.allow" { return Access.Never(String("Only your person allows what a plugin asks for, in the app.")) }
    if name == "plugin.message" or name == "chat.ask" { return Access.Never(String("Use message_agent.")) }
    if name.starts_with("push.") or name.starts_with("plugin.data.") or name == "plugin.cmd" { return Access.Never(String("That's for an app or a plugin's panel, not an agent.")) }
    if name.starts_with("browser.") { return Access.Never(String("Use your browser_ tools.")) }
    if name == "queue.steer" { return Access.Never(String("Steering is your person's: it stops the turn that's running.")) }
    let runs = ["conversation.create", "conversation.rename", "messages.list", "messages.search", "messages.pinned", "message.pin", "agent.create", "agent.update", "agent.revisions", "agent.rollback", "activity.list", "memory.list", "memory.put", "profile.get", "profile.put", "routine.list", "routine.put", "routine.run", "task.list", "task.start", "task.pause", "task.resume", "task.cancel", "task.retry", "queue.list", "queue.edit", "queue.order", "queue.drop", "skill.list", "skill.get", "skill.put", "plugin.list", "plugin.get", "plugin.put", "plugin.revisions", "mcp.list", "secret.list", "acp.list", "acp.registry"]
    for r in runs {
        if name == r { return Access.Runs }
    }
    if name.ends_with(".delete") or name.ends_with(".remove") or name == "device.revoke" { return Access.Asks(String("delete")) }
    if name == "instance.move" { return Access.Asks(String("move")) }
    // Anything else, and anything new, asks first.
    return Access.Asks(String("other"))
}

// Every command an agent can run, for list_commands: name, args, what it
// does, and whether it runs at once or asks the person.
pub fn catalog() -> List<Json> {
    var out = List<Json>()
    for c in COMMANDS {
        let how = if access(String(c.name)) == Access.Runs { "runs at once" } else { "asks your person first" }
        out.push(Obj.new().s("name", String(c.name)).s("args", String(c.args)).s("does", String(c.does)).s("how", String(how)).done())
    }
    return out
}

// What `name` does, in a few words, for the ask the person sees: the first
// sentence of what list_commands says.
pub fn does(name: String) -> String {
    for c in COMMANDS {
        if name == c.name { return String(c.does).split(". ")[0].trim_suffix(".").copy() }
    }
    return "Run {name}"
}

@test
fn reading_runs_and_harm_asks() {
    assert(access(String("task.list")) == Access.Runs)
    assert(access(String("agent.delete")) == Access.Asks(String("delete")))
    assert(access(String("user.remove")) == Access.Asks(String("delete")))
    assert(access(String("user.list")) == Access.Asks(String("other")))
    assert(access(String("acp.install")) == Access.Asks(String("other")))
    assert(access(String("instance.move")) == Access.Asks(String("move")))
    assert(access(String("something.new")) == Access.Asks(String("other")))
    for never in ["secret.put", "plugin.allow", "plugin.message", "account.delete", "browser.open", "queue.steer"] {
        if let Access.Never(_) = access(String(never)) {} else { panic("an agent could run {never}") }
    }
    for c in COMMANDS {
        if let Access.Never(_) = access(String(c.name)) { panic("{c.name} is listed but never runs") }
    }
    assert(catalog().len() == 65)
    assert(does(String("mcp.delete")) == "Removes an MCP server")
    assert(does(String("agent.update")) == "Changes an agent")
}
