module server.commands

// What an agent may do with loom's commands (PLAN.md, "Agents can do anything the app can"):
// run_command runs any of them with the person's rights, as their app does.
// Reading and everyday changes go at once. What deletes, removes people,
// installs code, reaches outside, or opens or moves the instance asks the
// person every time. A few stay the person's alone: their account, their
// password, their secrets' values, what a plugin is allowed, and a device's
// own push token.
import std.json.{Json}
import shared.obj.{Obj}

// Whether an agent runs a command at once, asks its person first, or can't.
pub enum Access {
    Runs,
    // The kind the ask shows as: delete, move or other.
    Asks(String),
    Never(String),
}

// A command an agent can run: its name, its args, and what it does.
struct Command {
    name: str
    args: str
    does: str
}

const COMMANDS: [Command; 65] = [
    Command { name: "conversation.create", args: "agent, title?", does: "Makes a conversation with an agent." },
    Command { name: "conversation.rename", args: "conversation, title", does: "Renames a conversation." },
    Command { name: "conversation.delete", args: "conversation", does: "Deletes a conversation and its messages." },
    Command { name: "messages.list", args: "conversation, before? (a message id), limit? (up to 100)", does: "A conversation's messages, newest last." },
    Command { name: "messages.search", args: "query, agent?, after?, before? (Unix ms), limit?", does: "Finds words in every chat, and in file names." },
    Command { name: "message.pin", args: "message, pinned? (false unpins it)", does: "Pins a message in its conversation, for every device to see." },
    Command { name: "messages.pinned", args: "conversation", does: "The pinned messages in a conversation, the newest pin first." },
    Command { name: "agent.create", args: "name, acp_agent, instructions, mcp? (names of MCP servers), color?", does: "Makes an agent. It starts out asking first." },
    Command { name: "agent.update", args: "agent, and what changes: name, instructions, mcp, color, folder, permission (ask, auto or allow)", does: "Changes an agent. A looser permission mode asks the person." },
    Command { name: "agent.revisions", args: "agent", does: "Every revision of an agent's instructions." },
    Command { name: "agent.rollback", args: "agent, revision", does: "Puts an agent back as it was at a revision." },
    Command { name: "agent.delete", args: "agent", does: "Deletes an agent." },
    Command { name: "activity.list", args: "agent?, before?, limit?", does: "What agents ran, were allowed, and changed." },
    Command { name: "memory.list", args: "agent?, query?, limit?", does: "Notes, an agent's and the shared ones." },
    Command { name: "memory.put", args: "text, agent? (left out: shared)", does: "Keeps a note." },
    Command { name: "memory.delete", args: "id", does: "Deletes a note." },
    Command { name: "profile.get", args: "", does: "The person's profile, which every agent starts with." },
    Command { name: "profile.put", args: "text", does: "Writes the person's whole profile anew." },
    Command { name: "routine.list", args: "", does: "Routines, with when each runs next and how it last went." },
    Command { name: "routine.put", args: #"name, agent, prompt, schedule ({every: minutes}, {daily: HH:MM} or {weekdays: HH:MM}), tz?, notify?, on?, catch_up?, webhook?; or id and what changes"#, does: "Makes or changes a routine." },
    Command { name: "routine.run", args: "id", does: "Runs a routine now." },
    Command { name: "routine.delete", args: "id", does: "Deletes a routine." },
    Command { name: "task.list", args: "", does: "Tasks, newest first." },
    Command { name: "task.start", args: "agent, prompt, title?", does: "Starts a long job for an agent, in a conversation of its own." },
    Command { name: "task.pause", args: "id", does: "Pauses a running task." },
    Command { name: "task.resume", args: "id", does: "Carries a paused task on." },
    Command { name: "task.cancel", args: "id", does: "Cancels a task." },
    Command { name: "task.retry", args: "id", does: "Tries a failed or cancelled task again." },
    Command { name: "queue.list", args: "conversation", does: "What waits for an agent in a conversation." },
    Command { name: "queue.edit", args: "id, text", does: "Changes a waiting message." },
    Command { name: "queue.order", args: "conversation, ids", does: "Puts what waits in that order." },
    Command { name: "queue.drop", args: "id", does: "Drops a waiting message." },
