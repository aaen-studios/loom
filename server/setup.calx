module server.setup

// `loom install`: sets loom up on a Linux server, as root, once the install
// script has put this program on it (PLAN.md, "Agents can do anything the
// app can"). It makes the `loom` user, which has no rights beyond its own
// folder, keeps the instance in /var/lib/loom, runs `loom serve` as that user
// from a systemd unit, and puts Caddy in front for TLS when there's a domain,
// or Tailscale when there isn't. Unless told not to, it sets up rootless Podman
// for the `loom` user, for the sandboxes everyone but the owner runs their
// agents in (server/sandbox.calx). Then it starts it, and gives the address
// the setup code, and a link code for an agent to add it to the person's app.
import std.env
import std.fs
import std.http.{Header, post}
import std.json.{Json, parse}
import std.process.{Command, current_exe, which}
import std.thread.{sleep}
import shared.obj.{Obj, at, bool_at, str_at}

pub const USER: str = "loom"
pub const HOME: str = "/var/lib/loom"
pub const BIN: str = "/usr/local/bin/loom"
// The program the service runs: the loom user's own copy, in its folder, so the
// instance can swap in an update (server/update.calx). /usr is read-only to the
// service, and BIN stays root's, for the command line.
pub const SERVICE_BIN: str = "/var/lib/loom/bin/loom"
pub const UNIT: str = "/etc/systemd/system/loom.service"
pub const CADDYFILE: str = "/etc/caddy/Caddyfile"
// Marks the files loom wrote, so a second install may write them again.
const MARK: str = "# Written by loom install."

/// How to install: a domain for Caddy, or none, and whether to set sandboxes up.
/// Without a domain, Tailscale serves it unless `tailscale` is false, on
/// `https_port`, or the first free HTTPS port when that's 0.
pub struct Plan {
    pub domain: String
    pub port: u16
    pub sandboxes: bool
    pub tailscale: bool
    pub https_port: i64
    pub version: String
}

/// What an install did, for `loom install` to say, in words or as JSON.
pub struct Done {
    pub address: String
    pub setup_code: String?
    pub link_code: String?    // a link code that makes the owner (protocol.md, "Link codes"), for add_server
    pub steps: List<String>
    pub version: String
    pub via: String    // caddy, tailscale or local
    pub local: String    // the instance on this machine
    pub imported: Json    // what --import staged, or null
}

// The HTTPS ports Tailscale is asked for, in order, when the choice is loom's.
const HTTPS_PORTS: [i64; 6] = [443, 8443, 10000, 10001, 10002, 10003]

// The serve configs in `tailscale serve status --json`: the one in the
// background, and each foreground session's.
fn serve_configs(status: Json) -> List<Json> {
    var out: List<Json> = [status.copy()]
    if let Json.Object(sessions) = at(status, "Foreground") {
        for (_, c) in sessions { out.push(c.copy()) }
    }
    return out
}

// What `status` serves at `/` and `/api` on HTTPS `port`, by path: where each goes.
fn served_at(status: Json, port: i64) -> List<(String, String)> {
    var out = List<(String, String)>()
    for c in serve_configs(status) {
        if let Json.Object(web) = at(c.copy(), "Web") {
            for (host, site) in web {
                if not host.ends_with(":{port}") { continue }
                if let Json.Object(handlers) = at(site.copy(), "Handlers") {
                    for (path, h) in handlers {
                        if path == "/" or path == "/api" or path.starts_with("/api/") {
                            let to = str_at(h.copy(), "Proxy") ?? str_at(h.copy(), "Path") ?? (if at(h.copy(), "Text") != Json.Null { String("a text page") } else { String("something") })
                            out.push((path.copy(), to))
                        }
                    }
                }
            }
        }
        // A port forwarded as plain TCP is taken whatever path is asked for.
        let tcp = at(c, "TCP").get("{port}") ?? Json.Null
        if tcp != Json.Null and bool_at(tcp.copy(), "HTTPS") != some(true) {
            out.push((String("/"), "a TCP forward to {str_at(tcp, "TCPForward") ?? String("somewhere")}"))
        }
    }
    return out
}

// Whether `to`, a serve handler's proxy, is the instance on `loom_port`.
fn is_loom(to: String, loom_port: u16) -> bool {
    let t = to.trim_suffix("/").copy()
    for host in ["http://127.0.0.1", "http://localhost", "127.0.0.1", "localhost", "http://[::1]"] {
        if t == "{host}:{loom_port}" { return true }
    }
    return t == "{loom_port}"
}

/// The HTTPS port Tailscale should serve loom on, from what `tailscale serve
/// status --json` gave: the one serving loom already, from an earlier install;
/// else `wanted`, or with 0 the first of 443, 8443, 10000 and on where
/// nothing else has `/` or `/api`. Fails when `wanted` is taken, saying by what.
pub fn https_port(status: Json, wanted: i64, loom_port: u16) -> i64 ! Error {
    var candidates = List<i64>()
    if wanted > 0 { candidates.push(wanted) } else { candidates.extend(HTTPS_PORTS) }
    // One serving loom already wins, so a second install keeps its address.
    for p in candidates {
        let there = served_at(status.copy(), p)
        if there.len() > 0 and there.all(|x| { let (_, to) = x; is_loom(to.copy(), loom_port) }) { return p }
    }
    for p in candidates {
        let there = served_at(status.copy(), p)
        if there.len() == 0 { return p }
        if wanted > 0 {
            let (path, to) = there[0].copy()
            fail "Tailscale serves {to} at {path} on HTTPS port {p} already, so loom leaves it: pick another with --https-port N, or auto"
        }
    }
    fail "Tailscale serves something at / or /api on every HTTPS port loom tries ({HTTPS_PORTS.map(|p| "{p}").join(", ")}): give one with --https-port N"
}

/// This machine's name on the tailnet, from `tailscale status --json`, or the
/// host of a site `serve status` names; "" when neither says.
pub fn tailnet_name(status: Json, serve: Json) -> String {
    let dns = (str_at(at(status, "Self"), "DNSName") ?? String()).trim_suffix(".").copy()
    if dns.len() > 0 { return dns }
    if let Json.Object(web) = at(serve, "Web") {
        for (host, _) in web {
            if let cut = host.find_last(":") { return host[..cut].copy() }
        }
    }
    return String()
}

/// The address Tailscale serves loom at.
pub fn tailnet_address(name: String, port: i64) -> String {
    return if port == 443 { "https://{name}" } else { "https://{name}:{port}" }
}

/// The systemd unit that runs the instance as `loom`, with as little else as it needs.
/// With `boxes`, the `loom` user's id, it runs sandboxes with rootless Podman, which
/// needs the user's own session (lingering) and newuidmap, a setuid program, so
/// the unit can't forbid new privileges.
pub fn unit(port: u16, boxes: String?) -> String {
    var lines: List<String> = [
        String(MARK),
        String("[Unit]"),
        String("Description=loom, an instance of agents"),
        String("After=network-online.target"),
        String("Wants=network-online.target"),
    ]
    if let uid = boxes.copy() {
        lines.push("Wants=user@{uid}.service")
        lines.push("After=user@{uid}.service")
    }
    lines.push(String())
    lines.push(String("[Service]"))
    lines.push("User={USER}")
    lines.push("Group={USER}")
    // So an update knows systemd starts it again (server/update.calx).
    lines.push(String("Environment=LOOM_SERVICE=systemd"))
    if let uid = boxes.copy() {
        lines.push("ExecStart={SERVICE_BIN} serve --data {HOME} --port {port} --sandboxes podman")
        lines.push("Environment=XDG_RUNTIME_DIR=/run/user/{uid}")
        lines.push("Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus")
        // ProtectHome covers /run/user too, where rootless Podman keeps its state.
        lines.push("ReadWritePaths=/run/user/{uid}")
    } else {
        lines.push("ExecStart={SERVICE_BIN} serve --data {HOME} --port {port}")
        lines.push(String("NoNewPrivileges=yes"))
    }
    let rest: List<String> = [
        String("Restart=on-failure"),
        String("RestartSec=2"),
        "WorkingDirectory={HOME}",
        String("PrivateTmp=yes"),
        String("ProtectSystem=full"),
        String("ProtectHome=read-only"),
        "ReadWritePaths={HOME}",
        String("UMask=0077"),
        String(),
        String("[Install]"),
        String("WantedBy=multi-user.target"),
        String(),
    ]
    lines.extend(rest)
    return lines.join("\n")
}

/// The first id of a free range of 65,536 for `/etc/subuid` or `/etc/subgid`, after
/// every range `text` gives out already, and never below 100,000.
pub fn free_range(text: String) -> i64 {
    var next: i64 = 100000
    for line in text.split("\n") {
        let parts = line.trim().split(":")
        if parts.len() != 3 { continue }
        let start = i64.parse(parts[1].copy()) ?? 0
        let count = i64.parse(parts[2].copy()) ?? 0
        if start + count > next { next = start + count }
    }
    return next
}

/// Whether `program` is in a folder of the PATH systemd gives a service.
fn for_service(program: str) -> bool {
    for dir in ["/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"] {
        if fs.exists("{dir}/{program}") { return true }
    }
    return false
}

/// Sets up rootless Podman for the `loom` user: Podman, pasta and newuidmap, ids
/// for its containers, and a session of its own that outlives a login. Gives
/// its id, or says why sandboxes aren't set up.
fn podman_for_loom(steps: mut List<String>) -> String? ! Error {
    // Where the service finds them: systemd's own PATH, not the one this shell has,
    // which may hold a Podman of another package manager's that the service can't see.
    if not for_service("podman") or not for_service("pasta") or not for_service("newuidmap") {
        if which(String("apt-get")) == none {
            steps.push(String("no sandboxes: install Podman, pasta (passt) and newuidmap (uidmap), then run loom install again. Until then, only the owner's agents run"))
            return none
        }
        _ = try sh("apt-get", words(["install", "-y", "podman", "passt", "uidmap"]))
        steps.push(String("installed Podman, for sandboxes"))
    }
    for file in ["/etc/subuid", "/etc/subgid"] {
        let text = if fs.exists(String(file)) { try fs.read_text(String(file)) ?? String() } else { String() }
        var has = false
        for line in text.split("\n") {
            if line.starts_with("{USER}:") { has = true }
        }
        if not has {
            let start = free_range(text)
            let flag = if file == "/etc/subuid" { "--add-subuids" } else { "--add-subgids" }
            _ = try sh("usermod", [String(flag), "{start}-{start + 65535}", String(USER)])
        }
    }
    _ = try sh("loginctl", words(["enable-linger", USER]))
    let id_text = try sh("id", words(["-u", USER]))
    let uid = id_text.trim().copy()
    steps.push("sandboxes: the agents of everyone but the owner run in rootless Podman, as {USER}")
    return some(uid)
}

/// Caddy's file for `domain`, with TLS from Let's Encrypt, in front of the instance.
pub fn caddyfile(domain: String, port: u16) -> String {
    return "{MARK}\n{domain} \{\n    reverse_proxy 127.0.0.1:{port}\n\}\n"
}

/// Whether a Caddyfile that's there may be written over: one loom wrote, or the one
/// Debian's caddy package comes with, which only serves its welcome page.
pub fn caddyfile_ours(text: String) -> bool {
    return text.contains(MARK) or (text.contains(":80") and text.contains("/usr/share/caddy"))
}

/// Runs `program` with `args`, and fails with what it said when it doesn't work.
fn sh(program: str, args: List<String>) -> String ! Error {
    let out = try Command.new(String(program)).args(args).output()
    if not out.status.success() { fail "{program} {args.join(" ")} didn't work: {out.error_text().trim()}" }
    return out.text()
}

fn words(list: List<str>) -> List<String> {
    var out = List<String>()
    for w in list {
        out.push(String(w))
    }
    return out
}

/// Installs loom as `plan` says. Linux with systemd, as root.
pub fn install(plan: Plan) -> Done ! Error {
    if env.os() != "linux" { fail "loom install sets loom up on a Linux server; on a PC, the desktop app runs an instance itself" }
    if not env.is_elevated() { fail "loom install needs root, to make the loom user and the service: run it with sudo" }
    if which(String("systemctl")) == none { fail "loom install needs systemd, which this system doesn't have" }
    var steps = List<String>()

    // The user, with no shell and no rights beyond its own folder.
    let known = try Command.new(String("id")).arg(String(USER)).output()
    if not known.status.success() {
        _ = try sh("useradd", words(["--system", "--home-dir", HOME, "--shell", "/usr/sbin/nologin", "--user-group", USER]))
        steps.push("made the user {USER}")
    }
    try fs.make_dir_all(String(HOME))
    _ = try sh("chown", words(["-R", "loom:loom", HOME]))
    try fs.set_mode(String(HOME), 0o700)
    steps.push("keeps the instance in {HOME}, which only {USER} can read")

    // The program, where the unit runs it.
    let exe = current_exe()
    // An update finds the service running the old one, which Linux won't let
    // be written over (ETXTBSY), so the new one goes beside it and is renamed
    // over it; the service runs it once it restarts, below.
    if exe != BIN {
        let next = "{BIN}.new"
        try fs.copy(exe, next.copy())
        try fs.set_mode(next.copy(), 0o755)
        try fs.rename_synced(next, String(BIN))
        steps.push("put loom in {BIN}")
    }
    // And the service's own copy, which it updates itself.
    let folder = String(SERVICE_BIN[..SERVICE_BIN.find_last("/") ?? 0])
    try fs.make_dir_all(folder.copy())
    let service_next = "{SERVICE_BIN}.new"
    try fs.copy(String(BIN), service_next.copy())
    try fs.set_mode(service_next.copy(), 0o755)
    try fs.rename_synced(service_next, String(SERVICE_BIN))
    _ = try sh("chown", [String("-R"), String("loom:loom"), folder])
    steps.push("the service runs its own copy, {SERVICE_BIN}, which it can update")

    // Sandboxes, for everyone but the owner.
    let boxes = if plan.sandboxes { try podman_for_loom(mut steps) } else { none }

    // The service.
    let existing = if fs.exists(String(UNIT)) { try fs.read_text(String(UNIT)) ?? String() } else { String() }
    if existing.len() > 0 and not existing.contains(MARK) { fail "{UNIT} is there already, and loom didn't write it, so it's left as it is" }
    try fs.write_text(String(UNIT), unit(plan.port, boxes))
    _ = try sh("systemctl", words(["daemon-reload"]))
    _ = try sh("systemctl", words(["enable", "--now", "loom"]))
    _ = try sh("systemctl", words(["restart", "loom"]))
    steps.push("runs loom serve as {USER}, from {UNIT}")

    // In front of it: Caddy for a domain, or Tailscale.
    let local = "http://127.0.0.1:{plan.port}"
    var address = local.copy()
    var via = String("local")
    if plan.domain.len() > 0 {
        if which(String("caddy")) == none {
            if which(String("apt-get")) == none { fail "Caddy isn't installed, and this system has no apt-get to install it with: install Caddy, then run loom install again" }
            _ = try sh("apt-get", words(["install", "-y", "caddy"]))
            steps.push("installed Caddy")
        }
        let there = if fs.exists(String(CADDYFILE)) { try fs.read_text(String(CADDYFILE)) ?? String() } else { String() }
        if there.len() > 0 and not caddyfile_ours(there) { fail "{CADDYFILE} has a site in it already, so loom leaves it: add `{plan.domain} \{ reverse_proxy 127.0.0.1:{plan.port} \}` to it yourself" }
        try fs.make_dir_all(String("/etc/caddy"))
        try fs.write_text(String(CADDYFILE), caddyfile(plan.domain.copy(), plan.port))
        _ = try sh("systemctl", words(["enable", "caddy"]))
        _ = try sh("systemctl", words(["reload-or-restart", "caddy"]))
        address = "https://{plan.domain}"
        via = String("caddy")
        steps.push("Caddy serves it at {address}, with TLS")
    } else if not plan.tailscale {
        steps.push("it listens only on this machine, at {local}, as --no-tailscale asked")
    } else if which(String("tailscale")) != none {
        // What Tailscale serves already stays: loom takes a port where nothing has / or /api.
        let shown = try Command.new(String("tailscale")).args(words(["serve", "status", "--json"])).output()
        let serving = if shown.status.success() { json_of(shown.text()) } else { Json.Null }
        let port = try https_port(serving.copy(), plan.https_port, plan.port)
        let served = try Command.new(String("tailscale")).args(words(["serve", "--bg"])).arg("--https={port}").arg(local.copy()).output()
        if served.status.success() {
            let me = try Command.new(String("tailscale")).args(words(["status", "--json"])).output()
            let name = tailnet_name(if me.status.success() { json_of(me.text()) } else { Json.Null }, serving)
            if name.len() > 0 {
                address = tailnet_address(name, port)
                via = String("tailscale")
                steps.push("Tailscale serves it on your tailnet at {address}")
            } else {
                steps.push("Tailscale serves it on your tailnet on HTTPS port {port}: `tailscale serve status` gives its address")
            }
        } else {
            steps.push("Tailscale didn't take it ({served.error_text().trim()}); it's at {address} on this machine")
        }
    } else {
        steps.push("it listens only on this machine: give a --domain for Caddy, or install Tailscale and run loom install again")
    }

    let code = try setup_code()
    let link = if let c = code.copy() { link_code(plan.port, c) } else { none }
    return Done { address: address, setup_code: code, link_code: link, steps: steps, version: plan.version.copy(), via: via, local: local, imported: Json.Null }
}

fn json_of(text: String) -> Json {
    return match parse(text) {
        ok(j) => j,
        err(_) => Json.Null,
    }
}

/// The setup code the instance printed on its first start, from its log. None once the
/// owner is set up, or if it doesn't come within 30 seconds.
fn setup_code() -> String? ! Error {
    var waited: i64 = 0
    while waited < 30000 {
        let log = try Command.new(String("journalctl")).args(words(["-u", "loom", "--no-pager", "-o", "cat", "-n", "50"])).output()
        let text = log.text()
        if text.contains("loom: serving") and not text.contains("setup code:") and waited >= 3000 { return none }
        for line in text.split("\n") {
            if line.starts_with("setup code: ") { return some(line["setup code: ".len()..].trim().copy()) }
        }
        unsafe { sleep(500000000) }
        waited += 500
    }
    return none
}

/// A link code that makes the owner, from the instance on `port` for its setup code
/// (POST /api/link/new), for an agent to hand to add_server. None if it didn't answer.
fn link_code(port: u16, setup: String) -> String? {
    let headers: List<Header> = [Header { name: String("Content-Type"), value: String("application/json") }]
    let body = Obj.new().s("setup_code", setup).done()
    var req = post("http://127.0.0.1:{port}/api/link/new", headers, "{body}".to_bytes(), 10000, 65536)
    let r = match req.wait() {
        ok(r) => r,
        err(_) => return none,
    }
    if r.status != 200 { return none }
    return match parse(String.from_utf8(r.body) ?? String()) {
        ok(j) => str_at(j, "code"),
        err(_) => none,
    }
}

/// What `loom install` says once it's done, as JSON.
pub fn done_json(d: Done) -> Json {
    var steps = List<Json>()
    for s in d.steps {
        steps.push(Json.Str(s.copy()))
    }
    return Obj.new().s("address", d.address.copy()).maybe("setup_code", d.setup_code.copy()).maybe("link_code", d.link_code.copy()).s("version", d.version.copy()).s("via", d.via.copy()).s("local", d.local.copy()).s("data", String(HOME)).s("user", String(USER)).s("service", String("loom")).j("import", d.imported.copy()).s("next", next_step(d.copy())).j("steps", Json.Array(steps)).done()
}

// What the person does next, in a sentence.
fn next_step(d: Done) -> String {
    if d.setup_code == none { return "Open the app and sign in at {d.address}." }
    let brought = if d.imported != Json.Null { " What --import staged comes into their account then." } else { "" }
    let agent = if d.link_code != none { " Or an agent of theirs adds it to their app with add_server and the link code, within 15 minutes." } else { "" }
    return "Open the app, give it {d.address} and the setup code, and choose a username and password.{brought}{agent}"
}

/// The same, in words.
pub fn done_text(d: Done) -> String {
    var lines = List<String>()
    for s in d.steps {
        lines.push("- {s}")
    }
    lines.push("")
    lines.push("loom {d.version} is at {d.address}")
    if let code = d.setup_code.copy() { lines.push("setup code: {code}") }
    if let link = d.link_code.copy() { lines.push("link code: {link}") }
    lines.push(next_step(d))
    return lines.join("\n")
}

@test
fn the_unit_runs_it_as_loom() {
    let u = unit(8790, none)
    assert(u.contains("User=loom") and u.contains("ExecStart=/var/lib/loom/bin/loom serve --data /var/lib/loom --port 8790\n") and u.contains("NoNewPrivileges=yes"))
    assert(u.contains("Environment=LOOM_SERVICE=systemd\n"))
    let boxed = unit(8790, some(String("998")))
    assert(boxed.contains("--port 8790 --sandboxes podman") and boxed.contains("XDG_RUNTIME_DIR=/run/user/998") and boxed.contains("After=user@998.service") and boxed.contains("ReadWritePaths=/run/user/998"))
    assert(not boxed.contains("NoNewPrivileges"))
}

@test
fn a_free_range_comes_after_the_others() {
    assert(free_range(String()) == 100000)
    assert(free_range(String("ann:100000:65536\nbob:165536:65536\n")) == 231072)
}

@test
fn tailscale_keeps_what_it_serves() {
    // Nothing served: 443.
    assert(https_port(parse(String("\{\}"))!, 0, 8790)! == 443)
    assert(https_port(Json.Null, 0, 8790)! == 443)
    // Another service at / on 443: the next free port.
    let other = parse(String(#"{"TCP":{"443":{"HTTPS":true}},"Web":{"box.tail1234.ts.net:443":{"Handlers":{"/":{"Proxy":"http://127.0.0.1:3000"}}}}}"#))!
    assert(https_port(other.copy(), 0, 8790)! == 8443)
    // Asked for 443 by name, it says what's there instead.
    match https_port(other.copy(), 443, 8790) {
        ok(_) => panic("443 was taken"),
        err(e) => assert("{e}".contains("http://127.0.0.1:3000") and "{e}".contains("--https-port")),
    }
    assert(https_port(other.copy(), 9443, 8790)! == 9443)
    // Only another path on 443: / is free there.
    let side = parse(String(#"{"Web":{"box.tail1234.ts.net:443":{"Handlers":{"/grafana":{"Proxy":"http://127.0.0.1:3001"}}}}}"#))!
    assert(https_port(side, 0, 8790)! == 443)
    // /api taken on 443 and 8443 too, by a foreground session: 10000.
    let busy = parse(String(#"{"Web":{"box.tail1234.ts.net:443":{"Handlers":{"/api":{"Proxy":"http://127.0.0.1:4000"}}}},"Foreground":{"s1":{"Web":{"box.tail1234.ts.net:8443":{"Handlers":{"/":{"Path":"/srv/www"}}}}}}}"#))!
    assert(https_port(busy, 0, 8790)! == 10000)
    // A plain TCP forward takes the port.
    let tcp = parse(String(#"{"TCP":{"443":{"TCPForward":"127.0.0.1:22"}}}"#))!
    assert(https_port(tcp, 0, 8790)! == 8443)
    // A second install finds loom where it put it, even past a free 443.
    let ours = parse(String(#"{"Web":{"box.tail1234.ts.net:8443":{"Handlers":{"/":{"Proxy":"http://127.0.0.1:8790"}}}}}"#))!
    assert(https_port(ours.copy(), 0, 8790)! == 8443)
    assert(tailnet_name(Json.Null, ours) == "box.tail1234.ts.net")
    assert(tailnet_name(parse(String(#"{"Self":{"DNSName":"vps.tail1234.ts.net."}}"#))!, Json.Null) == "vps.tail1234.ts.net")
    assert(tailnet_address(String("vps.ts.net"), 443) == "https://vps.ts.net" and tailnet_address(String("vps.ts.net"), 8443) == "https://vps.ts.net:8443")
}

@test
fn caddy_proxies_the_domain() {
    let c = caddyfile(String("loom.example.com"), 8790)
    assert(c.contains("loom.example.com \{\n    reverse_proxy 127.0.0.1:8790\n\}"))
    assert(caddyfile_ours(c))
    assert(caddyfile_ours(String(":80 \{\n\troot * /usr/share/caddy\n\tfile_server\n\}\n")))
    assert(not caddyfile_ours(String("example.org \{\n\treverse_proxy :3000\n\}\n")))
}
