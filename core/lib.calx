module core.lib

// The core's C boundary (PLAN.md, "The core's C boundary"): what the apps
// link. `calx build --staticlib core/lib.calx` makes the library and its
// header.
//
// loom_core_start runs the connection (core/conn.calx) on a thread of its
// own, and a second thread hands what it says to the app's on_event, so a
// slow app never holds up the socket. It returns at once: the instance in
// the app, when there is one, starts on the connection's thread first, so
// the app's window doesn't wait for it. loom_core_stop ends both and waits
// for them, and for the instance, so no on_event comes after it returns.
import std.crypto.{PasswordHasher}
import std.fs
import std.json.{Json, parse}
import std.thread.{Task}
import shared.obj.{Obj, str_at}
import core.cache.{Cache}
import core.conn.{Conn}
import core.pushbox
import core.update.{Updater}
import shared.release.{MANIFEST}
import server.instance.{Config, EventLife, Instance}
import server.mcp
import server.installer
import server.update.{Source as ServerSource}

/// The credential store's service the device token is kept under, by the instance's address.
const KEYRING: str = "loom"

/// Where the core tells the app what happened: the app's function, and the context it gave.
struct Sink {
    on_event: extern "C" fn(*const u8, usize, *u8)
    ctx: *u8
}

unsafe impl Send for Sink {}

impl Sink {
    fn tell(self, message: String) {
        unsafe { (self.on_event)(message.as_ptr(), message.len(), self.ctx) }
    }
}

/// Hands each message for the app to on_event, until the connection's thread ends.
struct Relay {
    sink: Sink
    from_core: Receiver<String>
}

impl Task for Relay {
    fn run(own self) {
        var r = self
        while let m = r.from_core.wait() {
            r.sink.tell(m)
        }
    }
}

/// An instance inside the app (PLAN.md, "An instance in the desktop app"), run on a
/// thread of its own: the same server code, on 127.0.0.1 with a free port. It says
/// where it is, and the token for this launch, on `ready`, and stops when told on `stop`.
struct Local {
    data: String
    username: String
    kind: String
    version: String    // the app's, which the instance in it says it is
    ready: Sender<String>
    stop: Receiver<bool>
}

impl Task for Local {
    fn run(own self) {
        var l = self
        // The port it had last time, so the person's scripts find it in the same
        // place (PLAN.md, "Scripts"), unless something else has taken it since.
        let port_file = "{l.data}/port"
        let last = match fs.read_text(port_file.copy()) {
            ok(some(t)) => u16.parse(t.trim().copy()) ?? 0,
            _ => 0,
        }
        var i = match open_local(l.data.copy(), last, l.version.copy()) {
            ok(i) => i,
            err(e) => {
                l.ready.send("error:{e}")
                return
            },
        }
        let url = i.url().trim_suffix("/").copy()
        let port = url[(url.find_last(":") ?? 0) + 1..].copy()
        if let err(e) = fs.write_text(port_file, port.copy()) { eprintln("loom: the instance's port wasn't kept: {e}") }
        let token = match i.local_token(l.username.copy(), l.kind.copy()) {
            ok(t) => t,
            err(e) => {
                l.ready.send("error:{e}")
                return
            },
        }
        match i.find_acp_agents() {
            ok => {},
            err(e) => eprintln("loom: finding ACP agents: {e}"),
        }
        l.ready.send("{i.url()}\n{token}")
        match i.serve_until(l.stop) {
            ok => {},
            err(e) => eprintln("loom: the instance stopped: {e}"),
        }
    }
}

// The instance in the app, on the port it had last time if it's free, or on
// a new one.
fn open_local(data: String, last: u16, version: String) -> Instance ! Error {
    if last != 0 {
        match Instance.open(local_config(data.copy(), last, version.copy())) {
            ok(i) => return i,
            err(_) => {},
        }
    }
    return try Instance.open(local_config(data, 0, version))
}

fn local_config(data: String, port: u16, version: String) -> Config {
    return Config { data: data.copy(), port: port, host: String("127.0.0.1"), hasher: PasswordHasher(), events: EventLife.standard(), registry: String(installer.REGISTRY), minute_ms: 60000, apns: String(), version: version.copy(), lan: true, sandboxes: String(), sandbox_image: String(), release: ServerSource.official(), in_app: true }
}

/// What the app holds between calls.
struct Core {
    to_core: Sender<String>?
    conn: Thread?
    relay: Thread?
}

/// The core's own thread: it starts the instance in the app first, when the config asks
/// for one, then runs the connection, so loom_core_start doesn't wait for the instance
/// and the app draws its window from the cache meanwhile. What the app sends before the
/// connection runs waits in its inbox. Once the connection ends, it stops the instance
/// and waits for it.
struct Boot {
    cfg: Json
    inbox: Receiver<String>
    to_app: Sender<String>
}

impl Task for Boot {
    fn run(own self) {
        var b = self
        let cfg = b.cfg.copy()
        var server = str_at(cfg.copy(), "server")
        var token = str_at(cfg.copy(), "token")
        let service = str_at(cfg.copy(), "keyring") ?? String(KEYRING)
        var path = String(":memory:")
        let data = str_at(cfg.copy(), "data")
        if let d = data {
            path = "{d}/core.db"
        }
        var local: Thread? = none
        var stop_local: Sender<bool>? = none
        if str_at(cfg.copy(), "mode") == some(String("local")) {
            match start_local(cfg.copy(), data.copy() ?? String(".")) {
                ok((t, stop, url, tok)) => {
                    local = some(t)
                    stop_local = some(stop)
                    server = some(url)
                    token = some(tok)
                    // Its own cache: the address changes every launch, and the instance elsewhere keeps core.db.
                    if let d = data {
                        path = "{d}/local.db"
                    }
                },
                err(e) => b.to_app.send("{Obj.new().s("t", String("error")).s("code", String("local")).s("message", "{e}").done()}"),
            }
        }
        let cache = match Cache.open(path.copy()) {
            ok(c) => c,
            err(e) => {
                // The app still works, from the instance alone, and hears why it can't read offline.
                b.to_app.send("{Obj.new().s("t", String("error")).s("code", String("cache")).s("message", "can't open {path}: {e}").done()}")
                Cache.open(String(":memory:"))!
            },
        }
        var conn = Conn.new(server, token, service, cache, b.inbox, b.to_app)
        conn.tz = str_at(cfg.copy(), "tz")
        conn.local = str_at(cfg.copy(), "mode") == some(String("local"))
        if let d = data {
            conn.files = some("{d}/files")
            // Updates, for an app that says its version. An empty `update` turns them off.
            let feed = str_at(cfg.copy(), "update") ?? String(MANIFEST)
            if let v = str_at(cfg.copy(), "version") {
                if feed.len() > 0 {
                    let updater = Updater.new(v, str_at(cfg.copy(), "platform") ?? String("windows-desktop"), feed, "{d}/update")
                    // A test's releases, in a build from source, are signed with a key of their own.
                    conn.updater = some(if let k = str_at(cfg.copy(), "update_key") { updater.with_key(k) } else { updater })
                }
            }
        }
        conn.run()
        if let s = mut stop_local {
            s.send(true)
        }
        if let t = local.take() {
            t.join()
        }
    }
}

/// Starts the instance in the app, and waits for its address and token.
pub fn start_local(cfg: Json, data: String) -> (Thread, Sender<bool>, String, String) ! Error {
    var ready = Receiver<String>()
    let stop = Receiver<bool>()
    let stop_to = stop.sender()
    let task = Local { data: "{data}/instance", username: str_at(cfg.copy(), "username") ?? String("me"), kind: str_at(cfg.copy(), "kind") ?? String("windows"), version: str_at(cfg, "version") ?? String("desktop"), ready: ready.sender(), stop: stop }
    let t = unsafe { Thread.spawn(task) }
    // Opening it can take a moment the first time, while it makes its database.
    let said = unsafe { ready.wait_for(60000000000) } else {
        fail "the instance in the app didn't start in a minute"
    }
    if said.starts_with("error:") {
        fail "the instance in the app didn't start: {said[6..]}"
    }
    let parts = said.split("\n")
    return (t, stop_to, parts[0].copy(), parts[1].copy())
}

/// The `len` bytes at `p`, as text, or none if they aren't UTF-8.
unsafe fn text_at(p: *const u8, len: usize) -> String? {
    var bytes = List<u8>()
    bytes.reserve(len)
    for i in 0..len {
        bytes.push(unsafe { p.add(i).read() })
    }
    return String.from_utf8(bytes)
}

/// Starts the core with its config, JSON in the `len` bytes at `config`:
/// `{"server": "https://…", "data": "C:\Users\…\Loom"}`, each optional (core/README.md, "Config").
/// It tells `on_event`, with `ctx`, what happens, from a thread of its own. Gives back
/// the core, which loom_core_send and loom_core_stop take.
@export_c("loom_core_start")
fn core_start(config: *const u8, len: usize, on_event: extern "C" fn(*const u8, usize, *u8), ctx: *u8) -> *u8 {
    let sink = unsafe { Sink { on_event: on_event, ctx: ctx } }
    let given = unsafe { text_at(config, len) } ?? String()
    let parsed = match parse(given) {
        ok(j) => some(j),
        err(_) => none,
    }
    let cfg = parsed ?? Obj.new().done()
    let inbox = Receiver<String>()
    let to_core = inbox.sender()
    let from_core = Receiver<String>()
    let conn_thread = unsafe { Thread.spawn(Boot { cfg: cfg, inbox: inbox, to_app: from_core.sender() }) }
    let relay_thread = unsafe { Thread.spawn(Relay { sink: sink, from_core: from_core }) }
    unsafe {
        return Box(Core { to_core: some(to_core), conn: some(conn_thread), relay: some(relay_thread) }).into_ptr().cast<u8>()
    }
}

/// Hands the core a JSON message from the app, the `len` bytes at `json`.
@export_c("loom_core_send")
fn core_send(core: *u8, json: *const u8, len: usize) {
    var c = unsafe { core.cast<Core>().to_box() }
    if let text = unsafe { text_at(json, len) } {
        if let to = mut c.value.to_core {
            to.send(text)
        }
    }
    unsafe { _ = c.into_ptr() }
}

/// Stops the core, waits for its threads, and frees it.
@export_c("loom_core_stop")
fn core_stop(core: *u8) {
    var c = unsafe { core.cast<Core>().to_box() }
    if let to = mut c.value.to_core {
        to.send(String(#"{"t":"core.stop"}"#))
    }
    c.value.to_core = none
    if let t = c.value.conn.take() {
        t.join()
    }
    if let t = c.value.relay.take() {
        t.join()
    }
}

/// Opens a notification the push relay brought (PLAN.md, "The push relay"), for the
/// iPhone's notification service extension: `sealed` is the notification's `sealed`
/// field, the `slen` bytes at it, and `keyring` (`klen` bytes) the credential store's
/// service the core was started with, where the phone's box key is. Hands `on_text`,
/// with `ctx`, the notification as the instance made it, JSON, and gives true; gives
/// false, without calling it, when it doesn't open.
@export_c("loom_push_open")
fn push_open(keyring: *const u8, klen: usize, sealed: *const u8, slen: usize, on_text: extern "C" fn(*const u8, usize, *u8), ctx: *u8) -> bool {
    let service = unsafe { text_at(keyring, klen) } ?? String(KEYRING)
    let given = unsafe { text_at(sealed, slen) } else return false
    let box = match pushbox.box_key(if service.len() == 0 { String(KEYRING) } else { service }) {
        ok(b) => b,
        err(_) => return false,
    }
    let opened = pushbox.open(box, given) else return false
    let sink = unsafe { Sink { on_event: on_text, ctx: ctx } }
    sink.tell("{opened}")
    return true
}

/// `loom mcp`, for the desktop app started as `loom.exe mcp` by an agent of the
/// instance it runs (PLAN.md, "Loom's own tools"). Serves MCP on standard
/// input and output until input ends. Gives the exit status.
@export_c("loom_mcp")
fn loom_mcp() -> i32 {
    match mcp.serve() {
        ok => return 0,
        err(e) => {
            eprintln("loom mcp: {e}")
            return 1
        },
    }
}
