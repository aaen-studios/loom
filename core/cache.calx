module core.cache

// The core's local cache (PLAN.md, "What the core does"): agents,
// conversations, messages, devices, the runs still going and the questions
// still open, so the app opens at once and reads offline. Each event is
// applied in one transaction with the cursor, the event's seq, so a crash
// never leaves the two apart (protocol.md, "The event log").
//
// The outbox lives here too: a message the person wrote waits here with its
// client id until the instance acks it.
import std.json.{Json, parse}
import std.sqlite.{Database, Value}
import std.time.{Timestamp}
import shared.obj.{Obj, at, bool_at, int_at, merge, str_at}
import shared.checkpoint
import core.asks
import core.sidebar
import std.fs
import std.thread.{Task, sleep}

const SCHEMA: str = #"
CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS agents (id TEXT PRIMARY KEY, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS conversations (
    id TEXT PRIMARY KEY, json TEXT NOT NULL, last INTEGER NOT NULL, agent TEXT, chat INTEGER NOT NULL DEFAULT 0,
    partial INTEGER NOT NULL DEFAULT 0, replied INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS messages (
    id TEXT PRIMARY KEY, conversation TEXT NOT NULL, at INTEGER NOT NULL, json TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS messages_by_conversation ON messages (conversation, at);
CREATE TABLE IF NOT EXISTS devices (id TEXT PRIMARY KEY, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS runs (id TEXT PRIMARY KEY, conversation TEXT NOT NULL, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS calls (call TEXT PRIMARY KEY, run TEXT NOT NULL, title TEXT, status TEXT, block INTEGER, parent TEXT, at INTEGER, name TEXT, doing TEXT, did TEXT, said INTEGER);
CREATE INDEX IF NOT EXISTS calls_by_run ON calls (run);
CREATE TABLE IF NOT EXISTS approvals (call TEXT PRIMARY KEY, run TEXT NOT NULL, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS groups (id TEXT PRIMARY KEY, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS outbox (
    cid TEXT PRIMARY KEY, conversation TEXT NOT NULL, json TEXT NOT NULL, at INTEGER NOT NULL);
"#

// Everything that came from the instance, which a reset or another login clears.
const TABLES: [str; 8] = ["agents", "conversations", "messages", "devices", "runs", "calls", "approvals", "groups"]

// What each list the app reads is, in order.
const AGENTS: str = "SELECT json FROM agents ORDER BY rowid"
// Each conversation with `last`, when its newest message is from, which orders them, so
// the app keeps the order as messages come without reading the list again, and
// `replied`, when its newest agent's message is from, which is unread while it's
// newer than the conversation's `read` (protocol.md, "Unread").
const CONVERSATIONS: str = "SELECT json_set(json, '$.last', last, '$.replied', replied) FROM conversations ORDER BY last DESC, rowid DESC"
const DEVICES: str = "SELECT json FROM devices ORDER BY rowid"
const RUNS: str = "SELECT json FROM runs ORDER BY rowid"
// What a tool block shows of each call: its call, run, title and status, its block in
// a reply still being written, the subagent call it sits inside, and its step in plain
// words (its tool's name, what it's doing and what it did), which is all the cache keeps
// of it. A call's input and output can be many KB, no app reads them from here, and the
// apps ask again at every tool event. A call with no block (from an instance before
// tool.started gave one), no parent (the agent's own) or no words (from an instance
// before it gave them) has none in its JSON.
const TOOLS_FOR: str = "SELECT json_patch(json_object('call', call, 'run', run, 'title', title, 'status', status), json_object('block', block, 'parent', parent, 'name', name, 'doing', doing, 'did', did, 'said', json(CASE said WHEN 1 THEN 'true' END))) FROM calls WHERE call IN (SELECT value FROM json_each(?)) OR run IN (SELECT value FROM json_each(?)) ORDER BY rowid"
const TOOLS: str = "SELECT json_patch(json_object('call', call, 'run', run, 'title', title, 'status', status), json_object('block', block, 'parent', parent, 'name', name, 'doing', doing, 'did', did, 'said', json(CASE said WHEN 1 THEN 'true' END))) FROM calls ORDER BY rowid"

// A cache from before calls and the conversations' agent column: what it had is moved over.
const FROM_TOOLS: str = #"
BEGIN;
INSERT OR IGNORE INTO calls (call, run, title, status, at)
    SELECT call, run, json_extract(json, '$.title'), json_extract(json, '$.status'), CAST(strftime('%s', 'now') AS INTEGER) * 1000 FROM tools ORDER BY rowid;
DROP TABLE tools;
COMMIT;
"#
const AGENT_COLUMN: str = #"
BEGIN;
ALTER TABLE conversations ADD COLUMN agent TEXT;
ALTER TABLE conversations ADD COLUMN chat INTEGER NOT NULL DEFAULT 0;
UPDATE conversations SET agent = json_extract(json, '$.agent'),
    chat = (json_extract(json, '$.task') IS NULL AND json_extract(json, '$.side') IS NULL AND json_extract(json, '$.branch_of') IS NULL AND json_extract(json, '$.routine') IS NULL AND json_extract(json, '$.asked_by') IS NULL);
COMMIT;
"#
// A cache from before calls kept their block.
const BLOCK_COLUMN: str = "ALTER TABLE calls ADD COLUMN block INTEGER;"
// A cache from before calls kept the subagent call they sit inside.
const PARENT_COLUMN: str = "ALTER TABLE calls ADD COLUMN parent TEXT;"
// A cache from before calls kept their steps in plain words.
const WORDS_COLUMNS: str = "ALTER TABLE calls ADD COLUMN name TEXT; ALTER TABLE calls ADD COLUMN doing TEXT; ALTER TABLE calls ADD COLUMN did TEXT; ALTER TABLE calls ADD COLUMN said INTEGER;"
// A cache from before calls kept when they started: what's there counts from now, so
// it goes CALLS_KEPT_MS after the update, not at once.
const CALLS_AT_COLUMN: str = #"
BEGIN;
ALTER TABLE calls ADD COLUMN at INTEGER;
UPDATE calls SET at = CAST(strftime('%s', 'now') AS INTEGER) * 1000;
COMMIT;
"#
// A cache from before conversations said whether it has all their messages: none is
// known to, so each fetches what it's missing when it's opened.
const PARTIAL_COLUMN: str = #"
BEGIN;
ALTER TABLE conversations ADD COLUMN partial INTEGER NOT NULL DEFAULT 0;
UPDATE conversations SET partial = 1;
COMMIT;
"#
// A cache from before conversations kept when their newest agent's message is from:
// from the messages it has.
const REPLIED_COLUMN: str = #"
BEGIN;
ALTER TABLE conversations ADD COLUMN replied INTEGER NOT NULL DEFAULT 0;
UPDATE conversations SET replied = COALESCE((SELECT MAX(m.at) FROM messages m WHERE m.conversation = conversations.id AND json_extract(m.json, '$.role') = 'agent'), 0);
COMMIT;
"#
// How long the cache keeps a tool call: as long as the instance keeps events (protocol.md,
// "The event log"), after which a new device couldn't have it either. A day between looks.
pub const CALLS_KEPT_MS: i64 = 2592000000

/// How many of the emoji this device sent lately the picker shows first.
const RECENT_EMOJI: usize = 24

const PRUNE_EVERY_MS: i64 = 86400000
// Each agent's chat, newest first, for `conversation_for` at a send.
const CHATS_BY_AGENT: str = "CREATE INDEX IF NOT EXISTS chats_by_agent ON conversations (agent, last DESC) WHERE chat = 1;"
const APPROVALS: str = "SELECT json FROM approvals ORDER BY rowid"
// The sidebar's folders, in the order the instance gave them, and the agents a question waits on.
const GROUPS: str = "SELECT json FROM groups ORDER BY rowid"
const WAITING: str = "SELECT DISTINCT json_extract(r.json, '$.agent') FROM approvals a JOIN runs r ON r.id = a.run"
// The group chats, in the order they were made (PLAN.md, "Group chats").
const ROOMS: str = "SELECT json FROM conversations WHERE json_extract(json, '$.room') IS NOT NULL ORDER BY rowid"
const OUTBOX: str = "SELECT json FROM outbox ORDER BY at, rowid"

// A JSON array of `items`, each JSON already.
fn array(items: List<String>) -> String {
    return "[{items.join(",")}]"
}

pub fn now() -> i64 {
    return unsafe { Timestamp.now() }.unix_ms
}

fn text(v: Value) -> String {
    match v {
        Value.Text(s) => return s.copy(),
        Value.Int(n) => return "{n}",
        _ => return String(),
    }
}

fn int(v: Value) -> i64 {
    match v {
        Value.Int(n) => return n,
        _ => return 0,
    }
}

fn t(s: own String) -> Value {
    return Value.Text(s)
}

fn maybe(s: own String?) -> Value {
    if let v = s { return Value.Text(v) }
    return Value.Null
}

// A tool event's `said`, as the calls table keeps it: 1 or 0, or null where it has none.
fn said_of(e: Json) -> Value {
    if let b = bool_at(e, "said") { return Value.Int(if b { 1 } else { 0 }) }
    return Value.Null
}

// Whether a conversation may be its agent's chat, rather than a task's, a side
// question's, a branch's, a routine's, another agent's (`asked_by`) or a thread an
// agent made (`made_by`): 1 or 0. Of those, the chat is the one marked `main`.
fn chat_of(c: Json) -> i64 {
    for key in ["task", "side", "branch_of", "routine", "asked_by", "made_by", "room"] {
        if at(c, key) != Json.Null { return 0 }
    }
    return 1
}

/// Takes the lock that makes a core the only one using the data folder `data`: its
/// cache, and the instance in the app. Two looms running at once, as when one was
/// started again while the other waited in the tray, both wrote every event to the
/// same cache. It waits up to `wait_ms` for a core that's stopping, as when the app
/// starts another core for the folder before the old one has gone; none if the lock
/// is still held then. `release` lets it go.
pub fn own_folder(data: String, wait_ms: i64) -> fs.FileLock? ! Error {
    let until = now() + wait_ms
    loop {
        if let l = try fs.try_lock("{data}/core.lock", List<u8>()) { return some(l) }
        if now() >= until { return none }
        unsafe { sleep(50000000) }
    }
}

pub struct Cache {
    db: Database
    stop_checkpoints: Sender<bool>?    // the thread that checkpoints it, which stops when this goes
    big: Receiver<bool>?    // that thread saying the log grew long
}

impl Cache {
    /// Opens (or makes) the cache at `path`, or one in memory for `:memory:`.
    pub fn open(path: String) -> Cache ! Error {
        let db = try Database.open(path.copy())
        try db.execute_script(String("PRAGMA journal_mode = WAL;"))
        var stop: Sender<bool>? = none
        var big: Receiver<bool>? = none
        if path != ":memory:" {
            // The core's thread doesn't checkpoint by itself: a commit that took the log
            // past 1000 pages held up the app's reads for up to 50 ms. A thread of its own
            // does it (shared/checkpoint.calx), and the log goes back to 64 MB after a burst.
            try db.execute_script(String("PRAGMA wal_autocheckpoint = 0; PRAGMA journal_size_limit = 67108864;"))
            let (_, s, b) = checkpoint.start(path)
            stop = some(s)
            big = some(b)
        }
        try db.execute_script(String(SCHEMA))
        if try db.query_one(String("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'tools'"), List<Value>()) != none {
            try db.execute_script(String(FROM_TOOLS))
        }
        if try db.query_one(String("SELECT 1 FROM pragma_table_info('conversations') WHERE name = 'agent'"), List<Value>()) == none {
            try db.execute_script(String(AGENT_COLUMN))
        }
        if try db.query_one(String("SELECT 1 FROM pragma_table_info('calls') WHERE name = 'block'"), List<Value>()) == none {
            try db.execute_script(String(BLOCK_COLUMN))
        }
        if try db.query_one(String("SELECT 1 FROM pragma_table_info('calls') WHERE name = 'parent'"), List<Value>()) == none {
            try db.execute_script(String(PARENT_COLUMN))
        }
        if try db.query_one(String("SELECT 1 FROM pragma_table_info('calls') WHERE name = 'at'"), List<Value>()) == none {
            try db.execute_script(String(CALLS_AT_COLUMN))
        }
        if try db.query_one(String("SELECT 1 FROM pragma_table_info('calls') WHERE name = 'doing'"), List<Value>()) == none {
            try db.execute_script(String(WORDS_COLUMNS))
        }
        if try db.query_one(String("SELECT 1 FROM pragma_table_info('conversations') WHERE name = 'partial'"), List<Value>()) == none {
            try db.execute_script(String(PARTIAL_COLUMN))
        }
        if try db.query_one(String("SELECT 1 FROM pragma_table_info('conversations') WHERE name = 'replied'"), List<Value>()) == none {
            try db.execute_script(String(REPLIED_COLUMN))
        }
        try db.execute_script(String(CHATS_BY_AGENT))
        return Cache { db: db, stop_checkpoints: stop, big: big }
    }

    pub fn meta(self, key: str) -> String? ! Error {
        let row = try self.db.query_one(String("SELECT value FROM meta WHERE key = ?"), [t(String(key))])
        let r = row else return none
        return some(text(r[0]))
    }

    pub fn set_meta(self, key: str, value: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO meta (key, value) VALUES (?, ?) ON CONFLICT (key) DO UPDATE SET value = excluded.value"), [t(String(key)), t(value.copy())])
    }

    /// The person's own emoji (PLAN.md, "Emoji"), as `synced` and each `emoji.changed`
    /// bring them whole: each `id`, `name`, `file`, `animated` and `at`.
    pub fn keep_emoji(self, list: Json) ! Error {
        let Json.Array(_) = list.copy() else return
        try self.set_meta("emoji", "{list}")
    }

    pub fn emoji(self) -> List<Json> ! Error {
        let kept = try self.meta("emoji") else return List<Json>()
        let read = match parse(kept) {
            ok(j) => j,
            err(_) => Json.Null,
        }
        let Json.Array(all) = read else return List<Json>()
        return all
    }

    /// The emoji this device sent lately, newest first, each as it was sent: the
    /// character, or a token for one of the person's own.
    pub fn recent_emoji(self) -> List<String> ! Error {
        let kept = try self.meta("emoji_recent") else return List<String>()
        let read = match parse(kept) {
            ok(j) => j,
            err(_) => Json.Null,
        }
        let Json.Array(all) = read else return List<String>()
        var out = List<String>()
        for e in all {
            if let s = e.as_str() { out.push(s) }
        }
        return out
    }

    /// Notes that this device sent `emoji`: it goes first among those used lately,
    /// which keep the newest `RECENT_EMOJI`.
    pub fn used_emoji(self, emoji: String) ! Error {
        if emoji.len() == 0 or emoji.len() > 64 { return }
        var list: List<Json> = [Json.Str(emoji.copy())]
        for e in try self.recent_emoji() {
            if e != emoji and list.len() < RECENT_EMOJI { list.push(Json.Str(e.copy())) }
        }
        try self.set_meta("emoji_recent", "{Json.Array(list)}")
    }

    /// The seq of the newest event applied: the `after` for the next hello.
    pub fn cursor(self) -> i64 ! Error {
        let c = try self.meta("cursor") else return 0
        return i64.parse(c) ?? 0
    }

    /// Forgets everything that came from the instance, the cursor with it. The outbox stays.
    pub fn clear(self) ! Error {
        for table in TABLES {
            _ = try self.db.execute("DELETE FROM {table}")
        }
        _ = try self.db.execute(String("DELETE FROM meta WHERE key = 'cursor'"))
    }

    // One step of changes that land together or not at all: a transaction of its own
    // outside `hold`, and a savepoint in the held one inside it. Gives whether it began
    // the transaction, for `step_done` and `undo`.
    //
    // A transaction that may read before it writes takes the write lock as it begins
    // (BEGIN IMMEDIATE). One that took it at its first write, after reading, failed at
    // once with "database is locked" whenever another connection had written since,
    // or was writing, whatever the busy timeout: SQLite can't wait there without
    // risking a deadlock. Taken first, it waits for the other connection as long as
    // the busy timeout.
    fn step(self) -> bool ! Error {
        if self.db.in_transaction() {
            _ = try self.db.execute(String("SAVEPOINT step"))
            return false
        }
        _ = try self.db.execute(String("BEGIN IMMEDIATE"))
        return true
    }

    fn step_done(self, began: bool) ! Error {
        if not began {
            _ = try self.db.execute(String("RELEASE step"))
            return
        }
        match self.db.commit() {
            ok => {},
            err(e) => {
                self.undo(true)
                fail e
            },
        }
    }

    fn undo(self, began: bool) {
        if began {
            match self.db.rollback() {
                ok => {},
                err(_) => {},    // the transaction ends with the connection anyway
            }
            return
        }
        match self.db.execute(String("ROLLBACK TO step")) {
            ok(_) => {},
            err(_) => {},
        }
        match self.db.execute(String("RELEASE step")) {
            ok(_) => {},
            err(_) => {},
        }
    }

    /// Keeps what's applied from here on in one transaction until `let_go`, so a burst
    /// of events, such as catching up, is written once rather than once an event. It
    /// takes the write lock at once, as `step` does.
    pub fn hold(self) ! Error {
        if not self.db.in_transaction() { _ = try self.db.execute(String("BEGIN IMMEDIATE")) }
    }

    /// Truncates the log once the checkpoint thread says it grew long, outside a
    /// transaction (shared/checkpoint.calx, `truncate`).
    pub fn truncate_if_big(mut self) ! Error {
        if let b = mut self.big { try checkpoint.truncate(self.db, mut b) }
    }

    /// Saves what was applied since `hold`.
    pub fn let_go(self) ! Error {
        if not self.db.in_transaction() { return }
        match self.db.commit() {
            ok => {},
            err(e) => {
                match self.db.rollback() {
                    ok => {},
                    err(_) => {},
                }
                fail e
            },
        }
    }

    // --- Applying what the instance sends ---

    /// Applies an event and moves the cursor to its seq, together. An event at or before
    /// the cursor was applied already, and is skipped. Gives whether it was applied.
    pub fn apply(self, event: Json) -> bool ! Error {
        let seq = int_at(event, "seq") ?? 0
        let began = try self.step()
        // The cursor is read in the step, so it's the one the step moves.
        let ahead = match self.cursor() {
            ok(c) => seq > c,
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        if not ahead {
            try self.step_done(began)
            return false
        }
        match self.change(event) {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        match self.set_meta("cursor", "{seq}") {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        try self.step_done(began)
        return true
    }

    fn change(self, e: Json) ! Error {
        let kind = str_at(e, "kind") ?? String()
        if kind == "conversation.created" {
            try self.put_conversation(at(e.copy(), "conversation"))
            // One brought over with more messages than came as events.
            if bool_at(e.copy(), "partial") == some(true) {
                _ = try self.db.execute(String("UPDATE conversations SET partial = 1 WHERE id = ?"), [t(str_at(at(e, "conversation"), "id") ?? String())])
            }
        } else if kind == "conversation.updated" {
            let c = at(e, "conversation")
            let id = str_at(c, "id") ?? String()
            if let old = try self.one("SELECT json FROM conversations WHERE id = ?", id.copy()) {
                let merged = merge(old, c)
                _ = try self.db.execute(String("UPDATE conversations SET json = ?, agent = ?, chat = ? WHERE id = ?"), [t("{merged}"), maybe(str_at(merged, "agent")), Value.Int(chat_of(merged.copy())), t(id)])
                try self.one_main(merged)
            }
        } else if kind == "conversation.deleted" {
            let id = str_at(e, "conversation") ?? String()
            _ = try self.db.execute(String("DELETE FROM conversations WHERE id = ?"), [t(id.copy())])
            _ = try self.db.execute(String("DELETE FROM messages WHERE conversation = ?"), [t(id.copy())])
        } else if kind == "message.created" or kind == "message.updated" {
            try self.put_message(at(e, "message"))
        } else if kind == "message.deleted" {
            _ = try self.db.execute(String("DELETE FROM messages WHERE id = ?"), [t(str_at(e, "message") ?? String())])
        } else if kind == "run.started" {
            let id = str_at(e, "run") ?? String()
            let conversation = str_at(e, "conversation") ?? String()
            _ = try self.db.execute(String("INSERT OR REPLACE INTO runs (id, conversation, json) VALUES (?, ?, ?)"), [t(id), t(conversation), t("{e}")])
        } else if kind == "run.finished" {
            let id = str_at(e, "run") ?? String()
            _ = try self.db.execute(String("DELETE FROM runs WHERE id = ?"), [t(id.copy())])
            _ = try self.db.execute(String("DELETE FROM approvals WHERE run = ?"), [t(id.copy())])
            // A call the instance left open, as one from before it closed them, ends with its turn.
            _ = try self.db.execute(String("UPDATE calls SET status = 'cancelled' WHERE run = ? AND status IS NULL"), [t(id)])
        } else if kind == "tool.started" {
            let call = str_at(e, "call") ?? String()
            let run = str_at(e, "run") ?? String()
            let block = if let b = int_at(e, "block") { Value.Int(b) } else { Value.Null }
            _ = try self.db.execute(String("INSERT OR REPLACE INTO calls (call, run, title, status, block, parent, at, name, doing, did, said) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"), [t(call), t(run), maybe(str_at(e, "title")), maybe(str_at(e, "status")), block, maybe(str_at(e, "parent")), Value.Int(int_at(e, "at") ?? now()), maybe(str_at(e, "name")), maybe(str_at(e, "doing")), maybe(str_at(e, "did")), said_of(e)])
        } else if kind == "tool.updated" or kind == "tool.finished" {
            // Only what changed, set in place: no stored JSON read, merged and written back.
            let call = str_at(e, "call") ?? String()
            _ = try self.db.execute(String("UPDATE calls SET title = coalesce(?, title), status = coalesce(?, status), name = coalesce(?, name), doing = coalesce(?, doing), did = coalesce(?, did), said = coalesce(?, said) WHERE call = ?"), [maybe(str_at(e, "title")), maybe(str_at(e, "status")), maybe(str_at(e, "name")), maybe(str_at(e, "doing")), maybe(str_at(e, "did")), said_of(e), t(call)])
        } else if kind == "approval.needed" {
            let call = str_at(e, "call") ?? String()
            let run = str_at(e, "run") ?? String()
            _ = try self.db.execute(String("INSERT OR REPLACE INTO approvals (call, run, json) VALUES (?, ?, ?)"), [t(call), t(run), t("{e}")])
        } else if kind == "approval.answered" {
            _ = try self.db.execute(String("DELETE FROM approvals WHERE call = ?"), [t(str_at(e, "call") ?? String())])
        } else if kind == "agent.created" or kind == "agent.updated" {
            try self.put_agent(at(e, "agent"))
        } else if kind == "agent.deleted" {
            _ = try self.db.execute(String("DELETE FROM agents WHERE id = ?"), [t(str_at(e, "agent") ?? String())])
        } else if kind == "group.updated" {
            let g = at(e, "group")
            _ = try self.db.execute(String("INSERT INTO groups (id, json) VALUES (?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json"), [t(str_at(g.copy(), "id") ?? String()), t("{g}")])
        } else if kind == "group.deleted" {
            _ = try self.db.execute(String("DELETE FROM groups WHERE id = ?"), [t(str_at(e, "group") ?? String())])
        } else if kind == "emoji.changed" {
            try self.keep_emoji(at(e, "emoji"))
        } else if kind == "device.added" {
            let d = at(e, "device")
            _ = try self.db.execute(String("INSERT OR REPLACE INTO devices (id, json) VALUES (?, ?)"), [t(str_at(d, "id") ?? String()), t("{d}")])
        } else if kind == "device.updated" {
            let d = at(e, "device")
            let id = str_at(d, "id") ?? String()
            if let old = try self.one("SELECT json FROM devices WHERE id = ?", id.copy()) {
                _ = try self.db.execute(String("UPDATE devices SET json = ? WHERE id = ?"), [t("{merge(old, d)}"), t(id)])
            }
        } else if kind == "device.revoked" {
            _ = try self.db.execute(String("DELETE FROM devices WHERE id = ?"), [t(str_at(e, "device") ?? String())])
        }
    }

    /// Replaces everything with a snapshot, after a welcome with reset, and moves the
    /// cursor to its seq.
    pub fn replace(self, snapshot: Json) ! Error {
        let began = try self.step()
        match self.fill(snapshot) {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        try self.step_done(began)
    }

    fn fill(self, s: Json) ! Error {
        try self.clear()
        if let Json.Array(agents) = at(s.copy(), "agents") {
            for a in agents {
                try self.put_agent(a.copy())
            }
        }
        if let Json.Array(conversations) = at(s.copy(), "conversations") {
            for c in conversations {
                try self.put_conversation(c.copy())
            }
        }
        if let Json.Array(messages) = at(s.copy(), "messages") {
            for m in messages {
                try self.put_message(m.copy())
            }
        }
        // The conversations it left messages of out, which fetch them when they're
        // opened. A snapshot from an instance from before `partial` may have, for any.
        let partial = at(s.copy(), "partial")
        if let Json.Array(_) = partial.copy() {
            _ = try self.db.execute(String("UPDATE conversations SET partial = 1 WHERE id IN (SELECT value FROM json_each(?))"), [t("{partial}")])
        } else {
            _ = try self.db.execute(String("UPDATE conversations SET partial = 1"), List<Value>())
        }
        try self.set_meta("cursor", "{int_at(s, "seq") ?? 0}")
    }

    /// Whether the instance may have messages of `conversation` older than the cache's:
    /// a snapshot left them out, or they came in from another app.
    pub fn partial(self, conversation: String) -> bool ! Error {
        let row = try self.db.query_one(String("SELECT partial FROM conversations WHERE id = ?"), [t(conversation.copy())]) else return false
        return int(row[0].copy()) != 0
    }

    /// The id of the oldest message of `conversation` the cache has, if any: where a
    /// messages.list for the older ones starts.
    pub fn oldest(self, conversation: String) -> String? ! Error {
        let row = try self.db.query_one(String("SELECT id FROM messages WHERE conversation = ? ORDER BY at, rowid LIMIT 1"), [t(conversation.copy())]) else return none
        return some(text(row[0].copy()))
    }

    /// Keeps a page of `conversation`'s older messages, from messages.list, and, when
    /// `more` says there are none older, that the cache has them all now.
    pub fn fill_older(self, conversation: String, messages: Json, more: bool) ! Error {
        let began = try self.step()
        match self.put_messages(messages) {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        if not more {
            match self.db.execute(String("UPDATE conversations SET partial = 0 WHERE id = ?"), [t(conversation.copy())]) {
                ok(_) => {},
                err(e) => {
                    self.undo(began)
                    fail e
                },
            }
        }
        try self.step_done(began)
    }

    /// Forgets tool calls that started before `before` (Unix ms), but those of runs still
    /// going, once a day: the app shows a call's title and how it ended from here, and a
    /// heavy user makes ten thousand a day. Gives how many went.
    pub fn prune_calls(self, before: i64) -> i64 ! Error {
        let t_now = now()
        if let last = try self.meta("calls_pruned") {
            if t_now - (i64.parse(last) ?? 0) < PRUNE_EVERY_MS { return 0 }
        }
        let gone = try self.db.execute(String("DELETE FROM calls WHERE at < ? AND run NOT IN (SELECT id FROM runs)"), [Value.Int(before)])
        try self.set_meta("calls_pruned", "{t_now}")
        return i64.wrap(u64(gone))
    }

    /// Makes the runs still going exactly `runs`, as `synced` names them: one the cache
    /// missed the end of goes, with its questions, and one it missed the start of comes
    /// in. Done in one step, so a crash leaves the runs as they were. A run it has
    /// already keeps the run.started it came with.
    pub fn keep_runs(self, runs: Json) ! Error {
        let Json.Array(going) = runs else return
        let began = try self.step()
        match self.put_runs(going) {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        try self.step_done(began)
    }

    /// Makes the sidebar's folders exactly `groups`, as `synced` gives them, in their
    /// order. A synced from an instance from before folders has none, and changes nothing.
    pub fn keep_groups(self, groups: Json) ! Error {
        let Json.Array(all) = groups else return
        let began = try self.step()
        match self.put_groups(all) {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        try self.step_done(began)
    }

    fn put_groups(self, all: List<Json>) ! Error {
        // Only when they differ, so the folders keep their rows, and the app reads the
        // sidebar again only when they changed.
        if try self.texts(GROUPS, List<Value>()) == all.map(|g| "{g}") { return }
        _ = try self.db.execute(String("DELETE FROM groups"), List<Value>())
        for g in all {
            _ = try self.db.execute(String("INSERT INTO groups (id, json) VALUES (?, ?)"), [t(str_at(g.copy(), "id") ?? String()), t("{g}")])
        }
    }

    /// How the sidebar groups the agents (`core/sidebar.calx`).
    pub fn sidebar(self) -> Json ! Error {
        var waiting = List<String>()
        for id in try self.texts(WAITING, List<Value>()) {
            if id.len() > 0 { waiting.push(id.copy()) }
        }
        return sidebar.arrange(try self.all(ROOMS, List<Value>()), try self.agents(), try self.all(GROUPS, List<Value>()), waiting)
    }

    fn put_runs(self, going: List<Json>) ! Error {
        var ids = List<Json>()
        for r in going {
            let id = str_at(r.copy(), "run") ?? String()
            ids.push(Json.Str(id.copy()))
            _ = try self.db.execute(String("INSERT OR IGNORE INTO runs (id, conversation, json) VALUES (?, ?, ?)"), [t(id), t(str_at(r.copy(), "conversation") ?? String()), t("{r}")])
        }
        let kept = "{Json.Array(ids)}"
        _ = try self.db.execute(String("DELETE FROM approvals WHERE run NOT IN (SELECT value FROM json_each(?))"), [t(kept.copy())])
        _ = try self.db.execute(String("DELETE FROM runs WHERE id NOT IN (SELECT value FROM json_each(?))"), [t(kept.copy())])
        // And the calls of runs that are over, left open by an instance from before it
        // closed them, or by a run.finished the cache missed.
        _ = try self.db.execute(String("UPDATE calls SET status = 'cancelled' WHERE status IS NULL AND run NOT IN (SELECT value FROM json_each(?))"), [t(kept)])
    }

    /// Keeps older messages the app fetched with messages.list.
    pub fn put_messages(self, messages: Json) ! Error {
        if let Json.Array(ms) = messages {
            for m in ms {
                try self.put_message(m.copy())
            }
        }
    }

    fn put_agent(self, a: Json) ! Error {
        _ = try self.db.execute(String("INSERT INTO agents (id, json) VALUES (?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json"), [t(str_at(a, "id") ?? String()), t("{a}")])
    }

    fn put_conversation(self, c: Json) ! Error {
        let id = str_at(c, "id") ?? String()
        let when = int_at(c, "at") ?? 0
        _ = try self.db.execute(String("INSERT INTO conversations (id, json, last, agent, chat) VALUES (?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json, agent = excluded.agent, chat = excluded.chat"), [t(id), t("{c}"), Value.Int(when), maybe(str_at(c.copy(), "agent")), Value.Int(chat_of(c.copy()))])
        try self.one_main(c)
    }

    // An agent has one chat: once conversation `c` is marked its agent's (`main`), no
    // other of that agent's is, though the event that says so hasn't come yet.
    fn one_main(self, c: Json) ! Error {
        if bool_at(c.copy(), "main") != some(true) { return }
        _ = try self.db.execute(String("UPDATE conversations SET json = json_remove(json, '$.main') WHERE agent = ? AND id != ? AND json_extract(json, '$.main') = 1"), [maybe(str_at(c.copy(), "agent")), t(str_at(c, "id") ?? String())])
    }

    fn put_message(self, m: Json) ! Error {
        let id = str_at(m, "id") ?? String()
        let conversation = str_at(m, "conversation") ?? String()
        let when = int_at(m, "at") ?? 0
        _ = try self.db.execute(String("INSERT OR REPLACE INTO messages (id, conversation, at, json) VALUES (?, ?, ?, ?)"), [t(id), t(conversation.copy()), Value.Int(when), t("{m}")])
        _ = try self.db.execute(String("UPDATE conversations SET last = max(last, ?) WHERE id = ?"), [Value.Int(when), t(conversation.copy())])
        if str_at(m, "role") == some(String("agent")) { _ = try self.db.execute(String("UPDATE conversations SET replied = max(replied, ?) WHERE id = ?"), [Value.Int(when), t(conversation)]) }
    }

    fn one(self, sql: str, id: String) -> Json? ! Error {
        let row = try self.db.query_one(String(sql), [t(id.copy())])
        let r = row else return none
        return some(try parse(text(r[0])))
    }

    fn texts(self, sql: str, params: List<Value>) -> List<String> ! Error {
        var out = List<String>()
        for r in try self.db.query(String(sql), params) {
            out.push(text(r[0]))
        }
        return out
    }

    fn all(self, sql: str, params: List<Value>) -> List<Json> ! Error {
        var out = List<Json>()
        for s in try self.texts(sql, params) {
            out.push(try parse(s))
        }
        return out
    }

    // --- Reading ---

    pub fn agents(self) -> List<Json> ! Error {
        return try self.all(AGENTS, List<Value>())
    }

    /// The conversations, the one with the newest message first.
    pub fn conversations(self) -> List<Json> ! Error {
        return try self.all(CONVERSATIONS, List<Value>())
    }

    pub fn devices(self) -> List<Json> ! Error {
        return try self.all(DEVICES, List<Value>())
    }

    /// The runs still going, as their run.started events.
    pub fn runs(self) -> List<Json> ! Error {
        return try self.all(RUNS, List<Value>())
    }

    /// The tool calls, so a reply's tool blocks can show what ran. They stay after their run.
    pub fn tools(self) -> List<Json> ! Error {
        return try self.all(TOOLS, List<Value>())
    }

    /// The questions nobody has answered, as their approval.needed events.
    pub fn approvals(self) -> List<Json> ! Error {
        return try self.all(APPROVALS, List<Value>())
    }

    /// A list the app asks for, `what` as in `core.get`, as a JSON array's text, made
    /// from the rows' JSON as it's kept, with nothing parsed. None for messages, which
    /// `messages_text` gives, or a list there isn't. The questions, few, each come with
    /// `shown`, what the card draws of the call (`core/asks.calx`).
    pub fn list_text(self, what: String) -> String? ! Error {
        if what == "approvals" {
            var out = List<String>()
            for a in try self.approvals() {
                out.push("{merge(a.copy(), Obj.new().j("shown", asks.shown(a)).done())}")
            }
            return some(array(out))
        }
        if what == "sidebar" { return some("{try self.sidebar()}") }
        if what == "emoji" { return some("{Json.Array(try self.emoji())}") }
        let sql = if what == "agents" { AGENTS } else if what == "conversations" { CONVERSATIONS } else if what == "devices" { DEVICES } else if what == "runs" { RUNS } else if what == "tools" { TOOLS } else if what == "outbox" { OUTBOX } else { return none }
        return some(array(try self.texts(sql, List<Value>())))
    }

    /// The tool calls named in `calls`, and those of the runs in `runs`, each a JSON array
    /// of ids, as a JSON array's text: what a chat's blocks and its runs show, rather than
    /// every call ever.
    pub fn tools_text(self, calls: String, runs: String) -> String ! Error {
        return array(try self.texts(TOOLS_FOR, [t(calls.copy()), t(runs.copy())]))
    }

    fn page(self, conversation: String, before: String?, limit: i64) -> (List<String>, bool) ! Error {
        var cut = i64.MAX
        if let b = before {
            let row = try self.db.query_one(String("SELECT at FROM messages WHERE id = ?"), [t(b.copy())])
            if let r = row { cut = int(r[0].copy()) }
        }
        var newest = try self.texts("SELECT json FROM messages WHERE conversation = ? AND at < ? ORDER BY at DESC, rowid DESC LIMIT ?", [t(conversation.copy()), Value.Int(cut), Value.Int(limit + 1)])
        let more = i64.wrap(u64(newest.len())) > limit
        if more { _ = newest.pop() }
        newest.reverse()
        return (newest, more)
    }

    /// Up to `limit` of a conversation's messages before the message `before` (or the
    /// newest), oldest first, and whether there are older ones in the cache.
    pub fn messages(self, conversation: String, before: String?, limit: i64) -> (List<Json>, bool) ! Error {
        let (texts, more) = try self.page(conversation, before, limit)
        var out = List<Json>()
        for s in texts {
            out.push(try parse(s))
        }
        return (out, more)
    }

    /// `messages` as a JSON array's text, with nothing parsed.
    pub fn messages_text(self, conversation: String, before: String?, limit: i64) -> (String, bool) ! Error {
        let (texts, more) = try self.page(conversation, before, limit)
        return (array(texts), more)
    }

    // --- The outbox ---

    /// Keeps a send until the instance acks it.
    pub fn queue(self, frame: Json) ! Error {
        let cid = str_at(frame, "cid") ?? String()
        let conversation = str_at(frame, "conversation") ?? String()
        _ = try self.db.execute(String("INSERT OR REPLACE INTO outbox (cid, conversation, json, at) VALUES (?, ?, ?, ?)"), [t(cid), t(conversation), t("{frame}"), Value.Int(now())])
    }

    /// A message the cache has, by its id.
    pub fn message(self, id: String) -> Json? ! Error {
        return try self.one("SELECT json FROM messages WHERE id = ?", id.copy())
    }

    /// A run still going, as its run.started event.
    pub fn run(self, id: String) -> Json? ! Error {
        return try self.one("SELECT json FROM runs WHERE id = ?", id.copy())
    }

    /// A conversation the cache has, by its id.
    pub fn conversation(self, id: String) -> Json? ! Error {
        return try self.one("SELECT json FROM conversations WHERE id = ?", id.copy())
    }

    pub fn agent(self, id: String) -> Json? ! Error {
        return try self.one("SELECT json FROM agents WHERE id = ?", id.copy())
    }

    /// `agent`'s chat with the person, the one the app shows as that agent's chat: the
    /// conversation the instance marks `main`, however new any other is. An instance from
    /// before `main` marks none, and its chat is then its newest that may be one.
    pub fn conversation_for(self, agent: String) -> String? ! Error {
        let row = try self.db.query_one(String("SELECT id FROM conversations WHERE agent = ? AND chat = 1 ORDER BY coalesce(json_extract(json, '$.main'), 0) DESC, last DESC, rowid DESC LIMIT 1"), [t(agent.copy())])
        let r = row else return none
        return some(text(r[0]))
    }

    /// The send waiting with the client id `cid`.
    pub fn queued(self, cid: String) -> Json? ! Error {
        return try self.one("SELECT json FROM outbox WHERE cid = ?", cid.copy())
    }

    /// The sends waiting, oldest first.
    pub fn outbox(self) -> List<Json> ! Error {
        return try self.all(OUTBOX, List<Value>())
    }

    /// The instance acked a send, or refused it for good: it leaves the outbox.
    pub fn sent(self, cid: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM outbox WHERE cid = ?"), [t(cid.copy())])
    }
}

fn ev(seq: i64, kind: str, fields: Json) -> Json {
    return merge(Obj.new().s("t", String("event")).i("seq", seq).s("kind", String(kind)).done(), fields)
}

// The ids in the sidebar's section of `kind`, agents or items.
fn section_ids(c: Cache, kind: str) -> List<String> ! Error {
    var out = List<String>()
    if let Json.Array(ss) = try c.sidebar() {
        for s in ss {
            if str_at(s.copy(), "kind") != some(String(kind)) { continue }
            if let Json.Array(listed) = at(s.copy(), "agents") {
                for id in listed {
                    if let Json.Str(x) = id { out.push(x.copy()) }
                }
            }
            if let Json.Array(listed) = at(s, "items") {
                for it in listed {
                    out.push(str_at(it, "id") ?? String())
                }
            }
        }
    }
    return out
}

@test
fn the_sidebar_has_the_folders_and_who_waits() ! Error {
    let c = try Cache.open(String(":memory:"))
    let folder = |id: str, name: str| Obj.new().s("id", String(id)).s("name", String(name)).b("collapsed", false).done()
    assert(try c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_1")).s("group", String("g_1")).done()).done())))
    assert(try c.apply(ev(2, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_2")).done()).done())))
    assert(try c.apply(ev(3, "group.updated", Obj.new().j("group", folder("g_1", "Work")).done())))
    assert(try section_ids(c, "group") == [String("a_1")])
    // A question open for one of a_1's runs: it waits on the person.
    assert(try c.apply(ev(4, "run.started", Obj.new().s("run", String("run_1")).s("conversation", String("c_1")).s("agent", String("a_1")).done())))
    assert(try c.apply(ev(5, "approval.needed", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).done())))
    assert(try section_ids(c, "waiting") == [String("a_1")] and section_ids(c, "group")!.len() == 0)
    assert(try c.apply(ev(6, "approval.answered", Obj.new().s("call", String("tc_1")).done())))
    assert(section_ids(c, "waiting")!.len() == 0)
    assert(try c.apply(ev(7, "group.deleted", Obj.new().s("group", String("g_1")).done())))
    assert(try section_ids(c, "list") == [String("a_1"), String("a_2")])
    // Synced brings the folders as they are; one from an older instance, none.
    try c.keep_groups(Json.Array([folder("g_2", "Later"), folder("g_1", "Work")]))
    try c.keep_groups(Json.Null)
    let Json.Array(all) = try c.sidebar() else return
    // After pinned, waiting and the list.
    assert(str_at(all[3].copy(), "id") == some(String("g_2")) and str_at(all[4].copy(), "id") == some(String("g_1")))
    assert(try section_ids(c, "group") == [String("a_1")])
    let listed = try parse(try c.list_text(String("sidebar")) ?? String())
    assert(listed == try c.sidebar())
}

@test
fn a_group_chat_takes_its_place_and_folder_in_the_sidebar() ! Error {
    let c = try Cache.open(String(":memory:"))
    let room = |order: i64| Obj.new().s("name", String("Money")).j("members", Json.Array([Json.Str(String("a_1")), Json.Str(String("a_2"))])).i("order", order).done()
    assert(try c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_1")).i("order", 0).done()).done())))
    assert(try c.apply(ev(2, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_2")).i("order", 1).done()).done())))
    assert(try c.apply(ev(3, "conversation.created", Obj.new().j("conversation", Obj.new().s("id", String("c_5")).s("agent", String()).s("title", String("Money")).i("at", 3).j("room", room(2)).done()).done())))
    assert(try section_ids(c, "list") == [String("a_1"), String("a_2"), String("c_5")])
    // Dragged to the top, then into a folder.
    assert(try c.apply(ev(4, "conversation.updated", Obj.new().j("conversation", Obj.new().s("id", String("c_5")).j("room", room(-1)).done()).done())))
    assert(try section_ids(c, "list") == [String("c_5"), String("a_1"), String("a_2")])
    assert(try c.apply(ev(5, "group.updated", Obj.new().j("group", Obj.new().s("id", String("g_1")).s("name", String("Work")).b("collapsed", false).done()).done())))
    assert(try c.apply(ev(6, "conversation.updated", Obj.new().j("conversation", Obj.new().s("id", String("c_5")).j("room", merge(room(-1), Obj.new().s("group", String("g_1")).done())).done()).done())))
    assert(try section_ids(c, "group") == [String("c_5")] and section_ids(c, "list")! == [String("a_1"), String("a_2")])
}

@test
fn applies_events_with_the_cursor() ! Error {
    let c = try Cache.open(String(":memory:"))
    let conv = Obj.new().s("id", String("c_1")).s("agent", String("a_1")).s("title", String("Builds")).i("at", 10).done()
    assert(try c.apply(ev(1, "conversation.created", Obj.new().j("conversation", conv).done())))
    let m = Obj.new().s("id", String("msg_1")).s("conversation", String("c_1")).s("role", String("person")).i("at", 20).done()
    assert(try c.apply(ev(2, "message.created", Obj.new().s("conversation", String("c_1")).j("message", m.copy()).done())))
    assert(not try c.apply(ev(2, "message.created", Obj.new().j("message", m).done())))
    assert(try c.cursor() == 2)
    _ = try c.apply(ev(3, "conversation.updated", Obj.new().j("conversation", Obj.new().s("id", String("c_1")).s("title", String("CI")).done()).done()))
    let cs = try c.conversations()
    assert(cs.len() == 1 and str_at(cs[0].copy(), "title") == some(String("CI")) and str_at(cs[0].copy(), "agent") == some(String("a_1")))
    // With when its newest message is from, which orders the list.
    assert(int_at(cs[0].copy(), "last") == some(20))
    let (ms, more) = try c.messages(String("c_1"), none, 50)
    assert(ms.len() == 1 and not more)
    // A message that's gone goes from the cache too.
    _ = try c.apply(ev(4, "message.deleted", Obj.new().s("conversation", String("c_1")).s("message", String("msg_1")).done()))
    let (left, _) = try c.messages(String("c_1"), none, 50)
    assert(left.len() == 0)
    // And when its newest agent's message is from, which is unread while it's newer
    // than the conversation's `read`: none yet, then the reply, not the person's after it.
    assert(int_at(cs[0].copy(), "replied") == some(0))
    let reply = Obj.new().s("id", String("msg_2")).s("conversation", String("c_1")).s("role", String("agent")).i("at", 30).done()
    _ = try c.apply(ev(5, "message.created", Obj.new().s("conversation", String("c_1")).j("message", reply).done()))
    let mine = Obj.new().s("id", String("msg_3")).s("conversation", String("c_1")).s("role", String("person")).i("at", 40).done()
    _ = try c.apply(ev(6, "message.created", Obj.new().s("conversation", String("c_1")).j("message", mine).done()))
    let replied = try c.conversations()
    assert(int_at(replied[0].copy(), "last") == some(40) and int_at(replied[0].copy(), "replied") == some(30))
}

@test
fn a_routines_thread_isnt_the_agents_chat() ! Error {
    let c = try Cache.open(String(":memory:"))
    let chat = Obj.new().s("id", String("c_chat")).s("agent", String("a_1")).s("title", String("Chat")).i("at", 10).done()
    let thread = Obj.new().s("id", String("c_thread")).s("agent", String("a_1")).s("title", String("News")).s("routine", String("rt_1")).i("at", 20).done()
    _ = try c.apply(ev(1, "conversation.created", Obj.new().j("conversation", chat).done()))
    _ = try c.apply(ev(2, "conversation.created", Obj.new().j("conversation", thread).done()))
    assert(try c.conversation_for(String("a_1")) == some(String("c_chat")))
}

@test
fn another_agents_thread_isnt_the_agents_chat() ! Error {
    let c = try Cache.open(String(":memory:"))
    let chat = Obj.new().s("id", String("c_chat")).s("agent", String("a_1")).s("title", String("Chat")).i("at", 10).done()
    let asked = Obj.new().s("id", String("c_asked")).s("agent", String("a_1")).s("title", String("From Casper")).s("asked_by", String("a_2")).i("at", 20).done()
    _ = try c.apply(ev(1, "conversation.created", Obj.new().j("conversation", chat).done()))
    _ = try c.apply(ev(2, "conversation.created", Obj.new().j("conversation", asked).done()))
    assert(try c.conversation_for(String("a_1")) == some(String("c_chat")))
    // One an older instance made, newer than the chat, is the chat until the
    // instance says whose it is.
    let old = Obj.new().s("id", String("c_old")).s("agent", String("a_1")).s("title", String("From Hermes")).i("at", 30).done()
    _ = try c.apply(ev(3, "conversation.created", Obj.new().j("conversation", old).done()))
    assert(try c.conversation_for(String("a_1")) == some(String("c_old")))
    _ = try c.apply(ev(4, "conversation.updated", Obj.new().j("conversation", Obj.new().s("id", String("c_old")).s("asked_by", String("a_3")).done()).done()))
    assert(try c.conversation_for(String("a_1")) == some(String("c_chat")))
}

@test
fn the_chat_is_the_one_marked_main() ! Error {
    let c = try Cache.open(String(":memory:"))
    let chat = Obj.new().s("id", String("c_5")).s("agent", String("a_2")).s("title", String("")).b("main", true).i("at", 10).done()
    // A conversation the agent made for itself, newer, with the newest message.
    let made = Obj.new().s("id", String("c_22")).s("agent", String("a_2")).s("title", String("Plenpartner warm-up")).s("made_by", String("a_2")).i("at", 20).done()
    _ = try c.apply(ev(1, "conversation.created", Obj.new().j("conversation", chat).done()))
    _ = try c.apply(ev(2, "conversation.created", Obj.new().j("conversation", made).done()))
    _ = try c.apply(ev(3, "message.created", Obj.new().j("message", Obj.new().s("id", String("msg_1")).s("conversation", String("c_22")).i("at", 30).done()).done()))
    assert(try c.conversation_for(String("a_2")) == some(String("c_5")))
    // An older chat, unmarked, newer than the marked one, isn't it either.
    let older = Obj.new().s("id", String("c_9")).s("agent", String("a_2")).s("title", String("")).i("at", 40).done()
    _ = try c.apply(ev(4, "conversation.created", Obj.new().j("conversation", older).done()))
    assert(try c.conversation_for(String("a_2")) == some(String("c_5")))
    // The person's new chat is, and the one before isn't, before the event that says so.
    let fresh = Obj.new().s("id", String("c_30")).s("agent", String("a_2")).s("title", String("")).b("main", true).i("at", 5).done()
    _ = try c.apply(ev(5, "conversation.created", Obj.new().j("conversation", fresh).done()))
    assert(try c.conversation_for(String("a_2")) == some(String("c_30")))
    // From an older instance, as a store migrates: the thread is marked, then the chat.
    _ = try c.apply(ev(6, "conversation.updated", Obj.new().j("conversation", Obj.new().s("id", String("c_5")).b("main", true).done()).done()))
    assert(try c.conversation_for(String("a_2")) == some(String("c_5")))
    var mains = List<String>()
    for k in try c.conversations() {
        if bool_at(k.copy(), "main") == some(true) { mains.push(str_at(k, "id") ?? String()) }
    }
    assert(mains == [String("c_5")])
}

@test
fn keeps_runs_and_questions_until_they_end() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "run.started", Obj.new().s("run", String("run_1")).s("conversation", String("c_1")).done()))
    _ = try c.apply(ev(2, "approval.needed", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).done()))
    _ = try c.apply(ev(3, "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_2")).s("title", String("ls")).done()))
    _ = try c.apply(ev(4, "tool.finished", Obj.new().s("call", String("tc_2")).s("status", String("done")).done()))
    assert((try c.runs()).len() == 1 and (try c.approvals()).len() == 1)
    let tools = try c.tools()
    assert(str_at(tools[0].copy(), "status") == some(String("done")) and str_at(tools[0].copy(), "title") == some(String("ls")))
    // The app reads each with what its card shows of the call.
    let listed = try parse(try c.list_text(String("approvals")) ?? String())
    assert(at(listed.at(0) ?? Json.Null, "shown").get(String("lines")) != none)
    _ = try c.apply(ev(5, "approval.answered", Obj.new().s("call", String("tc_1")).done()))
    assert((try c.approvals()).len() == 0)
    _ = try c.apply(ev(6, "run.finished", Obj.new().s("run", String("run_1")).done()))
    assert((try c.runs()).len() == 0 and (try c.tools()).len() == 1)
}

@test
fn a_call_left_open_ends_with_its_turn() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "run.started", Obj.new().s("run", String("run_1")).s("conversation", String("c_1")).done()))
    _ = try c.apply(ev(2, "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).s("title", String("ls")).done()))
    _ = try c.apply(ev(3, "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_2")).s("title", String("rm")).done()))
    _ = try c.apply(ev(4, "tool.finished", Obj.new().s("call", String("tc_2")).s("status", String("denied")).done()))
    _ = try c.apply(ev(5, "run.started", Obj.new().s("run", String("run_2")).s("conversation", String("c_2")).done()))
    _ = try c.apply(ev(6, "tool.started", Obj.new().s("run", String("run_2")).s("call", String("tc_3")).s("title", String("cat")).done()))
    // The instance closes it as the turn ends.
    _ = try c.apply(ev(7, "tool.finished", Obj.new().s("call", String("tc_1")).s("status", String("cancelled")).done()))
    _ = try c.apply(ev(8, "run.finished", Obj.new().s("run", String("run_1")).done()))
    assert(try c.tools_text(String("[]"), String(#"["run_1","run_2"]"#)) == #"[{"call":"tc_1","run":"run_1","title":"ls","status":"cancelled"},{"call":"tc_2","run":"run_1","title":"rm","status":"denied"},{"call":"tc_3","run":"run_2","title":"cat","status":null}]"#)
}

@test
fn a_call_an_older_instance_left_open_ends_too() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "run.started", Obj.new().s("run", String("run_1")).s("conversation", String("c_1")).done()))
    _ = try c.apply(ev(2, "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).s("title", String("ls")).done()))
    _ = try c.apply(ev(3, "run.finished", Obj.new().s("run", String("run_1")).done()))
    // One whose run.finished the cache missed, and one still going.
    _ = try c.apply(ev(4, "tool.started", Obj.new().s("run", String("run_2")).s("call", String("tc_2")).s("title", String("cat")).done()))
    _ = try c.apply(ev(5, "tool.started", Obj.new().s("run", String("run_3")).s("call", String("tc_3")).s("title", String("grep")).done()))
    try c.keep_runs(Json.Array([Obj.new().s("run", String("run_3")).s("conversation", String("c_3")).done()]))
    assert(try c.tools_text(String("[]"), String(#"["run_1","run_2","run_3"]"#)) == #"[{"call":"tc_1","run":"run_1","title":"ls","status":"cancelled"},{"call":"tc_2","run":"run_2","title":"cat","status":"cancelled"},{"call":"tc_3","run":"run_3","title":"grep","status":null}]"#)
}

@test
fn synced_makes_the_runs_those_still_going() ! Error {
    let c = try Cache.open(String(":memory:"))
    // One whose run.finished the cache missed, with its question, and one that's going.
    _ = try c.apply(ev(1, "run.started", Obj.new().s("run", String("run_1")).s("conversation", String("c_1")).s("agent", String("a_1")).done()))
    _ = try c.apply(ev(2, "approval.needed", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).done()))
    _ = try c.apply(ev(3, "run.started", Obj.new().s("run", String("run_2")).s("conversation", String("c_2")).s("agent", String("a_2")).i("revision", 4).done()))
    // And one whose run.started it missed.
    let going = Json.Array([Obj.new().s("run", String("run_2")).s("conversation", String("c_2")).s("agent", String("a_2")).done(), Obj.new().s("run", String("run_3")).s("conversation", String("c_3")).s("agent", String("a_3")).s("message", String("msg_9")).done()])
    try c.keep_runs(going)
    let runs = try c.runs()
    assert(runs.len() == 2)
    assert(str_at(runs[0].copy(), "run") == some(String("run_2")) and int_at(runs[0].copy(), "revision") == some(4))
    assert(str_at(runs[1].copy(), "run") == some(String("run_3")) and str_at(runs[1].copy(), "message") == some(String("msg_9")))
    assert((try c.approvals()).len() == 0)
    assert(try c.run(String("run_1")) == none)
    // A synced without runs, from an older instance, changes nothing; none going keeps none.
    try c.keep_runs(Json.Null)
    assert((try c.runs()).len() == 2)
    try c.keep_runs(Json.Array(List<Json>()))
    assert((try c.runs()).len() == 0)
}

@test
fn pages_messages_oldest_first() ! Error {
    let c = try Cache.open(String(":memory:"))
    var ms = List<Json>()
    for i in 1..6 {
        ms.push(Obj.new().s("id", "msg_{i}").s("conversation", String("c_1")).i("at", i64(i)).done())
    }
    try c.put_messages(Json.Array(ms))
    let (page, more) = try c.messages(String("c_1"), none, 2)
    assert(page.len() == 2 and more and str_at(page[0].copy(), "id") == some(String("msg_4")))
    let (older, more_again) = try c.messages(String("c_1"), some(String("msg_4")), 10)
    assert(older.len() == 3 and not more_again and str_at(older[0].copy(), "id") == some(String("msg_1")))
}

@test
fn a_changed_agent_keeps_its_place() ! Error {
