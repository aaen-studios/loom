    assert(str_at(agents[0].copy(), "id") == some(String("a_1")) and str_at(agents[0].copy(), "shape") == some(String("yarn")))
}

@test
fn a_snapshot_replaces_everything_but_the_outbox() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_1")).done()).done()))
    try c.queue(Obj.new().s("t", String("send")).s("cid", String("m_1")).s("conversation", String("c_1")).s("text", String("hi")).done())
    try c.replace(Obj.new().s("t", String("snapshot")).i("seq", 40).j("agents", Json.Array([Obj.new().s("id", String("a_2")).done()])).done())
    let agents = try c.agents()
    assert(agents.len() == 1 and str_at(agents[0].copy(), "id") == some(String("a_2")))
    assert(try c.cursor() == 40)
    assert((try c.outbox()).len() == 1)
    try c.sent(String("m_1"))
    assert((try c.outbox()).len() == 0)
}

@test
fn a_snapshot_says_which_conversations_it_left_messages_of_out() ! Error {
    let c = try Cache.open(String(":memory:"))
    let conversations = Json.Array([Obj.new().s("id", String("c_1")).i("at", 1).done(), Obj.new().s("id", String("c_2")).i("at", 2).done()])
    let messages = Json.Array([Obj.new().s("id", String("msg_9")).s("conversation", String("c_1")).i("at", 9).done()])
    try c.replace(Obj.new().s("t", String("snapshot")).i("seq", 5).j("conversations", conversations.copy()).j("messages", messages).j("partial", Json.Array([Json.Str(String("c_1"))])).done())
    assert(try c.partial(String("c_1")) and not try c.partial(String("c_2")))
    assert(try c.oldest(String("c_1")) == some(String("msg_9")) and try c.oldest(String("c_2")) == none)
    // A page of older ones that isn't the last keeps it partial; the last doesn't.
    try c.fill_older(String("c_1"), Json.Array([Obj.new().s("id", String("msg_5")).s("conversation", String("c_1")).i("at", 5).done()]), true)
    assert(try c.partial(String("c_1")) and try c.oldest(String("c_1")) == some(String("msg_5")))
    try c.fill_older(String("c_1"), Json.Array([Obj.new().s("id", String("msg_2")).s("conversation", String("c_1")).i("at", 2).done()]), false)
    assert(not try c.partial(String("c_1")))
    let (ms, more) = try c.messages(String("c_1"), none, 50)
    assert(ms.len() == 3 and not more)
    // One from an instance from before `partial` could have left out any.
    try c.replace(Obj.new().s("t", String("snapshot")).i("seq", 6).j("conversations", conversations).done())
    assert(try c.partial(String("c_1")) and try c.partial(String("c_2")))
    // A conversation made since has them all, unless it came in from another app with more.
    _ = try c.apply(ev(7, "conversation.created", Obj.new().j("conversation", Obj.new().s("id", String("c_3")).done()).done()))
    _ = try c.apply(ev(8, "conversation.created", Obj.new().j("conversation", Obj.new().s("id", String("c_4")).done()).b("partial", true).done()))
    assert(not try c.partial(String("c_3")) and try c.partial(String("c_4")))
    // Its updates keep it as it is.
    _ = try c.apply(ev(9, "conversation.updated", Obj.new().j("conversation", Obj.new().s("id", String("c_4")).s("title", String("Old")).done()).done()))
    assert(try c.partial(String("c_4")))
}

@test
fn old_tool_calls_go_but_not_a_running_ones() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "run.started", Obj.new().s("run", String("run_2")).s("conversation", String("c_1")).done()))
    _ = try c.apply(ev(2, "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).i("at", 1000).done()))
    _ = try c.apply(ev(3, "tool.started", Obj.new().s("run", String("run_2")).s("call", String("tc_2")).i("at", 1000).done()))
    _ = try c.apply(ev(4, "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_3")).i("at", 5000).done()))
    // Older than 2000 and not going: only tc_1. Then not again for a day.
    assert(try c.prune_calls(2000) == 1)
    assert(try c.tools_text(String(#"["tc_1","tc_2","tc_3"]"#), String("[]")) == #"[{"call":"tc_2","run":"run_2","title":null,"status":null},{"call":"tc_3","run":"run_1","title":null,"status":null}]"#)
    _ = try c.apply(ev(5, "run.finished", Obj.new().s("run", String("run_2")).done()))
    assert(try c.prune_calls(2000) == 0)
    // A day later it looks again.
    try c.set_meta("calls_pruned", "{now() - PRUNE_EVERY_MS - 1}")
    assert(try c.prune_calls(2000) == 1)
    assert((try c.tools()).len() == 1)
}

@test
fn a_cache_from_before_partial_fetches_what_it_may_miss() ! Error {
    // Before conversations said whether the cache has all their messages, and before
    // calls kept when they started.
    let dir = try fs.temp_dir()
    let path = "{dir}/cache.db"
    let old = try Database.open(path.copy())
    try old.execute_script(String(#"
CREATE TABLE conversations (id TEXT PRIMARY KEY, json TEXT NOT NULL, last INTEGER NOT NULL, agent TEXT, chat INTEGER NOT NULL DEFAULT 0);
CREATE TABLE calls (call TEXT PRIMARY KEY, run TEXT NOT NULL, title TEXT, status TEXT, block INTEGER, parent TEXT);
INSERT INTO conversations VALUES ('c_1', '{"id":"c_1","agent":"a_1","at":10}', 10, 'a_1', 1);
INSERT INTO calls VALUES ('tc_1', 'r_1', 'ls', 'done', 0, NULL);
"#))
    try old.close()
    {
        let c = try Cache.open(path.copy())
        assert(try c.partial(String("c_1")))
        // Its calls count from the update, so none is old yet.
        assert(try c.prune_calls(now() - 60000) == 0)
        assert((try c.tools()).len() == 1)
    }
    match fs.remove_dir_all(dir) {
        ok => {},
        err(_) => {},
    }
}

@test
fn a_held_burst_is_saved_together() ! Error {
    let c = try Cache.open(String(":memory:"))
    try c.hold()
    _ = try c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_1")).done()).done()))
    try c.replace(Obj.new().s("t", String("snapshot")).i("seq", 5).j("agents", Json.Array([Obj.new().s("id", String("a_2")).done()])).done())
    _ = try c.apply(ev(6, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_3")).done()).done()))
    try c.let_go()
    assert(try c.cursor() == 6)
    assert((try c.agents()).len() == 2)
    // Nothing held: each event is its own transaction, as before.
    _ = try c.apply(ev(7, "agent.deleted", Obj.new().s("agent", String("a_2")).done()))
    assert(try c.cursor() == 7 and (try c.agents()).len() == 1)
}

@test
