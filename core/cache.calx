module core.cache

// The core's local cache (PLAN.md, "What the core does"): agents,
// conversations, messages, devices, the runs still going and the questions
// still open, so the app opens at once and reads offline. Each event is
// applied in one transaction with the cursor, the event's seq, so a crash
// never leaves the two apart (protocol.md, "The event log").
//
// The outbox lives here too: a message the person wrote waits here with its
// client id until the instance acks it.
import std.json.{Json, parse}
import std.sqlite.{Database, Value}
import std.time.{Timestamp}
import shared.obj.{Obj, at, int_at, merge, str_at}
import shared.checkpoint
import std.fs
import std.thread.{Task, sleep}

const SCHEMA: str = #"
CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS agents (id TEXT PRIMARY KEY, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS conversations (
    id TEXT PRIMARY KEY, json TEXT NOT NULL, last INTEGER NOT NULL, agent TEXT, chat INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS messages (
    id TEXT PRIMARY KEY, conversation TEXT NOT NULL, at INTEGER NOT NULL, json TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS messages_by_conversation ON messages (conversation, at);
CREATE TABLE IF NOT EXISTS devices (id TEXT PRIMARY KEY, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS runs (id TEXT PRIMARY KEY, conversation TEXT NOT NULL, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS calls (call TEXT PRIMARY KEY, run TEXT NOT NULL, title TEXT, status TEXT);
CREATE INDEX IF NOT EXISTS calls_by_run ON calls (run);
CREATE TABLE IF NOT EXISTS approvals (call TEXT PRIMARY KEY, run TEXT NOT NULL, json TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS outbox (
    cid TEXT PRIMARY KEY, conversation TEXT NOT NULL, json TEXT NOT NULL, at INTEGER NOT NULL);
"#

// Everything that came from the instance, which a reset or another login clears.
const TABLES: [str; 7] = ["agents", "conversations", "messages", "devices", "runs", "calls", "approvals"]

// What each list the app reads is, in order.
const AGENTS: str = "SELECT json FROM agents ORDER BY rowid"
const CONVERSATIONS: str = "SELECT json FROM conversations ORDER BY last DESC, rowid DESC"
const DEVICES: str = "SELECT json FROM devices ORDER BY rowid"
const RUNS: str = "SELECT json FROM runs ORDER BY rowid"
// What a tool block shows of each call: its call, run, title and status, which is all
// the cache keeps of it. A call's input and output can be many KB, no app reads them
// from here, and the apps ask again at every tool event.
const TOOLS_FOR: str = "SELECT json_object('call', call, 'run', run, 'title', title, 'status', status) FROM calls WHERE call IN (SELECT value FROM json_each(?)) OR run IN (SELECT value FROM json_each(?)) ORDER BY rowid"
const TOOLS: str = "SELECT json_object('call', call, 'run', run, 'title', title, 'status', status) FROM calls ORDER BY rowid"

// A cache from before calls and the conversations' agent column: what it had is moved over.
const FROM_TOOLS: str = #"
BEGIN;
INSERT OR IGNORE INTO calls (call, run, title, status)
    SELECT call, run, json_extract(json, '$.title'), json_extract(json, '$.status') FROM tools ORDER BY rowid;
DROP TABLE tools;
COMMIT;
"#
const AGENT_COLUMN: str = #"
BEGIN;
ALTER TABLE conversations ADD COLUMN agent TEXT;
ALTER TABLE conversations ADD COLUMN chat INTEGER NOT NULL DEFAULT 0;
UPDATE conversations SET agent = json_extract(json, '$.agent'),
    chat = (json_extract(json, '$.task') IS NULL AND json_extract(json, '$.side') IS NULL AND json_extract(json, '$.branch_of') IS NULL AND json_extract(json, '$.routine') IS NULL);
COMMIT;
"#
// Each agent's chat, newest first, for `conversation_for` at a send.
const CHATS_BY_AGENT: str = "CREATE INDEX IF NOT EXISTS chats_by_agent ON conversations (agent, last DESC) WHERE chat = 1;"
const APPROVALS: str = "SELECT json FROM approvals ORDER BY rowid"
const OUTBOX: str = "SELECT json FROM outbox ORDER BY at, rowid"

// A JSON array of `items`, each JSON already.
fn array(items: List<String>) -> String {
    return "[{items.join(",")}]"
}

pub fn now() -> i64 {
    return unsafe { Timestamp.now() }.unix_ms
}

fn text(v: Value) -> String {
    match v {
        Value.Text(s) => return s.copy(),
        Value.Int(n) => return "{n}",
        _ => return String(),
    }
}

fn int(v: Value) -> i64 {
    match v {
        Value.Int(n) => return n,
        _ => return 0,
    }
}

fn t(s: own String) -> Value {
    return Value.Text(s)
}

fn maybe(s: own String?) -> Value {
    if let v = s { return Value.Text(v) }
    return Value.Null
}

// Whether a conversation is its agent's chat, rather than a task's, a side
// question's, a branch's or a routine's: 1 or 0.
fn chat_of(c: Json) -> i64 {
    for key in ["task", "side", "branch_of", "routine"] {
        if at(c, key) != Json.Null { return 0 }
    }
    return 1
}

/// Takes the lock that makes a core the only one using the data folder `data`: its
/// cache, and the instance in the app. Two looms running at once, as when one was
/// started again while the other waited in the tray, both wrote every event to the
/// same cache. It waits up to `wait_ms` for a core that's stopping, as when the app
/// starts another core for the folder before the old one has gone; none if the lock
/// is still held then. `release` lets it go.
pub fn own_folder(data: String, wait_ms: i64) -> fs.FileLock? ! Error {
    let until = now() + wait_ms
    loop {
        if let l = try fs.try_lock("{data}/core.lock", List<u8>()) { return some(l) }
        if now() >= until { return none }
        unsafe { sleep(50000000) }
    }
}

pub struct Cache {
    db: Database
    stop_checkpoints: Sender<bool>?    // the thread that checkpoints it, which stops when this goes
    big: Receiver<bool>?    // that thread saying the log grew long
}

impl Cache {
    /// Opens (or makes) the cache at `path`, or one in memory for `:memory:`.
    pub fn open(path: String) -> Cache ! Error {
        let db = try Database.open(path.copy())
        try db.execute_script(String("PRAGMA journal_mode = WAL;"))
        var stop: Sender<bool>? = none
        var big: Receiver<bool>? = none
        if path != ":memory:" {
            // The core's thread doesn't checkpoint by itself: a commit that took the log
            // past 1000 pages held up the app's reads for up to 50 ms. A thread of its own
            // does it (shared/checkpoint.calx), and the log goes back to 64 MB after a burst.
            try db.execute_script(String("PRAGMA wal_autocheckpoint = 0; PRAGMA journal_size_limit = 67108864;"))
            let (_, s, b) = checkpoint.start(path)
            stop = some(s)
            big = some(b)
        }
        try db.execute_script(String(SCHEMA))
        if try db.query_one(String("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'tools'"), List<Value>()) != none {
            try db.execute_script(String(FROM_TOOLS))
        }
        if try db.query_one(String("SELECT 1 FROM pragma_table_info('conversations') WHERE name = 'agent'"), List<Value>()) == none {
            try db.execute_script(String(AGENT_COLUMN))
        }
        try db.execute_script(String(CHATS_BY_AGENT))
        return Cache { db: db, stop_checkpoints: stop, big: big }
    }

    pub fn meta(self, key: str) -> String? ! Error {
        let row = try self.db.query_one(String("SELECT value FROM meta WHERE key = ?"), [t(String(key))])
        let r = row else return none
        return some(text(r[0]))
    }

    pub fn set_meta(self, key: str, value: String) ! Error {
        _ = try self.db.execute(String("INSERT INTO meta (key, value) VALUES (?, ?) ON CONFLICT (key) DO UPDATE SET value = excluded.value"), [t(String(key)), t(value.copy())])
    }

    /// The seq of the newest event applied: the `after` for the next hello.
    pub fn cursor(self) -> i64 ! Error {
        let c = try self.meta("cursor") else return 0
        return i64.parse(c) ?? 0
    }

    /// Forgets everything that came from the instance, the cursor with it. The outbox stays.
    pub fn clear(self) ! Error {
        for table in TABLES {
            _ = try self.db.execute("DELETE FROM {table}")
        }
        _ = try self.db.execute(String("DELETE FROM meta WHERE key = 'cursor'"))
    }

    // One step of changes that land together or not at all: a transaction of its own
    // outside `hold`, and a savepoint in the held one inside it. Gives whether it began
    // the transaction, for `step_done` and `undo`.
    //
    // A transaction that may read before it writes takes the write lock as it begins
    // (BEGIN IMMEDIATE). One that took it at its first write, after reading, failed at
    // once with "database is locked" whenever another connection had written since,
    // or was writing, whatever the busy timeout: SQLite can't wait there without
    // risking a deadlock. Taken first, it waits for the other connection as long as
    // the busy timeout.
    fn step(self) -> bool ! Error {
        if self.db.in_transaction() {
            _ = try self.db.execute(String("SAVEPOINT step"))
            return false
        }
        _ = try self.db.execute(String("BEGIN IMMEDIATE"))
        return true
    }

    fn step_done(self, began: bool) ! Error {
        if not began {
            _ = try self.db.execute(String("RELEASE step"))
            return
        }
        match self.db.commit() {
            ok => {},
            err(e) => {
                self.undo(true)
                fail e
            },
        }
    }

    fn undo(self, began: bool) {
        if began {
            match self.db.rollback() {
                ok => {},
                err(_) => {},    // the transaction ends with the connection anyway
            }
            return
        }
        match self.db.execute(String("ROLLBACK TO step")) {
            ok(_) => {},
            err(_) => {},
        }
        match self.db.execute(String("RELEASE step")) {
            ok(_) => {},
            err(_) => {},
        }
    }

    /// Keeps what's applied from here on in one transaction until `let_go`, so a burst
    /// of events, such as catching up, is written once rather than once an event. It
    /// takes the write lock at once, as `step` does.
    pub fn hold(self) ! Error {
        if not self.db.in_transaction() { _ = try self.db.execute(String("BEGIN IMMEDIATE")) }
    }

    /// Truncates the log once the checkpoint thread says it grew long, outside a
    /// transaction (shared/checkpoint.calx, `truncate`).
    pub fn truncate_if_big(mut self) ! Error {
        if let b = mut self.big { try checkpoint.truncate(self.db, mut b) }
    }

    /// Saves what was applied since `hold`.
    pub fn let_go(self) ! Error {
        if not self.db.in_transaction() { return }
        match self.db.commit() {
            ok => {},
            err(e) => {
                match self.db.rollback() {
                    ok => {},
                    err(_) => {},
                }
                fail e
            },
        }
    }

    // --- Applying what the instance sends ---

    /// Applies an event and moves the cursor to its seq, together. An event at or before
    /// the cursor was applied already, and is skipped. Gives whether it was applied.
    pub fn apply(self, event: Json) -> bool ! Error {
        let seq = int_at(event, "seq") ?? 0
        let began = try self.step()
        // The cursor is read in the step, so it's the one the step moves.
        let ahead = match self.cursor() {
            ok(c) => seq > c,
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        if not ahead {
            try self.step_done(began)
            return false
        }
        match self.change(event) {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        match self.set_meta("cursor", "{seq}") {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        try self.step_done(began)
        return true
    }

    fn change(self, e: Json) ! Error {
        let kind = str_at(e, "kind") ?? String()
        if kind == "conversation.created" {
            try self.put_conversation(at(e, "conversation"))
        } else if kind == "conversation.updated" {
            let c = at(e, "conversation")
            let id = str_at(c, "id") ?? String()
            if let old = try self.one("SELECT json FROM conversations WHERE id = ?", id.copy()) {
                let merged = merge(old, c)
                _ = try self.db.execute(String("UPDATE conversations SET json = ?, agent = ?, chat = ? WHERE id = ?"), [t("{merged}"), maybe(str_at(merged, "agent")), Value.Int(chat_of(merged)), t(id)])
            }
        } else if kind == "conversation.deleted" {
            let id = str_at(e, "conversation") ?? String()
            _ = try self.db.execute(String("DELETE FROM conversations WHERE id = ?"), [t(id.copy())])
            _ = try self.db.execute(String("DELETE FROM messages WHERE conversation = ?"), [t(id.copy())])
        } else if kind == "message.created" or kind == "message.updated" {
            try self.put_message(at(e, "message"))
        } else if kind == "message.deleted" {
            _ = try self.db.execute(String("DELETE FROM messages WHERE id = ?"), [t(str_at(e, "message") ?? String())])
        } else if kind == "run.started" {
            let id = str_at(e, "run") ?? String()
            let conversation = str_at(e, "conversation") ?? String()
            _ = try self.db.execute(String("INSERT OR REPLACE INTO runs (id, conversation, json) VALUES (?, ?, ?)"), [t(id), t(conversation), t("{e}")])
        } else if kind == "run.finished" {
            let id = str_at(e, "run") ?? String()
            _ = try self.db.execute(String("DELETE FROM runs WHERE id = ?"), [t(id.copy())])
            _ = try self.db.execute(String("DELETE FROM approvals WHERE run = ?"), [t(id)])
        } else if kind == "tool.started" {
            let call = str_at(e, "call") ?? String()
            let run = str_at(e, "run") ?? String()
            _ = try self.db.execute(String("INSERT OR REPLACE INTO calls (call, run, title, status) VALUES (?, ?, ?, ?)"), [t(call), t(run), maybe(str_at(e, "title")), maybe(str_at(e, "status"))])
        } else if kind == "tool.updated" or kind == "tool.finished" {
            // Only what changed, set in place: no stored JSON read, merged and written back.
            let call = str_at(e, "call") ?? String()
            _ = try self.db.execute(String("UPDATE calls SET title = coalesce(?, title), status = coalesce(?, status) WHERE call = ?"), [maybe(str_at(e, "title")), maybe(str_at(e, "status")), t(call)])
        } else if kind == "approval.needed" {
            let call = str_at(e, "call") ?? String()
            let run = str_at(e, "run") ?? String()
            _ = try self.db.execute(String("INSERT OR REPLACE INTO approvals (call, run, json) VALUES (?, ?, ?)"), [t(call), t(run), t("{e}")])
        } else if kind == "approval.answered" {
            _ = try self.db.execute(String("DELETE FROM approvals WHERE call = ?"), [t(str_at(e, "call") ?? String())])
        } else if kind == "agent.created" or kind == "agent.updated" {
            try self.put_agent(at(e, "agent"))
        } else if kind == "agent.deleted" {
            _ = try self.db.execute(String("DELETE FROM agents WHERE id = ?"), [t(str_at(e, "agent") ?? String())])
        } else if kind == "device.added" {
            let d = at(e, "device")
            _ = try self.db.execute(String("INSERT OR REPLACE INTO devices (id, json) VALUES (?, ?)"), [t(str_at(d, "id") ?? String()), t("{d}")])
        } else if kind == "device.updated" {
            let d = at(e, "device")
            let id = str_at(d, "id") ?? String()
            if let old = try self.one("SELECT json FROM devices WHERE id = ?", id.copy()) {
                _ = try self.db.execute(String("UPDATE devices SET json = ? WHERE id = ?"), [t("{merge(old, d)}"), t(id)])
            }
        } else if kind == "device.revoked" {
            _ = try self.db.execute(String("DELETE FROM devices WHERE id = ?"), [t(str_at(e, "device") ?? String())])
        }
    }

    /// Replaces everything with a snapshot, after a welcome with reset, and moves the
    /// cursor to its seq.
    pub fn replace(self, snapshot: Json) ! Error {
        let began = try self.step()
        match self.fill(snapshot) {
            ok => {},
            err(e) => {
                self.undo(began)
                fail e
            },
        }
        try self.step_done(began)
    }

    fn fill(self, s: Json) ! Error {
        try self.clear()
        if let Json.Array(agents) = at(s.copy(), "agents") {
            for a in agents {
                try self.put_agent(a.copy())
            }
        }
        if let Json.Array(conversations) = at(s.copy(), "conversations") {
            for c in conversations {
                try self.put_conversation(c.copy())
            }
        }
        if let Json.Array(messages) = at(s.copy(), "messages") {
            for m in messages {
                try self.put_message(m.copy())
            }
        }
        try self.set_meta("cursor", "{int_at(s, "seq") ?? 0}")
    }

    /// Makes the runs still going exactly `runs`, as `synced` names them: one the cache
    /// missed the end of goes, with its questions, and one it missed the start of comes
    /// in. Done in one step, so a crash leaves the runs as they were. A run it has
    /// already keeps the run.started it came with.
    pub fn keep_runs(self, runs: Json) ! Error {
        let Json.Array(going) = runs else return
        try self.step()
        match self.put_runs(going) {
            ok => {},
            err(e) => {
                self.undo()
                fail e
            },
        }
        try self.step_done()
    }

    fn put_runs(self, going: List<Json>) ! Error {
        var ids = List<Json>()
        for r in going {
            let id = str_at(r.copy(), "run") ?? String()
            ids.push(Json.Str(id.copy()))
            _ = try self.db.execute(String("INSERT OR IGNORE INTO runs (id, conversation, json) VALUES (?, ?, ?)"), [t(id), t(str_at(r.copy(), "conversation") ?? String()), t("{r}")])
        }
        let kept = "{Json.Array(ids)}"
        _ = try self.db.execute(String("DELETE FROM approvals WHERE run NOT IN (SELECT value FROM json_each(?))"), [t(kept.copy())])
        _ = try self.db.execute(String("DELETE FROM runs WHERE id NOT IN (SELECT value FROM json_each(?))"), [t(kept)])
    }

    /// Keeps older messages the app fetched with messages.list.
    pub fn put_messages(self, messages: Json) ! Error {
        if let Json.Array(ms) = messages {
            for m in ms {
                try self.put_message(m.copy())
            }
        }
    }

    fn put_agent(self, a: Json) ! Error {
        _ = try self.db.execute(String("INSERT INTO agents (id, json) VALUES (?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json"), [t(str_at(a, "id") ?? String()), t("{a}")])
    }

    fn put_conversation(self, c: Json) ! Error {
        let id = str_at(c, "id") ?? String()
        let when = int_at(c, "at") ?? 0
        _ = try self.db.execute(String("INSERT INTO conversations (id, json, last, agent, chat) VALUES (?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET json = excluded.json, agent = excluded.agent, chat = excluded.chat"), [t(id), t("{c}"), Value.Int(when), maybe(str_at(c, "agent")), Value.Int(chat_of(c))])
    }

    fn put_message(self, m: Json) ! Error {
        let id = str_at(m, "id") ?? String()
        let conversation = str_at(m, "conversation") ?? String()
        let when = int_at(m, "at") ?? 0
        _ = try self.db.execute(String("INSERT OR REPLACE INTO messages (id, conversation, at, json) VALUES (?, ?, ?, ?)"), [t(id), t(conversation.copy()), Value.Int(when), t("{m}")])
        _ = try self.db.execute(String("UPDATE conversations SET last = max(last, ?) WHERE id = ?"), [Value.Int(when), t(conversation)])
    }

    fn one(self, sql: str, id: String) -> Json? ! Error {
        let row = try self.db.query_one(String(sql), [t(id.copy())])
        let r = row else return none
        return some(try parse(text(r[0])))
    }

    fn texts(self, sql: str, params: List<Value>) -> List<String> ! Error {
        var out = List<String>()
        for r in try self.db.query(String(sql), params) {
            out.push(text(r[0]))
        }
        return out
    }

    fn all(self, sql: str, params: List<Value>) -> List<Json> ! Error {
        var out = List<Json>()
        for s in try self.texts(sql, params) {
            out.push(try parse(s))
        }
        return out
    }

    // --- Reading ---

    pub fn agents(self) -> List<Json> ! Error {
        return try self.all(AGENTS, List<Value>())
    }

    /// The conversations, the one with the newest message first.
    pub fn conversations(self) -> List<Json> ! Error {
        return try self.all(CONVERSATIONS, List<Value>())
    }

    pub fn devices(self) -> List<Json> ! Error {
        return try self.all(DEVICES, List<Value>())
    }

    /// The runs still going, as their run.started events.
    pub fn runs(self) -> List<Json> ! Error {
        return try self.all(RUNS, List<Value>())
    }

    /// The tool calls, so a reply's tool blocks can show what ran. They stay after their run.
    pub fn tools(self) -> List<Json> ! Error {
        return try self.all(TOOLS, List<Value>())
    }

    /// The questions nobody has answered, as their approval.needed events.
    pub fn approvals(self) -> List<Json> ! Error {
        return try self.all(APPROVALS, List<Value>())
    }

    /// A list the app asks for, `what` as in `core.get`, as a JSON array's text, made
    /// from the rows' JSON as it's kept, with nothing parsed. None for messages, which
    /// `messages_text` gives, or a list there isn't.
    pub fn list_text(self, what: String) -> String? ! Error {
        let sql = if what == "agents" { AGENTS } else if what == "conversations" { CONVERSATIONS } else if what == "devices" { DEVICES } else if what == "runs" { RUNS } else if what == "tools" { TOOLS } else if what == "approvals" { APPROVALS } else if what == "outbox" { OUTBOX } else { return none }
        return some(array(try self.texts(sql, List<Value>())))
    }

    /// The tool calls named in `calls`, and those of the runs in `runs`, each a JSON array
    /// of ids, as a JSON array's text: what a chat's blocks and its runs show, rather than
    /// every call ever.
    pub fn tools_text(self, calls: String, runs: String) -> String ! Error {
        return array(try self.texts(TOOLS_FOR, [t(calls.copy()), t(runs.copy())]))
    }

    fn page(self, conversation: String, before: String?, limit: i64) -> (List<String>, bool) ! Error {
        var cut = i64.MAX
        if let b = before {
            let row = try self.db.query_one(String("SELECT at FROM messages WHERE id = ?"), [t(b.copy())])
            if let r = row { cut = int(r[0].copy()) }
        }
        var newest = try self.texts("SELECT json FROM messages WHERE conversation = ? AND at < ? ORDER BY at DESC, rowid DESC LIMIT ?", [t(conversation.copy()), Value.Int(cut), Value.Int(limit + 1)])
        let more = i64.wrap(u64(newest.len())) > limit
        if more { _ = newest.pop() }
        newest.reverse()
        return (newest, more)
    }

    /// Up to `limit` of a conversation's messages before the message `before` (or the
    /// newest), oldest first, and whether there are older ones in the cache.
    pub fn messages(self, conversation: String, before: String?, limit: i64) -> (List<Json>, bool) ! Error {
        let (texts, more) = try self.page(conversation, before, limit)
        var out = List<Json>()
        for s in texts {
            out.push(try parse(s))
        }
        return (out, more)
    }

    /// `messages` as a JSON array's text, with nothing parsed.
    pub fn messages_text(self, conversation: String, before: String?, limit: i64) -> (String, bool) ! Error {
        let (texts, more) = try self.page(conversation, before, limit)
        return (array(texts), more)
    }

    // --- The outbox ---

    /// Keeps a send until the instance acks it.
    pub fn queue(self, frame: Json) ! Error {
        let cid = str_at(frame, "cid") ?? String()
        let conversation = str_at(frame, "conversation") ?? String()
        _ = try self.db.execute(String("INSERT OR REPLACE INTO outbox (cid, conversation, json, at) VALUES (?, ?, ?, ?)"), [t(cid), t(conversation), t("{frame}"), Value.Int(now())])
    }

    /// A run still going, as its run.started event.
    pub fn run(self, id: String) -> Json? ! Error {
        return try self.one("SELECT json FROM runs WHERE id = ?", id.copy())
    }

    pub fn agent(self, id: String) -> Json? ! Error {
        return try self.one("SELECT json FROM agents WHERE id = ?", id.copy())
    }

    /// The newest conversation with `agent`: the one the app shows as that agent's chat.
    /// A task's conversation is the task's, not the chat.
    pub fn conversation_for(self, agent: String) -> String? ! Error {
        let row = try self.db.query_one(String("SELECT id FROM conversations WHERE agent = ? AND chat = 1 ORDER BY last DESC, rowid DESC LIMIT 1"), [t(agent.copy())])
        let r = row else return none
        return some(text(r[0]))
    }

    /// The send waiting with the client id `cid`.
    pub fn queued(self, cid: String) -> Json? ! Error {
        return try self.one("SELECT json FROM outbox WHERE cid = ?", cid.copy())
    }

    /// The sends waiting, oldest first.
    pub fn outbox(self) -> List<Json> ! Error {
        return try self.all(OUTBOX, List<Value>())
    }

    /// The instance acked a send, or refused it for good: it leaves the outbox.
    pub fn sent(self, cid: String) ! Error {
        _ = try self.db.execute(String("DELETE FROM outbox WHERE cid = ?"), [t(cid.copy())])
    }
}

fn ev(seq: i64, kind: str, fields: Json) -> Json {
    return merge(Obj.new().s("t", String("event")).i("seq", seq).s("kind", String(kind)).done(), fields)
}

@test
fn applies_events_with_the_cursor() ! Error {
    let c = try Cache.open(String(":memory:"))
    let conv = Obj.new().s("id", String("c_1")).s("agent", String("a_1")).s("title", String("Builds")).i("at", 10).done()
    assert(try c.apply(ev(1, "conversation.created", Obj.new().j("conversation", conv).done())))
    let m = Obj.new().s("id", String("msg_1")).s("conversation", String("c_1")).s("role", String("person")).i("at", 20).done()
    assert(try c.apply(ev(2, "message.created", Obj.new().s("conversation", String("c_1")).j("message", m.copy()).done())))
    assert(not try c.apply(ev(2, "message.created", Obj.new().j("message", m).done())))
    assert(try c.cursor() == 2)
    _ = try c.apply(ev(3, "conversation.updated", Obj.new().j("conversation", Obj.new().s("id", String("c_1")).s("title", String("CI")).done()).done()))
    let cs = try c.conversations()
    assert(cs.len() == 1 and str_at(cs[0].copy(), "title") == some(String("CI")) and str_at(cs[0].copy(), "agent") == some(String("a_1")))
    let (ms, more) = try c.messages(String("c_1"), none, 50)
    assert(ms.len() == 1 and not more)
    // A routine run that ended quietly takes its message back.
    _ = try c.apply(ev(4, "message.deleted", Obj.new().s("conversation", String("c_1")).s("message", String("msg_1")).done()))
    let (left, _) = try c.messages(String("c_1"), none, 50)
    assert(left.len() == 0)
}

@test
fn a_routines_thread_isnt_the_agents_chat() ! Error {
    let c = try Cache.open(String(":memory:"))
    let chat = Obj.new().s("id", String("c_chat")).s("agent", String("a_1")).s("title", String("Chat")).i("at", 10).done()
    let thread = Obj.new().s("id", String("c_thread")).s("agent", String("a_1")).s("title", String("News")).s("routine", String("rt_1")).i("at", 20).done()
    _ = try c.apply(ev(1, "conversation.created", Obj.new().j("conversation", chat).done()))
    _ = try c.apply(ev(2, "conversation.created", Obj.new().j("conversation", thread).done()))
    assert(try c.conversation_for(String("a_1")) == some(String("c_chat")))
}

@test
fn keeps_runs_and_questions_until_they_end() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "run.started", Obj.new().s("run", String("run_1")).s("conversation", String("c_1")).done()))
    _ = try c.apply(ev(2, "approval.needed", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).done()))
    _ = try c.apply(ev(3, "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_2")).s("title", String("ls")).done()))
    _ = try c.apply(ev(4, "tool.finished", Obj.new().s("call", String("tc_2")).s("status", String("done")).done()))
    assert((try c.runs()).len() == 1 and (try c.approvals()).len() == 1)
    let tools = try c.tools()
    assert(str_at(tools[0].copy(), "status") == some(String("done")) and str_at(tools[0].copy(), "title") == some(String("ls")))
    _ = try c.apply(ev(5, "approval.answered", Obj.new().s("call", String("tc_1")).done()))
    assert((try c.approvals()).len() == 0)
    _ = try c.apply(ev(6, "run.finished", Obj.new().s("run", String("run_1")).done()))
    assert((try c.runs()).len() == 0 and (try c.tools()).len() == 1)
}

@test
fn synced_makes_the_runs_those_still_going() ! Error {
    let c = try Cache.open(String(":memory:"))
    // One whose run.finished the cache missed, with its question, and one that's going.
    _ = try c.apply(ev(1, "run.started", Obj.new().s("run", String("run_1")).s("conversation", String("c_1")).s("agent", String("a_1")).done()))
    _ = try c.apply(ev(2, "approval.needed", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).done()))
    _ = try c.apply(ev(3, "run.started", Obj.new().s("run", String("run_2")).s("conversation", String("c_2")).s("agent", String("a_2")).i("revision", 4).done()))
    // And one whose run.started it missed.
    let going = Json.Array([Obj.new().s("run", String("run_2")).s("conversation", String("c_2")).s("agent", String("a_2")).done(), Obj.new().s("run", String("run_3")).s("conversation", String("c_3")).s("agent", String("a_3")).s("message", String("msg_9")).done()])
    try c.keep_runs(going)
    let runs = try c.runs()
    assert(runs.len() == 2)
    assert(str_at(runs[0].copy(), "run") == some(String("run_2")) and int_at(runs[0].copy(), "revision") == some(4))
    assert(str_at(runs[1].copy(), "run") == some(String("run_3")) and str_at(runs[1].copy(), "message") == some(String("msg_9")))
    assert((try c.approvals()).len() == 0)
    assert(try c.run(String("run_1")) == none)
    // A synced without runs, from an older instance, changes nothing; none going keeps none.
    try c.keep_runs(Json.Null)
    assert((try c.runs()).len() == 2)
    try c.keep_runs(Json.Array(List<Json>()))
    assert((try c.runs()).len() == 0)
}

@test
fn pages_messages_oldest_first() ! Error {
    let c = try Cache.open(String(":memory:"))
    var ms = List<Json>()
    for i in 1..6 {
        ms.push(Obj.new().s("id", "msg_{i}").s("conversation", String("c_1")).i("at", i64(i)).done())
    }
    try c.put_messages(Json.Array(ms))
    let (page, more) = try c.messages(String("c_1"), none, 2)
    assert(page.len() == 2 and more and str_at(page[0].copy(), "id") == some(String("msg_4")))
    let (older, more_again) = try c.messages(String("c_1"), some(String("msg_4")), 10)
    assert(older.len() == 3 and not more_again and str_at(older[0].copy(), "id") == some(String("msg_1")))
}

@test
fn a_changed_agent_keeps_its_place() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_1")).done()).done()))
    _ = try c.apply(ev(2, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_2")).done()).done()))
    _ = try c.apply(ev(3, "agent.updated", Obj.new().j("agent", Obj.new().s("id", String("a_1")).s("shape", String("yarn")).done()).done()))
    let agents = try c.agents()
    assert(str_at(agents[0].copy(), "id") == some(String("a_1")) and str_at(agents[0].copy(), "shape") == some(String("yarn")))
}

@test
fn a_snapshot_replaces_everything_but_the_outbox() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_1")).done()).done()))
    try c.queue(Obj.new().s("t", String("send")).s("cid", String("m_1")).s("conversation", String("c_1")).s("text", String("hi")).done())
    try c.replace(Obj.new().s("t", String("snapshot")).i("seq", 40).j("agents", Json.Array([Obj.new().s("id", String("a_2")).done()])).done())
    let agents = try c.agents()
    assert(agents.len() == 1 and str_at(agents[0].copy(), "id") == some(String("a_2")))
    assert(try c.cursor() == 40)
    assert((try c.outbox()).len() == 1)
    try c.sent(String("m_1"))
    assert((try c.outbox()).len() == 0)
}

@test
fn a_held_burst_is_saved_together() ! Error {
    let c = try Cache.open(String(":memory:"))
    try c.hold()
    _ = try c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_1")).done()).done()))
    try c.replace(Obj.new().s("t", String("snapshot")).i("seq", 5).j("agents", Json.Array([Obj.new().s("id", String("a_2")).done()])).done())
    _ = try c.apply(ev(6, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_3")).done()).done()))
    try c.let_go()
    assert(try c.cursor() == 6)
    assert((try c.agents()).len() == 2)
    // Nothing held: each event is its own transaction, as before.
    _ = try c.apply(ev(7, "agent.deleted", Obj.new().s("agent", String("a_2")).done()))
    assert(try c.cursor() == 7 and (try c.agents()).len() == 1)
}

@test
fn lists_come_as_text_too() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_1")).done()).done()))
    _ = try c.apply(ev(2, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_2")).done()).done()))
    let agents = try parse(try c.list_text(String("agents")) ?? String())
    assert(agents == Json.Array(try c.agents()))
    assert(try c.list_text(String("tools")) == some(String("[]")))
    assert(try c.list_text(String("messages")) == none)
    var ms = List<Json>()
    for i in 1..4 {
        ms.push(Obj.new().s("id", "msg_{i}").s("conversation", String("c_1")).i("at", i64(i)).done())
    }
    try c.put_messages(Json.Array(ms))
    let (page, more) = try c.messages_text(String("c_1"), none, 2)
    let (parsed, _) = try c.messages(String("c_1"), none, 2)
    assert(more and try parse(page) == Json.Array(parsed))
}

@test
fn tools_come_for_the_calls_and_runs_asked() ! Error {
    let c = try Cache.open(String(":memory:"))
    _ = try c.apply(ev(1, "tool.started", Obj.new().s("run", String("run_1")).s("call", String("tc_1")).s("title", String("ls")).done()))
    _ = try c.apply(ev(2, "tool.started", Obj.new().s("run", String("run_2")).s("call", String("tc_2")).s("title", String("cat")).done()))
    _ = try c.apply(ev(3, "tool.started", Obj.new().s("run", String("run_3")).s("call", String("tc_3")).s("title", String("rm")).done()))
    let got = try parse(try c.tools_text(String(#"["tc_1"]"#), String(#"["run_3"]"#)))
    if let Json.Array(items) = got {
        assert(items.len() == 2 and str_at(items[0], "call") == some(String("tc_1")) and str_at(items[1], "title") == some(String("rm")))
    } else {
        panic("not an array")
    }
    assert(try c.tools_text(String("null"), String("[]")) == "[]")
}

@test
fn a_cache_from_before_keeps_its_calls_and_chats() ! Error {
    // The layout before tools kept only their title and status, and before each
    // conversation had its agent as a column.
    let dir = try fs.temp_dir()
    let path = "{dir}/cache.db"
    let old = try Database.open(path.copy())
    try old.execute_script(String(#"
CREATE TABLE conversations (id TEXT PRIMARY KEY, json TEXT NOT NULL, last INTEGER NOT NULL);
CREATE TABLE tools (call TEXT PRIMARY KEY, run TEXT NOT NULL, json TEXT NOT NULL);
INSERT INTO conversations VALUES ('c_chat', '{"id":"c_chat","agent":"a_1","at":10}', 10);
INSERT INTO conversations VALUES ('c_task', '{"id":"c_task","agent":"a_1","task":"t_1","at":20}', 20);
INSERT INTO tools VALUES ('tc_1', 'r_1', '{"call":"tc_1","run":"r_1","title":"ls","status":"done","input":{"command":"ls"}}');
"#))
    try old.close()
    {
        let c = try Cache.open(path.copy())
        assert(try c.conversation_for(String("a_1")) == some(String("c_chat")))
        assert(try c.tools_text(String(#"["tc_1"]"#), String("[]")) == #"[{"call":"tc_1","run":"r_1","title":"ls","status":"done"}]"#)
        // A tool that updates sets only what it says.
        _ = try c.apply(ev(1, "tool.started", Obj.new().s("call", String("tc_2")).s("run", String("r_1")).s("title", String("grep")).done()))
        _ = try c.apply(ev(2, "tool.finished", Obj.new().s("call", String("tc_2")).s("status", String("failed")).done()))
        assert(try c.tools_text(String(#"["tc_2"]"#), String("[]")) == #"[{"call":"tc_2","run":"r_1","title":"grep","status":"failed"}]"#)
    }
    // Windows keeps the folder while the checkpoint thread still has the file open.
    match fs.remove_dir_all(dir) {
        ok => {},
        err(_) => {},
    }
}

@test
fn one_core_owns_a_folder_at_a_time() ! Error {
    let dir = try fs.temp_dir()
    let first = try own_folder(dir.copy(), 0) else { fail "the folder wasn't free" }
    assert(try own_folder(dir.copy(), 100) == none)
    try first.release()
    let again = try own_folder(dir.copy(), 0) else { fail "the folder wasn't let go" }
    try again.release()
    try fs.remove_dir_all(dir)
}

// Applies an event to the cache at `path` from a connection of its own, as a
// second core on the same file would, and says how it went.
struct OtherCore {
    path: String
    said: Sender<String>
}

impl Task for OtherCore {
    fn run(own self) {
        let c = match Cache.open(self.path.copy()) {
            ok(c) => c,
            err(e) => {
                self.said.send("{e}")
                return
            },
        }
        match c.apply(ev(1, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_other")).done()).done())) {
            ok(_) => self.said.send(String("ok")),
            err(e) => self.said.send("{e}"),
        }
    }
}

@test
fn a_held_burst_waits_for_another_connection_rather_than_failing() ! Error {
    // A connection that had read in its transaction couldn't write once another had
    // written since: "database is locked", at once, whatever the busy timeout.
    let dir = try fs.temp_dir()
    let path = "{dir}/core.db"
    {
        let c = try Cache.open(path.copy())
        try c.hold()
        _ = try c.cursor()
        var said = Receiver<String>()
        let other = unsafe { Thread.spawn(OtherCore { path: path.copy(), said: said.sender() }) }
        unsafe { sleep(300000000) }
        _ = try c.apply(ev(2, "agent.created", Obj.new().j("agent", Obj.new().s("id", String("a_2")).done()).done()))
        try c.let_go()
        other.join()
        assert((said.wait() ?? String()) == "ok")
        // The other found the cursor past its event once it had the lock, so the cursor
        // never goes back.
        assert(try c.cursor() == 2)
    }
    match fs.remove_dir_all(dir) {
        ok => {},
        err(_) => {},
    }
}
