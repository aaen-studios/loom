module core.asks

// What an approval asks, as a few lines a person reads (PLAN.md, "Cards in the
// chat"): the apps draw an approval's call from this rather than from its JSON,
// so the desktop and the phone show the same. `shown` takes an approval.needed
// event and gives
//
//     {"what": "mcp", "lines": [{"label": "Query", "value": "is:unread"}], "more": 0, "code": "", "raw": ""}
//
// - `what`: what kind of call it is, for the card's icon: `script` (Code Mode's,
//   before it runs), `mcp` or `plugin` (a tool of one), `device` (one of the
//   person's devices), `install` (loom put on one of their hosts), or empty.
// - `lines`: what the call is given, at most six, each named in words and cut to
//   one short line: a long text ends with "…", a list is its items or how many,
//   and an object its members. What the title says already isn't said again.
// - `more`: how many more there were than lines.
// - `code`: the command or the script it runs, at most six lines.
// - `raw`: all of it, for the card's Details: the whole script, or what the call
//   is given as JSON, or empty when the lines and the code show it all.
//
// And what the card's head and steps show (LOO-278), all from the call itself:
//
// - `title`: what the call does, in plain words. The agent program's own title
//   when it gave one (an ACP tool call's), or for a tool of an MCP server or a
//   plugin, its name in words ("Fetch emails"), or its steps'.
// - `place`: where it goes, small: the server and the tool ("acta · search"),
//   the device and the tool, or empty.
// - `badges`: the services it reaches (`shared/badge.calx`), at most two: a
//   call's steps' services, or else its server's, with the server's own
//   icons when the call's detail has them (`icon`, `icon_dark`).
// - `effect`: what loom knows it does, `{"kind", "words"}`, from its kind (an ACP
//   tool kind, or `read` for an MCP tool marked readOnlyHint): `reads` ("Only
//   reads"), `changes`, `deletes` or `runs`, or both empty when it doesn't know;
//   one the instance counts `risky` is `deletes`, "Risky", unless it deletes.
// - `steps`: for a call whose argument is a list of the tools it runs, each an
//   object naming its tool (Composio's `tools: [{tool_slug, arguments}]`): each
//   step's `title`, `badge`, `chips` (`{"label", "value"}`, a few of its
//   arguments, short) and `more`. The other arguments then go under Details.
// - `reason`: why the agent makes the call, in its own words, from an argument
//   such as `thought` or `reason`, or empty.
import std.json.{Json, parse, pretty}
import shared.obj.{Obj, at, bool_at, str_at}
import shared.badge

const LINES_MOST: usize = 6
const VALUE_MOST: usize = 120
const CODE_LINES_MOST: usize = 6
const CODE_LINE_MOST: usize = 240
const RAW_LINES_MOST: usize = 400
const STEPS_MOST: usize = 6
const CHIPS_MOST: usize = 4
const CHIP_MOST: usize = 40
const REASON_MOST: usize = 240

// Names in a list's objects that say which one each is, best first.
const NAMES: str = "name title tool_slug slug tool label path file url id key"
// Words a label keeps in capitals.
const CAPITALS: str = "id url uri api ip html json sql ssh dns"
// What names the tool a step runs, in a list of the tools a call runs.
const TOOL_KEYS: str = "tool_slug tool_name toolName tool"
// What a step's arguments go by.
const ARG_KEYS: str = "arguments args input params parameters"
// Arguments that say why the agent makes the call.
const REASONS: str = "thought reason why rationale explanation purpose intent"
// Words a tool's name starts with when it says what it does rather than where:
// GMAIL_FETCH_EMAILS starts with a service, and create_issue with a verb.
const VERBS: str = "get list fetch search find read create add update edit delete remove send post put patch set run execute query open close move copy upload download start stop make write reply forward share invite insert append replace check count draft mark archive star sync import export generate call use"

// `text`, cut at `most` runes with "…", and whether it's all there.
fn cut(text: String, most: usize) -> (String, bool) {
    var out = String()
    var n: usize = 0
    for r in text.runes() {
        if n == most {
            out.push_str("…")
            return (out, false)
        }
        out.push(r)
        n += 1
    }
    return (out, true)
}

// `text`'s first line with anything in it, trimmed and cut at `most` runes, and
// whether that's all of `text`.
fn first_line(text: String, most: usize) -> (String, bool) {
    var first = String()
    var others = false
    for line in text.lines() {
        if line.trim().is_empty() { continue }
        if first.len() > 0 {
            others = true
            break
        }
        first = line.trim().copy()
    }
    let (short, whole) = cut(first, most)
    if others and whole { return ("{short} …", false) }
    return (short, whole and not others)
}

// The words of a name: `file_path`, `filePath`, `file-path` and `FILE_PATH` are
// "file" and "path", as they're written.
fn words_of(key: String) -> List<String> {
    var parts = List<String>()
    var word = String()
    var after_small = false
    for r in key.runes() {
        if r == '_' or r == '-' or r == ' ' or r == '.' or r == '/' or r == ':' {
            if word.len() > 0 {
                parts.push(word.copy())
                word.clear()
            }
            after_small = false
            continue
        }
        let big = r >= 'A' and r <= 'Z'
        if big and after_small and word.len() > 0 {
            parts.push(word.copy())
            word.clear()
        }
        word.push(r)
        after_small = (r >= 'a' and r <= 'z') or (r >= '0' and r <= '9')
    }
    if word.len() > 0 { parts.push(word.copy()) }
    return parts
}

// Whether a word stays in capitals: an id, a URL.
fn capital(word: String) -> bool {
    let small = word.to_lower_root()
    for c in CAPITALS.split(" ") {
        if small == c { return true }
    }
    return false
}

// `text` with its first rune in capitals.
fn capitalized(text: String) -> String {
    var out = String()
    var first = true
    for r in text.runes() {
        if first {
            var one = String()
            one.push(r)
            out.push_str(one.to_upper_root())
            first = false
        } else {
            out.push(r)
        }
    }
    return out
}

// `text` with its first rune small, unless its first word stays in capitals.
fn uncapitalized(text: String) -> String {
    let first = text.split(" ")[0].copy()
    if capital(first.copy()) or (first.len() > 1 and first == first.to_upper_root()) { return text.copy() }
    var out = String()
    var at_start = true
    for r in text.runes() {
        if at_start {
            var one = String()
            one.push(r)
            out.push_str(one.to_lower_root())
            at_start = false
        } else {
            out.push(r)
        }
    }
    return out
}

// A member's name in words: `file_path`, `filePath` and `file-path` are "File
// path", and an id or a URL stays in capitals.
pub fn label(key: String) -> String {
    var spelled = List<String>()
    for w in words_of(key) {
        let small = w.to_lower_root()
        spelled.push(if capital(w.copy()) { small.to_upper_root() } else if w.len() > 1 and w == w.to_upper_root() { w.copy() } else { small.copy() })
    }
    return capitalized(spelled.join(" "))
}

// Words as a phrase: in small letters but for an id or a URL, the first in
// capitals. ["FETCH", "EMAILS"] is "Fetch emails".
fn phrase(parts: List<String>) -> String {
    var spelled = List<String>()
    for w in parts {
        let small = w.to_lower_root()
        spelled.push(if capital(w.copy()) { small.to_upper_root() } else { small.copy() })
    }
    return capitalized(spelled.join(" "))
}

// Whether `word` is a verb a tool's name starts with.
fn verb(word: String) -> bool {
    let small = word.to_lower_root()
    for v in VERBS.split(" ") {
        if small == v { return true }
    }
    return false
}

// A tool's name as what it does and the service it reaches, when its name says
// one: GMAIL_FETCH_EMAILS is ("gmail", "Fetch emails"), and create_issue is ("",
// "Create issue"). Words that name `server` itself, as composio's
// COMPOSIO_SEARCH_TOOLS does, are left out, as is a service named twice
// (OUTLOOK_OUTLOOK_LIST_MESSAGES).
fn action_of(name: String, server: String) -> (String, String) {
    var parts = words_of(name.copy())
    let home = server.trim_prefix("plugin-").to_lower_root()
    while parts.len() > 1 and parts[0].to_lower_root() == home {
        _ = parts.remove(0)
    }
    var service = String()
    if parts.len() >= 3 and not verb(parts[0].copy()) {
        service = parts.remove(0).to_lower_root()
        while parts.len() > 1 and parts[0].to_lower_root() == service {
            _ = parts.remove(0)
        }
    }
    if parts.len() == 0 { return (service, name.copy()) }
    return (service, phrase(parts))
}

// A service's name as a title says it: "gmail" is "Gmail".
fn service_name(service: String) -> String {
    return capitalized(service)
}

// Whether `v` is a string, a number or a bool.
fn plain(v: Json) -> bool {
    return match v {
        Json.Array(_) => false,
        Json.Object(_) => false,
        Json.Null => false,
        _ => true,
    }
}

// A plain value in words: a string as it is, a bool as Yes or No, a number as
// JSON writes it.
fn words(v: Json) -> String {
    if let s = v.as_str() { return s }
    if let b = v.as_bool() { return String(if b { "Yes" } else { "No" }) }
    return "{v}"
}

// What says which one an object in a list is, by NAMES.
fn name_of(v: Json) -> String? {
    for k in NAMES.split(" ") {
        if let s = (v.get(k.copy()) ?? Json.Null).as_str() {
            if not s.trim().is_empty() { return some(s.trim().copy()) }
        }
    }
    return none
}

// `n` things, in words.
fn count(n: usize, one: str, many: str) -> String {
    if n == 1 { return "1 {one}" }
    return "{n} {many}"
}

// A value as one short line, and whether the line is all of it. None for one
// with nothing in it: null, "", [] or {}.
fn line_of(v: Json) -> (String, bool)? {
    if v == Json.Null { return none }
    if let s = v.as_str() {
        if s.trim().is_empty() { return none }
        return some(first_line(s, VALUE_MOST))
    }
    if let Json.Array(xs) = v.copy() {
        if xs.len() == 0 { return none }
        // Plain values as themselves, objects by their names, or else how many.
        var parts = List<String>()
        var named = true
        var all_plain = true
        for x in xs {
            if plain(x.copy()) {
                parts.push(words(x.copy()))
            } else {
                all_plain = false
                if let n = name_of(x.copy()) { parts.push(n) } else { named = false }
            }
        }
        if not named { return some((count(xs.len(), "item", "items"), false)) }
        let (short, whole) = first_line(parts.join(", "), VALUE_MOST)
        return some((short, whole and all_plain))
    }
    if let Json.Object(m) = v.copy() {
        if m.len() == 0 { return none }
        // Its members, `name: value`, the plain ones as themselves.
        var parts = List<String>()
        for (k, x) in m {
            let name = label(k.copy()).to_lower_root()
            if plain(x.copy()) {
                parts.push("{name}: {words(x.copy())}")
            } else if let Json.Array(ys) = x.copy() {
                parts.push("{name}: {count(ys.len(), "item", "items")}")
            } else if x.len() > 0 {
                parts.push("{name}: …")
            }
        }
        if parts.len() == 0 { return none }
        let (short, _) = first_line(parts.join(", "), VALUE_MOST)
        return some((short, false))
    }
    return some((words(v), true))
}

// A command as one line of text: a string as it is, or a list of words joined.
fn command_of(v: Json) -> String {
    if let s = v.as_str() { return s }
    if let Json.Array(parts) = v {
        var out = List<String>()
        for p in parts {
            if let s = p.as_str() { out.push(s) }
        }
        return out.join(" ")
    }
    return String()
}

// `text`'s lines, at most CODE_LINES_MOST of them, each cut, and whether that's all.
fn code_of(text: String) -> (String, bool) {
    var out = List<String>()
    var whole = true
    for line in text.trim_end().lines() {
        if out.len() == CODE_LINES_MOST {
            whole = false
            break
        }
        let (short, all) = cut(line.copy(), CODE_LINE_MOST)
        if not all { whole = false }
        out.push(short)
    }
    // Lines with nothing in them at the start say nothing.
    while out.len() > 0 and out[0].trim().is_empty() {
        _ = out.remove(0)
    }
    if not whole { out.push(String("…")) }
    return (out.join("\n"), whole)
}

// `text`, at most RAW_LINES_MOST lines.
fn raw_of(text: String) -> String {
    var out = List<String>()
    for line in text.lines() {
        if out.len() == RAW_LINES_MOST {
            out.push(String("…"))
            break
        }
        out.push(line.copy())
    }
    return out.join("\n")
}

// The tool a step of a call runs, by TOOL_KEYS.
fn tool_of(v: Json) -> String? {
    for k in TOOL_KEYS.split(" ") {
        if let s = (v.get(k.copy()) ?? Json.Null).as_str() {
            if not s.trim().is_empty() { return some(s.trim().copy()) }
        }
    }
    return none
}

// What a step of a call is given, by ARG_KEYS.
fn args_of(v: Json) -> Json {
    for k in ARG_KEYS.split(" ") {
        let a = v.get(k.copy()) ?? Json.Null
        if let Json.Object(_) = a.copy() { return a }
    }
    return Json.Null
}

// Which of what a call is given is the list of the tools it runs: the first list
// of objects that each name a tool.
fn steps_key(given: LinkedMap<String, Json>) -> String? {
    for (k, v) in given {
        if let Json.Array(xs) = v.copy() {
            if xs.len() == 0 { continue }
            var named = true
            for x in xs {
                if tool_of(x.copy()) == none { named = false }
            }
            if named { return some(k.copy()) }
        }
    }
    return none
}

// A few of what a step is given, each a short chip, and how many more there were.
// Only plain values and lists of them: an object is in Details.
fn chips_of(args: Json) -> (List<Json>, i64) {
    var chips = List<Json>()
    var more: i64 = 0
    if let Json.Object(m) = args {
        for (k, v) in m {
            var listed = plain(v.copy())
            if let Json.Array(xs) = v.copy() {
                listed = true
                for x in xs {
                    if not plain(x.copy()) { listed = false }
                }
            }
            if not listed { continue }
            let (value, _) = line_of(v.copy()) else continue
            if chips.len() == CHIPS_MOST {
                more += 1
                continue
            }
            let (short, _) = cut(value, CHIP_MOST)
            chips.push(Obj.new().s("label", uncapitalized(label(k.copy()))).s("value", short).done())
        }
    }
    return (chips, more)
}

// The steps of a call that runs the tools in `list`, each with its title, its
// badge, its chips and how many more it was given; the services they reach,
// once each, in order; and how many more steps there were than shown.
fn steps_of(list: Json, server: String, icon: (String, String)) -> (List<Json>, List<String>, i64) {
    var steps = List<Json>()
    var services = List<String>()
    var more: i64 = 0
    if let Json.Array(xs) = list {
        for x in xs {
            let tool = tool_of(x.copy()) ?? String()
            let (service, action) = action_of(tool, server.copy())
            if service.len() > 0 and not services.contains(service.copy()) { services.push(service.copy()) }
            if steps.len() == STEPS_MOST {
                more += 1
                continue
            }
            let (chips, more_chips) = chips_of(args_of(x.copy()))
            let title = if service.len() > 0 { "{action} in {service_name(service.copy())}" } else { action }
            let (reached, its_icon, its_dark) = if service.len() > 0 { (service, String(), String()) } else { (server.copy(), icon.0.copy(), icon.1.copy()) }
            steps.push(Obj.new().s("title", title).j("badge", badge.badge(reached, its_icon, its_dark)).j("chips", Json.Array(chips)).i("more", more_chips).done())
        }
    }
    return (steps, services, more)
}

// The steps' titles as one: the first, and the second or how many more.
fn steps_title(steps: List<Json>, more: i64) -> String {
    if steps.len() == 0 { return String() }
    let first = str_at(steps[0].copy(), "title") ?? String()
    let others = i64.wrap(steps.len()) - 1 + more
    if others == 0 { return first }
    if others == 1 { return "{first} and {uncapitalized(str_at(steps[1].copy(), "title") ?? String())}" }
    return "{first} and {others} more"
}

// What loom knows a call does, from its kind, and how a card says it.
fn effect_of(kind: String, what: String) -> (String, String) {
    if what == "script" { return (String("runs"), String("Runs a script")) }
    if what == "install" { return (String("runs"), String("Runs commands")) }
    if kind == "read" or kind == "search" or kind == "think" or kind == "fetch" { return (String("reads"), String("Only reads")) }
    if kind == "edit" { return (String("changes"), String("Changes files")) }
    if kind == "move" { return (String("changes"), String("Moves")) }
    if kind == "delete" { return (String("deletes"), String("Deletes")) }
    if kind == "execute" { return (String("runs"), String("Runs a command")) }
    // A tool its server didn't mark read-only.
    if what == "mcp" or what == "plugin" { return (String("changes"), String("Can change")) }
    return (String(), String())
}

// Why the agent makes the call, from an argument that says so, and which it was.
fn reason_of(given: LinkedMap<String, Json>) -> (String, String) {
    for k in REASONS.split(" ") {
        if let v = given.find(k.copy()) {
            if let s = v.as_str() {
                if not s.trim().is_empty() {
                    let (short, _) = cut(s.trim().copy(), REASON_MOST)
                    return (short, k.copy())
                }
            }
        }
    }
    return (String(), String())
}

// What an approval.needed event `e` asks, as the lines, code and raw text above.
pub fn shown(e: Json) -> Json {
    let kind = str_at(e.copy(), "tool") ?? String()
    let asked = str_at(e.copy(), "title") ?? String()
    let detail = at(e, "detail")
    var code = String()
    var what = String()
    // What the call is given, member by member, and what Details shows of it.
    var given = LinkedMap<String, Json>()
    var all = Json.Null
    if let s = detail.as_str() {
        code = s
    } else if let Json.Object(d) = detail.copy() {
        let arguments = at(detail.copy(), "arguments")
        let script = str_at(arguments.copy(), "code")
        if let c = script {
            // A script before it runs, in Code Mode: the script is all there is.
            code = c
            what = String("script")
        } else if d.contains("server") and d.contains("tool") and d.contains("arguments") {
            // A call to an MCP server's or a plugin's tool: what it's given. The
            // title names the tool and where it is.
            what = String(if (str_at(detail.copy(), "server") ?? String()).starts_with("plugin-") { "plugin" } else { "mcp" })
            if let Json.Object(a) = arguments.copy() { given = a.copy() }
            all = arguments
        } else if d.contains("device") and d.contains("args") {
            // A call to one of the person's devices: what it's given.
            what = String("device")
            if let Json.Object(a) = at(detail.copy(), "args") { given = a.copy() }
            all = at(detail.copy(), "args")
        } else if d.contains("plan") and d.contains("commands") {
            // Loom put on one of the person's hosts: the plan, and the commands
            // it runs there, word for word.
            what = String("install")
            for (k, v) in d {
                if k == "plan" {
                    if let Json.Object(p) = v.copy() {
                        for (pk, pv) in p {
                            given.insert(pk.copy(), pv.copy())
                        }
                    }
                } else if k == "commands" {
                    if let Json.Array(cs) = v.copy() {
                        var lines = List<String>()
                        for c in cs {
                            if let s = c.as_str() { lines.push(s) }
                        }
                        code = lines.join("\n")
                    }
                } else {
                    given.insert(k.copy(), v.copy())
                }
            }
            all = detail.copy()
        } else {
            given = d.copy()
            all = detail.copy()
        }
    }
    // A command is shown as one, apart from the rest.
    if code.len() == 0 {
        if let c = given.find(String("command")) {
            code = command_of(c.copy())
        }
        if code.len() > 0 { _ = given.remove(String("command")) }
    }
    _ = given.remove(String("act"))
    var whole = true
    // Where it goes, and the tool, for a tool of a server, a plugin or a device.
    let server = str_at(detail.copy(), "server") ?? str_at(detail.copy(), "device") ?? String()
    let tool = if what == "mcp" or what == "plugin" or what == "device" { str_at(detail.copy(), "tool") ?? String() } else { String() }
    // The server's own icons, which the instance gives with the call when it has them.
    let icon = if what == "mcp" { str_at(detail.copy(), "icon") ?? String() } else { String() }
    let icon_dark = if what == "mcp" { str_at(detail.copy(), "icon_dark") ?? String() } else { String() }
    let place = if tool.len() > 0 and server.len() > 0 { "{server.trim_prefix("plugin-")} · {tool}" } else { String() }
    // Why the agent makes it, in its own words: said once, as the reason.
    let (reason, reason_key) = reason_of(given.copy())
    if reason_key.len() > 0 { _ = given.remove(reason_key) }
    // The tools it runs, as steps: the rest of what it's given is in Details.
    var steps = List<Json>()
    var services = List<String>()
    var steps_more: i64 = 0
    if what == "mcp" or what == "plugin" {
        if let key = steps_key(given.copy()) {
            if let list = given.find(key.copy()) {
                let (ss, found, more_steps) = steps_of(list.copy(), server.copy(), (icon.copy(), icon_dark.copy()))
                steps = ss
                services = found
                steps_more = more_steps
            }
            given.clear()
            whole = false
        }
    }
    // What it does in plain words: the agent program's own title, or for a tool
    // of a server or a plugin, its steps' or the tool's name in words.
    var title = asked.copy()
    if (what == "mcp" or what == "plugin") and tool.len() > 0 {
        if steps.len() > 0 {
            title = steps_title(steps.copy(), steps_more)
        } else {
            // A tool that names the service it reaches, as Composio's do, says it
            // as a step does, with that service's badge.
            let (service, action) = action_of(tool.copy(), server.copy())
            title = if service.len() > 0 { "{action} in {service_name(service.copy())}" } else { action }
            if service.len() > 0 { services.push(service) }
        }
    }
    // The services it reaches: its steps', or its server's.
    var badges = List<Json>()
    for s in services {
        if badges.len() < 2 { badges.push(badge.badge(s.copy(), String(), String())) }
    }
    if badges.len() == 0 and (what == "mcp" or what == "plugin") and server.len() > 0 {
        badges.push(badge.badge(server.trim_prefix("plugin-").copy(), icon, icon_dark))
    }
    var (effect, effect_words) = effect_of(kind, what.copy())
    // One the instance counts risky, which is held to allow, says so in red.
    if bool_at(e.copy(), "risky") == some(true) and effect != "deletes" {
        effect = String("deletes")
        effect_words = String("Risky")
    }
    // A command the title already says whole isn't said again.
    if code.trim().len() >= 3 and not code.contains("\n") and asked.contains(code.trim()) { code = String() }
    let (shown_code, code_whole) = code_of(code.copy())
    if not code_whole { whole = false }
    var lines = List<Json>()
    var more: i64 = 0
    for (k, v) in given {
        let (value, all_of_it) = line_of(v.copy()) else continue
        // What the title says already.
        if all_of_it and value.trim().len() >= 3 and (asked.contains(value.trim()) or title.contains(value.trim())) { continue }
        if lines.len() == LINES_MOST {
            more += 1
            whole = false
            continue
        }
        if not all_of_it { whole = false }
        lines.push(Obj.new().s("label", label(k.copy())).s("value", value).done())
    }
    var raw = String()
    if not whole {
        raw = if not code_whole and lines.len() == 0 and more == 0 and steps.len() == 0 { raw_of(code.trim_end().copy()) } else if all != Json.Null { raw_of(pretty(all, 2)) } else { raw_of(code.trim_end().copy()) }
    }
    var out = Obj.new().s("what", what).j("lines", Json.Array(lines)).i("more", more).s("code", shown_code).s("raw", raw)
    out = out.s("title", title).s("place", place).j("badges", Json.Array(badges))
    out = out.j("effect", Obj.new().s("kind", effect).s("words", effect_words).done())
    return out.j("steps", Json.Array(steps)).i("steps_more", steps_more).s("reason", reason).done()
}

fn ask(text: String) -> Json {
    return shown(parse(text)!)
}

fn lines_of(s: Json) -> String {
    var out = List<String>()
    if let Json.Array(ls) = at(s, "lines") {
        for l in ls {
            out.push("{str_at(l.copy(), "label") ?? String()}={str_at(l.copy(), "value") ?? String()}")
        }
    }
    return out.join("|")
}

@test
fn names_members_in_words() {
    assert(label(String("file_path")) == "File path")
    assert(label(String("maxResults")) == "Max results")
    assert(label(String("tool_slug")) == "Tool slug")
    assert(label(String("session_id")) == "Session ID")
    assert(label(String("url")) == "URL")
    assert(label(String("TOOL")) == "TOOL")
    assert(label(String("sync-response")) == "Sync response")
}

// A step's title and chips, as "title: label=value, …".
fn steps_text(s: Json) -> String {
    var out = List<String>()
    if let Json.Array(ss) = at(s, "steps") {
        for st in ss {
            var chips = List<String>()
            if let Json.Array(cs) = at(st.copy(), "chips") {
                for c in cs {
                    chips.push("{str_at(c.copy(), "label") ?? String()}={str_at(c.copy(), "value") ?? String()}")
                }
            }
            out.push("{str_at(st.copy(), "title") ?? String()}: {chips.join(", ")}")
        }
    }
    return out.join("|")
}

// The badges' names, joined.
fn badges_text(s: Json) -> String {
    var out = List<String>()
    if let Json.Array(bs) = at(s, "badges") {
        for b in bs {
            out.push(str_at(b.copy(), "name") ?? String())
        }
    }
    return out.join(",")
}

@test
fn shows_the_tools_a_call_runs_as_steps() {
    let s = ask(#"{"tool": "other", "title": "Use COMPOSIO_MULTI_EXECUTE_TOOL on the MCP server composio", "detail": {"server": "composio", "tool": "COMPOSIO_MULTI_EXECUTE_TOOL", "arguments": {"tools": [{"tool_slug": "OUTLOOK_OUTLOOK_SEARCH_MESSAGES", "arguments": {"query": "received>=2026-11-22", "top": 30, "select": ["from", "subject"], "filter": {"a": 1}}}, {"tool_slug": "GMAIL_FETCH_EMAILS", "arguments": {"query": "is:unread", "max_results": 15}}], "sync_response_to_workbench": false, "thought": "Fetch the unread mail from today so I can sum it up for you", "memory": {}, "session_id": "s_1"}, "act": 3}}"#)
    assert(str_at(s.copy(), "title") == some(String("Search messages in Outlook and fetch emails in Gmail")))
    assert(str_at(s.copy(), "place") == some(String("composio · COMPOSIO_MULTI_EXECUTE_TOOL")))
    assert(badges_text(s.copy()) == "outlook,gmail")
    assert(steps_text(s.copy()) == "Search messages in Outlook: query=received>=2026-11-22, top=30, select=from, subject|Fetch emails in Gmail: query=is:unread, max results=15")
    assert(str_at(s.copy(), "reason") == some(String("Fetch the unread mail from today so I can sum it up for you")))
    // Nothing it doesn't know: Composio's tool isn't marked read-only.
    assert(str_at(at(s.copy(), "effect"), "words") == some(String("Can change")))
    // The rest of what it's given is under Details, all of it.
    assert(lines_of(s.copy()) == "")
    let raw = str_at(s.copy(), "raw") ?? String()
    assert(raw.contains("\"session_id\": \"s_1\"") and raw.contains("\"a\": 1") and not raw.contains("\"act\""))
    assert(str_at(s, "what") == some(String("mcp")))
}

@test
fn says_a_tool_in_words_with_its_service_s_badge() {
    let s = ask(#"{"tool": "read", "title": "Use search_issues on the MCP server acta", "detail": {"server": "acta", "tool": "search_issues", "arguments": {"query": "invoices", "limit": 5}, "act": 0}}"#)
    assert(str_at(s.copy(), "title") == some(String("Search issues")))
    assert(badges_text(s.copy()) == "acta")
    assert(str_at(at(s.copy(), "effect"), "kind") == some(String("reads")))
    assert(str_at(at(s.copy(), "effect"), "words") == some(String("Only reads")))
    assert(steps_text(s.copy()) == "")
    // A name with the server's own name in front, as composio's are.
    let named = ask(#"{"tool": "other", "title": "x", "detail": {"server": "composio", "tool": "COMPOSIO_SEARCH_TOOLS", "arguments": {}}}"#)
    assert(str_at(named, "title") == some(String("Search tools")))
    // One that names the service it reaches says it, with that service's badge.
    let gmail = ask(#"{"tool": "other", "title": "x", "detail": {"server": "composio", "tool": "GMAIL_SEND_EMAIL", "arguments": {"subject": "Saturday"}}}"#)
    assert(str_at(gmail.copy(), "title") == some(String("Send email in Gmail")) and badges_text(gmail) == "gmail")
    // A plugin's, by its own name.
    let plugin = ask(#"{"tool": "other", "title": "x", "detail": {"server": "plugin-board", "tool": "addCard", "arguments": {"title": "Ship it"}}}"#)
    assert(str_at(plugin.copy(), "place") == some(String("board · addCard")) and badges_text(plugin.copy()) == "board")
    assert(str_at(plugin, "title") == some(String("Add card")))
    // The server's own icons, which the instance gives with the call, are on its
    // badge, and not on a service's it reaches, nor among what the call is given.
    let iconed = ask(#"{"tool": "read", "title": "x", "detail": {"server": "acta", "tool": "search_issues", "arguments": {"query": "a"}, "act": 0, "icon": "ab12", "icon_dark": "cd34"}}"#)
    assert("{at(iconed.copy(), "badges")}".contains(#""icon":"ab12","icon_dark":"cd34""#) and not "{at(iconed, "lines")}".contains("ab12"))
    let reached = ask(#"{"tool": "other", "title": "x", "detail": {"server": "composio", "tool": "GMAIL_SEND_EMAIL", "arguments": {}, "icon": "ab12"}}"#)
    assert(not "{at(reached, "badges")}".contains("icon"))
}

@test
fn keeps_an_agent_program_s_own_title_and_says_its_kind() {
    let s = ask(#"{"tool": "execute", "title": "Run the tests", "detail": {"command": "cargo test", "description": "Run the tests"}}"#)
    assert(str_at(s.copy(), "title") == some(String("Run the tests")))
    assert(str_at(s.copy(), "place") == some(String()) and badges_text(s.copy()) == "")
    assert(str_at(at(s.copy(), "effect"), "words") == some(String("Runs a command")))
    let gone = ask(#"{"tool": "delete", "title": "Delete the agent Pip", "detail": null}"#)
    assert(str_at(at(gone, "effect"), "kind") == some(String("deletes")))
    let other = ask(#"{"tool": "other", "title": "Save a token", "detail": {"path": "/x"}}"#)
    assert(str_at(at(other, "effect"), "kind") == some(String()))
    // One the instance counts risky says so, in red, unless it says it deletes.
    let wipe = ask(#"{"tool": "execute", "title": "rm -rf build", "detail": {"command": "rm -rf build"}, "risky": true}"#)
    assert(str_at(at(wipe.copy(), "effect"), "kind") == some(String("deletes")) and str_at(at(wipe, "effect"), "words") == some(String("Risky")))
    let gone_risky = ask(#"{"tool": "delete", "title": "Delete the agent Pip", "detail": null, "risky": true}"#)
    assert(str_at(at(gone_risky, "effect"), "words") == some(String("Deletes")))
}

@test
fn says_it_all_without_details() {
    let s = ask(#"{"title": "Use search on the MCP server acta", "detail": {"server": "acta", "tool": "search", "arguments": {"query": "invoices", "limit": 5}, "act": 0}}"#)
    assert(lines_of(s.copy()) == "Query=invoices|Limit=5")
    assert(str_at(s, "raw") == some(String()))
}

@test
fn cuts_long_values_and_counts_the_rest() {
    let long = "x".repeat(300)
    let s = ask("\{\"title\": \"Use send on the MCP server mail\", \"detail\": \{\"server\": \"mail\", \"tool\": \"send\", \"arguments\": \{\"a\": \"{long}\", \"b\": \"one\\ntwo\", \"c\": 1, \"d\": 2, \"e\": 3, \"f\": 4, \"g\": 5, \"h\": 6\}\}\}")
    if let Json.Array(ls) = at(s.copy(), "lines") {
        assert(ls.len() == 6)
        let first = str_at(ls[0].copy(), "value") ?? String()
        assert(first.ends_with("…") and first.len() < 200)
        assert(str_at(ls[1].copy(), "value") == some(String("one …")))
    } else {
        panic("no lines")
    }
    assert(at(s.copy(), "more") == Json.Int(2))
    assert((str_at(s, "raw") ?? String()).len() > 0)
}

@test
fn shows_a_command_as_code() {
    let s = ask(#"{"title": "Run a command", "detail": {"command": ["gh", "run", "list"], "cwd": "/home/me/shop"}}"#)
    assert(str_at(s.copy(), "code") == some(String("gh run list")))
    assert(lines_of(s.copy()) == "Cwd=/home/me/shop")
    assert(str_at(s, "raw") == some(String()))
    // One the title says already isn't said twice.
    let said = ask(#"{"title": "`./deploy.sh production`", "detail": {"command": "./deploy.sh production"}}"#)
    assert(str_at(said, "code") == some(String()))
}

@test
fn shows_a_script_and_folds_the_rest() {
    var script = String()
    for n in 0..20 {
        script.push_str("const x{n} = await mcp.acta.search(\{query: \"{n}\"\})\n")
    }
    let e = Obj.new().s("title", String("Run a script")).j("detail", Obj.new().s("server", String("loom")).s("tool", String("run_code")).j("arguments", Obj.new().s("code", script.copy()).done()).i("act", 0).done()).done()
    let s = shown(e)
    let code = str_at(s.copy(), "code") ?? String()
    assert(code.lines().len() == CODE_LINES_MOST + 1 and code.ends_with("…"))
    assert(lines_of(s.copy()) == "")
    assert(str_at(s.copy(), "what") == some(String("script")))
    assert(str_at(s, "raw") == some(script.trim_end().copy()))
}

@test
fn leaves_out_what_the_title_says() {
    let s = ask(#"{"title": "Save a new status token to /srv/dash/token, as Pip asks", "detail": {"kind": "status", "path": "/srv/dash/token", "replace": true}}"#)
    assert(lines_of(s) == "Replace=Yes")
}

@test
fn shows_an_install_as_its_plan_and_commands() {
    let s = ask(#"{"title": "Install loom on vps, through Tailscale, link it to Desk PC", "detail": {"host": "vps", "through": "Desk PC", "plan": {"domain": "", "import": "openbot", "from_user": "openbot", "username": "elliot"}, "commands": ["curl -fsSL https://loom.rip/install.sh | sh", "loom import openbot"]}}"#)
    assert(lines_of(s.copy()) == "Import=openbot|From user=openbot|Username=elliot")
    assert(str_at(s, "code") == some(String("curl -fsSL https://loom.rip/install.sh | sh\nloom import openbot")))
}

@test
fn shows_nothing_for_nothing() {
    let s = ask(#"{"title": "Delete the agent Pip", "detail": null}"#)
    assert("{s}" == #"{"what":"","lines":[],"more":0,"code":"","raw":"","title":"Delete the agent Pip","place":"","badges":[],"effect":{"kind":"","words":""},"steps":[],"steps_more":0,"reason":""}"#)
    let text = ask(#"{"title": "Run a command", "detail": "gh run list --branch main"}"#)
    assert(str_at(text, "code") == some(String("gh run list --branch main")))
}
