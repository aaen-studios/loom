module core.device

// This device as a tool for the person's agents (PLAN.md, "Your devices"):
// running commands, reading files and folders, and opening a file or a link,
// on the computer the app runs on. Each tool is off until the person turns it
// on here, to ask each time or to be allowed. The device keeps its own key,
// signs the approvals given on it, and acts on a call that asks only when its
// approval is signed with a key it trusts: its own. So a hacked instance can't
// say yes for the person. It runs exactly the request that was signed, once.
import std.bytes
import std.crypto.{Ed25519Key, Ed25519PublicKey}
import std.env
import std.fs
import std.json.{Json, parse}
import std.net.{Waker}
import std.process.{Child, Command, Stdio}
import std.text.utf8.{decode_lossy_unicode}
import shared.obj.{Obj, at, bool_at, int_at, str_at}
import core.cache.{Cache}
import core.hosts
import core.hosts.{Host}
import core.install.{Install}
import shared.hosts.{install_plan}

// What a device offers, as the instance and the app name them.
// What a host does beside commands: put loom on it, as a plan the person signed.
pub const INSTALL: str = "install_loom"
pub const TOOLS: [str; 7] = ["run_command", "read_file", "list_files", "open", "screenshot", "read_clipboard", "write_clipboard"]
// The ones the app does, since they need the system's screen and clipboard:
// the core checks the call as for any tool, then asks the app.
const APP_TOOLS: [str; 3] = ["screenshot", "read_clipboard", "write_clipboard"]
// How long a command may run, and how much of a result goes back.
const COMMAND_MS: u64 = 120000
const MOST: usize = 20000
// A signed request is good for this long, so an old one can't be played again
// after the list of done calls has moved on.
const FRESH_MS: i64 = 900000
const KEEP_DONE: usize = 500
// How long Tailscale may take to say what's on the tailnet.
const SCAN_MS: u64 = 5000
// What an approval signs: this line, then the request's exact text.
pub const SIGNED: str = "loom device call\n"

struct Running {
    call: String
    child: Child
    out: List<u8>
}

pub struct Device {
    key: Ed25519Key
    modes: Map<String, String>    // tool -> off, ask or allow
    done: List<String>    // the calls done, newest last
    running: List<Running>
    asked: List<String>    // calls handed to the app, whose answers it gives with `answered`
    pub id: String    // this device's id, from welcome
    hosts: List<Host>    // the person's hosts this device reaches with ssh (core/hosts.calx)
    pub ssh: List<String>    // the ssh program, with its first arguments: just `ssh`, but in tests
    pub tailscale: List<String>    // the Tailscale program, the same way, for finding the tailnet's machines
    pub ssh_config: String    // the person's ~/.ssh/config, for finding their hosts
    scan: Child?    // `tailscale status --json`, while hosts are being found
    scan_ssh: List<String>    // what the ssh config named, meanwhile
    scan_out: List<u8>    // what Tailscale said so far
    installs: List<Install>    // loom going onto the person's hosts (core/install.calx)
    pub waker: Waker?    // the core's loop's, which commands, the scan and installs wake
}

fn hex(b: List<u8>) -> String {
    return bytes.hex(b)
}

fn unhex(s: String) -> List<u8>? {
    return bytes.from_hex(s)
}

impl Device {
    /// This device's key and settings, from the cache, or a new key the first time.
    pub fn load(cache: Cache) -> Device ! Error {
        var key = Ed25519Key.generate()
        var fresh = true
        if let seed = try cache.meta("device_key") {
            if let b = unhex(seed) {
                if let k = Ed25519Key.from_seed(b) {
                    key = k
                    fresh = false
                }
            }
        }
        if fresh { try cache.set_meta("device_key", hex(key.seed())) }
        var modes = Map<String, String>()
        if let text = try cache.meta("device_tools") {
            if let Json.Object(m) = try parse(text) {
                for (k, v) in m {
                    if let mode = v.as_str() { modes.insert(k.copy(), mode) }
                }
            }
        }
        var done = List<String>()
        if let text = try cache.meta("device_done") {
            if let Json.Array(ids) = try parse(text) {
                for id in ids {
                    if let s = id.as_str() { done.push(s) }
                }
            }
        }
        var d = Device.with_key(key, String())
        d.modes = modes
        d.done = done
        if let text = try cache.meta("device_hosts") {
            if let Json.Array(kept) = try parse(text) {
                for k in kept {
                    if let h = hosts.host_from(k.copy()) { d.hosts.push(h) }
                }
            }
        }
        return d
    }

    fn with_key(key: own Ed25519Key, id: own String) -> Device {
        return Device { key: key, modes: Map<String, String>(), done: List<String>(), running: List<Running>(), asked: List<String>(), id: id, hosts: List<Host>(), ssh: [String("ssh")], tailscale: [hosts.tailscale_program()], ssh_config: hosts.ssh_config_path(), scan: none, scan_ssh: List<String>(), scan_out: List<u8>(), installs: List<Install>(), waker: none }
    }

    pub fn public_key(self) -> String {
        return hex(self.key.public_key().bytes())
    }

    fn mode(self, tool: String) -> String {
        if let m = self.modes.find(tool) { return m.copy() }
        return String("off")
    }

    /// What the instance hears from this device: its key and its tools' modes.
    pub fn frame(self) -> Json {
        var listed = List<Json>()
        for h in self.hosts {
            listed.push(Obj.new().s("name", h.name.copy()).s("target", h.target.copy()).s("via", h.via.copy()).j("tools", Obj.new().s("run_command", h.mode.copy()).done()).done())
        }
        return Obj.new().s("t", String("device")).s("key", self.public_key()).j("tools", self.tools()).j("hosts", Json.Array(listed)).done()
    }

    /// The person's hosts, as the app shows them: each one's name, target, via and mode.
    pub fn hosts_json(self) -> Json {
        var out = List<Json>()
        for h in self.hosts {
            out.push(h.json())
        }
        return Json.Array(out)
    }

    fn keep_hosts(self, cache: Cache) ! Error {
        try cache.set_meta("device_hosts", "{self.hosts_json()}")
    }

    /// Adds the host the app's `host.add` gives (`target`, and `via`), asking
    /// each time from the start. Why not, for one that can't be added.
    pub fn add_host(mut self, cache: Cache, given: Json) -> String? ! Error {
        let target = str_at(given.copy(), "target") ?? String()
        let via = str_at(given, "via") ?? String("ssh")
        let h = hosts.host_from(Obj.new().s("target", target).s("via", via).s("mode", String("ask")).done()) else return some(String("That isn't a host ssh can reach. Give an alias from your ssh config, a machine's name, or user@name."))
        for k in self.hosts {
            if k.name == h.name { return some("There's a host called {h.name} already.") }
        }
        self.hosts.push(h)
        try self.keep_hosts(cache)
        return none
    }

    /// Sets what agents may do on the host `name`: off, ask or allow.
    pub fn set_host(mut self, cache: Cache, name: String, mode: String) ! Error {
        if mode != "off" and mode != "ask" and mode != "allow" { return }
        var kept = List<Host>()
        for h in self.hosts {
            kept.push(Host { name: h.name.copy(), target: h.target.copy(), via: h.via.copy(), mode: if h.name == name { mode.copy() } else { h.mode.copy() } })
        }
        self.hosts = kept
        try self.keep_hosts(cache)
    }

    /// Takes the host `name` away.
    pub fn remove_host(mut self, cache: Cache, name: String) ! Error {
        var kept = List<Host>()
        for h in self.hosts {
            if h.name != name { kept.push(Host { name: h.name.copy(), target: h.target.copy(), via: h.via.copy(), mode: h.mode.copy() }) }
        }
        self.hosts = kept
        try self.keep_hosts(cache)
    }

    /// Starts finding the person's hosts: the ssh config's at once, and the
    /// tailnet's from `tailscale status --json`, which `scan_poll` gathers.
    /// Their `core.hosts_found` now, when there's no Tailscale to ask.
    pub fn scan_start(mut self) -> Json? {
        self.scan_ssh = match fs.read_text(self.ssh_config.copy()) {
            ok(text) => hosts.ssh_hosts(text ?? String()),
            err(_) => List<String>(),
        }
        if self.scan != none { return none }
        var c = Command.new(self.tailscale[0].copy())
        for a in self.tailscale[1..] {
            c = c.arg(a.copy())
        }
        match c.arg(String("status")).arg(String("--json")).stdout(Stdio.Pipe).stderr(Stdio.Null).timeout(SCAN_MS).spawn() {
            ok(child) => {
                if let w = self.waker { child.wake_on(w) }
                self.scan = some(child)
                self.scan_out = List<u8>()
            },
            err(_) => return some(self.found(List<String>())),
        }
        return none
    }

    /// The hosts found, once Tailscale has answered or given up.
    pub fn scan_poll(mut self) -> Json? {
        var child = self.scan.take() else return none
        let got = child.read(0)
        self.scan_out.extend(got)
        if not child.ended() {
            self.scan = some(child)
            return none
        }
        let end = child.wait()
        self.scan_out.extend(end.stdout.copy())
        let tailnet = if end.status.success() { hosts.tailnet_hosts(text_of(self.scan_out.copy())) } else { List<String>() }
        return some(self.found(tailnet))
    }

    // core.hosts_found: what the ssh config and the tailnet name, but the
    // hosts already here.
    fn found(self, tailnet: List<String>) -> Json {
        var out = List<Json>()
        var seen = List<String>()
        for h in self.hosts {
            seen.push(h.name.copy())
        }
        for n in self.scan_ssh {
            if not seen.contains(n.copy()) {
                seen.push(n.copy())
                out.push(Obj.new().s("name", n.copy()).s("target", n.copy()).s("via", String("ssh")).done())
            }
        }
        for n in tailnet {
            if not seen.contains(n.copy()) {
                seen.push(n.copy())
                out.push(Obj.new().s("name", n.copy()).s("target", n.copy()).s("via", String("tailscale")).done())
            }
        }
        return Obj.new().s("t", String("core.hosts_found")).j("found", Json.Array(out)).done()
    }

    /// Each tool's mode, `off` for one not turned on.
    pub fn tools(self) -> Json {
        var o = Obj.new()
        for t in TOOLS {
            o = o.s(t, self.mode(String(t)))
        }
        return o.done()
    }

    /// Sets the tools the app's `device.tools` names, and keeps them.
    pub fn set_modes(mut self, cache: Cache, given: Json) ! Error {
        if let Json.Object(m) = given {
            for (k, v) in m {
                let mode = v.as_str() ?? String()
                var known = false
                for t in TOOLS {
                    if k == t { known = true }
                }
                if known and (mode == "off" or mode == "ask" or mode == "allow") { self.modes.insert(k.copy(), mode) }
            }
        }
        try cache.set_meta("device_tools", "{self.tools()}")
    }

    /// The signature an approval given on this device carries, of `request`.
    pub fn sign(self, request: String) -> Json {
        let message = "{SIGNED}{request}"
        return Obj.new().s("key", self.public_key()).s("signature", hex(self.key.sign(message.to_bytes()))).done()
    }

    // Whether `approval` is this device's own signature of `request`.
    fn trusted(self, request: String, approval: Json) -> bool {
        let key = str_at(approval.copy(), "key") ?? String()
        if key != self.public_key() { return false }
        let public = Ed25519PublicKey.from_bytes(unhex(key) ?? List<u8>()) else return false
        let signature = unhex(str_at(approval, "signature") ?? String()) ?? List<u8>()
        return public.verify("{SIGNED}{request}".to_bytes(), signature)
    }

    /// A `device.call` from the instance: its `device.result` now, or none for a
    /// command, whose result comes from `poll` once it ends.
    pub fn call(mut self, cache: Cache, f: Json, now_ms: i64) -> Json? {
        let call = str_at(f.copy(), "call") ?? String()
        let text = str_at(f.copy(), "request") ?? String()
        let request = match parse(text.copy()) {
            ok(r) => r,
            err(_) => return some(refused(call, String("The request isn't JSON."))),
        }
        // The signed request says everything: the outer frame is only its envelope.
        if str_at(request.copy(), "call") != some(call.copy()) or str_at(request.copy(), "device") != some(self.id.copy()) {
            return some(refused(call, String("That request isn't for this device.")))
        }
        let tool = str_at(request.copy(), "tool") ?? String()
        // A command for one of the person's hosts, which this device reaches
        // with ssh, goes by what the person set for that host.
        let host_name = str_at(request.copy(), "host") ?? String()
        var host: Host? = none
        if host_name.len() > 0 {
            for h in self.hosts {
                if h.name == host_name { host = some(Host { name: h.name.copy(), target: h.target.copy(), via: h.via.copy(), mode: h.mode.copy() }) }
            }
            if host == none { return some(refused(call, "This device has no host {host_name}.")) }
            if tool != "run_command" and tool != INSTALL { return some(refused(call, "A host only runs commands, and installs loom.")) }
        } else if tool == INSTALL {
            return some(refused(call, String("loom is installed on one of the person's hosts.")))
        }
        let mode = if let h = host { h.mode.copy() } else { self.mode(tool.copy()) }
        if mode == "off" { return some(refused(call, if host_name.len() > 0 { "Commands are off on {host_name}. The person can turn them on in their app." } else { "{tool} is off on this device. The person can turn it on in its app." })) }
        // An install runs several commands on one yes, so it always needs one,
        // even on a host that's allowed.
        if (mode == "ask" or tool == INSTALL) and not self.trusted(text.copy(), at(f, "approval")) {
            return some(refused(call, String("The person's yes for this didn't come from this device, so it isn't done. Approve it on this device.")))
        }
        if self.done.contains(call.copy()) { return some(refused(call, String("That request was done already."))) }
        let at_ms = int_at(request.copy(), "at") ?? 0
        if now_ms - at_ms > FRESH_MS or at_ms - now_ms > FRESH_MS { return some(refused(call, String("That request is too old."))) }
        self.done.push(call.copy())
        if self.done.len() > KEEP_DONE { _ = self.done.remove(0) }
        var ids = List<Json>()
        for d in self.done {
            ids.push(Json.Str(d.copy()))
        }
        if let err(_) = cache.set_meta("device_done", "{Json.Array(ids)}") {}
        let args = at(request, "args")
        for t in APP_TOOLS {
            if tool == t {
                if tool == "write_clipboard" and (str_at(args.copy(), "text") ?? String()).len() == 0 { return some(refused(call, String("text is empty."))) }
                self.asked.push(call.copy())
                return some(Obj.new().s("t", String("core.device_ask")).s("call", call).s("tool", tool.copy()).j("args", args).done())
            }
        }
        // loom onto the host, as the plan the person signed says: its commands
        // are made here, from the plan (core/install.calx).
        if tool == INSTALL {
            let (plan, why) = install_plan(args)
            if why.len() > 0 { return some(refused(call, why)) }
            let h = host else return some(refused(call, "This device has no host {host_name}."))
            let (i, first) = Install.start(call, h, plan, self.ssh.copy(), self.waker)
            if not i.done() { self.installs.push(i) }
            return some(first)
        }
        if tool == "run_command" {
            let command = str_at(args, "command") ?? String()
            if command.len() == 0 { return some(refused(call, String("command is empty."))) }
            let run = if let h = host { hosts.ssh_command(self.ssh.copy(), h.target.copy(), command) } else { shell(command) }
            match run.stdin(Stdio.Null).stdout(Stdio.Pipe).stderr(Stdio.Stdout).timeout(COMMAND_MS).spawn() {
                ok(child) => {
                    if let w = self.waker { child.wake_on(w) }
                    self.running.push(Running { call: call, child: child, out: List<u8>() })
                },
                err(e) => return some(refused(call, "It didn't start: {e}")),
            }
            return none
        }
        let path = str_at(args.copy(), "path") ?? str_at(args, "target") ?? String()
        if path.len() == 0 { return some(refused(call, String("path is empty."))) }
        if tool == "read_file" {
            return some(match fs.read(path.copy()) {
                ok(data) => answer(call, cut(text_of(data))),
                err(e) => refused(call, "{path}: {e}"),
            })
        }
        if tool == "list_files" {
            return some(match fs.list(path.copy()) {
                ok(names) => {
                    var lines = List<String>()
                    for n in names {
                        let full = "{path}/{n}"
                        lines.push(if fs.is_dir(full) { "{n}/" } else { n.copy() })
                    }
                    answer(call, cut(lines.join("\n")))
                },
                err(e) => refused(call, "{path}: {e}"),
            })
        }
        if tool == "open" {
            return some(match opener(path.copy()).stdout(Stdio.Null).spawn() {
                ok(_) => answer(call, "Opened {path}."),
                err(e) => refused(call, "{path} didn't open: {e}"),
            })
        }
        return some(refused(call, "This device has no tool {tool}."))
    }

    /// The app's `device.answer` to a call it was asked: its `device.result`, with a
    /// picture as `image` and `mime` when there is one. None for a call it wasn't asked.
    pub fn answered(mut self, f: Json) -> Json? {
        let call = str_at(f.copy(), "call") ?? String()
        let i = self.asked.position(|c| c == call) else return none
        _ = self.asked.remove(i)
        var r = Obj.new().s("t", String("device.result")).s("call", call).b("ok", bool_at(f.copy(), "ok") ?? false).s("output", cut(str_at(f.copy(), "output") ?? String()))
        if let image = str_at(f.copy(), "image") {
            r = r.s("image", image).s("mime", str_at(f, "mime") ?? String("image/jpeg"))
        }
        return some(r.done())
    }

    /// The results of commands that have ended, and how installs on the
    /// person's hosts are going: `device.progress` and `device.result` for the
    /// instance, and `core.offer` for the app, when one is ready to sign in to.
    pub fn poll(mut self, now_ms: i64) -> List<Json> {
        var out = List<Json>()
        var going = List<Install>()
        while self.installs.len() > 0 {
            var i = self.installs.remove(0)
            out.extend(i.poll(now_ms))
            if not i.done() { going.push(i) }
        }
        self.installs = going
        var still = List<Running>()
        while self.running.len() > 0 {
            var run = self.running.remove(0)
            let got = run.child.read(0)
            run.out.extend(got)
            if run.child.ended() {
                let end = run.child.wait()
                run.out.extend(end.stdout.copy())
                let status = if end.status.timed_out { String("It ran out of time.") } else { "Exit status {end.status.code ?? -1}." }
                let text = cut(text_of(run.out.copy())).trim_end().copy()
                out.push(Obj.new().s("t", String("device.result")).s("call", run.call.copy()).b("ok", end.status.success()).s("output", if text.len() > 0 { "{text}\n{status}" } else { status }).done())
            } else {
                still.push(run)
            }
        }
        self.running = still
        return out
    }

    /// How long until `poll` has something to do that nothing wakes the core for, in ms:
    /// an install's next look at its new server. None when there's nothing.
    pub fn due_ms(self, now_ms: i64) -> i64? {
        var soonest: i64? = none
        for i in self.installs {
            if let ms = i.due_ms(now_ms) {
                if soonest == none or ms < (soonest ?? 0) { soonest = some(ms) }
            }
        }
        return soonest
    }
}

fn answer(call: String, output: String) -> Json {
    return Obj.new().s("t", String("device.result")).s("call", call).b("ok", true).s("output", output).done()
}

fn refused(call: String, why: String) -> Json {
    return Obj.new().s("t", String("device.result")).s("call", call).b("ok", false).s("output", why).done()
}

// The first MOST bytes of `text`, cut at a character, and saying so.
fn cut(text: String) -> String {
    if text.len() <= MOST { return text.copy() }
    var out = String()
    for r in text.runes() {
        if out.len() >= MOST { break }
        out.push(r)
    }
    return "{out}\n[cut: {text.len()} bytes in all]"
}

// The person's shell, running `command`: PowerShell on Windows, zsh on a Mac.
fn shell(command: String) -> Command {
    let os = env.os()
    if os == "windows" { return Command.new(String("powershell")).arg(String("-NoProfile")).arg(String("-NonInteractive")).arg(String("-Command")).arg(command) }
    if os == "macos" { return Command.new(String("zsh")).arg(String("-c")).arg(command) }
    return Command.new(String("sh")).arg(String("-c")).arg(command)
}

// What opens a file or a link with its usual program.
fn opener(target: String) -> Command {
    let os = env.os()
    if os == "windows" { return Command.new(String("explorer")).arg(target) }
    if os == "macos" { return Command.new(String("open")).arg(target) }
    return Command.new(String("xdg-open")).arg(target)
}

@test
fn signs_what_it_trusts() {
    let d = Device.with_key(Ed25519Key.generate(), String("d_1"))
    let request = String(#"{"call":"tc_1","device":"d_1","tool":"read_file","args":{"path":"x"},"at":1}"#)
    let approval = d.sign(request.copy())
    assert(d.trusted(request.copy(), approval.copy()))
    assert(not d.trusted(request.replace("x", "y"), approval))
    let other = Device.with_key(Ed25519Key.generate(), String("d_1"))
    assert(not d.trusted(request.copy(), other.sign(request)))
}

@test
fn hosts_are_kept_and_go_by_their_own_mode() {
    let cache = Cache.open(String(":memory:"))!
    var d = Device.with_key(Ed25519Key.generate(), String("d_1"))
    assert(d.add_host(cache, Obj.new().s("target", String("root@vps")).done())! == none)
    assert(d.add_host(cache, Obj.new().s("target", String("vps")).done())! != none)
    assert(d.add_host(cache, Obj.new().s("target", String("-oProxyCommand=x")).done())! != none)
    assert("{d.hosts_json()}" == #"[{"name":"vps","target":"root@vps","via":"ssh","mode":"ask"}]"#)
    assert("{d.frame()}".contains(#""hosts":[{"name":"vps","target":"root@vps","via":"ssh","tools":{"run_command":"ask"}}]"#))
    // Off, a command for it is refused, whatever the device's own commands are.
    d.set_host(cache, String("vps"), String("off"))!
    d.modes.insert(String("run_command"), String("allow"))
    let request = Obj.new().s("call", String("tc_1")).s("device", String("d_1")).s("host", String("vps")).s("tool", String("run_command")).j("args", Obj.new().s("command", String("uptime")).done()).i("at", 1000).done()
    let frame = Obj.new().s("call", String("tc_1")).s("request", "{request}").done()
    let r = d.call(cache, frame, 1000) ?? Json.Null
    assert(str_at(r, "output") == some(String("Commands are off on vps. The person can turn them on in their app.")))
    // Asking, it needs this device's own yes.
    d.set_host(cache, String("vps"), String("ask"))!
    let asked = d.call(cache, Obj.new().s("call", String("tc_1")).s("request", "{request}").done(), 1000) ?? Json.Null
    assert((str_at(asked, "output") ?? String()).contains("didn't come from this device"))
    // Kept for next time, and taken away.
    let again = Device.load(cache)!
    assert("{again.hosts_json()}".contains(#""mode":"ask""#))
    d.remove_host(cache, String("vps"))!
    assert("{d.hosts_json()}" == "[]")
}

@test
fn installs_only_on_its_own_yes() {
    let cache = Cache.open(String(":memory:"))!
    var d = Device.with_key(Ed25519Key.generate(), String("d_1"))
    assert(d.add_host(cache, Obj.new().s("target", String("root@vps")).done())! == none)
    d.set_host(cache, String("vps"), String("allow"))!
    let request = "{Obj.new().s("call", String("tc_1")).s("device", String("d_1")).s("host", String("vps")).s("tool", String(INSTALL)).j("args", Obj.new().s("domain", String("x; rm -rf /")).done()).i("at", 1000).done()}"
    // Allowed commands or not, an install waits for this device's own signed yes.
    let unsigned = d.call(cache, Obj.new().s("call", String("tc_1")).s("request", request.copy()).done(), 1000) ?? Json.Null
    assert((str_at(unsigned, "output") ?? String()).contains("didn't come from this device"))
    // Signed, the plan is still checked before anything runs.
    let yes = d.sign(request.copy())
    let signed = d.call(cache, Obj.new().s("call", String("tc_1")).s("request", request.copy()).j("approval", yes).done(), 1000) ?? Json.Null
    assert((str_at(signed, "output") ?? String()).starts_with("domain is"))
    // And it's only for a host.
    let here = "{Obj.new().s("call", String("tc_2")).s("device", String("d_1")).s("tool", String(INSTALL)).j("args", Obj.new().done()).i("at", 1000).done()}"
    let also = d.sign(here.copy())
    let mine = d.call(cache, Obj.new().s("call", String("tc_2")).s("request", here).j("approval", also).done(), 1000) ?? Json.Null
    assert((str_at(mine, "output") ?? String()).contains("on one of the person's hosts"))
}

@test
fn cuts_long_results() {
    var long = String()
    for _ in 0..3000 {
        long.push_str("0123456789")
    }
    let c = cut(long)
    assert(c.len() < 20100 and c.ends_with("[cut: 30000 bytes in all]"))
}

fn text_of(b: List<u8>) -> String {
    return decode_lossy_unicode(b.copy(), 0, b.len())
}
