module core.conn

// The core's connection to its instance (protocol/protocol.md, "Connecting").
// One WebSocket to /ws, opened on the core's own thread: hello with the cursor,
// catch-up, then live frames. When it ends it opens again after 0.5 s,
// doubling to 30 s with up to 20% more at random, and at once when the system
// wakes or the network changes.
//
// The app's messages come in on `inbox`, and everything for the app goes out
// on `to_app`, both as JSON text. The C boundary (core/lib.calx) joins them
// to loom_core_send and on_event; tests use them as they are.
import std.bytes
import std.crypto.{Ed25519Key, Ed25519PublicKey}
import std.http.{Header, Request, get}
import std.http.websocket.{Message, WebSocket, open}
import std.http.websocket
import std.keyring
import std.json.{Json, parse}
import std.random.{Random}
import std.thread.{Task}
import std.time.{Instant}
import shared.obj.{Obj, at, bool_at, int_at, merge, str_at}
import shared.protocol.{APP_QUIET_MS, APP_WAIT_MS, CLOSE_MOVED, CLOSE_TOKEN, CLOSE_VERSION, NEWEST, moved_message}
import core.cache.{Cache, now}
import core.files.{Transfer, at_path, kept_at, refused}
import shared.files.{is_sha}
import core.login.{Kind, Outcome, Pending, address, request_body}
import core.link
import core.relay
import core.pushbox
import core.update.{Updater}
import core.device.{Device}
import std.fs

const FIRST_WAIT_MS: u64 = 500
const LONGEST_WAIT_MS: u64 = 30000
const TICK_NS: u64 = 10000000    // the loop wakes this often to read the socket
const FOLLOW_AGAIN_NS: u64 = 2000000000    // how long before asking a new place that didn't answer again

// The id the core gives its own conversation.create commands, before the send's cid.
const MAKING: str = "core.conversation:"

// What core.get reads from the cache.
const GETS: [str; 8] = ["conversations", "agents", "devices", "runs", "tools", "approvals", "outbox", "messages"]

/// How long to wait after `failed` tries in a row: 0.5 s, doubling up to 30 s.
pub fn wait_ms(failed: u32) -> u64 {
    var ms = FIRST_WAIT_MS
    var n: u32 = 0
    while n < failed and ms < LONGEST_WAIT_MS {
        ms *= 2
        n += 1
    }
    return if ms > LONGEST_WAIT_MS { LONGEST_WAIT_MS } else { ms }
}

/// The WebSocket address of an instance at `server`, an http:// or https:// address.
pub fn ws_url(server: String) -> String? {
    let a = address(server)
    if a.starts_with("https://") { return some("wss://{a[8..]}/ws") }
    if a.starts_with("http://") { return some("ws://{a[7..]}/ws") }
    return none
}

/// Whether `server` is an address the core can reach: http://, https://, or a place over Noise.
pub fn valid_server(server: String) -> bool {
    return ws_url(server.copy()) != none or relay.place(server) != none
}

/// What one read of the socket gave.
// What becomes of the app's push.register (Conn.through_relay).
enum Sealing {
    AsIs
    Sealed(Json)
    Failed(String)
}

enum Got {
    Text(String)
    Skip
    Nothing
    Ended(websocket.Error)
}

/// Where the connection is.
pub enum State {
    Offline       // waiting to try again
    Connecting    // the socket is opening, or hello is sent and welcome hasn't come
    Live          // welcomed: frames go both ways
    SignedOut     // the instance refused the token (4001); a login starts it again
    UpdateNeeded  // no protocol version in common (4002)
}

impl State {
    fn name(self) -> str {
        return match self {
            State.Offline => "offline",
            State.Connecting => "connecting",
            State.Live => "live",
            State.SignedOut => "signed_out",
            State.UpdateNeeded => "update_needed",
        }
    }
}

/// The connection, run by the core's thread.
pub struct Conn {
    server: String?       // the instance's http:// or https:// address, once it's known
    token: String?        // this device's token, kept in the credential store
    keyring: String       // the credential store's service the token is kept under
    cache: Cache          // what came from the instance, the cursor and the outbox
    lists: List<String>   // the ids of messages.list commands, whose results the cache keeps
    making: List<String>  // the ids of conversation.create commands the core sent for a send
    linking: List<String> // the ids of link.create commands, whose results get the QR code's text
    inviting: List<String> // the ids of invite.create commands, whose results get the invite's link
    resetting: List<String> // the ids of password.reset commands, whose results get the reset link
    synced: bool          // catch-up is over on this connection
    active: bool          // someone is looking at the app
    have: Map<String, usize>    // bytes of each streaming block so far, by "message/block"
    ws: WebSocket?
    state: State
    failed: u32           // tries in a row that didn't reach welcome
    retry_at: Instant?
    wait: u64             // how long after retry_at to try again
    pending: Pending?     // a login, setup or logout on its way
    inbox: Receiver<String>
    to_app: Sender<String>
    random: Random
    pub files: String?    // where files that come down are kept; the system's temporary folder without one
    transfers: List<Transfer>
    pub updater: Updater?    // looks for new releases of the app; none in tests and dev builds
    pub tz: String?          // the system's time zone, an IANA name, as the app found it
    device: Device?       // this device as a tool for agents; none if its key couldn't be kept
    follow_to: String     // where the instance moved, while the core checks it's the same one there
    following: Request?   // GET <follow_to>/api/info, for its key
    follow_at: Instant?   // when it last asked, so it asks again 2 s later while the new place isn't answering
    relay: Thread?        // the relay to a place over Noise (core/relay.calx), while there's one
    stop_relay: Sender<bool>?
    relay_place: String   // the place it goes to
    relay_url: String     // and where it listens
    push_relay: String?   // the push relay's key, base64, from welcome, when the instance pushes through one
}

impl Conn {
    /// A connection to the instance at `server`, or the one the cache last knew, keeping
    /// what comes in `cache`. Its token is `token`, or the one kept for the server under
    /// the credential store's service `service`; with neither, it waits for the app's
    /// login. It starts when it's run.
    pub fn new(server: String?, token: own String?, service: own String, cache: own Cache, inbox: own Receiver<String>, to_app: own Sender<String>) -> Conn {
        var s: String? = none
        if let given = server {
            s = some(address(given.copy()))
        } else {
            s = match cache.meta("server") {
                ok(known) => known,
                err(_) => none,
            }
        }
        let device = match Device.load(cache) {
            ok(d) => some(d),
            err(e) => {
                eprintln("loom: this device's key: {e}")
                none
            },
        }
        return Conn {
            server: s,
            token: token,
            keyring: service,
            cache: cache,
            lists: List<String>(),
            making: List<String>(),
            linking: List<String>(),
            inviting: List<String>(),
            resetting: List<String>(),
            synced: false,
            active: true,
            have: Map<String, usize>(),
            ws: none,
            state: State.SignedOut,
            failed: 0,
            retry_at: none,
            wait: 0,
            pending: none,
            inbox: inbox,
            to_app: to_app,
            random: Random.system(),
            files: none,
            transfers: List<Transfer>(),
            updater: none,
            tz: none,
            device: device,
            follow_to: String(),
            following: none,
            follow_at: none,
            relay: none,
            stop_relay: none,
            relay_place: String(),
            relay_url: String(),
            push_relay: none,
        }
    }

    /// Where to reach `server`: itself, or for a place over Noise, the relay to it,
    /// which starts the first time. Empty if the relay couldn't start.
    fn reach(mut self, server: String) -> String {
        if not relay.is_place(server.copy()) { return server.copy() }
        if self.relay_place == server and self.relay_url.len() > 0 { return self.relay_url.copy() }
        self.stop_relaying()
        let p = relay.place(server.copy()) else { return String() }
        match relay.start(p) {
            ok((t, stop, url)) => {
                self.relay = some(t)
                self.stop_relay = some(stop)
                self.relay_place = server.copy()
                self.relay_url = url.copy()
                return url
            },
            err(e) => {
                self.tell_error("relay", "{e}")
                return String()
            },
        }
    }

    fn stop_relaying(mut self) {
        if let s = mut self.stop_relay { s.send(true) }
        self.stop_relay = none
        if let t = self.relay.take() { t.join() }
        self.relay_place = String()
        self.relay_url = String()
    }

    fn tell(mut self, frame: Json) {
        self.to_app.send("{frame}")
    }

    fn tell_error(mut self, code: str, message: String) {
        self.tell(Obj.new().s("t", String("error")).s("code", String(code)).s("message", message).done())
    }

    fn tell_state(mut self, retry_ms: u64, why: String) {
        var o = Obj.new().s("t", String("core.conn")).s("state", String(self.state.name()))
        if retry_ms > 0 { o = o.i("retry_ms", i64.wrap(retry_ms)) }
        if why.len() > 0 { o = o.s("why", why) }
        self.tell(o.done())
    }

    /// Finds the token if the app gave none, and connects, or waits for a login.
    fn begin(mut self) {
        let server = self.server.copy() ?? String()
        if self.token == none and server.len() > 0 {
            match keyring.get(self.keyring.copy(), relay.keyring_name(server.copy())) {
                ok(t) => self.token = t,
                err(e) => self.tell(Obj.new().s("t", String("error")).s("code", String("keyring")).s("message", "{e}").done()),
            }
        }
        if server.len() > 0 and not valid_server(server.copy()) {
            self.tell(Obj.new().s("t", String("error")).s("code", String("bad_config")).s("message", "not an http://, https:// or noise:// address: {server}").done())
            self.server = none
        }
        if self.server != none and self.token != none {
            self.connect()
        } else {
            self.tell_state(0, String("not logged in"))
        }
    }

    /// Forgets the token, here and in the credential store, and closes the socket.
    fn forget(mut self) {
        if let ws = self.ws.take() {
            ws.close()
        }
        self.token = none
        self.retry_at = none
        if let server = self.server.copy() {
            match keyring.delete(self.keyring.copy(), relay.keyring_name(server)) {
                ok(_) => {},
                err(_) => {},    // a store that can't answer has nothing kept to delete
            }
        }
        self.state = State.SignedOut
    }

    /// Opens the socket and says hello. What's sent while it opens goes once it's open.
    fn connect(mut self) {
        self.retry_at = none
        self.synced = false
        // Commands sent on an old socket get no result: the outbox asks again on welcome.
        self.making = List<String>()
        let known = self.server.copy() ?? String()
        let base = self.reach(known)
        let url = ws_url(base) ?? String()
        let token = self.token.copy() ?? String()
        if url.len() == 0 or token.len() == 0 {
            self.state = State.SignedOut
            self.tell_state(0, String("not logged in"))
            return
        }
        let after = match self.cache.cursor() {
            ok(c) => c,
            err(e) => {
                self.tell_error("cache", "{e}")
                0
            },
        }
        // A connection that died without a close, as a sleeping laptop's does, ends
        // after 45 s with nothing from the instance, and the core reconnects.
        let ws = open(url, ping_interval_ms: APP_QUIET_MS, ping_timeout_ms: APP_WAIT_MS)
        let hello = Obj.new().s("t", String("hello")).s("token", token).j("versions", Json.Array([Json.Int(i64(NEWEST))])).i("after", after).j("device", Obj.new().b("active", self.active).maybe("tz", self.tz.copy()).done()).done()
        match ws.send_text("{hello}") {
            ok => {},
            err(_) => {},    // receive says how it ended
        }
        self.ws = some(ws)
        self.state = State.Connecting
        self.tell_state(0, String())
    }

    /// The socket ended with `e`: try again later, or stop for good on 4001 and 4002.
    fn ended(mut self, e: websocket.Error) {
        if let ws = self.ws.take() {
            ws.close()
        }
        match e {
            websocket.Error.Closed(code, reason) => {
                if code == CLOSE_TOKEN {
                    // The token is wrong or was revoked: log out on this device.
                    self.forget()
                    self.tell_state(0, reason.copy())
                    return
                }
                if code == CLOSE_VERSION {
                    self.state = State.UpdateNeeded
                    self.tell_state(0, reason.copy())
                    return
                }
                // The moved frame came first: the core is checking the new place.
                if code == CLOSE_MOVED and self.follow_to.len() > 0 {
                    let to = self.follow_to.copy()
                    self.state = State.Connecting
                    self.tell_state(0, "moving to {to}")
                    return
                }
            },
            _ => {},
        }
        self.retry_later("{e}")
    }

    fn retry_later(mut self, why: String) {
        let ms_base = wait_ms(self.failed)
        let ms = ms_base + self.random.below(ms_base / 5 + 1)
        self.failed += 1
        self.retry_at = some(unsafe { Instant.now() })
        self.state = State.Offline
        self.wait = ms
        self.tell_state(ms, why)
    }

    /// Sends a frame on the socket, if it's open.
    fn put(self, frame: String) -> bool {
        if let ws = self.ws {
            match ws.send_text(frame) {
                ok => return true,
                err(_) => return false,
            }
        }
        return false
    }

    /// Sends what's waiting in the outbox, oldest first. The instance ignores a cid it has
    /// seen, so sending again after a lost ack does no harm.
    fn flush(mut self) {
        let waiting = match self.cache.outbox() {
            ok(w) => w,
            err(e) => {
                self.tell_error("cache", "{e}")
                return
            },
        }
        for f in waiting {
            if str_at(f.copy(), "conversation") == none {
                self.make_conversation(f)
            } else if not self.put("{f}") {
                return
            }
        }
    }

    /// A send to an agent with no conversation yet: asks the instance for one, and sends
    /// the message when it comes (`made_conversation`).
    fn make_conversation(mut self, f: Json) {
        let cid = str_at(f.copy(), "cid") ?? String()
        let id = "{MAKING}{cid}"
        if self.making.contains(id.copy()) { return }
        let cmd = Obj.new().s("t", String("cmd")).s("id", id.copy()).s("name", String("conversation.create")).j("args", Obj.new().maybe("agent", str_at(f, "agent")).done()).done()
        if self.put("{cmd}") {
            self.making.push(id)
        }
    }

    /// The instance made the conversation a waiting send needed: the send gets it, and goes.
    fn made_conversation(mut self, f: Json) {
        let id = str_at(f.copy(), "id") ?? String()
        if let i = self.making.position(|x| x == id) {
            _ = self.making.remove(i)
        }
        let cid = id[MAKING.len()..].copy()
        let conversation = str_at(at(f.copy(), "value"), "conversation") else {
            // The agent is gone: the send can never go.
            match self.cache.sent(cid.copy()) {
                ok => {},
                err(e) => self.tell_error("cache", "{e}"),
            }
            self.tell(Obj.new().s("t", String("error")).s("code", String("not_sent")).s("ref", cid).s("message", str_at(at(f, "error"), "message") ?? String("The agent has no conversation.")).done())
            return
        }
        let waiting = match self.cache.queued(cid.copy()) {
            ok(w) => w,
            err(e) => {
                self.tell_error("cache", "{e}")
                return
            },
        }
        let w = waiting else { return }
        let frame = merge(w, Obj.new().s("conversation", conversation).done())
        match self.cache.queue(frame.copy()) {
            ok => {},
            err(e) => self.tell_error("cache", "{e}"),
        }
        _ = self.put("{frame}")
    }

    /// A delta: goes to the app when it adds to what's there, is dropped when it's there
    /// already, and a gap means something was lost, so the connection starts again.
    fn delta(mut self, f: Json, text: own String) {
        let key = "{str_at(f.copy(), "message") ?? String()}/{int_at(f.copy(), "block") ?? 0}"
        let pos = usize.try_from(int_at(f.copy(), "pos") ?? 0) ?? 0
        let piece = str_at(f, "text") ?? String()
        let have = self.have.get(key.copy()) ?? 0
        if pos > have {
            if let ws = self.ws.take() {
                ws.close()
            }
            _ = self.have.remove(key)
            self.retry_later(String("a delta came after a gap"))
            return
        }
        if pos + piece.len() <= have { return }
        self.have.insert(key, pos + piece.len())
        self.to_app.send(text)
    }

    /// Tells the app what's worth a system notification, while no one is looking at it:
    /// a reply that's done or failed, and a question an agent is waiting on, and, looking
    /// or not, what an agent sends with its notify tool. Only live
    /// events count, not catch-up, so waking up doesn't bring a flood of old news.
    fn notify(mut self, e: Json) {
        let kind = str_at(e.copy(), "kind") ?? String()
        if kind == "notify" {
            let agent_id = str_at(e.copy(), "agent") ?? String()
            let name = match self.cache.agent(agent_id.copy()) {
                ok(some(a)) => str_at(a, "name") ?? String("An agent"),
                _ => String("An agent"),
            }
            let title = str_at(e.copy(), "title") ?? String()
            self.tell(Obj.new().s("t", String("core.notify")).s("title", if title.len() > 0 { "{name}: {title}" } else { name }).s("body", str_at(e, "body") ?? String()).s("agent", agent_id).s("conversation", str_at(e, "conversation") ?? String()).s("kind", String("notify")).done())
            return
        }
        if kind != "run.finished" and kind != "approval.needed" { return }
        let run = match self.cache.run(str_at(e.copy(), "run") ?? String()) {
            ok(some(r)) => r,
            _ => return,
        }
        let agent_id = str_at(run.copy(), "agent") ?? String()
        let conversation = str_at(run, "conversation") ?? String()
        let name = match self.cache.agent(agent_id.copy()) {
            ok(some(a)) => str_at(a, "name") ?? String("An agent"),
            _ => String("An agent"),
        }
        var title = name.copy()
        var body = String()
        if kind == "approval.needed" {
            title = "{name} is asking"
            body = str_at(e.copy(), "title") ?? String("Can it go ahead?")
        } else {
            let status = str_at(e.copy(), "status") ?? String()
            if status == "cancelled" { return }
            if status == "failed" {
                body = "Couldn't finish: {str_at(e.copy(), "error") ?? String("it stopped")}"
            } else {
                body = match self.cache.messages(conversation.copy(), none, 1) {
                    ok((ms, _)) => if ms.len() > 0 { summary(ms[0].copy()) } else { String() },
                    err(_) => String(),
                }
                if body.len() == 0 { body = String("Done.") }
            }
        }
        self.tell(Obj.new().s("t", String("core.notify")).s("title", title).s("body", body).s("agent", agent_id).s("conversation", conversation).s("kind", kind).done())
    }

    /// A frame from the instance. What changes the cache is applied before the app hears
    /// of it, so a crash between the two loses nothing.
    fn frame(mut self, text: own String) {
        let f = match parse(text.copy()) {
            ok(j) => j,
            err(_) => return,
        }
        let t = str_at(f.copy(), "t") ?? String()
        if t == "moved" {
            self.moved(f)
            return
        }
        if t == "welcome" {
            // The instance's key, kept from the first welcome: a move is checked with it.
            if let key = str_at(f.copy(), "key") {
                if self.known("instance_key") == none {
                    match self.cache.set_meta("instance_key", key) {
                        ok => {},
                        err(e) => self.tell_error("cache", "{e}"),
                    }
                }
            }
            self.push_relay = str_at(f.copy(), "relay")
            self.state = State.Live
            self.failed = 0
            self.tell_state(0, String())
            self.offer(str_at(f.copy(), "device") ?? String())
            self.flush()
        } else if t == "synced" {
            self.synced = true
        } else if t == "event" {
            // Before the cache applies it, while the run it ends is still there to read.
            // An agent's own notify is for now, looking or not.
            if self.synced and (not self.active or str_at(f.copy(), "kind") == some(String("notify"))) {
                self.notify(f.copy())
            }
            match self.cache.apply(f.copy()) {
                ok(applied) => if not applied { return },
                err(e) => {
                    // Not applied, so not in the cursor either: the next hello gets it again.
                    self.tell_error("cache", "{e}")
                    return
                },
            }
            if (str_at(f.copy(), "kind") ?? String()) == "message.created" {
                let id = str_at(at(f.copy(), "message"), "id") ?? String()
                var done = List<String>()
                for (k, _) in self.have {
                    if k.starts_with("{id}/") { done.push(k.copy()) }
                }
                for k in done {
                    _ = self.have.remove(k)
                }
            }
        } else if t == "snapshot" {
            match self.cache.replace(f.copy()) {
                ok => {},
                err(e) => self.tell_error("cache", "{e}"),
            }
        } else if t == "device.call" {
            self.device_call(f)
            return
        } else if t == "delta" {
            self.delta(f, text)
            return
        } else if t == "ack" {
            match self.cache.sent(str_at(f.copy(), "cid") ?? String()) {
                ok => {},
                err(e) => self.tell_error("cache", "{e}"),
            }
        } else if t == "error" {
            // A send the instance can't take, ever: it leaves the outbox.
            if (str_at(f.copy(), "code") ?? String()) == "unknown_conversation" {
                if let cid = str_at(f.copy(), "ref") {
                    match self.cache.sent(cid) {
                        ok => {},
                        err(e) => self.tell_error("cache", "{e}"),
                    }
                }
            }
        } else if t == "result" {
            let id = str_at(f.copy(), "id") ?? String()
            if id.starts_with(MAKING) {
                self.made_conversation(f)
                return
            }
            if let i = self.linking.position(|x| x == id) {
                _ = self.linking.remove(i)
                self.linked(f)
                return
            }
            if let i = self.inviting.position(|x| x == id) {
                _ = self.inviting.remove(i)
                self.invited(f, "join")
                return
            }
            if let i = self.resetting.position(|x| x == id) {
                _ = self.resetting.remove(i)
                self.invited(f, "reset")
                return
            }
            if let i = self.lists.position(|x| x == id) {
                _ = self.lists.remove(i)
                match self.cache.put_messages(at(at(f.copy(), "value"), "messages")) {
                    ok => {},
                    err(e) => self.tell_error("cache", "{e}"),
                }
            }
        }
        self.to_app.send(text)
    }

    /// Reads what has come on the socket, without waiting.
    fn read(mut self) {
        loop {
            let got = match self.ws {
                some(ws) => match ws.receive(0) {
                    ok(some(Message.Text(text))) => Got.Text(text),
                    ok(some(Message.Binary(_))) => Got.Skip,
                    ok(none) => Got.Nothing,
                    err(e) => Got.Ended(e),
                },
                none => Got.Nothing,
            }
            match got {
                Got.Text(text) => self.frame(text),
                Got.Skip => {},
                Got.Nothing => return,
                Got.Ended(e) => {
                    self.ended(e)
                    return
                },
            }
        }
    }

    /// A message from the app. Gives false when the core is stopping.
    fn from_app(mut self, text: own String) -> bool {
        let m = match parse(text.copy()) {
            ok(j) => j,
            err(_) => return true,
        }
        let t = str_at(m.copy(), "t") ?? String()
        if t == "core.stop" {
            if let ws = self.ws.take() {
                ws.close()
            }
            return false
        }
        if t == "login" or t == "setup" {
            self.log_in(if t == "setup" { Kind.Setup } else { Kind.Login }, m)
            return true
        }
        if t == "logout" {
            if let server = self.server.copy() {
                if let token = self.token.copy() {
                    if self.pending == none {
                        let base = self.reach(server.copy())
                        self.pending = some(Pending.logout(server, base, token))
                    }
                }
            }
            self.forget()
            self.tell_state(0, String("logged out"))
            return true
        }
        if t == "app.active" {
            // Someone started or stopped looking at the app: it notifies only when no one is,
            // and the instance hears it too (the `device` frame).
            self.active = bool_at(m.copy(), "active") ?? true
            if self.state == State.Live {
                _ = self.put("{Obj.new().s("t", String("device")).b("active", self.active).done()}")
            }
            return true
        }
        if t == "app.wake" or t == "app.network" {
            // The socket may have died while the system slept or the network changed, with
            // nothing to say so: open a new one now. The cursor makes it lossless.
            if self.state == State.Live or self.state == State.Connecting or self.state == State.Offline {
                if let ws = self.ws.take() {
                    ws.close()
                }
                self.failed = 0
                self.connect()
            }
            return true
        }
        if t == "device.tools" or t == "device.get" {
            self.device_tools(at(m, "tools"))
            return true
        }
        if t == "device.answer" {
            self.device_answer(m)
            return true
        }
        if t == "approve" and (bool_at(m.copy(), "allow") ?? false) {
            if let signed = self.signed(m.copy()) {
                if self.state == State.Live and self.put("{signed}") { return true }
            }
        }
        if t == "core.get" {
            self.get(m)
            return true
        }
        if t == "send" {
            self.send(m)
            return true
        }
        if t == "update.check" {
            if let u = mut self.updater {
                u.check(str_at(m, "id"))
            } else {
                self.tell(Obj.new().s("t", String("core.update")).maybe("id", str_at(m, "id")).j("error", Obj.new().s("code", String("update")).s("message", String("This build doesn't update itself.")).done()).done())
            }
            return true
        }
        if t == "file.upload" or t == "file.get" {
            self.transfer(t == "file.upload", m)
            return true
        }
        if t == "link" {
            self.join(m)
            return true
        }
        if t == "invite.join" or t == "reset.use" {
            self.join_invite(m, t == "reset.use")
            return true
        }
        if t == "cmd" and (str_at(m.copy(), "name") ?? String()) == "password.reset" {
            if let id = str_at(m.copy(), "id") {
                self.resetting.push(id)
            }
        }
        if t == "cmd" and (str_at(m.copy(), "name") ?? String()) == "invite.create" {
            if let id = str_at(m.copy(), "id") {
                self.inviting.push(id)
            }
        }
        if t == "cmd" and (str_at(m.copy(), "name") ?? String()) == "messages.list" {
            if let id = str_at(m.copy(), "id") {
                self.lists.push(id)
            }
        }
        if t == "cmd" and (str_at(m.copy(), "name") ?? String()) == "link.create" {
            if let id = str_at(m.copy(), "id") {
                self.linking.push(id)
            }
        }
        var frame = text
        if t == "cmd" and (str_at(m.copy(), "name") ?? String()) == "push.register" {
            match self.through_relay(m.copy()) {
                Sealing.AsIs => {},
                Sealing.Sealed(sealed) => frame = "{sealed}",
                Sealing.Failed(why) => {
                    // Never the bare token to an instance that pushes through the relay.
                    self.tell(Obj.new().s("t", String("error")).s("code", String("keyring")).s("message", why).maybe("for", str_at(m.copy(), "id")).done())
                    return true
                },
            }
        }
        if self.state == State.Live {
            if self.put(frame) { return true }
        }
        // Not connected. A send waits in the outbox, but anything else would act on what
        // may have changed meanwhile, so the app hears it didn't go.
        self.tell(Obj.new().s("t", String("error")).s("code", String("offline")).maybe("for", str_at(m.copy(), "id")).done())
        return true
    }

    /// The app's push.register, with its APNs token sealed for the push relay and the
    /// phone's box key beside it, when the instance pushes through one (PLAN.md, "The push
    /// relay"). It goes as it is when the instance doesn't, and not at all when the
    /// phone's box key can't be kept.
    fn through_relay(self, m: Json) -> Sealing {
        let key = self.push_relay.copy() else return Sealing.AsIs
        let args = at(m.copy(), "args")
        let token = str_at(args.copy(), "token") else return Sealing.AsIs
        let env = str_at(args, "env") ?? String("production")
        let box = match pushbox.box_key(self.keyring.copy()) {
            ok(b) => b,
            err(e) => return Sealing.Failed("This device can't keep the key notifications are sealed for, so it takes no push through the relay: {e}"),
        }
        let sealed = pushbox.register_args(key, token, env, box) else return Sealing.Failed(String("The instance's push relay key isn't one."))
        return Sealing.Sealed(merge(m, Obj.new().j("args", sealed).done()))
    }

    /// A message the person wrote: kept in the outbox with a client id, and sent when the
    /// connection is up. The app hears `core.queued` at once, and the `ack` once it's stored.
    /// A send may name an `agent` instead of a `conversation`: it goes to that agent's
    /// newest conversation, which the core makes first if there's none.
    fn send(mut self, m: Json) {
        var cid = str_at(m.copy(), "cid") ?? String()
        if cid.len() == 0 {
            cid = "m_{self.random.next_u64()}"
        }
        var extra = Obj.new().s("cid", cid.copy())
        if str_at(m.copy(), "conversation") == none {
            if let agent = str_at(m.copy(), "agent") {
                match self.cache.conversation_for(agent) {
                    ok(found) => extra = extra.maybe("conversation", found),
                    err(e) => self.tell_error("cache", "{e}"),
                }
            }
        }
        let frame = merge(m.copy(), extra.done())
        match self.cache.queue(frame.copy()) {
            ok => {},
            err(e) => self.tell_error("cache", "{e}"),
        }
        var queued = Obj.new().s("t", String("core.queued")).s("cid", cid).maybe("conversation", str_at(frame.copy(), "conversation")).maybe("agent", str_at(frame.copy(), "agent")).maybe("text", str_at(m.copy(), "text")).i("at", now())
        if let Json.Array(_) = at(m, "files") {
            queued = queued.j("files", at(frame.copy(), "files"))
        }
        self.tell(queued.done())
        if self.state == State.Live {
            if str_at(frame.copy(), "conversation") == none {
                self.make_conversation(frame)
            } else {
                _ = self.put("{frame}")
            }
        }
    }

    /// Answers the app's `core.get` from the cache: `what` is conversations, agents,
    /// devices, runs, tools, approvals, outbox or messages (with `conversation`, and
    /// `before` and `limit` if it likes).
    fn get(mut self, m: Json) {
        let id = str_at(m.copy(), "id")
        let what = str_at(m.copy(), "what") ?? String()
        var known = false
        for g in GETS {
            if what == g { known = true }
        }
        if not known {
            self.tell(Obj.new().s("t", String("core.data")).maybe("id", id).j("error", Obj.new().s("code", String("unknown_what")).s("message", "There's no {what} to get.").done()).done())
            return
        }
        match self.read_cache(what.copy(), m) {
            ok((list, more)) => self.tell(Obj.new().s("t", String("core.data")).maybe("id", id).s("what", what).j("items", Json.Array(list)).b("more", more).done()),
            err(e) => self.tell(Obj.new().s("t", String("core.data")).maybe("id", id).j("error", Obj.new().s("code", String("cache")).s("message", "{e}").done()).done()),
        }
    }

    fn read_cache(self, what: String, m: Json) -> (List<Json>, bool) ! Error {
        if what == "conversations" { return (try self.cache.conversations(), false) }
        if what == "agents" { return (try self.cache.agents(), false) }
        if what == "devices" { return (try self.cache.devices(), false) }
        if what == "runs" { return (try self.cache.runs(), false) }
        if what == "tools" { return (try self.cache.tools(), false) }
        if what == "approvals" { return (try self.cache.approvals(), false) }
        if what == "outbox" { return (try self.cache.outbox(), false) }
        let limit = int_at(m.copy(), "limit") ?? 50
        return try self.cache.messages(str_at(m.copy(), "conversation") ?? String(), str_at(m, "before"), if limit < 1 or limit > 500 { 50 } else { limit })
    }

    /// A value the cache keeps, or none if it has none or can't be read.
    fn known(self, key: str) -> String? {
        return match self.cache.meta(key) {
            ok(v) => v,
            err(_) => none,
        }
    }

    /// A login's body, with this system's time zone in its `device` when the app didn't
    /// give one, so the instance knows where the person is from the start.
    fn with_tz(self, body: own Json) -> Json {
        let tz = self.tz.copy() else return body
        let device = at(body.copy(), "device")
        if str_at(device.copy(), "tz") != none { return body }
        let given = if device == Json.Null { Obj.new().done() } else { device }
        return merge(body, Obj.new().j("device", merge(given, Obj.new().s("tz", tz).done())).done())
    }

    /// Starts a login or a setup from the app's message `m`. Its `server`, or the one
    /// already known, is where.
    fn log_in(mut self, kind: Kind, m: Json) {
        let id = str_at(m.copy(), "id")
        let server = address(str_at(m.copy(), "server") ?? (self.server.copy() ?? String()))
        if not valid_server(server.copy()) {
            self.tell(Obj.new().s("t", String("core.login")).maybe("id", id).j("error", Obj.new().s("code", String("bad_server")).s("message", String("Give the instance's address, starting with https:// or http://.")).done()).done())
            return
        }
        if self.pending != none {
            self.tell(Obj.new().s("t", String("core.login")).maybe("id", id).j("error", Obj.new().s("code", String("busy")).s("message", String("A login is already on its way.")).done()).done())
            return
        }
        let base = self.reach(server.copy())
        self.pending = some(Pending.start(kind, server, base, id, self.with_tz(request_body(kind, m))))
    }

    /// The instance made a code to add a device: the app gets the result with `qr`, the
    /// text its QR code draws, which holds the address this core reaches the instance at.
    fn linked(mut self, f: Json) {
        let v = at(f.copy(), "value")
        if str_at(v.copy(), "code") == none {
            self.to_app.send("{f}")
            return
        }
        // An instance in this desktop app, with phones on: the phone reaches it over
        // Noise, at this PC's addresses on the network, so the QR code names that place.
        var server = self.server.copy() ?? String()
        let noise_on = at(v.copy(), "noise")
        if bool_at(noise_on.copy(), "on") == some(true) {
            let port = u16.wrap(int_at(noise_on.copy(), "port") ?? 0)
            let key = bytes.from_base64(str_at(noise_on, "key") ?? String()) ?? List<u8>()
            let addresses = relay.own_addresses(port)
            if key.len() == 32 and addresses.len() > 0 { server = relay.write(relay.Place { key: key, addresses: addresses }) }
        }
        let l = link.Link { server: server, code: str_at(v.copy(), "code") ?? String(), instance: str_at(v.copy(), "instance") ?? String(), key: str_at(v.copy(), "key") ?? String() }
        self.tell(merge(f, Obj.new().j("value", merge(v, Obj.new().s("qr", link.qr(l)).done())).done()))
    }

    /// The instance made an invite: the app gets the result with `link`, the address to
    /// pass on, `<the instance's address>/join/<code>`, for an instance on a server.
    fn invited(mut self, f: Json, kind: str) {
        let v = at(f.copy(), "value")
        let server = self.server.copy() ?? String()
        let code = str_at(v.copy(), "code") else {
            self.to_app.send("{f}")
            return
        }
        if not (server.starts_with("https://") or server.starts_with("http://")) {
            self.to_app.send("{f}")
            return
        }
        self.tell(merge(f, Obj.new().j("value", merge(v, Obj.new().s("link", "{server}/{kind}/{code}").done())).done()))
    }

    /// Someone with an invite link (`link`) makes their account, with the username and
    /// password they picked, as a login does; or with a reset link, sets a new password
    /// and logs in with it.
    fn join_invite(mut self, m: Json, reset: bool) {
        let id = str_at(m.copy(), "id")
        let given = (str_at(m.copy(), "link") ?? String()).trim().copy()
        let marker = if reset { "/reset/" } else { "/join/" }
        let what = if reset { "a password reset link. It looks like https://loom.example.com/reset/…" } else { "an invite link. It looks like https://loom.example.com/join/…" }
        var server = String()
        var code = String()
        if let at_marker = given.find(marker) {
            server = address(given[..at_marker].copy())
            code = given[at_marker + marker.len()..].trim_suffix("/").copy()
        }
        if not valid_server(server.copy()) or code.len() == 0 {
            self.tell(Obj.new().s("t", String("core.login")).maybe("id", id).j("error", Obj.new().s("code", String("bad_link")).s("message", "That isn't {what}").done()).done())
            return
        }
        if self.pending != none {
            self.tell(Obj.new().s("t", String("core.login")).maybe("id", id).j("error", Obj.new().s("code", String("busy")).s("message", String("A login is already on its way.")).done()).done())
            return
        }
        let body = merge(request_body(Kind.Login, m), Obj.new().s("code", code).done())
        let base = self.reach(server.copy())
        self.pending = some(Pending.start(if reset { Kind.Reset } else { Kind.Join }, server, base, id, self.with_tz(body)))
    }

    /// The app scanned a QR code (its text in `qr`) on a device that isn't signed in: the
    /// device joins that instance with the code, as a login does with a password.
    fn join(mut self, m: Json) {
        let id = str_at(m.copy(), "id")
        let l = link.read(str_at(m.copy(), "qr") ?? String()) else {
            self.tell(Obj.new().s("t", String("core.login")).maybe("id", id).j("error", Obj.new().s("code", String("bad_qr")).s("message", String("That isn't a loom code. Show the QR code on a device that's signed in, under Add a device.")).done()).done())
            return
        }
        if self.pending != none {
            self.tell(Obj.new().s("t", String("core.login")).maybe("id", id).j("error", Obj.new().s("code", String("busy")).s("message", String("A login is already on its way.")).done()).done())
            return
        }
        var body = Obj.new().s("code", l.code.copy())
        let device = at(m, "device")
        if device != Json.Null { body = body.j("device", device) }
        let server = address(l.server.copy())
        let base = self.reach(server.copy())
        self.pending = some(Pending.start(Kind.Link, server, base, id, self.with_tz(body.done())))
    }

    /// Takes a login, setup or logout that has ended.
    fn poll(mut self) {
        let ready = match self.pending {
            some(p) => p.done(),
            none => false,
        }
        if not ready { return }
        let taken = self.pending.take() else { return }
        var p = taken
        let server = p.server.copy()
        let id = p.id.copy()
        match p.outcome() {
            Outcome.Token(user, device, token) => {
                let user_id = user.copy()
                var reply = Obj.new().s("t", String("core.login")).maybe("id", id).b("ok", true).s("user", user).s("device", device)
                match keyring.set(self.keyring.copy(), relay.keyring_name(server.copy()), token.copy()) {
                    ok => reply = reply.b("kept", true),
                    // Logged in for this run, but the next start asks again.
                    err(e) => reply = reply.b("kept", false).s("why", "{e}"),
                }
                if let ws = self.ws.take() {
                    ws.close()
                }
                // The cache is one person's on one instance: another person, or another
                // instance, starts it again.
                let same = self.known("server") == some(server.copy()) and self.known("user") == some(user_id.copy())
                if not same {
                    match self.cache.clear() {
                        ok => {},
                        err(e) => self.tell_error("cache", "{e}"),
                    }
                    self.have = Map<String, usize>()
                }
                match self.cache.set_meta("server", server.copy()) {
                    ok => {},
                    err(e) => self.tell_error("cache", "{e}"),
                }
                match self.cache.set_meta("user", user_id) {
                    ok => {},
                    err(e) => self.tell_error("cache", "{e}"),
                }
                self.server = some(server)
                self.token = some(token)
                self.failed = 0
                self.tell(reply.done())
                self.connect()
            },
            Outcome.Refused(code, words, wait) => {
                var e = Obj.new().s("code", code).s("message", words)
                if wait > 0 { e = e.i("retry_after", wait) }
                self.tell(Obj.new().s("t", String("core.login")).maybe("id", id).j("error", e.done()).done())
            },
            Outcome.Done => {},
        }
    }

    /// Starts a file going up (`file.upload`, with `path`) or coming down (`file.get`, with
    /// `file` and `thumb`). A file that's down already is answered at once.
    fn transfer(mut self, up: bool, m: Json) {
        let id = str_at(m.copy(), "id")
        let known = self.server.copy() ?? String()
        let server = self.reach(known)
        let token = self.token.copy() ?? String()
        if server.len() == 0 or token.len() == 0 {
            self.tell(refused(id, "signed_out", String("Sign in to an instance first.")))
            return
        }
        if up {
            match Transfer.upload(server, token, id.copy(), str_at(m, "path") ?? String()) {
                ok(t) => self.transfers.push(t),
                err(why) => self.tell(refused(id, "unreadable", why)),
            }
            return
        }
        let sha = str_at(m.copy(), "file") ?? String()
        if not is_sha(sha.copy()) {
            self.tell(refused(id, "not_found", "There's no file {sha}."))
            return
        }
        let thumb = bool_at(m.copy(), "thumb") ?? false
        let name = str_at(m, "name")
        var dir = self.files.copy() ?? String()
        if dir.len() == 0 {
            dir = match fs.temp_dir() {
                ok(d) => d,
                err(e) => {
                    self.tell(refused(id, "cache", "{e}"))
                    return
                },
            }
            self.files = some(dir.copy())
        }
        // A file gets a folder of its own, by its SHA-256, to keep its name in.
        let folder = if thumb { dir.copy() } else { "{dir}/{sha}" }
        match fs.make_dir_all(folder.copy()) {
            ok => {},
            err(e) => {
                self.tell(refused(id, "cache", "can't make {folder}: {e}"))
                return
            },
        }
        let dest = kept_at(dir, sha.copy(), thumb, name)
        if fs.exists(dest.copy()) {
            self.tell(at_path(id, dest))
            return
        }
        self.transfers.push(Transfer.download(server, token, id, sha, thumb, dest))
    }

    /// Moves the update check along, and tells the app what it found.
    fn poll_update(mut self) {
        var said: Json? = none
        if let u = mut self.updater {
            said = u.poll()
        }
        if let s = said {
            self.tell(s)
        }
    }

    /// Answers the transfers that have ended.
    fn poll_transfers(mut self) {
        var i: usize = 0
        while i < self.transfers.len() {
            if self.transfers[i].done() {
                var t = self.transfers.remove(i)
                self.tell(t.outcome())
            } else {
                i += 1
            }
        }
    }

    // --- This device as a tool (core/device.calx) ---

    /// On welcome: this device's id, and its key and tools for the instance.
    fn offer(mut self, id: String) {
        var frame = Json.Null
        if let d = mut self.device {
            d.id = id.copy()
            frame = d.frame()
        }
        if frame != Json.Null { _ = self.put("{frame}") }
    }

    /// Sets the tools the app gives (none to only ask), and tells the app and the
    /// instance what they are now.
    fn device_tools(mut self, given: Json) {
        var tools = Json.Null
        var frame = Json.Null
        var failed = String()
        if let d = mut self.device {
            if given != Json.Null {
                if let err(e) = d.set_modes(self.cache, given) { failed = "{e}" }
            }
            tools = d.tools()
            frame = d.frame()
        }
        if failed.len() > 0 { self.tell_error("cache", failed) }
        if tools == Json.Null {
            self.tell_error("device", String("This device's key couldn't be kept, so it offers no tools."))
            return
        }
        self.tell(Obj.new().s("t", String("core.device")).j("tools", tools).done())
        if given != Json.Null and self.state == State.Live { _ = self.put("{frame}") }
    }

    /// An approval given here, of a call to a device: signed with this device's key, so
    /// the device doing the work knows the yes is the person's.
    fn signed(self, m: Json) -> Json? {
        let d = self.device else return none
        let call = str_at(m.copy(), "call") ?? String()
        let asked = match self.cache.approvals() {
            ok(all) => all,
            err(_) => return none,
        }
        for a in asked {
            if str_at(a.copy(), "call") == some(call.copy()) {
                let request = str_at(a, "request") else return none
                return some(merge(m.copy(), Obj.new().j("approval", d.sign(request)).done()))
            }
        }
        return none
    }

    fn device_call(mut self, f: Json) {
        var result = Json.Null
        if let d = mut self.device {
            if let r = d.call(self.cache, f.copy(), now()) { result = r }
        } else {
            result = Obj.new().s("t", String("device.result")).s("call", str_at(f, "call") ?? String()).b("ok", false).s("output", String("This device offers no tools.")).done()
        }
        // A screenshot or the clipboard: the app does it, and answers with device.answer.
        if str_at(result.copy(), "t") == some(String("core.device_ask")) {
            self.tell(result)
            return
        }
        if result != Json.Null { _ = self.put("{result}") }
    }

    /// The app's answer to a call it was asked, on to the instance.
    fn device_answer(mut self, m: Json) {
        var result = Json.Null
        if let d = mut self.device {
            if let r = d.answered(m) { result = r }
        }
        if result != Json.Null and self.state == State.Live { _ = self.put("{result}") }
    }

    fn poll_device(mut self) {
        var results = List<Json>()
        if let d = mut self.device { results = d.poll() }
        for r in results {
            _ = self.put("{r}")
        }
    }

    // --- Following a move (protocol.md, "moved") ---

    /// The instance moved: if it's signed with the instance's key, ask the new place for
    /// its key before sending it the token.
    fn moved(mut self, f: Json) {
        let to = address(str_at(f.copy(), "address") ?? String())
        let key = self.known("instance_key") ?? String()
        if not moved_signed(f.copy(), key) or ws_url(to.copy()) == none {
            self.tell_error("moved_unsigned", String("The instance says it moved, but it isn't signed with its key, so the app stays where it is."))
            return
        }
        self.follow_to = to.copy()
        self.following = some(get("{to}/api/info", List<Header>(), 30000, 65536))
    }

    /// Takes the new place's /api/info, once it has come: the same key, and the app goes
    /// there, keeping its token, cache and cursor. Another key, and it stays.
    fn poll_follow(mut self) {
        if self.following == none and self.follow_to.len() > 0 {
            if let since = self.follow_at {
                if unsafe { Instant.now() }.nanos_since(since) < FOLLOW_AGAIN_NS { return }
            }
            self.follow_at = none
            self.following = some(get("{self.follow_to}/api/info", List<Header>(), 30000, 65536))
            return
        }
        let ready = match self.following {
            some(r) => r.done(),
            none => false,
        }
        if not ready { return }
        let taken = self.following.take() else { return }
        var r = taken
        let to = self.follow_to.copy()
        var info = Json.Null
        if let ok(res) = r.wait() {
            if res.status == 200 {
                if let ok(j) = parse(String.from_utf8(res.body.copy()) ?? String()) { info = j }
            }
        }
        if info == Json.Null {
            // Not answering yet, as when it has the instance but hasn't started it:
            // ask again in a moment.
            self.follow_at = some(unsafe { Instant.now() })
            return
        }
        self.follow_to = String()
        if str_at(info, "key") != self.known("instance_key") {
            self.state = State.Offline
            self.retry_at = none
            self.tell_error("moved_elsewhere", "The instance says it moved to {to}, but another instance is there, so the app doesn't sign in to it.")
            return
        }
        let old = self.server.copy() ?? String()
        let token = self.token.copy() ?? String()
        match keyring.set(self.keyring.copy(), relay.keyring_name(to.copy()), token) {
            ok => {
                if old.len() > 0 {
                    match keyring.delete(self.keyring.copy(), relay.keyring_name(old.copy())) {
                        ok(_) => {},
                        err(_) => {},
                    }
                }
            },
            err(e) => self.tell_error("keyring", "{e}"),
        }
        match self.cache.set_meta("server", to.copy()) {
            ok => {},
            err(e) => self.tell_error("cache", "{e}"),
        }
        self.server = some(to.copy())
        self.failed = 0
        self.tell(Obj.new().s("t", String("core.moved")).s("from", old).s("address", to).done())
        self.connect()
    }

    /// Starts again if it's time.
    fn tick(mut self) {
        if self.state != State.Offline { return }
        if let since = self.retry_at {
            let waited = unsafe { Instant.now() }.nanos_since(since) / 1000000
            if waited < self.wait { return }
        }
        self.connect()
    }
}

impl Task for Conn {
    fn run(own self) {
        var c = self
        c.begin()
        loop {
            c.read()
            c.poll()
            c.poll_transfers()
            c.poll_update()
            c.poll_device()
            c.poll_follow()
            c.tick()
            if let m = unsafe { c.inbox.wait_for(TICK_NS) } {
                var going = c.from_app(m)
                while going {
                    let more = c.inbox.next() else break
                    going = c.from_app(more)
                }
                if not going { break }
            }
        }
        c.stop_relaying()
    }
}

/// Whether the moved frame `f` is signed with `key`, the instance's key (base64).
pub fn moved_signed(f: Json, key: String) -> bool {
    let public = Ed25519PublicKey.from_bytes(bytes.from_base64(key) ?? List<u8>()) else return false
    let message = moved_message(str_at(f.copy(), "instance") ?? String(), str_at(f.copy(), "address") ?? String(), int_at(f.copy(), "at") ?? 0)
    let signature = bytes.from_hex(str_at(f, "signature") ?? String()) ?? List<u8>()
    return public.verify(message.to_bytes(), signature)
}

@test
fn a_move_is_signed_with_the_instance_key() {
    let k = Ed25519Key.generate()
    let key = bytes.base64(k.public_key().bytes())
    let message = moved_message(String("i_1"), String("https://new.example"), 5)
    let f = Obj.new().s("t", String("moved")).s("instance", String("i_1")).s("address", String("https://new.example")).i("at", 5).s("signature", bytes.hex(k.sign(message.to_bytes()))).done()
    assert(moved_signed(f.copy(), key.copy()))
    assert(not moved_signed(merge(f.copy(), Obj.new().s("address", String("https://evil.example")).done()), key))
    assert(not moved_signed(f, bytes.base64(Ed25519Key.generate().public_key().bytes())))
}

@test
fn waits_double_up_to_thirty_seconds() {
    assert(wait_ms(0) == 500)
    assert(wait_ms(1) == 1000)
    assert(wait_ms(2) == 2000)
    assert(wait_ms(6) == 30000)
    assert(wait_ms(40) == 30000)
}

@test
fn makes_the_websocket_address() {
    assert(ws_url(String("http://127.0.0.1:8080")) == some(String("ws://127.0.0.1:8080/ws")))
    assert(ws_url(String("https://loom.example.com/")) == some(String("wss://loom.example.com/ws")))
    assert(ws_url(String("ftp://x")) == none)
}

/// A message's text, cut short for a notification.
fn summary(message: Json) -> String {
    var out = String()
    if let Json.Array(blocks) = at(message, "blocks") {
        for b in blocks {
            if (str_at(b.copy(), "kind") ?? String()) == "text" {
                out.push_str(str_at(b, "text") ?? String())
            }
        }
    }
    var cut = String()
    for r in out.trim().runes() {
        if cut.len() >= 160 {
            cut.push_str("…")
            break
        }
        cut.push(if r == '\n' { ' ' } else { r })
    }
    return cut
}
