module core.spike

// The LOO-4 spike's core: a Calx static library a GPUI window links, which
// streams a reply back to the host through on_event from a thread of its
// own, as the real core will stream the instance's deltas. Built by
// desktop/build.rs with `calx build --staticlib`.
import std.thread.{Task, sleep}
import shared.obj.{Obj}

/// Where the core tells the host what happened: the host's function, and the context it gave.
struct Sink {
    on_event: extern "C" fn(*const u8, usize, *u8)
    ctx: *u8
}

unsafe impl Send for Sink {}

impl Sink {
    fn tell(self, message: String) {
        unsafe { (self.on_event)(message.as_ptr(), message.len(), self.ctx) }
    }
}

struct Streamer {
    sink: Sink
    text: String
    stop: Receiver<bool>
}

impl Task for Streamer {
    fn run(own self) {
        var s = self
        var pos: usize = 0
        var current = String()
        for r in s.text.runes() {
            current.push(r)
            if r != ' ' { continue }
            if s.stop.next() != none { return }
            let delta = Obj.new().s("t", String("delta")).s("run", String("run_1")).s("message", String("msg_1")).i("block", 0).s("kind", String("text")).i("pos", i64.wrap(u64(pos))).s("text", current.copy()).done()
            s.sink.tell("{delta}")
            pos += current.len()
            current = String()
            unsafe { sleep(4000000) }
        }
        if current.len() > 0 {
            s.sink.tell("{Obj.new().s("t", String("delta")).i("pos", i64.wrap(u64(pos))).s("text", current).done()}")
        }
        s.sink.tell("{Obj.new().s("t", String("event")).s("kind", String("run.finished")).s("status", String("done")).done()}")
    }
}

struct Core {
    sink: Sink
    stop: Sender<bool>
}

/// The `len` bytes at `p`, as text, or none if they aren't UTF-8.
unsafe fn text_at(p: *const u8, len: usize) -> String? {
    var bytes = List<u8>()
    for i in 0..len {
        bytes.push(unsafe { p.add(i).read() })
    }
    return String.from_utf8(bytes)
}

/// Starts the core with its configuration, JSON in the `len` bytes at `config`. It tells
/// `on_event`, with `ctx`, what happens, from a thread of its own. Gives back the core,
/// which loom_core_send and loom_core_stop take.
@export_c("loom_core_start")
fn core_start(config: *const u8, len: usize, on_event: extern "C" fn(*const u8, usize, *u8), ctx: *u8) -> *u8 {
    let sink = unsafe { Sink { on_event: on_event, ctx: ctx } }
    let given = unsafe { text_at(config, len) } ?? String()
    sink.tell("{Obj.new().s("t", String("started")).s("config", given).done()}")
    let stop = Receiver<bool>()
    let to = stop.sender()
    let streamer = Streamer { sink: unsafe { Sink { on_event: on_event, ctx: ctx } }, text: String(REPLY), stop: stop }
    _ = unsafe { Thread.spawn(streamer) }
    unsafe {
        return Box(Core { sink: sink, stop: to }).into_ptr().cast<u8>()
    }
}

/// Hands the core a JSON message from the app, the `len` bytes at `json`.
@export_c("loom_core_send")
fn core_send(core: *u8, json: *const u8, len: usize) {
    let c = unsafe { core.cast<Core>().to_box() }
    let text = unsafe { text_at(json, len) } ?? String()
    c.value.sink.tell("{Obj.new().s("t", String("echo")).s("got", text).done()}")
    unsafe { _ = c.into_ptr() }
}

/// Stops the core and frees it.
@export_c("loom_core_stop")
fn core_stop(core: *u8) {
    var c = unsafe { core.cast<Core>().to_box() }
    c.value.stop.send(true)
}

const REPLY: str = "Yes. The last build on **main** passed at 14:02, in 3 minutes 12 seconds. Here's the step that took longest: `cargo build --release --locked`. Everything else was cached. The test run before it failed on a flaky network test, which passed when it ran again. Want me to mark that test as flaky so it stops failing builds? This reply came from Calx, through loom_core_start's on_event, on the core's own thread. "
