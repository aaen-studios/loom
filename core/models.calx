module core.models

// The voice models this device runs itself (PLAN.md, "Voice", "On the device"):
// Parakeet Ultra, v3 and v2 and Whisper large v3 turbo for dictation, Kokoro v1.1 and
// v1.0, Supertonic 3 and Pocket TTS for speech (shared/voice.calx, ENGINES), and what they
// all need, sherpa-onnx's C library for this system, and Silero's voice detector, which
// cuts dictation into the short pieces the models write. Each is downloaded once, into
// the app's models folder, a piece at a time, each piece checked by its size and its
// SHA-256 before it's kept. A model is used only once every piece of it is there and
// checked, which its folder's `.ready` says.
//
// Every address is pinned: sherpa-onnx v2.0.3's release, its model releases on GitHub,
// and its author's model repositories on Hugging Face at a commit. The sizes and hashes
// are those files' own, checked by downloading each one in November 2026.
import std.bytes
import std.env
import std.fs
import std.hash.{Algorithm, Digest}
import std.http
import std.http.server.{Server}
import std.net.{Waker}
import std.tar.{Tar}
import std.thread.{Task, sleep}
import shared.obj.{Obj, str_at}
import shared.voice.{ENGINES}
import std.json.{Json}

/// The sherpa-onnx release every piece comes from, or goes with.
pub const SHERPA: str = "2.0.3"

/// A file a model is made of: where it comes from, its size and its SHA-256, and where
/// it goes in the model's folder. An archive (`unpack`, its top folder's name) is
/// opened into the folder once it's checked, and isn't kept.
pub struct Piece {
    pub model: str
    pub url: str
    pub file: str
    pub size: u64
    pub sha256: str
    pub unpack: str
}

