module tests.fake_voice.main

// Fake voice services, for testing loom's dictation and speech (PLAN.md, "Voice";
// shared/voice.calx) without the real ones, each at the path and with the key header
// the real one has, and answering as its docs say it answers:
//
//     WS   /v1/listen                          Deepgram Nova-3, `Authorization: Token dg-key`:
//                                              a partial "hello" after the first audio, and
//                                              on Finalize "hello world" final, then closes
//                                              on CloseStream
//     WS   /v2/listen                          Deepgram Flux, the same key: Connected, a
//                                              TurnInfo Update "hello" after the first audio,
//                                              on ForceEndTurn an EndOfTurn "hello world",
//                                              and closes on CloseStream
//     WS   /v1/speech-to-text/realtime         ElevenLabs Scribe, `xi-api-key: el-key`:
//                                              session_started, a partial "hei" after the
//                                              first chunk, and on commit "hei verden"
//     WS   /v1/realtime?intent=transcription   OpenAI, `Authorization: Bearer oa-key`: after
//                                              session.update, a delta "Hel" and "lo" after
//                                              audio, and on commit "Hello there" completed
//     WS   /v1/realtime?model=MODEL            OpenAI speech, the same key: after
//                                              session.update, conversation.item.create and
//                                              response.create, two pieces of PCM, then
//                                              response.done
//     WS   /v1/text-to-dialogue/stream-input   ElevenLabs v4 speech, `xi-api-key: el-key`:
//                                              after its voices, inputs and close_socket, two
//                                              pieces of PCM, then is_final
//     POST /openai/v1/audio/transcriptions     Groq, `Bearer gq-key`: "from groq" for a WAV
//     POST /v1/text-to-speech/VOICE            ElevenLabs speech, PCM
//     GET  /v2/voices                          ElevenLabs' voices: Rachel and Adam
//     POST /v1/tts                             Fish Audio, `Bearer fa-key` and a `model` header
//     GET  /model                              Fish Audio's voices: Narrator
//     POST /v1/speak, /v2/speak                Deepgram's Aura-2 (PCM, with container=none)
//                                              and Flux (a WAV), `Token dg-key`
//
// A wrong key gets 401, or for a WebSocket, a refused handshake. Each WebSocket says the
// language the URL or session asked for in its words, so a test can see it: "(no)".
// GET /test/seen gives what each service was sent, as JSON: the audio bytes each stream
// got, the model each was asked for, and the last speech request. POST /test/words sets
// what the streams hear ("hello world" until then: its first word as a partial, then
// all of it), and POST /test/speech how long the speech OpenAI gives is, in ms (200
// until then).
//
//     calx tests/fake_voice/main.calx
import std.bytes
import std.http.server.{Response, Server, ServerSocket}
import std.http.websocket.{Message}
import std.io
import std.json.{Json, parse}
import shared.obj.{Obj, at, str_at}
import shared.voice.{to_wav}

struct Stream {
    socket: ServerSocket
    service: String     // deepgram, flux, elevenlabs, openai, openai_speech or dialogue
    language: String
    audio: usize
    spoke: bool
}

// The body as text, each byte past ASCII as a ?, for a form with a WAV in it.
fn ascii(b: List<u8>) -> String {
    var out = List<u8>()
    for x in b { out.push(if x < 128 { x } else { 63 }) }
    return String.from_utf8(out) ?? String()
}

fn pcm(n: usize) -> List<u8> {
    var out = List<u8>()
    for i in 0..n { out.push(u8.wrap(i)) }
    return out
}

fn query_value(query: String, name: str) -> String {
    for part in query.split("&") {
        if let (k, v) = part.split_once("=") {
            if k == name { return v }
        }
    }
    return String()
}

// A form's field, as text, for Groq's.
fn form_field(body: String, name: str) -> String {
    let marker = "name=\"{name}\"\r\n\r\n"
    let at_field = body.find(marker) else return String()
    let rest = body[at_field + marker.len()..].copy()
    return rest[0..rest.find("\r") ?? rest.len()].copy()
}

fn first_word(text: String) -> String {
    let all = text.split_whitespace()
    return if all.len() > 0 { all[0].copy() } else { String() }
}

fn words(base: String, language: String) -> String {
    return if language.len() > 0 and language != "multi" { "{base} ({language})" } else { base.copy() }
}

fn turn(event: str, transcript: String) -> String {
    return "{Obj.new().s("type", String("TurnInfo")).s("event", String(event)).j("turn_index", Json.Int(0)).s("transcript", transcript).done()}"
}

fn main() ! Error {
    var server = try Server.listen(0)
    server.log = false
    println("fake voice: http://127.0.0.1:{server.port}")
    io.flush()
    var streams = List<Stream>()
    var seen = Obj.new()
    var last_speech = String()
    var said = String("hello world")
    var speech_ms: usize = 200
    loop {
        let e = server.next_event() else continue
        match e {
            Request(req) => {
                let path = req.path.copy()
                if path == "/test/seen" {
                    server.respond(req, Response.json("{seen.copy().j("speech", Json.Str(last_speech.copy())).done()}"))
                    continue
                }
                if path == "/test/words" {
                    said = (String.from_utf8(req.body.copy()) ?? String()).trim().copy()
                    server.respond(req, Response.json(String(#"{}"#)))
                    continue
                }
                if path == "/test/speech" {
                    speech_ms = usize.parse((String.from_utf8(req.body.copy()) ?? String()).trim().copy()) ?? 200
                    server.respond(req, Response.json(String(#"{}"#)))
                    continue
                }
                let auth = req.header(String("Authorization")) ?? String()
                let eleven = req.header(String("xi-api-key")) == some(String("el-key"))
                if path == "/v1/listen" or path == "/v2/listen" or path == "/v1/speech-to-text/realtime" or path == "/v1/realtime" or path == "/v1/text-to-dialogue/stream-input" {
                    let query = req.query.copy()
                    let (service, good) = if path == "/v1/listen" {
                        ("deepgram", auth == "Token dg-key")
                    } else if path == "/v2/listen" {
                        ("flux", auth == "Token dg-key")
                    } else if path == "/v1/realtime" {
                        (if query.contains("intent=transcription") { "openai" } else { "openai_speech" }, auth == "Bearer oa-key")
                    } else if path == "/v1/text-to-dialogue/stream-input" {
                        ("dialogue", eleven)
                    } else {
                        ("elevenlabs", eleven)
                    }
                    if not good {
                        server.respond(req, Response.error(401, String("bad key")))
                        continue
                    }
                    let language = if service == "deepgram" { query_value(query.copy(), "language") } else if service == "flux" { query_value(query.copy(), "language_hint") } else { query_value(query.copy(), "language_code") }
                    if service == "deepgram" or service == "flux" { seen = seen.s("deepgram_model", query_value(query.copy(), "model")) }
                    if service == "elevenlabs" { seen = seen.s("elevenlabs_model", query_value(query.copy(), "model_id")) }
                    if service == "dialogue" {
                        seen = seen.s("dialogue_model", query_value(query.copy(), "model_id"))
                        seen = seen.s("dialogue_format", query_value(query.copy(), "output_format"))
                    }
                    if service == "openai_speech" { seen = seen.s("openai_speech_model", query_value(query.copy(), "model")) }
                    match server.upgrade(req) {
                        ok(s) => {
                            if service == "elevenlabs" { _ = server.send_text(s, String(#"{"message_type":"session_started","session_id":"s1"}"#)) }
                            if service == "flux" { _ = server.send_text(s, String(#"{"type":"Connected","request_id":"r1","sequence_id":0}"#)) }
                            streams.push(Stream { socket: s, service: String(service), language: language, audio: 0, spoke: false })
                        },
                        err(why) => eprintln("fake voice: {why}"),
                    }
                    continue
                }
                if path == "/openai/v1/audio/transcriptions" {
                    if auth != "Bearer gq-key" {
                        server.respond(req, Response.new(401, String("application/json"), String(#"{"error":{"message":"Invalid API Key"}}"#).to_bytes()))
                        continue
                    }
                    let body = ascii(req.body.copy())
                    let model = form_field(body.copy(), "model")
                    seen = seen.b("groq", body.contains("RIFF") and model.len() > 0).s("groq_model", model)
                    let given = form_field(body, "language")
                    let lang = if given.len() > 0 { " ({given})" } else { String() }
                    server.respond(req, Response.json("{Obj.new().s("text", " from groq{lang} ").done()}"))
                    continue
                }
                if path.starts_with("/v1/text-to-speech/") and req.method == "POST" {
                    if not eleven or not req.query.contains("output_format=pcm_24000") {
                        server.respond(req, Response.error(401, String("bad key")))
                        continue
                    }
                    last_speech = "elevenlabs {path[19..]} {ascii(req.body.copy())}"
                    server.respond(req, Response.new(200, String("audio/pcm"), pcm(4800)))
                    continue
                }
                if path == "/v2/voices" {
                    if not eleven {
                        server.respond(req, Response.error(401, String("bad key")))
                        continue
                    }
                    server.respond(req, Response.json(String(#"{"voices":[{"voice_id":"el_rachel","name":"Rachel","category":"premade"},{"voice_id":"el_adam","name":"Adam","category":"premade"}],"has_more":false}"#)))
                    continue
                }
                if path == "/v1/tts" {
                    let model = req.header(String("model")) ?? String()
                    if auth != "Bearer fa-key" or model.len() == 0 {
                        server.respond(req, Response.error(401, String("bad key")))
                        continue
                    }
                    last_speech = "fish {model} {ascii(req.body.copy())}"
                    server.respond(req, Response.new(200, String("audio/pcm"), pcm(2400)))
                    continue
                }
                if path == "/model" {
                    if auth != "Bearer fa-key" {
                        server.respond(req, Response.error(401, String("bad key")))
                        continue
                    }
                    server.respond(req, Response.json(String(#"{"total":1,"items":[{"_id":"fa_narrator","title":"Narrator","type":"tts"}]}"#)))
                    continue
                }
                if path == "/v1/speak" or path == "/v2/speak" {
                    if auth != "Token dg-key" {
                        server.respond(req, Response.new(401, String("application/json"), String(#"{"err_code":"INVALID_AUTH","err_msg":"Invalid credentials."}"#).to_bytes()))
                        continue
                    }
                    last_speech = "deepgram {path}?{req.query} {ascii(req.body.copy())}"
                    // Aura-2 without a container is its PCM; Flux's comes as a WAV.
                    let raw = path == "/v1/speak" and req.query.contains("container=none")
                    server.respond(req, Response.new(200, String(if raw { "audio/l16" } else { "audio/wav" }), if raw { pcm(4800) } else { to_wav(pcm(7200)) }))
                    continue
                }
                server.respond(req, Response.error(404))
            },
            Message(s, m) => {
                var at_stream: usize = 0
                var found = false
                for k in 0..streams.len() {
                    if streams[k].socket == s {
                        at_stream = k
                        found = true
                    }
                }
                if not found { continue }
                let service = streams[at_stream].service.copy()
                let language = streams[at_stream].language.copy()
                match m {
                    Message.Binary(b) => {
                        streams[at_stream].audio += b.len()
                        seen = seen.j("deepgram_audio", Json.Int(i64.wrap(streams[at_stream].audio)))
                        if not streams[at_stream].spoke {
                            streams[at_stream].spoke = true
                            if service == "flux" {
                                _ = server.send_text(s, turn("StartOfTurn", String()))
                                _ = server.send_text(s, turn("Update", words(first_word(said.copy()), language.copy())))
                            } else {
                                _ = server.send_text(s, "{Obj.new().s("type", String("Results")).b("is_final", false).j("channel", Obj.new().j("alternatives", Json.Array([Obj.new().s("transcript", words(first_word(said.copy()), language.copy())).done()])).done()).done()}")
                            }
                        }
                    },
                    Message.Text(t) => {
                        let j = match parse(t.copy()) {
                            ok(x) => x,
                            err(_) => Json.Null,
                        }
                        if service == "deepgram" or service == "flux" {
                            let kind = str_at(j, "type") ?? String()
                            if kind == "Finalize" and service == "deepgram" {
                                _ = server.send_text(s, "{Obj.new().s("type", String("Results")).b("is_final", true).b("from_finalize", true).j("channel", Obj.new().j("alternatives", Json.Array([Obj.new().s("transcript", words(said.copy(), language.copy())).done()])).done()).done()}")
                            } else if kind == "ForceEndTurn" and service == "flux" {
                                _ = server.send_text(s, turn("EndOfTurn", words(said.copy(), language.copy())))
                            } else if kind == "CloseStream" {
                                _ = server.send_text(s, String(#"{"type":"Metadata","request_id":"r1"}"#))
                                server.close_socket(s)
                            }
                        } else if service == "elevenlabs" {
                            let chunk = str_at(j.copy(), "audio_base_64") ?? String()
                            streams[at_stream].audio += chunk.len()
                            seen = seen.j("elevenlabs_audio", Json.Int(i64.wrap(streams[at_stream].audio)))
                            if at(j.copy(), "commit") == Json.Bool(true) {
                                _ = server.send_text(s, "{Obj.new().s("message_type", String("committed_transcript")).s("text", words("hei verden", language.copy())).done()}")
                            } else if not streams[at_stream].spoke and chunk.len() > 0 {
                                streams[at_stream].spoke = true
                                _ = server.send_text(s, "{Obj.new().s("message_type", String("partial_transcript")).s("text", words("hei", language.copy())).done()}")
                            }
                        } else if service == "dialogue" {
                            // Its voices first, then the text in one of them, then the end.
                            if let Json.Array(v) = at(j.copy(), "voices") {
                                if v.len() > 0 { seen = seen.j("dialogue_voices", Json.Array(v)) }
                            }
                            if let Json.Array(inputs) = at(j.copy(), "inputs") {
                                if inputs.len() > 0 { last_speech = "dialogue {inputs[0]}" }
                            }
                            if at(j, "close_socket") == Json.Bool(true) {
                                for _ in 0..2 { _ = server.send_text(s, "{Obj.new().s("audio", bytes.base64(pcm(2400))).j("alignment", Json.Null).done()}") }
                                _ = server.send_text(s, String(#"{"is_final_audio_for_turn":true}"#))
                                _ = server.send_text(s, String(#"{"is_final":true}"#))
                                server.close_socket(s)
                            }
                        } else if service == "openai_speech" {
                            let kind = str_at(j.copy(), "type") ?? String()
                            if kind == "session.update" {
                                seen = seen.j("openai_speech_session", at(j, "session"))
                                _ = server.send_text(s, String(#"{"type":"session.updated"}"#))
                            } else if kind == "conversation.item.create" {
                                let text = match at(at(j, "item"), "content").at(0) {
                                    some(c) => str_at(c, "text") ?? String(),
                                    none => String(),
                                }
                                last_speech = "openai {Obj.new().s("input", text).done()}"
                            } else if kind == "response.create" {
                                // Two pieces, speech_ms of 24 kHz PCM together.
                                for _ in 0..2 { _ = server.send_text(s, "{Obj.new().s("type", String("response.output_audio.delta")).s("delta", bytes.base64(pcm(speech_ms * 24))).done()}") }
                                _ = server.send_text(s, String(#"{"type":"response.output_audio.done"}"#))
                                _ = server.send_text(s, String(#"{"type":"response.done","response":{"status":"completed"}}"#))
                            }
                        } else {
                            let kind = str_at(j.copy(), "type") ?? String()
                            if kind == "session.update" {
                                let transcription = at(at(at(at(j.copy(), "session"), "audio"), "input"), "transcription")
                                let lang = match at(transcription.copy(), "languages").at(0) {
                                    some(Json.Str(l)) => l,
                                    _ => str_at(transcription.copy(), "language") ?? String(),
                                }
                                streams[at_stream].language = lang
                                seen = seen.s("openai_model", str_at(transcription, "model") ?? String())
                                seen = seen.j("openai_turns", at(at(at(at(j, "session"), "audio"), "input"), "turn_detection"))
                                _ = server.send_text(s, String(#"{"type":"session.updated"}"#))
                            } else if kind == "input_audio_buffer.append" {
                                streams[at_stream].audio += (str_at(j, "audio") ?? String()).len()
                                seen = seen.j("openai_audio", Json.Int(i64.wrap(streams[at_stream].audio)))
                                if not streams[at_stream].spoke {
                                    streams[at_stream].spoke = true
                                    _ = server.send_text(s, String(#"{"type":"conversation.item.input_audio_transcription.delta","item_id":"i1","content_index":0,"delta":"Hel"}"#))
                                    _ = server.send_text(s, String(#"{"type":"conversation.item.input_audio_transcription.delta","item_id":"i1","content_index":0,"delta":"lo"}"#))
                                }
                            } else if kind == "input_audio_buffer.commit" {
                                _ = server.send_text(s, String(#"{"type":"input_audio_buffer.committed","item_id":"i1"}"#))
                                _ = server.send_text(s, "{Obj.new().s("type", String("conversation.item.input_audio_transcription.completed")).s("item_id", String("i1")).j("content_index", Json.Int(0)).s("transcript", words("Hello there", streams[at_stream].language.copy())).done()}")
                            }
                        }
                    },
                }
            },
            Closed(s, _, _) => {
                var kept = List<Stream>()
                while let x = streams.pop() {
                    if x.socket != s { kept.push(x) }
                }
                streams = kept
            },
            _ => {},
        }
    }
}
