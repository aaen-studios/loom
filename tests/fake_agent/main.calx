module tests.fake_agent.main

// A fake ACP agent, for testing loom without a real model.
//
// It speaks ACP (JSON-RPC 2.0, one message a line) on standard input and
// output, as claude-agent-acp does, and plays whatever turn the prompt spells
// out. Each line of the prompt is one step:
//
//     plain text          says that line, streamed a word at a time
//     /say TEXT           the same, with each \n in it a line break
//     /think TEXT         an agent_thought_chunk
//     /plan A; B; C       a plan with those entries
//     /tool TITLE         a tool call that runs and completes
//     /ask TITLE          a command (kind execute) that asks permission first,
//                         and runs or fails by the answer
//     /read TITLE         the same for a tool that only reads (kind read)
//     /shell JSON         a shell command as Claude's adapter plays one: a tool call
//                         titled "Terminal", then an update with JSON as its
//                         rawInput and its "command" as the title, then completed
//     /selfprompt         a user_message_chunk, "Look into the spoons.", as a prompt
//                         the program gives itself or a subagent
//     /subagent TITLE; STEP; STEP ...
//                         a subagent, as Claude's adapter plays one: a Task call
//                         (kind think) titled TITLE, then each STEP (/tool TITLE,
//                         /think TEXT, or text to say) tagged with the Task call's
//                         id in _meta.claudeCode.parentToolUseId, then the Task
//                         call completed
//     /named TITLE        a tool call titled "Terminal" whose one update both
//                         titles it TITLE and completes it
//     /askonly TITLE      asks permission for a command it never sent a tool_call
//                         for, then completes or fails it by the answer
//     /open TITLE         a tool call (kind execute) that starts and is never
//                         reported on again
//     /askopen JSON       asks permission for a command it never sent a tool_call
//                         for, with JSON as its rawInput and its title from its
//                         "title", and never reports on it whatever the answer;
//                         says "allowed" or "denied"
//     /act KIND JSON     a tool call of KIND (execute, edit, fetch, ...) that asks
//                         permission first, with JSON as its rawInput, its
//                         locations from the JSON's "path", and its title from its
//                         "title" (or KIND); says "allowed" or "denied"
//     /slow MS            waits MS between chunks from here on
//     /sleep MS           waits MS, or until the turn is cancelled
//     /stop REASON        ends the turn with that stopReason (max_tokens, ...)
//     /tokens N           reports the turn used N tokens (ACP's usage: half input, half output)
//     /fail MESSAGE       answers session/prompt with an error
//     /crash              exits with status 3 in the middle of the turn
//     /files              says what files came with the prompt: "image MIME"
//                         for an image, "link NAME" for a link to a file that
//                         exists, "missing NAME" for one that doesn't
//     /image              sends back a small PNG
//     /link PATH          sends back a link to the file at PATH (resource_link)
//     /session            says its session id: "session ID"
//     /uptime             says how long ago the program started: "up MS ms"
//     /usage USED SIZE    reports its context as USED tokens of a SIZE window (usage_update)
//     /env NAME           says NAME=VALUE, its environment variable NAME
//     /net HOST:PORT      says whether HOST:PORT can be reached straight ("direct
//                         open" or "direct closed"), and through the proxy
//                         HTTPS_PROXY names with CONNECT ("proxy 200", the
//                         status it answers, or "proxy none")
//     /servers            says the MCP servers the session was given, but loom:
//                         "NAME command ARGS K=V" or "NAME url K=V" each, or "no servers"
//     /meta               says the _meta its session was given: "meta JSON",
//                         or "no meta"
//     /context            says what loom told it this turn about where the person
//                         is writing from (a "[loom: ...]" text block, which is
//                         never a step), or "no context"
//     /mcp TOOL JSON      calls TOOL of loom's own MCP server, the one named "loom"
//                         in the session's mcpServers, with JSON as its
//                         arguments, and says "TOOL: RESULT", or "TOOL failed:
//                         RESULT" for an error. /mcp list says the tools' names,
//                         and /mcp hints each one's name and annotations, a line each
//     /mcpkeep TOOL JSON  the same, through one loom mcp the session keeps, started
//                         at its first /mcpkeep, as a real agent keeps its servers
//
// A turn ends with end_turn after its last step, or with cancelled as soon as
// session/cancel arrives. Diagnostics go to standard error.
//
// With --load it offers session/load, and plays a line back when a session is
// loaded; with --resume it offers session/resume; with --forget it offers
// session/load and refuses every one. Without, it offers neither. With
// --limited it answers every session/prompt with a usage-limit error, as a
// program whose usage ran out does; with --broken it doesn't initialize.
//
//     calx tests/fake_agent/main.calx [--load | --resume | --forget | --limited | --broken]
import std.bytes
import std.crypto.{random_bytes}
import std.env
import std.fs
import std.image.{Color, Image, Kind}
import std.io
import std.url
import std.json.{Json, parse}
import std.net.{Event, Net}
import std.process.{Child, Command, Stdio, exit}
import std.thread.{Task}
import std.time.{Instant}

// Reads standard input on a thread of its own, so a turn can wait for a
// message and a deadline at once.
struct Reader {
    out: Sender<String>
}

impl Task for Reader {
    fn run(own self) {
        var out = self.out
        var input = io.Lines()
        while let line = input.next() {
            out.send(line)
        }
    }
}

// One step of a scripted turn.
pub enum Step {
    Say(String)
    Think(String)
    Plan(List<String>)
    Tool(String)
    Ask(String, String)
    Act(String, String)    // a kind, and the rawInput as JSON
    Shell(String)    // the rawInput as JSON
    SelfPrompt
    Subagent(String, List<String>)    // its title, and its steps
    Named(String)
    AskOnly(String)
    Open(String)
    AskOpen(String)    // the rawInput as JSON
    Slow(u64)
    Sleep(u64)
    Stop(String)
    Tokens(i64)
    Fail(String)
    Crash
    Files
    Image
    Link(String)
    Session
    Uptime
    Context
    Mcp(String, String)
    McpKeep(String, String)
    Env(String)
    Net(String)
    Servers
    Config
    Meta
    Usage(i64, i64)
}

// The steps a prompt spells out. Blank lines are skipped.
pub fn script(text: String) -> List<Step> {
    var steps = List<Step>()
    for raw in text.split("\n") {
        let line = raw.trim()
        if line.len() == 0 { continue }
        if not line.starts_with("/") {
            steps.push(Step.Say(line.copy()))
            continue
        }
        let (word, rest) = split_word(line.copy())
        if word == "/say" {
            steps.push(Step.Say(rest.replace(String("\\n"), String("\n"))))
        } else if word == "/think" {
            steps.push(Step.Think(rest))
        } else if word == "/plan" {
            var entries = List<String>()
            for e in rest.split(";") {
                let t = e.trim()
                if t.len() > 0 { entries.push(t.copy()) }
            }
            steps.push(Step.Plan(entries))
        } else if word == "/tool" {
            steps.push(Step.Tool(rest))
        } else if word == "/ask" {
            steps.push(Step.Ask(String("execute"), rest))
        } else if word == "/act" {
            let (kind, input) = split_word(rest.copy())
            steps.push(Step.Act(kind, if input.len() > 0 { input } else { String(#"{}"#) }))
        } else if word == "/selfprompt" {
            steps.push(Step.SelfPrompt)
        } else if word == "/subagent" {
            var title = String()
            var inner = List<String>()
            for part in rest.split(";") {
                let t = part.trim()
                if title.len() == 0 { title = t.copy() } else if t.len() > 0 { inner.push(t.copy()) }
            }
            steps.push(Step.Subagent(title, inner))
        } else if word == "/named" {
            steps.push(Step.Named(rest))
        } else if word == "/askonly" {
            steps.push(Step.AskOnly(rest))
        } else if word == "/open" {
            steps.push(Step.Open(rest))
        } else if word == "/askopen" {
            steps.push(Step.AskOpen(if rest.len() > 0 { rest } else { String(#"{}"#) }))
        } else if word == "/shell" {
            steps.push(Step.Shell(rest))
        } else if word == "/read" {
            steps.push(Step.Ask(String("read"), rest))
        } else if word == "/slow" {
            steps.push(Step.Slow(u64.parse(rest) ?? 0))
        } else if word == "/sleep" {
            steps.push(Step.Sleep(u64.parse(rest) ?? 0))
        } else if word == "/tokens" {
            steps.push(Step.Tokens(i64.parse(rest) ?? 0))
        } else if word == "/stop" {
            steps.push(Step.Stop(if rest.len() == 0 { String("end_turn") } else { rest }))
        } else if word == "/fail" {
            steps.push(Step.Fail(if rest.len() == 0 { String("the fake agent failed") } else { rest }))
        } else if word == "/crash" {
            steps.push(Step.Crash)
        } else if word == "/files" {
            steps.push(Step.Files)
        } else if word == "/mcp" or word == "/mcpkeep" {
            let (tool, args) = match rest.find(" ") {
                some(at) => (rest[..at].copy(), rest[at + 1..].copy()),
                none => (rest.copy(), String(#"{}"#)),
            }
            steps.push(if word == "/mcp" { Step.Mcp(tool, args) } else { Step.McpKeep(tool, args) })
        } else if word == "/context" {
            steps.push(Step.Context)
        } else if word == "/uptime" {
            steps.push(Step.Uptime)
        } else if word == "/session" {
            steps.push(Step.Session)
        } else if word == "/servers" {
            steps.push(Step.Servers)
        } else if word == "/config" {
            steps.push(Step.Config)
        } else if word == "/meta" {
            steps.push(Step.Meta)
        } else if word == "/usage" {
            let (used, size) = split_word(rest)
            steps.push(Step.Usage(i64.parse(used) ?? 0, i64.parse(size) ?? 0))
        } else if word == "/env" {
            steps.push(Step.Env(rest))
        } else if word == "/net" {
            steps.push(Step.Net(rest))
        } else if word == "/image" {
            steps.push(Step.Image)
        } else if word == "/link" {
            steps.push(Step.Link(rest))
        } else {
            steps.push(Step.Say(line.copy()))
        }
    }
    return steps
}

// Opens a connection to `host`:`port` on `net`, and gives what came back
// after sending `send`, until the first line break, or none if it closed
// first or nothing came in 5 seconds. "" when `send` is empty and it opened.
fn talk(net: Net, host: String, port: u16, send: String) -> String? {
    let conn = match net.connect(host, port) {
        ok(c) => c,
        err(_) => return none,
    }
    var events = List<Event>()
    var got = List<u8>()
    var open = false
    let start = unsafe { Instant.now() }
    while unsafe { Instant.now() }.nanos_since(start) < 5000000000 {
        net.poll(200, mut events)
        for e in events {
            match e {
                Connected(c) => {
                    if c == conn {
                        open = true
                        if send.len() == 0 {
                            net.close(conn)
                            return some(String())
                        }
                        net.write(conn, send.to_bytes())
                    }
                },
                Received(c) => if c == conn { _ = net.read(conn, mut got) },
                Closed(c) => if c == conn {
                    let text = String.from_utf8(got.copy()) ?? String()
                    return if text.len() > 0 { some(text) } else { none }
                },
                _ => {},
            }
        }
        let text = String.from_utf8(got.copy()) ?? String()
        if text.contains("\r\n") {
            net.close(conn)
            return some(text.split("\r\n")[0].copy())
        }
    }
    if open { net.close(conn) }
    return none
}

// What /net says of `target`, host:port: whether it's reached straight, and
// what the proxy HTTPS_PROXY names says to a CONNECT for it.
fn reach(target: String) -> String {
    let net = match Net.new() {
        ok(n) => n,
        err(e) => return "net {target}: {e}",
    }
    let cut = target.find_last(":") ?? target.len()
    let host = target[..cut].copy()
    let port = u16.parse(if cut < target.len() { target[cut + 1..].copy() } else { String("443") }) ?? 443
    let direct = if talk(net, host.copy(), port, String()) != none { "open" } else { "closed" }
    var proxied = String("none")
    if let proxy = env.variable(String("HTTPS_PROXY")) {
        let address = proxy.trim_prefix("http://").trim_suffix("/").copy()
        let at = address.find_last(":") ?? address.len()
        let p_host = address[..at].copy()
        let p_port = u16.parse(if at < address.len() { address[at + 1..].copy() } else { String("80") }) ?? 80
        let said = talk(net, p_host, p_port, "CONNECT {target} HTTP/1.1\r\nHost: {target}\r\n\r\n") ?? String("no answer")
        let words = said.split(" ")
        proxied = if words.len() > 1 { words[1].copy() } else { said }
    }
    return "net {target}: direct {direct}, proxy {proxied}"
}

// "/tool ls -la" -> ("/tool", "ls -la")
fn split_word(line: own String) -> (String, String) {
    if let i = line.find(" ") {
        return (line[..i].copy(), line[i + 1..].trim().copy())
    }
    return (line, String())
}

// "one two three" -> ["one ", "two ", "three"]
pub fn chunks(text: String) -> List<String> {
    var out = List<String>()
    var current = String()
    for r in text.runes() {
        current.push(r)
        if r == ' ' {
            out.push(current.copy())
            current = String()
        }
    }
    if current.len() > 0 { out.push(current) }
    return out
}

fn js(s: String) -> Json {
    return Json.Str(s.copy())
}

fn int(n: i64) -> Json {
    return Json.Int(n)
}

struct Agent {
    inbox: Receiver<String>
    sessions: i64
    next_id: i64
    tools: i64
    // "load", "resume" or "forget" (offers session/load and refuses every one), from
    // its argument, or "" for neither.
    picks_up: String
    // Each session's mcpServers, as session/new, /load or /resume gave them.
    mcp: Map<String, Json>
    // Each session's _meta, as session/new, /load or /resume gave it.
    meta: Map<String, Json>
    stamp: String
    // Requests that came in during a turn, answered after it.
    backlog: List<Json>
    // Each session's config options' values, by option id: "model" and "effort".
    config: Map<String, Map<String, String>>
    // The loom mcp each session keeps for /mcpkeep, and its next request's id.
    kept: Map<String, Child>
    kept_id: i64
    born: Instant    // when it started, for /uptime
}

// The config options a session offers (ACP's session config options): a model
// and a reasoning effort, with their values now.
fn config_options(values: Map<String, String>) -> Json {
    return Json.Array([config_option(values.copy(), "model", "Model", "model"), config_option(values, "effort", "Effort", "thought_level")])
}

// The values option `id` offers.
fn offered(id: String) -> List<String> {
    if id == "model" { return [String("fake-1"), String("fake-2")] }
    if id == "effort" { return [String("low"), String("medium"), String("high")] }
    return List<String>()
}

fn config_option(values: Map<String, String>, id: str, name: str, category: str) -> Json {
    var options = List<Json>()
    for v in offered(String(id)) {
        var o = LinkedMap<String, Json>()
        o.insert("value", js(v.copy()))
        o.insert("name", js("{name} {v}"))
        options.push(Json.Object(o))
    }
    var c = LinkedMap<String, Json>()
    c.insert("id", js(String(id)))
    c.insert("name", js(String(name)))
    c.insert("category", js(String(category)))
    c.insert("type", js(String("select")))
    var current = String()
    if let v = values.find(String(id)) { current = v.copy() }
    c.insert("currentValue", js(current))
    c.insert("options", Json.Array(options))
    return Json.Object(c)
}

fn config_default() -> Map<String, String> {
    var m = Map<String, String>()
    m.insert(String("model"), String("fake-1"))
    m.insert(String("effort"), String("medium"))
    return m
}

fn emit(message: Json) {
    println("{message}")
    io.flush()
}

fn respond(id: Json, result: Json) {
    var m = LinkedMap<String, Json>()
    m.insert("jsonrpc", js(String("2.0")))
    m.insert("id", id.copy())
    m.insert("result", result.copy())
    emit(Json.Object(m))
}

fn respond_error(id: Json, code: i64, message: String) {
    var e = LinkedMap<String, Json>()
    e.insert("code", int(code))
    e.insert("message", js(message))
    var m = LinkedMap<String, Json>()
    m.insert("jsonrpc", js(String("2.0")))
    m.insert("id", id.copy())
    m.insert("error", Json.Object(e))
    emit(Json.Object(m))
}

fn update(session: String, u: LinkedMap<String, Json>) {
    var p = LinkedMap<String, Json>()
    p.insert("sessionId", js(session))
    p.insert("update", Json.Object(u.copy()))
    var m = LinkedMap<String, Json>()
    m.insert("jsonrpc", js(String("2.0")))
    m.insert("method", js(String("session/update")))
    m.insert("params", Json.Object(p))
    emit(Json.Object(m))
}

fn chunk(session: String, kind: str, text: String) {
    update(session, chunk_of(kind, text))
}

// A subagent's update, tagged as Claude's adapter tags one: the id of the Task
// call that started it, in _meta.claudeCode.parentToolUseId.
fn inside(u: own LinkedMap<String, Json>, parent: String) -> LinkedMap<String, Json> {
    var claude = LinkedMap<String, Json>()
    claude.insert("parentToolUseId", js(parent))
    var meta = LinkedMap<String, Json>()
    meta.insert("claudeCode", Json.Object(claude))
    var out = u
    out.insert("_meta", Json.Object(meta))
    return out
}

fn tool_update(session: String, id: String, status: str, output: String) {
    update(session, tool_update_of(id, status, output))
}

fn tool_update_of(id: String, status: str, output: String) -> LinkedMap<String, Json> {
    var u = LinkedMap<String, Json>()
    u.insert("sessionUpdate", js(String("tool_call_update")))
    u.insert("toolCallId", js(id))
    u.insert("status", js(String(status)))
    if output.len() > 0 {
        var text = LinkedMap<String, Json>()
        text.insert("type", js(String("text")))
        text.insert("text", js(output))
        var block = LinkedMap<String, Json>()
        block.insert("type", js(String("content")))
        block.insert("content", Json.Object(text))
        u.insert("content", Json.Array([Json.Object(block)]))
    }
    return u
}

fn tool_call_of(id: String, kind: String, title: String) -> LinkedMap<String, Json> {
    var u = LinkedMap<String, Json>()
    u.insert("sessionUpdate", js(String("tool_call")))
    u.insert("toolCallId", js(id))
    u.insert("title", js(title))
    u.insert("kind", js(kind))
    u.insert("status", js(String("pending")))
    return u
}

fn chunk_of(kind: str, text: String) -> LinkedMap<String, Json> {
    var content = LinkedMap<String, Json>()
    content.insert("type", js(String("text")))
    content.insert("text", js(text))
    var u = LinkedMap<String, Json>()
    u.insert("sessionUpdate", js(String(kind)))
    u.insert("content", Json.Object(content))
    return u
}

impl Agent {
    fn tool_call(a: mut Agent, session: String, kind: String, title: String) -> String {
        let id = a.new_tool()
        update(session, tool_call_of(id.copy(), kind, title))
        return id
    }

    // A new toolCallId.
    fn new_tool(a: mut Agent) -> String {
        a.tools += 1
        return "tool_{a.tools}"
    }

    // A subagent's steps (/subagent), each tagged with `parent`, its Task call's id.
    fn subagent(a: mut Agent, session: String, parent: String, inner: List<String>) {
        for line in inner {
            let (word, rest) = split_word(line.copy())
            if word == "/tool" {
                let id = a.new_tool()
                update(session.copy(), inside(tool_call_of(id.copy(), String("execute"), rest.copy()), parent.copy()))
                update(session.copy(), inside(tool_update_of(id, "completed", "ran: {rest}"), parent.copy()))
            } else if word == "/think" {
                update(session.copy(), inside(chunk_of("agent_thought_chunk", rest), parent.copy()))
            } else {
                for c in chunks(line.copy()) {
                    update(session.copy(), inside(chunk_of("agent_message_chunk", c), parent.copy()))
                }
            }
        }
    }

    // The next message, waiting at most `ms`. none if nothing came in time.
    fn next(a: mut Agent, ms: u64) -> Json? {
        let line = unsafe { a.inbox.wait_for(ms * 1000000) } else return none
        match parse(line.copy()) {
            ok(j) => return some(j),
            err(e) => {
                eprintln("fake agent: not JSON ({e}): {line}")
                return none
            },
        }
    }

    // Waits up to `ms` during a turn. Gives true if the turn was cancelled.
    // Requests that come meanwhile wait in the backlog.
    fn idle(a: mut Agent, ms: u64) -> bool {
        let start = unsafe { Instant.now() }
        loop {
            let spent = unsafe { Instant.now() }.nanos_since(start) / 1000000
            if spent >= ms { return false }
            let m = a.next(ms - spent) else continue
            if method(m.copy()) == "session/cancel" { return true }
            a.backlog.push(m)
        }
    }

    // Asks the client's permission for a tool call. Gives whether it was
    // allowed, or none if the turn was cancelled first.
    fn ask(a: mut Agent, session: String, tool: String, tool_kind: String, title: String, raw: Json) -> bool? {
        a.next_id += 1
        let id = a.next_id
        var call = LinkedMap<String, Json>()
        call.insert("toolCallId", js(tool))
        call.insert("title", js(title))
        call.insert("kind", js(tool_kind))
        if raw != Json.Null {
            if let p = raw.get(String("path")) {
                var place = LinkedMap<String, Json>()
                place.insert("path", p.copy())
                call.insert("locations", Json.Array([Json.Object(place)]))
            }
            call.insert("rawInput", raw.copy())
        }
        var options = List<Json>()
        for kind in "allow_once allow_always reject_once reject_always".split(" ") {
            var o = LinkedMap<String, Json>()
            o.insert("optionId", js(kind.copy()))
            o.insert("name", js(kind.replace("_", " ")))
            o.insert("kind", js(kind.copy()))
            options.push(Json.Object(o))
        }
        var p = LinkedMap<String, Json>()
        p.insert("sessionId", js(session))
        p.insert("toolCall", Json.Object(call))
        p.insert("options", Json.Array(options))
        var m = LinkedMap<String, Json>()
        m.insert("jsonrpc", js(String("2.0")))
        m.insert("id", int(id))
        m.insert("method", js(String("session/request_permission")))
        m.insert("params", Json.Object(p))
        emit(Json.Object(m))
        loop {
            let reply = a.next(1000) else continue
            if method(reply.copy()) == "session/cancel" { return none }
            if (reply.get(String("id")) ?? Json.Null).as_i64() != some(id) or reply.get(String("method")) != none {
                a.backlog.push(reply)
                continue
            }
            let outcome = reply.pointer(String("/result/outcome/outcome")) ?? Json.Null
            if outcome.as_str() != some(String("selected")) { return none }
            let option = (reply.pointer(String("/result/outcome/optionId")) ?? Json.Null).as_str() ?? String()
            return some(option.starts_with("allow"))
        }
    }

    // The session's MCP servers but loom's own, one a line.
    fn servers(a: Agent, session: String) -> String {
        var lines = List<String>()
        var servers = Json.Null
        if let s = a.mcp.find(session.copy()) { servers = s.copy() }
        if let Json.Array(list) = servers {
            for s in list {
                let name = (s.get(String("name")) ?? Json.Null).as_str() ?? String()
                if name == "loom" { continue }
                var line = name.copy()
                if let address = (s.get(String("url")) ?? Json.Null).as_str() {
                    line = "{line} {address}"
                } else {
                    line = "{line} {(s.get(String("command")) ?? Json.Null).as_str() ?? String()}"
                    if let Json.Array(xs) = s.get(String("args")) ?? Json.Null {
                        for x in xs {
                            line = "{line} {x.as_str() ?? String()}"
                        }
                    }
                }
                let pairs = s.get(String("env")) ?? s.get(String("headers")) ?? Json.Null
                if let Json.Array(vars) = pairs {
                    for v in vars {
                        line = "{line} {(v.get(String("name")) ?? Json.Null).as_str() ?? String()}={(v.get(String("value")) ?? Json.Null).as_str() ?? String()}"
                    }
                }
                lines.push(line)
            }
        }
        return if lines.len() == 0 { String("no servers") } else { lines.join("\n") }
    }

    // Calls `tool` of loom's own MCP server, as a real agent would: starts the
    // server the session was given, says initialize, then tools/call (or
    // tools/list for "list"). Gives what to say.
    fn call_loom(a: Agent, session: String, tool: String, args: String) -> String {
        let child = match a.start_loom(session) {
            ok(ch) => ch,
            err(e) => return "{e}",
        }
        let said = a.talk_to(child, 2, tool.copy(), args)
        child.kill()
        return said
    }

    // The same through the loom mcp the session keeps, started and initialized
    // at its first call.
    fn call_kept(a: mut Agent, session: String, tool: String, args: String) -> String {
        let child = match a.kept.remove(session.copy()) {
            some(ch) => ch,
            none => match a.start_loom(session.copy()) {
                ok(ch) => ch,
                err(e) => return "{e}",
            },
        }
        a.kept_id += 1
        let said = a.talk_to(child, a.kept_id, tool, args)
        a.kept.insert(session.copy(), child)
        return said
    }

    // Starts the loom mcp the session was given, and says initialize.
    fn start_loom(a: Agent, session: String) -> Child ! Error {
        var found = Json.Null
        var servers = Json.Null
        if let s = a.mcp.find(session.copy()) { servers = s.copy() }
        if let Json.Array(list) = servers {
            for s in list {
                if (s.get(String("name")) ?? Json.Null).as_str() == some(String("loom")) { found = s.copy() }
            }
        }
        if found == Json.Null { fail "no loom MCP server in this session" }
        var c = Command.new((found.get(String("command")) ?? Json.Null).as_str() ?? String())
        if let Json.Array(list) = found.get(String("args")) ?? Json.Null {
            for x in list {
                c = c.arg(x.as_str() ?? String())
            }
        }
        if let Json.Array(vars) = found.get(String("env")) ?? Json.Null {
            for v in vars {
                c = c.env((v.get(String("name")) ?? Json.Null).as_str() ?? String(), (v.get(String("value")) ?? Json.Null).as_str() ?? String())
            }
        }
        let child = match c.stdin(Stdio.Pipe).stdout(Stdio.Pipe).spawn() {
            ok(ch) => ch,
            err(e) => fail "loom mcp didn't start: {e}",
        }
        let init = String(#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"fake-agent","version":"1"}}}"#)
        if let err(e) = child.write_text("{init}\n") { fail "loom mcp: {e}" }
        if child.wait_for_line(String("\"id\":1"), 60000) == none { fail "loom mcp didn't answer initialize" }
        let initialized = String(#"{"jsonrpc":"2.0","method":"notifications/initialized"}"#)
        if let err(e) = child.write_text("{initialized}\n") { fail "loom mcp: {e}" }
        return child
    }

    fn talk_to(a: Agent, child: Child, n: i64, tool: String, args: String) -> String {
        _ = a
        let arguments = match parse(args.copy()) {
            ok(j) => j,
            err(_) => return "the arguments aren't JSON: {args}",
        }
        var p = LinkedMap<String, Json>()
        p.insert("name", js(tool.copy()))
        p.insert("arguments", arguments)
        var m = LinkedMap<String, Json>()
        m.insert("jsonrpc", js(String("2.0")))
        m.insert("id", int(n))
        let listing = tool == "list" or tool == "hints"
        m.insert("method", js(if listing { String("tools/list") } else { String("tools/call") }))
        m.insert("params", Json.Object(p))
        if let err(e) = child.write_text("{Json.Object(m)}\n") { return "loom mcp: {e}" }
        let line = child.wait_for_line("\"id\":{n},", 300000) else return String("loom mcp didn't answer in 5 minutes")
        let answer = match parse(line) {
            ok(j) => j,
            err(_) => return String("loom mcp's answer isn't JSON"),
        }
        let result = answer.get(String("result")) ?? Json.Null
        if tool == "list" {
            var names = List<String>()
            if let Json.Array(tools) = result.get(String("tools")) ?? Json.Null {
                for t in tools {
                    names.push((t.get(String("name")) ?? Json.Null).as_str() ?? String())
                }
            }
            return "tools: {names.join(", ")}"
        }
        if tool == "hints" {
            var lines = List<String>()
            if let Json.Array(tools) = result.get(String("tools")) ?? Json.Null {
                for t in tools {
                    lines.push("{(t.get(String("name")) ?? Json.Null).as_str() ?? String()} {t.get(String("annotations")) ?? Json.Null}")
                }
            }
            return lines.join("\n")
        }
        var text = String()
        if let Json.Array(content) = result.get(String("content")) ?? Json.Null {
            for c in content {
                if (c.get(String("type")) ?? Json.Null).as_str() == some(String("image")) {
                    text.push_str("[image {(c.get(String("mimeType")) ?? Json.Null).as_str() ?? String()}] ")
                }
                text.push_str((c.get(String("text")) ?? Json.Null).as_str() ?? String())
            }
        }
        let failed = (result.get(String("isError")) ?? Json.Null) == Json.Bool(true)
        return if failed { "{tool} failed: {text}" } else { "{tool}: {text}" }
    }

    // Plays one session/prompt. The stopReason, or none if it answered with
    // an error.
    fn turn(a: mut Agent, id: Json, params: Json) {
        let session = (params.get(String("sessionId")) ?? Json.Null).as_str() ?? String()
        var text = String()
        var got = List<String>()
        var context = String()
        if let Json.Array(blocks) = params.get(String("prompt")) ?? Json.Null {
            for b in blocks {
                let kind = (b.get(String("type")) ?? Json.Null).as_str() ?? String()
                if kind == "image" {
                    got.push("image {(b.get(String("mimeType")) ?? Json.Null).as_str() ?? String()}")
                } else if kind == "resource_link" {
                    let name = (b.get(String("name")) ?? Json.Null).as_str() ?? String()
                    let found = fs.exists(path_of((b.get(String("uri")) ?? Json.Null).as_str() ?? String()))
                    got.push(if found { "link {name}" } else { "missing {name}" })
                } else if let t = (b.get(String("text")) ?? Json.Null).as_str() {
                    // What loom says about where the person is, not a step.
                    if t.starts_with("[loom:") {
                        if context.len() > 0 { context.push_str("\n") }
                        context.push_str(t)
                        continue
                    }
                    if text.len() > 0 { text.push_str("\n") }
                    text.push_str(t)
                }
            }
        }
        var slow: u64 = 0
        var reason = String("end_turn")
        var tokens: i64 = 0
        for step in script(text) {
            match step {
                Step.Say(s) => {
                    for c in chunks(s) {
                        chunk(session.copy(), "agent_message_chunk", c)
                        if slow > 0 and a.idle(slow) { reason = String("cancelled"); break }
                    }
                },
                Step.Think(s) => chunk(session.copy(), "agent_thought_chunk", s),
                Step.Plan(entries) => {
                    var list = List<Json>()
                    for e in entries {
                        var o = LinkedMap<String, Json>()
                        o.insert("content", js(e))
                        o.insert("priority", js(String("medium")))
                        o.insert("status", js(String("pending")))
                        list.push(Json.Object(o))
                    }
                    var u = LinkedMap<String, Json>()
                    u.insert("sessionUpdate", js(String("plan")))
                    u.insert("entries", Json.Array(list))
                    update(session.copy(), u)
                },
                Step.Tool(title) => {
                    let tool = a.tool_call(session.copy(), String("execute"), title.copy())
                    tool_update(session.copy(), tool.copy(), "in_progress", String())
                    tool_update(session.copy(), tool, "completed", "ran: {title}")
                },
                Step.SelfPrompt => chunk(session.copy(), "user_message_chunk", String("Look into the spoons.")),
                Step.Subagent(title, inner) => {
                    let task = a.tool_call(session.copy(), String("think"), title)
                    tool_update(session.copy(), task.copy(), "in_progress", String())
                    a.subagent(session.copy(), task.copy(), inner)
                    tool_update(session.copy(), task, "completed", String("The subagent is done."))
                },
                Step.Named(title) => {
                    let tool = a.tool_call(session.copy(), String("execute"), String("Terminal"))
                    var u = tool_update_of(tool, "completed", String("ran"))
                    u.insert("title", js(title))
                    update(session.copy(), u)
                },
                Step.AskOnly(title) => {
                    let tool = a.new_tool()
                    match a.ask(session.copy(), tool.copy(), String("execute"), title.copy(), Json.Null) {
                        some(true) => tool_update(session.copy(), tool, "completed", "ran: {title}"),
                        some(false) => tool_update(session.copy(), tool, "failed", String("denied")),
                        none => {
                            tool_update(session.copy(), tool, "failed", String("cancelled"))
                            reason = String("cancelled")
                        },
                    }
                },
                Step.Open(title) => {
                    let tool = a.tool_call(session.copy(), String("execute"), title)
                    tool_update(session.copy(), tool, "in_progress", String())
                },
                Step.AskOpen(input) => {
                    let raw = match parse(input.copy()) {
                        ok(j) => j,
                        err(_) => Json.Null,
                    }
                    let title = (raw.get(String("title")) ?? Json.Null).as_str() ?? String("Run a command")
                    let tool = a.new_tool()
                    match a.ask(session.copy(), tool, String("execute"), title, raw) {
                        some(true) => chunk(session.copy(), "agent_message_chunk", String("allowed")),
                        some(false) => chunk(session.copy(), "agent_message_chunk", String("denied")),
                        none => reason = String("cancelled"),
                    }
                },
                Step.Shell(input) => {
                    let raw = match parse(input.copy()) {
                        ok(j) => j,
                        err(_) => Json.Null,
                    }
                    let tool = a.tool_call(session.copy(), String("execute"), String("Terminal"))
                    var u = LinkedMap<String, Json>()
                    u.insert("sessionUpdate", js(String("tool_call_update")))
                    u.insert("toolCallId", js(tool.copy()))
                    u.insert("title", js((raw.get(String("command")) ?? Json.Null).as_str() ?? String("Terminal")))
                    u.insert("kind", js(String("execute")))
                    u.insert("rawInput", raw)
                    update(session.copy(), u)
                    tool_update(session.copy(), tool, "completed", String("ran"))
                },
                Step.Ask(kind, title) => {
                    let tool = a.tool_call(session.copy(), kind.copy(), title.copy())
                    match a.ask(session.copy(), tool.copy(), kind.copy(), title.copy(), Json.Null) {
                        some(true) => {
                            tool_update(session.copy(), tool.copy(), "in_progress", String())
                            tool_update(session.copy(), tool, "completed", "ran: {title}")
                        },
                        some(false) => tool_update(session.copy(), tool, "failed", String("denied")),
                        none => {
                            tool_update(session.copy(), tool, "failed", String("cancelled"))
                            reason = String("cancelled")
                        },
                    }
                },
                Step.Act(kind, input) => {
                    let raw = match parse(input.copy()) {
                        ok(j) => j,
                        err(_) => Json.Null,
                    }
                    let title = (raw.get(String("title")) ?? Json.Null).as_str() ?? kind.copy()
                    let tool = a.tool_call(session.copy(), kind.copy(), title.copy())
                    let said = match a.ask(session.copy(), tool.copy(), kind.copy(), title, raw) {
                        some(true) => {
                            tool_update(session.copy(), tool, "completed", String("ran"))
                            "allowed"
                        },
                        some(false) => {
                            tool_update(session.copy(), tool, "failed", String("denied"))
                            "denied"
                        },
                        none => {
                            tool_update(session.copy(), tool, "failed", String("cancelled"))
                            reason = String("cancelled")
                            "cancelled"
                        },
                    }
                    chunk(session.copy(), "agent_message_chunk", String(said))
                },
                Step.Slow(ms) => slow = ms,
                Step.Sleep(ms) => {
                    if a.idle(ms) { reason = String("cancelled") }
                },
                Step.Stop(r) => reason = r.copy(),
                Step.Tokens(n) => tokens = n,
                Step.Fail(message) => {
                    respond_error(id, -32603, message)
                    return
                },
                Step.Crash => {
                    eprintln("fake agent: crashing, as the prompt asked")
                    exit(3)
                },
                Step.Files => chunk(session.copy(), "agent_message_chunk", if got.len() == 0 { String("no files") } else { got.join(", ") }),
                Step.Session => chunk(session.copy(), "agent_message_chunk", "session {session}"),
                Step.Uptime => chunk(session.copy(), "agent_message_chunk", "up {unsafe { Instant.now() }.nanos_since(a.born) / 1000000} ms"),
                Step.Env(name) => chunk(session.copy(), "agent_message_chunk", "{name}={env.variable(name.copy()) ?? String()}"),
                Step.Net(target) => chunk(session.copy(), "agent_message_chunk", reach(target)),
                Step.Servers => chunk(session.copy(), "agent_message_chunk", a.servers(session.copy())),
                Step.Usage(used, size) => {
                    var u = LinkedMap<String, Json>()
                    u.insert("sessionUpdate", js(String("usage_update")))
                    u.insert("used", int(used))
                    u.insert("size", int(size))
                    update(session.copy(), u)
                },
                Step.Config => {
                    let values = a.values(session.copy())
                    chunk(session.copy(), "agent_message_chunk", "model={value_of(values.copy(), "model")} effort={value_of(values, "effort")}")
                },
                Step.Meta => {
                    var meta = Json.Null
                    if let m = a.meta.find(session.copy()) { meta = m.copy() }
                    chunk(session.copy(), "agent_message_chunk", if meta == Json.Null { String("no meta") } else { "meta {meta}" })
                },
                Step.Context => chunk(session.copy(), "agent_message_chunk", if context.len() > 0 { context.copy() } else { String("no context") }),
                Step.Mcp(tool, args) => chunk(session.copy(), "agent_message_chunk", a.call_loom(session.copy(), tool, args)),
                Step.McpKeep(tool, args) => chunk(session.copy(), "agent_message_chunk", a.call_kept(session.copy(), tool, args)),
                Step.Link(path) => {
                    var content = LinkedMap<String, Json>()
                    content.insert("type", js(String("resource_link")))
                    content.insert("uri", js("file://{path}"))
                    content.insert("name", js(String("linked.txt")))
                    content.insert("mimeType", js(String("text/plain")))
                    var u = LinkedMap<String, Json>()
                    u.insert("sessionUpdate", js(String("agent_message_chunk")))
                    u.insert("content", Json.Object(content))
                    update(session.copy(), u)
                },
                Step.Image => {
                    var content = LinkedMap<String, Json>()
                    content.insert("type", js(String("image")))
                    content.insert("mimeType", js(String("image/png")))
                    content.insert("data", js(bytes.base64(Image.new(8, 8, Kind.Rgb, Color.rgb(24, 56, 208)).encode_png())))
                    var u = LinkedMap<String, Json>()
                    u.insert("sessionUpdate", js(String("agent_message_chunk")))
                    u.insert("content", Json.Object(content))
                    update(session.copy(), u)
                },
            }
            if reason != "end_turn" { break }
        }
        var r = LinkedMap<String, Json>()
        r.insert("stopReason", js(reason))
        if tokens > 0 {
            var usage = LinkedMap<String, Json>()
            usage.insert("inputTokens", int(tokens / 2))
            usage.insert("outputTokens", int(tokens - tokens / 2))
            usage.insert("totalTokens", int(tokens))
            r.insert("usage", Json.Object(usage))
        }
        respond(id, Json.Object(r))
    }

    // Session `session`'s config values: its own, or the defaults (a session
    // picked up after the agent restarted).
    fn values(a: Agent, session: String) -> Map<String, String> {
        if let v = a.config.find(session) { return v.copy() }
        return config_default()
    }

    fn handle(a: mut Agent, m: Json) {
        let name = method(m.copy())
        let id = m.get(String("id"))
        let params = m.get(String("params")) ?? Json.Null
        if name == "initialize" and a.picks_up == "broken" {
            respond_error(id ?? Json.Null, -32603, String("the fake agent is broken"))
        } else if name == "initialize" {
            var prompt = LinkedMap<String, Json>()
            prompt.insert("image", Json.Bool(true))
            prompt.insert("audio", Json.Bool(false))
            prompt.insert("embeddedContext", Json.Bool(false))
            var caps = LinkedMap<String, Json>()
            caps.insert("loadSession", Json.Bool(a.picks_up == "load" or a.picks_up == "forget"))
            if a.picks_up == "resume" {
                var resume = LinkedMap<String, Json>()
                resume.insert("resume", Json.Object(LinkedMap<String, Json>()))
                caps.insert("sessionCapabilities", Json.Object(resume))
            }
            caps.insert("promptCapabilities", Json.Object(prompt))
            // It takes MCP servers over HTTP, as claude-agent-acp does.
            var mcp = LinkedMap<String, Json>()
            mcp.insert("http", Json.Bool(true))
            mcp.insert("sse", Json.Bool(false))
            caps.insert("mcpCapabilities", Json.Object(mcp))
            var info = LinkedMap<String, Json>()
            info.insert("name", js(String("fake-agent")))
            info.insert("version", js(String("1")))
            var r = LinkedMap<String, Json>()
            r.insert("protocolVersion", int(1))
            r.insert("agentCapabilities", Json.Object(caps))
            r.insert("agentInfo", Json.Object(info))
            r.insert("authMethods", Json.Array(List<Json>()))
            respond(id ?? Json.Null, Json.Object(r))
        } else if name == "session/new" {
            a.sessions += 1
            var r = LinkedMap<String, Json>()
            let new_id = "fake_{a.stamp}_{a.sessions}"
            a.mcp.insert(new_id.copy(), params.get(String("mcpServers")) ?? Json.Null)
            a.meta.insert(new_id.copy(), params.get(String("_meta")) ?? Json.Null)
            a.config.insert(new_id.copy(), config_default())
            r.insert("configOptions", config_options(config_default()))
            r.insert("sessionId", js(new_id))
            respond(id ?? Json.Null, Json.Object(r))
        } else if name == "session/set_config_option" {
            let session = (params.get(String("sessionId")) ?? Json.Null).as_str() ?? String()
            let option = (params.get(String("configId")) ?? Json.Null).as_str() ?? String()
            let value = (params.get(String("value")) ?? Json.Null).as_str() ?? String()
            if not offered(option.copy()).contains(value.copy()) {
                respond_error(id ?? Json.Null, -32602, "no {option} {value}")
                return
            }
            var values = a.values(session.copy())
            values.insert(option, value)
            a.config.insert(session, values.copy())
            var r = LinkedMap<String, Json>()
            r.insert("configOptions", config_options(values))
            respond(id ?? Json.Null, Json.Object(r))
        } else if name == "session/load" or name == "session/resume" {
            let session = (params.get(String("sessionId")) ?? Json.Null).as_str() ?? String()
            if a.picks_up == "forget" or not session.starts_with("fake_") {
                respond_error(id ?? Json.Null, -32002, "no session {session}")
                return
            }
            a.mcp.insert(session.copy(), params.get(String("mcpServers")) ?? Json.Null)
            a.meta.insert(session.copy(), params.get(String("_meta")) ?? Json.Null)
            // session/load plays the conversation back first; session/resume doesn't.
            if name == "session/load" { chunk(session.copy(), "agent_message_chunk", String("(the conversation so far)")) }
            var r = LinkedMap<String, Json>()
            r.insert("configOptions", config_options(a.values(session)))
            respond(id ?? Json.Null, Json.Object(r))
        } else if name == "session/prompt" and a.picks_up == "limited" {
            respond_error(id ?? Json.Null, -32000, String("You've hit your usage limit. Try again in 3 hours."))
        } else if name == "session/prompt" {
            a.turn(id ?? Json.Null, params)
        } else if let i = id {
            if name.len() > 0 { respond_error(i, -32601, "method not found: {name}") }
        }
        // Notifications it doesn't know, such as a session/cancel with no turn
        // running, and stray responses, are dropped.
    }
}

fn method(m: Json) -> String {
    return (m.get(String("method")) ?? Json.Null).as_str() ?? String()
}

fn main() {
    let inbox = Receiver<String>()
    let reader = Reader { out: inbox.sender() }
    _ = unsafe { Thread.spawn(reader) }
    let given = env.args()
    let picks_up = if given.len() > 0 { given[0].replace("--", "") } else { String() }
    var a = Agent { inbox: inbox, sessions: 0, next_id: 0, tools: 0, picks_up: picks_up, mcp: Map<String, Json>(), meta: Map<String, Json>(), stamp: bytes.hex(random_bytes(3)), backlog: List<Json>(), config: Map<String, Map<String, String>>(), kept: Map<String, Child>(), kept_id: 1, born: unsafe { Instant.now() } }
    loop {
        if a.backlog.len() > 0 {
            let m = a.backlog.remove(0)
            a.handle(m)
            continue
        }
        let line = a.inbox.wait() else return
        match parse(line.copy()) {
            ok(m) => a.handle(m),
            err(e) => eprintln("fake agent: not JSON ({e}): {line}"),
        }
    }
}

@test
fn plain_lines_are_said() {
    let steps = script(String("hello there\n\n/say again"))
    assert(steps.len() == 2)
    assert(steps[0] == Step.Say(String("hello there")))
    assert(steps[1] == Step.Say(String("again")))
}

@test
fn reads_every_step() {
    let steps = script(String("/think hmm\n/plan a; b ;\n/tool ls\n/ask rm x\n/slow 5\n/sleep 10\n/stop max_tokens\n/fail no\n/crash"))
    assert(steps.len() == 9)
    let entries: List<String> = [String("a"), String("b")]
    assert(steps[1] == Step.Plan(entries))
    assert(steps[3] == Step.Ask(String("execute"), String("rm x")))
    assert(steps[5] == Step.Sleep(10))
    assert(steps[6] == Step.Stop(String("max_tokens")))
    assert(steps[8] == Step.Crash)
}

@test
fn reads_a_subagents_steps() {
    let steps = script(String("/subagent Explore the notes; /tool Read notes.md ; Three notes. ;\n/named Save it\n/askonly rm x"))
    assert(steps.len() == 3)
    let inner: List<String> = [String("/tool Read notes.md"), String("Three notes.")]
    assert(steps[0] == Step.Subagent(String("Explore the notes"), inner))
    assert(steps[1] == Step.Named(String("Save it")))
    assert(steps[2] == Step.AskOnly(String("rm x")))
}

@test
fn chunks_keep_their_spaces() {
    let c = chunks(String("one two three"))
    assert(c.len() == 3)
    assert(c[0] == "one " and c[2] == "three")
}

// The path a file:// URI names: file:///C:/x is C:/x on Windows.
fn path_of(uri: String) -> String {
    if not uri.starts_with("file://") { return uri.copy() }
    let path = url.decode(uri[7..].copy())
    if path.len() > 2 and path.starts_with("/") and path[2..].starts_with(":") { return path[1..].copy() }
    return path
}

fn value_of(values: Map<String, String>, key: str) -> String {
    if let v = values.find(String(key)) { return v.copy() }
    return String()
}
