module tests.fake_mcp.main

// A fake MCP server, for testing Code Mode (PLAN.md, "Code Mode") and the
// versions of MCP loom speaks (PLAN.md, "MCP versions") without a real one. It
// speaks MCP over standard input and output, one message a line, and offers
// three tools:
//
//     echo {text}         gives {said: text} as structured content; only reads
//     add {a, b}          gives a + b, whole numbers, as text; changes something, so it asks
//     key_length          says how long its FAKE_KEY environment variable is,
//                         so a test sees the key reached the server, not the script
//
// Its serverInfo gives the icons FAKE_ICON names (`icons`).
//
// With FAKE_GROW set, it says its tools change (`listChanged`) and offers
// `grow`, after whose answer it offers `grown` too and says so with
// notifications/tools/list_changed: in the legacy era at once, and in the
// modern era on a subscriptions/listen stream that asked for it, which it
// acknowledges first.
//
// FAKE_ERA says which era of MCP it speaks. Unset, it's of the legacy era,
// answering initialize in 2025-06-18 and any other request with `{}`, as it
// always has. Set, it's one of these, and offers three tools more: `spoke`,
// which says the version of MCP its call came in, `region {region}`, which
// says the Mcp-Param-Region header it was given (`none` over stdio), and
// `header_bad`, whose x-mcp-header breaks MCP's rules, so loom leaves it out
// over HTTP in the modern era.
//
//     legacy   initialize, in the version asked for when it's 2025-11-25 to
//              2024-11-05, or else 2025-11-25; server/discover is a method it
//              doesn't know, and anything else before initialize an error
//     old      the same, but only ever 2025-03-26
//     odd      the same, but answering initialize in 2024-01-01, which isn't MCP's
//     silent   legacy, saying nothing to a request before initialize
//     exits    legacy, stopping at a request before initialize
//     modern   only 2026-07-28: a request says its version in _meta, and
//              initialize is a method it doesn't know
//     dual     both, as each request comes
//     newer    a version of the modern era loom doesn't speak, 2027-01-01, and
//              2025-11-25 after initialize
//     slow     modern, but it reads nothing for its first 6 seconds, as a
//              server whose package is fetched first
//
// With --http it's a server over Streamable HTTP at /mcp instead, listening on
// 127.0.0.1, and prints `fake mcp: URL` once it is. In the legacy era it gives
// a session at initialize (Mcp-Session-Id) and wants it after; in the modern
// era it checks a request's headers match its body (MCP-Protocol-Version,
// Mcp-Method, Mcp-Name, and region's Mcp-Param-Region), answering 400 with
// HeaderMismatch where they don't. With FAKE_GROW, it answers a
// subscriptions/listen with an event stream that stays open, acknowledged
// first, and sends its tool changes on each such stream that's open. GET
// /test/stats says how many initialize, server/discover, mismatched and
// subscriptions/listen requests it had, how many of those streams are open,
// and the Authorization the last of them came with; /test/rename names
// region's header Zone from then on; /test/grow?name=NAME offers a tool NAME
// more, and says so; /test/drop ends every stream, as a server that went away
// would.
//
// It ends when its input does. It needs only the standard library, since loom
// mcp starts it from an agent's folder.
//
//     calx tests/fake_mcp/main.calx [--http]
import std.bytes
import std.env
import std.http.server.{EventStream, Request, Response, Server}
import std.image.{Color, Image, Kind}
import std.io
import std.json.{Json, parse}
import std.process.{exit}
import std.thread.{sleep}
import std.url

const MODERN: str = "2026-07-28"
const LEGACY: [str; 4] = ["2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"]
const NEWER: str = "2027-01-01"

fn text(s: str) -> Json {
    return Json.Str(String(s))
}

fn object(pairs: List<(str, Json)>) -> Json {
    var m = LinkedMap<String, Json>()
    for (k, v) in pairs {
        m.insert(String(k), v.copy())
    }
    return Json.Object(m)
}

fn strings(xs: List<String>) -> Json {
    var out = List<Json>()
    for x in xs {
        out.push(Json.Str(x.copy()))
    }
    return Json.Array(out)
}

fn str_of(j: Json, key: str) -> String {
    return (j.get(String(key)) ?? Json.Null).as_str() ?? String()
}

fn prop(kind: str, about: str) -> Json {
    return object([("type", text(kind)), ("description", text(about))])
}

fn schema(props: List<(str, Json)>, required: List<str>) -> Json {
    var names = List<Json>()
    for r in required {
        names.push(text(r))
    }
    return object([("type", text("object")), ("properties", object(props)), ("required", Json.Array(names))])
}

fn tool(name: str, about: str, input: Json, reads: bool) -> Json {
    return object([("name", text(name)), ("description", text(about)), ("inputSchema", input.copy()), ("annotations", object([("readOnlyHint", Json.Bool(reads))]))])
}

fn content(said: String) -> Json {
    return Json.Array([object([("type", text("text")), ("text", Json.Str(said.copy()))])])
}

fn number(j: Json) -> i64 {
    return match j {
        Json.Int(n) => n,
        _ => 0,
    }
}

// The picture an icon is, as a test makes it too: 64 pixels a side, in one colour.
fn picture(r: u8, g: u8, b: u8) -> List<u8> {
    return Image.new(64, 64, Kind.Rgba, Color.rgba(r, g, b, 255)).encode_png()
}

fn data_uri(mime: str, data: List<u8>) -> Json {
    return Json.Str("data:{mime};base64,{bytes.base64(data)}")
}

fn icon(src: own Json, mime: str, theme: str) -> Json {
    var pairs: List<(str, Json)> = [("src", src), ("mimeType", text(mime)), ("sizes", Json.Array([text("64x64")]))]
    if theme.len() > 0 { pairs.push(("theme", text(theme))) }
    return object(pairs)
}

// The icons its serverInfo gives, as FAKE_ICON says: `good` (one for a light
// background and one for a dark), `blue`, `bad` (not a picture), `huge` (over
// what loom fetches), `svg` (only an SVG), or none.
fn icons() -> Json {
    let which = env.variable(String("FAKE_ICON")) ?? String()
    if which == "good" { return Json.Array([icon(data_uri("image/png", picture(220, 80, 40)), "image/png", ""), icon(data_uri("image/png", picture(240, 240, 240)), "image/png", "dark")]) }
    if which == "blue" { return Json.Array([icon(data_uri("image/png", picture(30, 90, 220)), "image/png", "")]) }
    if which == "bad" { return Json.Array([icon(data_uri("image/png", "not a picture".to_bytes()), "image/png", "")]) }
    if which == "huge" {
        var big = picture(0, 0, 0)
        while big.len() < 300000 {
            big.push(0)
        }
        return Json.Array([icon(data_uri("image/png", big), "image/png", "")])
    }
    if which == "svg" { return Json.Array([icon(data_uri("image/svg+xml", "<svg xmlns='http://www.w3.org/2000/svg'/>".to_bytes()), "image/svg+xml", "")]) }
    return Json.Array(List<Json>())
}

fn server_info() -> Json {
    return object([("name", text("fake")), ("version", text("1")), ("icons", icons())])
}

fn result(id: own Json, r: own Json) -> Json {
    return object([("jsonrpc", text("2.0")), ("id", id), ("result", r)])
}

fn error(id: own Json, code: i64, message: own String, data: own Json) -> Json {
    var e: List<(str, Json)> = [("code", Json.Int(code)), ("message", Json.Str(message))]
    if data != Json.Null { e.push(("data", data)) }
    return object([("jsonrpc", text("2.0")), ("id", id), ("error", object(e))])
}

// `r` as a result of the modern era: final, from this server, and for a list
// stale at once.
fn modern(r: Json, list: bool) -> Json {
    var m = LinkedMap<String, Json>()
    m.insert(String("resultType"), text("complete"))
    if let Json.Object(members) = r {
        for (k, v) in members {
            m.insert(k.copy(), v.copy())
        }
    }
    if list {
        m.insert(String("ttlMs"), Json.Int(0))
        m.insert(String("cacheScope"), text("private"))
    }
    m.insert(String("_meta"), object([("io.modelcontextprotocol/serverInfo", server_info())]))
    return Json.Object(m)
}

// A header's value, as MCP's Base64 sentinel `=?base64?…?=` carries one that
// isn't plain ASCII.
fn decoded(value: String) -> String {
    if not (value.starts_with("=?base64?") and value.ends_with("?=")) { return value.copy() }
    let inner = value[9..value.len() - 2].copy()
    return String.from_utf8(bytes.from_base64(inner) ?? List<u8>()) ?? String()
}

struct Fake {
    era: String
    spoken: String    // the version initialize settled, or nothing before it
    zone: bool    // whether region's header is named Zone (/test/rename)
    session: String    // over HTTP in the legacy era, the session initialize gave
    minted: bool    // whether the answer being made gives a session
    initialized: i64
    discovered: i64
    mismatched: i64
    grows: bool    // FAKE_GROW
    grown: bool    // whether `grow` was called
    listening: Json    // the id of a subscriptions/listen for tool changes, or null
    said: List<Json>    // notifications to write after the answer being made
    extra: List<String>    // over HTTP, the tools /test/grow added
    news: bool    // over HTTP, whether its tools changed since its streams were told
    listens: i64    // over HTTP, the subscriptions/listen it had
    listen_auth: String    // and the Authorization the last came with
}

impl Fake {
    // The versions of the modern era it speaks.
    fn modern_versions(self) -> List<String> {
        if self.era == "modern" or self.era == "slow" or self.era == "dual" { return [String(MODERN)] }
        if self.era == "newer" { return [String(NEWER)] }
        return List<String>()
    }

    // Whether it speaks the legacy era.
    fn speaks_legacy(self) -> bool {
        return self.era != "modern" and self.era != "slow"
    }

    // Every version it speaks, as its errors name them.
    fn all_versions(self) -> List<String> {
        var out = self.modern_versions()
        if self.speaks_legacy() { out.push(String(LEGACY[0])) }
        return out
    }

    fn header_name(self) -> String {
        return if self.zone { String("Zone") } else { String("Region") }
    }

    fn tools(self) -> Json {
        let echo = tool("echo", "Says the text back.", schema([("text", prop("string", "What to say back."))], ["text"]), true)
        let add = tool("add", "Adds two numbers, and keeps the sum.", schema([("a", prop("integer", "The first.")), ("b", prop("integer", "The second."))], ["a", "b"]), false)
        let key = tool("key_length", "Says how long the server's key is.", schema(List<(str, Json)>(), List<str>()), true)
        var list = [echo, add, key].to_list()
        if self.era.len() > 0 {
            list.push(tool("spoke", "Says the version of MCP it was called in.", schema(List<(str, Json)>(), List<str>()), true))
            let region = object([("type", text("string")), ("description", text("Where.")), ("x-mcp-header", Json.Str(self.header_name()))])
            list.push(tool("region", "Says the region it was given as a header.", schema([("region", region)], ["region"]), true))
            let bad = object([("type", text("number")), ("x-mcp-header", text("Amount"))])
            list.push(tool("header_bad", "Has a header MCP doesn't allow.", schema([("amount", bad)], List<str>()), true))
        }
        if self.grows {
            list.push(tool("grow", "Offers one tool more.", schema(List<(str, Json)>(), List<str>()), false))
            if self.grown { list.push(tool("grown", "Is there once grow was called.", schema(List<(str, Json)>(), List<str>()), true)) }
        }
        for name in self.extra {
            list.push(object([("name", Json.Str(name.copy())), ("description", text("Added by a test.")), ("inputSchema", schema(List<(str, Json)>(), List<str>())), ("annotations", object([("readOnlyHint", Json.Bool(true))]))]))
        }
        return object([("tools", Json.Array(list))])
    }

    // What its capabilities say of its tools.
    fn tools_capability(self) -> Json {
        if self.grows { return object([("tools", object([("listChanged", Json.Bool(true))]))]) }
        return object([("tools", object(List<(str, Json)>()))])
    }

    // After `grow`: notifications/tools/list_changed, to a client of the
    // legacy era, or on the stream a client of the modern era opened.
    fn grew(self: mut Fake, modern_era: bool) {
        self.grown = true
        self.news = true
        if not modern_era {
            self.said.push(object([("jsonrpc", text("2.0")), ("method", text("notifications/tools/list_changed"))]))
            return
        }
        if self.listening == Json.Null { return }
        let meta = object([("io.modelcontextprotocol/subscriptionId", self.listening.copy())])
        self.said.push(object([("jsonrpc", text("2.0")), ("method", text("notifications/tools/list_changed")), ("params", object([("_meta", meta)]))]))
    }

    fn call(self, params: Json, version: String, heard: Map<String, String>) -> Json {
        let name = str_of(params.copy(), "name")
        let args = params.get(String("arguments")) ?? Json.Null
        if name == "echo" {
            let said = str_of(args, "text")
            return object([("content", content(said.copy())), ("structuredContent", object([("said", Json.Str(said))]))])
        }
        if name == "add" {
            let sum = number(args.get(String("a")) ?? Json.Null) + number(args.get(String("b")) ?? Json.Null)
            return object([("content", content("{sum}"))])
        }
        if name == "key_length" {
            let key = env.variable(String("FAKE_KEY")) ?? String()
            return object([("content", content("{key.len()}"))])
        }
        if name == "spoke" { return object([("content", content(version))]) }
        if name == "grow" { return object([("content", content(String("grown")))]) }
        if name == "grown" { return object([("content", content(String("here")))]) }
        if name == "region" {
            let header = "mcp-param-{self.header_name().to_lower_root()}"
            let said = if let v = heard.find(header) { decoded(v.copy()) } else { String("none") }
            return object([("content", content(said))])
        }
        return object([("content", content("no tool {name}")), ("isError", Json.Bool(true))])
    }

    // Why a request of the modern era over HTTP is refused for its headers,
    // or nothing when they match its body.
    fn mismatch(self, method: String, params: Json, version: String, heard: Map<String, String>) -> String {
        let said_version = if let v = heard.find(String("mcp-protocol-version")) { v.copy() } else { String() }
        if said_version != version { return "MCP-Protocol-Version {said_version} isn't {version}" }
        let said_method = if let v = heard.find(String("mcp-method")) { v.copy() } else { String() }
        if said_method != method { return "Mcp-Method {said_method} isn't {method}" }
        if method != "tools/call" { return String() }
        let name = str_of(params.copy(), "name")
        let said_name = if let v = heard.find(String("mcp-name")) { decoded(v.copy()) } else { String() }
        if said_name != name { return "Mcp-Name {said_name} isn't {name}" }
        if name != "region" { return String() }
        let value = str_of(params.get(String("arguments")) ?? Json.Null, "region")
        let header = "mcp-param-{self.header_name().to_lower_root()}"
        let said = if let v = heard.find(header.copy()) { decoded(v.copy()) } else { String() }
        if said != value { return "{header} {said} isn't {value}" }
        return String()
    }

    // The answer to `m`, with the HTTP status it goes with, or none for a
    // notification. `heard` is its HTTP headers by lowercase name, over HTTP.
    fn answer(self: mut Fake, m: Json, http: bool, heard: Map<String, String>) -> (u16, Json?) {
        let id = m.get(String("id")) else return (202, none)
        let method = str_of(m.copy(), "method")
        let params = m.get(String("params")) ?? Json.Null
        if self.era.len() == 0 {
            // As it always was.
            if method == "initialize" { return (200, some(result(id, object([("protocolVersion", text("2025-06-18")), ("capabilities", self.tools_capability()), ("serverInfo", server_info())])))) }
            if method == "tools/list" { return (200, some(result(id, self.tools()))) }
            if method == "tools/call" {
                if str_of(params.copy(), "name") == "grow" { self.grew(false) }
                return (200, some(result(id, self.call(params, String("2025-06-18"), heard))))
            }
            return (200, some(result(id, object(List<(str, Json)>()))))
        }
        let meta = params.get(String("_meta")) ?? Json.Null
        let asked = meta.get(String("io.modelcontextprotocol/protocolVersion"))
        let versions = self.modern_versions()
        if let named = asked {
            if versions.len() > 0 { return self.answer_modern(id, method, params, named.as_str() ?? String(), http, heard) }
        }
        if method == "initialize" {
            if not self.speaks_legacy() { return (if http { 400 } else { 200 }, some(error(id, -32601, "This server speaks MCP {MODERN} only, which has no initialize", Json.Null))) }
            self.initialized += 1
            let wanted = str_of(params, "protocolVersion")
            var version = String(LEGACY[0])
            for v in LEGACY {
                if wanted == v { version = wanted.copy() }
            }
            if self.era == "old" { version = String("2025-03-26") }
            if self.era == "odd" { version = String("2024-01-01") }
            self.spoken = version.copy()
            if http {
                self.session = "s-{self.initialized}"
                self.minted = true
            }
            return (200, some(result(id, object([("protocolVersion", Json.Str(version)), ("capabilities", self.tools_capability()), ("serverInfo", server_info())]))))
        }
        if versions.len() > 0 and not self.speaks_legacy() {
            return (if http { 400 } else { 200 }, some(error(id, -32602, "A request says its version in _meta's io.modelcontextprotocol/protocolVersion", Json.Null)))
        }
        // The legacy era, before initialize or after.
        var ready = not http and self.spoken.len() > 0
        if let s = heard.find(String("mcp-session-id")) { ready = http and self.session.len() > 0 and s == self.session }
        if not ready {
            if http { return (400, some(error(id, -32000, String("Bad Request: Server not initialized"), Json.Null))) }
            if method == "server/discover" {
                if self.era == "silent" { return (200, none) }
                if self.era == "exits" { exit(3) }
                return (200, some(error(id, -32601, String("Method not found"), Json.Null)))
            }
            if self.era == "silent" { return (200, none) }
            return (200, some(error(id, -32000, String("Server not initialized"), Json.Null)))
        }
        if method == "tools/list" { return (200, some(result(id, self.tools()))) }
        if method == "tools/call" {
            if str_of(params.copy(), "name") == "grow" { self.grew(false) }
            return (200, some(result(id, self.call(params, self.spoken.copy(), heard))))
        }
        if method == "ping" { return (200, some(result(id, object(List<(str, Json)>())))) }
        return (if http { 404 } else { 200 }, some(error(id, -32601, String("Method not found"), Json.Null)))
    }

    fn answer_modern(self: mut Fake, id: own Json, method: String, params: Json, version: String, http: bool, heard: Map<String, String>) -> (u16, Json?) {
        let bad: u16 = if http { 400 } else { 200 }
        if not self.modern_versions().contains(version.copy()) {
            let data = object([("supported", strings(self.all_versions())), ("requested", Json.Str(version.copy()))])
            return (bad, some(error(id, -32022, String("Unsupported protocol version"), data)))
        }
        if http {
            let why = self.mismatch(method.copy(), params.copy(), version.copy(), heard.copy())
            if why.len() > 0 {
                self.mismatched += 1
                return (400, some(error(id, -32020, "Header mismatch: {why}", Json.Null)))
            }
        }
        if method == "server/discover" {
            self.discovered += 1
            return (200, some(result(id, modern(object([("supportedVersions", strings(self.all_versions())), ("capabilities", self.tools_capability())]), true))))
        }
        if method == "tools/list" { return (200, some(result(id, modern(self.tools(), true)))) }
        if method == "tools/call" {
            if str_of(params.copy(), "name") == "grow" { self.grew(true) }
            return (200, some(result(id, modern(self.call(params, version, heard), false))))
        }
        // A stream of the tool changes asked for, acknowledged first, and
        // never answered while it's open.
        if method == "subscriptions/listen" and self.grows and not http {
            let asked = (params.get(String("notifications")) ?? Json.Null).get(String("toolsListChanged")) == some(Json.Bool(true))
            if asked { self.listening = id.copy() }
            let agreed = if asked { object([("toolsListChanged", Json.Bool(true))]) } else { object(List<(str, Json)>()) }
            let meta = object([("io.modelcontextprotocol/subscriptionId", id)])
            self.said.push(object([("jsonrpc", text("2.0")), ("method", text("notifications/subscriptions/acknowledged")), ("params", object([("_meta", meta), ("notifications", agreed)]))]))
            return (200, none)
        }
        return (if http { 404 } else { 200 }, some(error(id, -32601, String("Method not found"), Json.Null)))
    }

    // Over HTTP, a subscriptions/listen for tool changes that's answered with
    // an event stream: its id, and the acknowledgement it starts with. none
    // for any other request, which `respond` answers.
    fn listen_over_http(self: mut Fake, req: Request) -> (Json, Json)? {
        if req.path != "/mcp" or req.method != "POST" or not self.grows or self.modern_versions().len() == 0 { return none }
        let m = match parse(req.text() ?? String()) {
            ok(j) => j,
            err(_) => return none,
        }
        let id = m.get(String("id")) else return none
        let method = str_of(m.copy(), "method")
        if method != "subscriptions/listen" { return none }
        let params = m.get(String("params")) ?? Json.Null
        let version = str_of((params.get(String("_meta")) ?? Json.Null), "io.modelcontextprotocol/protocolVersion")
        if not self.modern_versions().contains(version.copy()) { return none }
        var heard = Map<String, String>()
        for h in req.headers {
            heard.insert(h.name.to_lower_root(), h.value.copy())
        }
        if self.mismatch(method, params.copy(), version, heard.copy()).len() > 0 { return none }
        if (params.get(String("notifications")) ?? Json.Null).get(String("toolsListChanged")) != some(Json.Bool(true)) { return none }
        self.listens += 1
        self.listen_auth = if let a = heard.find(String("authorization")) { a.copy() } else { String() }
        let meta = object([("io.modelcontextprotocol/subscriptionId", id.copy())])
        let ack = object([("jsonrpc", text("2.0")), ("method", text("notifications/subscriptions/acknowledged")), ("params", object([("_meta", meta), ("notifications", object([("toolsListChanged", Json.Bool(true))]))]))])
        return some((id, ack))
    }

    fn respond(self: mut Fake, req: Request, open: i64) -> Response {
        if req.path == "/test/stats" {
            let stats = object([("initialized", Json.Int(self.initialized)), ("discovered", Json.Int(self.discovered)), ("mismatched", Json.Int(self.mismatched)), ("listens", Json.Int(self.listens)), ("open", Json.Int(open)), ("listen_auth", Json.Str(self.listen_auth.copy()))])
            return Response.new(200, String("application/json"), "{stats}".to_bytes())
        }
        if req.path == "/test/rename" {
            self.zone = true
            return Response.new(200, String("application/json"), "\{\}".to_bytes())
        }
        if req.path == "/test/grow" {
            for (k, v) in url.form_decode(req.query.copy()) {
                if k == "name" {
                    self.extra.push(v.copy())
                    self.news = true
                }
            }
            return Response.new(200, String("application/json"), "\{\}".to_bytes())
        }
        if req.path != "/mcp" { return Response.error(404) }
        if req.method != "POST" { return Response.error(405) }
        var heard = Map<String, String>()
        for h in req.headers {
            heard.insert(h.name.to_lower_root(), h.value.copy())
        }
        let m = match parse(req.text() ?? String()) {
            ok(j) => j,
            err(_) => return Response.error(400),
        }
        self.minted = false
        let (status, said) = self.answer(m, true, heard)
        let body = said else return Response.new(202, String("application/json"), List<u8>())
        let res = Response.new(status, String("application/json"), "{body}".to_bytes())
        if self.minted { return res.with_header(String("Mcp-Session-Id"), self.session.copy()) }
        return res
    }
}

fn serve_http(fake: mut Fake) ! Error {
    var server = try Server.listen(0)
    server.log = false
    println("fake mcp: {server.url().trim_suffix("/")}/mcp")
    io.flush()
    // The streams of tool changes open, each with its subscription's id.
    var streams = List<(EventStream, Json)>()
    loop {
        match server.next_event() {
            some(Request(req)) => {
                if req.path == "/test/drop" {
                    for (s, _) in streams {
                        server.end_stream(s)
                    }
                    streams = List<(EventStream, Json)>()
                    server.respond(req, Response.new(200, String("application/json"), "\{\}".to_bytes()))
                    continue
                }
                if let (id, ack) = fake.listen_over_http(req.copy()) {
                    let s = server.stream(req)
                    _ = server.send_event(s, "{ack}")
                    streams.push((s, id))
                } else {
                    let res = fake.respond(req.copy(), i64.wrap(streams.len()))
                    server.respond(req, res)
                }
                fake.said = List<Json>()
                if fake.news {
                    fake.news = false
                    for (s, id) in streams {
                        let meta = object([("io.modelcontextprotocol/subscriptionId", id.copy())])
                        _ = server.send_event(s, "{object([("jsonrpc", text("2.0")), ("method", text("notifications/tools/list_changed")), ("params", object([("_meta", meta)]))])}")
                    }
                }
            },
            some(Ended(gone)) => {
                var left = List<(EventStream, Json)>()
                for (s, id) in streams {
                    if s != gone { left.push((s, id.copy())) }
                }
                streams = left
            },
            _ => {},
        }
    }
}

fn main() ! Error {
    var fake = Fake { era: env.variable(String("FAKE_ERA")) ?? String(), spoken: String(), zone: false, session: String(), minted: false, initialized: 0, discovered: 0, mismatched: 0, grows: env.variable(String("FAKE_GROW")) != none, grown: false, listening: Json.Null, said: List<Json>(), extra: List<String>(), news: false, listens: 0, listen_auth: String() }
    if env.args().contains(String("--http")) {
        try serve_http(mut fake)
        return
    }
    if fake.era == "slow" { unsafe { sleep(6000000000) } }
    var input = io.Lines()
    while let line = input.next() {
        let m = match parse(line.copy()) {
            ok(j) => j,
            err(_) => continue,
        }
        let (_, said) = fake.answer(m, false, Map<String, String>())
        if let body = said { println("{body}") }
        // Its notifications, after the answer, as a server sends them while
        // the client isn't waiting.
        for n in fake.said {
            println("{n}")
        }
        fake.said = List<Json>()
        io.flush()
    }
}
