module tests.protocol.quiet

// Routines run quietly (PLAN.md, "Routines"). A run's prompt is never a
// message in the chat, and neither is its agent's answer: with nothing posted,
// nothing reaches the chat and no one is notified, and the run ends quiet.
// What the agent posts with routine_post is its message in the chat, and a
// notification. routine_quiet ends a run quiet; routine_failed makes it a
// failure with why, which the person sees and is told, and five in a row
// turn the routine off with a notice. pause_routine pauses it and tells the
// person. A prompt still naming OpenBot's tools reaches them as loom's.
// Outside a routine run, they're refused. routine.runs keeps each run. A post
// keeps its routine's name. A run while the person's turn goes on runs beside
// it, its post going in after the turn's reply and before what they queued
// behind it; one while the routine's last run still goes is skipped, and kept so.
//
//     calx tests/protocol/quiet.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, int_at, str_at}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

fn put(app: mut Session, id: str, name: str, prompt: str) -> String ! Error {
    let r = try app.cmd(id, "routine.put", Obj.new().s("name", String(name)).s("agent", String("Main")).s("prompt", String(prompt)).j("schedule", Obj.new().i("every", 600).done()).b("notify", true).done())
    return str_at(at(at(r, "value"), "routine"), "id") ?? String()
}

// Runs routine `id` by hand and gives the routine once its run has ended, with
// the frames that came meanwhile.
fn run_once(app: mut Session, q: str, id: String) -> (Json, List<Json>) ! Error {
    let from = app.frames.len()
    let ran = try app.cmd(q, "routine.run", Obj.new().s("id", id.copy()).done())
    if bool_at(ran.copy(), "ok") != some(true) { fail "routine.run refused: {ran}" }
    loop {
        let e = try app.until("event", "routine.updated")
        let r = at(e, "routine")
        let status = str_at(at(r.copy(), "last"), "status") ?? String()
        if str_at(r.copy(), "id") == some(id.copy()) and status != "running" {
            // What the run's end sends after the routine is kept: its notify, and run.finished.
            loop {
                let f = try app.until("event", "run.finished")
                if str_at(f, "run") == some(str_at(at(r.copy(), "last"), "run") ?? String()) { break }
            }
            return (r, app.frames[from..].copy())
        }
    }
}

// The routine `id` once its last run is `status`, from the frames that came
// since `since` or those still to come.
fn last_is(app: mut Session, since: usize, id: String, status: str) -> Json ! Error {
    var n = since
    loop {
        while n < app.frames.len() {
            let f = app.frames[n].copy()
            n += 1
            if str_at(f.copy(), "kind") != some(String("routine.updated")) { continue }
            let r = at(f, "routine")
            if str_at(r.copy(), "id") == some(id.copy()) and str_at(at(r.copy(), "last"), "status") == some(String(status)) { return r }
        }
        _ = try app.until("event", "routine.updated")
    }
}

// Routine `id`'s newest run, as routine.runs gives it.
fn newest_run(app: mut Session, q: str, id: String) -> Json ! Error {
    if let Json.Array(runs) = at(at(try app.cmd(q, "routine.runs", Obj.new().s("id", id).done()), "value"), "runs") {
        if runs.len() > 0 { return runs[0].copy() }
    }
    fail "routine.runs has none"
}

fn kinds(frames: List<Json>, kind: str) -> List<Json> {
    var out = List<Json>()
    for f in frames {
        if str_at(f.copy(), "kind") == some(String(kind)) { out.push(f.copy()) }
    }
    return out
}

// The messages that came, as their role and text.
fn shown(frames: List<Json>) -> List<String> {
    var out = List<String>()
    for f in kinds(frames, "message.created") {
        let m = at(f, "message")
        out.push("{str_at(m.copy(), "role") ?? String()}: {reply_text(m)}")
    }
    return out
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    _ = try app.cmd("q_a", "agent.create", Obj.new().s("name", String("Main")).s("acp_agent", String("fake")).s("instructions", String("Test.")).done())

    // Nothing to say: nothing reaches the chat, and no one hears.
    let silent = try put(mut app, "q_1", "Watch", "No new release since the last check.")
    let (s, s_frames) = try run_once(mut app, "q_2", silent.copy())
    try check(str_at(at(s.copy(), "last"), "status") == some(String("quiet")), "a run that posts nothing ends quiet")
    try check(shown(s_frames.copy()).len() == 0 and kinds(s_frames.copy(), "notify").len() == 0, "and leaves nothing in the chat, its prompt and its answer, and notifies no one")
    var started = Json.Null
    for f in kinds(s_frames, "run.started") { started = f.copy() }
    try check(str_at(started, "routine") == some(silent.copy()), "its run.started says it's the routine's")
    let conversation = str_at(s, "conversation") ?? String()
    let listed = "{try app.cmd("q_3", "messages.list", Obj.new().s("conversation", conversation.copy()).done())}"
    try check(not listed.contains("No new release"), "messages.list doesn't have it either")

    // routine_quiet ends it quiet too.
    let quiet = try put(mut app, "q_4", "Hush", #"/mcp routine_quiet {}"#)
    let (q, q_frames) = try run_once(mut app, "q_5", quiet.copy())
    try check(str_at(at(q, "last"), "status") == some(String("quiet")) and shown(q_frames).len() == 0, "a run that calls routine_quiet ends quiet")

    // Something to say: the post is the agent's message, and a notification.
    let news = try put(mut app, "q_6", "News", "/mcp routine_post \{\"text\": \"26.4 is out.\"\}\nI posted it.")
    let (n, n_frames) = try run_once(mut app, "q_7", news.copy())
    let notified = kinds(n_frames.copy(), "notify")
    try check(str_at(at(n.copy(), "last"), "status") == some(String("done")) and shown(n_frames.copy()) == [String("agent: 26.4 is out.")], "a post is the only message the run leaves")
    var posted = Json.Null
    for f in kinds(n_frames, "message.created") { posted = at(f.copy(), "message") }
    try check(str_at(posted.copy(), "routine") == some(news.copy()) and str_at(posted.copy(), "conversation") == some(conversation.copy()) and str_at(posted.copy(), "agent") != none, "in the agent's chat, as its message, marked with the routine")
    try check(str_at(posted, "routine_name") == some(String("News")), "and with the routine's name as it was then")
    try check(notified.len() == 1 and str_at(notified[0].copy(), "title") == some(String("News")) and str_at(notified[0].copy(), "body") == some(String("26.4 is out.")) and str_at(notified[0].copy(), "conversation") == some(conversation.copy()), "and its person is notified with it")
    let runs = at(at(try app.cmd("q_8", "routine.runs", Obj.new().s("id", news.copy()).done()), "value"), "runs")
    var last_run = Json.Null
    if let Json.Array(rs) = runs.copy() { if rs.len() > 0 { last_run = rs[0].copy() } }
    try check(str_at(last_run.copy(), "status") == some(String("done")) and at(last_run.copy(), "posted") == Json.Array([Json.Str(String("26.4 is out."))]) and (str_at(last_run.copy(), "said") ?? String()).contains("I posted it.") and (int_at(last_run, "ended") ?? 0) > 0, "routine.runs keeps the run: how it ended, what it posted and what its agent answered")

    // OpenBot's names for the tools, in a prompt imported before they changed on the way.
    let imported = try put(mut app, "q_9", "Imported", #"/mcp openbot.routine_no_update {}"#)
    let (im, _) = try run_once(mut app, "q_10", imported)
    try check(str_at(at(im, "last"), "status") == some(String("quiet")), "a prompt naming openbot.routine_no_update calls routine_quiet")

    // Failed: with why, and five in a row turn it off.
    let failing = try put(mut app, "q_11", "Prices", #"/mcp routine_failed {"why": "the shop was down"}"#)
    let (f1, f1_frames) = try run_once(mut app, "q_12", failing.copy())
    let told = kinds(f1_frames.copy(), "notify")
    try check(str_at(at(f1.copy(), "last"), "status") == some(String("failed")) and str_at(at(f1.copy(), "last"), "error") == some(String("the shop was down")) and int_at(f1, "failures") == some(1), "routine_failed makes the run a failure, with why")
    try check(told.len() == 1 and (str_at(told[0].copy(), "body") ?? String()).contains("the shop was down"), "and its person is told why")
    try check(shown(f1_frames).len() == 1, "and sees its agent's answer in the chat")
    var last = Json.Null
    var last_frames = List<Json>()
    for k in 0..4 {
        let (r, fs) = try run_once(mut app, if k == 0 { "q_13" } else if k == 1 { "q_14" } else if k == 2 { "q_15" } else { "q_16" }, failing.copy())
        last = r
        last_frames = fs
    }
    let off_notice = kinds(last_frames, "notify")
    try check(int_at(last.copy(), "failures") == some(5) and bool_at(last.copy(), "on") == some(false) and int_at(last, "next") == some(0), "five failures in a row turn the routine off")
    try check(off_notice.len() == 1 and (str_at(off_notice[0].copy(), "body") ?? String()).contains("failed 5 times in a row"), "with one notice that says so")

    // Pause: the routine pauses itself, and the person is told.
    let pausing = try put(mut app, "q_17", "Sale", #"/mcp pause_routine {"why": "the sale is over"}"#)
    let (p, p_frames) = try run_once(mut app, "q_18", pausing)
    let paused = kinds(p_frames, "notify")
    try check(bool_at(p.copy(), "on") == some(false) and str_at(at(p, "last"), "status") == some(String("quiet")), "pause_routine pauses its own routine")
    try check(paused.len() >= 1 and str_at(paused[0].copy(), "title") == some(String("Main paused Sale")) and str_at(paused[0].copy(), "body") == some(String("the sale is over")), "and tells the person why")

    // A routine run while the person's turn goes on in the chat runs at once,
    // beside it, and what it posts goes in once the turn is over, before what
    // the person queued behind it.
    let later = try put(mut app, "q_19", "Later", "/mcp routine_post \{\"text\": \"after you\"\}")
    try app.send(Obj.new().s("t", String("send")).s("cid", String("c_2")).s("conversation", conversation.copy()).s("text", String("/nap 1500\nfirst")).done())
    _ = try app.until("event", "run.started")
    let since = app.frames.len()
    try app.send(Obj.new().s("t", String("send")).s("cid", String("c_3")).s("conversation", conversation.copy()).s("text", String("second")).done())
    let ran = at(try app.cmd("q_20", "routine.run", Obj.new().s("id", later.copy()).done()), "value")
    let beside_run = str_at(ran.copy(), "run") ?? String()
    try check(at(ran, "waiting") == Json.Null and beside_run.len() > 0, "routine.run in a busy chat runs at once")
    let done = try last_is(mut app, since, later.copy(), "done")
    try check(str_at(at(done, "last"), "run") == some(beside_run.copy()) and not shown(app.frames[since..].copy()).contains(String("agent: first")), "and its run ends while the person's turn goes on")
    while not shown(app.frames[since..].copy()).contains(String("agent: second")) { _ = try app.until("event", "message.created") }
    let order = shown(app.frames[since..].copy())
    let first_at = order.position(|x| x == "agent: first") ?? 99
    let posted_at = order.position(|x| x == "agent: after you") ?? 99
    let second_at = order.position(|x| x == "person: second") ?? 0
    if not (first_at < posted_at and posted_at < second_at) { eprintln("the chat went: {order}") }
    try check(first_at < posted_at and posted_at < second_at, "its post goes in after the turn's reply, before the message the person queued")

    // A run while the routine's run before still goes is skipped, and kept in its runs with why.
    let slow = try put(mut app, "q_22", "Slow", "/sleep 1500")
    let slow_since = app.frames.len()
    _ = try app.cmd("q_23", "routine.run", Obj.new().s("id", slow.copy()).done())
    let again = try app.cmd("q_24", "routine.run", Obj.new().s("id", slow.copy()).done())
    try check(str_at(at(again, "error"), "code") == some(String("busy")), "a routine run again while its run goes on is refused")
    let skipped = try newest_run(mut app, "q_25", slow.copy())
    try check(str_at(skipped.copy(), "status") == some(String("skipped")) and str_at(skipped, "error") == some(String("It was still running from the time before.")), "and its runs keep that time as skipped, with why")
    _ = try last_is(mut app, slow_since, slow, "quiet")

    // Outside a routine run, they're refused.
    try app.send(Obj.new().s("t", String("send")).s("cid", String("c_1")).s("conversation", conversation.copy()).s("text", String("/mcp routine_quiet \{\}\n/mcp routine_post \{\"text\": \"hi\"\}")).done())
    let said = reply_text(try app.reply())
    try check(said.contains("routine_quiet failed: ") and said.contains("You aren't answering for a routine now."), "outside a routine run, routine_quiet is refused")
    try check(said.contains("routine_post failed: "), "and so is routine_post")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    var failure: String? = none
    match run(inst.copy()) {
        ok => {},
        err(e) => failure = some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nquiet: all good")
}
