module tests.protocol.main_chat

// An agent's chat with the person is fixed (protocol.md, "An agent's chat"): when
// the agent makes a conversation for itself with conversation.create mid-task, the
// person's chat stays its chat, `main`, with its history, and what the agent made is
// a thread beside it, `made_by` the agent, labelled with its title. A real core sends
// what the person writes to the agent into the chat, and after a restart too. The
// person's new chat, from their app, is the chat from then on.
//
//     calx tests/protocol/main_chat.calx
import std.json.{Json, parse}
import std.process.{exit}
import std.time.{Instant}
import shared.obj.{Obj, at, bool_at, str_at}
import shared.client.{Session, reply_text}
import core.cache.{Cache}
import core.conn.{Conn, ToApp}
import tests.kit.{Instance, check}

// The agent's next reply in `conversation`, as text.
fn reply_in(app: mut Session, conversation: String) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return reply_text(m) }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

// The conversation the person's message `text` was stored in.
fn stored_in(app: mut Session, text: str) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("person")) and reply_text(m.copy()) == text { return str_at(m, "conversation") ?? String() }
    }
}

// The app's side of a real core: what it sends, and what the core tells it.
struct App {
    to_core: Sender<String>
    from_core: Receiver<ToApp>
    thread: Thread?
}

impl App {
    fn start(base: String, token: String) -> App ! Error {
        let inbox = Receiver<String>()
        let to_core = inbox.sender()
        let from_core = Receiver<ToApp>()
        let conn = Conn.new(some("http://{base}"), some(token.copy()), String("loom-test-main-chat"), try Cache.open(String(":memory:")), inbox, from_core.sender())
        let t = unsafe { Thread.spawn(conn) }
        return App { to_core: to_core, from_core: from_core, thread: some(t) }
    }

    // Reads what the core says until a frame whose `t` is `t` and whose `field` is
    // `value`, if `field` isn't empty.
    fn until(mut self, t: str, field: str, value: String, ms: u64) -> Json ! Error {
        let start = unsafe { Instant.now() }
        loop {
            let waited = unsafe { Instant.now() }.nanos_since(start) / 1000000
            if waited >= ms { fail "no {t} {field}={value} came in {ms} ms" }
            let got = unsafe { self.from_core.wait_for((ms - waited) * 1000000) } else { continue }
            let m = got.text() else { continue }
            let f = try parse(m)
            if (str_at(f.copy(), "t") ?? String()) != t { continue }
            if field.len() == 0 or (str_at(f.copy(), field) ?? String()) == value { return f }
        }
    }

    // The conversations the core gives the app, newest first.
    fn conversations(mut self, id: str) -> List<Json> ! Error {
        self.to_core.send("{Obj.new().s("t", String("core.get")).s("id", String(id)).s("what", String("conversations")).done()}")
        let got = try self.until("core.data", "id", String(id), 5000)
        let Json.Array(items) = at(got, "items") else return List<Json>()
        return items
    }

    fn stop(mut self) {
        self.to_core.send(String(#"{"t":"core.stop"}"#))
        if let t = self.thread.take() { t.join() }
    }
}

// A conversation of `list` by its id.
fn find(list: List<Json>, id: String) -> Json {
    for c in list {
        if str_at(c.copy(), "id") == some(id.copy()) { return c.copy() }
    }
    return Json.Null
}

// What the person opens: the core's chat for the agent is the person's chat, with its
// history, and the thread the agent made is beside it, by its title. A message the
// app sends to the agent, naming only the agent as the app does before it knows its
// chat, goes into the chat.
fn opened(i: Instance, app: mut Session, agent: String, chat: String, thread: String, q: str, said: str) ! Error {
    var core = try App.start(i.base.copy(), i.token.copy())
    _ = try core.until("synced", "", String(), 30000)
    let list = try core.conversations(q)
    let c = find(list.copy(), chat.copy())
    let t = find(list.copy(), thread.copy())
    try check(bool_at(c, "main") == some(true), "the person's chat is marked as the agent's chat")
    try check(str_at(t.copy(), "made_by") == some(agent.copy()) and str_at(t.copy(), "title") == some(String("Plenpartner warm-up")) and bool_at(t, "main") != some(true), "what the agent made is a thread beside it, by its title")
    core.to_core.send("{Obj.new().s("t", String("send")).s("agent", agent).s("text", String(said)).done()}")
    try check(try stored_in(mut app, said) == chat, "what the person writes to the agent goes into the chat, not the thread")
    core.stop()
}

// Before the restart: gives the event to go on from, the agent, its chat and the
// thread it made.
fn before(i: Instance) -> (i64, String, String, String) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Casper")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).b("code_mode", false).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    // The person's chat with Casper, from their app.
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()
    var created = Json.Null
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.created")) and str_at(at(f.copy(), "conversation"), "id") == some(chat.copy()) { created = at(f.copy(), "conversation") }
    }
    try check(bool_at(created, "main") == some(true), "the person's new chat is the agent's chat")
    try check(try say(mut app, chat.copy(), "m_1", String("hello")) == "hello", "the person talks with Casper")
    // Mid-task, Casper makes a conversation for itself.
    let call = Obj.new().s("name", String("conversation.create")).j("args", Obj.new().s("agent", agent.copy()).s("title", String("Plenpartner warm-up")).done()).done()
    _ = try say(mut app, chat.copy(), "m_2", "/mcp run_command {call}")
    var thread = Json.Null
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.created")) and str_at(at(f.copy(), "conversation"), "title") == some(String("Plenpartner warm-up")) { thread = at(f.copy(), "conversation") }
    }
    let thread_id = str_at(thread.copy(), "id") ?? String()
    try check(thread_id.len() > 0 and thread_id != chat and str_at(thread.copy(), "made_by") == some(agent.copy()) and bool_at(thread, "main") != some(true), "what Casper made says Casper made it, and isn't the chat")
    try opened(i.copy(), mut app, agent.copy(), chat.copy(), thread_id.copy(), "g_1", "still here")
    let seq = app.seq
    app.close()
    return (seq, agent, chat, thread_id)
}

fn after_restart(i: Instance, seq: i64, agent: String, chat: String, thread: String) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), seq)
    try opened(i.copy(), mut app, agent.copy(), chat.copy(), thread.copy(), "g_2", "after a restart")
    // The person's new chat, from their app, is the chat from then on, and the one
    // before isn't.
    let c = try app.cmd("q_3", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let fresh = str_at(at(c, "value"), "conversation") ?? String()
    // It may have come with the command's answer.
    var changed = Json.Null
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.updated")) { changed = f.copy() }
    }
    if changed == Json.Null { changed = try app.until("event", "conversation.updated") }
    try check(str_at(at(changed.copy(), "conversation"), "id") == some(chat.copy()) and bool_at(at(changed, "conversation"), "main") == some(false), "the chat before says it isn't the chat any more")
    var core = try App.start(i.base.copy(), i.token.copy())
    _ = try core.until("synced", "", String(), 30000)
    let list = try core.conversations("g_3")
    try check(bool_at(find(list.copy(), fresh.copy()), "main") == some(true) and bool_at(find(list, chat), "main") != some(true), "the new chat is the agent's chat")
    core.to_core.send("{Obj.new().s("t", String("send")).s("agent", agent).s("text", String("a new start")).done()}")
    try check(try stored_in(mut app, "a new start") == fresh, "and what the person writes goes there")
    core.stop()
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    var failure: String? = none
    var left: (i64, String, String, String) = (0, String(), String(), String())
    match before(inst.copy()) {
        ok(l) => left = l,
        err(e) => failure = some("{e}"),
    }
    if failure != none {
        inst.stop()
    } else {
        let (seq, agent, chat, thread) = left
        let back = try inst.restart()
        match after_restart(back.copy(), seq, agent, chat, thread) {
            ok => {},
            err(e) => failure = some("{e}"),
        }
        back.stop()
    }
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nmain_chat: all good")
}
