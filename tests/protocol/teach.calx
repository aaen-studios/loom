module tests.protocol.teach

// Teaching a task, and proposals (PLAN.md, "Sharing and learning"): the fake
// agent proposes a skill and a note, which wait for the person to keep or drop,
// and which an agent can't keep itself; a kept note is a note, tied to its
// site, and a kept skill a skill, with what the person changed. proposal.ask
// starts a task of looking over past chats. Then, with a Chrome, Edge or
// Chromium on the computer: a note tied to a site is shown to the agent when
// its browser opens a page there, once a visit; the person takes over the
// browser and records a task, whose steps are kept without what went into a
// password field or any of their secrets; the agent's write-up task is given
// the steps, and its save_skill there is proposed, not saved, until the person
// keeps it. Without a browser, that part says it was skipped.
//
//     calx tests/protocol/teach.calx
import std.fs
import std.http.server.{Server}
import std.json.{Json}
import std.process.{exit}
import std.thread.{Task}
import shared.obj.{Obj, at, bool_at, merge, str_at}
import server.browser
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

struct Serving {
    server: Server
    dir: String
}

impl Task for Serving {
    fn run(own self) {
        var s = self
        s.server.serve(s.dir.copy())
    }
}

fn reply_in(app: mut Session, conversation: String, wait_ms: u32 = 30000) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created", wait_ms)
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return reply_text(m) }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String, wait_ms: u32 = 30000) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation, wait_ms)
}

// check, saying what came when it fails.
fn see(passed: bool, what: str, got: String) ! Error {
    if not passed { fail "failed: {what}, from:\n{got}" }
    println("ok    {what}")
}

// The `n`th proposal made (from 1), from the proposal.created events read so
// far, or the next to come. It comes before the reply that says so.
fn proposed(app: mut Session, n: usize) -> Json ! Error {
    loop {
        var seen: usize = 0
        for f in app.frames {
            if str_at(f.copy(), "kind") == some(String("proposal.created")) {
                seen += 1
                if seen == n { return at(f.copy(), "proposal") }
            }
        }
        _ = try app.until("event", "proposal.created")
    }
}

fn proposals(app: mut Session, id: str) -> List<Json> ! Error {
    let r = try app.cmd(id, "proposal.list", Obj.new().done())
    let Json.Array(list) = at(at(r, "value"), "proposals") else return List<Json>()
    return list
}

fn proposals_part(app: mut Session, agent: String, conversation: String) ! Error {
    let note = try say(mut app, conversation.copy(), "m_1", String(#"/mcp propose_note {"text":"Ann buys wool socks.","site":"https://www.Shop.example/socks","why":"From our chat on Tuesday."}"#))
    try see(note.starts_with("propose_note: Proposed."), "propose_note proposes a note", note.copy())
    let p_note = try proposed(mut app, 1)
    try see(str_at(p_note.copy(), "status") == some(String("waiting")) and str_at(at(p_note.copy(), "note"), "site") == some(String("shop.example")) and str_at(p_note.copy(), "why") == some(String("From our chat on Tuesday.")), "which waits for the person, tied to its site", "{p_note}")
    let note_id = str_at(p_note, "id") ?? String()

    let skill = try say(mut app, conversation.copy(), "m_2", String(#"/mcp propose_skill {"name":"order-socks","description":"Ordering socks.","body":"1. Open the shop.","why":"You've asked me three times."}"#))
    try see(skill.starts_with("propose_skill: Proposed the skill order-socks."), "propose_skill proposes a skill", skill.copy())
    let p_skill = try proposed(mut app, 2)
    let skill_id = str_at(p_skill.copy(), "id") ?? String()
    try check(str_at(at(p_skill, "skill"), "name") == some(String("order-socks")), "with the skill it proposes")
    let listed = try app.cmd("q_1", "skill.list", Obj.new().done())
    try check(not "{listed}".contains("order-socks"), "and nothing is saved before the person says so")
    let waiting = try proposals(mut app, "q_2")
    try check(waiting.len() == 2, "proposal.list gives what waits")

    let self_kept = try say(mut app, conversation.copy(), "m_3", "/mcp run_command {Obj.new().s("name", String("proposal.keep")).j("args", Obj.new().s("id", skill_id.copy()).done()).done()}")
    try see(self_kept.starts_with("run_command failed") and self_kept.contains("Proposals are your person's"), "an agent can't keep its own proposal", self_kept.copy())

    let kept = try app.cmd("q_3", "proposal.keep", Obj.new().s("id", note_id.copy()).done())
    try see(str_at(at(at(kept.copy(), "value"), "proposal"), "status") == some(String("kept")), "proposal.keep keeps a note", "{kept}")
    let updated = try heard(mut app, "proposal.updated", note_id.copy())
    try check(str_at(at(updated, "proposal"), "status") == some(String("kept")), "and every device hears so")
    let notes = try app.cmd("q_4", "memory.list", Obj.new().s("agent", agent.copy()).done())
    try see("{notes}".contains("Ann buys wool socks.") and "{notes}".contains("\"site\":\"shop.example\""), "as a note of the agent's, tied to its site", "{notes}")

    let changed = try app.cmd("q_5", "proposal.keep", Obj.new().s("id", skill_id.copy()).j("skill", Obj.new().s("description", String("Ordering socks from the usual shop.")).done()).done())
    try check(bool_at(changed, "ok") == some(true), "proposal.keep keeps a skill, with what the person changed")
    let got = try app.cmd("q_6", "skill.get", Obj.new().s("name", String("order-socks")).done())
    try see(str_at(at(at(got.copy(), "value"), "skill"), "description") == some(String("Ordering socks from the usual shop.")), "and it's a skill for every agent", "{got}")
    let again = try app.cmd("q_7", "proposal.keep", Obj.new().s("id", skill_id).done())
    try check(str_at(at(again, "error"), "code") == some(String("not_now")), "a proposal is decided once")

    _ = try say(mut app, conversation.copy(), "m_4", String(#"/mcp propose_note {"text":"Bob is Ann's brother."}"#))
    let p_drop = try proposed(mut app, 3)
    let dropped = try app.cmd("q_8", "proposal.drop", Obj.new().s("id", str_at(p_drop, "id") ?? String()).done())
    try check(str_at(at(at(dropped, "value"), "proposal"), "status") == some(String("dropped")), "proposal.drop drops one")
    let after = try app.cmd("q_9", "memory.list", Obj.new().done())
    try check(not "{after}".contains("Bob is"), "and it never becomes a note")
    let left = try proposals(mut app, "q_10")
    try check(left.len() == 0, "leaving nothing waiting")

    let remembered = try say(mut app, conversation.copy(), "m_5", String(#"/mcp remember {"text":"Checkout needs the work card.","site":"shop.example"}"#))
    try see(remembered.contains("for shop.example"), "remember ties a note to a site", remembered.copy())

    let asked = try app.cmd("q_11", "proposal.ask", Obj.new().s("agent", agent.copy()).done())
    let task = at(at(asked, "value"), "task")
    try see(str_at(task.copy(), "title") == some(String("Propose skills and notes from past chats")), "proposal.ask starts a task of looking over past chats", "{asked}")
    let looked = try reply_in(mut app, str_at(task, "conversation") ?? String())
    try see(looked.contains("propose_skill") and looked.contains("Ann buys wool socks"), "which is given the chat", looked)
}

fn browser_part(i: Instance, app: mut Session, agent: String, conversation: String) ! Error {
    let pages = try fs.temp_dir()
    try fs.write_text("{pages}/shop.html", String(#"
        <!doctype html><title>Shop</title>
        <input aria-label="Search" style="position:absolute;left:10px;top:10px;width:300px;height:30px">
        <input type="password" aria-label="Password" style="position:absolute;left:10px;top:60px;width:300px;height:30px">
        <a href="second.html" style="position:absolute;left:10px;top:110px;font-size:20px">Next page</a>
        "#))
    try fs.write_text("{pages}/second.html", String("<!doctype html><title>Second</title><h1>Second page</h1>"))
    var server = try Server.listen(0)
    server.log = false
    let base = server.url()[..server.url().len() - 1].copy()
    _ = unsafe { Thread.spawn(Serving { server: server, dir: pages.copy() }) }
    let host = base.trim_prefix("http://").copy()

    _ = try app.cmd("q_b1", "memory.put", Obj.new().s("text", String("Log in with the shop account.")).s("agent", agent.copy()).s("site", base.copy()).done())
    let opened = try say(mut app, conversation.copy(), "m_b1", "/mcp browser_open \{\"url\":\"{base}/shop.html\"\}", 120000)
    try see(opened.contains("Page: Shop") and opened.contains("[loom: Your notes for {host}") and opened.contains("Log in with the shop account."), "a page on a site with notes shows the agent them", opened.copy())
    let snap = try say(mut app, conversation.copy(), "m_b2", String("/mcp browser_snapshot"))
    try see(not snap.contains("Your notes for"), "once a visit", snap.copy())

    let early = try app.cmd("q_b2", "browser.record", Obj.new().s("agent", agent.copy()).done())
    try check(str_at(at(early, "error"), "code") == some(String("not_yours")), "recording waits for the person to take over")
    _ = try app.cmd("q_b3", "secret.put", Obj.new().s("name", String("SHOP_PASS")).s("value", String("hunter2-wool")).done())
    _ = try app.cmd("q_b4", "browser.take", Obj.new().s("agent", agent.copy()).done())
    let on = try app.cmd("q_b5", "browser.record", Obj.new().s("agent", agent.copy()).b("on", true).done())
    try check(bool_at(at(on, "value"), "recording") == some(true), "browser.record starts recording")
    let inputs = [
        Obj.new().s("kind", String("click")).i("x", 60).i("y", 25).done(),
        Obj.new().s("kind", String("text")).s("text", String("wool")).done(),
        Obj.new().s("kind", String("text")).s("text", String(" hunter2-woolx")).done(),
        Obj.new().s("kind", String("key")).s("key", String("Backspace")).done(),
        Obj.new().s("kind", String("click")).i("x", 60).i("y", 75).done(),
        Obj.new().s("kind", String("text")).s("text", String("hunter2-wool")).done(),
        Obj.new().s("kind", String("click")).i("x", 40).i("y", 122).done(),
    ]
    var taken: usize = 0
    for input in inputs {
        let args = merge(input, Obj.new().s("agent", agent.copy()).done())
        let r = try app.cmd("q_in", "browser.input", args)
        if bool_at(r, "ok") == some(true) { taken += 1 }
    }
    try check(taken == inputs.len(), "the person's clicks, text and keys go to the page")
    _ = try app.cmd("q_b6", "browser.record", Obj.new().s("agent", agent.copy()).b("on", false).done())
    var conv = String()
    loop {
        let f = try app.until("event", "task.updated", 60000)
        let t = at(f, "task")
        if str_at(t.copy(), "title") == some(String("Write up the task you were shown")) {
            conv = str_at(t, "conversation") ?? String()
            break
        }
    }
    try check(true, "stopping starts the agent's task of writing it up")
    let shown = try reply_in(mut app, conv.copy())
    try see(shown.contains("save_skill") and shown.contains("1. On the page Shop") and shown.contains("Clicked textbox \"Search\"") and shown.contains("Typed \"wool [secret SHOP_PASS]\" into textbox \"Search\"") and shown.contains("Typed something secret into textbox \"Password\"") and shown.contains("Clicked link \"Next page\"") and shown.contains("On the page Second"), "which is given the steps: pages, clicks and what was typed", shown.copy())
    try see(not shown.contains("hunter2"), "and never a secret, typed into a password field or anywhere", shown.copy())

    let wrote = try say(mut app, conv.copy(), "m_b3", String(#"/mcp save_skill {"name":"shop-search","description":"Searching the shop.","body":"1. Open the shop and search."}"#))
    try see(wrote.starts_with("save_skill: Proposed the skill shop-search."), "save_skill there is proposed, not saved", wrote.copy())
    let p = try proposed(mut app, 4)
    try see(str_at(p.copy(), "recording") != none and "{at(p.copy(), "steps")}".contains("\"kind\":\"click\""), "with the recording's steps for the person to look at", "{p}")
    let skills = try app.cmd("q_b7", "skill.list", Obj.new().done())
    try check(not "{skills}".contains("shop-search"), "it isn't a skill until the person says yes")
    _ = try app.cmd("q_b8", "proposal.keep", Obj.new().s("id", str_at(p, "id") ?? String()).done())
    let now_skills = try app.cmd("q_b9", "skill.list", Obj.new().done())
    try check("{now_skills}".contains("shop-search"), "and then it is")
    let state = try app.cmd("q_b10", "browser.give", Obj.new().s("agent", agent.copy()).done())
    try check(bool_at(at(state, "value"), "recording") == some(false), "handing back leaves nothing recording")
    let profile = "{i.data}/browsers"
    try check(fs.is_dir(profile), "the browser kept its profile in the instance's data")
    try fs.remove_dir_all(pages)
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_a", "agent.create", Obj.new().s("name", String("Teacher")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_c", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let conversation = str_at(at(c, "value"), "conversation") ?? String()
    try proposals_part(mut app, agent.copy(), conversation.copy())
    if browser.find() == none {
        println("teach: the browser part skipped, there's no Chrome, Edge or Chromium here")
    } else {
        try browser_part(i.copy(), mut app, agent.copy(), conversation)
    }
    _ = try app.cmd("q_d", "agent.delete", Obj.new().s("agent", agent).done())
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nteach: all good")
}

// The event of `kind` about proposal `id`, read already or still to come.
fn heard(app: mut Session, kind: str, id: String) -> Json ! Error {
    loop {
        for f in app.frames {
            if str_at(f.copy(), "kind") == some(String(kind)) and str_at(at(f.copy(), "proposal"), "id") == some(id.copy()) { return f.copy() }
        }
        _ = try app.until("event", kind)
    }
}
