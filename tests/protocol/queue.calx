module tests.protocol.queue

// The queue (PLAN.md, "Work that waits its turn"): a message to an agent
// that's still answering waits in its conversation's queue, which the person
// reorders, edits and drops from, and goes once the agent is free. Steering
// stops the running turn and sends the message at once. A turn the person
// stops leaves the queue waiting; one a restart cut short doesn't.
//
//     calx tests/protocol/queue.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, str_at}
import tests.kit.{App, Instance, check, reply_text}

fn send(app: mut App, conversation: String, cid: str, text: str) -> Json ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation).s("text", String(text)).done())
    loop {
        let ack = try app.until("ack", "")
        if str_at(ack.copy(), "cid") == some(String(cid)) { return ack }
    }
}

// The texts in the next queue.changed.
fn queue_now(app: mut App) -> String ! Error {
    let changed = try app.until("event", "queue.changed")
    var texts = List<String>()
    if let Json.Array(items) = at(changed, "queue") {
        for item in items {
            texts.push(str_at(item, "text") ?? String())
        }
    }
    return texts.join(" | ")
}

// The texts in the newest queue.changed the app has read.
fn last_queue(app: App) -> String {
    var texts = List<String>()
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("queue.changed")) {
            texts = List<String>()
            if let Json.Array(items) = at(f.copy(), "queue") {
                for item in items {
                    texts.push(str_at(item, "text") ?? String())
                }
            }
        }
    }
    return texts.join(" | ")
}

// The queue's item whose text is `text`.
fn item_id(app: mut App, conversation: String, text: str) -> String ! Error {
    let listed = try app.cmd("q_list", "queue.list", Obj.new().s("conversation", conversation).done())
    if let Json.Array(items) = at(at(listed, "value"), "queue") {
        for item in items {
            if str_at(item.copy(), "text") == some(String(text)) { return str_at(item, "id") ?? String() }
        }
    }
    return String()
}

// The agent's next reply, as text.
fn reply(app: mut App) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) { return reply_text(m) }
    }
}

fn run(i: Instance) -> (i64, String, String) ! Error {
    var app = try App.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Busy")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let conversation = str_at(at(c, "value"), "conversation") ?? String()

    let first = try send(mut app, conversation.copy(), "m_1", "/sleep 1500\nfirst, done")
    try check(str_at(first, "run") != none, "a message to a free agent starts a run")
    let second = try send(mut app, conversation.copy(), "m_2", "second")
    try check(bool_at(second, "queued") == some(true), "one to a busy agent is queued, not refused")
    try check(try queue_now(mut app) == "second", "and every device hears the queue")
    _ = try send(mut app, conversation.copy(), "m_3", "third")
    try check(try queue_now(mut app) == "second | third", "the next waits behind it")

    let second_id = try item_id(mut app, conversation.copy(), "second")
    let third_id = try item_id(mut app, conversation.copy(), "third")
    _ = try app.cmd("q_3", "queue.order", Obj.new().s("conversation", conversation.copy()).j("ids", Json.Array([Json.Str(third_id.copy()), Json.Str(second_id.copy())])).done())
    try check(last_queue(app) == "third | second", "queue.order reorders it")
    _ = try app.cmd("q_4", "queue.edit", Obj.new().s("id", third_id.copy()).s("text", String("third, edited")).done())
    try check(last_queue(app) == "third, edited | second", "queue.edit changes one, in its place")
    _ = try app.cmd("q_5", "queue.drop", Obj.new().s("id", second_id).done())
    try check(last_queue(app) == "third, edited", "queue.drop drops one")

    try check(try reply(mut app) == "first, done", "the running turn finishes")
    try check(try queue_now(mut app) == "", "then the first that waits goes")
    try check(try reply(mut app) == "third, edited", "as the person's message, and the agent answers it")

    // --- Steering ---
    _ = try send(mut app, conversation.copy(), "m_6", "/sleep 20000\nnever")
    _ = try send(mut app, conversation.copy(), "m_7", "/context")
    try check(try queue_now(mut app) == "/context", "a message waits behind a long turn")
    let steer_id = try item_id(mut app, conversation.copy(), "/context")
    _ = try app.cmd("q_6", "queue.steer", Obj.new().s("id", steer_id).done())
    let finished = try app.until("event", "run.finished")
    try check(str_at(finished, "status") == some(String("cancelled")), "queue.steer stops the running turn")
    var said_by_person = String()
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("person")) {
            said_by_person = reply_text(m)
            break
        }
    }
    try check(said_by_person == "/context", "and the steered message goes at once, as the person wrote it")
    let steered = try reply(mut app)
    try check(steered.contains("Your person stopped you to say this"), "the agent is told it was stopped for it")

    // --- Stopping ---
    let long = try send(mut app, conversation.copy(), "m_8", "/sleep 20000\nnever")
    _ = try send(mut app, conversation.copy(), "m_9", "after the stop")
    _ = try queue_now(mut app)
    try app.send(Obj.new().s("t", String("cancel")).s("run", str_at(long, "run") ?? String()).done())
    let stopped = try app.until("event", "run.finished")
    try check(str_at(stopped, "status") == some(String("cancelled")), "the person stops a turn")
    let left = try app.cmd("q_7", "queue.list", Obj.new().s("conversation", conversation.copy()).done())
    try check(at(at(left, "value"), "queue").len() == 1, "and what waits stays waiting")

    // --- A restart in the middle of a turn ---
    let other = try app.cmd("q_8", "conversation.create", Obj.new().s("agent", agent).done())
    let cut = str_at(at(other, "value"), "conversation") ?? String()
    _ = try send(mut app, cut.copy(), "m_10", "/sleep 20000\nnever")
    _ = try send(mut app, cut.copy(), "m_11", "after the restart")
    _ = try queue_now(mut app)
    let seq = app.seq
    app.close()
    return (seq, conversation, cut)
}

// The turn the restart cut short failed, so what waited behind it goes; the
// queue the person left waiting by stopping a turn still waits.
fn after_restart(i: Instance, seq: i64, stopped: String, cut: String) ! Error {
    var app = try App.connect(i.base.copy(), i.token.copy(), seq)
    try check(try reply(mut app) == "after the restart", "what waited behind a turn a restart cut short goes")
    let still = try app.cmd("q_9", "queue.list", Obj.new().s("conversation", stopped).done())
    try check(at(at(still, "value"), "queue").len() == 1, "and a queue left waiting by a stop still waits")
    let gone = try app.cmd("q_10", "queue.list", Obj.new().s("conversation", cut).done())
    try check(at(at(gone, "value"), "queue").len() == 0, "the one that went isn't there any more")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    var failure: String? = none
    var left: (i64, String, String) = (0, String(), String())
    match run(inst.copy()) {
        ok(l) => left = l,
        err(e) => failure = some("{e}"),
    }
    if failure != none {
        inst.stop()
    } else {
        let (seq, stopped, cut) = left
        let back = try inst.restart()
        match after_restart(back.copy(), seq, stopped, cut) {
            ok => {},
            err(e) => failure = some("{e}"),
        }
        back.stop()
    }
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nqueue: all good")
}
