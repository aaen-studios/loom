module tests.protocol.side

// Side questions (PLAN.md, "Side questions"): chat.ask asks an agent about
// its chat on the side. The agent is given the chat's newest messages and
// answers in a conversation of its own for side questions, marked `side`, so
// neither the question nor the answer goes in the chat, and a tool that asks
// is refused there without asking the person.
//
//     calx tests/protocol/side.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, str_at}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

fn reply_in(app: mut Session, conversation: String) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return reply_text(m) }
    }
}

// How many messages a conversation has.
fn count(app: mut Session, id: str, conversation: String) -> usize ! Error {
    let listed = try app.cmd(id, "messages.list", Obj.new().s("conversation", conversation).done())
    if let Json.Array(ms) = at(at(listed, "value"), "messages") { return ms.len() }
    return 0
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Main")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_1")).s("conversation", chat.copy()).s("text", String("the word is teapot")).done())
    _ = try reply_in(mut app, chat.copy())
    let before = try count(mut app, "q_3", chat.copy())

    let asked = try app.cmd("q_4", "chat.ask", Obj.new().s("conversation", chat.copy()).s("question", String("/context")).done())
    let answer = str_at(at(asked, "value"), "reply") ?? String()
    try check(answer.contains("side question") and answer.contains("Your person: the word is teapot"), "a side question is answered with the chat to go on")
    try check(try count(mut app, "q_5", chat.copy()) == before, "and neither it nor the answer goes in the chat")
    var side = String()
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.created")) and bool_at(at(f.copy(), "conversation"), "side") == some(true) { side = str_at(at(f, "conversation"), "id") ?? String() }
    }
    try check(side.len() > 0, "it's asked in a conversation of the agent's own for side questions")

    let refused = try app.cmd("q_6", "chat.ask", Obj.new().s("conversation", chat.copy()).s("question", String("/ask Delete everything\nafter")).done())
    var asked_person = false
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("approval.needed")) { asked_person = true }
    }
    try check((str_at(at(refused, "value"), "reply") ?? String()).contains("after") and not asked_person, "a tool that asks is refused there, without asking the person")
    var sides: usize = 0
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.created")) and bool_at(at(f.copy(), "conversation"), "side") == some(true) { sides += 1 }
    }
    try check(sides == 1, "and the next side question goes to the same one")

    let wrong = try app.cmd("q_7", "chat.ask", Obj.new().s("conversation", side).s("question", String("hi")).done())
    try check(str_at(at(wrong, "error"), "code") == some(String("bad_request")), "side questions are about a chat, not about themselves")
    let empty = try app.cmd("q_8", "chat.ask", Obj.new().s("conversation", chat).s("question", String(" ")).done())
    try check(str_at(at(empty, "error"), "code") == some(String("bad_request")), "and have something to ask")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nside: all good")
}
