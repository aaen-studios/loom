module tests.protocol.core_conn

// The core's connection (core/conn.calx) against a real instance: it sets
// the instance up and keeps the token, logs out, keeps a cache it reads
// offline and an outbox that sends what was written offline, and
// connects and catches up, takes the app's frames to the instance, starts
// again when the instance goes away and comes back, reconnects at once on
// wake, stops on a refused token, and stops when it's told to.
//
// Run it from the repository's root:
//
//     calx tests/protocol/core_conn.calx
import std.env
import std.fs
import std.json.{Json, parse}
import std.net.{Waker}
import std.process.{Child, Command, Stdio, exit}
import std.random.{Random}
import std.time.{Instant}
import shared.obj.{Obj, at, bool_at, int_at, str_at}
import core.cache.{Cache}
import core.conn.{Conn, ToApp}

const WAIT: u64 = 120000    // the first start builds the server

fn calx() -> String {
    return env.variable(String("CALX")) ?? String("calx")
}

fn serve(data: String, port: String) -> Child ! Error {
    let cmd = Command.new(calx()).arg(String("server/main.calx")).arg(String("serve")).arg(String("--port")).arg(port).arg(String("--data")).arg(data).arg(String("--test-fast-hashes")).arg(String("--allow-root"))
    return try cmd.stdout(Stdio.Pipe).own_group().spawn()
}

fn check(passed: bool, what: str) ! Error {
    if not passed { fail "failed: {what}" }
    println("ok    {what}")
}

// The app's side of a running connection: what it sends the core, and what
// the core tells it. As in the app, each send wakes the core's loop, which
// otherwise waits for the socket, its requests and its timers.
struct App {
    to_core: Sender<String>
    from_core: Receiver<ToApp>
    wakers: Receiver<Waker>
    waker: Waker?
    thread: Thread?
}

impl App {
    // Starts a core for the instance at `base`, keeping its token under the
    // credential store's service `service`, and its cache at `cache`.
    fn start(base: String, token: own String?, service: String, cache: String) -> App ! Error {
        let inbox = Receiver<String>()
        let to_core = inbox.sender()
        let from_core = Receiver<ToApp>()
        let wakers = Receiver<Waker>()
        var conn = Conn.new(some("http://{base}"), token, service.copy(), try Cache.open(cache.copy()), inbox, from_core.sender())
        conn.wakers_to = some(wakers.sender())
        let t = unsafe { Thread.spawn(conn) }
        return App { to_core: to_core, from_core: from_core, wakers: wakers, waker: none, thread: some(t) }
    }

    fn tell(mut self, text: own String) {
        self.to_core.send(text)
        while let w = self.wakers.next() { self.waker = some(w) }
        if let w = self.waker { w.wake() }
    }

    fn send(mut self, frame: Json) {
        self.tell("{frame}")
    }

    // Reads what the core says until a frame whose `t` is `t` and, if `field` isn't
    // empty, whose `field` is `value`. Fails after `ms`.
    fn until(mut self, t: str, field: str, value: String, ms: u64) -> Json ! Error {
        let start = unsafe { Instant.now() }
        loop {
            let waited = unsafe { Instant.now() }.nanos_since(start) / 1000000
            if waited >= ms { fail "no {t} {field}={value} came in {ms} ms" }
            let got = unsafe { self.from_core.wait_for((ms - waited) * 1000000) } else { continue }
            let m = got.text() else { continue }
            let f = try parse(m)
            if (str_at(f.copy(), "t") ?? String()) != t { continue }
            if field.len() == 0 or (str_at(f.copy(), field) ?? String()) == value { return f }
        }
    }

    fn stop(mut self) {
        self.tell(String(#"{"t":"core.stop"}"#))
        if let t = self.thread.take() {
            t.join()
        }
    }
}

fn run(server: mut Child, data: String) ! Error {
    let serving = server.wait_for_line(String("loom: serving"), WAIT) else {
        fail "the server didn't start"
    }
    let address = serving[serving.find("http://") ?? 0..].trim().copy()
    let base = if address.ends_with("/") { address[7..address.len() - 1].copy() } else { address[7..].copy() }
    let port = base[(base.find_last(":") ?? 0) + 1..].copy()
    let code_line = server.wait_for_line(String("setup code:"), 10000) else {
        fail "the server didn't print a setup code"
    }
    let code = code_line[12..].trim().copy()
    var random = Random.system()
    let service = "loom-test-{random.next_u32()}"
    let device = Obj.new().s("name", String("Desk PC")).s("kind", String("windows")).done()

    let cache = "{try fs.temp_dir()}/core.db"

    // --- Setup through the core ---
    var app = try App.start(base.copy(), none, service.copy(), cache.copy())
    let waiting = try app.until("core.conn", "state", "signed_out", 5000)
    try check(str_at(waiting, "why") == some(String("not logged in")), "with no token kept, it waits for a login")
    app.send(Obj.new().s("t", String("setup")).s("id", String("l_1")).s("code", String("wrong")).s("username", String("elliot")).s("password", String("correct horse")).done())
    let refused = try app.until("core.login", "id", "l_1", 10000)
    try check(str_at(at(refused, "error"), "code") == some(String("bad_code")), "a setup with a wrong code is refused")
    app.send(Obj.new().s("t", String("setup")).s("id", String("l_2")).s("code", code).s("username", String("elliot")).s("password", String("correct horse")).j("device", device.copy()).done())
    let logged = try app.until("core.login", "id", "l_2", 10000)
    try check(bool_at(logged.copy(), "ok") == some(true) and str_at(logged.copy(), "user") != none, "the core sets the instance up and gets a token")
    let kept = bool_at(logged.copy(), "kept") == some(true)
    if kept {
        println("ok    and keeps it in the credential store")
    } else {
        println("      the token wasn't kept: {str_at(logged, "why") ?? String()}")
    }

    // --- Connects and catches up ---
    _ = try app.until("core.conn", "state", "connecting", 5000)
    let live = try app.until("core.conn", "state", "live", 10000)
    try check(str_at(live, "state") == some(String("live")), "it connects, says hello and is welcomed")
    // Catching up, the app hears of no event one by one, but of each kind with synced.
    var heard = 0
    var synced = Json.Null
    while synced == Json.Null {
        let m = unsafe { app.from_core.wait_for(5000 * 1000000) } else { fail "no synced came in 5 s" }
        let f = try parse(m)
        let t = str_at(f.copy(), "t") ?? String()
        if t == "event" { heard += 1 }
        if t == "synced" { synced = f }
    }
    try check(heard == 0 and "{at(at(synced, "held"), "kinds")}" == #"["device.added"]"#, "it catches up from its cursor, and the app hears of it once, with synced")
    app.send(Obj.new().s("t", String("core.get")).s("id", String("g_0")).s("what", String("devices")).done())
    try check("{at(try app.until("core.data", "id", "g_0", 5000), "items")}".contains("Desk PC"), "and the cache has what it held")

    // --- Whether the instance is behind the newest release ---
    app.send(Obj.new().s("t", String("release")).s("version", String("99.0.0")).done())
    let behind = try app.until("core.server", "latest", String("99.0.0"), 5000)
    try check(bool_at(behind.copy(), "behind") == some(true) and (str_at(behind, "loom") ?? String()).len() > 0, "a newer release than the instance's version makes it behind (core.server)")
    app.send(Obj.new().s("t", String("release")).s("version", String("0.0.1")).done())
    let ahead = try app.until("core.server", "latest", String("0.0.1"), 5000)
    try check(bool_at(ahead, "behind") == some(false), "and an older one doesn't")

    // --- The app's frames go to the instance ---
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_1")).s("name", String("nothing.here")).j("args", Obj.new().done()).done())
    let listed = try app.until("result", "id", "q_1", 5000)
    try check(str_at(at(listed, "error"), "code") == some(String("unknown_command")), "a cmd from the app reaches the instance and its result comes back")

    // --- A phone joins by the QR code this device shows ---
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_link")).s("name", String("link.create")).done())
    let link_made = at(try app.until("result", "id", "q_link", 5000), "value")
    let qr = str_at(link_made.copy(), "qr") ?? String()
    try check(qr.starts_with("loom://link?a=http%3A%2F%2F") and qr.contains("&c={str_at(link_made.copy(), "code") ?? String("-")}") and (int_at(link_made, "expires") ?? 0) > 0, "link.create gives a one-time code, and the core makes the QR code's text from it")
    var phone = try App.start(base.copy(), none, "{service}-phone", String(":memory:"))
    phone.send(Obj.new().s("t", String("link")).s("id", String("k_1")).s("qr", qr.copy()).j("device", Obj.new().s("name", String("iPhone")).s("kind", String("ios")).done()).done())
    let joined = try phone.until("core.login", "id", "k_1", 10000)
    try check(bool_at(joined.copy(), "ok") == some(true) and str_at(joined, "user") == str_at(logged.copy(), "user"), "a phone that scans it joins the same account, with a token of its own")
    _ = try phone.until("core.conn", "state", "live", 10000)
    let seen = try app.until("event", "kind", "device.added", 5000)
    try check(str_at(at(seen, "device"), "kind") == some(String("ios")), "and the device that showed it hears it joined")
    phone.send(Obj.new().s("t", String("link")).s("id", String("k_2")).s("qr", qr).done())
    let used = try phone.until("core.login", "id", "k_2", 10000)
    phone.send(Obj.new().s("t", String("link")).s("id", String("k_3")).s("qr", String("https://example.com")).done())
    let not_loom = try phone.until("core.login", "id", "k_3", 5000)
    try check(str_at(at(used, "error"), "code") == some(String("bad_code")) and str_at(at(not_loom, "error"), "code") == some(String("bad_qr")), "a code works once, and a QR code that isn't loom's is refused")
    phone.send(Obj.new().s("t", String("logout")).done())
    _ = try phone.until("core.conn", "why", String("logged out"), 5000)
    phone.stop()

    // --- The cache ---
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_a")).s("name", String("agent.create")).j("args", Obj.new().s("name", String("Fake")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done()).done())
    let made = try app.until("result", "id", "q_a", 5000)
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_c")).s("name", String("conversation.create")).j("args", Obj.new().s("agent", agent).s("title", String("Builds")).done()).done())
    let conv = try app.until("result", "id", "q_c", 5000)
    let conversation = str_at(at(conv, "value"), "conversation") ?? String()
    app.send(Obj.new().s("t", String("core.get")).s("id", String("g_1")).s("what", String("conversations")).done())
    let listed_convs = try app.until("core.data", "id", "g_1", 5000)
    try check("{at(listed_convs, "items")}".contains("Builds") and "{at(listed_convs, "items")}".contains(#""last":"#), "the cache keeps the conversation the events made, with when its newest message is from")
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_p")).s("name", String("acp.list")).done())
    let programs = try app.until("result", "id", "q_p", 5000)
    try check("{at(at(programs, "value"), "programs")}".contains("\"name\":\"fake\""), "acp.list gives the agent programs installed")
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_b")).s("name", String("agent.create")).j("args", Obj.new().s("name", String("Other")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done()).done())
    let other = str_at(at(at(try app.until("result", "id", "q_b", 5000), "value"), "agent"), "id") ?? String()
    app.send(Obj.new().s("t", String("send")).s("agent", other.copy()).s("text", String("hello, new agent")).done())
    let made_conv = try app.until("event", "kind", "conversation.created", 5000)
    let to_agent = try app.until("ack", "", String(), 5000)
    try check(str_at(at(made_conv, "conversation"), "agent") == some(other.copy()) and str_at(to_agent, "message") != none, "a send to an agent with no conversation makes one and goes")
    _ = try app.until("event", "kind", "run.finished", 20000)

    // --- Files, up and down ---
    let sample = "{try fs.temp_dir()}/report.txt"
    try fs.write_text(sample.copy(), String("the quarterly numbers"))
    app.send(Obj.new().s("t", String("file.upload")).s("id", String("u_1")).s("path", sample).done())
    let up = at(try app.until("core.file", "id", "u_1", 10000), "file")
    let sha = str_at(up.copy(), "file") ?? String()
    try check(sha.len() == 64 and str_at(up, "name") == some(String("report.txt")), "file.upload sends a file and gives its SHA-256")
    app.send(Obj.new().s("t", String("send")).s("agent", other.copy()).s("text", String("/files")).j("files", Json.Array([Json.Str(sha.copy())])).done())
    var with_file = try app.until("event", "kind", "message.created", 10000)
    while str_at(at(with_file.copy(), "message"), "role") != some(String("agent")) {
        with_file = try app.until("event", "kind", "message.created", 10000)
    }
    try check("{with_file}".contains("link report.txt"), "a send with files gives them to the agent")
    _ = try app.until("event", "kind", "run.finished", 20000)
    app.send(Obj.new().s("t", String("file.get")).s("id", String("f_1")).s("file", sha.copy()).done())
    let down = str_at(try app.until("core.file", "id", "f_1", 10000), "path") ?? String()
    try check(try fs.read_text(down.copy()) == some(String("the quarterly numbers")), "file.get fetches a file to the data folder")
    app.send(Obj.new().s("t", String("file.get")).s("id", String("f_2")).s("file", sha).done())
    try check(str_at(try app.until("core.file", "id", "f_2", 1000), "path") == some(down), "and a file it has is answered at once")

    // --- Notifications, while no one is looking ---
    app.send(Obj.new().s("t", String("app.active")).b("active", false).done())
    app.send(Obj.new().s("t", String("send")).s("agent", other).s("text", String("tell me when you're done")).done())
    let note = try app.until("core.notify", "kind", String("run.finished"), 20000)
    try check(str_at(note.copy(), "title") == some(String("Other")) and (str_at(note, "body") ?? String()).len() > 0, "a reply that's done while the app isn't looked at becomes a notification")
    // A routine's quiet run that posts nothing isn't one: only a post, or a failure, is.
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_r1")).s("name", String("routine.put")).j("args", Obj.new().s("name", String("Check")).s("agent", other.copy()).s("prompt", String("nothing new")).j("schedule", Obj.new().i("every", 600).done()).done()).done())
    let routine = str_at(at(at(try app.until("result", "id", "q_r1", 5000), "value"), "routine"), "id") ?? String()
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_r2")).s("name", String("routine.run")).j("args", Obj.new().s("id", routine).done()).done())
    let routine_run = str_at(at(try app.until("result", "id", "q_r2", 5000), "value"), "run") ?? String()
    var told_quiet = false
    loop {
        let got = unsafe { app.from_core.wait_for(20000 * 1000000) } else { fail "the routine's run didn't finish" }
        let m = got.text() else { continue }
        let f = try parse(m)
        let t = str_at(f.copy(), "t") ?? String()
        if t == "core.notify" { told_quiet = true }
        if t == "event" and str_at(f.copy(), "kind") == some(String("run.finished")) and str_at(f, "run") == some(routine_run.copy()) { break }
    }
    try check(not told_quiet, "a routine's quiet run that posts nothing isn't a notification")
    app.send(Obj.new().s("t", String("app.active")).b("active", true).done())

    // --- The instance goes away and comes back ---
    server.kill_tree()
    _ = server.wait()
    let gone = try app.until("core.conn", "state", "offline", 10000)
    let first_wait = int_at(gone, "retry_ms") ?? 0
    try check(first_wait >= 500 and first_wait <= 600, "it notices the instance went, and waits 0.5 s and up to 20% more")
    println("      first wait {first_wait} ms")
    let again = try app.until("core.conn", "state", "offline", 10000)
    let second_wait = int_at(again, "retry_ms") ?? 0
    try check(second_wait >= 1000 and second_wait <= 1200, "then twice as long")
    println("      second wait {second_wait} ms")
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_2")).s("name", String("nothing.here")).done())
    let offline = try app.until("error", "code", "offline", 5000)
    try check(str_at(offline, "for") == some(String("q_2")), "a frame sent while offline is answered with offline")
    app.send(Obj.new().s("t", String("send")).s("conversation", conversation.copy()).s("text", String("written while offline")).done())
    let queued = try app.until("core.queued", "", "", 2000)
    let cid = str_at(queued, "cid") ?? String()
    try check(cid.starts_with("m_"), "a message written offline goes in the outbox with a client id")

    server = try serve(data.copy(), port)
    if server.wait_for_line(String("loom: serving"), WAIT) == none {
        fail "the server didn't start again"
    }
    _ = try app.until("core.conn", "state", "live", 40000)
    try check(true, "it connects again once the instance is back")
    _ = try app.until("synced", "", "", 5000)
    _ = try app.until("ack", "cid", cid.copy(), 10000)
    app.send(Obj.new().s("t", String("core.get")).s("id", String("g_2")).s("what", String("outbox")).done())
    let outbox = try app.until("core.data", "id", "g_2", 5000)
    try check("{at(outbox, "items")}" == "[]", "and the outbox sends it, and lets it go once it's acked")
    _ = try app.until("event", "kind", "run.finished", 20000)

    // --- Wake ---
    app.send(Obj.new().s("t", String("app.wake")).done())
    _ = try app.until("core.conn", "state", "connecting", 2000)
    _ = try app.until("core.conn", "state", "live", 5000)
    try check(true, "on wake it opens a new connection at once")

    // --- Stop ---
    app.stop()
    try check(true, "core.stop closes it and its thread ends")

    // --- Reading offline, from the cache ---
    var reader = try App.start(base.copy(), none, "{service}-none", cache.copy())
    _ = try reader.until("core.conn", "state", "signed_out", 5000)
    reader.send(Obj.new().s("t", String("core.get")).s("id", String("g_3")).s("what", String("messages")).s("conversation", conversation.copy()).done())
    let read = try reader.until("core.data", "id", "g_3", 5000)
    let shown = "{at(read, "items")}"
    try check(shown.contains("written while offline") and shown.contains("\"role\":\"agent\""), "with no connection, the app reads the conversation from the cache")
    reader.stop()

    // --- Started again, from the credential store ---
    if kept {
        // A run the cache kept going, whose run.finished it never got.
        {
            let stale = try Cache.open(cache.copy())
            try stale.keep_runs(Json.Array([Obj.new().s("run", String("run_gone")).s("conversation", conversation.copy()).s("agent", String("a_gone")).done()]))
        }
        var next = try App.start(base.copy(), none, service.copy(), cache.copy())
        _ = try next.until("core.conn", "state", "live", 10000)
        try check(true, "a new start finds the token in the credential store and connects")
        _ = try next.until("synced", "", "", 5000)
        next.send(Obj.new().s("t", String("core.get")).s("id", String("g_runs")).s("what", String("runs")).done())
        let runs = try next.until("core.data", "id", "g_runs", 5000)
        try check("{at(runs, "items")}" == "[]", "a run the cache missed the end of is gone once it's synced")

        // --- A wrong password, and logging out ---
        next.send(Obj.new().s("t", String("login")).s("id", String("l_3")).s("username", String("elliot")).s("password", String("not it")).done())
        let wrong_pw = try next.until("core.login", "id", "l_3", 10000)
        try check(str_at(at(wrong_pw, "error"), "code") == some(String("bad_password")), "a wrong password is refused")
        next.send(Obj.new().s("t", String("logout")).done())
        let out = try next.until("core.conn", "state", "signed_out", 5000)
        try check(str_at(out, "why") == some(String("logged out")), "logout signs out")
        next.stop()
        var after_logout = try App.start(base.copy(), none, service.copy(), String(":memory:"))
        let gone_token = try after_logout.until("core.conn", "state", "signed_out", 5000)
        try check(str_at(gone_token, "why") == some(String("not logged in")), "and forgets the token")
        after_logout.stop()
    }

    // --- A refused token ---
    var wrong = try App.start(base.copy(), some(String("not a token")), service.copy(), String(":memory:"))
    let out = try wrong.until("core.conn", "state", "signed_out", 10000)
    try check(str_at(out, "state") == some(String("signed_out")), "a refused token signs out and doesn't try again")
    wrong.stop()
}

fn main() ! Error {
    let data = try fs.temp_dir()
    let agent = try fs.absolute(String("tests/fake_agent/main.calx"))
    let added = try Command.new(calx()).arg(String("server/main.calx")).arg(String("acp")).arg(String("add")).arg(String("fake")).arg(calx()).arg(agent).arg(String("--data")).arg(data.copy()).output()
    if not added.status.success() { fail "loom acp add failed: {added.error_text()}" }
    var server = try serve(data.copy(), String("0"))
    let failure: String? = match run(mut server, data) {
        ok => none,
        err(e) => some("{e}"),
    }
    server.kill_tree()
    _ = server.wait()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\ncore connection: all good")
}
