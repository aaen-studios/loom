module tests.protocol.core_conn

// The core's connection (core/conn.calx) against a real instance: it sets
// the instance up and keeps the token, logs out, and
// connects and catches up, takes the app's frames to the instance, starts
// again when the instance goes away and comes back, reconnects at once on
// wake, stops on a refused token, and stops when it's told to.
//
// Run it from the repository's root:
//
//     calx tests/protocol/core_conn.calx
import std.env
import std.fs
import std.json.{Json, parse}
import std.process.{Child, Command, Stdio, exit}
import std.random.{Random}
import std.time.{Instant}
import shared.obj.{Obj, at, bool_at, int_at, str_at}
import core.conn.{Conn}

const WAIT: u64 = 120000    // the first start builds the server

fn calx() -> String {
    return env.variable(String("CALX")) ?? String("calx")
}

fn serve(data: String, port: String) -> Child ! Error {
    let cmd = Command.new(calx()).arg(String("server/main.calx")).arg(String("serve")).arg(String("--port")).arg(port).arg(String("--data")).arg(data).arg(String("--test-fast-hashes"))
    return try cmd.stdout(Stdio.Pipe).own_group().spawn()
}

fn check(passed: bool, what: str) ! Error {
    if not passed { fail "failed: {what}" }
    println("ok    {what}")
}

// The app's side of a running connection: what it sends the core, and what
// the core tells it.
struct App {
    to_core: Sender<String>
    from_core: Receiver<String>
    thread: Thread?
}

impl App {
    // Starts a core for the instance at `base`, keeping its token under the
    // credential store's service `service`.
    fn start(base: String, token: own String?, service: String) -> App {
        let inbox = Receiver<String>()
        let to_core = inbox.sender()
        let from_core = Receiver<String>()
        let conn = Conn.new(some("http://{base}"), token, 0, service.copy(), inbox, from_core.sender())
        let t = unsafe { Thread.spawn(conn) }
        return App { to_core: to_core, from_core: from_core, thread: some(t) }
    }

    fn send(mut self, frame: Json) {
        self.to_core.send("{frame}")
    }

    // Reads what the core says until a frame whose `t` is `t` and, if `field` isn't
    // empty, whose `field` is `value`. Fails after `ms`.
    fn until(mut self, t: str, field: str, value: str, ms: u64) -> Json ! Error {
        let start = unsafe { Instant.now() }
        loop {
            let waited = unsafe { Instant.now() }.nanos_since(start) / 1000000
            if waited >= ms { fail "no {t} {field}={value} came in {ms} ms" }
            let m = unsafe { self.from_core.wait_for((ms - waited) * 1000000) } else { continue }
            let f = try parse(m)
            if (str_at(f.copy(), "t") ?? String()) != t { continue }
            if field.len() == 0 or (str_at(f.copy(), field) ?? String()) == value { return f }
        }
    }

    fn stop(mut self) {
        self.to_core.send(String(#"{"t":"core.stop"}"#))
        if let t = self.thread.take() {
            t.join()
        }
    }
}

fn run(server: mut Child, data: String) ! Error {
    let serving = server.wait_for_line(String("loom: serving"), WAIT) else {
        fail "the server didn't start"
    }
    let address = serving[serving.find("http://") ?? 0..].trim().copy()
    let base = if address.ends_with("/") { address[7..address.len() - 1].copy() } else { address[7..].copy() }
    let port = base[(base.find_last(":") ?? 0) + 1..].copy()
    let code_line = server.wait_for_line(String("setup code:"), 10000) else {
        fail "the server didn't print a setup code"
    }
    let code = code_line[12..].trim().copy()
    var random = Random.system()
    let service = "loom-test-{random.next_u32()}"
    let device = Obj.new().s("name", String("Desk PC")).s("kind", String("windows")).done()

    // --- Setup through the core ---
    var app = App.start(base.copy(), none, service.copy())
    let waiting = try app.until("core.conn", "state", "signed_out", 5000)
    try check(str_at(waiting, "why") == some(String("not logged in")), "with no token kept, it waits for a login")
    app.send(Obj.new().s("t", String("setup")).s("id", String("l_1")).s("code", String("wrong")).s("username", String("elliot")).s("password", String("correct horse")).done())
    let refused = try app.until("core.login", "id", "l_1", 10000)
    try check(str_at(at(refused, "error"), "code") == some(String("bad_code")), "a setup with a wrong code is refused")
    app.send(Obj.new().s("t", String("setup")).s("id", String("l_2")).s("code", code).s("username", String("elliot")).s("password", String("correct horse")).j("device", device.copy()).done())
    let logged = try app.until("core.login", "id", "l_2", 10000)
    try check(bool_at(logged.copy(), "ok") == some(true) and str_at(logged.copy(), "user") != none, "the core sets the instance up and gets a token")
    let kept = bool_at(logged.copy(), "kept") == some(true)
    if kept {
        println("ok    and keeps it in the credential store")
    } else {
        println("      the token wasn't kept: {str_at(logged, "why") ?? String()}")
    }

    // --- Connects and catches up ---
    _ = try app.until("core.conn", "state", "connecting", 5000)
    let live = try app.until("core.conn", "state", "live", 10000)
    try check(str_at(live, "state") == some(String("live")), "it connects, says hello and is welcomed")
    let added = try app.until("event", "kind", "device.added", 5000)
    try check(int_at(added, "seq") == some(1), "it catches up from its cursor")
    _ = try app.until("synced", "", "", 5000)
    println("ok    and says synced")

    // --- The app's frames go to the instance ---
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_1")).s("name", String("nothing.here")).j("args", Obj.new().done()).done())
    let listed = try app.until("result", "id", "q_1", 5000)
    try check(str_at(at(listed, "error"), "code") == some(String("unknown_command")), "a cmd from the app reaches the instance and its result comes back")

    // --- The instance goes away and comes back ---
    server.kill_tree()
    _ = server.wait()
    let gone = try app.until("core.conn", "state", "offline", 10000)
    let first_wait = int_at(gone, "retry_ms") ?? 0
    try check(first_wait >= 500 and first_wait <= 600, "it notices the instance went, and waits 0.5 s and up to 20% more")
    println("      first wait {first_wait} ms")
    let again = try app.until("core.conn", "state", "offline", 10000)
    let second_wait = int_at(again, "retry_ms") ?? 0
    try check(second_wait >= 1000 and second_wait <= 1200, "then twice as long")
    println("      second wait {second_wait} ms")
    app.send(Obj.new().s("t", String("cmd")).s("id", String("q_2")).s("name", String("nothing.here")).done())
    let offline = try app.until("error", "code", "offline", 5000)
    try check(str_at(offline, "for") == some(String("q_2")), "a frame sent while offline is answered with offline")

    server = try serve(data.copy(), port)
    if server.wait_for_line(String("loom: serving"), WAIT) == none {
        fail "the server didn't start again"
    }
    _ = try app.until("core.conn", "state", "live", 40000)
    _ = try app.until("synced", "", "", 5000)
    try check(true, "it connects again once the instance is back")

    // --- Wake ---
    app.send(Obj.new().s("t", String("app.wake")).done())
    _ = try app.until("core.conn", "state", "connecting", 2000)
    _ = try app.until("core.conn", "state", "live", 5000)
    try check(true, "on wake it opens a new connection at once")

    // --- Stop ---
    app.stop()
    try check(true, "core.stop closes it and its thread ends")

    // --- Started again, from the credential store ---
    if kept {
        var next = App.start(base.copy(), none, service.copy())
        _ = try next.until("core.conn", "state", "live", 10000)
        try check(true, "a new start finds the token in the credential store and connects")

        // --- A wrong password, and logging out ---
        next.send(Obj.new().s("t", String("login")).s("id", String("l_3")).s("username", String("elliot")).s("password", String("not it")).done())
        let wrong_pw = try next.until("core.login", "id", "l_3", 10000)
        try check(str_at(at(wrong_pw, "error"), "code") == some(String("bad_password")), "a wrong password is refused")
        next.send(Obj.new().s("t", String("logout")).done())
        let out = try next.until("core.conn", "state", "signed_out", 5000)
        try check(str_at(out, "why") == some(String("logged out")), "logout signs out")
        next.stop()
        var after_logout = App.start(base.copy(), none, service.copy())
        let gone_token = try after_logout.until("core.conn", "state", "signed_out", 5000)
        try check(str_at(gone_token, "why") == some(String("not logged in")), "and forgets the token")
        after_logout.stop()
    }

    // --- A refused token ---
    var wrong = App.start(base.copy(), some(String("not a token")), service.copy())
    let out = try wrong.until("core.conn", "state", "signed_out", 10000)
    try check(str_at(out, "state") == some(String("signed_out")), "a refused token signs out and doesn't try again")
    wrong.stop()
}

fn main() ! Error {
    let data = try fs.temp_dir()
    var server = try serve(data.copy(), String("0"))
    let failure: String? = match run(mut server, data) {
        ok => none,
        err(e) => some("{e}"),
    }
    server.kill_tree()
    _ = server.wait()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\ncore connection: all good")
}
