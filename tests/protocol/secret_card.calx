module tests.protocol.secret_card

// A password asked for on a card (PLAN.md, "The agent's browser"): the fake
// agent opens a sign-in page and is told it wants a password, which it never
// asks for in the chat. Its browser_ask_secret puts a card in its reply with
// the site, a masked field and Save as; the person fills it with Save as, and
// the field has it while the agent never sees it, the secret is kept with the
// site allowed, and the next fill there asks no one. Not now is a plain no,
// one card takes an email and a password at once, and a card the turn ended
// on says so. Without Chrome, Edge or Chromium on the computer, it says it was
// skipped.
//
//     calx tests/protocol/secret_card.calx
import std.fs
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, str_at}
import server.browser
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

fn reply_in(app: mut Session, conversation: String, wait_ms: u32 = 30000) -> Json ! Error {
    loop {
        let created = try app.until("event", "message.created", wait_ms)
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return m }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return reply_text(try reply_in(mut app, conversation))
}

// Sends `text` for the agent to play, and gives the secret_ask card it puts in its reply.
fn ask(app: mut Session, conversation: String, cid: str, text: String) -> Json ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    loop {
        let f = try app.until("card", "")
        if str_at(at(f.copy(), "card"), "type") == some(String("secret_ask")) { return f }
    }
}

// The first card frame for the card `id` from the `mark`th frame read on.
fn card_now(app: mut Session, mark: usize, id: String) -> Json ! Error {
    var k = mark
    while k < app.frames.len() {
        let c = at(app.frames[k].copy(), "card")
        if str_at(app.frames[k].copy(), "t") == some(String("card")) and str_at(c.copy(), "id") == some(id.copy()) { return c }
        k += 1
    }
    loop {
        let f = try app.until("card", "")
        let c = at(f, "card")
        if str_at(c.copy(), "id") == some(id.copy()) { return c }
    }
}

// check, saying what came when it fails.
fn see(passed: bool, what: str, got: String) ! Error {
    if not passed { fail "failed: {what}, from:\n{got}" }
    println("ok    {what}")
}

// The ref of the first line of an outline that has `part` in it.
fn ref_of(outline: String, part: str) -> String {
    for line in outline.lines() {
        if line.contains(part) {
            if let start = line.find("[ref=") {
                let rest = line[start + 5..].copy()
                if let end = rest.find("]") { return rest[..end].copy() }
            }
        }
    }
    return String()
}

fn file_url(path: String) -> String {
    let p = path.replace("\\", "/")
    return if p.starts_with("/") { "file://{p}" } else { "file:///{p}" }
}

// The secret_ask card a finished reply keeps.
fn kept_card(message: Json) -> Json {
    if let Json.Array(blocks) = at(message, "blocks") {
        for b in blocks {
            if str_at(at(b.copy(), "card"), "type") == some(String("secret_ask")) { return at(b, "card") }
        }
    }
    return Json.Null
}

fn run(i: Instance) ! Error {
    let pages = try fs.temp_dir()
    // The page checks the password itself, so its title says whether it got it.
    try fs.write_text("{pages}/signin.html", String(#"
        <!doctype html><title>Sign in</title><h1>NTNU</h1>
        <form onsubmit="document.title = this.pw.value === 'correct horse' ? 'Signed in as ' + this.email.value : 'Wrong password'; return false">
        <input name="email" type="email" aria-label="Email"><input name="pw" type="password" aria-label="Password"><button>Sign in</button></form>
        "#))
    let page = file_url("{pages}/signin.html")

    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("School")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let conversation = str_at(at(c, "value"), "conversation") ?? String()
    // Watched, so the browser stays open between turns.
    _ = try app.cmd("q_w", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", true).i("width", 320).i("height", 200).done())

    let told = try say(mut app, conversation.copy(), "m_0", String("/context"))
    try see(told.contains("Never ask your person for a password or a code in the chat") and told.contains("browser_ask_secret"), "a session is told never to ask for a password in the chat", told.copy())

    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_1")).s("conversation", conversation.copy()).s("text", "/mcp browser_open \{\"url\":\"{page}\"\}").done())
    let opened = reply_text(try reply_in(mut app, conversation.copy(), 120000))
    try see(opened.contains("Page: Sign in") and opened.contains("[loom: This page wants a password or a code. Never ask your person for one in the chat") and not opened.contains("keeps a secret"), "a page that wants a password tells the agent to fill or ask for it unseen", opened.copy())
    let pw = ref_of(opened.copy(), "textbox \"Password\"")
    let email = ref_of(opened.copy(), "textbox \"Email\"")
    try check(pw.len() > 0 and email.len() > 0, "with refs for the fields")

    // --- Asking, and Save as ---
    let asked = try ask(mut app, conversation.copy(), "m_2", "/mcp browser_ask_secret \{\"ref\":\"{pw}\",\"why\":\"Your NTNU password\"\}")
    let card = at(asked.copy(), "card")
    let id = str_at(card.copy(), "id") ?? String()
    try see(str_at(card.copy(), "title") == some(String("Your NTNU password")) and str_at(card.copy(), "site") == some(String("a file on this computer")) and str_at(card.copy(), "state") == some(String("asking")) and "{at(card.copy(), "fields")}" == #"[{"label":"Password","kind":"password","masked":true,"save":"password"}]"#, "browser_ask_secret puts a card in the reply: what's asked, the site, a masked field and Save as", "{card}")
    let early = try app.cmd("q_s0", "browser.secret", Obj.new().s("agent", agent.copy()).j("fields", Json.Array([Obj.new().s("value", String("x")).s("save", String("not a name")).done()])).done())
    try see(str_at(at(early.copy(), "error"), "code") == some(String("bad_request")), "a name that can't be a secret's is refused, and the card still asks", "{early}")
    let mark = app.frames.len()
    let answered = try app.cmd("q_s1", "browser.secret", Obj.new().s("agent", agent.copy()).j("fields", Json.Array([Obj.new().s("value", String("correct horse")).s("save", String("ntnu-password")).done()])).done())
    try see(bool_at(answered.copy(), "ok") == some(true) and "{at(at(answered.copy(), "value"), "saved")}" == #"["ntnu-password"]"#, "Fill with Save as keeps it under the name given", "{answered}")
    let filled = try card_now(mut app, mark, id.copy())
    try see(str_at(filled.copy(), "state") == some(String("filled")) and "{at(filled, "saved")}" == #"["ntnu-password"]"#, "and the card says it's filled, and kept as that", "{answered}")
    let message = try reply_in(mut app, conversation.copy())
    let result = reply_text(message.copy())
    try see(result == "browser_ask_secret: Filled in what your person typed. They kept it as ntnu-password for files on this computer, so from now on browser_fill_secret fills it in there without asking." and str_at(kept_card(message), "state") == some(String("filled")), "the agent hears it's in and what it's kept as, never what it was", result.copy())
    let listed = try app.cmd("q_s2", "secret.list", Obj.new().done())
    try see("{at(at(listed.copy(), "value"), "secrets")}".contains(#""name":"ntnu-password""#) and "{at(at(listed.copy(), "value"), "secrets")}".contains(#""sites":[""]"#), "it's in the person's secrets, with the site allowed", "{listed}")

    _ = try say(mut app, conversation.copy(), "m_3", "/mcp browser_type \{\"ref\":\"{email}\",\"text\":\"ada@ntnu.no\"\}")
    let signed = try say(mut app, conversation.copy(), "m_4", "/mcp browser_click \{\"ref\":\"{ref_of(opened.copy(), "button \"Sign in\"")}\"\}")
    try see(signed.contains("Page: Signed in as ada@ntnu.no") and not signed.contains("correct horse"), "the field had what the person typed, and the agent never reads it", signed.copy())

    // --- Next time it fills, asking no one ---
    let again = try say(mut app, conversation.copy(), "m_5", "/mcp browser_open \{\"url\":\"{page}\"\}")
    let pw2 = ref_of(again.copy(), "textbox \"Password\"")
    let before = app.frames.len()
    let refilled = try say(mut app, conversation.copy(), "m_6", "/mcp browser_fill_secret \{\"ref\":\"{pw2}\",\"secret\":\"ntnu-password\"\}")
    var asked_again = false
    var k = before
    while k < app.frames.len() {
        if str_at(app.frames[k].copy(), "kind") == some(String("approval.needed")) { asked_again = true }
        k += 1
    }
    try see(refilled == "browser_fill_secret: Filled in ntnu-password." and not asked_again, "the next fill on that site asks no one", refilled.copy())
    // A browser started again is told again, on its first page.
    let opened_again = try say(mut app, conversation.copy(), "m_7", "/mcp browser_close\n/mcp browser_open \{\"url\":\"{page}\"\}")
    try see(opened_again.contains("[loom: Your person keeps a secret for files on this computer: ntnu-password.") and opened_again.contains("browser_fill_secret"), "back on the site, the agent is told the names its person keeps for it", opened_again.copy())

    // --- Not now ---
    let pw3 = ref_of(opened_again.copy(), "textbox \"Password\"")
    let email3 = ref_of(opened_again.copy(), "textbox \"Email\"")
    let second = try ask(mut app, conversation.copy(), "m_8", "/mcp browser_ask_secret \{\"ref\":\"{pw3}\",\"why\":\"Your code\",\"kind\":\"code\"\}")
    let code = at(second.copy(), "card")
    try see("{at(code.copy(), "fields")}" == #"[{"label":"Code","kind":"code","masked":false,"save":""}]"#, "a one-time code is shown as it's typed, and not offered to keep", "{code}")
    let mark3 = app.frames.len()
    _ = try app.cmd("q_s3", "browser.secret", Obj.new().s("agent", agent.copy()).j("fields", Json.Array(List<Json>())).done())
    let declined = try card_now(mut app, mark3, str_at(code, "id") ?? String())
    let no = reply_text(try reply_in(mut app, conversation.copy()))
    try see(no.starts_with("browser_ask_secret failed: Your person said not now, so nothing went in.") and str_at(declined, "state") == some(String("declined")), "Not now is a plain no, and the card says so", no.copy())

    // --- Two fields on one card ---
    let both = try ask(mut app, conversation.copy(), "m_9", "/mcp browser_ask_secret {Obj.new().s("why", String("Your NTNU sign-in")).b("submit", true).j("fields", Json.Array([Obj.new().s("ref", email3.copy()).s("kind", String("username")).s("label", String("Email")).done(), Obj.new().s("ref", pw3.copy()).s("label", String("Password")).done()])).done()}")
    let two = at(both, "card")
    try see("{at(two.copy(), "fields")}" == #"[{"label":"Email","kind":"username","masked":false,"save":"username"},{"label":"Password","kind":"password","masked":true,"save":"password"}]"#, "one card takes an email and a password", "{two}")
    let half = try app.cmd("q_s4", "browser.secret", Obj.new().s("agent", agent.copy()).j("fields", Json.Array([Obj.new().s("value", String("ada@ntnu.no")).done(), Obj.new().s("value", String()).done()])).done())
    try see(str_at(at(half.copy(), "error"), "code") == some(String("bad_request")), "one left empty is refused", "{half}")
    _ = try app.cmd("q_s5", "browser.secret", Obj.new().s("agent", agent.copy()).j("fields", Json.Array([Obj.new().s("value", String("ada@ntnu.no")).done(), Obj.new().s("value", String("correct horse")).done()])).done())
    let in_both = reply_text(try reply_in(mut app, conversation.copy()))
    try see(in_both.starts_with("browser_ask_secret: Filled in the 2 fields with what your person typed, and submitted.") and in_both.contains("Page: Signed in as") and not in_both.contains("correct horse") and not in_both.contains("ada@ntnu.no"), "both go in, and neither reaches the agent", in_both.copy())
    let still = try app.cmd("q_s6", "secret.list", Obj.new().done())
    try see(not "{still}".contains("\"username\""), "with nothing kept that wasn't asked to be", "{still}")

    // --- A turn that ends while it asks ---
    let third = try ask(mut app, conversation.copy(), "m_10", "/mcp browser_ask_secret \{\"ref\":\"{pw3}\",\"why\":\"Your password\"\}")
    try app.send(Obj.new().s("t", String("cancel")).s("run", str_at(third.copy(), "run") ?? String()).done())
    let cut = try reply_in(mut app, conversation.copy())
    try see(str_at(kept_card(cut.copy()), "state") == some(String("closed")), "a card its turn ended on is kept closed", "{cut}")
    let late = try app.cmd("q_s7", "browser.secret", Obj.new().s("agent", agent.copy()).s("value", String("late")).done())
    try see(str_at(at(late.copy(), "error"), "code") == some(String("not_asked")), "and answers nothing after", "{late}")

    _ = try app.cmd("q_w2", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", false).done())
    _ = try app.cmd("q_3", "agent.delete", Obj.new().s("agent", agent).done())
    app.close()
    try fs.remove_dir_all(pages)
}

fn main() ! Error {
    if browser.find() == none {
        println("secret_card: skipped, there's no Chrome, Edge or Chromium here")
        return
    }
    var failure: String? = none
    let inst = try Instance.start()
    match run(inst.copy()) {
        ok => {},
        err(e) => failure = some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nsecret_card: all good")
}
