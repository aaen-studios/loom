module tests.protocol.push

// Push (PLAN.md, "Notifications and push"): a phone hands the instance its
// APNs token with push.register, only for itself, and the owner sets up the
// APNs key with `loom push key`, kept sealed, which `loom status` reports.
//
//     calx tests/protocol/push.calx
import std.fs
import std.process.{exit}
import std.text.utf8.{decode_lossy_unicode}
import shared.obj.{Obj, at, bool_at, str_at}
import tests.kit.{App, Instance, check, loom}

const TOKEN: str = "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"

fn run(i: Instance) ! Error {
    var app = try App.connect(i.base.copy(), i.token.copy(), 0)
    let taken = try app.cmd("q_1", "push.register", Obj.new().s("token", String(TOKEN)).s("env", String("development")).done())
    try check(bool_at(taken, "ok") == some(true), "a device registers its APNs token")
    let short = try app.cmd("q_2", "push.register", Obj.new().s("token", String("abc")).done())
    let env = try app.cmd("q_3", "push.register", Obj.new().s("token", String(TOKEN)).s("env", String("staging")).done())
    try check(str_at(at(short, "error"), "code") == some(String("bad_request")) and str_at(at(env, "error"), "code") == some(String("bad_request")), "a token that isn't one, or an env that isn't, is refused")
    let off = try app.cmd("q_4", "push.unregister", Obj.new().done())
    try check(bool_at(off, "ok") == some(true), "and it can stop taking push")
    app.close()

    // The owner's APNs key, from the command line.
    let before = try loom(i.data.copy(), [String("status")]).output()
    try check(before.text().contains("push: off"), "with no APNs key, there's no push")
    let key = "{i.data}/AuthKey_TEST.p8"
    try fs.write_text(key.copy(), String("-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg\n-----END PRIVATE KEY-----\n"))
    let set = try loom(i.data.copy(), [String("push"), String("key"), key, String("TESTKEY123"), String("TEAM123456"), String("no.aaenz.loom")]).output()
    let after = try loom(i.data.copy(), [String("status")]).output()
    try check(set.status.success() and after.text().contains("push: APNs, for no.aaenz.loom"), "loom push key sets it up")
    var kept = List<u8>()
    for name in ["loom.db", "loom.db-wal"] {
        if fs.exists("{i.data}/{name}") { kept.extend(try fs.read("{i.data}/{name}")) }
    }
    try check(not decode_lossy_unicode(kept.copy(), 0, kept.len()).contains("BEGIN PRIVATE KEY"), "and the database keeps the key only sealed")
    let not_key = "{i.data}/not-a-key.txt"
    try fs.write_text(not_key.copy(), String("hello"))
    let refused = try loom(i.data.copy(), [String("push"), String("key"), not_key, String("K"), String("T"), String("B")]).output()
    _ = try loom(i.data.copy(), [String("push"), String("off")]).output()
    let gone = try loom(i.data.copy(), [String("status")]).output()
    try check(not refused.status.success() and gone.text().contains("push: off"), "a file that isn't a key is refused, and push off turns it off")
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\npush: all good")
}
