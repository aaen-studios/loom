module tests.protocol.reply

// Replying to a message (PLAN.md, "Replying to a message"): a send with
// `reply` keeps what it answers as the message's `reply`, the whole message
// or the part selected, and the agent is told it with the message. A reply to
// a message that isn't in the chat is refused.
//
//     calx tests/protocol/reply.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, str_at}
import shared.client.{Session}
import tests.kit.{Instance, check}

// The next message made in `conversation` by `role`.
fn next_in(app: mut Session, conversation: String, role: str) -> Json ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String(role)) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return m }
    }
}

fn words(m: Json) -> String {
    var out = String()
    if let Json.Array(blocks) = at(m, "blocks") {
        for b in blocks {
            if str_at(b.copy(), "kind") == some(String("text")) { out.push_str(str_at(b, "text") ?? String()) }
        }
    }
    return out
}

fn send(app: Session, cid: str, chat: String, text: str, reply: Json) ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", chat).s("text", String(text)).j("reply", reply).done())
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Main")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()

    // A message, and the agent's answer to reply to.
    try send(app, "m_1", chat.copy(), "The build passed at 14:02.", Json.Null)
    let first = try next_in(mut app, chat.copy(), "person")
    let first_id = str_at(first.copy(), "id") ?? String()
    let answer = try next_in(mut app, chat.copy(), "agent")
    let answer_id = str_at(answer.copy(), "id") ?? String()
    _ = try app.until("event", "run.finished")

    // --- A part of the answer, selected ---
    try send(app, "m_2", chat.copy(), "/context\nWhich build?", Obj.new().s("message", answer_id.copy()).s("quote", String("14:02")).done())
    let mine = try next_in(mut app, chat.copy(), "person")
    let r = at(mine, "reply")
    try check(str_at(r.copy(), "message") == some(answer_id.copy()) and str_at(r.copy(), "role") == some(String("agent")) and str_at(r.copy(), "agent") == some(agent.copy()), "the message keeps what it replies to, and who said it")
    try check(str_at(r.copy(), "text") == some(String("14:02")) and bool_at(r, "part") == some(true), "and only the part selected")
    let told = words(try next_in(mut app, chat.copy(), "agent"))
    try check(told.contains("[loom: This message replies to this part of your message {answer_id}:\n> 14:02]"), "the agent is told what it replies to, and its id")
    _ = try app.until("event", "run.finished")

    // --- The person's own message, whole ---
    try send(app, "m_3", chat.copy(), "/context\nAgain", Obj.new().s("message", first_id.copy()).done())
    let again = try next_in(mut app, chat.copy(), "person")
    try check(str_at(at(again.copy(), "reply"), "text") == some(String("The build passed at 14:02.")) and bool_at(at(again, "reply"), "part") == none, "a whole message is quoted by its words")
    let told_again = words(try next_in(mut app, chat.copy(), "agent"))
    try check(told_again.contains("This message replies to their own message {first_id}:\n> The build passed at 14:02."), "and the agent hears it was the person's own")
    _ = try app.until("event", "run.finished")

    // --- A message that isn't in the chat ---
    try send(app, "m_4", chat.copy(), "Hm", Obj.new().s("message", String("msg_nope")).done())
    let refused = try app.until("error", "")
    try check(str_at(refused.copy(), "code") == some(String("bad_reply")) and str_at(refused, "ref") == some(String("m_4")), "a reply to a message that isn't there is refused")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nreply: all good")
}
