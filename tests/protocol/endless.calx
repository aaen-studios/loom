module tests.protocol.endless

// One endless chat (PLAN.md): when an agent's session says its context is
// nearly full, the next message goes to a fresh session, which is given the
// newest of the chat and told where the rest is. The chat itself goes on as
// one conversation, and a session with room keeps going.
//
//     calx tests/protocol/endless.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, str_at}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

fn reply_in(app: mut Session, conversation: String) -> Json ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return m }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return reply_text(try reply_in(mut app, conversation))
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Main")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()

    _ = try say(mut app, chat.copy(), "m_1", String("The password hint is kiwi."))
    let first = try say(mut app, chat.copy(), "m_2", String("/session"))
    _ = try say(mut app, chat.copy(), "m_3", String("/usage 500 1000\nhalf full"))
    let roomy = try say(mut app, chat.copy(), "m_4", String("/session"))
    try check(roomy == first, "a session with room keeps going")

    _ = try say(mut app, chat.copy(), "m_5", String("/usage 850 1000\nnearly full"))
    let fresh = try say(mut app, chat.copy(), "m_6", String("/session\n/context"))
    try check(not fresh.starts_with(first.copy()), "the message after a session nearly fills goes to a fresh one")
    try check(fresh.contains("goes on from an earlier session") and fresh.contains("kiwi") and fresh.contains("nearly full") and fresh.contains("search_messages"), "which is given the newest of the chat, and told where the rest is")
    try check(not fresh.contains("/session\n/context"), "but not the message it's answering, twice")
    let after = try say(mut app, chat.copy(), "m_7", String("/session\n/context"))
    try check(after.starts_with(fresh[..first.len()].copy()) and not after.contains("earlier session"), "and the next message stays in it, without being told again")

    // A session compacted once its turn has ended, as Claude's adapter compacts
    // an idle one, has room again: what it says with no run going is kept.
    _ = try say(mut app, chat.copy(), "m_8", String("/usage 900 1000\n/compacted 100 1000\nfull, then compacted"))
    let compacted = try say(mut app, chat.copy(), "m_9", String("/session"))
    try check(compacted.starts_with(fresh[..first.len()].copy()), "a session compacted after its turn keeps going")
    let listed = try app.cmd("q_3", "messages.list", Obj.new().s("conversation", chat).done())
    try check("{listed}".contains("The password hint is kiwi."), "the chat itself is one conversation, with everything in it")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nendless: all good")
}
