module tests.protocol.endless

// One endless chat (PLAN.md): when an agent's session says its context is
// nearly full, the next message goes to a fresh session, which is given the
// newest of the chat and told where the rest is. The chat itself goes on as
// one conversation, and a session with room keeps going.
//
//     calx tests/protocol/endless.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, int_at, str_at}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

fn reply_in(app: mut Session, conversation: String) -> Json ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return m }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return reply_text(try reply_in(mut app, conversation))
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Main")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()

    _ = try say(mut app, chat.copy(), "m_1", String("The password hint is kiwi."))
    let first = try say(mut app, chat.copy(), "m_2", String("/session"))
    _ = try say(mut app, chat.copy(), "m_3", String("/usage 500 1000\nhalf full"))
    let roomy = try say(mut app, chat.copy(), "m_4", String("/session"))
    try check(roomy == first, "a session with room keeps going")

    _ = try say(mut app, chat.copy(), "m_5", String("/usage 850 1000\nnearly full"))
    let fresh = try say(mut app, chat.copy(), "m_6", String("/session\n/context"))
    try check(not fresh.starts_with(first.copy()), "the message after a session nearly fills goes to a fresh one")
    try check(fresh.contains("goes on from an earlier session") and fresh.contains("kiwi") and fresh.contains("nearly full") and fresh.contains("search_messages"), "which is given the newest of the chat, and told where the rest is")
    try check(not fresh.contains("/session\n/context"), "but not the message it's answering, twice")
    let after = try say(mut app, chat.copy(), "m_7", String("/session\n/context"))
    try check(after.starts_with(fresh[..first.len()].copy()) and not after.contains("earlier session"), "and the next message stays in it, without being told again")

    // A session compacted once its turn has ended, as Claude's adapter compacts
    // an idle one, has room again: what it says with no run going is kept.
    _ = try say(mut app, chat.copy(), "m_8", String("/usage 900 1000\n/compacted 100 1000\nfull, then compacted"))
    let compacted = try say(mut app, chat.copy(), "m_9", String("/session"))
    try check(compacted.starts_with(fresh[..first.len()].copy()), "a session compacted after its turn keeps going")
    // A compaction during a turn is a line in the chat, not a step of the reply.
    let during = try say(mut app, chat.copy(), "m_10", String("/compact 700 50 1000\nstill here"))
    try check(during.contains("still here"), "a turn that compacts goes on")
    let listed = try app.cmd("q_3", "messages.list", Obj.new().s("conversation", chat.copy()).done())
    try check("{listed}".contains("The password hint is kiwi."), "the chat itself is one conversation, with everything in it")
    try check(not "{listed}".contains("Compact conversation"), "a compaction isn't a call in the reply")

    // The lines are kept with the chat: where a fresh session started, and
    // where the context was compacted, with its tokens before and after.
    var lines = List<String>()
    if let Json.Array(items) = at(at(listed, "value"), "messages") {
        for m in items {
            if str_at(m.copy(), "role") != some(String("loom")) { continue }
            lines.push("{at(m, "blocks")}")
        }
    }
    if lines.len() != 3 { fail "three lines in the chat, not {lines.len()}: {lines}" }
    try check(true, "three lines in the chat")
    try check(lines[0].contains(#""mark":"fresh""#), "a fresh session starts where the last one was nearly full")
    try check(lines[1].contains(#""mark":"compacted""#) and lines[1].contains(#""before":900"#) and lines[1].contains(#""after":100"#), "an idle compaction, from 900 to 100")
    try check(lines[2].contains(#""before":700"#) and lines[2].contains(#""after":50"#), "a compaction in a turn, from 700 to 50")

    // How full the context is goes to the apps with the conversation: from 0
    // in a fresh session, and small again after a compaction.
    var told = List<String>()
    for f in app.frames {
        if str_at(f.copy(), "kind") != some(String("conversation.updated")) { continue }
        let changed = at(f, "conversation")
        if str_at(changed.copy(), "id") != some(chat.copy()) { continue }
        let x = at(changed, "context")
        told.push("{int_at(x.copy(), "used") ?? -1}/{int_at(x, "size") ?? -1}")
    }
    try check(told.len() > 0 and told[0] == "500/1000", "the context goes to the apps once the program says it")
    try check(told.contains(String("0/1000")) and told.contains(String("100/1000")) and told[told.len() - 1] == "50/1000", "from nothing in a fresh session, and small after a compaction")
    let shown = try newest_context(app, chat.copy())
    try check(int_at(shown.copy(), "compacted") != none and "{shown}".contains(#""compacts":true"#), "with when it was last compacted, and that its program compacts one when asked")

    // Compact now: a quiet turn of the program's own /compact, which leaves no
    // reply, only the compaction's line, and what's sent meanwhile waits for it.
    _ = try say(mut app, chat.copy(), "m_11", String("/usage 600 1000\nfuller"))
    let compact = try app.cmd("q_4", "conversation.compact", Obj.new().s("conversation", chat.copy()).done())
    let compacting = str_at(at(compact, "value"), "run") ?? String()
    try check(compacting.len() > 0, "conversation.compact starts a turn")
    var quiet = false
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("run.started")) and str_at(f.copy(), "run") == some(compacting.copy()) { quiet = "{f}".contains(#""quiet":true"#) }
    }
    try check(quiet, "which is quiet")
    loop {
        let done = try app.until("event", "run.finished")
        if str_at(done, "run") == some(compacting.copy()) { break }
    }
    let after_compact = try app.cmd("q_6", "messages.list", Obj.new().s("conversation", chat.copy()).done())
    var newest = Json.Null
    var replies = 0
    if let Json.Array(items) = at(at(after_compact, "value"), "messages") {
        for m in items {
            if str_at(m.copy(), "role") == some(String("agent")) { replies += 1 }
            newest = m.copy()
        }
    }
    try check(replies == 11 and str_at(newest.copy(), "role") == some(String("loom")) and "{at(newest, "blocks")}".contains(#""before":600"#), "it leaves no reply, and a line from 600 tokens")
    let compacted_now = try newest_context(app, chat.copy())
    try check(int_at(compacted_now.copy(), "used") == some(60i64) and int_at(compacted_now, "compacted") != none, "the context is small again, and says when it was compacted")

    // Start a fresh session: a line in the chat now, the context from nothing,
    // and its next turn in a fresh session, given the newest of the chat.
    let fresh_now = try app.cmd("q_7", "conversation.fresh", Obj.new().s("conversation", chat.copy()).done())
    try check(at(fresh_now, "error") == Json.Null, "conversation.fresh is answered")
    let line = at(try app.event("message.created"), "message")
    try check(str_at(line.copy(), "role") == some(String("loom")) and "{at(line, "blocks")}".contains(#""mark":"fresh""#), "a line says a fresh session starts there")
    let emptied = try newest_context(app, chat.copy())
    try check(int_at(emptied.copy(), "used") == some(0i64) and int_at(emptied, "compacted") == none, "and the context starts again from nothing")
    let nothing = try app.cmd("q_8", "conversation.compact", Obj.new().s("conversation", chat.copy()).done())
    try check(str_at(at(nothing, "error"), "code") == some(String("bad_request")), "with nothing in it to compact")
    let asked = try say(mut app, chat.copy(), "m_12", String("/session\n/context"))
    try check(not asked.starts_with(fresh[..first.len()].copy()) and asked.contains("chose to start afresh") and asked.contains("kiwi"), "its next turn goes to a fresh session, given the newest of the chat")
    let stays = try say(mut app, chat.copy(), "m_13", String("/session\n/context"))
    try check(stays.starts_with(asked[..first.len()].copy()) and not stays.contains("earlier session"), "once")

    // A chat whose program hasn't said how full it is has nothing to compact.
    let other = str_at(at(try app.cmd("q_9", "conversation.create", Obj.new().s("agent", agent.copy()).done()), "value"), "conversation") ?? String()
    let untold = try app.cmd("q_10", "conversation.compact", Obj.new().s("conversation", other).done())
    try check(str_at(at(untold, "error"), "code") == some(String("bad_request")), "a chat with no context has nothing to compact")
    app.close()

    // A device that connects later has it with the conversation.
    let later = try Session.connect(i.base.copy(), i.token.copy(), 0)
    var seen = String()
    for f in later.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.updated")) { seen = "{at(at(f, "conversation"), "context")}" }
    }
    try check(seen.contains(#""used":0"#) and seen.contains(#""compacts":true"#), "a device that connects later has it")
    later.close()
}

// The context the apps were last told for `conversation`.
fn newest_context(app: Session, conversation: String) -> Json ! Error {
    var n = app.frames.len()
    while n > 0 {
        n -= 1
        let f = app.frames[n].copy()
        if str_at(f.copy(), "kind") != some(String("conversation.updated")) { continue }
        let changed = at(f, "conversation")
        if str_at(changed.copy(), "id") == some(conversation.copy()) and at(changed.copy(), "context") != Json.Null { return at(changed, "context") }
    }
    fail "no context for {conversation} came"
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nendless: all good")
}
