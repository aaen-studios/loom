module tests.protocol.routines

// Routines on a schedule (PLAN.md, "Routines"). A minute lasts 100 ms here,
// so a routine every 5 minutes runs every half second. It sends its agent the
// prompt in a quiet turn in the agent's chat (its newest conversation, or a
// new one when it has none), tells it the routine sent it and that the person
// sees nothing of the turn, and keeps nothing of it in the chat but what the
// agent posts, which notifies the person. routine.runs says how each run went
// and what its agent answered. Paused, it waits; run by hand, it runs
// once. A daily or weekday routine runs next at its time, in its time zone,
// on the real clock. An agent makes routines with the schedule tool, lists them, and
// deletes one only once the person says yes. A run goes on beside a turn in
// its chat, its post coming after the turn's reply, and a person's message
// while a routine runs goes at once.
//
//     calx tests/protocol/routines.calx
import std.json.{Json, parse}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, int_at, str_at}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

// The next reply in `conversation`, as text.
fn reply_in(app: mut Session, conversation: String) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return reply_text(m) }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

// The next routine.updated event for routine `id` that says its last run
// is `status`.
fn last_is(app: mut Session, id: String, status: str) -> Json ! Error {
    loop {
        let e = try app.until("event", "routine.updated")
        let r = at(e, "routine")
        if str_at(r.copy(), "id") == some(id.copy()) and str_at(at(r.copy(), "last"), "status") == some(String(status)) { return r }
    }
}

// Waits for run `run` to finish, if it hasn't already.
fn finished(app: mut Session, run_id: String) ! Error {
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("run.finished")) and str_at(f.copy(), "run") == some(run_id.copy()) { return }
    }
    loop {
        let e = try app.until("event", "run.finished")
        if str_at(e, "run") == some(run_id.copy()) { return }
    }
}

// The numbers in a JSON list.
fn ints(j: Json) -> List<i64> {
    var out = List<i64>()
    if let Json.Array(xs) = j {
        for x in xs { out.push(x.as_i64() ?? 0) }
    }
    return out
}

// Run `run` of routine `id`, as routine.runs gives it.
fn run_of(app: mut Session, q: str, id: String, which: String) -> Json ! Error {
    if let Json.Array(runs) = at(at(try app.cmd(q, "routine.runs", Obj.new().s("id", id).done()), "value"), "runs") {
        for r in runs {
            if str_at(r.copy(), "run") == some(which.copy()) { return r.copy() }
        }
    }
    fail "routine.runs doesn't have {which}"
}

fn run(i: Instance) -> i64 ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Main")).s("acp_agent", String("fake")).s("instructions", String("Test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()

    let bad = try app.cmd("q_2", "routine.put", Obj.new().s("name", String("Pulse")).s("agent", String("Main")).s("prompt", String("hi")).j("schedule", Obj.new().i("every", 1).done()).done())
    try check(bool_at(bad.copy(), "ok") == some(false) and str_at(at(bad, "error"), "code") == some(String("bad_request")), "a routine more often than every 5 minutes is refused")

    // At a time of day, on the real clock, in the routine's time zone.
    let daily = at(at(try app.cmd("q_d1", "routine.put", Obj.new().s("name", String("Brief")).s("agent", String("Main")).s("prompt", String("brief")).j("schedule", Obj.new().s("daily", String("08:00")).done()).done()), "value"), "routine")
    let daily_gap = (int_at(daily.copy(), "next") ?? 0) - (int_at(daily.copy(), "at") ?? 0)
    try check(str_at(daily.copy(), "when") == some(String("daily at 08:00")) and daily_gap > 0 and daily_gap <= 25 * 3600000, "a daily routine runs next at its time, within a day")
    let weekly = at(at(try app.cmd("q_d2", "routine.put", Obj.new().s("name", String("Standup")).s("agent", String("Main")).s("prompt", String("standup")).s("tz", String("America/New_York")).j("schedule", Obj.new().s("weekdays", String("09:30")).done()).done()), "value"), "routine")
    let weekly_gap = (int_at(weekly.copy(), "next") ?? 0) - (int_at(weekly.copy(), "at") ?? 0)
    try check(str_at(weekly.copy(), "when") == some(String("on weekdays at 09:30")) and str_at(weekly.copy(), "tz") == some(String("America/New_York")) and weekly_gap > 0 and weekly_gap <= 4 * 86400000, "one on weekdays takes the time zone it's given")
    let no_zone = try app.cmd("q_d3", "routine.put", Obj.new().s("name", String("X")).s("agent", String("Main")).s("prompt", String("x")).s("tz", String("Mars/Base")).j("schedule", Obj.new().s("daily", String("08:00")).done()).done())
    let no_time = try app.cmd("q_d4", "routine.put", Obj.new().s("name", String("X")).s("agent", String("Main")).s("prompt", String("x")).j("schedule", Obj.new().s("daily", String("25:00")).done()).done())
    try check(bool_at(no_zone, "ok") == some(false) and bool_at(no_time, "ok") == some(false), "a time zone loom doesn't know, or a time that isn't one, is refused")

    // Chosen days at several times, kept in order, with its next three runs.
    let chosen = at(at(try app.cmd("q_t1", "routine.put", Obj.new().s("name", String("Checks")).s("agent", String("Main")).s("prompt", String("check")).s("tz", String("Europe/Oslo")).j("schedule", parse(#"{"times":["17:00","08:00"],"days":["fri","mon","wed"]}"#)!).done()), "value"), "routine")
    let soon = ints(at(chosen.copy(), "upcoming"))
    try check("{at(chosen.copy(), "schedule")}" == #"{"times":["08:00","17:00"],"days":["mon","wed","fri"]}"# and str_at(chosen.copy(), "when") == some(String("on Mon, Wed and Fri at 08:00 and 17:00")), "chosen days at several times are kept in order, and said in words")
    try check(soon.len() == 3 and soon[0] == (int_at(chosen.copy(), "next") ?? 0) and soon[0] < soon[1] and soon[1] < soon[2] and soon[2] - soon[0] <= 5 * 86400000, "with its next three runs, the first its next")
    let windowed = at(at(try app.cmd("q_t2", "routine.put", Obj.new().s("name", String("Prices")).s("agent", String("Main")).s("prompt", String("prices")).j("schedule", parse(#"{"every":120,"from":"08:00","to":"20:00","days":["sat","sun"]}"#)!).done()), "value"), "routine")
    try check(str_at(windowed.copy(), "when") == some(String("every 2 hours from 08:00 to 20:00 on weekends")) and ints(at(windowed.copy(), "upcoming")).len() == 3, "every few hours within a window, on chosen days")
    let backwards = try app.cmd("q_t3", "routine.put", Obj.new().s("name", String("X")).s("agent", String("Main")).s("prompt", String("x")).j("schedule", parse(#"{"every":120,"from":"20:00","to":"08:00"}"#)!).done())
    let no_days = try app.cmd("q_t4", "routine.put", Obj.new().s("name", String("X")).s("agent", String("Main")).s("prompt", String("x")).j("schedule", parse(#"{"times":["08:00"],"days":[]}"#)!).done())
    try check(str_at(at(backwards, "error"), "code") == some(String("bad_request")) and str_at(at(no_days, "error"), "code") == some(String("bad_request")), "a window that ends before it starts, or no days, is refused")
    // What a schedule would do, before it's kept.
    let would = at(try app.cmd("q_t5", "routine.next", Obj.new().j("schedule", parse(#"{"times":["09:00"],"days":["sun"]}"#)!).s("tz", String("Asia/Tokyo")).done()), "value")
    let would_times = ints(at(would.copy(), "next"))
    try check(would_times.len() == 3 and would_times[1] - would_times[0] == 7 * 86400000 and str_at(would.copy(), "when") == some(String("on Sun at 09:00")) and str_at(would, "tz") == some(String("Asia/Tokyo")), "routine.next says when a schedule would run, and how it reads")
    let not_one = try app.cmd("q_t6", "routine.next", Obj.new().j("schedule", parse(#"{"times":["noon"]}"#)!).done())
    try check(str_at(at(not_one, "error"), "code") == some(String("bad_request")), "and refuses one that isn't a schedule")
    // A week of them, for the calendar.
    let week_from = (int_at(chosen.copy(), "at") ?? 0)
    let week_to = week_from + 7 * 86400000
    let week = at(at(try app.cmd("q_t7", "routine.calendar", Obj.new().i("from", week_from).i("to", week_to).done()), "value"), "routines")
    var checks_week = List<i64>()
    if let Json.Array(all) = week {
        for x in all {
            if str_at(x.copy(), "id") == str_at(chosen.copy(), "id") { checks_week = ints(at(x, "times")) }
        }
    }
    var inside = true
    for t in checks_week {
        if t < week_from or t >= week_to { inside = false }
    }
    try check(checks_week.len() >= 5 and checks_week.len() <= 7 and inside and checks_week[0] == soon[0], "routine.calendar gives each routine's times in the week")
    let too_long = try app.cmd("q_t8", "routine.calendar", Obj.new().i("from", week_from).i("to", week_from + 30 * 86400000).done())
    try check(str_at(at(too_long, "error"), "code") == some(String("bad_request")), "and no more than 8 days at once")
    _ = try app.cmd("q_t9", "routine.delete", Obj.new().s("id", str_at(chosen, "id") ?? String()).done())
    _ = try app.cmd("q_t10", "routine.delete", Obj.new().s("id", str_at(windowed, "id") ?? String()).done())
    _ = try app.cmd("q_d5", "routine.delete", Obj.new().s("id", str_at(daily, "id") ?? String()).done())
    _ = try app.cmd("q_d6", "routine.delete", Obj.new().s("id", str_at(weekly, "id") ?? String()).done())

    let put = try app.cmd("q_3", "routine.put", Obj.new().s("name", String("Pulse")).s("agent", String("Main")).s("prompt", String("/mcp routine_post \{\"text\": \"pulse\"\}\n/context")).j("schedule", Obj.new().i("every", 5).done()).done())
    let r = at(at(put, "value"), "routine")
    let id = str_at(r.copy(), "id") ?? String()
    try check(str_at(r.copy(), "agent") == some(agent.copy()) and str_at(r.copy(), "when") == some(String("every 5 minutes")) and str_at(r.copy(), "tz") == some(String("Europe/Oslo")) and bool_at(r.copy(), "notify") == some(true) and (int_at(r, "next") ?? 0) > 0, "a routine is made, for the agent named, in the device's time zone, notifying")

    // It runs on its own. The agent has no conversation yet, so it starts one.
    let running = try last_is(mut app, id.copy(), "running")
    let conversation = str_at(running.copy(), "conversation") ?? String()
    let from = app.frames.len()
    let first = try reply_in(mut app, conversation.copy())
    try check(first == "pulse", "it runs on schedule, and what its agent posts is in the chat")
    let notified = try app.until("event", "notify")
    try check(str_at(notified.copy(), "title") == some(String("Pulse")) and str_at(notified.copy(), "conversation") == some(conversation.copy()) and str_at(notified, "body") == some(String("pulse")), "the person is notified with the post")
    _ = try last_is(mut app, id.copy(), "done")
    var shown = List<String>()
    for f in app.frames[from..] {
        if str_at(f.copy(), "kind") == some(String("message.created")) { shown.push(reply_text(at(f.copy(), "message"))) }
    }
    try check(shown == [String("pulse")], "and nothing else of the run: not its prompt, nor its agent's answer")
    let first_run = str_at(at(running, "last"), "run") ?? String()
    let ran = try run_of(mut app, "q_r1", id.copy(), first_run)
    let said = str_at(ran.copy(), "said") ?? String()
    try check((int_at(ran.copy(), "started") ?? 0) >= (int_at(ran.copy(), "at") ?? 0) and (int_at(ran.copy(), "ended") ?? 0) >= (int_at(ran.copy(), "started") ?? 1) and at(ran.copy(), "hint") == Json.Null, "a run keeps when it started and ended, and one that went well has no hint")
    try check(str_at(ran.copy(), "status") == some(String("done")) and str_at(ran.copy(), "by") == some(String("schedule")) and at(ran, "posted") == Json.Array([Json.Str(String("pulse"))]) and said.contains("routine \"Pulse\", run every 5 minutes") and said.contains("Your person sees nothing of this turn"), "its runs say how it went and what its agent answered, which knew a routine sent it, quietly")
    let again = try last_is(mut app, id.copy(), "running")
    try check(str_at(again.copy(), "conversation") == some(conversation.copy()), "and it runs again, in the same conversation")

    let paused = try app.cmd("q_4", "routine.put", Obj.new().s("id", id.copy()).b("on", false).done())
    try check(int_at(at(at(paused, "value"), "routine"), "next") == some(0), "paused, it isn't due")
    try finished(mut app, str_at(at(again, "last"), "run") ?? String())
    let by_hand = try app.cmd("q_5", "routine.run", Obj.new().s("id", id.copy()).done())
    let hand_run = str_at(at(by_hand, "value"), "run") ?? String()
    try check(hand_run.len() > 0, "run by hand, it runs")
    try finished(mut app, hand_run.copy())
    let hand = try run_of(mut app, "q_r2", id.copy(), hand_run)
    try check((str_at(hand, "said") ?? String()).contains("run now, as the person asked"), "and its agent knows that")

    // An agent makes one, lists them, and asks to delete one.
    let c = try app.cmd("q_6", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()
    let scheduled = try say(mut app, chat.copy(), "m_1", String(#"/mcp schedule {"name":"Hourly","prompt":"hi","schedule":{"every":60}}"#))
    try check(scheduled.starts_with("schedule: Scheduled: Hourly, every hour, as routine "), "an agent makes a routine with schedule")
    let twice = try say(mut app, chat.copy(), "m_1b", String(#"/mcp schedule {"name":"Twice","prompt":"hi","on":false,"schedule":{"times":["17:00","08:00"],"days":["mon","tue","wed","thu","fri"]}}"#))
    try check(twice.starts_with("schedule: Scheduled: Twice, on weekdays at 08:00 and 17:00 (Europe/Oslo time), as routine "), "and on chosen days at several times")
    let listed = try say(mut app, chat.copy(), "m_2", String("/mcp list_routines"))
    try check(listed.contains("Hourly") and listed.contains("Pulse") and listed.contains("Twice"), "and lists them")
    let routines = at(at(try app.cmd("q_7", "routine.list", Obj.new().done()), "value"), "routines")
    var hourly_id = String()
    var twice_id = String()
    if let Json.Array(all) = routines {
        for x in all {
            if str_at(x.copy(), "name") == some(String("Hourly")) { hourly_id = str_at(x.copy(), "id") ?? String() }
            if str_at(x.copy(), "name") == some(String("Twice")) { twice_id = str_at(x, "id") ?? String() }
        }
    }
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_3")).s("conversation", chat.copy()).s("text", "/mcp delete_routine \{\"id\":\"{hourly_id}\"\}").done())
    let asked = try app.until("event", "approval.needed")
    try check(str_at(asked.copy(), "title") == some(String("Delete the routine Hourly")), "deleting one asks the person")
    try app.send(Obj.new().s("t", String("approve")).s("call", str_at(asked, "call") ?? String()).b("allow", true).done())
    let deleted = try app.until("event", "routine.deleted")
    try check(str_at(deleted, "routine") == some(hourly_id), "and a yes deletes it")
    _ = try reply_in(mut app, chat.copy())
    // The person's chat is the agent's newest now, so the routine posts there.
    _ = try app.cmd("q_11", "routine.run", Obj.new().s("id", id.copy()).done())
    try check((try reply_in(mut app, chat.copy())).contains("pulse"), "a routine posts into its agent's chat, the conversation the person last used")

    _ = try app.cmd("q_8", "routine.delete", Obj.new().s("id", id).done())
    _ = try app.cmd("q_8b", "routine.delete", Obj.new().s("id", twice_id).done())
    let left = "{at(at(try app.cmd("q_9", "routine.list", Obj.new().done()), "value"), "routines")}"
    try check(left == "[]", "the person deletes one")
    let logged = "{at(try app.cmd("q_10", "activity.list", Obj.new().s("agent", agent).done()), "value")}"
    try check(logged.contains("Made the routine Pulse") and logged.contains("Ran the routine Pulse") and logged.contains("Deleted the routine Hourly"), "the activity log has the routines")

    // A run goes on beside a turn in its chat, in a session of its own: it
    // doesn't wait for the turn, and what it posts goes in once the turn is over.
    let beside = str_at(at(at(try app.cmd("q_w1", "routine.put", Obj.new().s("name", String("Beside")).s("agent", String("Main")).s("prompt", String("/mcp routine_post \{\"text\": \"beside\"\}")).j("schedule", Obj.new().i("every", 600).done()).b("on", false).done()), "value"), "routine"), "id") ?? String()
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_4")).s("conversation", chat.copy()).s("text", String("/nap 3000\nawake")).done())
    _ = try app.until("event", "run.started")
    let ran_beside = at(try app.cmd("q_w2", "routine.run", Obj.new().s("id", beside.copy()).done()), "value")
    try check(at(ran_beside.copy(), "waiting") == Json.Null and (str_at(ran_beside.copy(), "run") ?? String()).len() > 0, "run while the person's turn goes on, it doesn't wait for it")
    _ = try last_is(mut app, beside.copy(), "done")
    let beside_run = try run_of(mut app, "q_w3", beside.copy(), str_at(ran_beside, "run") ?? String())
    try check(at(beside_run, "posted") == Json.Array([Json.Str(String("beside"))]), "and ends before the turn does, having posted")
    try check((try reply_in(mut app, chat.copy())) == "awake", "the person's turn goes on as it was, and its reply comes first")
    try check((try reply_in(mut app, chat.copy())) == "beside", "then the routine's post, after the reply")
    // A person's message while a routine runs goes at once, not behind it.
    let slow = str_at(at(at(try app.cmd("q_w4", "routine.put", Obj.new().s("name", String("Slow")).s("agent", String("Main")).s("prompt", String("/nap 3000\nslow")).j("schedule", Obj.new().i("every", 600).done()).b("on", false).done()), "value"), "routine"), "id") ?? String()
    let slow_run = str_at(at(try app.cmd("q_w5", "routine.run", Obj.new().s("id", slow.copy()).done()), "value"), "run") ?? String()
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_5")).s("conversation", chat.copy()).s("text", String("now")).done())
    let ack = try app.until("ack", "")
    try check(at(ack, "queued") == Json.Null, "a person's message while a routine runs isn't queued behind it")
    try check((try reply_in(mut app, chat.copy())) == "now", "and is answered at once")
    try check(str_at(try run_of(mut app, "q_w6", slow.copy(), slow_run.copy()), "status") == some(String("running")), "while the routine's run goes on")
    try finished(mut app, slow_run)
    _ = try app.cmd("q_w7", "routine.delete", Obj.new().s("id", beside).done())
    _ = try app.cmd("q_w8", "routine.delete", Obj.new().s("id", slow).done())

    // Two more, for while the instance is off: one catches up, one doesn't.
    _ = try app.cmd("q_12", "routine.put", Obj.new().s("name", String("Quiet")).s("agent", String("Main")).s("prompt", String("quiet")).j("schedule", Obj.new().i("every", 5).done()).b("catch_up", false).done())
    _ = try app.cmd("q_13", "routine.put", Obj.new().s("name", String("Loud")).s("agent", String("Main")).s("prompt", String("loud")).j("schedule", Obj.new().i("every", 5).done()).done())
    let seq = app.seq
    app.close()
    return seq
}

// Off for a few of their gaps: Quiet waits for its next time, and Loud runs once.
fn after_restart(i: Instance, seq: i64) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), seq)
    // What came while it connected first, as the catch-up replays it, then what comes live.
    var seen = List<Json>()
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("routine.updated")) { seen.push(at(f.copy(), "routine")) }
    }
    var quiet = String()
    var quiet_id = String()
    var loud = String()
    var loud_done = false
    var n: usize = 0
    while quiet.len() == 0 or loud.len() == 0 or not loud_done {
        let r = if n < seen.len() { seen[n].copy() } else { at(try app.until("event", "routine.updated"), "routine") }
        n += 1
        let status = str_at(at(r.copy(), "last"), "status") ?? String()
        if str_at(r.copy(), "name") == some(String("Quiet")) {
            if quiet.len() == 0 {
                quiet = status
                quiet_id = str_at(r, "id") ?? String()
            }
        } else if str_at(r, "name") == some(String("Loud")) {
            if loud.len() == 0 { loud = status.copy() }
            if status == "quiet" { loud_done = true }
        }
    }
    try check(quiet == "skipped" and loud == "running", "missed while the instance was off, one routine runs once and one waits, as each says")
    var missed = false
    if let Json.Array(runs) = at(at(try app.cmd("q_m1", "routine.runs", Obj.new().s("id", quiet_id).done()), "value"), "runs") {
        for x in runs {
            if str_at(x.copy(), "status") == some(String("skipped")) and str_at(x, "error") == some(String("It was missed while the instance was off.")) { missed = true }
        }
    }
    try check(missed, "the one that waits keeps the time it missed in its runs, with why")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start_with([String("--test-minute-ms"), String("100")])
    var failure: String? = none
    var seq: i64 = 0
    match run(inst.copy()) {
        ok(s) => seq = s,
        err(e) => failure = some("{e}"),
    }
    if let f = failure {
        inst.stop()
        eprintln("\n{f}")
        exit(1)
    } else {
        let back = try inst.restart_with([String("--test-minute-ms"), String("100")], 1500)
        match after_restart(back.copy(), seq) {
            ok => {},
            err(e) => failure = some("{e}"),
        }
        back.stop()
    }
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nroutines: all good")
}
