module tests.protocol.tools

// Loom's own tools (PLAN.md, "Loom's own tools"): every ACP session is given
// `loom mcp`, and the fake agent calls it as a real agent would. An agent
// lists the tools and the agents, hands work to another agent and gets its
// reply, edits its own instructions, makes and changes agents but never their
// permission mode, and sends a notification. Each change to an agent is a
// revision, and one can be rolled back to. The activity log keeps all of it.
// Skills an agent saves reach every agent, and each agent's folder.
// Each session is told where the
// person is writing from, or that a message came from another agent. The tool
// endpoints refuse a request without the agent's token.
//
//     calx tests/protocol/tools.calx
import std.fs
import std.http.{Header, get}
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, int_at, str_at}
import tests.kit.{App, Instance, check, reply_text}

// The agent's next reply in `conversation`, as text.
fn reply_in(app: mut App, conversation: String) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return reply_text(m) }
    }
}

// Says `text` in `conversation`, and gives the reply.
fn say(app: mut App, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

fn agent(app: mut App, id: str, name: str) -> String ! Error {
    let made = try app.cmd(id, "agent.create", Obj.new().s("name", String(name)).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    return str_at(at(at(made, "value"), "agent"), "id") ?? String()
}

// The newest event of `kind` among what the app has read.
fn last(app: App, kind: str) -> Json {
    var found = Json.Null
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String(kind)) { found = f.copy() }
    }
    return found
}

fn run(i: Instance) ! Error {
    var req = get("http://{i.base}/api/mcp/tools", List<Header>(), 10000, 65536)
    try check((try req.wait()).status == 401, "loom's tools need an agent's token")

    var app = try App.connect(i.base.copy(), i.token.copy(), 0)
    let main_id = try agent(mut app, "q_1", "Main")
    _ = try agent(mut app, "q_2", "Helper")
    let c = try app.cmd("q_3", "conversation.create", Obj.new().s("agent", main_id.copy()).done())
    let conversation = str_at(at(c, "value"), "conversation") ?? String()

    let listed = try say(mut app, conversation.copy(), "m_1", String("/mcp list"))
    try check(listed.contains("message_agent") and listed.contains("edit_instructions") and listed.contains("notify"), "an agent's session has loom's tools")
    let agents = try say(mut app, conversation.copy(), "m_2", String("/mcp list_agents"))
    try check(agents.contains("Helper") and agents.contains("Main"), "list_agents gives the person's agents")

    let handed = try say(mut app, conversation.copy(), "m_3", String(#"/mcp message_agent {"agent":"helper","text":"hello from main"}"#))
    try check(handed == "message_agent: hello from main", "message_agent gives the other agent's reply")
    let made = last(app, "conversation.created")
    try check(str_at(at(made, "conversation"), "title") == some(String("From Main")), "in a conversation of its own")
    let again = try say(mut app, conversation.copy(), "m_4", String(#"/mcp message_agent {"agent":"Helper","text":"again"}"#))
    try check(again == "message_agent: again" and str_at(at(last(app, "conversation.created"), "conversation"), "title") == some(String("From Main")), "and the next message goes to the same one")
    var conversations: usize = 0
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.created")) { conversations += 1 }
    }
    try check(conversations == 2, "the two keep one conversation")
    let self_talk = try say(mut app, conversation.copy(), "m_5", String(#"/mcp message_agent {"agent":"Main","text":"hi"}"#))
    try check(self_talk.starts_with("message_agent failed"), "an agent can't message itself")

    let edited = try say(mut app, conversation.copy(), "m_6", String(#"/mcp edit_instructions {"instructions":"Be brief."}"#))
    let updated = at(last(app, "agent.updated"), "agent")
    try check(edited.starts_with("edit_instructions:") and str_at(updated.copy(), "id") == some(main_id.copy()) and str_at(updated, "instructions") == some(String("Be brief.")), "edit_instructions changes the agent's own instructions")

    _ = try say(mut app, conversation.copy(), "m_7", String(#"/mcp update_agent {"agent":"Helper","name":"Helper 2","permission":"allow"}"#))
    let changed = at(last(app, "agent.updated"), "agent")
    try check(str_at(changed.copy(), "name") == some(String("Helper 2")) and str_at(changed, "permission") == some(String("ask")), "update_agent renames an agent, but leaves its permission mode")

    _ = try say(mut app, conversation.copy(), "m_8", String(#"/mcp create_agent {"name":"Third","acp_agent":"fake","instructions":"Hi.","permission":"allow"}"#))
    let third = at(last(app, "agent.created"), "agent")
    try check(str_at(third.copy(), "name") == some(String("Third")) and str_at(third, "permission") == some(String("ask")), "create_agent makes an agent that asks first")

    let sent = try say(mut app, conversation.copy(), "m_9", String(#"/mcp notify {"title":"Build","body":"It failed."}"#))
    let note = last(app, "notify")
    try check(sent == "notify: Sent." and str_at(note.copy(), "title") == some(String("Build")) and str_at(note, "agent") == some(main_id.copy()), "notify sends the person a notification")

    let unknown = try say(mut app, conversation, "m_10", String("/mcp delete_everything"))
    try check(unknown.starts_with("delete_everything failed"), "there's no tool that isn't on the list")

    // --- Revisions ---
    let revisions = try app.cmd("q_rev", "agent.revisions", Obj.new().s("agent", main_id.copy()).done())
    var listed_revisions = List<Json>()
    if let Json.Array(rs) = at(at(revisions, "value"), "revisions") { listed_revisions = rs.copy() }
    try check(listed_revisions.len() == 2 and int_at(listed_revisions[0].copy(), "revision") == some(2) and str_at(listed_revisions[0].copy(), "by") == some(main_id.copy()), "each change is a revision, and says who made it")
    let back = try app.cmd("q_back", "agent.rollback", Obj.new().s("agent", main_id.copy()).i("revision", 1).done())
    let rolled = at(at(back, "value"), "agent")
    try check(str_at(rolled.copy(), "instructions") == some(String("You are a test.")) and int_at(rolled, "revision") == some(3), "rolling back makes a new revision with the old instructions")

    // --- The activity log ---
    let logged = try app.cmd("q_act", "activity.list", Obj.new().s("agent", main_id.copy()).done())
    let entries = "{at(at(logged, "value"), "activity")}"
    try check(entries.contains("Asked Helper: hello from main") and entries.contains("Notified you: Build") and entries.contains("Changed: revision 2") and entries.contains("Made Main"), "the activity log has what the agent did, and what was done to it")
    let everyone = try app.cmd("q_act2", "activity.list", Obj.new().i("limit", 3).done())
    var first_three = List<Json>()
    if let Json.Array(es) = at(at(everyone, "value"), "activity") { first_three = es.copy() }
    try check(first_three.len() == 3 and str_at(first_three[0].copy(), "text") == some(String("Changed: revision 3")), "newest first, for every agent")

    // --- Where the person is writing from ---
    let c2 = try app.cmd("q_4", "conversation.create", Obj.new().s("agent", main_id.copy()).done())
    let fresh = str_at(at(c2, "value"), "conversation") ?? String()
    let first = try say(mut app, fresh.copy(), "m_11", String("/context"))
    try check(first.contains("Desk PC") and first.contains("Europe/Oslo") and first.contains("UTC"), "a new session is told which device the person writes from")
    let second = try say(mut app, fresh.copy(), "m_12", String("/context"))
    try check(second == "no context", "and isn't told again while it's the same")
    let relayed = try say(mut app, fresh.copy(), "m_13", String(#"/mcp message_agent {"agent":"Third","text":"/context"}"#))
    try check(relayed.contains("Main, another of the person's agents") and relayed.contains("never the person's approval"), "an agent hears when a message comes from another agent")

    // --- Skills ---
    let saved = try say(mut app, fresh.copy(), "m_14", String(#"/mcp save_skill {"name":"release-notes","description":"Writing release notes.","body":"Keep them short."}"#))
    try check(saved.starts_with("save_skill: Saved"), "an agent saves a skill")
    let skills = try say(mut app, fresh.copy(), "m_15", String("/mcp list_skills"))
    let read = try say(mut app, fresh.copy(), "m_16", String(#"/mcp read_skill {"name":"release-notes"}"#))
    try check(skills.contains("release-notes") and skills.contains("Writing release notes.") and read == "read_skill: Keep them short.", "and every agent lists it and reads it")
    let bad = try say(mut app, fresh, "m_17", String(#"/mcp save_skill {"name":"Bad Name","description":"x","body":"y"}"#))
    try check(bad.starts_with("save_skill failed"), "a skill's name is checked")
    let file = "{i.data}/agents/{main_id}/.claude/skills/release-notes/SKILL.md"
    let written = try fs.read_text(file.copy()) ?? String()
    try check(written.contains("name: release-notes") and written.contains("description: Writing release notes.") and written.contains("Keep them short."), "it's in each agent's folder as a Claude Code skill")
    _ = try app.cmd("q_del", "skill.delete", Obj.new().s("name", String("release-notes")).done())
    try check(not fs.exists(file), "and taken out again when it's deleted")

    // --- What waits for the person's yes ---
    let c3 = try app.cmd("q_5", "conversation.create", Obj.new().s("agent", main_id.copy()).done())
    let risky = str_at(at(c3, "value"), "conversation") ?? String()
    let self_raise = try say(mut app, risky.copy(), "m_18", String(#"/mcp set_permission {"agent":"Main","permission":"allow"}"#))
    try check(self_raise.starts_with("set_permission failed"), "an agent can't loosen its own permission mode")
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_19")).s("conversation", risky.copy()).s("text", String(#"/mcp set_permission {"agent":"Helper 2","permission":"auto"}"#)).done())
    let asked = try app.until("event", "approval.needed")
    try check(str_at(asked.copy(), "title") == some(String("Set Helper 2's permission mode to auto")) and bool_at(asked.copy(), "can_always") == some(false), "changing another's permission mode asks the person")
    try app.send(Obj.new().s("t", String("approve")).s("call", str_at(asked, "call") ?? String()).b("allow", false).done())
    let no = try app.until("event", "tool.finished")
    let told_no = try reply_in(mut app, risky.copy())
    try check(str_at(no, "status") == some(String("denied")) and told_no.starts_with("set_permission failed") and told_no.contains("said no"), "and a no is passed back to the agent")
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_20")).s("conversation", risky.copy()).s("text", String(#"/mcp delete_agent {"agent":"Third"}"#)).done())
    let delete = try app.until("event", "approval.needed")
    try check(str_at(delete.copy(), "title") == some(String("Delete the agent Third")) and str_at(delete.copy(), "tool") == some(String("delete")), "deleting an agent asks the person")
    try app.send(Obj.new().s("t", String("approve")).s("call", str_at(delete, "call") ?? String()).b("allow", true).done())
    _ = try app.until("event", "agent.deleted")
    let yes = try app.until("event", "tool.finished")
    let done = try reply_in(mut app, risky.copy())
    try check(str_at(yes, "status") == some(String("done")) and done.contains("your person said yes"), "and a yes does it")
    let left = try say(mut app, risky, "m_21", String("/mcp list_agents"))
    var loosened = false
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("agent.updated")) and str_at(at(f.copy(), "agent"), "permission") != some(String("ask")) { loosened = true }
    }
    try check(not left.contains("Third") and not loosened, "Third is gone, and no permission mode changed")

    // --- Memory ---
    let c4 = try app.cmd("q_m1", "conversation.create", Obj.new().s("agent", main_id.copy()).done())
    let notes = str_at(at(c4, "value"), "conversation") ?? String()
    let kept = try say(mut app, notes.copy(), "m_m1", String(#"/mcp remember {"text":"The deploy key is in 1Password, under Servers."}"#))
    _ = try say(mut app, notes.copy(), "m_m2", String(#"/mcp remember {"text":"Elliot likes short answers.","shared":true}"#))
    let found = try say(mut app, notes.copy(), "m_m3", String(#"/mcp recall {"query":"deploy keys"}"#))
    try check(kept.starts_with("remember: Remembered, as note") and found.contains("1Password") and not found.contains("short answers"), "an agent remembers a note, and recalls it by its words")
    let fourth = try agent(mut app, "q_m2", "Fourth")
    let c5 = try app.cmd("q_m3", "conversation.create", Obj.new().s("agent", fourth).done())
    let theirs = str_at(at(c5, "value"), "conversation") ?? String()
    let other = try say(mut app, theirs.copy(), "m_m4", String("/mcp recall"))
    try check(other.contains("(shared): Elliot likes short answers.") and not other.contains("1Password"), "another agent reads only the shared notes")
    let every = "{try app.cmd("q_m4", "memory.list", Obj.new().done())}"
    try check(every.contains("1Password") and every.contains("short answers"), "the person sees every note")
    let refused = try say(mut app, theirs, "m_m5", String(#"/mcp forget {"id":1}"#))
    try check(refused.starts_with("forget failed"), "an agent can't forget another's note")
    _ = try app.cmd("q_m5", "memory.delete", Obj.new().i("id", 1).done())
    let gone = try say(mut app, notes, "m_m6", String(#"/mcp recall {"query":"1Password"}"#))
    try check(gone == "recall: Nothing remembered about 1Password.", "and the person can delete one")

    // --- The person's profile ---
    _ = try app.cmd("q_p1", "profile.put", Obj.new().s("text", String("Elliot, in Oslo. Short answers.")).done())
    let c6 = try app.cmd("q_p2", "conversation.create", Obj.new().s("agent", main_id.copy()).done())
    let about = str_at(at(c6, "value"), "conversation") ?? String()
    let told = try say(mut app, about.copy(), "m_p1", String("/context"))
    try check(told.contains("About the person") and told.contains("Elliot, in Oslo. Short answers."), "a new session starts with the person's profile")
    try check(try say(mut app, about.copy(), "m_p2", String("/context")) == "no context", "and isn't told it again")
    _ = try say(mut app, about.copy(), "m_p3", String(#"/mcp update_profile {"text":"Elliot, in Oslo. Short answers. Builds loom."}"#))
    let retold = try say(mut app, about, "m_p4", String("/context"))
    let profile = at(at(try app.cmd("q_p3", "profile.get", Obj.new().done()), "value"), "profile")
    try check(retold.contains("Builds loom.") and int_at(profile.copy(), "revision") == some(2) and str_at(profile, "by") == some(main_id.copy()), "an agent updates it, and every session hears the new one")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\ntools: all good")
}
