module tests.protocol.rooms

// Group chats (PLAN.md, "Group chats"): loom makes none for a person with two
// agents, a group chat is made with some of them, and each message in one goes
// to one member: the router's pick, among the members only, falling back to the
// chat's default; the one an @mention names, with no router call; and the one
// the person re-sends it to, which is kept as a correction the router follows
// next time. A member hands a message on with hand_off, and the next answers
// it. A chat with one agent never routes, and a pin in a group chat isn't in a
// member's own chat. The fake agent plays the router (tests/fake_agent).
//
//     calx tests/protocol/rooms.calx
import std.json.{Json}
import std.process.{exit}
import std.sqlite.{Database, Value}
import shared.obj.{Obj, at, int_at, str_at}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

fn agent(app: mut Session, id: str, name: str, instructions: str) -> String ! Error {
    let made = try app.cmd(id, "agent.create", Obj.new().s("name", String(name)).s("acp_agent", String("fake")).s("instructions", String(instructions)).done())
    return str_at(at(at(made, "value"), "agent"), "id") ?? String()
}

// The run.started and the reply of the next turn in `conversation`.
fn next_turn(app: mut Session, conversation: String) -> (Json, Json) ! Error {
    var started = Json.Null
    loop {
        let e = try app.until("event", "")
        let kind = str_at(e.copy(), "kind") ?? String()
        if kind == "run.started" and str_at(e.copy(), "conversation") == some(conversation.copy()) { started = e.copy() }
        if kind == "message.created" {
            let m = at(e, "message")
            if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return (started, m) }
        }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> (Json, Json) ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try next_turn(mut app, conversation)
}

// A number in a command's value, or 0.
fn num(value: Json, key: str) -> i64 {
    return int_at(value, key) ?? 0
}

fn by(m: Json) -> String {
    return str_at(at(m, "routed"), "by") ?? String()
}

// Until the run `id` has finished, as it may have already.
fn finished(app: mut Session, id: String) ! Error {
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("run.finished")) and str_at(f, "run") == some(id.copy()) { return }
    }
    loop {
        let done = try app.until("event", "run.finished")
        if str_at(done, "run") == some(id.copy()) { return }
    }
}

// The context the apps were last told for `conversation`.
fn shown_context(app: Session, conversation: String) -> Json {
    var shown = Json.Null
    for f in app.frames {
        let changed = at(f.copy(), "conversation")
        if str_at(f.copy(), "kind") == some(String("conversation.updated")) and str_at(changed.copy(), "id") == some(conversation.copy()) and at(changed.copy(), "context") != Json.Null { shown = at(changed, "context") }
    }
    return shown
}

// What the frames read so far wrote: the ids of loom's lines made in `conversation`,
// and how many messages or contexts went anywhere but a chat, as a member's seat
// (CONVERSATION/AGENT) or the router's session.
fn lines_in(app: Session, conversation: String) -> (List<String>, usize) {
    var lines = List<String>()
    var astray: usize = 0
    for f in app.frames {
        let kind = str_at(f.copy(), "kind") ?? String()
        let to = if kind == "conversation.updated" { str_at(at(f.copy(), "conversation"), "id") ?? String() } else if kind.starts_with("message.") { str_at(f.copy(), "conversation") ?? String() } else { String() }
        if to.contains("/") or to == "route" { astray += 1 }
        let m = at(f, "message")
        if kind == "message.created" and to == conversation and str_at(m.copy(), "role") == some(String("loom")) { lines.push(str_at(m, "id") ?? String()) }
    }
    return (lines, astray)
}

// What `sql` counts in the instance's database, with `value` for its one parameter.
fn count(i: Instance, sql: str, value: String) -> i64 ! Error {
    let db = try Database.open("{i.data}/loom.db")
    let row = try db.query_one(String(sql), [Value.Text(value.copy())]) else return 0
    return match row[0].copy() {
        Value.Int(n) => n,
        _ => 0,
    }
}

// The ids of loom's lines kept in `conversation`, and their blocks, oldest first.
fn kept_lines(app: mut Session, id: str, conversation: String) -> (List<String>, List<String>) ! Error {
    var ids = List<String>()
    var blocks = List<String>()
    if let Json.Array(items) = at(at(try app.cmd(id, "messages.list", Obj.new().s("conversation", conversation).done()), "value"), "messages") {
        for m in items {
            if str_at(m.copy(), "role") != some(String("loom")) { continue }
            ids.push(str_at(m.copy(), "id") ?? String())
            blocks.push("{at(m, "blocks")}")
        }
    }
    return (ids, blocks)
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    _ = try app.cmd("q_0", "defaults.put", Obj.new().s("router_brain", String("fake")).done())
    let ledger = try agent(mut app, "q_1", "Ledger", "Keeps money and bills.")
    let hermes = try agent(mut app, "q_2", "Hermes", "Reads and writes mail.")

    // --- Loom makes no group chat of its own ---
    // A device connecting once the person has two agents, where loom once made
    // Everyone, gets none.
    var device = try Session.connect(i.base.copy(), i.token.copy(), 0)
    _ = try device.cmd("q_20", "agent.update", Obj.new().s("agent", hermes.copy()).s("for", String("Reads and writes mail.")).done())
    var made_rooms: usize = 0
    for f in device.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.created")) and at(at(f, "conversation"), "room") != Json.Null { made_rooms += 1 }
    }
    device.close()
    try check(made_rooms == 0 and try count(i, "SELECT COUNT(*) FROM rooms WHERE conversation != ?", String()) == 0, "a person with two agents gets no group chat made for them")
    let casper = try agent(mut app, "q_3", "Casper", "Writes code.")
    let listed = try app.cmd("q_4", "agent.update", Obj.new().s("agent", ledger.copy()).s("for", String("Keeps money and bills.")).done())
    try check(str_at(at(at(listed, "value"), "agent"), "for") == some(String("Keeps money and bills.")), "an agent's what-I'm-for is filled from its instructions, and kept")
    let all_made = try app.cmd("q_21", "room.create", Obj.new().s("name", String("All")).j("members", Json.Array([Json.Str(ledger.copy()), Json.Str(hermes.copy()), Json.Str(casper.copy())])).done())
    let all = str_at(at(at(all_made, "value"), "conversation"), "id") ?? String()
    try check(all.len() > 0, "a group chat is made with all three agents")

    // --- A group chat routes among its members only ---
    let room = try app.cmd("q_5", "room.create", Obj.new().s("name", String("Money")).j("members", Json.Array([Json.Str(ledger.copy()), Json.Str(hermes.copy())])).s("default", hermes.copy()).done())
    let money = str_at(at(at(room.copy(), "value"), "conversation"), "id") ?? String()
    try check(str_at(at(at(at(room, "value"), "conversation"), "room"), "name") == some(String("Money")), "a group chat is made with its name and members")
    let (_, picked) = try say(mut app, money.copy(), "m_1", String("ROUTE:Ledger the bill please"))
    try check(str_at(picked.copy(), "agent") == some(ledger.copy()) and by(picked.copy()) == "router" and str_at(at(picked, "routed"), "said") == some(String("fake pick")), "the router's pick answers, with why")
    let (_, outside) = try say(mut app, money.copy(), "m_2", String("ROUTE:Casper fix the code"))
    try check(str_at(outside.copy(), "agent") == some(hermes.copy()) and by(outside) == "default", "a pick that isn't a member goes to the chat's default instead")

    // --- @ wins ---
    let (started, mentioned) = try say(mut app, money.copy(), "m_3", "[@Hermes](loom:agent/{hermes}) any new mail?")
    try check(str_at(mentioned.copy(), "agent") == some(hermes.copy()) and by(mentioned) == "mention" and str_at(at(started, "routed"), "by") == some(String("mention")), "an @mention goes to that member, with no router call")
    let (_, typed) = try say(mut app, money.copy(), "m_4", String("@ledger and the budget?"))
    try check(str_at(typed.copy(), "agent") == some(ledger.copy()) and by(typed) == "mention", "a name typed after @ is a mention too")

    // --- A correction changes the next similar pick ---
    let (_, first) = try say(mut app, all.copy(), "m_5", String("what did the vps cost in october"))
    try check(str_at(first.copy(), "agent") == some(ledger.copy()), "with nothing to go on, the router picks the first member")
    let resent = try app.cmd("q_6", "room.resend", Obj.new().s("message", str_at(first, "id") ?? String()).s("agent", casper.copy()).done())
    try check(str_at(at(resent, "value"), "run") != none, "a reply is sent to another member")
    let (_, again) = try next_turn(mut app, all.copy())
    try check(str_at(again.copy(), "agent") == some(casper.copy()) and by(again) == "person", "that member answers the same message")
    var corrections: usize = 0
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.updated")) and str_at(at(f.copy(), "conversation"), "id") == some(all.copy()) {
            if let Json.Array(cs) = at(at(at(f, "conversation"), "room"), "corrections") { corrections = cs.len() }
        }
    }
    try check(corrections == 1, "the correction is kept with the chat")
    let (_, next) = try say(mut app, all.copy(), "m_6", String("what did the vps cost in november"))
    try check(str_at(next.copy(), "agent") == some(casper.copy()) and by(next) == "router", "and the router follows it for a message like it")

    // --- A handoff moves the answer ---
    let handoff = "ROUTE:Ledger please\n/mcp hand_off {Obj.new().s("agent", String("Hermes")).s("why", String("mail question")).done()}"
    let (_, handing) = try say(mut app, money.copy(), "m_7", handoff)
    try check(str_at(handing.copy(), "agent") == some(ledger.copy()) and reply_text(handing).contains("hand_off: Hermes answers it"), "a member hands the message on")
    let (_, handed) = try next_turn(mut app, money.copy())
    try check(str_at(handed.copy(), "agent") == some(hermes.copy()) and by(handed.copy()) == "handoff" and str_at(at(handed.copy(), "routed"), "from") == some(ledger.copy()) and str_at(at(handed, "routed"), "said") == some(String("handed off by Ledger")), "and the next member answers it, handed off by the first")

    // --- A member's fresh session goes on from its part, by who said each ---
    let (_, full) = try say(mut app, money.copy(), "m_9", String("ROUTE:Hermes nearly full\n/usage 90 100"))
    try check(str_at(full, "agent") == some(hermes.copy()), "a member fills its session")
    var shown = Json.Null
    for f in app.frames {
        let changed = at(f.copy(), "conversation")
        if str_at(f.copy(), "kind") == some(String("conversation.updated")) and str_at(changed.copy(), "id") == some(money.copy()) and at(changed.copy(), "context") != Json.Null { shown = at(changed, "context") }
    }
    try check(str_at(shown.copy(), "agent") == some(hermes.copy()) and int_at(shown, "used") == some(90i64), "the group chat shows how full the session of the member that answered last is, by whose it is")
    let (going_on, fresh) = try say(mut app, money.copy(), "m_10", String("ROUTE:Hermes and now?\n/context"))
    try finished(mut app, str_at(going_on, "run") ?? String())
    let told = reply_text(fresh.copy())
    try check(str_at(fresh, "agent") == some(hermes.copy()) and told.contains("Your part in this group chat goes on from an earlier session of yours, which grew too long"), "its next message goes to a fresh session of its own there")
    try check(told.contains("Ledger: @ledger and the budget?") and told.contains("You: ROUTE:Hermes nearly full") and not told.contains("You: @ledger"), "where another member's replies are by its name, and its own are its")
    let (fresh_made, _) = lines_in(app, money.copy())
    let (_, fresh_lines) = try kept_lines(mut app, "q_18", money.copy())
    try check(fresh_made.len() == 1 and fresh_lines.len() == 1 and fresh_lines[0].contains(#""mark":"fresh""#) and fresh_lines[0].contains("\"agent\":\"{hermes}\""), "and the group chat has a line where it did, naming the member")

    // --- Its usage has the router's ---
    _ = try say(mut app, money.copy(), "m_11", String("ROUTE:Ledger count this\n/tokens 100"))
    let used = at(try app.cmd("q_7", "room.summary", Obj.new().s("conversation", money.copy()).done()), "value")
    try check(num(used.copy(), "tokens_today") >= 100 and num(used.copy(), "tokens_month") >= num(used.copy(), "tokens_today"), "a group chat's usage counts its members' turns there")
    try check(num(used.copy(), "router_today") >= 12 * 5 and num(used.copy(), "router_month") >= num(used.copy(), "router_today"), "and the router's picks for it, apart")
    let ledger_own = str_at(at(try app.cmd("q_13", "conversation.create", Obj.new().s("agent", ledger.copy()).done()), "value"), "conversation") ?? String()
    let in_own_chat = try app.cmd("q_14", "room.summary", Obj.new().s("conversation", ledger_own).done())
    try check(str_at(at(in_own_chat, "error"), "code") == some(String("bad_request")), "an agent's own chat has no group chat's usage")

    // --- The router's usage is its pick's, never a chat's ---
    let (routed, _) = try say(mut app, money.copy(), "m_14", String("ROUTE:Ledger USAGE:900/1000 the router's session fills"))
    let pick = str_at(routed, "run") ?? String()
    try finished(mut app, pick.copy())
    try check(try count(i, "SELECT COUNT(*) FROM usage WHERE run = ? AND total = 12", "route:{pick}") == 1, "the router's tokens for a pick are kept as route:RUN")
    try check(try count(i, "SELECT COUNT(*) FROM contexts WHERE conversation = ?", String("route")) == 0 and try count(i, "SELECT COUNT(*) FROM conversations WHERE id = ?", String("route")) == 0, "and what its session says of its context isn't kept as a chat's")
    var router_told = false
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.updated")) and int_at(at(at(f, "conversation"), "context"), "used") == some(900i64) { router_told = true }
    }
    let (_, router_astray) = lines_in(app, money.copy())
    try check(not router_told and router_astray == 0, "nor sent to the apps as a context")

    // --- A member's compaction is a line in the group chat, by whose it is ---
    let (compacting, _) = try say(mut app, money.copy(), "m_12", String("ROUTE:Ledger tidy the books\n/usage 120000 200000\n/compact 120000 76000 200000\ndone"))
    try finished(mut app, str_at(compacting, "run") ?? String())
    let compact = try app.cmd("q_15", "conversation.compact", Obj.new().s("conversation", money.copy()).s("agent", ledger.copy()).done())
    try finished(mut app, str_at(at(compact, "value"), "run") ?? String())
    // After Hermes's fresh session's line, one for each compaction.
    let (made, astray) = lines_in(app, money.copy())
    let (kept, lines) = try kept_lines(mut app, "q_16", money.copy())
    if made.len() != 3 or kept != made { fail "one line in the group chat for each compaction, kept with it, not {made} made and {kept} kept: {lines}" }
    try check(true, "one line in the group chat for each compaction, kept with it")
    let whose = "\"agent\":\"{ledger}\""
    try check(lines[1].contains(#""mark":"compacted""#) and lines[1].contains(whose.copy()) and lines[1].contains(#""before":120000"#) and lines[1].contains(#""after":76000"#), "a member's compaction in a turn names the member, with its tokens before and after")
    try check(lines[2].contains(whose.copy()) and lines[2].contains(#""before":76000"#) and lines[2].contains(#""after":7600"#), "and so does one the person asked for")
    try check(astray == 0, "with nothing written under a member's seat")
    let compacted = shown_context(app, money.copy())
    try check(str_at(compacted.copy(), "agent") == some(ledger.copy()) and int_at(compacted.copy(), "used") == some(7600i64) and int_at(compacted, "compacted") != none, "its context is the member's, small again, and says when it was compacted")

    // --- A fresh session for a member: its context from nothing, under a line ---
    let fresh_now = try app.cmd("q_17", "conversation.fresh", Obj.new().s("conversation", money.copy()).s("agent", ledger.copy()).done())
    try check(at(fresh_now, "error") == Json.Null, "conversation.fresh starts a member's session afresh")
    let emptied = shown_context(app, money.copy())
    try check(str_at(emptied.copy(), "agent") == some(ledger.copy()) and int_at(emptied.copy(), "used") == some(0i64) and int_at(emptied, "compacted") == none, "the group chat shows the member's context from nothing")
    let (asked_made, _) = lines_in(app, money.copy())
    let (_, asked_lines) = try kept_lines(mut app, "q_19", money.copy())
    try check(asked_made.len() == 4 and asked_lines.len() == 4 and asked_lines[3].contains(#""mark":"fresh""#) and asked_lines[3].contains(whose), "with a line in the group chat at once, naming the member")
    let (_, afresh) = try say(mut app, money.copy(), "m_13", String("ROUTE:Ledger and now?\n/context"))
    try check(str_at(afresh.copy(), "agent") == some(ledger.copy()) and reply_text(afresh.copy()).contains("which your person chose to start afresh"), "and its next turn there goes to a fresh session of its own")
    try check(reply_text(afresh).contains("[loom: You're answering in the group chat"), "which is told where it is and who's there")
    let (_, after_that) = try say(mut app, money.copy(), "m_15", String("ROUTE:Ledger and then?\n/context"))
    let then_told = reply_text(after_that)
    try check(not then_told.contains("You're answering in the group chat") and then_told.contains("[loom: This message in the group chat is yours. What was said there since you last answered"), "once a session: the turn after is told only that the message is its, and what was said since")
    let (after_fresh, astray_now) = lines_in(app, money.copy())
    try check(after_fresh.len() == 4 and astray_now == 0, "with no second line, and nothing under its seat")

    // --- One agent's chat never routes, and pins stay in their chat ---
    let single = str_at(at(try app.cmd("q_8", "conversation.create", Obj.new().s("agent", casper.copy()).done()), "value"), "conversation") ?? String()
    let (alone_started, alone) = try say(mut app, single.copy(), "m_8", String("ROUTE:Ledger hello"))
    try check(str_at(alone.copy(), "agent") == some(casper.copy()) and at(alone, "routed") == Json.Null and at(alone_started, "routed") == Json.Null, "an agent's own chat never routes")
    _ = try app.cmd("q_9", "message.pin", Obj.new().s("message", str_at(again, "id") ?? String()).done())
    let in_room = "{try app.cmd("q_10", "messages.pinned", Obj.new().s("conversation", all.copy()).done())}"
    let in_own = "{try app.cmd("q_11", "messages.pinned", Obj.new().s("conversation", single).done())}"
    try check(in_room.contains("\"pinned\"") and not in_own.contains("\"pinned\""), "a pin in a group chat isn't in the member's own chat")

    // --- Any group chat is deleted ---
    let gone = try app.cmd("q_12", "conversation.delete", Obj.new().s("conversation", all.copy()).done())
    try check(at(gone, "error") == Json.Null and try count(i, "SELECT COUNT(*) FROM conversations WHERE id = ? AND deleted = 1", all) == 1, "a group chat with all of the person's agents is deleted as any other")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nrooms: all good")
}
