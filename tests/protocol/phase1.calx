module tests.protocol.phase1

// Phase 1's test: a real instance, driven through HTTP and the WebSocket as
// an app would, with the fake ACP agent answering. It checks PLAN.md's
// "done when" for the server MVP:
//
// - the owner sets up the instance, and a second account comes from the
//   command line;
// - the owner makes an agent and a conversation and chats;
// - the connection drops in the middle of a reply, and a reconnect catches
//   up: the events missed, then the reply so far from position 0, then the
//   rest live;
// - an approval is asked and answered, and the auto mode answers a safe one
//   by itself;
// - a send sent again does nothing new;
// - the second account sees none of it.
//
// Run it from the repository's root:
//
//     calx tests/protocol/phase1.calx
//
// With LOOM_TEST_CLAUDE set to an ACP command line for Claude, such as
// "npx @agentclientprotocol/claude-agent-acp", it also chats with Claude itself.
import std.env
import std.fs
import std.http.{Header, post}
import std.http.websocket.{Message, WebSocket, connect}
import std.json.{Json, parse}
import std.process.{Child, Command, Stdio, exit}
import shared.obj.{Obj, at, bool_at, int_at, str_at}

const WAIT: u64 = 120000    // the first start builds the server and the agent

fn calx() -> String {
    return env.variable(String("CALX")) ?? String("calx")
}

fn loom(data: String, args: List<String>) -> Command {
    return Command.new(calx()).arg(String("server/main.calx")).args(args).arg(String("--data")).arg(data).arg(String("--test-fast-hashes"))
}

fn check(passed: bool, what: str) ! Error {
    if not passed { fail "failed: {what}" }
    println("ok    {what}")
}

// A connected app: its socket, and the newest seq it has applied.
struct App {
    ws: WebSocket
    seq: i64
    frames: List<Json>
}

impl App {
    // Opens /ws and says hello with `after`. Gives the app once it's synced.
    fn connect(base: String, token: String, after: i64) -> App ! Error {
        let ws = try connect("ws://{base}/ws")
        var app = App { ws: ws, seq: after, frames: List<Json>() }
        try app.send(Obj.new().s("t", String("hello")).s("token", token).j("versions", Json.Array([Json.Int(1)])).i("after", after).done())
        _ = try app.until("synced", "")
        return app
    }

    fn send(self, frame: Json) ! Error {
        try self.ws.send_text("{frame}")
    }

    // Reads frames until one whose `t` is `t` (and, for events, whose kind
    // is `kind`), and gives it. Every frame read is kept in `frames`.
    fn until(a: mut App, t: str, kind: str) -> Json ! Error {
        loop {
            let m = try a.ws.receive(30000) else {
                fail "no {t} {kind} came in 30 s"
            }
            let text = match m {
                Message.Text(s) => s,
                Message.Binary(_) => fail "a binary frame came",
            }
            let f = try parse(text)
            if let seq = int_at(f.copy(), "seq") {
                if (str_at(f.copy(), "t") ?? String()) == "event" {
                    if seq != a.seq + 1 { fail "event {seq} came after {a.seq}" }
                    a.seq = seq
                }
            }
            a.frames.push(f.copy())
            if (str_at(f.copy(), "t") ?? String()) == t and (kind.len() == 0 or (str_at(f.copy(), "kind") ?? String()) == kind) {
                return f
            }
        }
    }

    fn cmd(a: mut App, id: str, name: str, args: Json) -> Json ! Error {
        try a.send(Obj.new().s("t", String("cmd")).s("id", String(id)).s("name", String(name)).j("args", args).done())
        loop {
            let r = try a.until("result", "")
            if (str_at(r.copy(), "id") ?? String()) == id { return r }
        }
    }

    fn close(own self) {
        self.ws.close()
    }
}

fn post_json(base: String, path: str, body: Json) -> (u32, Json) ! Error {
    let headers: List<Header> = [Header { name: String("Content-Type"), value: String("application/json") }]
    var req = post("http://{base}{path}", headers, "{body}".to_bytes(), 30000, 1048576)
    let r = try req.wait()
    let j = match parse(String.from_utf8(r.body) ?? String()) {
        ok(v) => v,
        err(_) => Json.Null,
    }
    return (r.status, j)
}

fn device(name: str) -> Json {
    return Obj.new().s("name", String(name)).s("kind", String("cli")).s("tz", String("Europe/Oslo")).done()
}

// The text of an agent reply's text blocks, joined.
fn reply_text(message: Json) -> String {
    var out = String()
    if let Json.Array(blocks) = at(message, "blocks") {
        for b in blocks {
            if (str_at(b.copy(), "kind") ?? String()) == "text" {
                out.push_str(str_at(b, "text") ?? String())
            }
        }
    }
    return out
}

fn run(server: Child, data: String) ! Error {
    let serving = server.wait_for_line(String("loom: serving"), WAIT) else {
        fail "the server didn't start"
    }
    let address = serving[serving.find("http://") ?? 0..].trim().copy()
    let base = if address.ends_with("/") { address[7..address.len() - 1].copy() } else { address[7..].copy() }
    let code_line = server.wait_for_line(String("setup code:"), 10000) else {
        fail "the server didn't print a setup code"
    }
    let code = code_line[12..].trim().copy()
    println("ok    the instance started at {address}")

    // --- Accounts ---
    let (status, info) = try post_json(base.copy(), "/api/setup", Obj.new().s("code", String("wrong")).s("username", String("elliot")).s("password", String("hunter22")).done())
    try check(status == 403 and "{info}".contains("bad_code"), "a wrong setup code is refused")
    let (s1, owner) = try post_json(base.copy(), "/api/setup", Obj.new().s("code", code.copy()).s("username", String("elliot")).s("password", String("correct horse")).j("device", device("Desk PC")).done())
    try check(s1 == 200 and str_at(owner.copy(), "token") != none, "the owner sets the instance up")
    let (s2, _) = try post_json(base.copy(), "/api/setup", Obj.new().s("code", code).s("username", String("again")).s("password", String("correct horse")).done())
    try check(s2 == 409, "setup works once")
    let token = str_at(owner, "token") ?? String()

    let added = try loom(data.copy(), [String("user"), String("add"), String("bob")]).input_text(String("bobs password\n")).output()
    try check(added.status.success(), "a second account comes from the command line")
    let said = try loom(data.copy(), [String("status")]).output()
    try check(said.status.success() and said.text().contains("runs as: "), "loom status says which user it runs as")
    if env.is_elevated() {
        let refused = try loom(data.copy(), [String("serve"), String("--port"), String("0")]).output()
        try check(not refused.status.success() and refused.error_text().contains("--allow-root"), "loom serve won't run elevated without --allow-root")
    } else {
        println("      (not elevated, so serve's refusal to run elevated isn't tried)")
    }
    let (s3, _) = try post_json(base.copy(), "/api/login", Obj.new().s("username", String("bob")).s("password", String("not it")).done())
    try check(s3 == 401, "a wrong password is refused")
    let (s4, bob) = try post_json(base.copy(), "/api/login", Obj.new().s("username", String("bob")).s("password", String("bobs password")).j("device", device("Bob's laptop")).done())
    try check(s4 == 200, "the second account logs in")
    let bob_token = str_at(bob, "token") ?? String()

    // --- An agent and a conversation ---
    var app = try App.connect(base.copy(), token.copy(), 0)
    try check(app.seq == 1, "the owner's first hello catches up on its device.added")
    let agent_cmd = Obj.new().s("name", String("Fake")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done()
    let made = try app.cmd("q_1", "agent.create", agent_cmd)
    let agent = str_at(at(at(made.copy(), "value"), "agent"), "id") ?? String()
    try check(agent.starts_with("a_"), "agent.create makes an agent")
    let conv = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent).s("title", String("Builds")).done())
    let conversation = str_at(at(conv, "value"), "conversation") ?? String()
    try check(conversation.starts_with("c_"), "conversation.create makes a conversation")

    // --- A reply, with the connection dropped in the middle ---
    let words = "one two three four five six seven eight nine ten"
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_1")).s("conversation", conversation.copy()).s("text", "/slow 150\n{words}").done())
    let ack = try app.until("ack", "")
    let run_id = str_at(ack.copy(), "run") ?? String()
    try check(run_id.starts_with("run_"), "send is acked with a run")
    _ = try app.until("event", "run.started")
    _ = try app.until("delta", "")
    _ = try app.until("delta", "")
    let cursor = app.seq
    app.close()
    println("ok    the connection dropped in the middle of the reply, at seq {cursor}")

    var back = try App.connect(base.copy(), token.copy(), cursor)
    var first_delta: Json = Json.Null
    for f in back.frames {
        if (str_at(f.copy(), "t") ?? String()) == "delta" and first_delta == Json.Null { first_delta = f.copy() }
    }
    try check(int_at(first_delta.copy(), "pos") == some(0) and (str_at(first_delta.copy(), "text") ?? String()).starts_with("one two "), "the reconnect gets the reply so far from position 0, before synced")
    let created = try back.until("event", "message.created")
    let reply = reply_text(at(created, "message"))
    println("      the reply: {reply}")
    try check(reply == words, "the finished reply is whole")
    let finished = try back.until("event", "run.finished")
    try check(str_at(finished, "status") == some(String("done")), "the run finishes done")

    // --- The same send again does nothing new ---
    let before = back.seq
    try back.send(Obj.new().s("t", String("send")).s("cid", String("m_1")).s("conversation", conversation.copy()).s("text", String("anything")).done())
    let again = try back.until("ack", "")
    try check(str_at(again, "run") == some(run_id), "a send sent again gets the same ack")
    let listed = try back.cmd("q_3", "messages.list", Obj.new().s("conversation", conversation.copy()).done())
    var count: usize = 0
    if let Json.Array(ms) = at(at(listed, "value"), "messages") { count = ms.len() }
    try check(count == 2 and back.seq == before, "and makes no message and no event")

    // --- An approval ---
    try back.send(Obj.new().s("t", String("send")).s("cid", String("m_2")).s("conversation", conversation.copy()).s("text", String("/ask rm -rf build\ndone")).done())
    let needed = try back.until("event", "approval.needed")
    let call = str_at(needed.copy(), "call") ?? String()
    try check(str_at(needed, "title") == some(String("rm -rf build")), "the agent asks before a risky step")
    try back.send(Obj.new().s("t", String("approve")).s("call", call.copy()).b("allow", true).b("always", false).done())
    _ = try back.until("event", "approval.answered")
    let tool = try back.until("event", "tool.finished")
    try check(str_at(tool, "status") == some(String("done")), "an allowed tool runs")
    _ = try back.until("event", "run.finished")
    try back.send(Obj.new().s("t", String("approve")).s("call", call).b("allow", true).done())
    let late = try back.until("error", "")
    try check(str_at(late, "code") == some(String("already_answered")), "an approval answered twice is refused")

    // --- The auto permission mode ---
    _ = try back.cmd("q_auto", "agent.update", Obj.new().s("agent", agent.copy()).s("permission", String("auto")).done())
    try back.send(Obj.new().s("t", String("send")).s("cid", String("m_auto")).s("conversation", conversation.copy()).s("text", String("/read cat notes.md\n/ask rm notes.md")).done())
    let by_itself = try back.until("event", "approval.answered")
    try check(str_at(by_itself, "by") == some(String("auto")) and bool_at(by_itself, "allow") == some(true), "auto allows a tool that only reads")
    let risky = try back.until("event", "approval.needed")
    try check(str_at(risky.copy(), "title") == some(String("rm notes.md")) and str_at(risky.copy(), "tool") == some(String("execute")), "and asks about one that runs a command")
    try back.send(Obj.new().s("t", String("approve")).s("call", str_at(risky, "call") ?? String()).b("allow", false).done())
    let denied = try back.until("event", "tool.finished")
    try check(str_at(denied, "status") == some(String("denied")), "a denied tool doesn't run")
    _ = try back.until("event", "run.finished")
    _ = try back.cmd("q_ask", "agent.update", Obj.new().s("agent", agent.copy()).s("permission", String("ask")).done())

    // --- A cancel ---
    try back.send(Obj.new().s("t", String("send")).s("cid", String("m_3")).s("conversation", conversation.copy()).s("text", String("/sleep 20000\nlate")).done())
    let ack3 = try back.until("ack", "")
    try back.send(Obj.new().s("t", String("cancel")).s("run", str_at(ack3, "run") ?? String()).done())
    let cancelled = try back.until("event", "run.finished")
    try check(str_at(cancelled, "status") == some(String("cancelled")), "a cancel ends the run")

    // --- The second account sees none of it ---
    var b = try App.connect(base.copy(), bob_token, 0)
    var leaked = false
    for f in b.frames {
        if "{f}".contains(conversation.copy()) or "{f}".contains("Builds") { leaked = true }
    }
    try check(not leaked and b.seq == 1, "the second account's log has only its own device")
    let peek = try b.cmd("q_1", "messages.list", Obj.new().s("conversation", conversation.copy()).done())
    try check(str_at(at(peek, "error"), "code") == some(String("not_found")), "and it can't read the owner's conversation")
    b.close()

    // --- Too many wrong passwords ---
    var limited_after = 0
    for n in 1..13 {
        let (st, body) = try post_json(base.copy(), "/api/login", Obj.new().s("username", String("mallory")).s("password", String("guess")).done())
        if st == 429 {
            if "{body}".contains("rate_limited") { limited_after = n }
            break
        }
    }
    try check(limited_after > 0 and limited_after <= 11, "too many wrong passwords are rate-limited")

    // --- Claude, when it's set up ---
    if let claude = env.variable(String("LOOM_TEST_CLAUDE")) {
        let parts = claude.split(" ")
        let cmd = Command.new(calx()).arg(String("server/main.calx")).arg(String("acp")).arg(String("add")).arg(String("claude")).args(parts).arg(String("--data")).arg(data.copy())
        _ = try cmd.output()
        let c_agent = try back.cmd("q_4", "agent.create", Obj.new().s("name", String("Claude")).s("acp_agent", String("claude")).s("instructions", String("Answer in one short sentence.")).done())
        let c_id = str_at(at(at(c_agent, "value"), "agent"), "id") ?? String()
        let c_conv = try back.cmd("q_5", "conversation.create", Obj.new().s("agent", c_id).done())
        try back.send(Obj.new().s("t", String("send")).s("cid", String("m_9")).s("conversation", str_at(at(c_conv, "value"), "conversation") ?? String()).s("text", String("Say hello to loom in five words.")).done())
        var msg = try back.until("event", "message.created")
        while str_at(at(msg.copy(), "message"), "role") != some(String("agent")) {
            msg = try back.until("event", "message.created")
        }
        let done = try back.until("event", "run.finished")
        try check(str_at(done.copy(), "status") == some(String("done")) and reply_text(at(msg.copy(), "message")).len() > 0, "Claude answers")
        println("      Claude said: {reply_text(at(msg, "message"))}")
    }
    back.close()
}

fn main() ! Error {
    let data = try fs.temp_dir()
    let agent = try fs.absolute(String("tests/fake_agent/main.calx"))
    let added = try loom(data.copy(), [String("acp"), String("add"), String("fake"), calx(), agent]).output()
    if not added.status.success() { fail "loom acp add failed: {added.error_text()}" }
    var server = try loom(data.copy(), [String("serve"), String("--port"), String("0"), String("--allow-root")]).stdout(Stdio.Pipe).spawn()
    let failure: String? = match run(server, data) {
        ok => none,
        err(e) => some("{e}"),
    }
    server.kill()
    _ = server.wait()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nphase 1: all good")
}
