module tests.protocol.browser

// The agent's browser (PLAN.md, "The agent's browser"): the fake agent opens
// a page through loom's tools, reads its outline, types into a field and
// submits it, follows a link, goes back and takes a picture. It closes when the
// agent's turn ends, unless the person watches it, and starts again where it
// was on the next call; browser_close closes it at once, and with nothing to
// do it closes after a while even while watched. Deleting the agent stops its
// browser. Without Chrome, Edge or Chromium on the computer, it says it was
// skipped.
//
//     calx tests/protocol/browser.calx
import std.bytes
import std.fs
import std.image.{Image}
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, int_at, str_at}
import server.browser
import server.store.{now}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

fn reply_in(app: mut Session, conversation: String, wait_ms: u32 = 30000) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created", wait_ms)
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return reply_text(m) }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

// A turn waited on past the browser's 30 s for a call, so a call that never came back
// says what the browser said rather than timing the test out first.
fn say_long(app: mut Session, conversation: String, cid: String, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", cid).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation, 60000)
}

// check, saying what came when it fails.
fn see(passed: bool, what: str, got: String) ! Error {
    if not passed { fail "failed: {what}, from:\n{got}" }
    println("ok    {what}")
}

// The ref of the first line of an outline that has `part` in it.
fn ref_of(outline: String, part: str) -> String {
    for line in outline.lines() {
        if line.contains(part) {
            if let start = line.find("[ref=") {
                let rest = line[start + 5..].copy()
                if let end = rest.find("]") { return rest[..end].copy() }
            }
        }
    }
    return String()
}

// Waits for browser.state to say `agent`'s browser is open, or isn't, as `open` says.
fn until_open(app: mut Session, agent: String, open: bool, wait_ms: u32 = 30000) ! Error {
    loop {
        let state = try app.until("browser.state", "", wait_ms)
        if str_at(state.copy(), "agent") == some(agent.copy()) and bool_at(state, "open") == some(open) { return }
    }
}

// A file's address, as a browser opens it.
fn file_url(path: String) -> String {
    let p = path.replace("\\", "/")
    return if p.starts_with("/") { "file://{p}" } else { "file:///{p}" }
}

// Watches `agent`'s browser shown `width` × `height`, or at the page's size with 0, and gives
// the first frame that comes after browser.watch answers: its picture's size, then the page's.
fn first_frame(app: mut Session, agent: String, width: i64, height: i64) -> (i64, i64, i64, i64) ! Error {
    var args = Obj.new().s("agent", agent).b("on", true)
    if width > 0 { args = args.i("width", width).i("height", height) }
    _ = try app.cmd("q_z", "browser.watch", args.done())
    let frame = try app.until("browser.frame", "")
    let pixels = match Image.decode(app.body.copy()) {
        ok(im) => im,
        err(e) => fail "failed: a frame that isn't a picture: {e}",
    }
    return (i64.wrap(pixels.width()), i64.wrap(pixels.height()), int_at(frame.copy(), "width") ?? 0, int_at(frame, "height") ?? 0)
}

fn run(i: Instance) ! Error {
    let pages = try fs.temp_dir()
    try fs.write_text("{pages}/shop.html", String(#"
        <!doctype html><title>Shop</title><h1>Welcome</h1>
        <form onsubmit="document.title = 'Sent ' + this.q.value; return false"><input name="q" aria-label="Search"><button>Go</button></form>
        <a href="second.html">Next page</a>
        "#))
    try fs.write_text("{pages}/second.html", String("<!doctype html><title>Second</title><h1>Second page</h1>"))
    // A page that's never still, so its frames come all the time.
    try fs.write_text("{pages}/moving.html", String(#"<!doctype html><title>Moving</title><style>@keyframes spin { to { transform: rotate(360deg) } } div { width: 200px; height: 200px; background: teal; animation: spin 1s linear infinite }</style><div></div>"#))

    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Browser")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let conversation = str_at(at(c, "value"), "conversation") ?? String()

    // The browser starts on this first call. On a Linux runner whose AppArmor stops
    // Chrome making its sandbox, it starts twice, which can take well past 30 s.
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_1")).s("conversation", conversation.copy()).s("text", "/mcp browser_open \{\"url\":\"{file_url("{pages}/shop.html")}\"\}").done())
    let opened = try reply_in(mut app, conversation.copy(), 120000)
    try see(opened.starts_with("browser_open: Page: Shop") and opened.contains("heading \"Welcome\"") and opened.contains("textbox \"Search\""), "browser_open gives the page's outline", opened.copy())

    // --- Closing ---
    try until_open(mut app, agent.copy(), false)
    try check(true, "the turn's over and no one watches, so the browser closes")
    let watching = try app.cmd("q_w0", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", true).done())
    try check(bool_at(at(watching, "value"), "open") == some(false), "watching doesn't open it")
    let reopened = try say(mut app, conversation.copy(), "m_1b", String("/mcp browser_snapshot"))
    try see(reopened.contains("[loom: Your browser had closed since you last used it, so it opened {file_url("{pages}/shop.html")} again") and reopened.contains("Page: Shop") and reopened.contains("heading \"Welcome\""), "the next call starts it again, on the page it was on", reopened.copy())
    // The rest goes on watched, so each turn's end leaves it open.
    let field = ref_of(reopened.copy(), "textbox \"Search\"")
    try check(field.len() > 0, "with a ref for the field")

    let typed = try say(mut app, conversation.copy(), "m_2", "/mcp browser_type \{\"ref\":\"{field}\",\"text\":\"socks\",\"submit\":true\}")
    try see(typed.contains("Page: Sent socks"), "browser_type types into the field and submits it", typed.copy())

    let link = ref_of(typed, "link \"Next page\"")
    let clicked = try say(mut app, conversation.copy(), "m_3", "/mcp browser_click \{\"ref\":\"{link}\"\}")
    try see(clicked.contains("Page: Second") and clicked.contains("heading \"Second page\""), "browser_click follows a link", clicked.copy())

    let stale = try say(mut app, conversation.copy(), "m_4", "/mcp browser_click \{\"ref\":\"e999\"\}")
    try check(stale.starts_with("browser_click failed: There's no e999"), "a ref that isn't on the page is refused")

    let back = try say(mut app, conversation.copy(), "m_5", String("/mcp browser_back"))
    try see(back.contains("Page: ") and back.contains("heading \"Welcome\""), "browser_back goes back", back.copy())

    let shot = try say(mut app, conversation.copy(), "m_6", String("/mcp browser_screenshot"))
    try see(shot.starts_with("browser_screenshot: [image image/jpeg] Page: "), "browser_screenshot gives a picture", shot.copy())

    // --- html_preview ---
    let card = String(#"<!doctype html><title>Card</title><h1>Hello</h1><script>console.log("drawn", 2); console.error("oops"); missing();</script>"#)
    // A preview's tab is drawn in front for its picture: one in the background draws
    // frames only now and then, so the picture took seconds, and at times past the
    // browser's 30 s for a call. Each turn here is waited on longer than that, so a
    // slow one says what the browser said, and each must be quick.
    var slowest: i64 = 0
    var started = now()
    let previewed = try say_long(mut app, conversation.copy(), String("m_p1"), "/mcp html_preview {Obj.new().s("html", card.copy()).i("width", 640).i("height", 480).done()}")
    slowest = slowest.max(now() - started)
    try see(previewed.starts_with("html_preview: [image image/jpeg] The page, at 640 × 480. Its console said:") and previewed.contains("log: drawn 2") and previewed.contains("error: oops") and previewed.contains("missing is not defined"), "html_preview gives a picture of the page and what its console said", previewed.copy())
    started = now()
    let whole = try say_long(mut app, conversation.copy(), String("m_p2"), "/mcp html_preview {Obj.new().s("html", String(#"<!doctype html><div style="height:3000px">tall</div>"#)).i("width", 400).b("full_page", true).done()}")
    slowest = slowest.max(now() - started)
    try see(whole.contains("The page, at 400 × 30") and whole.contains("the whole page. Its console said nothing."), "and of the whole page, past the window", whole.copy())
    for n in 0..4 {
        started = now()
        let again = try say_long(mut app, conversation.copy(), "m_pa{n}", "/mcp html_preview {Obj.new().s("html", "<!doctype html><h1>Again {n}</h1>").b("full_page", n % 2 == 0).done()}")
        slowest = slowest.max(now() - started)
        try see(again.starts_with("html_preview: [image image/jpeg] The page, at "), "a preview again gives a picture", again.copy())
    }
    try see(slowest < 10000, "each preview is quick, its tab drawn in front", "the slowest took {slowest} ms")
    let kept = try say(mut app, conversation.copy(), "m_p3", String("/mcp browser_snapshot"))
    try see(kept.contains("heading \"Welcome\""), "while the agent's own page stays as it was", kept.copy())
    let blank = try say(mut app, conversation.copy(), "m_p4", String(#"/mcp html_preview {"html":""}"#))
    try check(blank.starts_with("html_preview failed: html is empty"), "an empty page is refused")

    let refused = try say(mut app, conversation.copy(), "m_7", String(#"/mcp browser_open {"url":"javascript:alert(1)"}"#))
    try check(refused.starts_with("browser_open failed"), "it opens only pages")

    // --- Secrets ---
    _ = try app.cmd("q_s1", "secret.put", Obj.new().s("name", String("SHOP_PASS")).s("value", String("hunter2-wool")).done())
    let page = try say(mut app, conversation.copy(), "m_s1", String("/mcp browser_snapshot"))
    let search = ref_of(page, "textbox \"Search\"")
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_s2")).s("conversation", conversation.copy()).s("text", "/mcp browser_fill_secret \{\"ref\":\"{search}\",\"secret\":\"SHOP_PASS\"\}").done())
    let asked = try app.until("event", "approval.needed")
    try see((str_at(asked.copy(), "title") ?? String()) == "Fill your secret SHOP_PASS on a file on this computer", "a secret's first time on a site waits for the person's yes", "{asked}")
    try app.send(Obj.new().s("t", String("approve")).s("call", str_at(asked, "call") ?? String()).b("allow", true).done())
    let filled = try reply_in(mut app, conversation.copy())
    try see(filled == "browser_fill_secret: Filled in SHOP_PASS.", "then browser_fill_secret fills it in", filled.copy())
    let shown = try say(mut app, conversation.copy(), "m_s3", String("/mcp browser_snapshot"))
    try see(shown.contains("[secret SHOP_PASS]") and not shown.contains("hunter2"), "and the agent never reads it, on the page either", shown.copy())
    let again = try say(mut app, conversation.copy(), "m_s4", "/mcp browser_fill_secret \{\"ref\":\"{search}\",\"secret\":\"SHOP_PASS\"\}")
    try see(again == "browser_fill_secret: Filled in SHOP_PASS.", "the same site again needs no new yes", again.copy())
    let missing = try say(mut app, conversation.copy(), "m_s5", "/mcp browser_fill_secret \{\"ref\":\"{search}\",\"secret\":\"NOPE\"\}")
    try check(missing.starts_with("browser_fill_secret failed: Your person has no secret NOPE"), "a secret they don't have is refused")

    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_s6")).s("conversation", conversation.copy()).s("text", "/mcp browser_ask_secret \{\"ref\":\"{search}\",\"why\":\"Your one-time code\"\}").done())
    loop {
        let state = try app.until("browser.state", "")
        if str_at(state, "secret") == some(String("Your one-time code")) { break }
    }
    try check(true, "browser_ask_secret asks the person, with browser.state")
    _ = try app.cmd("q_s2", "browser.secret", Obj.new().s("agent", agent.copy()).s("value", String("424242")).done())
    let typed_secret = try reply_in(mut app, conversation.copy())
    try see(typed_secret == "browser_ask_secret: Filled in what your person typed.", "browser.secret fills what they typed", typed_secret.copy())
    let after = try say(mut app, conversation.copy(), "m_s7", String("/mcp browser_snapshot"))
    try see(not after.contains("424242"), "and the agent never reads it either", after.copy())

    // --- Watching, and taking over ---
    // The app shows the page 640 pixels wide, so the frames are no wider.
    let watched = try app.cmd("q_w1", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", true).i("width", 640).i("height", 400).done())
    try check(bool_at(at(watched, "value"), "open") == some(true), "browser.watch says the browser is open")
    let frame = try app.until("browser.frame", "")
    let jpeg = app.body.copy()
    try check(app.binary and str_at(frame.copy(), "agent") == some(agent.copy()) and str_at(frame.copy(), "data") == none and jpeg.len() > 2 and jpeg[0] == 255 and jpeg[1] == 216, "and frames of the page come, as JPEGs in binary messages")
    // Whole, the page's shape, and no bigger than shown: Chrome on Linux writes a scan
    // for each color, which a decoder that reads only the first draws green (LOO-252).
    let pixels = match Image.decode(jpeg) {
        ok(im) => im,
        err(e) => fail "failed: a frame that isn't a picture: {e}",
    }
    let page_w = int_at(frame.copy(), "width") ?? 0
    let page_h = int_at(frame, "height") ?? 0
    let (w, h) = (i64.wrap(pixels.width()), i64.wrap(pixels.height()))
    try see(page_w > 640 and page_w <= browser.PAGE_WIDTH and page_h <= browser.PAGE_HEIGHT and w <= 640 and h <= 400 and w >= 600 and (w * page_h - h * page_w).abs() <= page_w + page_h, "each a whole picture of the page, as big as it's shown, its own size beside it", "{w} × {h} of {page_w} × {page_h}")
    // An app a version behind gets them as JSON, the JPEG in base64; and, as it says
    // no size, as big as the page, for both apps while both watch.
    var old = try Session.connect_speaking(i.base.copy(), i.token.copy(), 0, Json.Array([Json.Int(1)]))
    _ = try old.cmd("q_o1", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", true).done())
    let text_frame = try old.until("browser.frame", "")
    let old_jpeg = bytes.from_base64(str_at(text_frame.copy(), "data") ?? String()) ?? List<u8>()
    let full = match Image.decode(old_jpeg) {
        ok(im) => im,
        err(e) => fail "failed: a version 1 frame that isn't a picture: {e}",
    }
    try see(not old.binary and i64.wrap(full.width()) == (int_at(text_frame.copy(), "width") ?? 0) and i64.wrap(full.height()) == (int_at(text_frame, "height") ?? 0), "an app of protocol version 1 gets them as JSON, as big as the page", "{full.width()} × {full.height()}")
    _ = try old.cmd("q_o2", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", false).done())
    old.close()
    let early = try app.cmd("q_w2", "browser.input", Obj.new().s("agent", agent.copy()).s("kind", String("key")).s("key", String("Tab")).done())
    try check(bool_at(early, "ok") == some(false), "the person's input waits for them to take over")

    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_8")).s("conversation", conversation.copy()).s("text", String(#"/mcp browser_ask_person {"why":"Type the code from your phone."}"#)).done())
    loop {
        let state = try app.until("browser.state", "")
        if str_at(state, "asked") == some(String("Type the code from your phone.")) { break }
    }
    try check(true, "browser_ask_person asks the person, with browser.state")
    let took = try app.cmd("q_w3", "browser.take", Obj.new().s("agent", agent.copy()).done())
    try check(bool_at(at(took, "value"), "person") == some(true), "browser.take gives them the browser")
    let tab = try app.cmd("q_i1", "browser.input", Obj.new().s("agent", agent.copy()).s("kind", String("key")).s("key", String("Tab")).done())
    let typed_in = try app.cmd("q_i2", "browser.input", Obj.new().s("agent", agent.copy()).s("kind", String("text")).s("text", String("boots")).done())
    let enter = try app.cmd("q_i3", "browser.input", Obj.new().s("agent", agent.copy()).s("kind", String("key")).s("key", String("Enter")).done())
    try check(bool_at(tab, "ok") == some(true) and bool_at(typed_in, "ok") == some(true) and bool_at(enter, "ok") == some(true), "browser.input takes their keys and text")
    _ = try app.cmd("q_w4", "browser.give", Obj.new().s("agent", agent.copy()).done())
    let handed = try reply_in(mut app, conversation.copy())
    try see(handed.starts_with("browser_ask_person: Your person handed the browser back after 3 clicks and keys") and handed.contains("boots ("), "browser.give answers the agent, with what they did and the page", handed.copy())

    // A click on the page takes it over and lands in the same go, as the desktop app
    // sends them: browser.take and browser.input one after the other, without waiting
    // for the first's answer, handled in that order (LOO-279).
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_8b")).s("conversation", conversation.copy()).s("text", String(#"/mcp browser_ask_person {"why":"Sign in for me."}"#)).done())
    loop {
        let state = try app.until("browser.state", "")
        if str_at(state, "asked") == some(String("Sign in for me.")) { break }
    }
    try app.send(Obj.new().s("t", String("cmd")).s("id", String("q_t1")).s("name", String("browser.take")).j("args", Obj.new().s("agent", agent.copy()).done()).done())
    try app.send(Obj.new().s("t", String("cmd")).s("id", String("q_t2")).s("name", String("browser.input")).j("args", Obj.new().s("agent", agent.copy()).s("kind", String("click")).i("x", 20).i("y", 20).done()).done())
    try app.send(Obj.new().s("t", String("cmd")).s("id", String("q_t3")).s("name", String("browser.input")).j("args", Obj.new().s("agent", agent.copy()).s("kind", String("key")).s("key", String("Tab")).done()).done())
    var answered = List<String>()
    for _ in 0..3 {
        let r = try app.until("result", "")
        answered.push("{str_at(r.copy(), "id") ?? String()} {bool_at(r, "ok") ?? false}")
    }
    try see(answered == [String("q_t1 true"), String("q_t2 true"), String("q_t3 true")], "a click sent right after browser.take, without waiting, is theirs", "{answered}")
    _ = try app.cmd("q_t4", "browser.give", Obj.new().s("agent", agent.copy()).done())
    let given = try reply_in(mut app, conversation.copy())
    try see(given.starts_with("browser_ask_person: Your person handed the browser back after 2 clicks and keys"), "and the agent hears of both", given.copy())

    // While frames come all the time, the first after the size it's shown at changes is
    // already at that size: none from before it was asked comes after browser.watch answers.
    let moving = try say(mut app, conversation.copy(), "m_9", "/mcp browser_open \{\"url\":\"{file_url("{pages}/moving.html")}\"\}")
    try see(moving.contains("Page: Moving"), "a page that moves opens", moving.copy())
    for n in 0..6 {
        let (sw, sh, spw, sph) = try first_frame(mut app, agent.copy(), 640, 400)
        try see(sw <= 640 and sh <= 400 and sw >= 600 and spw > 640, "the first frame after it's shown small is small", "{sw} × {sh} of {spw} × {sph}, time {n}")
        let (fw, fh, fpw, fph) = try first_frame(mut app, agent.copy(), 0, 0)
        try see(fw == fpw and fh == fph, "and the first after it's shown at the page's size is as big as the page", "{fw} × {fh} of {fpw} × {fph}, time {n}")
    }
    _ = try app.cmd("q_w5", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", false).done())
    try until_open(mut app, agent.copy(), false)
    try check(true, "once no one watches it after the turn, it closes")

    // --- browser_close ---
    let closed = try say(mut app, conversation.copy(), "m_c1", "/mcp browser_open \{\"url\":\"{file_url("{pages}/second.html")}\"\}\n/mcp browser_close")
    try see(closed.contains("Page: Second") and closed.contains("browser_close: Closed your browser."), "browser_close closes it in the middle of a turn", closed.copy())
    let fresh = try say(mut app, conversation.copy(), "m_c2", String("/mcp browser_snapshot"))
    try see(not fresh.contains("had closed") and not fresh.contains("Second page"), "and the next call starts it on a blank page", fresh.copy())
    let none_open = try say(mut app, conversation.copy(), "m_c3", String("/mcp browser_snapshot\n/mcp browser_close\n/mcp browser_close"))
    try see(none_open.contains("browser_close: Closed your browser.") and none_open.contains("browser_close: Your browser wasn't open."), "closing one that isn't open says so", none_open.copy())
    // One started on the profile while the last is still closing on it waits for it,
    // rather than finding the profile in use and stopping.
    for n in 0..3 {
        let reopened_now = try say_long(mut app, conversation.copy(), "m_c4{n}", "/mcp browser_open \{\"url\":\"{file_url("{pages}/shop.html")}\"\}\n/mcp browser_close\n/mcp browser_open \{\"url\":\"{file_url("{pages}/second.html")}\"\}")
        try see(reopened_now.contains("Page: Second") and not reopened_now.contains("didn't start"), "a browser opened again right after it closed starts", reopened_now.copy())
    }

    // An app's small window only follows the agent's browsing, which keeps it open no longer than the turn.
    _ = try app.cmd("q_f1", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", true).b("follow", true).done())
    let followed = try say(mut app, conversation.copy(), "m_f1", "/mcp browser_open \{\"url\":\"{file_url("{pages}/shop.html")}\"\}")
    try see(followed.contains("Page: Shop"), "a browser that's followed opens", followed.copy())
    try until_open(mut app, agent.copy(), false)
    try check(true, "and closes when the turn ends")
    _ = try app.cmd("q_f2", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", false).done())

    let profile = "{i.data}/browsers"
    try check(fs.is_dir(profile.copy()), "the browser's profile is in the instance's data")
    _ = try app.cmd("q_3", "agent.delete", Obj.new().s("agent", agent).done())
    app.close()
    try fs.remove_dir_all(pages)
}

// With a minute of a second, a browser that's watched but has nothing to do
// closes after browser.IDLE_MINUTES of them.
fn idle(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Idle")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let conversation = str_at(at(c, "value"), "conversation") ?? String()
    _ = try app.cmd("q_3", "browser.watch", Obj.new().s("agent", agent.copy()).b("on", true).done())
    let opened = try say(mut app, conversation.copy(), "m_1", String(#"/mcp browser_open {"url":"about:blank"}"#))
    try see(opened.starts_with("browser_open: Page: "), "a watched browser opens", opened.copy())
    let since = now()
    try until_open(mut app, agent.copy(), false, 60000)
    let waited = now() - since
    try see(waited >= (browser.IDLE_MINUTES - 1) * 1000, "and closes once it's been idle a while, though watched", "{waited} ms")
    _ = try app.cmd("q_4", "agent.delete", Obj.new().s("agent", agent).done())
    app.close()
}

fn main() ! Error {
    if browser.find() == none {
        println("browser: skipped, there's no Chrome, Edge or Chromium here")
        return
    }
    var failure: String? = none
    let inst = try Instance.start()
    match run(inst.copy()) {
        ok => {},
        err(e) => failure = some("{e}"),
    }
    inst.stop()
    if failure == none {
        let quick = try Instance.start_with([String("--test-minute-ms"), String("1000")])
        match idle(quick.copy()) {
            ok => {},
            err(e) => failure = some("{e}"),
        }
        quick.stop()
    }
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nbrowser: all good")
}
