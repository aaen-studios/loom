module tests.protocol.imports

// Importing from OpenBot and Grok Bot (PLAN.md, "Importing from OpenBot and
// Grok Bot"), against small copies of their data folders made here: an
// OpenBot-like openbot.db with a workspace, shared tables and a skill bundle,
// and a Grok Bot-like folder of cache blobs. import.scan finds them, import.run
// brings each kind over with its own times, none of their secrets come, and a
// second import brings nothing twice. Only the owner imports, and loom import
// does the same from the command line.
//
//     calx tests/protocol/imports.calx
import std.fs
import std.json.{Json}
import std.process.{exit}
import std.sqlite.{Database, Value}
import std.time.{Timestamp}
import std.zip.{Writer}
import shared.obj.{Obj, at, int_at, str_at}
import shared.client.{Session, json_of, reply_text}
import tests.kit.{Instance, check, loom}

// What the copies hold that must never come over.
const SECRETS: [str; 8] = ["PROVIDER_TOKEN_SECRET", "VAULT_SECRET_VALUE", "API_KEY_SECRET", "MCP_ENV_SECRET", "MCP_HEADER_SECRET", "GROK_SECRET", "GROK_ENV_SECRET", "GROK_HEADER_SECRET"]

const OPENBOT_SCHEMA: str = #"
CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY);
INSERT INTO schema_migrations VALUES (66);
CREATE TABLE projection_agents (agent_id TEXT PRIMARY KEY, thread_id TEXT, model TEXT NOT NULL, updated_at TEXT, sort_order INTEGER NOT NULL, agent_json TEXT NOT NULL, last_event_sequence INTEGER NOT NULL DEFAULT 0);
CREATE TABLE projection_threads (thread_id TEXT PRIMARY KEY, agent_id TEXT NOT NULL, title TEXT NOT NULL, active_turn_id TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, last_event_sequence INTEGER NOT NULL DEFAULT 0);
CREATE TABLE projection_agent_threads (thread_id TEXT PRIMARY KEY, agent_id TEXT NOT NULL, legacy_task_id TEXT, origin TEXT NOT NULL, title TEXT NOT NULL, title_source TEXT NOT NULL, outcome TEXT, error TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, archived_at TEXT, last_event_sequence INTEGER NOT NULL DEFAULT 0, branch_source_thread_id TEXT, branch_source_message_id TEXT, branch_through_message_id TEXT, routine_id TEXT);
CREATE TABLE projection_thread_messages (thread_id TEXT NOT NULL, message_id TEXT NOT NULL, turn_id TEXT, author TEXT NOT NULL, status TEXT NOT NULL, item_type TEXT, created_at TEXT NOT NULL, ordinal INTEGER NOT NULL, message_json TEXT NOT NULL, last_event_sequence INTEGER NOT NULL DEFAULT 0);
CREATE TABLE projection_pinned_thread_messages (thread_id TEXT NOT NULL, message_id TEXT NOT NULL, pinned_at TEXT NOT NULL, pinned_by_kind TEXT NOT NULL, pinned_by_id TEXT, pinned_by_name TEXT);
CREATE TABLE projection_agent_memories (memory_id TEXT PRIMARY KEY, agent_id TEXT NOT NULL, text TEXT NOT NULL, normalized_text TEXT NOT NULL, origin TEXT NOT NULL, source_turn_id TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, last_event_sequence INTEGER NOT NULL DEFAULT 0, site TEXT);
CREATE TABLE projection_agent_routines (routine_id TEXT PRIMARY KEY, agent_id TEXT NOT NULL, name TEXT NOT NULL, instruction TEXT NOT NULL, active INTEGER NOT NULL, timezone TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, last_event_sequence INTEGER NOT NULL DEFAULT 0, limit_policy TEXT NOT NULL DEFAULT 'wait', missed_policy TEXT NOT NULL DEFAULT 'skip', run_in TEXT NOT NULL DEFAULT 'chat');
CREATE TABLE projection_routine_triggers (trigger_id TEXT PRIMARY KEY, routine_id TEXT NOT NULL, schedule_json TEXT NOT NULL, next_run_at TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, last_event_sequence INTEGER NOT NULL DEFAULT 0);
CREATE TABLE projection_mcp_servers (mcp_server_id TEXT PRIMARY KEY, name TEXT NOT NULL, transport TEXT NOT NULL, enabled INTEGER NOT NULL, command TEXT NOT NULL, args_json TEXT NOT NULL, env_json TEXT NOT NULL, env_passthrough_json TEXT NOT NULL, working_directory TEXT NOT NULL, url TEXT NOT NULL, headers_json TEXT NOT NULL, position INTEGER NOT NULL);
CREATE TABLE projection_attachments (attachment_id TEXT PRIMARY KEY, owner_kind TEXT NOT NULL, owner_id TEXT NOT NULL, name TEXT NOT NULL, path TEXT NOT NULL, metadata_json TEXT NOT NULL, created_at TEXT NOT NULL, last_event_sequence INTEGER NOT NULL DEFAULT 0);
