INSERT INTO projection_mcp_servers VALUES ('mcp1', 'Acta', 'stdio', 1, 'npx', '["-y","acta-mcp"]', '{"ACTA_KEY":"MCP_ENV_SECRET"}', '[]', '', '', '{}', 0);
INSERT INTO projection_mcp_servers VALUES ('mcp2', 'Remote', 'http', 1, '', '[]', '{}', '[]', '', 'https://mcp.example.com/mcp', '{"Authorization":"Bearer MCP_HEADER_SECRET"}', 1);
"#

fn sql_text(s: String) -> Value {
    return Value.Text(s.copy())
}

// A small OpenBot data folder in `root`: its database, a workspace with the main
// agent's AGENTS.md and a shared table, a skill bundle, the sidebar's pins, a
// file a message has, and secrets beside them that must stay.
fn openbot_fixture(root: String) ! Error {
    let ws = "{root}/workspace"
    try fs.make_dir_all("{ws}/Agents/main")
    try fs.make_dir_all("{ws}/Shared/Data")
    try fs.make_dir_all("{root}/attachments")
    try fs.make_dir_all("{root}/agent-api-keys")
    try fs.make_dir_all("{root}/local-skills/local-skill-1/1.0.0")
    try fs.write_text("{ws}/Agents/main/AGENTS.md", String("# Main\n\nYou are Main. Keep it short."))
    try fs.write_text("{root}/attachments/report.txt", String("The report."))
    try fs.write_text("{root}/agent-api-keys/key.txt", String("API_KEY_SECRET"))
    try fs.write_text("{root}/openbot-vault-v1.json", String(#"{"keys":"VAULT_SECRET_VALUE"}"#))
    try fs.write_text("{root}/openbot-sidebar-pins-v1.json", String(#"{"version":1,"pinned":["ag_main"]}"#))
    // The provider OpenBot's Claude uses, in Claude Code's settings, with other settings beside it.
    try fs.make_dir_all("{root}/.claude")
    try fs.write_text("{root}/.claude/settings.json", String(#"{"env":{"ANTHROPIC_BASE_URL":"https://proxy.example.com","ANTHROPIC_AUTH_TOKEN":"PROVIDER_TOKEN_SECRET","OTHER":"x"},"permissions":{"allow":[]}}"#))
    var z = Writer.new()
    z.add(String("weekly-report/SKILL.md"), String("---\nname: Weekly Report\ndescription: When asked for the week's report\n---\n\n# Steps\n\nGather the week.").to_bytes())
    z.add(String("weekly-report/template.md"), String("# Week").to_bytes())
    try fs.write("{root}/local-skills/local-skill-1/1.0.0/bundle.zip", z.finish())

    let db = try Database.open("{root}/openbot.db")
    try db.execute_script(String(OPENBOT_SCHEMA))
    let main_agent = Obj.new().s("id", String("ag_main")).s("name", String("Main")).s("title", String("Helps")).s("description", String("Does things")).s("provider", String("claude")).s("model", String("claude-sonnet-4-5")).s("reasoningEffort", String("high")).s("chatColor", String("blue")).s("threadId", String("th_main")).s("workspacePath", "{ws}/Agents/main").done()
    let helper = Obj.new().s("id", String("ag_helper")).s("name", String("Helper")).s("title", String("Researcher")).s("description", String("Finds things out.")).s("provider", String("codex")).s("avatarColor", String("#18a06a")).s("workspacePath", String("/nowhere/Agents/helper")).done()
    _ = try db.execute(String("INSERT INTO projection_agents VALUES (?, ?, ?, ?, ?, ?, 1)"), [sql_text(String("ag_main")), sql_text(String("th_main")), sql_text(String("claude-sonnet-4-5")), Value.Null, Value.Int(0), sql_text("{main_agent}")])
    _ = try db.execute(String("INSERT INTO projection_agents VALUES (?, ?, ?, ?, ?, ?, 1)"), [sql_text(String("ag_helper")), Value.Null, sql_text(String("gpt-5")), Value.Null, Value.Int(1), sql_text("{helper}")])
    // The report is there; one file is gone; one is a secret, which isn't read.
    _ = try db.execute(String("INSERT INTO projection_attachments VALUES ('at1', 'message', 'th_main:m2', 'report.txt', ?, '[]', '2026-01-02T03:04:09.000Z', 1)"), [sql_text("{root}/attachments/report.txt")])
    _ = try db.execute(String("INSERT INTO projection_attachments VALUES ('at2', 'message', 'th_main:m2', 'gone.png', ?, '[]', '2026-01-02T03:04:09.000Z', 1)"), [sql_text("{root}/attachments/gone.png")])
    _ = try db.execute(String("INSERT INTO projection_attachments VALUES ('at3', 'message', 'th_main:m1', 'key.txt', ?, '[]', '2026-01-02T03:04:05.000Z', 1)"), [sql_text("{root}/agent-api-keys/key.txt")])
    try db.close()

    let tables = try Database.open("{ws}/Shared/Data/agent-data.db")
    try tables.execute_script(String("CREATE TABLE openbot_metadata (table_name TEXT PRIMARY KEY, owner_agent_id TEXT, created_at TEXT); INSERT INTO openbot_metadata VALUES ('reading_list', 'ag_main', '2026-01-01'); CREATE TABLE reading_list (title TEXT, pages INTEGER, done INTEGER); INSERT INTO reading_list VALUES ('Dune', 412, 0); INSERT INTO reading_list VALUES ('Emma', 300, 1);"))
    try tables.close()
}

// A small Grok Bot data folder in `root`: the roster, one agent's recent chat
// and the pins as cache blobs, settings with an MCP server, and its secrets.
fn grok_fixture(root: String) ! Error {
    let cache = "{root}/sand-client-persistence"
    try fs.make_dir_all(cache.copy())
    try fs.make_dir_all("{root}/.grokbot")
    let roster = #"{"schemaVersion":1,"value":{"rows":[{"id":"g_scout","name":"Scout","title":"Scouts the web","description":"Looks things up.","avatarColor":"yellow","harness":"cursor","isGroup":false,"memberIds":[]},{"id":"g_team","name":"Team","isGroup":true,"memberIds":["g_scout"]}]}}"#
    let chat = #"{"schemaVersion":1,"value":{"entries":[{"kind":"message","id":"e1","seq":1,"role":"user","content":"Find me a cafe","timestampMs":1767225600000,"author":{"kind":"user","id":"u1","name":"Elliot"}},{"kind":"message","id":"e2","seq":2,"role":"assistant","content":"Try the one on the corner.","timestampMs":1767225660000,"author":{"kind":"agent","id":"g_scout","name":"Scout"}}]}}"#
    try fs.write_text("{cache}/onxw4zbo.blob", String(roster))
    try fs.write_text("{cache}/mfzgk3tf.blob", String(chat))
    try fs.write_text("{cache}/nbsxg5dp.blob", String(#"{"schemaVersion":1,"value":{"pinnedAgentIds":["g_scout"]}}"#))
    try fs.write_text("{root}/sand-secrets.json", String(#"{"token":"GROK_SECRET"}"#))
    try fs.write_text("{root}/.grokbot/credentials.json", String(#"{"token":"GROK_SECRET"}"#))
    try fs.write_text("{root}/.grokbot/settings.json", String(#"{"mcpBoxServers":{"search":{"command":"npx","args":["-y","search-mcp"],"env":{"KEY":"GROK_ENV_SECRET"}},"docs":{"url":"https://docs.example.com/mcp","headers":{"Authorization":"GROK_HEADER_SECRET"}}}}"#))
}

fn value(r: Json) -> Json {
    return at(r, "value")
}

// Every agent.created event the app has read, by name.
fn agent_named(app: Session, name: str) -> Json {
    var found = Json.Null
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("agent.created")) and str_at(at(f.copy(), "agent"), "name") == some(String(name)) { found = at(f.copy(), "agent") }
    }
    return found
}

// An agent as the app last heard of it, made or changed.
fn agent_by_id(app: Session, id: String) -> Json {
    var found = Json.Null
    for f in app.frames {
        let kind = str_at(f.copy(), "kind") ?? String()
        if (kind == "agent.created" or kind == "agent.updated") and str_at(at(f.copy(), "agent"), "id") == some(id.copy()) { found = at(f.copy(), "agent") }
    }
    return found
}

fn parent_of(path: String) -> String {
    return if let cut = path.find_last("/") { path[..cut].copy() } else { String() }
}

// The conversations made for an agent, as conversation.created told the app.
fn conversations_of(app: Session, agent: String) -> List<Json> {
    var out = List<Json>()
    for f in app.frames {
        let c = at(f.copy(), "conversation")
        if str_at(f.copy(), "kind") == some(String("conversation.created")) and str_at(c.copy(), "agent") == some(agent.copy()) { out.push(c) }
    }
    return out
}

// How many things came, of every kind.
fn total(came: Json) -> i64 {
    var n: i64 = 0
    if let Json.Object(m) = came {
        for (_, v) in m { n += v.as_i64() ?? 0 }
    }
    return n
}

fn ms(iso: str) -> i64 {
    return (Timestamp.parse_iso(String(iso)) ?? Timestamp { unix_ms: 0 }).unix_ms
}

fn run(inst: Instance) ! Error {
    let root = (try fs.temp_dir()).replace("\\", "/")
    let ob = "{root}/OpenBot"
    let gb = "{root}/Grok Bot"
    try openbot_fixture(ob.copy())
    try grok_fixture(gb.copy())
    var app = try Session.connect(inst.base.copy(), inst.token.copy(), 0)

    // --- What's there ---
    let scan = value(try app.cmd("q_1", "import.scan", Obj.new().s("openbot", ob.copy()).s("grokbot", gb.copy()).done()))
    let sources = at(scan, "sources")
    let o = sources.at(0) ?? Json.Null
    let g = sources.at(1) ?? Json.Null
    try check(str_at(o.copy(), "from") == some(String("openbot")) and at(o.copy(), "found") == Json.Bool(true) and int_at(at(o.copy(), "counts"), "agents") == some(2) and int_at(at(o.copy(), "counts"), "messages") == some(3), "import.scan finds OpenBot's data, with how much of each kind")
    try check(at(g.copy(), "found") == Json.Bool(true) and int_at(at(g.copy(), "counts"), "agents") == some(1) and (str_at(g, "text") ?? String()).contains("1 agent"), "and Grok Bot's, in words")
    let provider = at(o.copy(), "provider")
    try check(str_at(provider.copy(), "endpoint") == some(String("https://proxy.example.com")) and at(provider.copy(), "token") == Json.Bool(true) and (str_at(provider.copy(), "text") ?? String()).contains("https://proxy.example.com with a token") and not "{scan}".contains("PROVIDER_TOKEN_SECRET"), "it says which endpoint OpenBot's Claude uses, with a token, and never the token")
    let nowhere = value(try app.cmd("q_2", "import.scan", Obj.new().s("openbot", "{root}/nothing").done()))
    try check(at(at(nowhere, "sources").at(0) ?? Json.Null, "found") == Json.Bool(false), "an app that isn't there is said not to be")

    // --- OpenBot ---
    let first = try app.cmd("q_3", "import.run", Obj.new().s("from", String("openbot")).s("path", ob.copy()).done())
    let r = value(first.copy())
    let came = at(r.copy(), "came")
    println("      {str_at(r.copy(), "text") ?? String()}")
    try check(int_at(came.copy(), "agents") == some(2) and int_at(came.copy(), "messages") == some(3) and int_at(came.copy(), "memories") == some(1) and int_at(came.copy(), "routines") == some(2) and int_at(came.copy(), "skills") == some(1) and int_at(came.copy(), "mcp") == some(2) and int_at(came.copy(), "tables") == some(1) and int_at(came.copy(), "rows") == some(2) and int_at(came.copy(), "files") == some(1) and int_at(came.copy(), "pins") == some(1), "import.run brings each kind over from OpenBot, and says how many")
    let left = "{at(r.copy(), "not")}"
    try check(left.contains("Weekly review") and left.contains("weekly on Friday") and left.contains("file") and left.contains("template") == false and left.contains("only its SKILL.md") and left.contains("environment and headers"), "and says plainly what changed or couldn't come")

    let main_one = agent_named(app, "Main")
    let main_id = str_at(main_one.copy(), "id") ?? String()
    try check((str_at(main_one.copy(), "instructions") ?? String()).contains("You are Main") and str_at(main_one.copy(), "color") == some(String("periwinkle")) and str_at(at(main_one.copy(), "config"), "model") == some(String("sonnet")) and int_at(main_one.copy(), "pinned") != none and str_at(main_one.copy(), "acp_agent") == some(String("fake")), "an agent comes with its AGENTS.md, its colour, its model and its pin")
    try check("{at(main_one.copy(), "mcp")}" == #"["acta","remote"]"#, "and with the MCP servers that came, as every agent in OpenBot has them")
    let helper = agent_named(app, "Helper")
    try check((str_at(helper.copy(), "instructions") ?? String()).contains("Finds things out") and str_at(helper.copy(), "color") == some(String("mint")) and int_at(helper, "pinned") == none, "one without its AGENTS.md takes its title and description, and the nearest colour")

    let convs = conversations_of(app, main_id.copy())
    var chat = String()
    var side = Json.Null
    for c in convs {
        if str_at(c.copy(), "branch_of") != none { side = c.copy() } else { chat = str_at(c, "id") ?? String() }
    }
    let listed = value(try app.cmd("q_4", "messages.list", Obj.new().s("conversation", chat.copy()).done()))
    let ms_list = at(listed, "messages")
    let hello = ms_list.at(0) ?? Json.Null
    let report = ms_list.at(1) ?? Json.Null
    try check(ms_list.len() == 2 and reply_text(hello.copy()) == "Hello there" and str_at(hello.copy(), "role") == some(String("person")) and str_at(hello.copy(), "from") == some(String("import:openbot")) and int_at(hello.copy(), "at") == some(ms("2026-01-02T03:04:05.000Z")), "the chat's messages come with their own times, a system note left out")
    try check(str_at(report.copy(), "agent") == some(main_id.copy()) and "{at(report.copy(), "blocks")}".contains("report.txt") and at(report.copy(), "pinned") != Json.Null, "a reply keeps the file it had, and its pin")
    try check(str_at(side.copy(), "branch_of") == some(chat.copy()) and str_at(side, "branch_at") == some(str_at(hello, "id") ?? String()), "a thread beside the chat is a branch of it, from before it began")

    let notes = "{value(try app.cmd("q_5", "memory.list", Obj.new().s("agent", main_id.copy()).done()))}"
    try check(notes.contains("Elliot likes short answers") and notes.contains("import:openbot"), "memories come, each its agent's")
    let rs = "{value(try app.cmd("q_6", "routine.list", Obj.new().done()))}"
    try check(rs.contains(#""daily":"07:30""#) and rs.contains(#""daily":"16:00""#) and rs.contains("Europe/Oslo") and rs.contains(#""post":"thread""#), "routines come on loom's schedules, in their time zone")
    try check(rs.contains("With nothing new, call routine_quiet.") and not rs.contains("openbot.routine"), "naming loom's routine tools where they named OpenBot's")
    let skill = value(try app.cmd("q_7", "skill.get", Obj.new().s("name", String("weekly-report")).done()))
    try check((str_at(at(skill, "skill"), "body") ?? String()).contains("Gather the week"), "a skill comes from its bundle")
    let mcp = "{value(try app.cmd("q_8", "mcp.list", Obj.new().done()))}"
    try check(mcp.contains("acta") and mcp.contains("acta-mcp") and mcp.contains("https://mcp.example.com/mcp"), "MCP servers come")
    let rows = "{value(try app.cmd("q_9", "table.rows", Obj.new().s("table", String("reading_list")).done()))}"
    try check(rows.contains("Dune") and rows.contains("Emma") and rows.contains("\"owner\":\"{main_id}\""), "a shared table comes with its rows, its owner's")

    // --- Grok Bot ---
    let grok = value(try app.cmd("q_10", "import.run", Obj.new().s("from", String("grokbot")).s("path", gb.copy()).done()))
    let gcame = at(grok.copy(), "came")
    let scout = agent_named(app, "Scout")
    let scout_chat = conversations_of(app, str_at(scout.copy(), "id") ?? String())
    let gmessages = at(value(try app.cmd("q_11", "messages.list", Obj.new().s("conversation", str_at(if scout_chat.len() > 0 { scout_chat[0].copy() } else { Json.Null }, "id") ?? String()).done())), "messages")
    try check(int_at(gcame.copy(), "agents") == some(1) and int_at(gcame, "mcp") == some(2) and gmessages.len() == 2 and int_at(gmessages.at(0) ?? Json.Null, "at") == some(1767225600000) and int_at(scout.copy(), "pinned") != none and str_at(scout, "color") == some(String("gold")), "Grok Bot's agents, recent chats, pins and MCP servers come")
    let gleft = "{at(grok, "not")}"
    try check(gleft.contains("own server") and gleft.contains("Team"), "and it says what Grok Bot doesn't keep on this computer")

    // --- No secrets ---
    var everything = String()
    for (k, name) in [("q_12", "mcp.list"), ("q_13", "memory.list"), ("q_14", "skill.list"), ("q_15", "activity.list"), ("q_16", "routine.list"), ("q_17", "table.list")] {
        everything.push_str("{try app.cmd(k, name, Obj.new().b("bodies", true).done())}")
    }
    for f in app.frames { everything.push_str("{f}") }
    var leaked = String()
    for s in SECRETS {
        if everything.contains(s) { leaked = String(s) }
    }
    try check(leaked.len() == 0 and everything.contains("Brought over from OpenBot"), "no secret comes over, and the activity log says what did")

    // --- Twice ---
    let again = value(try app.cmd("q_18", "import.run", Obj.new().s("from", String("openbot")).s("path", ob.copy()).done()))
    let relisted = at(value(try app.cmd("q_19", "messages.list", Obj.new().s("conversation", chat.copy()).done())), "messages")
    try check(total(at(again.copy(), "came")) == 0 and (int_at(again.copy(), "already") ?? 0) > 0 and relisted.len() == 2 and (str_at(again, "text") ?? String()).contains("here already"), "importing again brings nothing twice")

    // --- Only the owner, and from the command line ---
    let member = try inst.second_account("ann")
    var theirs = try Session.connect(inst.base.copy(), member, 0)
    let refused = try theirs.cmd("q_20", "import.scan", Obj.new().done())
    try check(str_at(at(refused, "error"), "code") == some(String("not_allowed")), "only the owner imports")
    theirs.close()
    let token = str_at(value(try app.cmd("q_21", "scripts.on", Obj.new().done())), "token") ?? String()
    let out = try loom(inst.data.copy(), [String("import"), String("grokbot"), gb.copy(), String("--url"), "http://{inst.base}", String("--token"), token]).output()
    try check(out.status.success() and out.text().contains("here already"), "loom import grokbot does it from the command line")

    // --- The provider, carried over once the person says yes ---
    try inst.add_fake(String("claude"), String("--load"))
    let carried = value(try app.cmd("q_22", "import.run", Obj.new().s("from", String("openbot")).s("path", ob.copy()).b("carry_provider", true).done()))
    let p = at(carried.copy(), "provider")
    try check(at(p.copy(), "carried") == Json.Bool(true) and str_at(p.copy(), "program") == some(String("claude")) and str_at(p, "endpoint") == some(String("https://proxy.example.com")) and not "{carried}".contains("PROVIDER_TOKEN_SECRET"), "import.run with carry_provider gives the provider to the Claude agent program, saying the endpoint, not the token")
    let programs = "{value(try app.cmd("q_23", "acp.list", Obj.new().done()))}"
    try check(programs.contains(#""ANTHROPIC_BASE_URL","ANTHROPIC_AUTH_TOKEN""#) and not programs.contains("PROVIDER_TOKEN_SECRET") and not programs.contains("OTHER"), "kept in its sealed settings, of which only the names come back, and nothing else of Claude's settings")
    let made = value(try app.cmd("q_24", "agent.create", Obj.new().s("name", String("Carried")).s("acp_agent", String("claude")).s("instructions", String("Test.")).done()))
    let carried_agent = str_at(at(made, "agent"), "id") ?? String()
    let opened = value(try app.cmd("q_25", "conversation.create", Obj.new().s("agent", carried_agent).done()))
    try app.send(Obj.new().s("t", String("send")).s("cid", String("c_1")).s("conversation", str_at(opened, "conversation") ?? String()).s("text", String("/env ANTHROPIC_BASE_URL")).done())
    try check(reply_text(try app.reply()) == "ANTHROPIC_BASE_URL=https://proxy.example.com", "and an agent on it starts with that endpoint")

    // --- From another user's folder, as root would, while OpenBot writes to it ---
    let home = "{root}/home-openbot"
    let data = "{home}/.config/OpenBot"
    try openbot_fixture(data.copy())
    try fs.make_dir_all("{home}/.claude")
    try fs.write_text("{home}/.claude/settings.json", String(#"{"env":{"ANTHROPIC_BASE_URL":"https://proxy2.example.com","ANTHROPIC_AUTH_TOKEN":"PROVIDER_TOKEN_SECRET"}}"#))
    try fs.make_dir_all("{home}/.agents/skills/notes")
    try fs.write_text("{home}/.agents/skills/notes/SKILL.md", String("---\nname: notes\ndescription: Taking notes\n---\n\nWrite them down."))
    try fs.write_text("{data}/attachments/notes.txt", String("The notes."))
    // A repo in the user's home that an agent works in, which the loom user can't read there.
    try fs.make_dir_all("{home}/repos/elliot/.git")
    try fs.make_dir_all("{home}/repos/elliot/data")
    try fs.write_text("{home}/repos/elliot/data/food.csv", String("day,what\n"))
    try fs.write_text("{data}/workspace/Agents/main/AGENTS.md", "# Main\n\nYou are Main. Log food in {home}/repos/elliot/data/food.csv.")
    let coach_made = value(try app.cmd("q_25b", "agent.create", Obj.new().s("name", String("Coach")).s("acp_agent", String("fake")).s("instructions", "Log food in {home}/repos/elliot/data/food.csv.").done()))
    let coach = str_at(at(coach_made, "agent"), "id") ?? String()
    // OpenBot is running: what it wrote last is still in its WAL, which a copy of the file would miss.
    let live = try Database.open("{data}/openbot.db")
    _ = try live.query(String("PRAGMA journal_mode=WAL"))
    _ = try live.query(String("PRAGMA wal_autocheckpoint=0"))
    _ = try live.execute(String(#"INSERT INTO projection_thread_messages VALUES ('th_main', 'm9', 't9', 'user', 'done', 'message', '2026-01-03T09:00:00.000Z', 4, '{"id":"m9","author":"user","text":"Written while it ran","source":"user"}', 1)"#))
    _ = try live.execute(String("INSERT INTO projection_attachments VALUES ('at9', 'message', 'th_main:m9', 'notes.txt', ?, '[]', '2026-01-03T09:00:00.000Z', 1)"), [sql_text("{data}/attachments/notes.txt")])
    let staged_run = try loom(inst.data.copy(), [String("import"), String("openbot"), String("--from-user"), String("openbot"), String("--test-from-home"), home.copy(), String("--carry-provider"), String("--url"), "http://{inst.base}", String("--json")]).output()
    try live.close()
    let said = json_of(staged_run.stdout.copy())
    let staged_came = at(said.copy(), "came")
    println("      {str_at(said.copy(), "text") ?? staged_run.error_text()}")
    try check(staged_run.status.success() and int_at(staged_came.copy(), "messages") == some(1) and int_at(staged_came.copy(), "files") == some(1) and int_at(staged_came, "skills") == some(1) and (int_at(said.copy(), "already") ?? 0) > 0, "loom import openbot --from-user stages a snapshot that has what was still in the WAL, with its file and the user's skills, and imports what's new")
    try check(str_at(at(said.copy(), "provider"), "endpoint") == some(String("https://proxy2.example.com")) and not "{said}".contains("PROVIDER_TOKEN_SECRET") and not staged_run.error_text().contains("PROVIDER_TOKEN_SECRET"), "with --carry-provider the user's Claude provider comes too, its token never said")
    let stage_dir = (str_at(at(said.copy(), "staged"), "path") ?? String()).copy()
    let files_map = try fs.read_text("{stage_dir}/loom-files.json") ?? String()
    try check(stage_dir.ends_with("/imports/openbot") and fs.is_file("{stage_dir}/openbot.db") and files_map.contains("notes.txt") and files_map.contains("report.txt") and not files_map.contains("key.txt") and not fs.exists("{stage_dir}/openbot-vault-v1.json") and not fs.exists("{stage_dir}/agent-api-keys"), "the staged folder in the instance's imports/ has the snapshot and the chats' files, but no secret")
    try check(not fs.exists("{stage_dir}/.claude/settings.json") and not fs.exists("{inst.data}/imports/pending.json") and not fs.exists("{inst.data}/imports/done.json"), "and keeps no token once it's imported, nor anything waiting")
    let main_chat = at(value(try app.cmd("q_26", "messages.list", Obj.new().s("conversation", chat.copy()).done())), "messages")
    try check("{main_chat}".contains("Written while it ran"), "the message written while OpenBot ran is in the chat")
    let coach_now = str_at(agent_by_id(app, coach), "instructions") ?? String()
    let moved = coach_now.replace("Log food in ", "").trim_suffix(".").replace("\\", "/")
    try check(int_at(staged_came.copy(), "folders") == some(1) and moved.contains("/shared/") and moved.ends_with("/elliot/data/food.csv") and fs.is_file(moved.copy()) and fs.is_dir("{parent_of(parent_of(moved))}/.git"), "a repo in the user's home that an agent names comes into the shared folder, and the agent names it there")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nimports: all good")
}
