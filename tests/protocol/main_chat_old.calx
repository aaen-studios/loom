module tests.protocol.main_chat_old

// An instance from before chats were fixed (protocol.md, "An agent's chat") fixes
// them when it starts. Its store has the shape of one where an agent made a
// conversation for itself mid-task with conversation.create, which then showed as the
// agent's chat, and the person's next message went there: it's the newest. Started
// again, the instance marks that conversation as the agent's thread (`made_by`), from
// the activity log, and the person's chat, with its history, as the agent's chat
// (`main`). The devices hear both, nothing is deleted, and a real core sends what the
// person writes to the agent into the chat.
//
//     calx tests/protocol/main_chat_old.calx
import std.json.{Json, parse}
import std.process.{exit}
import std.sqlite.{Database}
import std.time.{Instant}
import shared.obj.{Obj, at, bool_at, str_at}
import shared.client.{Session, reply_text}
import core.cache.{Cache}
import core.conn.{Conn, ToApp}
import tests.kit.{Instance, check}

// The agent's next reply in `conversation`, as text.
fn reply_in(app: mut Session, conversation: String) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return reply_text(m) }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

// The conversation the person's message `text` was stored in.
fn stored_in(app: mut Session, text: str) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("person")) and reply_text(m.copy()) == text { return str_at(m, "conversation") ?? String() }
    }
}

// The app's side of a real core: what it sends, and what the core tells it.
struct App {
    to_core: Sender<String>
    from_core: Receiver<ToApp>
    thread: Thread?
}

impl App {
    fn start(base: String, token: String) -> App ! Error {
        let inbox = Receiver<String>()
        let to_core = inbox.sender()
        let from_core = Receiver<ToApp>()
        let conn = Conn.new(some("http://{base}"), some(token.copy()), String("loom-test-main-chat-old"), try Cache.open(String(":memory:")), inbox, from_core.sender())
        let t = unsafe { Thread.spawn(conn) }
        return App { to_core: to_core, from_core: from_core, thread: some(t) }
    }

    fn until(mut self, t: str, field: str, value: String, ms: u64) -> Json ! Error {
        let start = unsafe { Instant.now() }
        loop {
            let waited = unsafe { Instant.now() }.nanos_since(start) / 1000000
            if waited >= ms { fail "no {t} {field}={value} came in {ms} ms" }
            let got = unsafe { self.from_core.wait_for((ms - waited) * 1000000) } else { continue }
            let m = got.text() else { continue }
            let f = try parse(m)
            if (str_at(f.copy(), "t") ?? String()) != t { continue }
            if field.len() == 0 or (str_at(f.copy(), field) ?? String()) == value { return f }
        }
    }

    fn conversations(mut self, id: str) -> List<Json> ! Error {
        self.to_core.send("{Obj.new().s("t", String("core.get")).s("id", String(id)).s("what", String("conversations")).done()}")
        let got = try self.until("core.data", "id", String(id), 5000)
        let Json.Array(items) = at(got, "items") else return List<Json>()
        return items
    }

    fn stop(mut self) {
        self.to_core.send(String(#"{"t":"core.stop"}"#))
        if let t = self.thread.take() { t.join() }
    }
}

fn find(list: List<Json>, id: String) -> Json {
    for c in list {
        if str_at(c.copy(), "id") == some(id.copy()) { return c.copy() }
    }
    return Json.Null
}

// The store as an older instance left it: gives the event to go on from, the agent,
// its chat, the thread it made and how many conversations there are.
fn before(i: Instance) -> (i64, String, String, String, usize) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Casper")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).b("code_mode", false).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()
    _ = try say(mut app, chat.copy(), "m_1", String("hello"))
    _ = try say(mut app, chat.copy(), "m_2", String("and more"))
    let call = Obj.new().s("name", String("conversation.create")).j("args", Obj.new().s("agent", agent.copy()).s("title", String("Plenpartner warm-up")).done()).done()
    _ = try say(mut app, chat.copy(), "m_3", "/mcp run_command {call}")
    var thread = String()
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String("conversation.created")) and str_at(at(f.copy(), "conversation"), "title") == some(String("Plenpartner warm-up")) { thread = str_at(at(f.copy(), "conversation"), "id") ?? String() }
    }
    try check(thread.len() > 0, "Casper makes a conversation for itself")
    // The person's next message went into it, as it showed as the chat: it's the newest.
    _ = try say(mut app, thread.copy(), "m_4", String("where did it go"))
    let seq = app.seq
    app.close()
    // As an older instance kept it: nothing marks the chat, or the thread as Casper's.
    let db = try Database.open("{i.data}/loom.db")
    _ = try db.execute(String("DELETE FROM main_chats"), [])
    _ = try db.execute(String("DELETE FROM made_threads"), [])
    _ = try db.execute(String("DELETE FROM meta WHERE key = 'made_threads_marked'"), [])
    let counted = try db.query(String("SELECT id FROM conversations WHERE deleted = 0"), [])
    return (seq, agent, chat, thread, counted.len())
}

fn after_restart(i: Instance, seq: i64, agent: String, chat: String, thread: String, count: usize) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), seq)
    // The devices hear of both with the events they missed, which may have come already.
    var marked_thread = false
    var marked_chat = false
    var waited = 0
    while not (marked_thread and marked_chat) and waited < 2 {
        for f in app.frames {
            if str_at(f.copy(), "kind") != some(String("conversation.updated")) { continue }
            let c = at(f.copy(), "conversation")
            if str_at(c.copy(), "id") == some(thread.copy()) and str_at(c.copy(), "made_by") == some(agent.copy()) { marked_thread = true }
            if str_at(c.copy(), "id") == some(chat.copy()) and bool_at(c, "main") == some(true) { marked_chat = true }
        }
        if not (marked_thread and marked_chat) { _ = try app.until("event", "conversation.updated") }
        waited += 1
    }
    try check(marked_thread, "the conversation Casper made is marked as its thread, and the devices hear so")
    try check(marked_chat, "the person's chat is marked as Casper's chat, and the devices hear so")
    var core = try App.start(i.base.copy(), i.token.copy())
    _ = try core.until("synced", "", String(), 30000)
    let list = try core.conversations("g_1")
    try check(list.len() == count, "nothing is deleted")
    try check(bool_at(find(list.copy(), chat.copy()), "main") == some(true), "a new device has the person's chat as Casper's chat")
    let t = find(list, thread.copy())
    try check(str_at(t.copy(), "made_by") == some(agent.copy()) and bool_at(t, "main") != some(true), "and the conversation Casper made beside it")
    core.to_core.send("{Obj.new().s("t", String("send")).s("agent", agent).s("text", String("back again")).done()}")
    try check(try stored_in(mut app, "back again") == chat, "what the person writes to Casper goes into the chat")
    core.stop()
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    var failure: String? = none
    var left: (i64, String, String, String, usize) = (0, String(), String(), String(), 0)
    match before(inst.copy()) {
        ok(l) => left = l,
        err(e) => failure = some("{e}"),
    }
    if failure != none {
        inst.stop()
    } else {
        let (seq, agent, chat, thread, count) = left
        let back = try inst.restart()
        match after_restart(back.copy(), seq, agent, chat, thread, count) {
            ok => {},
            err(e) => failure = some("{e}"),
        }
        back.stop()
    }
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nmain_chat_old: all good")
}
