module tests.protocol.cards

// Cards in the chat (PLAN.md, "Cards in the chat"): show_card puts a small
// card in the agent's reply, which the apps draw: choices, a checklist, a
// table, progress or facts. Each change goes out at once as a `card` frame,
// and the finished reply keeps the card as it was last.
//
//     calx tests/protocol/cards.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, str_at}
import tests.kit.{App, Instance, check, reply_text}

fn reply_in(app: mut App, conversation: String) -> Json ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return m }
    }
}

fn say(app: mut App, conversation: String, cid: str, text: String) -> Json ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

// The message's card blocks' cards.
fn cards_in(m: Json) -> List<Json> {
    var out = List<Json>()
    if let Json.Array(blocks) = at(m, "blocks") {
        for b in blocks {
            if str_at(b.copy(), "kind") == some(String("card")) { out.push(at(b.copy(), "card")) }
        }
    }
    return out
}

fn strings(xs: List<str>) -> Json {
    var out = List<Json>()
    for x in xs {
        out.push(Json.Str(String(x)))
    }
    return Json.Array(out)
}

fn run(i: Instance) ! Error {
    var app = try App.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Carder")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()

    let choices = Obj.new().s("type", String("choices")).s("title", String("Which colour?")).j("options", strings(["Red", "Green", "Blue"])).done()
    let asked = try say(mut app, chat.copy(), "m_1", "/mcp show_card {choices}")
    let shown = cards_in(asked.copy())
    try check(reply_text(asked).starts_with("show_card: It's in the chat, as card_1") and shown.len() == 1, "show_card puts a card in the agent's reply")
    try check("{shown[0]}" == "\{\"id\":\"card_1\",\"type\":\"choices\",\"title\":\"Which colour?\",\"options\":[\"Red\",\"Green\",\"Blue\"]\}", "as the card it described, with its id")

    let bad = reply_text(try say(mut app, chat.copy(), "m_2", "/mcp show_card {Obj.new().s("type", String("choices")).j("options", strings(["Only"])).done()}"))
    try check(bad.starts_with("show_card failed: options has 1"), "a card that can't be drawn is refused, saying why")
    let odd = reply_text(try say(mut app, chat.copy(), "m_3", "/mcp show_card {Obj.new().s("type", String("chart")).done()}"))
    try check(odd.starts_with("show_card failed: type is \"chart\""), "and so is a type there isn't")

    // A card changed while the agent works: each change comes at once, as a
    // card frame, and the reply keeps the last.
    let start = Obj.new().s("type", String("progress")).s("label", String("0 of 2 files")).j("value", Json.Float(0.0)).done()
    let half = Obj.new().s("type", String("progress")).s("id", String("card_1")).s("label", String("1 of 2 files")).j("value", Json.Float(0.5)).done()
    let table = Obj.new().s("type", String("table")).j("columns", strings(["File", "Size"])).j("rows", Json.Array([strings(["a.txt", "2 KB"])])).done()
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_4")).s("conversation", chat.copy()).s("text", "/mcp show_card {start}\n/mcp show_card {half}\n/mcp show_card {table}").done())
    let first = try app.until("card", "")
    try check(int_at_or(first.copy(), "block") >= 0 and str_at(at(first.copy(), "card"), "label") == some(String("0 of 2 files")), "a new card goes to the apps at once")
    let second = try app.until("card", "")
    try check(at(first.copy(), "block") == at(second.copy(), "block") and str_at(at(second, "card"), "label") == some(String("1 of 2 files")), "and a change to it takes its place")
    let moved = try reply_in(mut app, chat.copy())
    let kept = cards_in(moved.copy())
    try check(kept.len() == 2 and at(kept[0].copy(), "value").as_f64() == some(0.5) and str_at(kept[1].copy(), "id") == some(String("card_2")), "the reply keeps each card as it was last")
    try check(reply_text(moved).contains("show_card: Changed card_1 in the chat."), "the agent hears it was changed")

    let gone = reply_text(try say(mut app, chat.copy(), "m_5", "/mcp show_card {Obj.new().s("type", String("facts")).s("id", String("card_9")).j("items", Json.Array([Obj.new().s("label", String("A")).s("value", String("1")).done()])).done()}"))
    try check(gone.starts_with("show_card failed: There's no card card_9 in this reply"), "a card from another reply can't be changed")
    app.close()
}

fn int_at_or(f: Json, key: str) -> i64 {
    if let Json.Int(n) = at(f, key) { return n }
    return -1
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\ncards: all good")
}
