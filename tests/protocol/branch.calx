module tests.protocol.branch

// Branching a chat (PLAN.md, "Branching a chat"): conversation.branch makes a
// conversation with the same agent that goes on from a message, marked with
// the chat and the message it branches at. Its first turn hands the agent the
// chat up to that message, and not after it; the chat goes on as it was.
//
//     calx tests/protocol/branch.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, str_at}
import tests.kit.{App, Instance, check, reply_text}

fn reply_in(app: mut App, conversation: String) -> Json ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return m }
    }
}

fn say(app: mut App, conversation: String, cid: str, text: String) -> Json ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

// The newest event of `kind` among what the app has read.
fn last(app: App, kind: str) -> Json {
    var found = Json.Null
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String(kind)) { found = f.copy() }
    }
    return found
}

fn run(i: Instance) ! Error {
    var app = try App.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_1", "agent.create", Obj.new().s("name", String("Main")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_2", "conversation.create", Obj.new().s("agent", agent).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()
    _ = try say(mut app, chat.copy(), "m_1", String("apples"))
    let pears = try say(mut app, chat.copy(), "m_2", String("pears"))
    _ = try say(mut app, chat.copy(), "m_3", String("plums"))
    let at_pears = str_at(pears, "id") ?? String()

    let branched = try app.cmd("q_3", "conversation.branch", Obj.new().s("message", at_pears.copy()).done())
    let branch = str_at(at(branched, "value"), "conversation") ?? String()
    let made_event = at(last(app, "conversation.created"), "conversation")
    try check(branch.len() > 0 and str_at(made_event.copy(), "id") == some(branch.copy()) and str_at(made_event.copy(), "branch_of") == some(chat.copy()) and str_at(made_event.copy(), "branch_at") == some(at_pears.copy()) and str_at(made_event, "title") == some(String("Branch: pears")), "a chat branches at a message, into a conversation marked with where it came from")

    let handed = reply_text(try say(mut app, branch.copy(), "m_4", String("/context")))
    try check(handed.contains("branch of your chat") and handed.contains("Your person: apples") and handed.contains("You: pears") and not handed.contains("plums"), "its first turn hands the agent the chat up to there, and not after")
    let again = reply_text(try say(mut app, branch.copy(), "m_5", String("/context")))
    try check(again == "no context", "and only the first")
    let still = reply_text(try say(mut app, chat.copy(), "m_6", String("/context")))
    try check(not still.contains("branch"), "the chat goes on as it was")

    let missing = try app.cmd("q_4", "conversation.branch", Obj.new().s("message", String("msg_nothing")).done())
    try check(str_at(at(missing, "error"), "code") == some(String("not_found")), "a message that isn't there doesn't branch")
    _ = try app.cmd("q_5", "chat.ask", Obj.new().s("conversation", chat.copy()).s("question", String("what fruit?")).done())
    let side = str_at(at(last(app, "conversation.created"), "conversation"), "id") ?? String()
    let asked = try app.cmd("q_6", "messages.list", Obj.new().s("conversation", side).done())
    var in_side = String()
    if let Json.Array(ms) = at(at(asked, "value"), "messages") {
        if ms.len() > 0 { in_side = str_at(ms[0].copy(), "id") ?? String() }
    }
    let from_side = try app.cmd("q_7", "conversation.branch", Obj.new().s("message", in_side).done())
    try check(str_at(at(from_side, "error"), "code") == some(String("bad_request")), "side questions don't branch")
    let by_agent = reply_text(try say(mut app, chat.copy(), "m_7", "/mcp run_command {Obj.new().s("name", String("conversation.branch")).j("args", Obj.new().s("message", at_pears).s("title", String("Pears again")).done()).done()}"))
    try check(by_agent.starts_with("run_command:") and str_at(at(last(app, "conversation.created"), "conversation"), "title") == some(String("Pears again")), "an agent branches one too")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nbranch: all good")
}
