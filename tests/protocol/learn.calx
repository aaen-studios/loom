module tests.protocol.learn

// What an agent learns from a chat (PLAN.md, "Memory" and "Sharing and
// learning"). A note the agent keeps is kept at once, under its reply and in
// the activity log, and Undo there forgets it. Once the chat pauses, the agent
// looks back over it in a quiet turn, and what it keeps goes under the chat's
// last reply; a message the person sends then stops that turn and goes at
// once. A skill it said failed is fixed: with a mode that doesn't ask about
// everyday changes, the fix is put in, with the lines it removes and adds, and
// undone. With a mode that asks, a note, even one for every agent, is still
// kept at once, and forgetting it takes it from every agent; a fix waits on a
// card under the reply: put off, it waits on the Proposals page, and a fix the
// person changed is kept as they changed it, to
// the skill by the name it has now when it was renamed while the fix waited. In
// a group chat, each member that answered looks back over its own part, one
// after the other, and what it keeps goes under its own reply. A note an older
// instance left waiting is kept when the instance starts.
//
//     calx tests/protocol/learn.calx
import std.json.{Json}
import std.process.{exit}
import std.sqlite.{Database, Value}
import shared.obj.{Obj, at, bool_at, str_at}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

// A minute lasts this many ms here, so a chat pauses after 4 of them.
const MINUTE_MS: str = "150"

const SKILL: str = "# Post release notes\n\n1. Open the drafts.\n2. Paste the notes.\n3. Press Publish.\n4. Share the link.\n"
const FIXED: str = "# Post release notes\n\n1. Open the drafts.\n2. Paste the notes.\n3. Press Release, at the top.\n4. Share the link.\n"
// Words enough for a chat to be looked back over once it pauses (learn.LOOK_BACK_LEAST).
const TALK: str = "We talked it through: the chess club meets on Tuesdays at the library, the Sunday runs start at the bridge at nine, and both of them should go in the shared calendar so nobody books anything else over them. Next week we try the new route along the river and the longer opening in the club games."

// The agent's reply in `conversation`, the next to come.
fn reply_in(app: mut Session, conversation: String, wait_ms: u32 = 30000) -> Json ! Error {
    loop {
        let created = try app.until("event", "message.created", wait_ms)
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return m }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> Json ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

fn see(passed: bool, what: str, got: String) ! Error {
    if not passed { fail "failed: {what}, from:\n{got}" }
    println("ok    {what}")
}

// What's under reply `m`, each as learn.shown gives it.
fn learned(m: Json) -> List<Json> {
    let Json.Array(list) = at(m, "learned") else return List<Json>()
    return list
}

// The reply `id` once what's under it says `want`, as its message.updated does,
// read already or still to come.
fn under(app: mut Session, id: String, want: str) -> Json ! Error {
    var looked: usize = 0
    loop {
        while looked < app.frames.len() {
            let f = app.frames[looked].copy()
            looked += 1
            if str_at(f.copy(), "kind") != some(String("message.updated")) { continue }
            let m = at(f, "message")
            if str_at(m.copy(), "id") == some(id.copy()) and "{at(m.copy(), "learned")}".contains(want) { return m }
        }
        _ = try app.until("event", "message.updated", 30000)
    }
}

fn agent_cmd(app: mut Session, id: str, agent: String, permission: str) ! Error {
    let r = try app.cmd(id, "agent.update", Obj.new().s("agent", agent).s("permission", String(permission)).done())
    if bool_at(r.copy(), "ok") != some(true) { fail "agent.update: {r}" }
}

fn memories(app: mut Session, id: str) -> String ! Error {
    return "{try app.cmd(id, "memory.list", Obj.new().done())}"
}

fn memories_of(app: mut Session, id: str, agent: String) -> String ! Error {
    return "{try app.cmd(id, "memory.list", Obj.new().s("agent", agent).done())}"
}

fn skill_body(app: mut Session, id: str) -> String ! Error {
    return try body_of(mut app, id, "post-release-notes")
}

fn body_of(app: mut Session, id: str, name: str) -> String ! Error {
    let got = try app.cmd(id, "skill.get", Obj.new().s("name", String(name)).done())
    return str_at(at(at(got, "value"), "skill"), "body") ?? String()
}

// Renames the skill `was` to `name`, as the Skills page's Save does.
fn rename_skill(app: mut Session, id: str, was: str, name: str, body: String) -> Json ! Error {
    return try app.cmd(id, "skill.put", Obj.new().s("name", String(name)).s("was", String(was)).s("description", String("Posting the release notes.")).s("body", body).done())
}

fn activity(app: mut Session, id: str) -> String ! Error {
    return "{try app.cmd(id, "activity.list", Obj.new().done())}"
}

// Keeping it on its own, with a mode that doesn't ask about everyday changes.
fn kept_part(app: mut Session, agent: String, chat: String) ! Error {
    try agent_cmd(mut app, "q_k0", agent.copy(), "allow")
    let m = try say(mut app, chat.copy(), "m_k1", String(#"/mcp propose_note {"text":"Ann buys wool socks.","why":"She said so today."}"#))
    try see(reply_text(m.copy()).starts_with("propose_note: Kept:"), "a note an agent proposes in allow is kept at once", reply_text(m.copy()))
    let items = learned(m.copy())
    try see(items.len() == 1 and str_at(items[0].copy(), "status") == some(String("kept")) and str_at(items[0].copy(), "by") == some(String("auto")) and str_at(at(items[0].copy(), "note"), "text") == some(String("Ann buys wool socks.")), "and its reply has it under it, kept by the permission mode", "{m}")
    let id = str_at(items[0].copy(), "id") ?? String()
    try check((try memories(mut app, "q_k1")).contains("Ann buys wool socks."), "as one of the agent's notes")
    let log = try activity(mut app, "q_k2")
    try see(log.contains("Remembered: Ann buys wool socks.") and log.contains("\"proposal\":\"{id}\",\"undo\":true"), "and in the activity log, which can undo it", log.copy())

    let undone = try app.cmd("q_k3", "proposal.undo", Obj.new().s("id", id.copy()).done())
    try see(str_at(at(at(undone.copy(), "value"), "proposal"), "status") == some(String("undone")), "proposal.undo undoes it", "{undone}")
    try check(not (try memories(mut app, "q_k4")).contains("Ann buys wool socks."), "and the note is forgotten")
    let after = try under(mut app, str_at(m, "id") ?? String(), "\"status\":\"undone\"")
    try check(learned(after).len() == 1, "the reply says so, for every device")
    let log2 = try activity(mut app, "q_k5")
    try see(log2.contains("Forgot what was remembered: Ann buys wool socks.") and log2.contains("\"proposal\":\"{id}\",\"undo\":false"), "and the log, where it can't be undone again", log2)
    let twice = try app.cmd("q_k6", "proposal.undo", Obj.new().s("id", id).done())
    try check(str_at(at(twice, "error"), "code") == some(String("not_now")), "a note is undone once")

    let self_undo = try say(mut app, chat.copy(), "m_k3", "/mcp run_command {Obj.new().s("name", String("proposal.undo")).j("args", Obj.new().s("id", String("prop_1")).done()).done()}")
    try see(reply_text(self_undo.copy()).starts_with("run_command failed"), "an agent can't undo one itself", reply_text(self_undo))
}

// Looking back once the chat pauses, and a skill that fixes itself.
fn look_back_part(app: mut Session, chat: String) ! Error {
    let m = try say(mut app, chat.copy(), "m_l1", String("/next /mcp propose_note \{\"text\":\"Ann's sister is Bea.\"\}\nok"))
    try check(reply_text(m.copy()) == "ok", "the person's turn ends")
    let reply = str_at(m, "id") ?? String()
    let looked = try app.until("event", "run.started", 30000)
    try see(bool_at(looked.copy(), "quiet") == some(true) and str_at(looked.copy(), "conversation") == some(chat.copy()), "once the chat pauses, its agent looks back over it in a quiet turn", "{looked}")
    let kept = try under(mut app, reply.copy(), "Ann's sister is Bea.")
    try see("{at(kept.copy(), "learned")}".contains("\"status\":\"kept\""), "and what it keeps goes under the chat's last reply", "{kept}")
    try check((try memories(mut app, "q_l1")).contains("Ann's sister is Bea."), "as a note")

    _ = try app.cmd("q_l2", "skill.put", Obj.new().s("name", String("post-release-notes")).s("description", String("Posting the release notes.")).s("body", String(SKILL)).done())
    let early = try say(mut app, chat.copy(), "m_l2", "/mcp fix_skill {Obj.new().s("name", String("post-release-notes")).s("body", String(FIXED)).done()}")
    try see(reply_text(early.copy()).contains("You haven't said post-release-notes failed"), "fix_skill is only for a skill its agent said failed", reply_text(early))
    let failed = try say(mut app, chat.copy(), "m_l3", String(#"/mcp skill_failed {"name":"post-release-notes","step":"Press Publish","why":"There's no Publish button any more."}"#))
    try see(reply_text(failed.copy()).starts_with("skill_failed: Noted."), "skill_failed says a skill failed at a step", reply_text(failed))
    let fix = Obj.new().s("name", String("post-release-notes")).s("body", String(FIXED)).s("why", String("The button is called Release now.")).done()
    let asked = try say(mut app, chat.copy(), "m_l4", "/next /mcp fix_skill {fix}\nok")
    let fixed = try under(mut app, str_at(asked, "id") ?? String(), "post-release-notes")
    let items = learned(fixed.copy())
    let f = items[items.len() - 1].copy()
    try see(str_at(f.copy(), "kind") == some(String("fix")) and str_at(f.copy(), "status") == some(String("kept")) and "{at(f.copy(), "fix")}".contains("\"step\":\"Press Publish\""), "looking back, the agent fixes the skill, which is put in at once, saying why it failed", "{f}")
    try see("{at(at(f.copy(), "fix"), "lines")}".contains(#"{"op":"-","text":"3. Press Publish."},{"op":"+","text":"3. Press Release, at the top."}"#), "with the lines it removes and adds", "{f}")
    try check((try skill_body(mut app, "q_l3")) == FIXED, "the skill is the fix now")
    let again = try say(mut app, chat.copy(), "m_l5", "/mcp fix_skill {fix}")
    try check(reply_text(again).contains("You haven't said"), "and one failure is fixed once")
    let undone = try app.cmd("q_l4", "proposal.undo", Obj.new().s("id", str_at(f, "id") ?? String()).done())
    try see(str_at(at(at(undone.copy(), "value"), "proposal"), "status") == some(String("undone")), "the fix is undone", "{undone}")
    try check((try skill_body(mut app, "q_l5")) == SKILL, "and the skill is as it was")
    try check((try activity(mut app, "q_l6")).contains("Undid the fix to the skill post-release-notes"), "which the activity log says")

    // A message while it looks back stops that turn, and goes at once. It says
    // enough to be looked back over itself, whether or not the pause after the last
    // came before it.
    _ = try say(mut app, chat.copy(), "m_l6", "/next /sleep 20000\nok, and one more thing. {TALK}")
    let slow = try app.until("event", "run.started", 30000)
    try check(bool_at(slow.copy(), "quiet") == some(true), "the agent looks back again after the next pause")
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_l7")).s("conversation", chat.copy()).s("text", String("straight away")).done())
    let answer = try reply_in(mut app, chat.copy(), 10000)
    try check(reply_text(answer) == "straight away", "a message then is answered at once")
    var stopped = false
    for fr in app.frames {
        if str_at(fr.copy(), "kind") == some(String("run.finished")) and str_at(fr.copy(), "run") == str_at(slow.copy(), "run") { stopped = str_at(fr, "status") == some(String("cancelled")) }
    }
    try check(stopped, "the turn it looked back in stopped for it")
}

// A mode that asks: a note, even one for every agent, is kept at once, and
// forgetting it takes it from every agent; a fix waits on a card under the reply.
fn card_part(app: mut Session, agent: String, chat: String) ! Error {
    try agent_cmd(mut app, "q_c0", agent.copy(), "ask")
    let made = try app.cmd("q_c1", "agent.create", Obj.new().s("name", String("Fern")).s("acp_agent", String("fake")).s("instructions", String("You are a test too.")).done())
    let fern = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let m = try say(mut app, chat.copy(), "m_c1", String(#"/mcp propose_note {"text":"Ann's team is Platform.","shared":true}"#))
    let items = learned(m.copy())
    try see(items.len() == 1 and str_at(items[0].copy(), "status") == some(String("kept")) and str_at(items[0].copy(), "by") == some(String("auto")) and bool_at(at(items[0].copy(), "note"), "shared") == some(true) and reply_text(m.copy()).starts_with("propose_note: Kept: it's a note every agent of your person's reads now"), "in ask, a note for every agent is kept at once too, under the reply", "{m}")
    let note_id = str_at(items[0].copy(), "id") ?? String()
    try check((try memories_of(mut app, "q_c2", fern.copy())).contains("Ann's team is Platform."), "and every agent has it")
    try check((try activity(mut app, "q_c3")).contains("\"proposal\":\"{note_id}\",\"undo\":true"), "which the activity log can undo too")
    let forgot = try app.cmd("q_c4", "proposal.undo", Obj.new().s("id", note_id).done())
    try see(str_at(at(at(forgot.copy(), "value"), "proposal"), "status") == some(String("undone")), "Forget under the reply forgets it", "{forgot}")
    try check(not (try memories_of(mut app, "q_c5", fern.copy())).contains("Platform") and not (try memories_of(mut app, "q_c5b", agent.copy())).contains("Platform"), "out of every agent's notes")
    _ = try app.cmd("q_c5c", "agent.delete", Obj.new().s("agent", fern).done())

    _ = try say(mut app, chat.copy(), "m_c2", String(#"/mcp skill_failed {"name":"post-release-notes","step":"Press Publish","why":"There's no Publish button any more."}"#))
    let asked = try say(mut app, chat.copy(), "m_c3", "/next /mcp fix_skill {Obj.new().s("name", String("post-release-notes")).s("body", String(FIXED)).done()}\nok")
    let card = try under(mut app, str_at(asked.copy(), "id") ?? String(), "post-release-notes")
    let list = learned(card.copy())
    let f = list[list.len() - 1].copy()
    try see(str_at(f.copy(), "status") == some(String("waiting")), "in ask, a fix waits on a card", "{f}")
    try check((try skill_body(mut app, "q_c6")) == SKILL, "and the skill stays as it was")
    let fix_id = str_at(f.copy(), "id") ?? String()
    let later = try app.cmd("q_c6b", "proposal.later", Obj.new().j("ids", Json.Array([Json.Str(fix_id.copy())])).done())
    try see("{later}".contains("\"later\":true"), "Not now puts it off", "{later}")
    _ = try under(mut app, str_at(asked, "id") ?? String(), "\"later\":true")
    let waiting = try app.cmd("q_c6c", "proposal.list", Obj.new().done())
    try check("{waiting}".contains(fix_id), "to wait on the Proposals page")
    let renamed = try rename_skill(mut app, "q_cr1", "post-release-notes", "post-notes", String(SKILL))
    try see(bool_at(renamed.copy(), "ok") == some(true), "the skill is renamed while its fix waits", "{renamed}")
    let changed = String("# Post release notes\n\n1. Open the drafts.\n2. Paste the notes.\n3. Press Release.\n4. Share the link.\n")
    let keep = try app.cmd("q_c7", "proposal.keep", Obj.new().s("id", str_at(f.copy(), "id") ?? String()).j("fix", Obj.new().s("body", changed.copy()).done()).done())
    try see(str_at(at(at(keep.copy(), "value"), "proposal"), "status") == some(String("kept")), "Change it keeps the fix as the person changed it", "{keep}")
    try check((try body_of(mut app, "q_c8", "post-notes")) == changed, "and the skill, by its new name, is that")
    // Its name back, the kept fix follows it again.
    _ = try rename_skill(mut app, "q_cr2", "post-notes", "post-release-notes", changed.copy())
    let kept_ones = try app.cmd("q_cr3", "proposal.list", Obj.new().s("status", String("kept")).done())
    var named = String()
    if let Json.Array(ps) = at(at(kept_ones, "value"), "proposals") {
        for p in ps {
            if str_at(p.copy(), "id") == str_at(f.copy(), "id") { named = str_at(at(p, "fix"), "name") ?? String() }
        }
    }
    try check(named == "post-release-notes", "a kept fix names its skill by the name it has now")
    _ = try app.cmd("q_c9", "skill.put", Obj.new().s("name", String("post-release-notes")).s("description", String("Posting the release notes.")).s("body", String("Something else.")).done())
    let late = try app.cmd("q_c10", "proposal.undo", Obj.new().s("id", str_at(f, "id") ?? String()).done())
    try check(str_at(at(late, "error"), "code") == some(String("changed")), "a fix isn't undone once the skill has changed since")
}

// A group chat: each member that answered looks back over its own part once it
// pauses, one after the other, and what each keeps goes under its own reply.
fn room_part(app: mut Session, juniper: String) ! Error {
    try agent_cmd(mut app, "q_g0", juniper.copy(), "allow")
    let made = try app.cmd("q_g1", "agent.create", Obj.new().s("name", String("Moss")).s("acp_agent", String("fake")).s("instructions", String("You are a test too.")).done())
    let moss = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    try agent_cmd(mut app, "q_g2", moss.copy(), "allow")
    let room = try app.cmd("q_g3", "room.create", Obj.new().s("name", String("Pair")).j("members", Json.Array([Json.Str(juniper.copy()), Json.Str(moss.copy())])).done())
    let pair = str_at(at(at(room, "value"), "conversation"), "id") ?? String()
    let first = try say(mut app, pair.copy(), "m_g1", "[@Juniper](loom:agent/{juniper})\n/next /mcp propose_note \{\"text\":\"Ann plays chess.\"\}\nok\n{TALK}")
    let second = try say(mut app, pair.copy(), "m_g2", "[@Moss](loom:agent/{moss})\n/next /mcp propose_note \{\"text\":\"Ann runs on Sundays.\"\}\nok\n{TALK}")
    try check(str_at(first.copy(), "agent") == some(juniper.copy()) and str_at(second.copy(), "agent") == some(moss.copy()), "two members answer in a group chat")
    var quiet = List<Json>()
    var overlapped = false
    var running = String()
    var looked: usize = 0
    while quiet.len() < 2 or running.len() > 0 {
        while looked < app.frames.len() {
            let f = app.frames[looked].copy()
            looked += 1
            let kind = str_at(f.copy(), "kind") ?? String()
            if kind == "run.started" and bool_at(f.copy(), "quiet") == some(true) and str_at(f.copy(), "conversation") == some(pair.copy()) {
                if running.len() > 0 { overlapped = true }
                running = str_at(f.copy(), "run") ?? String()
                quiet.push(f)
            } else if kind == "run.finished" and running.len() > 0 and str_at(f.copy(), "run") == some(running.copy()) {
                running = String()
            }
        }
        if quiet.len() < 2 or running.len() > 0 { _ = try app.until("event", "", 30000) }
    }
    try see(str_at(quiet[0].copy(), "agent") == some(juniper.copy()) and str_at(quiet[1].copy(), "agent") == some(moss.copy()) and not overlapped, "once it pauses, each member looks back over its part, one after the other", "{quiet}")
    let j = try under(mut app, str_at(first, "id") ?? String(), "Ann plays chess.")
    let m = try under(mut app, str_at(second, "id") ?? String(), "Ann runs on Sundays.")
    let j_items = learned(j)
    let m_items = learned(m)
    try see(j_items.len() == 1 and str_at(j_items[0].copy(), "agent") == some(juniper.copy()) and m_items.len() == 1 and str_at(m_items[0].copy(), "agent") == some(moss.copy()), "and what each keeps goes under its own reply, as its own note", "{j_items} {m_items}")
    _ = try app.cmd("q_g4", "agent.delete", Obj.new().s("agent", moss).done())
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_a", "agent.create", Obj.new().s("name", String("Juniper")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_c", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()
    try kept_part(mut app, agent.copy(), chat.copy())
    try look_back_part(mut app, chat.copy())
    try card_part(mut app, agent.copy(), chat)
    try room_part(mut app, agent.copy())
    _ = try app.cmd("q_d", "agent.delete", Obj.new().s("agent", agent).done())
    app.close()
}

// Before a restart: a note waiting under a reply, as an older instance left one
// from before every note was kept at once. Gives the event to go on from and the reply.
fn waiting_before(i: Instance) -> (i64, String) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)
    let made = try app.cmd("q_w1", "agent.create", Obj.new().s("name", String("Rowan")).s("acp_agent", String("fake")).s("instructions", String("You are a test.")).done())
    let agent = str_at(at(at(made, "value"), "agent"), "id") ?? String()
    let c = try app.cmd("q_w2", "conversation.create", Obj.new().s("agent", agent.copy()).done())
    let chat = str_at(at(c, "value"), "conversation") ?? String()
    let m = try say(mut app, chat, "m_w1", String("hello"))
    let reply = str_at(m, "id") ?? String()
    let seq = app.seq
    app.close()
    let db = try Database.open("{i.data}/loom.db")
    let user = try db.query_one(String("SELECT id FROM users LIMIT 1"), List<Value>()) else fail "there's no user"
    let note = Obj.new().s("text", String("Ann likes figs.")).s("site", String()).b("shared", false).done()
    _ = try db.execute(String("INSERT INTO proposals (id, user, agent, kind, data, why, recording, status, at, message) VALUES ('prop_old', ?, ?, 'note', ?, '', '', 'waiting', 1, ?)"), [user[0].copy(), Value.Text(agent), Value.Text("{note}"), Value.Text(reply.copy())])
    return (seq, reply)
}

// After it: the note is kept, as Keep on its card kept it, and its reply says so.
fn waiting_after(i: Instance, seq: i64, reply: String) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), seq)
    let kept = try under(mut app, reply, "Ann likes figs.")
    let items = learned(kept.copy())
    try see(items.len() == 1 and str_at(items[0].copy(), "status") == some(String("kept")), "a note left waiting is kept when the instance starts, and its reply says so", "{kept}")
    try check((try memories(mut app, "q_w3")).contains("Ann likes figs."), "as a note")
    let waiting = try app.cmd("q_w4", "proposal.list", Obj.new().done())
    try see(not "{waiting}".contains("Ann likes figs."), "and it waits no more", "{waiting}")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start_with([String("--test-minute-ms"), String(MINUTE_MS)])
    var failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    var left: (i64, String) = (0, String())
    if failure == none {
        match waiting_before(inst.copy()) {
            ok(l) => left = l,
            err(e) => failure = some("{e}"),
        }
    }
    if failure != none {
        inst.stop()
    } else {
        let (seq, reply) = left
        let back = try inst.restart_with([String("--test-minute-ms"), String(MINUTE_MS)], 0)
        match waiting_after(back.copy(), seq, reply) {
            ok => {},
            err(e) => failure = some("{e}"),
        }
        back.stop()
    }
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\nlearn: all good")
}
