module tests.protocol.defaults

// Agent defaults (PLAN.md, "Agent defaults"): what every agent of the
// person's follows, live, unless it sets its own. A new agent runs on the
// default brain; an agent's sessions start on the default model and effort
// for its program, unless it picked its own, and null goes back to the
// default; an agent with no permission mode of its own works in the
// default's; every agent is told the instructions for every agent; and a
// message to a busy agent queues, or steers where the default says so. An
// agent reads the defaults at once, but changing them asks the person.
//
//     calx tests/protocol/defaults.calx
import std.json.{Json}
import std.process.{exit}
import shared.obj.{Obj, at, bool_at, str_at}
import shared.client.{Session, reply_text}
import tests.kit.{Instance, check}

// The agent's next reply in `conversation`, as text.
fn reply_in(app: mut Session, conversation: String) -> String ! Error {
    loop {
        let created = try app.until("event", "message.created")
        let m = at(created, "message")
        if str_at(m.copy(), "role") == some(String("agent")) and str_at(m.copy(), "conversation") == some(conversation.copy()) { return reply_text(m) }
    }
}

fn say(app: mut Session, conversation: String, cid: str, text: String) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", text).done())
    return try reply_in(mut app, conversation)
}

// The send's ack.
fn send(app: mut Session, conversation: String, cid: str, text: str) -> Json ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation).s("text", String(text)).done())
    loop {
        let ack = try app.until("ack", "")
        if str_at(ack.copy(), "cid") == some(String(cid)) { return ack }
    }
}

// The newest event of `kind` among what the app has read.
fn last(app: Session, kind: str) -> Json {
    var found = Json.Null
    for f in app.frames {
        if str_at(f.copy(), "kind") == some(String(kind)) { found = f.copy() }
    }
    return found
}

fn put(app: mut Session, id: str, args: Json) -> Json ! Error {
    return try app.cmd(id, "defaults.put", args)
}

fn update(app: mut Session, id: str, args: Json) -> Json ! Error {
    return try app.cmd(id, "agent.update", args)
}

fn chat(app: mut Session, id: str, agent: String) -> String ! Error {
    let c = try app.cmd(id, "conversation.create", Obj.new().s("agent", agent).done())
    return str_at(at(c, "value"), "conversation") ?? String()
}

// `/mcp run_command` with `name` and `args`, as the agent's message.
fn run_command(name: str, args: Json) -> String {
    return "/mcp run_command {Obj.new().s("name", String(name)).j("args", args).done()}"
}

// How the next approval for `conversation`'s tool went: "auto" when the
// permission mode answered it, "asked" when it came to the person, who says yes.
fn ask_goes(app: mut Session, conversation: String, cid: str) -> String ! Error {
    try app.send(Obj.new().s("t", String("send")).s("cid", String(cid)).s("conversation", conversation.copy()).s("text", String("/ask Run it")).done())
    loop {
        let f = try app.until("event", "")
        let kind = str_at(f.copy(), "kind") ?? String()
        if kind == "approval.answered" and str_at(f.copy(), "by") == some(String("auto")) {
            _ = try reply_in(mut app, conversation)
            return String("auto")
        }
        if kind == "approval.needed" {
            try app.send(Obj.new().s("t", String("approve")).s("call", str_at(f, "call") ?? String()).b("allow", true).done())
            _ = try reply_in(mut app, conversation)
            return String("asked")
        }
    }
}

fn run(i: Instance) ! Error {
    var app = try Session.connect(i.base.copy(), i.token.copy(), 0)

    // --- Before any are put ---
    let blank = at(at(try app.cmd("q_1", "defaults.get", Obj.new().done()), "value"), "defaults")
    try check(str_at(blank.copy(), "permission") == some(String("ask")) and str_at(blank.copy(), "busy") == some(String("queue")) and str_at(blank, "brain") == some(String()), "the defaults start asking and queueing, with no brain")
    let nameless = try app.cmd("q_2", "agent.create", Obj.new().s("name", String("Nowhere")).s("instructions", String("Hi.")).done())
    try check(str_at(at(nameless, "error"), "code") == some(String("bad_request")), "an agent with no program and no default brain is refused")

    // --- Putting them ---
    let wrong_mode = try put(mut app, "q_3", Obj.new().s("permission", String("sometimes")).done())
    try check(str_at(at(wrong_mode, "error"), "code") == some(String("bad_request")), "a permission mode that isn't one is refused")
    let wrong_brain = try put(mut app, "q_4", Obj.new().s("brain", String("nope")).done())
    try check(str_at(at(wrong_brain, "error"), "code") == some(String("not_found")), "and a brain that isn't installed")
    let fake_config = Obj.new().j("fake", Obj.new().s("model", String("fake-2")).s("effort", String("high")).done()).done()
    let put_now = try put(mut app, "q_5", Obj.new().s("brain", String("fake")).j("config", fake_config).s("instructions", String("Sign every answer with a fern.")).done())
    let kept = at(at(put_now, "value"), "defaults")
    let heard = last(app, "defaults.updated")
    try check(str_at(kept.copy(), "brain") == some(String("fake")) and str_at(at(heard.copy(), "defaults"), "instructions") == some(String("Sign every answer with a fern.")) and (str_at(heard, "by") ?? String()).starts_with("d_"), "the person puts defaults, and every device hears them")

    // --- A new agent follows them ---
    let made = try app.cmd("q_6", "agent.create", Obj.new().s("name", String("Main")).s("instructions", String("You are a test.")).done())
    let main_agent = at(at(made, "value"), "agent")
    let main_id = str_at(main_agent.copy(), "id") ?? String()
    try check(str_at(main_agent.copy(), "acp_agent") == some(String("fake")) and str_at(main_agent, "permission") == none, "a new agent runs on the default brain, with no permission mode of its own")
    let first = try chat(mut app, "q_7", main_id.copy())
    let told = try say(mut app, first.copy(), "m_1", String("/context"))
    try check(told.contains("Instructions your person gives every agent") and told.contains("Sign every answer with a fern."), "it's told the instructions for every agent")
    try check(try say(mut app, first.copy(), "m_2", String("/config")) == "model=fake-2 effort=high", "and its session starts on the default model and effort for its program")
    let again = try say(mut app, first.copy(), "m_3", String("/context"))
    try check(not again.contains("fern"), "once a session")
    _ = try put(mut app, "q_8", Obj.new().s("instructions", String("Sign with an oak.")).done())
    let changed = try say(mut app, first.copy(), "m_4", String("/context"))
    try check(changed.contains("Sign with an oak."), "and again when they change")

    // --- Its own over them, and back ---
    _ = try update(mut app, "q_9", Obj.new().s("agent", main_id.copy()).j("config", Obj.new().s("model", String("fake-1")).done()).done())
    try check(try say(mut app, first.copy(), "m_5", String("/config")) == "model=fake-1 effort=high", "a model of its own wins over the default, the effort still the default's")
    let followed = try update(mut app, "q_10", Obj.new().s("agent", main_id.copy()).j("config", Obj.new().j("model", Json.Null).done()).done())
    try check("{at(at(at(followed, "value"), "agent"), "config")}" == "\{\}", "null takes it back to following the default")
    try check(try say(mut app, first.copy(), "m_6", String("/config")) == "model=fake-2 effort=high", "which the next prompt is set to")
    _ = try put(mut app, "q_11", Obj.new().j("config", Obj.new().j("fake", Obj.new().s("model", String("fake-9")).done()).done()).done())
    let second = try chat(mut app, "q_12", main_id.copy())
    try check(try say(mut app, second, "m_7", String("/config")) == "model=fake-1 effort=high", "a default its program doesn't offer leaves the session on what the program starts on")

    // --- Permission ---
    let helper_made = try app.cmd("q_13", "agent.create", Obj.new().s("name", String("Careful")).s("instructions", String("Hi.")).s("permission", String("ask")).done())
    let helper = str_at(at(at(helper_made, "value"), "agent"), "id") ?? String()
    let helper_chat = try chat(mut app, "q_14", helper.copy())
    try check(try ask_goes(mut app, first.copy(), "m_8") == "asked", "an agent following the default ask asks")
    _ = try put(mut app, "q_15", Obj.new().s("permission", String("allow")).done())
    try check(try ask_goes(mut app, first.copy(), "m_9") == "auto", "and once the default allows, it doesn't")
    try check(try ask_goes(mut app, helper_chat.copy(), "m_10") == "asked", "while one with its own mode keeps it")
    let back = try update(mut app, "q_16", Obj.new().s("agent", helper.copy()).j("permission", Json.Null).done())
    try check(str_at(at(at(back, "value"), "agent"), "permission") == none, "null sets an agent back to following the default mode")
    try check(try ask_goes(mut app, helper_chat.copy(), "m_11") == "auto", "which it then works in")
    _ = try put(mut app, "q_17", Obj.new().s("permission", String("ask")).done())

    // --- Agents and the defaults ---
    let read = try say(mut app, first.copy(), "m_12", run_command("defaults.get", Obj.new().done()))
    try check(read.starts_with("run_command:") and read.contains("Sign with an oak."), "an agent reads the defaults at once")
    let looser = try say(mut app, first.copy(), "m_13", run_command("defaults.put", Obj.new().s("permission", String("auto")).done()))
    try check(looser.starts_with("run_command failed") and looser.contains("no more than you have yourself"), "but can't propose a looser default mode than its own")
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_14")).s("conversation", first.copy()).s("text", run_command("defaults.put", Obj.new().s("instructions", String("Never sign.")).done())).done())
    let asked = try app.until("event", "approval.needed")
    try check(str_at(asked.copy(), "title") == some(String("Changes the agent defaults, for every agent that follows them")), "changing them asks the person")
    try app.send(Obj.new().s("t", String("approve")).s("call", str_at(asked, "call") ?? String()).b("allow", false).done())
    _ = try reply_in(mut app, first.copy())
    let still = at(at(try app.cmd("q_18", "defaults.get", Obj.new().done()), "value"), "defaults")
    try check(str_at(still, "instructions") == some(String("Sign with an oak.")), "and a no leaves them as they were")
    try app.send(Obj.new().s("t", String("send")).s("cid", String("m_15")).s("conversation", first.copy()).s("text", run_command("agent.update", Obj.new().s("agent", helper.copy()).j("permission", Json.Null).done())).done())
    let follow = try app.until("event", "approval.needed")
    try check(str_at(at(follow.copy(), "detail"), "agent") == some(helper.copy()), "an agent setting another back to the default mode asks too")
    try app.send(Obj.new().s("t", String("approve")).s("call", str_at(follow, "call") ?? String()).b("allow", false).done())
    _ = try reply_in(mut app, first.copy())

    // --- Busy ---
    _ = try put(mut app, "q_19", Obj.new().s("busy", String("steer")).done())
    _ = try send(mut app, first.copy(), "m_16", "/sleep 20000\nnever")
    let steered = try send(mut app, first.copy(), "m_17", "/context")
    try check(bool_at(steered.copy(), "queued") == some(true) and bool_at(steered, "steered") == some(true), "with the default steer, a message to a busy agent steers")
    let stopped = try app.until("event", "run.finished")
    try check(str_at(stopped, "status") == some(String("cancelled")), "the running turn stops for it")
    let went = try reply_in(mut app, first.copy())
    try check(went.contains("Your person stopped you to say this"), "and it goes at once")
    _ = try update(mut app, "q_20", Obj.new().s("agent", main_id.copy()).s("busy", String("queue")).done())
    let long = try send(mut app, first.copy(), "m_18", "/sleep 1500\nlong, done")
    let waits = try send(mut app, first.copy(), "m_19", "after")
    try check(str_at(long, "run") != none and bool_at(waits.copy(), "queued") == some(true) and bool_at(waits, "steered") == none, "an agent's own busy queue wins over the default")
    try check(try reply_in(mut app, first.copy()) == "long, done", "so the turn finishes")
    try check(try reply_in(mut app, first.copy()) == "after", "and then what waited goes")
    app.close()
}

fn main() ! Error {
    let inst = try Instance.start()
    let failure: String? = match run(inst.copy()) {
        ok => none,
        err(e) => some("{e}"),
    }
    inst.stop()
    if let f = failure {
        eprintln("\n{f}")
        exit(1)
    }
    println("\ndefaults: all good")
}
