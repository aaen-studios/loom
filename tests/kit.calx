module tests.kit

// What the protocol tests share: starting an instance with the fake agent,
// HTTP calls, and an app's WebSocket session.
import std.env
import std.fs
import std.http.{Header, get, post}
import std.http.websocket.{Message, WebSocket, connect}
import std.json.{Json, parse}
import std.process.{Child, Command, Stdio}
import shared.obj.{Obj, at, int_at, str_at}

const WAIT: u64 = 120000    // the first start builds the server and the agent

pub fn calx() -> String {
    return env.variable(String("CALX")) ?? String("calx")
}

pub fn loom(data: String, args: List<String>) -> Command {
    return Command.new(calx()).arg(String("server/main.calx")).args(args).arg(String("--data")).arg(data).arg(String("--test-fast-hashes"))
}

pub fn check(passed: bool, what: str) ! Error {
    if not passed { fail "failed: {what}" }
    println("ok    {what}")
}

/// A running instance with the fake agent added as `fake`, and its owner set up.
pub struct Instance {
    pub server: Child
    pub data: String
    pub base: String    // host:port
    pub token: String
}

impl Instance {
    pub fn start() -> Instance ! Error {
        let data = try fs.temp_dir()
        let agent = try fs.absolute(String("tests/fake_agent/main.calx"))
        let added = try loom(data.copy(), [String("acp"), String("add"), String("fake"), calx(), agent]).output()
        if not added.status.success() { fail "loom acp add failed: {added.error_text()}" }
        let server = try loom(data.copy(), [String("serve"), String("--port"), String("0")]).stdout(Stdio.Pipe).spawn()
        let serving = server.wait_for_line(String("loom: serving"), WAIT) else {
            server.kill()
            fail "the server didn't start"
        }
        let address = serving[serving.find("http://") ?? 0..].trim().copy()
        let base = if address.ends_with("/") { address[7..address.len() - 1].copy() } else { address[7..].copy() }
        let code_line = server.wait_for_line(String("setup code:"), 10000) else {
            server.kill()
            fail "the server didn't print a setup code"
        }
        let code = code_line[12..].trim().copy()
        let (status, owner) = try post_json(base.copy(), "/api/setup", Obj.new().s("code", code).s("username", String("elliot")).s("password", String("correct horse")).j("device", device("Desk PC")).done())
        if status != 200 {
            server.kill()
            fail "setup failed: {owner}"
        }
        return Instance { server: server, data: data, base: base, token: str_at(owner, "token") ?? String() }
    }

    /// Adds an account from the command line, logs it in, and gives its token.
    pub fn second_account(self, name: str) -> String ! Error {
        let added = try loom(self.data.copy(), [String("user"), String("add"), String(name)]).input_text(String("their password\n")).output()
        if not added.status.success() { fail "user add failed: {added.error_text()}" }
        let (_, body) = try post_json(self.base.copy(), "/api/login", Obj.new().s("username", String(name)).s("password", String("their password")).j("device", device("Laptop")).done())
        return str_at(body, "token") ?? String()
    }

    pub fn stop(own self) {
        var s = self.server
        s.kill()
        _ = s.wait()
    }
}

pub fn device(name: str) -> Json {
    return Obj.new().s("name", String(name)).s("kind", String("cli")).s("tz", String("Europe/Oslo")).done()
}

pub fn post_json(base: String, path: str, body: Json) -> (u32, Json) ! Error {
    let headers: List<Header> = [Header { name: String("Content-Type"), value: String("application/json") }]
    var req = post("http://{base}{path}", headers, "{body}".to_bytes(), 30000, 1048576)
    let r = try req.wait()
    return (r.status, json_of(r.body))
}

pub fn json_of(body: List<u8>) -> Json {
    return match parse(String.from_utf8(body.copy()) ?? String()) {
        ok(v) => v,
        err(_) => Json.Null,
    }
}

fn auth(token: String) -> List<Header> {
    if token.len() == 0 { return List<Header>() }
    return [Header { name: String("Authorization"), value: "Bearer {token}" }]
}

/// POSTs `body` to /files with `token`. The status, and the answer as JSON.
pub fn upload(base: String, token: String, name: str, mime: str, body: List<u8>) -> (u32, Json) ! Error {
    var headers = auth(token)
    headers.push(Header { name: String("Content-Type"), value: String(mime) })
    var req = post("http://{base}/files?name={name}", headers, body, 30000, 1048576)
    let r = try req.wait()
    return (r.status, json_of(r.body))
}

/// GETs `path` with `token`: the status, the Content-Type, and the body.
pub fn fetch(base: String, token: String, path: String) -> (u32, String, List<u8>) ! Error {
    var req = get("http://{base}{path}", auth(token), 30000, 104857600)
    let r = try req.wait()
    return (r.status, r.header(String("Content-Type")) ?? String(), r.body)
}

/// A connected app: its socket, and the newest seq it has applied.
pub struct App {
    ws: WebSocket
    pub seq: i64
    pub frames: List<Json>
}

impl App {
    /// Opens /ws and says hello with `after`. Gives the app once it's synced.
    pub fn connect(base: String, token: String, after: i64) -> App ! Error {
        let ws = try connect("ws://{base}/ws")
        var app = App { ws: ws, seq: after, frames: List<Json>() }
        try app.send(Obj.new().s("t", String("hello")).s("token", token).j("versions", Json.Array([Json.Int(1)])).i("after", after).done())
        _ = try app.until("synced", "")
        return app
    }

    pub fn send(self, frame: Json) ! Error {
        try self.ws.send_text("{frame}")
    }

    /// Reads frames until one whose `t` is `t` (and, for events, whose kind is `kind`),
    /// and gives it. Every frame read is kept in `frames`.
    pub fn until(a: mut App, t: str, kind: str) -> Json ! Error {
        loop {
            let m = try a.ws.receive(30000) else {
                fail "no {t} {kind} came in 30 s"
            }
            let text = match m {
                Message.Text(s) => s,
                Message.Binary(_) => fail "a binary frame came",
            }
            let f = try parse(text)
            if let seq = int_at(f.copy(), "seq") {
                if (str_at(f.copy(), "t") ?? String()) == "event" {
                    if seq != a.seq + 1 { fail "event {seq} came after {a.seq}" }
                    a.seq = seq
                }
            }
            a.frames.push(f.copy())
            if (str_at(f.copy(), "t") ?? String()) == t and (kind.len() == 0 or (str_at(f.copy(), "kind") ?? String()) == kind) {
                return f
            }
        }
    }

    pub fn cmd(a: mut App, id: str, name: str, args: Json) -> Json ! Error {
        try a.send(Obj.new().s("t", String("cmd")).s("id", String(id)).s("name", String(name)).j("args", args).done())
        loop {
            let r = try a.until("result", "")
            if (str_at(r.copy(), "id") ?? String()) == id { return r }
        }
    }

    /// The agent's next finished message.
    pub fn reply(a: mut App) -> Json ! Error {
        loop {
            let created = try a.until("event", "message.created")
            let m = at(created, "message")
            if str_at(m.copy(), "role") == some(String("agent")) { return m }
        }
    }

    pub fn close(own self) {
        self.ws.close()
    }
}

/// The text of a message's text blocks, joined.
pub fn reply_text(message: Json) -> String {
    var out = String()
    if let Json.Array(blocks) = at(message, "blocks") {
        for b in blocks {
            if (str_at(b.copy(), "kind") ?? String()) == "text" {
                out.push_str(str_at(b, "text") ?? String())
            }
        }
    }
    return out
}
