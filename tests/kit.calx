module tests.kit

// What the protocol tests share: starting an instance with the fake agent,
// and files over HTTP. Logging in and an app's WebSocket session are
// shared/client.calx's, as the command line has them.
import std.env
import std.fs
import std.http.{Header, get, post}
import std.json.{Json}
import std.process.{Child, Command, Stdio}
import std.thread.{sleep}
import shared.client
import shared.client.{json_of, post_json}
import shared.obj.{Obj, str_at}

const WAIT: u64 = 120000    // the first start builds the server and the agent
const STOP_MS: u64 = 30000    // how long an instance asked to stop may take to

pub fn calx() -> String {
    return env.variable(String("CALX")) ?? String("calx")
}

pub fn loom(data: String, args: List<String>) -> Command {
    return Command.new(calx()).arg(String("server/main.calx")).args(args).arg(String("--data")).arg(data).arg(String("--test-fast-hashes"))
}

pub fn check(passed: bool, what: str) ! Error {
    if not passed { fail "failed: {what}" }
    println("ok    {what}")
}

/// A running instance with the fake agent added as `fake`, and its owner set up.
pub struct Instance {
    pub server: Child
    pub data: String
    pub base: String    // host:port
    pub token: String
}

impl Instance {
    pub fn start() -> Instance ! Error {
        return try Instance.start_with(List<String>())
    }

    /// The same, with `extra` options for `loom serve`.
    pub fn start_with(extra: List<String>) -> Instance ! Error {
        let data = try fs.temp_dir()
        let agent = try fs.absolute(String("tests/fake_agent/main.calx"))
        let added = try loom(data.copy(), [String("acp"), String("add"), String("fake"), calx(), agent]).output()
        if not added.status.success() { fail "loom acp add failed: {added.error_text()}" }
        var args: List<String> = [String("serve"), String("--port"), String("0"), String("--allow-root")]
        args.extend(extra)
        let cmd = loom(data.copy(), args)
        return try Instance.launch(data, cmd)
    }

    /// An instance `cmd` serves on `data`, a `loom serve` the test put together, with its
    /// owner set up.
    pub fn launch(data: own String, cmd: own Command) -> Instance ! Error {
        let server = try cmd.own_group().stdout(Stdio.Pipe).spawn()
        let serving = server.wait_for_line(String("loom: serving"), WAIT) else {
            server.kill_tree()
            fail "the server didn't start"
        }
        let address = serving[serving.find("http://") ?? 0..].trim().copy()
        let base = if address.ends_with("/") { address[7..address.len() - 1].copy() } else { address[7..].copy() }
        let code_line = server.wait_for_line(String("setup code:"), 10000) else {
            server.kill_tree()
            fail "the server didn't print a setup code"
        }
        let code = code_line[12..].trim().copy()
        let (status, owner) = try post_json(base.copy(), "/api/setup", Obj.new().s("code", code).s("username", String("elliot")).s("password", String("correct horse")).j("device", device("Desk PC")).done())
        if status != 200 {
            server.kill_tree()
            fail "setup failed: {owner}"
        }
        return Instance { server: server, data: data, base: base, token: str_at(owner, "token") ?? String() }
    }

    /// Adds an account from the command line, logs it in, and gives its token.
    pub fn second_account(self, name: str) -> String ! Error {
        let added = try loom(self.data.copy(), [String("user"), String("add"), String(name)]).input_text(String("their password\n")).output()
        if not added.status.success() { fail "user add failed: {added.error_text()}" }
        let (_, body) = try post_json(self.base.copy(), "/api/login", Obj.new().s("username", String(name)).s("password", String("their password")).j("device", device("Laptop")).done())
        return str_at(body, "token") ?? String()
    }

    /// Adds the fake agent again as `name`, started with `arg`, such as --load.
    pub fn add_fake(self, name: String, arg: String) ! Error {
        let agent = try fs.absolute(String("tests/fake_agent/main.calx"))
        let added = try loom(self.data.copy(), [String("acp"), String("add"), name.copy(), calx(), agent, arg.copy()]).output()
        if not added.status.success() { fail "loom acp add failed: {added.error_text()}" }
    }

    /// Kills the instance, as a crash would, and starts it again on the same data.
    /// The token still works; the address is a new one.
    pub fn restart(own self) -> Instance ! Error {
        return try self.restart_with(List<String>(), 0)
    }

    /// The same, with `extra` options for `loom serve`, after `off_ms` stopped.
    pub fn restart_with(own self, extra: List<String>, off_ms: i64) -> Instance ! Error {
        // With all it started, its agents among it, which a killed instance leaves.
        var old = self.server
        old.kill_tree()
        _ = old.wait()
        if off_ms > 0 { unsafe { sleep(u64.wrap(off_ms) * 1000000) } }
        var args: List<String> = [String("serve"), String("--port"), String("0"), String("--allow-root")]
        args.extend(extra)
        let server = try loom(self.data.copy(), args).own_group().stdout(Stdio.Pipe).spawn()
        let serving = server.wait_for_line(String("loom: serving"), WAIT) else {
            server.kill_tree()
            fail "the server didn't start again"
        }
        let address = serving[serving.find("http://") ?? 0..].trim().copy()
        let base = if address.ends_with("/") { address[7..address.len() - 1].copy() } else { address[7..].copy() }
        return Instance { server: server, data: self.data, base: base, token: self.token }
    }

    /// Stops the instance, and removes the folder the kit made for its data, with
    /// everything in it. A folder anywhere else is left as it is.
    pub fn stop(own self) {
        _ = end(self.server)
        remove_scratch(self.data)
    }
}

/// Asks `server`, an instance started in a group of its own, to stop, as a
/// service is, so it closes its browsers and agents first, and waits for it. One
/// that hasn't ended after `STOP_MS` is killed, with all it started. Whether it
/// ended when asked.
pub fn end(server: Child) -> bool {
    server.stop()
    if server.wait_timeout(STOP_MS) != none { return true }
    server.kill_tree()
    _ = server.wait_timeout(10000)
    return false
}

/// Removes the folder of the system's temporary folder that `data` is in, when it's one
/// `fs.temp_dir` made (a `calx-` folder there), as a test's instance folders are. Anything
/// else, and a folder something still holds open, is left as it is.
pub fn remove_scratch(data: String) {
    let probe = match fs.temp_dir() {
        ok(p) => p,
        err(_) => return,
    }
    let probe_name = probe.replace("\\", "/")
    let cut = probe_name.find_last("/") ?? 0
    let root = probe_name[..cut].copy()
    match fs.remove_dir(probe) {
        ok => {},
        err(_) => {},
    }
    let path = data.replace("\\", "/")
    if cut == 0 or not path.starts_with("{root}/calx-") { return }
    let rest = path[root.len() + 1..].copy()
    let name = rest[..(rest.find("/") ?? rest.len())].copy()
    if name.len() <= 5 { return }
    match fs.remove_dir_all("{root}/{name}") {
        ok => {},
        err(_) => {},
    }
}

/// `data` with every `from` in it written over with `to`, which is as long, as the
/// update tests make a newer loom from the one they built.
pub fn patched(data: List<u8>, from: String, to: String) -> List<u8> ! Error {
    let a = from.to_bytes()
    let b = to.to_bytes()
    if a.len() != b.len() or a.len() == 0 { fail "a version is patched with one as long" }
    var out = data.copy()
    var found: usize = 0
    var k: usize = 0
    while k + a.len() <= out.len() {
        var same = true
        for j in 0usize..a.len() {
            if out[k + j] != a[j] {
                same = false
                break
            }
        }
        if same {
            for j in 0usize..b.len() {
                out[k + j] = b[j]
            }
            found += 1
            k += a.len()
        } else {
            k += 1
        }
    }
    if found == 0 { fail "the program doesn't hold {from}" }
    return out
}

/// Writes `data`, a program, to `path`, ready to run. On macOS it's signed again ad
/// hoc, since a patched program's signature no longer matches and the system kills it.
pub fn write_program(path: String, data: List<u8>) ! Error {
    try fs.write(path.copy(), data)
    if env.os() == "windows" { return }
    try fs.set_mode(path.copy(), 0o755)
    if env.os() != "macos" { return }
    let signed = try Command.new(String("codesign")).args([String("--force"), String("--sign"), String("-"), path.copy()]).output()
    if not signed.status.success() { fail "codesign {path}: {signed.error_text()}" }
}

/// A device a test signs in, as the command line's would be.
pub fn device(name: str) -> Json {
    return client.device(name, "cli", "Europe/Oslo")
}

fn auth(token: String) -> List<Header> {
    if token.len() == 0 { return List<Header>() }
    return [Header { name: String("Authorization"), value: "Bearer {token}" }]
}

/// POSTs `body` to /files with `token`. The status, and the answer as JSON.
pub fn upload(base: String, token: String, name: str, mime: str, body: List<u8>) -> (u32, Json) ! Error {
    var headers = auth(token)
    headers.push(Header { name: String("Content-Type"), value: String(mime) })
    var req = post("http://{base}/files?name={name}", headers, body, 30000, 1048576)
    let r = try req.wait()
    return (r.status, json_of(r.body))
}

/// GETs `path` with `token`: the status, the Content-Type, and the body.
pub fn fetch(base: String, token: String, path: String) -> (u32, String, List<u8>) ! Error {
    var req = get("http://{base}{path}", auth(token), 30000, 104857600)
    let r = try req.wait()
    return (r.status, r.header(String("Content-Type")) ?? String(), r.body)
}
