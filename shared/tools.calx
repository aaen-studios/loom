module shared.tools

// Loom's own tools, as `loom mcp` offers them to every agent (PLAN.md, "Loom's
// own tools"). The instance does what each one says, with its person's rights
// and no more: an agent can't change a permission mode, and nothing here
// deletes. Each is an MCP tool definition, with its arguments as JSON Schema.
import std.json.{Json}
import shared.obj.{Obj}

fn text_arg(description: str) -> Json {
    return Obj.new().s("type", String("string")).s("description", String(description)).done()
}

fn object(properties: own Obj, required: List<str>) -> Json {
    var names = List<Json>()
    for r in required {
        names.push(Json.Str(String(r)))
    }
    return Obj.new().s("type", String("object")).j("properties", properties.done()).j("required", Json.Array(names)).done()
}

fn tool(name: str, description: str, input: Json) -> Json {
    return Obj.new().s("name", String(name)).s("description", String(description)).j("inputSchema", input).done()
}

// Every tool, for tools/list.
pub fn all() -> List<Json> {
    return [
        tool("message_agent", "Sends a message to another of your person's agents and waits for its reply, which comes back as the result. The two of you keep one conversation, so it remembers what you said before. Use it to hand work to an agent that's better at it.", object(Obj.new().j("agent", text_arg("The agent's name or id, as list_agents gives them.")).j("text", text_arg("What to say.")), ["agent", "text"])),
        tool("list_agents", "Lists your person's agents: each one's id, name, the ACP agent it runs on, and its instructions.", object(Obj.new(), List<str>())),
        tool("create_agent", "Makes a new agent for your person. It asks before every command and edit until your person changes that in the app.", object(Obj.new().j("name", text_arg("Its name.")).j("acp_agent", text_arg("The ACP agent it runs on, one of list_acp_agents.")).j("instructions", text_arg("Its instructions, in Markdown, as an AGENTS.md has them.")), ["name", "acp_agent", "instructions"])),
        tool("update_agent", "Changes another agent's name or instructions. Each change is kept as a revision your person can roll back.", object(Obj.new().j("agent", text_arg("The agent's name or id.")).j("name", text_arg("Its new name.")).j("instructions", text_arg("Its new instructions, whole.")), ["agent"])),
        tool("edit_instructions", "Replaces your own instructions, which you start every session with. Give them whole, not just the change. Your person sees it as a revision by you, and can roll it back.", object(Obj.new().j("instructions", text_arg("Your new instructions, in Markdown.")), ["instructions"])),
        tool("list_acp_agents", "Lists the ACP agent programs installed on the instance, which agents run on.", object(Obj.new(), List<str>())),
        tool("search_messages", "Searches every conversation your person has, for words in messages and in file names. Gives the newest matches first.", object(Obj.new().j("query", text_arg("The words to find.")).j("agent", text_arg("Only this agent's conversations, by name or id.")), ["query"])),
        tool("list_skills", "Lists your person's skills: named instructions for a kind of task, each with when it's for. Look here before a task you haven't done before, and read the one that fits with read_skill.", object(Obj.new(), List<str>())),
        tool("read_skill", "Reads a skill: how your person wants that kind of task done. Follow it.", object(Obj.new().j("name", text_arg("The skill's name, as list_skills gives it.")), ["name"])),
        tool("save_skill", "Saves a skill, new or changed, for every one of your person's agents: how to do a kind of task, learned while doing it. Give it whole.", object(Obj.new().j("name", text_arg("Lowercase letters, digits and hyphens, such as release-notes.")).j("description", text_arg("When it's for, in one sentence, so an agent knows to read it.")).j("body", text_arg("The skill, in Markdown.")), ["name", "description", "body"])),
        tool("notify", "Sends your person a notification on their devices. Keep it for what they'd want to know now.", object(Obj.new().j("title", text_arg("A few words.")).j("body", text_arg("One or two sentences.")), ["title", "body"])),
    ]
}

@test
fn every_tool_has_a_schema() {
    let tools = all()
    assert(tools.len() == 11)
    for t in tools {
        assert("{t}".contains("\"inputSchema\":\{\"type\":\"object\""))
    }
}
