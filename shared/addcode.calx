module shared.addcode

// The code that adds a device to an account (protocol.md, "Adding a device"): eight
// letters and digits of Crockford's base 32, shown as two groups of four, which a
// person can read and type. It's read back in any case, without the dash or spaces,
// with O as 0 and I or L as 1. And the check both devices show while the person says
// yes, four digits.
import std.crypto.{random_bytes}

const ALPHABET: str = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"

/// A new code, as it's shown: `K7QF-M2XD`.
pub fn new_code() -> String {
    var out = String()
    for (n, b) in random_bytes(8).enumerate() {
        if n == 4 { out.push_str("-") }
        // 256 is 8 times 32, so each letter is as likely as the next.
        let i = usize(b % 32u8)
        out.push_str(ALPHABET[i..i + 1])
    }
    return out
}

/// `code` as it's kept, its SHA-256 taken of: uppercase, its letters and digits alone,
/// O read as 0 and I and L as 1. A link code (`loom-link-…`) stays as it is.
pub fn normal(code: String) -> String {
    let t = code.trim().copy()
    if t.starts_with("loom-link-") { return t }
    var out = String()
    for r in t.to_upper_root().runes() {
        if r == 'O' {
            out.push('0')
        } else if r == 'I' or r == 'L' {
            out.push('1')
        } else if (r >= '0' and r <= '9') or (r >= 'A' and r <= 'Z') {
            out.push(r)
        }
    }
    return out
}

/// Whether `code` is one a device showed, rather than a link code an agent or the
/// server's command line handed on.
pub fn is_device_code(code: String) -> bool {
    return not code.trim().starts_with("loom-link-")
}

/// Four digits, `0000` to `9999`, for the check.
pub fn new_check() -> String {
    let b = random_bytes(4)
    let n = (u32(b[0]) << 24 | u32(b[1]) << 16 | u32(b[2]) << 8 | u32(b[3])) % 10000u32
    return "{n}".pad_start(4, '0')
}

@test
fn a_code_is_two_groups_of_four() {
    let c = new_code()
    assert(c.len() == 9 and c[4..5] == "-")
    assert(normal(c.copy()).len() == 8)
    assert(is_device_code(c))
    assert(not is_device_code(String("loom-link-0f3a")))
}

@test
fn reads_a_code_as_its_person_typed_it() {
    assert(normal(String(" k7qf-m2xd ")) == "K7QFM2XD")
    assert(normal(String("K7QF M2XD")) == "K7QFM2XD")
    assert(normal(String("o1il-0000")) == "01110000")
    assert(normal(String("loom-link-0f3a")) == "loom-link-0f3a")
}

@test
fn a_check_is_four_digits() {
    for _ in 0..50 {
        let c = new_check()
        assert(c.len() == 4)
        for r in c.runes() {
            assert(r >= '0' and r <= '9')
        }
    }
}
