module shared.checkpoint

// A database checkpointed on a thread of its own, with a connection of its own:
// the instance's (server/store.calx, `Store.checkpoint_elsewhere`) and the
// core's cache (core/cache.calx). SQLite's own checkpoint runs inside whichever
// commit takes the write-ahead log past 1000 pages: on the instance's loop that
// held up every person for 20-50 ms every ten turns or so, and on the core's it
// held up the app's reads for up to 50 ms. A passive checkpoint never waits on
// the other connection's writes, and that connection never waits on it.
import std.sqlite.{Database}
import std.thread.{Task}
import std.time.{Instant}

// How often it checkpoints, in nanoseconds: often enough that each one copies little.
const EVERY_NS: u64 = 2000000000

struct Worker {
    path: String
    stop: Receiver<bool>
}

impl Task for Worker {
    fn run(own self) {
        var w = self
        let db = match Database.open(w.path.copy()) {
            ok(d) => d,
            err(e) => {
                eprintln("loom: checkpointing {w.path}: {e}")
                return
            },
        }
        loop {
            let from = unsafe { Instant.now() }
            if let _ = unsafe { w.stop.wait_for(EVERY_NS) } { return }
            // Nothing came, but it came back early: whoever could stop it is gone.
            if unsafe { Instant.now() }.nanos_since(from) < EVERY_NS / 2 { return }
            if let err(e) = db.query(String("PRAGMA wal_checkpoint(PASSIVE)")) { eprintln("loom: checkpointing {w.path}: {e}") }
        }
    }
}

/// Starts checkpointing the database at `path`. Sending to what it gives back, or
/// letting go of it, stops it.
pub fn start(path: String) -> (Thread, Sender<bool>) {
    let stop = Receiver<bool>()
    let to = stop.sender()
    let t = unsafe { Thread.spawn(Worker { path: path.copy(), stop: stop }) }
    return (t, to)
}
