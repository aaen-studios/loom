// Supertonic 3's ten voice styles, in voice.bin's order, each speaker's number its place.
const SUPERTONIC_VOICES: [(str, str); 10] = [
    ("F1", "Woman 1"), ("F2", "Woman 2"), ("F3", "Woman 3"), ("F4", "Woman 4"), ("F5", "Woman 5"),
    ("M1", "Man 1"), ("M2", "Man 2"), ("M3", "Man 3"), ("M4", "Man 4"), ("M5", "Man 5"),
]

/// Pocket TTS's voices: it speaks in the voice of a short recording, and these are the
/// two English ones its sherpa-onnx package comes with, each id, name and file.
pub const POCKET_VOICES: [(str, str, str); 2] = [("bria", "Bria", "test_wavs/bria.wav"), ("loona", "Loona", "test_wavs/loona.wav")]

fn three(n: u32) -> String {
    return if n < 10 { "00{n}" } else if n < 100 { "0{n}" } else { "{n}" }
}

fn a_voice(id: String, name: String) -> Json {
    return Obj.new().s("id", id).s("name", name).done()
}

/// The voices of an engine whose voices are its own, each `id` and `name`, for `model`;
/// none for one whose voices come from the service (ElevenLabs, Fish Audio). A model on
/// the device's are in its speakers' order.
pub fn fixed_voices(which: String, model: String) -> List<Json>? {
    var out = List<Json>()
    if which == "openai" {
        for v in OPENAI_VOICES { out.push(a_voice(String(v), title(String(v)))) }
    } else if which == "deepgram" {
        if model == "aura-2" {
            for v in AURA_VOICES { out.push(a_voice("aura-2-{v}-en", title(String(v)))) }
        } else {
            for v in FLUX_VOICES { out.push(a_voice("flux-{v}-en", title(String(v)))) }
        }
    } else if which == "kokoro" {
        for (id, _, name) in KOKORO_VOICES { out.push(a_voice(String(id), String(name))) }
    } else if which == "kokoro-v1.1" {
        for (id, name) in KOKORO_11_ENGLISH { out.push(a_voice(String(id), String(name))) }
        for n in KOKORO_11_WOMEN { out.push(a_voice("zf_{three(n)}", "Woman {n}, Chinese")) }
        for n in KOKORO_11_MEN { out.push(a_voice("zm_{three(n)}", "Man {n}, Chinese")) }
    } else if which == "supertonic" {
        for (id, name) in SUPERTONIC_VOICES { out.push(a_voice(String(id), String(name))) }
    } else if which == "pocket" {
        for (id, name, _) in POCKET_VOICES { out.push(a_voice(String(id), String(name))) }
    } else {
        return none
    }
    return some(out)
}

/// The voice in `list` that `wanted` names, by its id or its name, if one does.
pub fn find_voice(list: List<Json>, wanted: String) -> Json? {
    let w = wanted.trim().to_lower_root()
    for v in list {
        if (str_at(v.copy(), "id") ?? String()).to_lower_root() == w or (str_at(v.copy(), "name") ?? String()).to_lower_root() == w { return some(v.copy()) }
    }
    return none
}

/// The voice in `list` that `wanted` names, by its id or its name, or the first.
pub fn pick_voice(list: List<Json>, wanted: String) -> Json? {
    if let v = find_voice(list.copy(), wanted) { return some(v) }
    if list.len() > 0 { return some(list[0].copy()) }
    return none
}

/// What a model on the device speaks `voice` with: its speaker's number, and for Pocket
/// TTS, the recording it speaks like, in its folder.
pub fn local_voice(which: String, wanted: String) -> (i32, String) {
    if which == "kokoro" {
        let w = wanted.trim().to_lower_root()
        for (id, n, name) in KOKORO_VOICES {
            if w == id or w == String(name).to_lower_root() { return (n, String()) }
        }
        return (3, String())
    }
    let list = fixed_voices(which.copy(), String()) ?? List<Json>()
    let picked = str_at(pick_voice(list.copy(), wanted) ?? Json.Null, "id") ?? String()
    var n: i32 = 0
    for v in list {
        if str_at(v, "id") == some(picked.copy()) { break }
        n += 1
    }
    if which == "pocket" {
        for (id, _, file) in POCKET_VOICES {
            if id == picked { return (0, String(file)) }
        }
        return (0, String(POCKET_VOICES[0].2))
    }
    return (n, String())
}

// Voices' names, as an error lists them: all of a few, or the first of many.
fn voice_names(list: List<Json>) -> String {
    var names = List<String>()
    for v in list.copy() {
        if names.len() == 6 and list.len() > 8 { break }
        names.push(str_at(v, "name") ?? String())
    }
    let more = list.len() > names.len()
    let last = names.pop() ?? String()
    let all = if names.len() == 0 { last } else { "{names.join(", ")} and {last}" }
    return if more { "such as {all}" } else { all }
}

/// The ids of the engines of `kind`, as an error lists them: "a, b and c".
pub fn engine_ids(kind: str) -> String {
    var ids = List<String>()
    for e in ENGINES {
        if e.kind == kind { ids.push(String(e.id)) }
    }
    if ids.len() < 2 { return ids.join("") }
    let last = ids.pop() ?? String()
    return "{ids.join(", ")} and {last}"
}

/// The services a key is kept for, each the person's secret `voice.SERVICE`.
pub const SERVICES: [str; 5] = ["elevenlabs", "deepgram", "openai", "groq", "fish"]

/// The languages dictation can be told to hear, by ISO 639-1 code and name; "" detects it.
pub const LANGUAGES: [(str, str); 20] = [
    ("", "Detect"), ("en", "English"), ("no", "Norwegian"), ("sv", "Swedish"), ("da", "Danish"),
    ("fi", "Finnish"), ("de", "German"), ("nl", "Dutch"), ("fr", "French"), ("es", "Spanish"),
    ("it", "Italian"), ("pt", "Portuguese"), ("pl", "Polish"), ("uk", "Ukrainian"), ("tr", "Turkish"),
    ("hi", "Hindi"), ("ja", "Japanese"), ("ko", "Korean"), ("zh", "Chinese"), ("ar", "Arabic"),
]

/// How fast speech goes, as the Speed row offers it. Each service takes these.
pub const SPEEDS: [f64; 5] = [0.8, 0.9, 1.0, 1.1, 1.2]

/// When replies are read aloud: never, only in live mode (LOO-440), or every reply in
/// the chat in front of the person.
pub const READ_ALOUD: [str; 3] = ["never", "live", "always"]

/// How long the person is quiet in live mode before what they said is sent, in
/// seconds, as the Send when I stop talking row offers it.
pub const PAUSES: [f64; 3] = [0.5, 0.8, 1.2]

/// The rate every engine hears and speaks at: 16-bit mono PCM at 24 kHz.
pub const RATE: u32 = 24000

/// The engine `id` of `kind`, if there's one.
pub fn engine(kind: String, id: String) -> Engine? {
    for e in ENGINES {
        if e.kind == kind and e.id == id { return some(e) }
    }
    return none
}

/// The secret a service's key is kept as.
pub fn key_name(service: String) -> String {
    return "voice.{service}"
}

/// Whether `service` is one a key is kept for.
pub fn is_service(service: String) -> bool {
    for s in SERVICES {
        if s == service { return true }
    }
    return false
}

/// A language's name, or none for a code that isn't one of them.
pub fn language_name(code: String) -> String? {
    for (c, n) in LANGUAGES {
        if c == code { return some(String(n)) }
    }
    return none
}

fn number(j: Json) -> f64? {
    return match j {
        Json.Float(f) => some(f),
        Json.Int(n) => some(f64.nearest(n)),
        _ => none,
    }
}

/// The nearest of the speeds to `s`.
pub fn nearest_speed(s: f64) -> f64 {
    var best = 1.0
    for v in SPEEDS {
        if (v - s).abs() < (best - s).abs() { best = v }
    }
    return best
}

/// The nearest of the pauses to `p`.
pub fn nearest_pause(p: f64) -> f64 {
    var best = 0.8
    for v in PAUSES {
        if (v - p).abs() < (best - p).abs() { best = v }
    }
    return best
}

/// Live mode's settings in `j`, whole: a reply stops when the person talks over it,
/// what they said goes after 0.8 s of quiet, and the words show, unless `j` says
/// otherwise.
pub fn live_settings(j: Json) -> Json {
    let barge = bool_of(at(j.copy(), "barge_in")) ?? true
    let captions = bool_of(at(j.copy(), "captions")) ?? true
    let pause = nearest_pause(number(at(j, "pause")) ?? 0.8)
    return Obj.new().b("barge_in", barge).j("pause", Json.Float(pause)).b("captions", captions).done()
}

fn bool_of(j: Json) -> bool? {
    return match j {
        Json.Bool(b) => some(b),
        _ => none,
    }
}

/// The settings in `j`, whole, with the defaults for what it doesn't have: no engine
/// picked, the language detected, each service's newest model, normal speed, replies
/// never read aloud, and live mode's own. What isn't one of the choices is the default.
pub fn settings(j: Json) -> Json {
    let d = at(j.copy(), "dictation")
    let live = live_settings(at(j.copy(), "live"))
    let s = at(j, "speech")
    var dictation_engine = str_at(d.copy(), "engine") ?? String()
    if engine(String("dictation"), dictation_engine.copy()) == none { dictation_engine = String() }
    var language = str_at(d.copy(), "language") ?? String()
    if language_name(language.copy()) == none { language = String() }
    var speech_engine = str_at(s.copy(), "engine") ?? String()
    if engine(String("speech"), speech_engine.copy()) == none { speech_engine = String() }
    var read = str_at(s.copy(), "read_aloud") ?? String()
    if not reads(read.copy()) { read = String("never") }
    let dictation = Obj.new().s("engine", dictation_engine).s("language", language).j("models", models_json(d, "dictation")).done()
    let spoken = Obj.new().s("engine", speech_engine).s("voice", str_at(s.copy(), "voice") ?? String()).s("voice_name", str_at(s.copy(), "voice_name") ?? String()).j("speed", Json.Float(nearest_speed(number(at(s.copy(), "speed")) ?? 1.0))).s("read_aloud", read).j("models", models_json(s, "speech")).done()
    return Obj.new().j("dictation", dictation).j("speech", spoken).j("live", live).done()
}

// A kind's settings with `given` the model of its engine in use: by its id or its name,
// or "" for its newest.
fn set_model(kept: Json, kind: str, given: String) -> Json ! String {
    let id = str_at(kept.copy(), "engine") ?? String()
    if id.len() == 0 { fail "Pick a {kind} engine before its model." }
    return try set_model_of(kept, kind, id, given)
}

// A kind's settings with each service's model in `given`, `{service: model}`, as the
// settings keep them.
fn set_models(kept: Json, kind: str, given: Json) -> Json ! String {
    var next = kept.copy()
    if let Json.Object(o) = given {
        for (id, m) in o {
            if let Json.Str(model) = m { next = try set_model_of(next, kind, id.copy(), model.copy()) }
        }
    }
    return next
}

// A kind's settings with `given` the model of its engine `id`.
fn set_model_of(kept: Json, kind: str, id: String, given: String) -> Json ! String {
    let e = engine(String(kind), id.copy()) else fail "There's no {kind} engine {id}."
    let all = models_of(String(kind), id.copy())
    if all.len() == 0 {
        if given.len() == 0 or given == id { return kept.copy() }
        fail "{e.name} runs on the device, and is its own model."
    }
    let picked = if given.len() == 0 { all[0] } else {
        match model_named(String(kind), id, given.copy()) {
            some(m) => m,
            none => {
                var names = List<String>()
                for m in all { names.push(String(m.id)) }
                fail "{e.name} has no model {given}. Its models are {names.join(", ")}."
            },
        }
    }
    let models = merge(at(kept.copy(), "models"), Obj.new().s(e.id, String(picked.id)).done())
    return merge(kept, Obj.new().j("models", models).done())
}

/// `old` with the changes in `args` (`dictation` and `speech`, each with what changes),
/// or why one isn't right. A new speech engine starts with its own default voice
/// unless a voice comes with it, and so does a model of Deepgram's, whose voices are
/// each model's own.
pub fn apply(old: Json, args: Json) -> Json ! String {
    var next = settings(old)
    var d = at(next.copy(), "dictation")
    var s = at(next.copy(), "speech")
    let dc = at(args.copy(), "dictation")
    if let e = str_at(dc.copy(), "engine") {
        if e.len() > 0 and engine(String("dictation"), e.copy()) == none { fail "There's no dictation engine {e}. Pick one of {engine_ids("dictation")}." }
        d = merge_str(d, "engine", e)
    }
    d = try set_models(d, "dictation", at(dc.copy(), "models"))
    if let m = str_at(dc.copy(), "model") { d = try set_model(d, "dictation", m) }
    if let l = str_at(dc, "language") {
        if language_name(l.copy()) == none { fail "There's no language {l} to dictate in. Give an ISO 639-1 code, such as en or no, or \"\" to detect it." }
        d = merge_str(d, "language", l)
    }
    let live = match apply_live(at(next.copy(), "live"), at(args.copy(), "live")) {
        ok(l) => l,
        err(why) => fail why,
    }
    let sc = at(args, "speech")
    let voice_given = str_at(sc.copy(), "voice") != none
    if let e = str_at(sc.copy(), "engine") {
        if e.len() > 0 and engine(String("speech"), e.copy()) == none { fail "There's no speech engine {e}. Pick one of {engine_ids("speech")}." }
        if some(e.copy()) != str_at(s.copy(), "engine") and not voice_given {
            s = merge_str(merge_str(s, "voice", String()), "voice_name", String())
        }
        s = merge_str(s, "engine", e)
    }
    s = try set_models(s, "speech", at(sc.copy(), "models"))
    if let m = str_at(sc.copy(), "model") {
        let e = str_at(s.copy(), "engine") ?? String()
        let was = model_of(s.copy(), String("speech"), e.copy())
        s = try set_model(s, "speech", m)
        if e == "deepgram" and model_of(s.copy(), String("speech"), e) != was and not voice_given {
            s = merge_str(merge_str(s, "voice", String()), "voice_name", String())
        }
    }
    if let v = str_at(sc.copy(), "voice") {
        let e = str_at(s.copy(), "engine") ?? String()
        var id = v.copy()
        var shown = str_at(sc.copy(), "voice_name") ?? v.copy()
        if v.len() > 0 {
            if let list = fixed_voices(e.copy(), model_of(s.copy(), String("speech"), e.copy())) {
                let name = match engine(String("speech"), e.copy()) {
                    some(x) => String(x.name),
                    none => e.copy(),
                }
                let found = find_voice(list.copy(), v.copy()) else fail "{name} has no voice {v}. Its voices are {voice_names(list)}."
                id = str_at(found.copy(), "id") ?? String()
                shown = str_at(found, "name") ?? String()
            }
        } else {
            shown = String()
        }
        s = merge_str(s, "voice", id)
        s = merge_str(s, "voice_name", shown)
    }
    if let given = sc.get(String("speed")) {
        let n = number(given) else fail "speed is a number, from 0.8 to 1.2."
        if n < 0.5 or n > 2.0 { fail "speed is from 0.8 to 1.2." }
        s = merge(s, Obj.new().j("speed", Json.Float(nearest_speed(n))).done())
    }
    if let r = str_at(sc, "read_aloud") {
        if not reads(r.copy()) { fail "read_aloud is never, live or always." }
        s = merge_str(s, "read_aloud", r)
    }
    next = Obj.new().j("dictation", d).j("speech", s).j("live", live).done()
    return settings(next)
}

/// Live mode's settings `old` with the changes in `args`: `barge_in` and `captions`,
/// each true or false, and `pause`, one of the pauses.
fn apply_live(old: Json, args: Json) -> Json ! String {
    var next = live_settings(old)
    for k in ["barge_in", "captions"] {
        if let given = args.get(String(k)) {
            let b = bool_of(given) else fail "{k} is true or false."
            next = merge(next, Obj.new().b(k, b).done())
        }
    }
    if let given = args.get(String("pause")) {
        let p = number(given) else fail "pause is a number of seconds: 0.5, 0.8 or 1.2."
        if p < 0.2 or p > 3.0 { fail "pause is 0.5, 0.8 or 1.2 seconds." }
        next = merge(next, Obj.new().j("pause", Json.Float(nearest_pause(p))).done())
    }
    return next
}

/// A word with its first letter in capitals: OpenAI's `marin` is shown as Marin.
pub fn title(word: String) -> String {
    if word.len() == 0 { return String() }
    return "{word[0..1].to_upper_root()}{word[1..]}"
}

fn merge_str(was: Json, key: str, value: String) -> Json {
    return merge(was, Obj.new().s(key, value).done())
}

/// Whether `word` is one of the read-aloud choices.
fn reads(word: String) -> bool {
    for r in READ_ALOUD {
        if word == r { return true }
    }
    return false
}

/// Whether `name` is one of OpenAI's voices.
pub fn openai_voice(name: String) -> bool {
    for v in OPENAI_VOICES {
        if name == v { return true }
    }
    return false
}

/// The engines of `kind` as their tiles show them, with whether the person has the
/// key each needs (`have`, by service), which is in use, and with that kind's settings
/// (`kept`), the model each service uses. A service's tile has its models (`models`,
/// each `id`, `name` and `line`, newest first) and the one it uses (`picked`), whose
/// name is its line; a model on the device has its own line. One with a mark has its
/// SVG (`icon_svg`) and its name (`mark`), which the iPhone has its copy by; `icon` is
/// what one without draws.
pub fn tiles(kind: String, have: List<String>, kept: Json, in_use: String) -> Json {
    var out = List<Json>()
    for e in ENGINES {
        if e.kind != kind { continue }
        let keyed = e.on_device or have.contains(String(e.id))
        let svg = mark_svg(String(e.mark))
        let mark = if svg != none { some(String(e.mark)) } else { none }
        let picked = model_of(kept.copy(), kind.copy(), String(e.id))
        let line = if e.on_device { String(e.line) } else { model_name(kind.copy(), String(e.id), picked.copy()) }
        var t = Obj.new().s("id", String(e.id)).s("name", String(e.name)).s("line", line).s("icon", String(if e.on_device { "laptop" } else { "cloud" })).maybe("icon_svg", svg).maybe("mark", mark).b("streams", e.streams).b("key", not e.on_device).b("have", keyed).b("in_use", in_use == e.id)
        if not e.on_device {
            var models = List<Json>()
            for m in models_of(kind.copy(), String(e.id)) { models.push(Obj.new().s("id", String(m.id)).s("name", String(m.name)).s("line", String(m.line)).done()) }
            t = t.j("models", Json.Array(models)).s("picked", picked)
        }
        out.push(t.done())
    }
    return Json.Array(out)
}

/// What `voice.get` gives: the settings, each kind's tiles, the languages, the speeds,
/// the read-aloud choices and the services the person has a key for.
pub fn listed(kept: Json, have: List<String>) -> Json {
    let s = settings(kept)
    var languages = List<Json>()
    for (c, n) in LANGUAGES { languages.push(Obj.new().s("code", String(c)).s("name", String(n)).done()) }
    var speeds = List<Json>()
    for v in SPEEDS { speeds.push(Json.Float(v)) }
    var pauses = List<Json>()
    for v in PAUSES { pauses.push(Json.Float(v)) }
    var keys = Obj.new()
    for svc in SERVICES { keys = keys.b(svc, have.contains(String(svc))) }
    let d = at(s.copy(), "dictation")
    let sp = at(s.copy(), "speech")
    let dictation_tiles = tiles(String("dictation"), have.copy(), d.copy(), str_at(d, "engine") ?? String())
    let speech_tiles = tiles(String("speech"), have, sp.copy(), str_at(sp, "engine") ?? String())
    return Obj.new().j("settings", s).j("engines", Obj.new().j("dictation", dictation_tiles).j("speech", speech_tiles).done()).j("languages", Json.Array(languages)).j("speeds", Json.Array(speeds)).j("pauses", Json.Array(pauses)).j("read_aloud", Json.Array([Json.Str(String("never")), Json.Str(String("live")), Json.Str(String("always"))])).j("keys", keys.done()).done()
}

// --- The services ---

/// Where a service is, or `at` in its place (a fake one, for tests), as `https://` or
/// `wss://` and its host.
fn service_at(service: String, secure: bool, place: String?) -> String {
    if let given = place {
        let plain = if given.ends_with("/") { given[0..given.len() - 1].copy() } else { given.copy() }
        if secure { return plain }
        return if plain.starts_with("https://") { "wss://{plain[8..]}" } else if plain.starts_with("http://") { "ws://{plain[7..]}" } else { plain }
    }
    let host = match service {
        "elevenlabs" => "api.elevenlabs.io",
        "deepgram" => "api.deepgram.com",
        "openai" => "api.openai.com",
        "groq" => "api.groq.com",
        "fish" => "api.fish.audio",
        _ => "localhost",
    }
    return if secure { "https://{host}" } else { "wss://{host}" }
}

fn header(name: str, value: String) -> Header {
    return Header { name: String(name), value: value.copy() }
}

/// The headers a service's key goes in.
pub fn auth(service: String, key: String) -> List<Header> {
    return match service {
        "deepgram" => [header("Authorization", "Token {key}")],
        "elevenlabs" => [header("xi-api-key", key)],
        _ => [header("Authorization", "Bearer {key}")],
    }
}

// Whether a Deepgram model is one of its Flux ones, which listen and speak on /v2.
fn flux(model: String) -> bool {
    return model.starts_with("flux")
}

/// The WebSocket a streaming dictation engine is heard over, with `model`, for
/// `language` ("" to detect it).
pub fn stream_url(service: String, model: String, language: String, place: String?) -> String {
    let b = service_at(service.copy(), false, place)
    if service == "deepgram" {
        if flux(model.copy()) {
            // Flux English hears English; its multilingual model takes the language as a hint.
            let hint = if model == "flux-general-multi" and language.len() > 0 { "&language_hint={url.encode_plus(language)}" } else { String() }
            return "{b}/v2/listen?model={url.encode_plus(model)}&encoding=linear16&sample_rate={RATE}{hint}"
        }
        let lang = if language.len() == 0 { String("multi") } else { language.copy() }
        return "{b}/v1/listen?model={url.encode_plus(model)}&encoding=linear16&sample_rate={RATE}&channels=1&interim_results=true&smart_format=true&punctuate=true&language={url.encode_plus(lang)}"
    }
    if service == "elevenlabs" {
        let lang = if language.len() == 0 { String() } else { "&language_code={url.encode_plus(language)}" }
        return "{b}/v1/speech-to-text/realtime?model_id={url.encode_plus(model)}&audio_format=pcm_{RATE}&commit_strategy=vad{lang}"
    }
    return "{b}/v1/realtime?intent=transcription"
}

/// What's sent first on the stream, once it's open: OpenAI's session, set to transcribe
/// 24 kHz PCM with `model`, with no turn detection of its own, as the core commits once
/// the person stops. Its newer models take `languages`, and Whisper `language`. Nothing
/// for the others, whose URL says it.
pub fn stream_hello(service: String, model: String, language: String) -> List<String> {
    if service != "openai" { return List<String>() }
    var transcription = Obj.new().s("model", model.copy())
    if language.len() > 0 {
        transcription = if model == "gpt-realtime-whisper" { transcription.s("language", language) } else { transcription.j("languages", Json.Array([Json.Str(language.copy())])) }
    }
    let input = Obj.new().j("format", Obj.new().s("type", String("audio/pcm")).j("rate", Json.Int(i64(RATE))).done()).j("transcription", transcription.done()).j("turn_detection", Json.Null).done()
    let session = Obj.new().s("type", String("transcription")).j("audio", Obj.new().j("input", input).done()).done()
    return ["{Obj.new().s("type", String("session.update")).j("session", session).done()}"]
}

/// A piece of the person's speech on the stream: 16-bit little-endian PCM at 24 kHz,
/// as Deepgram takes it, in a binary message (`true`), or as the others take it, in
/// JSON with the audio in base64.
pub fn stream_audio(service: String, pcm: List<u8>) -> (bool, String) {
    if service == "deepgram" { return (true, String()) }
    if service == "elevenlabs" {
        return (false, "{Obj.new().s("message_type", String("input_audio_chunk")).s("audio_base_64", bytes.base64(pcm)).b("commit", false).j("sample_rate", Json.Int(i64(RATE))).done()}")
    }
    return (false, "{Obj.new().s("type", String("input_audio_buffer.append")).s("audio", bytes.base64(pcm)).done()}")
}

/// What ends the stream once the person stops: the last words are written, and
/// Deepgram closes the stream after them. Flux ends the turn the person was in.
pub fn stream_end(service: String, model: String) -> List<String> {
    if service == "deepgram" {
        if flux(model) { return [String(#"{"type":"ForceEndTurn"}"#), String(#"{"type":"CloseStream"}"#)] }
        return [String(#"{"type":"Finalize"}"#), String(#"{"type":"CloseStream"}"#)]
    }
    if service == "elevenlabs" { return ["{Obj.new().s("message_type", String("input_audio_chunk")).s("audio_base_64", String()).b("commit", true).j("sample_rate", Json.Int(i64(RATE))).done()}"] }
    return [String(#"{"type":"input_audio_buffer.commit"}"#)]
}

/// What a streaming engine said, read from one of its messages.
pub enum Heard {
    Partial(String)    // the words being said now, in place of the last partial
    Delta(String)      // more of the words being said now, after the partial
    Final(String)      // words that are kept, after those kept before
    Failed(String)     // why it stopped, in the service's words
    Nothing
}

/// One message from a streaming engine, heard with `model`.
pub fn heard(service: String, model: String, text: String) -> Heard {
    let m = match parse(text) {
        ok(j) => j,
        err(_) => return Heard.Nothing,
    }
    if service == "deepgram" {
        let kind = str_at(m.copy(), "type") ?? String()
        if kind == "Error" { return Heard.Failed(str_at(m.copy(), "description") ?? str_at(m, "message") ?? String("Deepgram stopped.")) }
        if flux(model) {
            // Flux tells each turn as it goes, and its words once it ends.
            if kind != "TurnInfo" { return Heard.Nothing }
            let event = str_at(m.copy(), "event") ?? String()
            let words = str_at(m, "transcript") ?? String()
            if event == "EndOfTurn" { return Heard.Final(words) }
            if event == "Update" or event == "StartOfTurn" or event == "EagerEndOfTurn" { return Heard.Partial(words) }
            return Heard.Nothing
        }
        if kind != "Results" { return Heard.Nothing }
        let alternatives = at(at(m.copy(), "channel"), "alternatives")
        let first = match alternatives {
            Json.Array(a) => if a.len() > 0 { a[0].copy() } else { Json.Null },
            _ => Json.Null,
        }
        let words = str_at(first, "transcript") ?? String()
        if at(m, "is_final") == Json.Bool(true) { return Heard.Final(words) }
        return Heard.Partial(words)
    }
    if service == "elevenlabs" {
        let kind = str_at(m.copy(), "message_type") ?? String()
        if kind == "partial_transcript" { return Heard.Partial(str_at(m, "text") ?? String()) }
        if kind == "committed_transcript" or kind == "committed_transcript_with_timestamps" { return Heard.Final(str_at(m, "text") ?? String()) }
        if kind.ends_with("error") or kind == "quota_exceeded" or kind == "rate_limited" or kind == "invalid_request" or kind == "session_time_limit_exceeded" or kind == "resource_exhausted" {
            return Heard.Failed(str_at(m, "error") ?? kind)
        }
        return Heard.Nothing
    }
    let kind = str_at(m.copy(), "type") ?? String()
    if kind == "conversation.item.input_audio_transcription.delta" { return Heard.Delta(str_at(m, "delta") ?? String()) }
    if kind == "conversation.item.input_audio_transcription.completed" { return Heard.Final(str_at(m, "transcript") ?? String()) }
    if kind == "conversation.item.input_audio_transcription.failed" { return Heard.Failed(str_at(at(m, "error"), "message") ?? String("OpenAI couldn't write it.")) }
    if kind == "error" {
        let e = at(m, "error")
        // Committing a buffer with nothing in it is no failure.
        if str_at(e.copy(), "code") == some(String("input_audio_buffer_commit_empty")) { return Heard.Nothing }
        return Heard.Failed(str_at(e, "message") ?? String("OpenAI stopped."))
    }
    return Heard.Nothing
}

/// Words kept, then more after them: a space between, unless either side has one.
pub fn joined(kept: String, more: String) -> String {
    let m = more.trim().copy()
    if m.len() == 0 { return kept.copy() }
    if kept.len() == 0 { return m }
    return "{kept} {m}"
}

/// The request that writes a whole recording at once, for an engine that doesn't
/// stream (Groq's Whisper, `model`): its URL, its headers and the form, a WAV file.
pub fn batch(service: String, key: String, wav: List<u8>, language: String, model: String, place: String?) -> (String, List<Header>, Form) {
    var form = Form.new().field(String("model"), model).field(String("response_format"), String("json"))
    if language.len() > 0 { form = form.field(String("language"), language) }
    form = form.file(String("file"), String("speech.wav"), wav, String("audio/wav"))
    return ("{service_at(service.copy(), true, place)}/openai/v1/audio/transcriptions", auth(service, key), form)
}

/// The words in a batch engine's answer, or why there are none.
pub fn batch_text(status: u32, body: List<u8>) -> String ! String {
    let text = String.from_utf8(body.copy()) ?? String()
    if status != 200 { fail service_error(status, text) }
    let m = match parse(text) {
        ok(j) => j,
        err(_) => fail String("The answer was not JSON."),
    }
    return (str_at(m, "text") ?? String()).trim().copy()
}

/// Why a service said no, in its words where it gave any.
pub fn service_error(status: u32, text: String) -> String {
    if let ok(m) = parse(text.copy()) {
        for k in ["message", "detail", "error", "description", "err_msg"] {
            if let s = str_at(m.copy(), k) { return "{status}: {s}" }
            let inner = at(m.copy(), k)
            if let s = str_at(inner.copy(), "message") { return "{status}: {s}" }
            if let s = str_at(inner, "message") { return "{status}: {s}" }
        }
    }
    if status == 401 or status == 403 { return "{status}: the key wasn't taken" }
    return "{status}: {text.trim()}"
}

/// The most Deepgram reads aloud at once: Aura-2 takes 2000 letters.
const DEEPGRAM_MOST: usize = 2000

/// Whether speech with `service`'s `model` streams over a WebSocket (speech_url) rather
/// than coming as the answer to one request (speech): OpenAI's, over its Realtime API,
/// and ElevenLabs' v4 models, over its Text to Dialogue socket, which its text-to-speech
/// requests don't take.
pub fn speech_socket(service: String, model: String) -> bool {
    return service == "openai" or (service == "elevenlabs" and model.starts_with("eleven_v4"))
}

/// The request that speaks `text` in `voice` (its id) at `speed` with `model`, giving
/// 16-bit mono PCM at 24 kHz: its URL, headers and JSON body. Deepgram's answer may come
/// as a WAV (pcm_of).
pub fn speech(service: String, key: String, text: String, voice: String, pace: f64, model: String, place: String?) -> (String, List<Header>, List<u8>) {
    let b = service_at(service.copy(), true, place)
    var headers = auth(service.copy(), key)
    headers.push(header("Content-Type", String("application/json")))
    if service == "elevenlabs" {
        // v3 doesn't follow speed, and takes it.
        let tuning = Obj.new().j("speed", Json.Float(pace)).done()
        let body = Obj.new().s("text", text).s("model_id", model).j("voice_settings", tuning).done()
        return ("{b}/v1/text-to-speech/{url.encode(voice)}?output_format=pcm_{RATE}", headers, "{body}".to_bytes())
    }
    if service == "fish" {
        headers.push(header("model", model))
        let body = Obj.new().s("text", text).s("reference_id", voice).s("format", String("pcm")).j("sample_rate", Json.Int(i64(RATE))).s("latency", String("normal")).j("prosody", Obj.new().j("speed", Json.Float(pace)).done()).done()
        return ("{b}/v1/tts", headers, "{body}".to_bytes())
    }
    // Deepgram: the voice is the model it asks for, Flux's on /v2 and Aura-2's on /v1.
    let list = fixed_voices(service.copy(), model.copy()) ?? List<Json>()
    let id = str_at(pick_voice(list, voice) ?? Json.Null, "id") ?? String()
    let path = if model == "aura-2" { "/v1/speak" } else { "/v2/speak" }
    let raw = if model == "aura-2" { "&container=none" } else { "" }
    let pace_arg = if pace == 1.0 { String() } else { "&speed={pace}" }
    let body = Obj.new().s("text", cut(text, DEEPGRAM_MOST)).done()
    return ("{b}{path}?model={url.encode_plus(id)}&encoding=linear16&sample_rate={RATE}{raw}{pace_arg}", headers, "{body}".to_bytes())
}

/// The PCM in an answer that may be a WAV file: what follows its `data` header, or the
/// answer itself.
pub fn pcm_of(body: List<u8>) -> List<u8> {
    if body.len() < 44 or String.from_utf8(body[0..4].copy()) != some(String("RIFF")) { return body.copy() }
    var i: usize = 12
    while i + 8 <= body.len() {
        let size = usize(bytes.u32_le(body.copy(), i + 4))
        if String.from_utf8(body[i..i + 4].copy()) == some(String("data")) {
            let end = if i + 8 + size <= body.len() { i + 8 + size } else { body.len() }
            return body[i + 8..end].copy()
        }
        i += 8 + size + size % 2
    }
    return body.copy()
}

/// The WebSocket speech that streams comes over (speech_socket), with `model`.
pub fn speech_url(service: String, model: String, place: String?) -> String {
    let b = service_at(service.copy(), false, place)
    if service == "elevenlabs" { return "{b}/v1/text-to-dialogue/stream-input?model_id={url.encode_plus(model)}&output_format=pcm_{RATE}" }
    return "{b}/v1/realtime?model={url.encode_plus(model)}"
}

/// What OpenAI is told to do with the text it's given: read it, as written.
const READ_AS_WRITTEN: str = "Read the user's text aloud exactly as it's written, word for word, in a natural voice. Don't answer it, and don't add, leave out or change anything."

/// What's sent on speech's socket once it's open, to speak `text` in `voice` at `speed`:
/// ElevenLabs' voice, the text in it, and the end; or OpenAI's session, set to speak
/// 24 kHz PCM in the voice and read what it's given as written, the text, and the
/// request for its speech.
pub fn speech_hello(service: String, model: String, text: String, voice: String, pace: f64) -> List<String> {
    _ = model
    if service == "elevenlabs" {
        let first = Obj.new().j("voices", Json.Array([Json.Str(voice.copy())])).done()
        let input = Obj.new().j("inputs", Json.Array([Obj.new().s("text", text).s("voice_id", voice).done()])).done()
        return ["{first}", "{input}", "{Obj.new().b("close_socket", true).done()}"]
    }
    let picked = if openai_voice(voice.to_lower_root()) { voice.to_lower_root() } else { String("marin") }
    let output = Obj.new().j("format", Obj.new().s("type", String("audio/pcm")).j("rate", Json.Int(i64(RATE))).done()).s("voice", picked).j("speed", Json.Float(pace)).done()
    let session = Obj.new().s("type", String("realtime")).j("output_modalities", Json.Array([Json.Str(String("audio"))])).s("instructions", String(READ_AS_WRITTEN)).j("audio", Obj.new().j("output", output).done()).done()
    let content = Json.Array([Obj.new().s("type", String("input_text")).s("text", text).done()])
    let item = Obj.new().s("type", String("message")).s("role", String("user")).j("content", content).done()
    return ["{Obj.new().s("type", String("session.update")).j("session", session).done()}", "{Obj.new().s("type", String("conversation.item.create")).j("item", item).done()}", String(#"{"type":"response.create"}"#)]
}

/// What a speech socket said.
pub enum Said {
    Audio(List<u8>)    // more 24 kHz PCM
    Done
    Failed(String)     // why, in the service's words
    Nothing
}

/// One message on a speech socket.
pub fn speech_heard(service: String, text: String) -> Said {
    let m = match parse(text) {
        ok(j) => j,
        err(_) => return Said.Nothing,
    }
    if service == "elevenlabs" {
        if let a = str_at(m.copy(), "audio") { return Said.Audio(bytes.from_base64(a) ?? List<u8>()) }
        if bool_at(m.copy(), "is_final") == some(true) { return Said.Done }
        if let e = str_at(m.copy(), "error") { return Said.Failed(str_at(m, "message") ?? e) }
        return Said.Nothing
    }
    let kind = str_at(m.copy(), "type") ?? String()
    if kind == "response.output_audio.delta" { return Said.Audio(bytes.from_base64(str_at(m, "delta") ?? String()) ?? List<u8>()) }
    if kind == "response.done" {
        let r = at(m, "response")
        if str_at(r.copy(), "status") == some(String("failed")) { return Said.Failed(str_at(at(at(r, "status_details"), "error"), "message") ?? String("OpenAI couldn't say it.")) }
        return Said.Done
    }
    if kind == "error" { return Said.Failed(str_at(at(m, "error"), "message") ?? String("OpenAI stopped.")) }
    return Said.Nothing
}

/// The request for a speech engine's voices, or none for one whose are its own.
pub fn voices_request(service: String, key: String, place: String?) -> (String, List<Header>)? {
    let b = service_at(service.copy(), true, place)
    if service == "elevenlabs" { return some(("{b}/v2/voices?page_size=100&include_total_count=false", auth(service, key))) }
    if service == "fish" { return some(("{b}/model?page_size=50&sort_by=score", auth(service, key))) }
    return none
}

/// A speech engine's voices, each `id` and `name`, from its answer, or its own for one
/// whose voices are, with its newest model.
pub fn voices(service: String, body: List<u8>) -> List<Json> {
    var out = List<Json>()
    if service != "elevenlabs" and service != "fish" {
        let all = models_of(String("speech"), service.copy())
        let model = if all.len() > 0 { String(all[0].id) } else { String() }
        return fixed_voices(service, model) ?? out
    }
    let m = match parse(String.from_utf8(body.copy()) ?? String()) {
        ok(j) => j,
        err(_) => return out,
    }
    let (list, id_key, name_key) = if service == "elevenlabs" { (at(m, "voices"), "voice_id", "name") } else { (at(m, "items"), "_id", "title") }
    if let Json.Array(items) = list {
        for v in items {
            let id = str_at(v.copy(), id_key) ?? String()
            if id.len() > 0 { out.push(Obj.new().s("id", id).s("name", str_at(v, name_key) ?? String()).done()) }
        }
    }
    return out
}

/// The most of a reply read aloud at once, cut at a sentence: Realtime takes more, and
/// a reply this long is better read in the chat.
const SPOKEN_MOST: usize = 4000

/// Words cut to at most `most` letters, at the last sentence that fits, or the last
/// word.
pub fn cut(all: String, most: usize) -> String {
    if all.len() <= most { return all.copy() }
    var head = String()
    for w in all.split_whitespace() {
        if head.len() + w.len() + 1 > most { break }
        head = if head.len() == 0 { w.copy() } else { "{head} {w}" }
    }
    let stop = head.find_last(". ") ?? 0
    return if stop > 0 { head[0..stop + 1].copy() } else { head }
}

/// A reply's Markdown as words to say: no code, no marks, a link as its words.
pub fn speakable(markdown: String) -> String {
    var out = List<String>()
    var code = false
    for raw in markdown.split("\n") {
        let line = raw.trim()
        if line.starts_with("```") {
            code = not code
            continue
        }
        if code or line.len() == 0 { continue }
        var l = line.copy()
        while l.starts_with("#") or l.starts_with(">") or l.starts_with("- ") or l.starts_with("* ") { l = l[1..].trim().copy() }
        // [words](address) is its words.
        var spoken = String()
        var rest = l.copy()
        while let open = rest.find("[") {
            let close = rest[open..].find("](") else break
            let end = rest[open + close..].find(")") else break
            spoken = "{spoken}{rest[0..open]}{rest[open + 1..open + close]}"
            rest = rest[open + close + end + 1..].copy()
        }
        spoken = "{spoken}{rest}"
        for mark in ["**", "__", "`", "*", "_", "~~"] { spoken = spoken.replace(mark, "") }
        out.push(spoken.trim().copy())
    }
    return cut(out.join(" "), SPOKEN_MOST)
}

// --- Audio ---

/// 16-bit PCM from the device's mic, `channels` interleaved at `rate`, as one channel
/// at 24 kHz: the channels averaged, and each sample between two of the input's.
pub fn to_24k(pcm: List<u8>, rate: u32, channels: u32) -> List<i16> {
    var out = List<i16>()
    let ch = usize(if channels == 0 { 1u32 } else { channels })
    let frames = pcm.len() / (2 * ch)
    if frames == 0 or rate == 0 { return out }
    var mono = List<f64>()
    for f in 0..frames {
        var sum = 0.0
        for c in 0..ch {
            let i = (f * ch + c) * 2
            let s = i16.wrap(u32(pcm[i]) | (u32(pcm[i + 1]) << 8))
            sum += f64(s)
        }
        mono.push(sum / f64.nearest(ch))
    }
    if rate == RATE {
        for s in mono { out.push(i16.wrap(i32.saturate(s))) }
        return out
    }
    let step = f64(rate) / f64(RATE)
    var t = 0.0
    let last = f64.nearest(frames - 1)
    while t <= last {
        let i = usize.try_from(i64.saturate(t.floor())) ?? 0
        let frac = t - t.floor()
        let a = mono[i]
        let b = if i + 1 < frames { mono[i + 1] } else { a }
        out.push(i16.wrap(i32.saturate((a + (b - a) * frac + 0.5).floor())))
        t += step
    }
    return out
}

/// 24 kHz samples as the on-device models hear them: 16 kHz, from -1 to 1, each
/// between two of the input's.
pub fn to_16k(samples: List<i16>) -> List<f32> {
    var out = List<f32>()
    let n = samples.len()
    if n == 0 { return out }
    // Two of every three 24 kHz samples' places: 0, 1.5, 3, 4.5, ...
    var i: usize = 0
    while i < n {
        out.push(f32.nearest(f64(samples[i]) / 32768.0))
        if i + 1 < n {
            let mid = (f64(samples[i + 1]) + f64(if i + 2 < n { samples[i + 2] } else { samples[i + 1] })) / 2.0
            out.push(f32.nearest(mid / 32768.0))
        }
        i += 3
    }
    return out
}

/// Samples from -1 to 1, as a model speaks them, as 16-bit little-endian PCM.
pub fn from_floats(samples: List<f32>) -> List<u8> {
    var out = List<u8>()
    for s in samples {
        let v = f64(s) * 32767.0
        let c = if v > 32767.0 { 32767.0 } else if v < -32768.0 { -32768.0 } else { v }
        let u = u32.wrap(i16.wrap(i32.saturate((c + 0.5).floor())))
        out.push(u8.wrap(u))
        out.push(u8.wrap(u >> 8))
    }
    return out
}

/// Samples as 16-bit little-endian bytes.
pub fn le_bytes(samples: List<i16>) -> List<u8> {
    var out = List<u8>()
    for s in samples {
        let u = u32.wrap(s)
        out.push(u8.wrap(u))
        out.push(u8.wrap(u >> 8))
    }
    return out
}

/// 16-bit mono PCM at 24 kHz as a WAV file: the 44-byte header std.wave writes, then
/// the samples.
pub fn to_wav(pcm: List<u8>) -> List<u8> {
    var out = List<u8>()
    let n = u32.try_from(pcm.len() - pcm.len() % 2) ?? 0
    for c in "RIFF".to_bytes() { out.push(c) }
    bytes.put_u32_le(mut out, 36 + n)
    for c in "WAVEfmt ".to_bytes() { out.push(c) }
    bytes.put_u32_le(mut out, 16)
    bytes.put_u16_le(mut out, 1)
    bytes.put_u16_le(mut out, 1)
    bytes.put_u32_le(mut out, RATE)
    bytes.put_u32_le(mut out, RATE * 2)
    bytes.put_u16_le(mut out, 2)
    bytes.put_u16_le(mut out, 16)
    for c in "data".to_bytes() { out.push(c) }
    bytes.put_u32_le(mut out, n)
    for i in 0..usize(n) { out.push(pcm[i]) }
    return out
}

// --- Tests ---

@test
fn settings_start_with_nothing_picked() {
    let s = settings(Json.Null)
    assert("{s}" == #"{"dictation":{"engine":"","language":"","models":{"elevenlabs":"scribe_v3_live","deepgram":"nova-3","openai":"gpt-live-transcribe","groq":"whisper-large-v3-turbo"}},"speech":{"engine":"","voice":"","voice_name":"","speed":1.0,"read_aloud":"never","models":{"elevenlabs":"eleven_v4_turbo","fish":"drama-3","openai":"gpt-realtime-2.1-mini","deepgram":"flux"}},"live":{"barge_in":true,"pause":0.8,"captions":true}}"#)
    // What isn't one of the choices is the default, a model that's gone too.
    let odd = settings(parse(#"{"dictation":{"engine":"siri","language":"xx","models":{"deepgram":"nova-2","groq":"whisper-large-v3"}},"speech":{"engine":"openai","speed":1.13,"read_aloud":"sometimes"}}"#)!)
    assert(str_at(at(odd.copy(), "dictation"), "engine") == some(String("")) and str_at(at(odd.copy(), "speech"), "read_aloud") == some(String("never")))
    assert("{at(at(odd.copy(), "dictation"), "models")}" == #"{"elevenlabs":"scribe_v3_live","deepgram":"nova-3","openai":"gpt-live-transcribe","groq":"whisper-large-v3"}"#)
    assert(at(at(odd, "speech"), "speed") == Json.Float(1.1))
}

@test
fn changes_are_checked() {
    let s = apply(Json.Null, parse(#"{"dictation":{"engine":"deepgram","language":"no"},"speech":{"engine":"openai","voice":"Cedar","speed":0.9,"read_aloud":"always"}}"#)!)!
    assert("{at(s.copy(), "speech")}".starts_with(#"{"engine":"openai","voice":"cedar","voice_name":"Cedar","speed":0.9,"read_aloud":"always","models":"#))
    assert(match apply(Json.Null, parse(#"{"dictation":{"engine":"siri"}}"#)!) { ok(_) => false, err(_) => true })
    assert(match apply(Json.Null, parse(#"{"dictation":{"language":"klingon"}}"#)!) { ok(_) => false, err(_) => true })
    assert(match apply(s.copy(), parse(#"{"speech":{"voice":"robot"}}"#)!) { ok(_) => false, err(_) => true })
    // OpenAI's Realtime voices are ten: Fable isn't one.
    assert(match apply(s.copy(), parse(#"{"speech":{"voice":"fable"}}"#)!) { ok(_) => false, err(e) => e.contains("Marin, Cedar, Alloy") })
    assert(match apply(s.copy(), parse(#"{"speech":{"speed":9}}"#)!) { ok(_) => false, err(_) => true })
    // Another speech engine starts on its own default voice.
    let fish = apply(s, parse(#"{"speech":{"engine":"fish"}}"#)!)!
    assert(str_at(at(fish.copy(), "speech"), "voice") == some(String("")) and str_at(at(fish, "dictation"), "language") == some(String("no")))
}

@test
fn each_service_keeps_its_model() {
    let s = apply(Json.Null, parse(#"{"dictation":{"engine":"deepgram","model":"Flux English"}}"#)!)!
    assert(model_of(at(s.copy(), "dictation"), String("dictation"), String("deepgram")) == "flux-general-en")
    // Another engine, then back: each keeps its own.
    let groq = apply(s, parse(#"{"dictation":{"engine":"groq","model":"whisper-large-v3"}}"#)!)!
    let back = apply(groq, parse(#"{"dictation":{"engine":"deepgram"}}"#)!)!
    let d = at(back.copy(), "dictation")
    assert(model_of(d.copy(), String("dictation"), String("deepgram")) == "flux-general-en" and model_of(d, String("dictation"), String("groq")) == "whisper-large-v3")
    // "" is the newest again; a model that isn't one, or one before an engine, is refused.
    let newest = apply(back.copy(), parse(#"{"dictation":{"model":""}}"#)!)!
    assert(model_of(at(newest, "dictation"), String("dictation"), String("deepgram")) == "nova-3")
    assert(match apply(back.copy(), parse(#"{"dictation":{"model":"nova-2"}}"#)!) { ok(_) => false, err(e) => e == "Deepgram has no model nova-2. Its models are nova-3, flux-general-en, flux-general-multi." })
    assert(match apply(Json.Null, parse(#"{"speech":{"model":"v4"}}"#)!) { ok(_) => false, err(e) => e == "Pick a speech engine before its model." })
    assert(match apply(Json.Null, parse(#"{"dictation":{"engine":"whisper","model":"tiny"}}"#)!) { ok(_) => false, err(_) => true })
    // Deepgram's voices are each model's: another model starts on its own first voice.
    let dg = apply(Json.Null, parse(#"{"speech":{"engine":"deepgram","voice":"kit"}}"#)!)!
    assert(str_at(at(dg.copy(), "speech"), "voice") == some(String("flux-kit-en")) and str_at(at(dg.copy(), "speech"), "voice_name") == some(String("Kit")))
    let aura = apply(dg, parse(#"{"speech":{"model":"aura-2"}}"#)!)!
    assert(str_at(at(aura.copy(), "speech"), "voice") == some(String("")))
    assert(str_at(at(apply(aura, parse(#"{"speech":{"voice":"Helena"}}"#)!)!, "speech"), "voice") == some(String("aura-2-helena-en")))
}

@test
fn tiles_say_what_each_engine_is() {
    let kept = at(apply(Json.Null, parse(#"{"dictation":{"engine":"groq","model":"whisper-large-v3"}}"#)!)!, "dictation")
    let t = tiles(String("dictation"), [String("groq")], kept, String("groq"))
    assert("{t}".starts_with(#"[{"id":"elevenlabs","name":"ElevenLabs","line":"Scribe v3 Live","icon":"cloud","icon_svg":"<svg "#))
    assert("{t}".contains(#""mark":"elevenlabs","streams":true,"key":true,"have":false,"in_use":false,"models":[{"id":"scribe_v3_live","name":"Scribe v3 Live","line":"Words as you say them"},{"id":"scribe_v2_realtime","name":"Scribe v2 Realtime","line":"The model before"}],"picked":"scribe_v3_live"}"#))
    assert("{t}".contains(#""line":"Whisper large v3","icon":"cloud""#) and "{t}".contains(#""in_use":true,"models":[{"id":"whisper-large-v3-turbo""#) and "{t}".contains(#""picked":"whisper-large-v3"}"#))
    if let Json.Array(each) = t {
        assert(each.len() == 8 and str_at(each[3].copy(), "icon_svg") == mark_svg(String("groq")))
    }
    let l = listed(Json.Null, [String("openai")])
    assert("{at(l.copy(), "keys")}" == #"{"elevenlabs":false,"deepgram":false,"openai":true,"groq":false,"fish":false}"#)
    assert("{at(at(l, "engines"), "speech")}".contains(#"{"id":"openai","name":"OpenAI","line":"gpt-realtime-2.1-mini""#))
}

@test
fn each_service_is_asked_its_own_way() {
    assert(stream_url(String("deepgram"), String("nova-3"), String(""), none) == "wss://api.deepgram.com/v1/listen?model=nova-3&encoding=linear16&sample_rate=24000&channels=1&interim_results=true&smart_format=true&punctuate=true&language=multi")
    assert(stream_url(String("deepgram"), String("flux-general-en"), String("no"), none) == "wss://api.deepgram.com/v2/listen?model=flux-general-en&encoding=linear16&sample_rate=24000")
    assert(stream_url(String("deepgram"), String("flux-general-multi"), String("de"), none) == "wss://api.deepgram.com/v2/listen?model=flux-general-multi&encoding=linear16&sample_rate=24000&language_hint=de")
    assert(stream_end(String("deepgram"), String("flux-general-en"))[0] == #"{"type":"ForceEndTurn"}"#)
    assert(stream_url(String("elevenlabs"), String("scribe_v3_live"), String("no"), some(String("http://127.0.0.1:9/"))) == "ws://127.0.0.1:9/v1/speech-to-text/realtime?model_id=scribe_v3_live&audio_format=pcm_24000&commit_strategy=vad&language_code=no")
    assert(stream_url(String("openai"), String("gpt-live-transcribe"), String(""), none) == "wss://api.openai.com/v1/realtime?intent=transcription")
    assert(stream_hello(String("openai"), String("gpt-live-transcribe"), String("en"))[0] == #"{"type":"session.update","session":{"type":"transcription","audio":{"input":{"format":{"type":"audio/pcm","rate":24000},"transcription":{"model":"gpt-live-transcribe","languages":["en"]},"turn_detection":null}}}}"#)
    assert(stream_hello(String("openai"), String("gpt-realtime-whisper"), String("no"))[0].contains(#""transcription":{"model":"gpt-realtime-whisper","language":"no"}"#))
    assert("{auth(String("deepgram"), String("k"))[0].value}" == "Token k" and auth(String("elevenlabs"), String("k"))[0].name == "xi-api-key" and auth(String("groq"), String("k"))[0].value == "Bearer k")
    let (binary, _) = stream_audio(String("deepgram"), [1u8, 2])
    let (_, eleven) = stream_audio(String("elevenlabs"), [1u8, 2])
    assert(binary and eleven == #"{"message_type":"input_audio_chunk","audio_base_64":"AQI=","commit":false,"sample_rate":24000}"#)
    let (u, _, body) = speech(String("elevenlabs"), String("k"), String("Hi."), String("v 1"), 1.1, String("eleven_multilingual_v2"), none)
    assert(u == "https://api.elevenlabs.io/v1/text-to-speech/v%201?output_format=pcm_24000" and String.from_utf8(body) == some(String(#"{"text":"Hi.","model_id":"eleven_multilingual_v2","voice_settings":{"speed":1.1}}"#)))
    let (fu, fh, _) = speech(String("fish"), String("k"), String("Hi."), String("abc"), 1.0, String("drama-3"), none)
    assert(fu == "https://api.fish.audio/v1/tts" and fh[2].name == "model" and fh[2].value == "drama-3")
    let (du, _, db) = speech(String("deepgram"), String("k"), String("Hi."), String("Kit"), 1.1, String("flux"), none)
    assert(du == "https://api.deepgram.com/v2/speak?model=flux-kit-en&encoding=linear16&sample_rate=24000&speed=1.1" and String.from_utf8(db) == some(String(#"{"text":"Hi."}"#)))
    let (au, _, _) = speech(String("deepgram"), String("k"), String("Hi."), String(""), 1.0, String("aura-2"), none)
    assert(au == "https://api.deepgram.com/v1/speak?model=aura-2-thalia-en&encoding=linear16&sample_rate=24000&container=none")
    // ElevenLabs' v4 and OpenAI's speech stream over a socket.
    assert(speech_socket(String("elevenlabs"), String("eleven_v4_turbo")) and not speech_socket(String("elevenlabs"), String("eleven_v3")) and speech_socket(String("openai"), String("gpt-realtime-2.1-mini")) and not speech_socket(String("deepgram"), String("flux")))
    assert(speech_url(String("elevenlabs"), String("eleven_v4_turbo"), none) == "wss://api.elevenlabs.io/v1/text-to-dialogue/stream-input?model_id=eleven_v4_turbo&output_format=pcm_24000")
    assert(speech_url(String("openai"), String("gpt-realtime-2.1-mini"), none) == "wss://api.openai.com/v1/realtime?model=gpt-realtime-2.1-mini")
    let el = speech_hello(String("elevenlabs"), String("eleven_v4_turbo"), String("Hi."), String("v1"), 1.0)
    assert(el.len() == 3 and el[0] == #"{"voices":["v1"]}"# and el[1] == #"{"inputs":[{"text":"Hi.","voice_id":"v1"}]}"# and el[2] == #"{"close_socket":true}"#)
    let oa = speech_hello(String("openai"), String("gpt-realtime-2.1-mini"), String("Hi."), String("Nova"), 1.1)
    assert(oa.len() == 3 and oa[0].contains(#""output_modalities":["audio"]"#) and oa[0].contains(#""output":{"format":{"type":"audio/pcm","rate":24000},"voice":"marin","speed":1.1}"#) and oa[1].contains(#""content":[{"type":"input_text","text":"Hi."}]"#) and oa[2] == #"{"type":"response.create"}"#)
}

@test
fn what_a_stream_says_is_read() {
    let nova = String("nova-3")
    let partial = heard(String("deepgram"), nova.copy(), String(#"{"type":"Results","is_final":false,"channel":{"alternatives":[{"transcript":"hello wor"}]}}"#))
    let done = heard(String("deepgram"), nova, String(#"{"type":"Results","is_final":true,"channel":{"alternatives":[{"transcript":"hello world"}]}}"#))
    if let Heard.Partial(p) = partial { assert(p == "hello wor") } else { panic("not a partial") }
    if let Heard.Final(f) = done { assert(f == "hello world") } else { panic("not final") }
    let flux_model = String("flux-general-en")
    if let Heard.Partial(p) = heard(String("deepgram"), flux_model.copy(), String(#"{"type":"TurnInfo","event":"Update","turn_index":0,"transcript":"hello"}"#)) { assert(p == "hello") } else { panic("not a partial") }
    if let Heard.Final(f) = heard(String("deepgram"), flux_model.copy(), String(#"{"type":"TurnInfo","event":"EndOfTurn","turn_index":0,"transcript":"hello there"}"#)) { assert(f == "hello there") } else { panic("not final") }
    if let Heard.Nothing = heard(String("deepgram"), flux_model.copy(), String(#"{"type":"Connected","request_id":"r"}"#)) {} else { panic("Connected isn't words") }
    if let Heard.Failed(w) = heard(String("deepgram"), flux_model, String(#"{"type":"Error","code":"BAD","description":"no"}"#)) { assert(w == "no") } else { panic("not failed") }
    let scribe = String("scribe_v3_live")
    if let Heard.Final(f) = heard(String("elevenlabs"), scribe.copy(), String(#"{"message_type":"committed_transcript","text":"hej"}"#)) { assert(f == "hej") } else { panic("not final") }
    if let Heard.Delta(d) = heard(String("openai"), String("gpt-live-transcribe"), String(#"{"type":"conversation.item.input_audio_transcription.delta","item_id":"i","delta":"Hel"}"#)) { assert(d == "Hel") } else { panic("not a delta") }
    if let Heard.Failed(w) = heard(String("elevenlabs"), scribe, String(#"{"message_type":"auth_error","error":"bad key"}"#)) { assert(w == "bad key") } else { panic("not failed") }
    if let Heard.Nothing = heard(String("openai"), String("gpt-live-transcribe"), String(#"{"type":"error","error":{"code":"input_audio_buffer_commit_empty","message":"empty"}}"#)) {} else { panic("an empty commit failed") }
    assert(joined(String("Hello"), String(" world ")) == "Hello world" and joined(String(""), String("Hi")) == "Hi" and joined(String("Hi"), String("")) == "Hi")
}

@test
fn what_a_speech_socket_says_is_read() {
    if let Said.Audio(a) = speech_heard(String("elevenlabs"), String(#"{"audio":"AQI=","alignment":null}"#)) { assert(a == [1u8, 2]) } else { panic("no audio") }
    if let Said.Done = speech_heard(String("elevenlabs"), String(#"{"is_final":true}"#)) {} else { panic("not done") }
    if let Said.Nothing = speech_heard(String("elevenlabs"), String(#"{"is_final_audio_for_turn":true}"#)) {} else { panic("a turn's end isn't the end") }
    if let Said.Failed(w) = speech_heard(String("elevenlabs"), String(#"{"message":"Model not supported","error":"invalid_request","code":1008}"#)) { assert(w == "Model not supported") } else { panic("not failed") }
    if let Said.Audio(a) = speech_heard(String("openai"), String(#"{"type":"response.output_audio.delta","delta":"AwQ="}"#)) { assert(a == [3u8, 4]) } else { panic("no audio") }
    if let Said.Done = speech_heard(String("openai"), String(#"{"type":"response.done","response":{"status":"completed"}}"#)) {} else { panic("not done") }
    if let Said.Failed(w) = speech_heard(String("openai"), String(#"{"type":"error","error":{"message":"bad"}}"#)) { assert(w == "bad") } else { panic("not failed") }
    // Deepgram's WAV comes as its PCM.
    var wav = to_wav([1u8, 2, 3, 4])
    assert(pcm_of(wav.copy()) == [1u8, 2, 3, 4] and pcm_of([9u8, 9]) == [9u8, 9])
    wav.truncate(44)
    assert(pcm_of(wav).len() == 0)
}

@test
fn voices_are_read_from_each_answer() {
    let eleven = voices(String("elevenlabs"), String(#"{"voices":[{"voice_id":"v1","name":"Rachel"},{"voice_id":"v2","name":"Adam"}]}"#).to_bytes())
    let fish = voices(String("fish"), String(#"{"total":1,"items":[{"_id":"f1","title":"Narrator"}]}"#).to_bytes())
    assert(eleven.len() == 2 and str_at(fish[0].copy(), "name") == some(String("Narrator")) and voices(String("openai"), List<u8>()).len() == 10)
    assert(str_at(pick_voice(eleven.copy(), String("adam")) ?? Json.Null, "id") == some(String("v2")))
    assert(str_at(pick_voice(eleven, String("")) ?? Json.Null, "id") == some(String("v1")))
    assert(pick_voice(List<Json>(), String("x")) == none)
    assert((fixed_voices(String("deepgram"), String("flux")) ?? List<Json>()).len() == 36 and (fixed_voices(String("deepgram"), String("aura-2")) ?? List<Json>()).len() == 41 and fixed_voices(String("fish"), String("drama-3")) == none)
    assert(batch_text(200, String(#"{"text":" hello "}"#).to_bytes())! == "hello")
    assert(match batch_text(401, String(#"{"error":{"message":"Invalid API Key"}}"#).to_bytes()) { ok(_) => false, err(_) => true })
}

@test
fn audio_comes_to_24k_mono() {
    // Two channels at 48 kHz: each pair averaged, every other frame kept.
    var pcm = List<u8>()
    for i in 0..8 {
        let s = i16.wrap(i * 100)
        bytes.put_u16_le(mut pcm, u16.wrap(s))
        bytes.put_u16_le(mut pcm, u16.wrap(s + 100))
    }
    let out = to_24k(pcm, 48000, 2)
    assert(out.len() == 4 and out[0] == 50 and out[1] == 250)
    // At 24 kHz already, as it is.
    assert(to_24k(le_bytes([1i16, -2, 3]), 24000, 1) == [1i16, -2, 3])
    // 16 kHz comes up: 3 samples become 4 or 5.
    assert(to_24k(le_bytes([0i16, 300, 600]), 16000, 1).len() >= 4)
    let w = to_wav(le_bytes([1i16, 2]))
    assert(w.len() == 48 and String.from_utf8(w[0..4].copy()) == some(String("RIFF")) and bytes.u32_le(w.copy(), 24) == 24000)
}

@test
fn models_on_the_device_need_no_key() {
    let t = tiles(String("dictation"), List<String>(), Json.Null, String("parakeet-ultra"))
    assert("{t}".contains(#"{"id":"parakeet-ultra","name":"Parakeet Ultra","line":"25 languages, 670 MB","icon":"laptop","icon_svg":"<svg "#))
    assert("{t}".contains(#""mark":"nvidia","streams":true,"key":false,"have":true,"in_use":true}"#))
    assert("{t}".contains(#"{"id":"parakeet","name":"Parakeet v2","line":"English, 660 MB""#))
    // Kokoro's, Supertone's and Kyutai's makers have no mark here, so their tiles have the Laptop.
    let spoken = "{tiles(String("speech"), List<String>(), Json.Null, String())}"
    assert(spoken.contains(#"{"id":"kokoro-v1.1","name":"Kokoro v1.1","line":"Chinese, 3 English voices, 365 MB","icon":"laptop","streams":false"#) and spoken.contains(#"{"id":"pocket","name":"Pocket TTS""#))
    assert(match apply(Json.Null, parse(#"{"dictation":{"engine":"siri"}}"#)!) { ok(_) => false, err(e) => e.contains("groq, parakeet-ultra, parakeet-v3, whisper and parakeet") })
    // Kokoro's voices go by id, its name kept for the picker.
    let k = apply(Json.Null, parse(#"{"speech":{"engine":"kokoro","voice":"emma, british"}}"#)!)!
    assert(str_at(at(k.copy(), "speech"), "voice") == some(String("bf_emma")) and str_at(at(k.copy(), "speech"), "voice_name") == some(String("Emma, British")))
    assert(local_voice(String("kokoro"), String("bf_emma")).0 == 21 and local_voice(String("kokoro"), String("")).0 == 3)
    assert(match apply(k, parse(#"{"speech":{"voice":"robot"}}"#)!) { ok(_) => false, err(_) => true })
    // Kokoro v1.1's speakers in their order; Supertonic's styles; Pocket's recordings.
    let k11 = fixed_voices(String("kokoro-v1.1"), String()) ?? List<Json>()
    assert(k11.len() == 103 and str_at(k11[3].copy(), "id") == some(String("zf_001")) and str_at(k11[58].copy(), "id") == some(String("zm_009")) and str_at(k11[102].copy(), "name") == some(String("Man 100, Chinese")))
    assert(local_voice(String("kokoro-v1.1"), String("bf_vale")).0 == 2 and local_voice(String("kokoro-v1.1"), String("zm_100")).0 == 102 and local_voice(String("kokoro-v1.1"), String("")).0 == 0)
    assert(local_voice(String("supertonic"), String("Man 1")).0 == 5)
    assert(local_voice(String("pocket"), String("loona")).1 == "test_wavs/loona.wav" and local_voice(String("pocket"), String("")).1 == "test_wavs/bria.wav")
    assert(voices(String("kokoro"), List<u8>()).len() == 36)
}

@test
fn the_models_hear_16k_floats() {
    let f = to_16k([0i16, 3000, 6000, 9000, 12000, 15000])
    assert(f.len() == 4 and f[0] == 0.0 and (f64(f[1]) - 4500.0 / 32768.0).abs() < 0.0001 and (f64(f[2]) - 9000.0 / 32768.0).abs() < 0.0001)
    assert(from_floats([0.0f32, 1.0, -1.0, 2.0]) == [0u8, 0, 0xff, 0x7f, 0x01, 0x80, 0xff, 0x7f])
}

@test
fn a_reply_is_said_as_words() {
    assert(speakable(String("# Done\n\nI fixed **the build** in [CI](https://x.y/z).\n```\ncode\n```\n- one\n- two")) == "Done I fixed the build in CI. one two")
    assert(cut(String("One two. Three four five."), 12) == "One two.")
}

@test
fn each_engine_has_its_makers_mark() {
    for e in ENGINES {
        if e.mark.len() == 0 { continue }
        let svg = mark_svg(String(e.mark)) ?? String()
        assert(svg.starts_with("<svg ") and svg.contains("fill=\"currentColor\"") and not svg.contains("#"))
    }
    assert(mark_svg(String("nvidia")) != none and mark_svg(String("siri")) == none)
    // Each service has its models, and a model on the device none.
    for e in ENGINES {
        assert((models_of(String(e.kind), String(e.id)).len() == 0) == e.on_device)
    }
}

@test
fn live_settings_are_checked() {
    let s = apply(Json.Null, parse(#"{"live":{"barge_in":false,"pause":1.1}}"#)!)!
    assert("{at(s.copy(), "live")}" == #"{"barge_in":false,"pause":1.2,"captions":true}"#)
    assert(match apply(s.copy(), parse(#"{"live":{"captions":"yes"}}"#)!) { ok(_) => false, err(_) => true })
    assert(match apply(s.copy(), parse(#"{"live":{"pause":9}}"#)!) { ok(_) => false, err(_) => true })
    // A change to speech keeps live as it was.
    let kept = apply(s, parse(#"{"speech":{"read_aloud":"live"}}"#)!)!
    assert(bool_at(at(kept, "live"), "barge_in") == some(false))
}

@test
fn a_cards_models_are_kept() {
    // A voice_setup card's settings have every service's model, which Add sets.
    let card = at(apply(Json.Null, parse(#"{"dictation":{"engine":"deepgram","model":"flux-general-multi"}}"#)!)!, "dictation")
    let set = apply(Json.Null, Obj.new().j("dictation", card).done())!
    assert(model_of(at(set, "dictation"), String("dictation"), String("deepgram")) == "flux-general-multi")
    assert(match apply(Json.Null, parse(#"{"speech":{"models":{"fish":"s9"}}}"#)!) { ok(_) => false, err(_) => true })
}
