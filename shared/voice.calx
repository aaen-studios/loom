/// The models of engine `id` of `kind`, newest first; none for a model on the device,
/// which is its own.
pub fn models_of(kind: String, id: String) -> List<Model> {
    var out = List<Model>()
    for m in MODELS {
        if m.kind == kind and m.engine == id { out.push(m) }
    }
    return out
}

/// The model of `kind`'s engine `id` that `given` names, by its id or its name, or none.
pub fn model_named(kind: String, id: String, given: String) -> Model? {
    let w = given.trim().to_lower_root()
    for m in models_of(kind, id) {
        if w == m.id or w == String(m.name).to_lower_root() { return some(m) }
    }
    return none
}

// The model kept for engine `id` in a kind's settings, if one is.
fn kept_model(kept: Json, id: String) -> String? {
    let models = kept.get(String("models")) ?? Json.Null
    return match models.get(id) {
        some(Json.Str(s)) => some(s),
        _ => none,
    }
}

/// The model `kind`'s engine `id` uses with that kind's settings, `kept`: the one kept
/// for it, or its newest when that isn't one of its; "" for a model on the device.
pub fn model_of(kept: Json, kind: String, id: String) -> String {
    let all = models_of(kind, id.copy())
    if all.len() == 0 { return String() }
    if let given = kept_model(kept, id) {
        for m in all.copy() {
            if m.id == given { return given }
        }
    }
    return String(all[0].id)
}

/// A model's name, by its id, or the id itself.
pub fn model_name(kind: String, id: String, model: String) -> String {
    for m in models_of(kind, id) {
        if m.id == model { return String(m.name) }
    }
    return model.copy()
}

// Each service of `kind` and its model, as the settings keep them.
fn models_json(kept: Json, kind: str) -> Json {
    var o = Obj.new()
    for e in ENGINES {
        if e.kind != kind or e.on_device { continue }
        o = o.s(e.id, model_of(kept.copy(), String(kind), String(e.id)))
    }
    return o.done()
}

