module shared.voice

// loom's voice (PLAN.md, "Voice"): the engines that hear the person and speak replies,
// each service's models, the person's voice settings, and each service's wire format, so
// the instance and the core read and write them the same way. The core runs the engines
// on the device (core/voice.calx); the instance keeps the settings and the keys
// (server/instance.calx).
//
// The settings, as `voice.get` gives them and `voice.put` takes them, all optional:
//
//     {"dictation": {"engine": "deepgram", "language": "",
//                    "models": {"elevenlabs": "scribe_v3_live", "deepgram": "nova-3", ...}},
//      "speech": {"engine": "openai", "voice": "marin", "voice_name": "Marin",
//                 "speed": 1.0, "read_aloud": "never",
//                 "models": {"elevenlabs": "eleven_v4_turbo", ...}},
//      "live": {"barge_in": true, "pause": 0.8, "captions": true}}
//
// An engine is `""` until one is picked, a language `""` detects it, and `read_aloud` is
// `never`, `live` or `always`. `models` has the model each service uses, kept per
// service so another engine keeps its own, the newest unless the person picked another;
// one that isn't the service's any more is its newest again. `voice.put` takes `model`
// for the engine in use, or the engine given with it. Live mode (core/live.calx) stops a
// reply the person talks over (`barge_in`), sends what they said once they've been quiet
// for `pause` seconds, and shows the words being said (`captions`).
//
// Each service's key is the person's secret `voice.SERVICE` on the instance, which only
// their devices open (`voice.start`), never an agent.
import std.bytes
import std.http.{Form, Header}
import std.json.{Json, parse}
import std.url
import shared.obj.{Obj, at, bool_at, merge, str_at}

/// A dictation engine, or a speech one. `streams` says whether the words come as
/// they're said; one that doesn't writes them once the person stops. `on_device` is a
/// model the device downloads and runs itself (core/models.calx), which needs no key;
/// one that dictates writes its words in short pieces as they're said, and its `line`
/// is its tile's, its languages and size. A service's tile has its model's name as its
/// line (MODELS). `mark` is its maker's logo, a file in voice/ without its .svg
/// (mark_svg), or "" for none.
pub struct Engine {
    pub id: str
    pub kind: str    // dictation or speech
    pub name: str
    pub line: str    // a model on the device's one quiet line
    pub streams: bool
    pub on_device: bool
    pub mark: str
}

/// One of a service's models: its id, as the service's API names it, the name its tile
/// and menu show, and its one quiet line in the menu.
pub struct Model {
    pub kind: str
    pub engine: str
    pub id: str
    pub name: str
    pub line: str
}

// The makers' marks (voice/README.md), built into the program as their files are.
const ELEVENLABS: [u8; 143] = embed("voice/elevenlabs.svg")
const DEEPGRAM: [u8; 410] = embed("voice/deepgram.svg")
const OPENAI: [u8; 2387] = embed("voice/openai.svg")
const GROQ: [u8; 188] = embed("voice/groq.svg")
const FISH_AUDIO: [u8; 2303] = embed("voice/fish-audio.svg")
const NVIDIA: [u8; 870] = embed("voice/nvidia.svg")

/// The SVG of the mark `name` names (`elevenlabs`, a file in voice/), or none.
pub fn mark_svg(name: String) -> String? {
    let text = if name == "elevenlabs" {
        String.from_utf8(ELEVENLABS[..])
    } else if name == "deepgram" {
        String.from_utf8(DEEPGRAM[..])
    } else if name == "openai" {
        String.from_utf8(OPENAI[..])
    } else if name == "groq" {
        String.from_utf8(GROQ[..])
    } else if name == "fish-audio" {
        String.from_utf8(FISH_AUDIO[..])
    } else if name == "nvidia" {
        String.from_utf8(NVIDIA[..])
    } else {
        return none
    }
    return some((text ?? String()).trim().copy())
}

