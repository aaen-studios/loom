module shared.protocol

// What protocol/protocol.md fixes for every side: the versions, the frame
// size and the close codes. The frames themselves come with the server.

// The versions this build speaks, newest first. An instance speaks its newest
// version and the one before.
pub const NEWEST: i32 = 1
pub const OLDEST: i32 = 1

// A frame bigger than this closes the socket with 1009.
pub const MAX_FRAME: usize = 1048576

// Keeping a connection alive (protocol.md, "The WebSocket session"): the
// instance pings every 20 s and closes a socket that hasn't answered for 60 s.
// The app pings after 25 s of quiet and gives up 20 s later, so 45 s with
// nothing from the instance is a dead connection.
pub const PING_EVERY_MS: u64 = 20000
pub const PING_ANSWER_MS: u64 = 40000
pub const APP_QUIET_MS: u32 = 25000
pub const APP_WAIT_MS: u32 = 20000

// WebSocket close codes.
pub const CLOSE_TOO_BIG: u16 = 1009
pub const CLOSE_PROTOCOL: u16 = 4000    // the first frame wasn't hello, or the session broke the protocol
pub const CLOSE_TOKEN: u16 = 4001       // the token is wrong or was revoked
pub const CLOSE_VERSION: u16 = 4002     // no protocol version in common
pub const CLOSE_TOO_SLOW: u16 = 4003    // the app's queue filled up
pub const CLOSE_MOVED: u16 = 4004       // the instance moved: the moved frame before it says where

// The app offers, the instance picks: the newest version both speak, or none.
pub fn pick_version(offered: List<i32>) -> i32? {
    var best: i32? = none
    for v in offered {
        if v >= OLDEST and v <= NEWEST {
            if let b = best {
                if v > b { best = some(v) }
            } else {
                best = some(v)
            }
        }
    }
    return best
}

@test
fn picks_the_newest_in_common() {
    let offered: List<i32> = [3, 1, 2]
    assert(pick_version(offered) == some(1))
}

@test
fn picks_none_without_a_common_version() {
    let offered: List<i32> = [7, 8]
    assert(pick_version(offered) == none)
    assert(pick_version(List<i32>()) == none)
}

// What the instance signs, with its Ed25519 key, to say it moved to
// `address` at `at` (Unix ms): the moved frame's `signature` is over this.
pub fn moved_message(instance: String, address: String, at: i64) -> String {
    return "loom moved {instance} to {address} at {at}"
}
